package cli;
import "app/wzcc/model" as model;
import "app/wzcc/render" as render;
import "app/wzcc/source" as source;
import "app/wzcc/input" as input;
import "app/wzcc/lexer" as lexer;
import "app/wzcc/parser" as parser;
import "std/io" as io;
import "std/os" as os;
import "std/strconv" as strconv;
import "std/text" as text;

func finish(options Options, sources Vec[model.Source], state model.PhaseState,
            failure model.FailureKind, has_value bool, diagnostics Vec[model.Diagnostic]) i32 throws os.Error {
    if options.json {
        try { io.println(render.document(sources, state, failure, has_value, diagnostics)); }
        catch error render.Error {
            io.eprintln("E_INTERNAL_ERROR: invalid diagnostic document");
            return 3;
        }
    } else if render.succeeded(state, has_value, diagnostics) {
        if options.command == "build" {
            var output = options.output;
            if options.backend == "native" {
                if text.ends_with(output, "/") { output += "program"; }
                else { output += "/program"; }
            }
            io.println("build ok: " + output);
        } else if options.syntax { io.println("syntax ok: " + options.path); }
        else { io.println("check ok: " + options.project); }
    } else {
        for diagnostic in diagnostics {
            var location = "";
            if diagnostic.has_primary {
                for item in sources {
                    if item.id == diagnostic.primary.snapshot {
                        location = item.path + ":bytes[" + strconv.format_u64(diagnostic.primary.begin_byte) + "," +
                            strconv.format_u64(diagnostic.primary.end_byte) + "): ";
                    }
                }
            }
            io.eprintln(location + diagnostic.code + ": " + diagnostic.message);
        }
    }
    return render.exit_code(state, failure, has_value, diagnostics);
}
func fail(options Options, sources Vec[model.Source], code string, phase string,
          message string, failure model.FailureKind) i32 throws os.Error {
    var diagnostic = model.diagnostic(code, phase, message, model.Span(snapshot: 0, begin_byte: 0, end_byte: 0));
    diagnostic.has_primary = false;
    return finish(options, sources, model.PhaseState.Failed, failure, false, [diagnostic]);
}
func os_text(problem os.Error) string {
    switch problem {
        case os.Error.Interrupted(code, completed): return "os error " + strconv.format_i64(i64(code));
        case os.Error.WouldBlock(code, completed): return "os error " + strconv.format_i64(i64(code));
        case os.Error.System(code, completed): return "os error " + strconv.format_i64(i64(code));
        case os.Error.NoProgress(completed): return "no progress";
    }
}
func help_text() string {
    return "Usage: woozyc --help | --version\n" +
        "       woozyc check --syntax-only [--format json] FILE\n" +
        "       woozyc check --project MANIFEST [--std-binding BUNDLE] [--backend native|python] [--format json]\n" +
        "       woozyc build --project MANIFEST --out-dir DIR [--std-binding BUNDLE] [--backend native|python] [--format json]\n" +
        "       Native build also accepts --opt 0|2, --target TRIPLE and --package-objects\n" +
        "       Source Make: build --project MANIFEST --out-dir DIR --source-make [--cache-dir DIR] [--opt 0|2]";
}
func syntax_command(options Options, manager inout source.Manager) i32 throws os.Error {
    let read = input.read(options.path, inout manager);
    if !render.succeeded(read.state, read.has_value, read.diagnostics) {
        return finish(options, manager.snapshots, read.state, read.failure, read.has_value, read.diagnostics);
    }
    let lexed = lexer.lex(read.value);
    if !render.succeeded(lexed.state, lexed.has_value, lexed.diagnostics) {
        return finish(options, manager.snapshots, lexed.state, lexed.failure, lexed.has_value, lexed.diagnostics);
    }
    let parsed = parser.parse(lexed);
    return finish(options, manager.snapshots, parsed.state, parsed.failure, parsed.has_value, parsed.diagnostics);
}
pub func run(args Vec[string]) i32 throws os.Error {
    let options = arguments(args);
    if !options.valid { io.eprintln(options.error); return 2; }
    if options.command == "lsp" || options.command == "capabilities" {
        io.eprintln("E_CAPABILITY_UNAVAILABLE: " + options.command + " is not implemented");
        return 1;
    }
    if options.command == "--version" { io.println("woozyc 0.1.0-selfhost (compiler-dev/1)"); return 0; }
    if options.command == "--help" { io.println(help_text()); return 0; }
    var manager = source.manager();
    if options.command == "__source_make_worker" {
        return source_make_worker(options, inout manager);
    }
    if options.command == "__source_make_combine" {
        return source_make_combine(options);
    }
    if options.command == "__source_make_link" {
        return source_make_link(options);
    }
    if options.syntax { return syntax_command(options, inout manager); }
    return project_command(options, inout manager);
}
