// Direct source-make scheduler. The driver prepares the immutable project and
// optional shared declarations, then this supervisor keeps at most --jobs
// package workers alive. Scheduling never runs GNU Make, a shell, an internal
// worker subcommand, or a broker socket.
package cli;

import "app/wzcc/model" as model;
import "app/wzcc/resolve" as resolve;
import "app/wzcc/sema" as sema;
import "app/wzcc/source" as source;
import "std/fs" as fs;
import "std/io" as io;
import "std/option" as option;
import "std/os" as os;
import "std/process" as process;
import "std/strconv" as strconv;
import "std/vec" as vec;

const WORKER_DIR string = ".wz-source-make";

struct ActiveWorker {
    pid i32;
    package_index usize;
}

struct MakeRun {
    ok bool;
    log string;
}

func close_quietly(file os.File) {
    try { os.close(file); } catch problem os.Error {}
}

func worker_capture(package_value MakePackage) string {
    return WORKER_DIR + "/worker-" + package_value.fixed + ".log";
}

func redirect_worker_output(package_value MakePackage) throws os.Error {
    let output = os.open(worker_capture(package_value),
        os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC, 0o600);
    defer { if os.fd(output) >= 3 { close_quietly(output); } }
    let standard_output = os.dup2(output, 1);
    let standard_error = os.dup2(output, 2);
}

func status_text(status process.WaitStatus) string {
    let signalled = process.signaled(status);
    var code = process.exit_status(status);
    if signalled { code = 128 + process.term_signal(status); }
    var signal_text = "false";
    if signalled { signal_text = "true"; }
    return "exit=" + strconv.format_i64(i64(code)) + " signalled=" + signal_text;
}

func worker_child(options Options, manager source.Manager, state MakeState,
                  original model.Project, prepared resolve.PreparedProject,
                  declarations option.Option[sema.PreparedPackages],
                  package_value MakePackage) {
    var status i32 = 125;
    try {
        redirect_worker_output(package_value);
        let compiled = source_make_compile(options, manager, state, original,
            prepared, declarations, package_value);
        status = compiled;
    } catch problem os.Error {
        try { io.eprintln("source-make worker failed: " + source_os_text(problem)); }
        catch ignored os.Error {}
        status = 125;
    }
    os.exit(status);
}

func remove_worker(active Vec[ActiveWorker], pid i32) option.Option[ActiveWorker] {
    for var index usize = 0; index < vec.len(active); index += 1 {
        if active[index].pid == pid {
            return option.Option[ActiveWorker].Some(vec.remove_at(active, index));
        }
    }
    return option.Option[ActiveWorker].None;
}

func reap_status(packages Vec[MakePackage], active Vec[ActiveWorker],
                 status process.WaitStatus, log inout string) bool {
    switch remove_worker(active, status.pid) {
        case option.Option.Some(worker): {
            let package_value = packages[worker.package_index];
            let succeeded = process.exited(status) && process.exit_status(status) == 0;
            append_log(inout log, "worker end: " + package_value.fixed + " " +
                status_text(status));
            return succeeded;
        }
        case option.Option.None: {
            append_log(inout log, "unexpected worker status: pid=" +
                strconv.format_i64(i64(status.pid)) + " " + status_text(status));
            return false;
        }
    }
}

func append_worker_logs(log inout string, packages Vec[MakePackage]) {
    for package_value in packages {
        var output = "";
        try { output = fs.read_text(worker_capture(package_value)); }
        catch problem os.Error {}
        if output != "" {
            append_log(inout log, "worker output: " + package_value.fixed);
            append_log(inout log, output);
        }
    }
}

func all_objects_present(packages Vec[MakePackage], log inout string) bool {
    var present = true;
    for package_value in packages {
        var exists = false;
        try { exists = fs.is_file(os.stat(object_name(package_value))); }
        catch problem os.Error {}
        if !exists {
            append_log(inout log, "missing object: " + object_name(package_value));
            present = false;
        }
    }
    return present;
}

func run_source_make(options Options, state MakeState, original model.Project,
                         prepared resolve.PreparedProject,
                         manager source.Manager) MakeRun {
    var jobs = options.jobs;
    if jobs == 0 { jobs = 1; }
    var declarations = option.Option[sema.PreparedPackages].None;
    if state.cache_dir == "" && vec.len(state.packages) > 1 {
        declarations = sema.prepare_packages(resolve.resolve_prepared_project(prepared),
            option.Option[model.CheckConfig].None);
    }
    var workdir = "";
    try { workdir = os.getcwd(); } catch problem os.Error {}
    var log = "source-make driver\nworkdir: " + workdir + "\n";
    append_log(inout log, "packages: " + strconv.format_u64(u64(vec.len(state.packages))));
    append_log(inout log, "jobs: " + strconv.format_u64(u64(jobs)));
    let active = vec.empty[ActiveWorker]();
    var next usize = 0;
    var failed = false;
    for true {
        for true {
            if failed || next >= vec.len(state.packages) || vec.len(active) >= jobs { break; }
            let package_value = state.packages[next];
            var pid i32 = 0;
            var forked = false;
            try { pid = process.fork(); forked = true; }
            catch problem os.Error {
                append_log(inout log, "worker fork failed: " + source_os_text(problem));
                failed = true;
            }
            if forked {
                if pid == 0 {
                    worker_child(options, manager, state, original, prepared,
                        declarations, package_value);
                }
                vec.push(active, ActiveWorker(pid: pid, package_index: next));
                append_log(inout log, "worker start: " + package_value.fixed +
                    " pid=" + strconv.format_i64(i64(pid)));
                next += 1;
            }
        }
        if vec.len(active) == 0 { break; }
        var status = process.WaitStatus(pid: 0, status: 0);
        var wait_failed = false;
        try { status = process.wait(-1); }
        catch problem os.Error {
            append_log(inout log, "worker wait failed: " + source_os_text(problem));
            failed = true;
            wait_failed = true;
        }
        if wait_failed {
            for worker in active {
                try {
                    let stopped = process.wait(worker.pid);
                    append_log(inout log, "worker end: " +
                        state.packages[worker.package_index].fixed + " " +
                        status_text(stopped));
                } catch problem os.Error {}
            }
            vec.clear(active);
            break;
        }
        if !reap_status(state.packages, active, status, inout log) { failed = true; }
    }
    append_worker_logs(inout log, state.packages);
    if !failed && !all_objects_present(state.packages, inout log) { failed = true; }
    return MakeRun(ok: !failed && next >= vec.len(state.packages), log: log);
}
