package cli;
import "app/wzcc/model" as model;
import "app/wzcc/frontcache" as frontcache;
import "app/wzcc/dependencylock" as dependencylock;
import "app/wzcc/hir" as hir;
import "app/wzcc/hirverify" as hirverify;
import "app/wzcc/project" as project;
import "app/wzcc/resolve" as resolve;
import "app/wzcc/sema" as sema;
import "app/wzcc/source" as source;
import "app/wzcc/render" as render;
import "app/wzcc/resources" as resources;
import "app/wzcc/nativelower" as nativelower;
import "app/wzcc/nativeemit" as nativeemit;
import "app/wzcc/nativebuild" as nativebuild;
import "app/wzcc/nativeverify" as nativeverify;
import "app/wzcc/interface" as interface;
import "app/wzcc/pythonemit" as pythonemit;
import "app/wzcc/toolio" as toolio;
import "std/fs" as fs;
import "std/os" as os;
import "std/option" as option;
import "std/vec" as vec;

func support_text(problem model.SupportError) string {
    switch problem {
        case model.SupportError.Invalid(message): return message;
        case model.SupportError.Limit(message): return message;
    }
}
func native_entry(resolved model.ResolvedProject) option.Option[usize] throws model.SupportError {
    var entry = option.Option[usize].None;
    for symbol in resolved.symbols {
        var function = false;
        switch symbol.kind { case model.SymbolKind.Function: function = true; default: {} }
        if function && symbol.module == resolved.project.entry && symbol.name == "main" {
            if option.is_some(entry) { throw model.SupportError.Invalid("ambiguous entry name"); }
            entry = option.Option[usize].Some(symbol.id);
        }
    }
    return entry;
}
func python_entry(module hir.HirModule) option.Option[usize] throws model.SupportError {
    var entry = option.Option[usize].None;
    for function in module.functions {
        if function.symbol >= vec.len(module.resolved.symbols) {
            throw model.SupportError.Invalid("entry function symbol index");
        }
        let symbol = module.resolved.symbols[function.symbol];
        if symbol.module == module.identity && symbol.name == "main" {
            entry = option.Option[usize].Some(symbol.id);
        }
    }
    return entry;
}
func missing_main(options Options, sources Vec[model.Source]) i32 throws os.Error {
    return fail(options, sources, "E_CAPABILITY_UNAVAILABLE", "codegen",
        "executable build requires main in the entry module", model.FailureKind.Unsupported);
}
func build_native_packages(options Options, original model.Project, native nativeverify.VerifiedModule,
                           entry usize, settings nativeemit.Options, sources Vec[model.Source], cache frontcache.Context) i32 throws os.Error {
    try {
    let input = nativeverify.snapshot(native);
    let inputs = vec.empty[nativebuild.PackageInput]();
    let keys = interface.index(input.hir); let selected = vec.empty[usize]();
    for package_value in input.hir.resolved.project.modules {
        var used = false;
        for function in input.functions { if interface.indexed_owner(keys, function.symbol) == package_value.id { used = true; } }
        if used { vec.push(selected, package_value.id); }
    }
    let emit_start = os.clock_gettime(os.CLOCK_MONOTONIC);
    let emitted_values = nativeemit.emit_packages(native, entry, settings, selected);
    let emit_end = os.clock_gettime(os.CLOCK_MONOTONIC);
    let emit_nanoseconds = u64((emit_end.seconds - emit_start.seconds) * 1000000000 + emit_end.nanoseconds - emit_start.nanoseconds);
    for var index usize = 0; index < vec.len(emitted_values); index += 1 {
        let emitted = emitted_values[index]; let package_value = input.hir.resolved.project.modules[selected[index]];
        switch emitted.value {
            case option.Option.None: return finish(options, sources, emitted.state, emitted.failure, false, emitted.diagnostics);
            case option.Option.Some(output): {
                let digest = frontcache.llvm_digest(output.llvm_sections); var key = ""; var frontend_key = ""; var object = option.Option[Vec[u8]].None;
                if frontcache.active(cache) {
                    frontend_key = frontcache.package_key(cache, input.hir, package_value.id);
                    key = frontcache.object_key(cache, package_value.identity, digest); object = frontcache.load_target_object(cache, key, settings.triple);
                }
                vec.push(inputs, nativebuild.PackageInput(package_id: package_value.id, logical_path: package_value.logical_path,
                    identity: package_value.identity, object_key: key, frontend_key: frontend_key, llvm_digest: digest,
                    object: object, output: option.Option[nativeemit.Output].Some(output)));
            }
        }
    }
    let built = nativebuild.build_cached_packages(inputs, original, options.output, settings, cache, emit_nanoseconds);
    return finish(options, sources, built.state, built.failure, built.has_value, built.diagnostics);
    } catch problem model.SupportError {
        return fail(options, sources, "E_INTERNAL_ERROR", "toolchain", support_text(problem), model.FailureKind.Internal);
    }
}
func build_native(options Options, original model.Project, resolved model.ResolvedProject,
                  verified hirverify.VerifiedHirModule, sources Vec[model.Source], cache frontcache.Context) i32 throws os.Error {
    try {
        switch native_entry(resolved) {
            case option.Option.None: return missing_main(options, sources);
            case option.Option.Some(entry): {
                let lowered = nativelower.lower(verified);
                let has_native = option.is_some(lowered.value);
                if !render.succeeded(lowered.state, has_native, lowered.diagnostics) {
                    return finish(options, sources, lowered.state, lowered.failure, has_native, lowered.diagnostics);
                }
                switch lowered.value {
                    case option.Option.None:
                        return finish(options, sources, lowered.state, lowered.failure, false, lowered.diagnostics);
                    case option.Option.Some(native): {
                        var settings = nativeemit.default_options();
                        settings.debug_info = options.debug_info;
                        if options.opt == "2" { settings.optimization = 2; }
                        if options.target != "" { settings.triple = options.target; }
                        if options.package_objects {
                            return build_native_packages(options, original, native, entry, settings, sources, cache);
                        }
                        let emitted = nativeemit.emit(native, entry, settings);
                        let has_output = option.is_some(emitted.value);
                        if !render.succeeded(emitted.state, has_output, emitted.diagnostics) {
                            return finish(options, sources, emitted.state, emitted.failure, has_output, emitted.diagnostics);
                        }
                        switch emitted.value {
                            case option.Option.None:
                                return finish(options, sources, emitted.state, emitted.failure, false, emitted.diagnostics);
                            case option.Option.Some(output): {
                                let built = nativebuild.build(output, original, options.output, settings.optimization);
                                return finish(options, sources, built.state, built.failure, built.has_value, built.diagnostics);
                            }
                        }
                    }
                }
            }
        }
    } catch problem model.SupportError {
        return fail(options, sources, "E_INTERNAL_ERROR", "toolchain", support_text(problem), model.FailureKind.Internal);
    }
}
func build_python(options Options, verified hirverify.VerifiedHirModule,
                  sources Vec[model.Source]) i32 throws os.Error {
    try {
        let module = hirverify.snapshot(verified);
        switch python_entry(module) {
            case option.Option.None: return missing_main(options, sources);
            case option.Option.Some(entry): {
                let directory = resources.directory();
                let runtime = fs.read_text(directory + "/runtime/python/unicode18.py") + "\n" +
                    fs.read_text(directory + "/runtime/python/langrt.py");
                let emitted = pythonemit.emit(verified, entry, pythonemit.Options(entrypoint: true), runtime);
                let has_output = option.is_some(emitted.value);
                if !render.succeeded(emitted.state, has_output, emitted.diagnostics) {
                    return finish(options, sources, emitted.state, emitted.failure, has_output, emitted.diagnostics);
                }
                switch emitted.value {
                    case option.Option.None:
                        return finish(options, sources, emitted.state, emitted.failure, false, emitted.diagnostics);
                    case option.Option.Some(output): {
                        var staging = toolio.stage(options.output, "python");
                        defer { toolio.cleanup(staging); }
                        let directory = staging.path;
                        fs.write_text(directory + "/program.py", output.code, 0o666);
                        fs.write_text(directory + "/langrt.py", output.runtime, 0o666);
                        toolio.publish_pair(inout staging, "langrt.py", "program.py");
                        return finish(options, sources, emitted.state, emitted.failure, true, emitted.diagnostics);
                    }
                }
            }
        }
    } catch problem model.SupportError {
        return fail(options, sources, "E_INTERNAL_ERROR", "toolchain", support_text(problem), model.FailureKind.Internal);
    } catch problem toolio.Error {
        switch problem {
            case toolio.Error.System(error):
                return fail(options, sources, "E_INPUT_IO", "toolchain", os_text(error), model.FailureKind.Environment);
            case toolio.Error.Rollback(backup, error):
                return fail(options, sources, "E_INPUT_IO", "toolchain",
                    "output recovery failed; retained at " + backup + ": " + os_text(error), model.FailureKind.Environment);
        }
    }
}
func lock_error(options Options, sources Vec[model.Source], problem dependencylock.Error) i32 throws os.Error {
    switch problem {
        case dependencylock.Error.Missing:
            return fail(options, sources, "E_DEPENDENCY_LOCK", "resolve",
                "lang.lock is missing; run woozyc lock --project MANIFEST", model.FailureKind.Source);
        case dependencylock.Error.Changed:
            return fail(options, sources, "E_DEPENDENCY_LOCK", "resolve",
                "lang.lock differs from the dependency snapshot; review it and run woozyc lock --project MANIFEST",
                model.FailureKind.Source);
        case dependencylock.Error.Io:
            return fail(options, sources, "E_INPUT_IO", "resolve",
                "cannot read or atomically replace lang.lock", model.FailureKind.Environment);
        case dependencylock.Error.Unsupported:
            return fail(options, sources, "E_CAPABILITY_UNAVAILABLE", "resolve",
                "lang.lock cannot pin host Python or native libraries", model.FailureKind.Unsupported);
    }
}
func project_command(input Options, manager inout source.Manager) i32 throws os.Error {
    var options = input;
    try {
        var library = option.Option[string].None;
        var binding = option.Option[string].None;
        if options.std_binding != "" { binding = option.Option[string].Some(options.std_binding); }
        else { library = option.Option[string].Some(resources.standard_library()); }
        let project_options = model.ProjectOptions(manifest: options.project,
            std_source_root: library, std_binding_bundle: binding);
        var cache = frontcache.context("", "");
        let darwin_default = options.command == "build" && options.target == "" && resources.host_is_darwin();
        var cache_target = options.target;
        if darwin_default { cache_target = nativeemit.DARWIN_ARM64_TRIPLE; }
        if options.source_make {
            cache = frontcache.configure_source_make(options.cache_directory, options.opt,
                cache_target, options.objects_only);
        } else { cache = frontcache.configure(options.cache_directory, options.opt, cache_target); }
        let snapshot = project.load_snapshot(project_options, inout manager, cache);
        let loaded = snapshot.result;
        if !render.succeeded(loaded.state, loaded.has_value, loaded.diagnostics) {
            return finish(options, manager.snapshots, loaded.state, loaded.failure, loaded.has_value, loaded.diagnostics);
        }
        try {
            if options.command == "lock" && !options.lock_check { dependencylock.update(snapshot, manager); }
            else { dependencylock.check(snapshot, manager, options.lock_check); }
        } catch problem dependencylock.Error { return lock_error(options, manager.snapshots, problem); }
        if options.command == "lock" {
            return finish(options, manager.snapshots, loaded.state, loaded.failure, true, loaded.diagnostics);
        }
        var original = loaded.value;
        if options.backend != "" { original.backend = options.backend; }
        options.backend = original.backend;
        if options.backend == "native" && darwin_default { options.target = nativeemit.DARWIN_ARM64_TRIPLE; }
        if options.debug_info && options.backend != "native" {
            return fail(options, manager.snapshots, "E_DRIVER_ARGUMENT", "toolchain",
                "-g requires native build", model.FailureKind.Environment);
        }
        if options.command == "build" && options.backend == "python" && (options.opt != "" || options.target != "" || options.package_objects || options.source_make) {
            return fail(options, manager.snapshots, "E_DRIVER_ARGUMENT", "toolchain",
                "--opt, --target, --package-objects and --source-make require native build", model.FailureKind.Environment);
        }
        if options.command == "build" && options.source_make {
            if options.debug_info && frontcache.active(cache) {
                cache.fingerprint = frontcache.debug_source_fingerprint(cache, original);
            }
            return source_make_build(options, original, inout manager, cache);
        }
        let resolved = resolve.resolve_project(original);
        let checked = sema.check_project_cached(resolved, option.Option[model.CheckConfig].None, hirverify.VerifyMode.Backend, cache);
        let has_checked = option.is_some(checked.value);
        if !render.succeeded(checked.state, has_checked, checked.diagnostics) || options.command == "check" {
            return finish(options, manager.snapshots, checked.state, checked.failure, has_checked, checked.diagnostics);
        }
        switch checked.value {
            case option.Option.None:
                return finish(options, manager.snapshots, checked.state, checked.failure, false, checked.diagnostics);
            case option.Option.Some(verified): {
                if options.backend == "native" {
                    return build_native(options, original, resolved.value, verified, manager.snapshots, cache);
                }
                return build_python(options, verified, manager.snapshots);
            }
        }
    } catch problem os.Error {
        return fail(options, manager.snapshots, "E_INPUT_IO", "toolchain", os_text(problem), model.FailureKind.Environment);
    }
}
