package cli;
import "std/text" as text;
import "std/vec" as vec;

pub struct Options {
    pub valid bool;
    pub error string;
    pub command string;
    pub syntax bool;
    pub format_check bool;
    pub package_objects bool;
    pub source_make bool;
    pub make_state string;
    pub make_package string;
    pub cache_directory string;
    pub json bool;
    pub path string;
    pub project string;
    pub output string;
    pub opt string;
    pub debug_info bool;
    pub target string;
    pub std_binding string;
    pub backend string;
}

func not_flag(value string) bool { return text.len(value) > 0 && value[0] != 45; }

pub func arguments(args Vec[string]) Options {
    var options = Options(valid: false,
        error: "E_DRIVER_ARGUMENT: expected --help, --version, check, build, lsp or capabilities",
        command: "", syntax: false, format_check: false, package_objects: false, source_make: false,
        make_state: "", make_package: "", cache_directory: "", json: false,
        path: "", project: "", output: "", opt: "", debug_info: false, target: "", std_binding: "", backend: "");
    if vec.len(args) < 2 { return options; }
    options.command = args[1];
    if options.command == "--help" || options.command == "--version" {
        options.valid = vec.len(args) == 2;
        return options;
    }
    if options.command == "lsp" {
        options.error = "E_DRIVER_ARGUMENT: use lsp [--stdio]";
        options.valid = vec.len(args) == 2 ||
            (vec.len(args) == 3 && args[2] == "--stdio");
        return options;
    }
    if options.command == "capabilities" {
        options.valid = true;
        return options;
    }
    if options.command == "fmt" {
        options.error = "E_DRIVER_ARGUMENT: use fmt [--check] FILE|-";
        var check = false;
        var index usize = 2;
        if index < vec.len(args) && args[index] == "--check" {
            check = true; index += 1;
        }
        var literal = false;
        if index < vec.len(args) && args[index] == "--" {
            literal = true; index += 1;
        }
        if index + 1 != vec.len(args) { return options; }
        let argument = args[index];
        if argument == "" { return options; }
        if !literal && argument != "-" && argument[0] == 45 { return options; }
        options.path = argument;
        options.format_check = check;
        options.valid = true;
        return options;
    }
    if options.command == "__source_make_worker" ||
       options.command == "__source_make_combine" ||
       options.command == "__source_make_link" {
        options.error = "E_DRIVER_ARGUMENT: invalid source-make worker arguments";
        var index usize = 2;
        for index < vec.len(args) {
            let argument = args[index];
            var next = "";
            if index + 1 < vec.len(args) { next = args[index + 1]; }
            if argument == "--state" && options.make_state == "" && not_flag(next) {
                options.make_state = next; index += 1;
            } else if argument == "--package" && options.make_package == "" && next != "" && !text.contains(next, "-") {
                options.make_package = next; index += 1;
            } else { return options; }
            index += 1;
        }
        options.valid = options.make_state != "" &&
            (options.command != "__source_make_worker" || options.make_package != "");
        return options;
    }
    if options.command != "check" && options.command != "build" { return options; }
    options.error = "E_DRIVER_ARGUMENT: invalid check/build arguments";
    var index usize = 2;
    for index < vec.len(args) {
        let argument = args[index];
        var next = "";
        if index + 1 < vec.len(args) { next = args[index + 1]; }
        if argument == "--package-objects" && options.command == "build" && !options.package_objects { options.package_objects = true; }
        else if argument == "--source-make" && options.command == "build" && !options.source_make { options.source_make = true; }
        else if argument == "--cache-dir" && options.command == "build" && options.cache_directory == "" && not_flag(next) { options.cache_directory = next; index += 1; }
        else if argument == "--syntax-only" { options.syntax = true; }
        else if argument == "--format" && next == "json" { options.json = true; index += 1; }
        else if argument == "--project" && options.project == "" && not_flag(next) { options.project = next; index += 1; }
        else if argument == "--out-dir" && options.command == "build" && options.output == "" && not_flag(next) { options.output = next; index += 1; }
        else if argument == "--std-binding" && options.std_binding == "" && not_flag(next) { options.std_binding = next; index += 1; }
        else if argument == "--backend" && options.backend == "" && (next == "native" || next == "python") { options.backend = next; index += 1; }
        else if argument == "--opt" && options.command == "build" && options.opt == "" && (next == "0" || next == "2") { options.opt = next; index += 1; }
        else if argument == "-g" && options.command == "build" && !options.debug_info { options.debug_info = true; }
        else if argument == "--target" && options.command == "build" && options.target == "" && not_flag(next) { options.target = next; index += 1; }
        else if not_flag(argument) && options.path == "" { options.path = argument; }
        else { return options; }
        index += 1;
    }
    options.error = "E_DRIVER_ARGUMENT: use check --syntax-only FILE, check --project MANIFEST, or build --project MANIFEST --out-dir DIR";
    if options.syntax {
        options.valid = options.command == "check" && options.path != "" && options.project == "" &&
            options.backend == "" && options.std_binding == "";
    } else {
        options.valid = options.project != "" && options.path == "" &&
            (options.command != "build" || options.output != "");
    }
    if options.cache_directory != "" && !options.package_objects && !options.source_make { options.valid = false; options.error = "E_DRIVER_ARGUMENT: --cache-dir requires --package-objects or --source-make"; }
    if options.package_objects && options.source_make { options.valid = false; options.error = "E_DRIVER_ARGUMENT: --source-make cannot be combined with --package-objects"; }
    if options.source_make && options.command != "build" { options.valid = false; options.error = "E_DRIVER_ARGUMENT: --source-make requires build"; }
    if options.source_make && options.backend == "python" { options.valid = false; options.error = "E_DRIVER_ARGUMENT: --source-make requires the native backend"; }
    if options.debug_info && options.backend == "python" { options.valid = false; options.error = "E_DRIVER_ARGUMENT: -g requires native build"; }
    return options;
}
