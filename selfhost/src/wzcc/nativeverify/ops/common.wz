// Per-instruction checks: shared HIR/type/layout helpers.
//
// These helpers read only the independently copied CFG and HIR in Body.
package ops;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativelayout" as nativelayout;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/types" as types;
import "app/wzcc/valueops" as valueops;
import "app/wzcc/nativeverify/containers" as nvcontainers;
import "app/wzcc/nativeverify/state" as nvstate;
import "app/wzcc/nativeverify/support" as nvsupport;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

pub func aggregate_fields(state inout nvstate.Body, type_id usize,
                      variant option.Option[usize]) Vec[hir.FieldDecl]
    throws nvsupport.VerifyError {
    try {
        return nativelayout.fields(inout state.aggregates, type_id, variant);
    } catch error model.SupportError {
        throw nvsupport.support(error);
    }
}

pub func aggregate_field_index(state inout nvstate.Body, type_id usize, field usize,
                           variant option.Option[usize]) usize
    throws nvsupport.VerifyError {
    try {
        return nativelayout.field_index(inout state.aggregates, type_id, field,
            variant);
    } catch error model.SupportError {
        throw nvsupport.support(error);
    }
}

pub func aggregate_variant_index(state nvstate.Body, type_id usize, variant usize) usize
    throws nvsupport.VerifyError {
    try {
        return nativelayout.variant_index(state.aggregates, type_id, variant);
    } catch error model.SupportError {
        throw nvsupport.support(error);
    }
}

pub func aggregate_declaration(state nvstate.Body, type_id usize) hir.NominalDecl
    throws nvsupport.VerifyError {
    try {
        return nativelayout.declaration(state.aggregates, type_id);
    } catch error model.SupportError {
        throw nvsupport.support(error);
    }
}

pub func classify(state nvstate.Body, type_id usize) hir.ValueOps throws nvsupport.VerifyError {
    try {
        return valueops.classify_value(state.m.h, type_id);
    } catch error model.SupportError {
        throw nvsupport.support(error);
    }
}

pub func bit_width(state nvstate.Body, value model.Type) u32 throws nvsupport.VerifyError {
    try {
        return types.bit_width(value, state.m.config);
    } catch error types.Error {
        throw nvsupport.support(nvsupport.support_from_type_error(error));
    }
}

pub func operand_type(state nvstate.Body, args Vec[nvcontainers.Definition], index usize,
                  span model.Span) model.Type throws nvsupport.VerifyError {
    if index >= vec.len(args) {
        throw nvsupport.support(model.SupportError.Invalid("missing instruction operand"));
    }
    nvsupport.need(!args[index].address, "address used as scalar value", span);
    return nvsupport.require_type(state.m.h, args[index].type_id, span);
}

pub func require_arity(args Vec[nvcontainers.Definition], count usize, span model.Span)
    throws nvsupport.VerifyError {
    nvsupport.need(vec.len(args) == count, "instruction operand count", span);
}

func source_operation(state nvstate.Body, origin option.Option[usize],
                      expected hir.NodeKind, result_type usize,
                      args Vec[nvcontainers.Definition], span model.Span) hir.HirNode
    throws nvsupport.VerifyError {
    var origin_id usize = 0;
    var present = false;
    switch origin {
        case option.Option.Some(value): origin_id = value; present = true;
        case option.Option.None: {}
    }
    nvsupport.need(present && origin_id < vec.len(state.m.h.nodes),
         "source operation has no HIR origin", span);
    let node = state.m.h.nodes[origin_id];
    nvsupport.need(nvsupport.kind_is(hir.node_kind(node.data), expected) &&
             node.type_id == result_type &&
             nvsupport.same_span(node.source.span, span) &&
             nvsupport.hir_scope_function(state.m.h, node.scope) == state.f.symbol &&
             vec.len(node.children) == vec.len(args),
         "source operation differs from verified HIR", span);
    for var index usize = 0; index < vec.len(args); index += 1 {
        let child = nvsupport.hir_node(state.m.h, node.children[index]);
        nvsupport.need(nvsupport.same_span(args[index].source, child.source.span),
             "source operation operand differs from source", span);
    }
    return node;
}

func index_operation(state nvstate.Body, origin option.Option[usize],
                     expected hir.NodeKind, source_is_origin bool,
                     args Vec[nvcontainers.Definition], span model.Span) hir.HirNode
    throws nvsupport.VerifyError {
    var origin_id usize = 0;
    var present = false;
    switch origin {
        case option.Option.Some(value): origin_id = value; present = true;
        case option.Option.None: {}
    }
    nvsupport.need(present && origin_id < vec.len(state.m.h.nodes),
         "index operation has no HIR origin", span);
    let node = state.m.h.nodes[origin_id];
    nvsupport.need(nvsupport.kind_is(hir.node_kind(node.data), expected) &&
             vec.len(node.children) == 2 &&
             nvsupport.hir_scope_function(state.m.h, node.scope) == state.f.symbol &&
             nvsupport.same_span(node.source.span, span) == source_is_origin,
         "index operation differs from verified HIR", span);
    for var index usize = 0; index < 2; index += 1 {
        let child = nvsupport.hir_node(state.m.h, node.children[index]);
        nvsupport.need(nvsupport.same_span(args[index].source, child.source.span),
             "index receiver/index differs from source HIR", span);
    }
    return node;
}

pub func valid_utf8(value string) bool {
    let bytes = text.bytes(value);
    let count = vec.len(bytes);
    var index usize = 0;
    for index < count {
        let lead = bytes[index];
        var width usize = 1;
        var code u32 = u32(lead);
        var minimum u32 = 0;
        if lead < 0x80 {
            width = 1;
        } else if lead >= 0xC2 && lead <= 0xDF {
            width = 2;
            code = u32(lead & 0x1F);
            minimum = 0x80;
        } else if lead >= 0xE0 && lead <= 0xEF {
            width = 3;
            code = u32(lead & 0x0F);
            minimum = 0x800;
        } else if lead >= 0xF0 && lead <= 0xF4 {
            width = 4;
            code = u32(lead & 0x07);
            minimum = 0x10000;
        } else {
            return false;
        }
        if width > count - index {
            return false;
        }
        for var offset usize = 1; offset < width; offset += 1 {
            let next = bytes[index + offset];
            if (next & 0xC0) != 0x80 {
                return false;
            }
            code = (code << 6) | u32(next & 0x3F);
        }
        if code < minimum || code > 0x10FFFF ||
           (code >= 0xD800 && code <= 0xDFFF) {
            return false;
        }
        index += width;
    }
    return true;
}

pub func binary_result_ok(comparison bool, value_type model.Type,
                      instruction nativeir.Instruction,
                      args Vec[nvcontainers.Definition]) bool {
    if comparison {
        return nvsupport.type_is(value_type.kind, model.TypeKind.Bool);
    }
    return instruction.type_id == args[0].type_id;
}
