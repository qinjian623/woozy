// Shared ordered containers and error plumbing for the Native CFG verifier.
//
// The C++ verifier uses std::map/std::set/<map> of ids.  Their iteration order
// is the ascending (or tuple-lexicographic) key order, and that order decides
// which malformed record is reported first.  Every map/set here therefore
// keeps its entries in the same order instead of using hash-like or insertion
// order.  A BoolSet stands in for std::set<size_t> where only membership,
// intersection and equality are observed.
//
// Vec values are shared handles in Woozy, so every copy that corresponds to a
// C++ container copy is made explicitly; assigning a record with a Vec field
// would otherwise alias the producer's storage.
package nativeverify;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/vec" as vec;

// A C++ Bad (message + SourceSpan) or an exception from a shared algorithm.
// The shared algorithms already keep their original text; this type never
// Panics in place of an error return.
enum VerifyError {
    Bad(message string, span model.Span);
    Support(error model.SupportError);
}

func bad(message string, span model.Span) VerifyError {
    return VerifyError.Bad(message: message, span: span);
}

func support(error model.SupportError) VerifyError {
    return VerifyError.Support(error: error);
}

func support_from_type_error(error types.Error) model.SupportError {
    switch error {
        case types.Error.Invalid(message):
            return model.SupportError.Invalid(message);
    }
}

func need(ok bool, message string, span model.Span) throws VerifyError {
    if !ok {
        throw bad(message, span);
    }
}

func empty_span() model.Span {
    return model.Span(snapshot: 0, begin_byte: 0, end_byte: 0);
}

func same_span(left model.Span, right model.Span) bool {
    return left.snapshot == right.snapshot &&
           left.begin_byte == right.begin_byte &&
           left.end_byte == right.end_byte;
}

func span_contains(outer model.Span, inner model.Span) bool {
    return inner.snapshot == outer.snapshot &&
           inner.begin_byte >= outer.begin_byte &&
           inner.end_byte <= outer.end_byte;
}

func kind_is(left hir.NodeKind, right hir.NodeKind) bool {
    return hir.node_kind_id(left) == hir.node_kind_id(right);
}

func exit_kind_id(kind hir.ExitKind) u32 {
    switch kind {
        case hir.ExitKind.Normal: return 0;
        case hir.ExitKind.Return: return 1;
        case hir.ExitKind.Break: return 2;
        case hir.ExitKind.Continue: return 3;
        case hir.ExitKind.Error: return 4;
        case hir.ExitKind.Cancel: return 5;
    }
}

func integer(kind model.TypeKind) bool {
    return model.type_kind_id(kind) == model.type_kind_id(model.TypeKind.SignedInt) ||
           model.type_kind_id(kind) == model.type_kind_id(model.TypeKind.UnsignedInt) ||
           model.type_kind_id(kind) == model.type_kind_id(model.TypeKind.Isize) ||
           model.type_kind_id(kind) == model.type_kind_id(model.TypeKind.Usize);
}

func type_is(kind model.TypeKind, expected model.TypeKind) bool {
    return model.type_kind_id(kind) == model.type_kind_id(expected);
}

// C++ Verifier::type: an absent TypeId is a Bad with the caller's span.
func require_type(h hir.HirModule, id usize, span model.Span) model.Type
    throws VerifyError {
    let found = types.find(h.types, id);
    switch found {
        case option.Option.Some(value): return value;
        case option.Option.None:
            throw bad("invalid TypeId", span);
    }
}

// std::vector::at / std::map::at in the C++ verifier throw std::out_of_range,
// which the outer handler reports as E_IR_INVALID without a primary span.
func hir_node(h hir.HirModule, id usize) hir.HirNode throws VerifyError {
    if id >= vec.len(h.nodes) {
        throw support(model.SupportError.Invalid("invalid HIR node index"));
    }
    return h.nodes[id];
}

func hir_scope_function(h hir.HirModule, scope usize) usize throws VerifyError {
    if scope >= vec.len(h.scopes) {
        throw support(model.SupportError.Invalid("invalid HIR scope index"));
    }
    return h.scopes[scope].function;
}


// std::optional ordering: an empty optional sorts before an engaged one.
func compare_option(left option.Option[usize], right option.Option[usize]) i32 {
    var left_value usize = 0;
    var right_value usize = 0;
    var left_some = false;
    var right_some = false;
    switch left {
        case option.Option.Some(item): left_some = true; left_value = item;
        case option.Option.None: {}
    }
    switch right {
        case option.Option.Some(item): right_some = true; right_value = item;
        case option.Option.None: {}
    }
    if !left_some && !right_some { return 0; }
    if !left_some { return -1; }
    if !right_some { return 1; }
    if left_value < right_value { return -1; }
    if left_value > right_value { return 1; }
    return 0;
}

func usize_compare(left usize, right usize) i32 {
    if left < right { return -1; }
    if left > right { return 1; }
    return 0;
}

// Sorted insertion with binary search, mirroring std::set/std::map key order.
func sorted_position[T](values Vec[T], probe T, compare func(T, T) i32) usize {
    var low usize = 0;
    var high usize = vec.len(values);
    for low < high {
        let middle = low + (high - low) / 2;
        if compare(values[middle], probe) < 0 {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

func sorted_index[T](values Vec[T], probe T, compare func(T, T) i32) usize {
    let at = sorted_position(values, probe, compare);
    if at < vec.len(values) && compare(values[at], probe) == 0 {
        return at;
    }
    return vec.len(values);
}

func sorted_insert[T](values inout Vec[T], value T, compare func(T, T) i32) bool {
    let at = sorted_position(values, value, compare);
    if at < vec.len(values) && compare(values[at], value) == 0 {
        return false;
    }
    vec.push(values, value);
    for var index usize = vec.len(values) - 1; index > at; index -= 1 {
        values[index] = values[index - 1];
    }
    values[at] = value;
    return true;
}

// std::set<size_t> stand-in.
struct BoolSet {
    bits Vec[bool];
}

func bool_set(size usize) BoolSet {
    return BoolSet(bits: vec.make[bool](size, false));
}


func bool_set_copy(value BoolSet) BoolSet {
    let bits = vec.make[bool](vec.len(value.bits), false);
    for var index usize = 0; index < vec.len(value.bits); index += 1 {
        bits[index] = value.bits[index];
    }
    return BoolSet(bits: bits);
}

func bool_set_has(value BoolSet, index usize) bool {
    if index >= vec.len(value.bits) {
        return false;
    }
    return value.bits[index];
}

func bool_set_add(value inout BoolSet, index usize) bool {
    if index >= vec.len(value.bits) || value.bits[index] {
        return false;
    }
    value.bits[index] = true;
    return true;
}

func bool_set_remove(value inout BoolSet, index usize) bool {
    if index >= vec.len(value.bits) || !value.bits[index] {
        return false;
    }
    value.bits[index] = false;
    return true;
}


func bool_set_intersect(left BoolSet, right BoolSet) BoolSet {
    let result = bool_set_copy(left);
    for var index usize = 0; index < vec.len(result.bits); index += 1 {
        if !bool_set_has(right, index) {
            result.bits[index] = false;
        }
    }
    return result;
}

func bool_set_equal(left BoolSet, right BoolSet) bool {
    if vec.len(left.bits) != vec.len(right.bits) {
        return false;
    }
    for var index usize = 0; index < vec.len(left.bits); index += 1 {
        if left.bits[index] != right.bits[index] {
            return false;
        }
    }
    return true;
}


// std::set<HirNodeId> in ascending id order.
struct NodeSet {
    values Vec[usize];
}

func node_set() NodeSet {
    return NodeSet(values: vec.empty[usize]());
}

func node_set_compare(left usize, right usize) i32 {
    return usize_compare(left, right);
}

func node_set_has(state NodeSet, value usize) bool {
    return sorted_index(state.values, value, node_set_compare) <
           vec.len(state.values);
}

func node_set_insert(state inout NodeSet, value usize) bool {
    return sorted_insert(inout state.values, value, node_set_compare);
}

func node_set_remove(state inout NodeSet, value usize) bool {
    let at = sorted_index(state.values, value, node_set_compare);
    if at >= vec.len(state.values) {
        return false;
    }
    for var index usize = at; index + 1 < vec.len(state.values);
        index += 1 {
        state.values[index] = state.values[index + 1];
    }
    let popped = vec.pop(state.values);
    switch popped {
        case option.Option.Some(item): return true;
        case option.Option.None: return false;
    }
}

func node_set_copy(state NodeSet) NodeSet {
    let result = vec.empty[usize]();
    vec.reserve(result, vec.len(state.values));
    for value in state.values {
        vec.push(result, value);
    }
    return NodeSet(values: result);
}


// std::set<std::pair<HirNodeId, uint32_t>> for catch targets.
struct CatchKey {
    try_node usize;
    index u32;
}

struct CatchSet {
    values Vec[CatchKey];
}

func catch_key_compare(left CatchKey, right CatchKey) i32 {
    let node_order = usize_compare(left.try_node, right.try_node);
    if node_order != 0 {
        return node_order;
    }
    return usize_compare(usize(left.index), usize(right.index));
}

func catch_set() CatchSet {
    return CatchSet(values: vec.empty[CatchKey]());
}

func catch_set_insert(state inout CatchSet, key CatchKey) bool {
    return sorted_insert(inout state.values, key, catch_key_compare);
}


func catch_set_remove(state inout CatchSet, key CatchKey) bool {
    let at = sorted_index(state.values, key, catch_key_compare);
    if at >= vec.len(state.values) {
        return false;
    }
    for var index usize = at; index + 1 < vec.len(state.values);
        index += 1 {
        state.values[index] = state.values[index + 1];
    }
    let popped = vec.pop(state.values);
    switch popped {
        case option.Option.Some(item): return true;
        case option.Option.None: return false;
    }
}


// std::set<std::tuple<ValueId, SymbolId, bool>> used for enum variant facts.
struct Fact {
    value usize;
    variant usize;
    matches bool;
}

struct FactSet {
    values Vec[Fact];
}

func fact_compare(left Fact, right Fact) i32 {
    let value_order = usize_compare(left.value, right.value);
    if value_order != 0 {
        return value_order;
    }
    let variant_order = usize_compare(left.variant, right.variant);
    if variant_order != 0 {
        return variant_order;
    }
    if !left.matches && right.matches { return -1; }
    if left.matches && !right.matches { return 1; }
    return 0;
}

func fact_set() FactSet {
    return FactSet(values: vec.empty[Fact]());
}

func fact_insert(state inout FactSet, value usize, variant usize,
                 matches bool) bool {
    return sorted_insert(inout state.values,
        Fact(value: value, variant: variant, matches: matches), fact_compare);
}

func fact_has(state FactSet, value usize, variant usize, matches bool) bool {
    let probe = Fact(value: value, variant: variant, matches: matches);
    return sorted_index(state.values, probe, fact_compare) <
           vec.len(state.values);
}

func fact_set_copy(state FactSet) FactSet {
    let result = vec.empty[Fact]();
    vec.reserve(result, vec.len(state.values));
    for value in state.values {
        vec.push(result, value);
    }
    return FactSet(values: result);
}

func fact_set_equal(left FactSet, right FactSet) bool {
    if vec.len(left.values) != vec.len(right.values) {
        return false;
    }
    for var index usize = 0; index < vec.len(left.values); index += 1 {
        if fact_compare(left.values[index], right.values[index]) != 0 {
            return false;
        }
    }
    return true;
}

func fact_set_intersect(left FactSet, right FactSet) FactSet {
    let result = vec.empty[Fact]();
    for value in left.values {
        if fact_has(right, value.value, value.variant, value.matches) {
            vec.push(result, value);
        }
    }
    return FactSet(values: result);
}

// std::map<ValueId, Def>.  ValueIds sort as plain integers.
struct Definition {
    block usize;
    position usize;
    type_id usize;
    address bool;
    source model.Span;
}

struct ValueDefinition {
    value usize;
    definition Definition;
}

struct DefinitionMap {
    entries Vec[ValueDefinition];
}

func value_definition_compare(left ValueDefinition, right ValueDefinition) i32 {
    return usize_compare(left.value, right.value);
}

func definition_map() DefinitionMap {
    return DefinitionMap(entries: vec.empty[ValueDefinition]());
}

func definition_find(state DefinitionMap, value usize) option.Option[Definition] {
    let probe = ValueDefinition(value: value,
        definition: Definition(block: 0, position: 0, type_id: 0, address: false,
            source: empty_span()));
    let at = sorted_index(state.entries, probe, value_definition_compare);
    if at < vec.len(state.entries) {
        return option.Option[Definition].Some(state.entries[at].definition);
    }
    return option.Option[Definition].None;
}

func definition_require(state DefinitionMap, value usize) Definition
    throws VerifyError {
    let found = definition_find(state, value);
    switch found {
        case option.Option.Some(definition): return definition;
        case option.Option.None:
            throw support(model.SupportError.Invalid("missing value definition"));
    }
}

func definition_insert(state inout DefinitionMap, value usize,
                       definition Definition) bool {
    return sorted_insert(inout state.entries,
        ValueDefinition(value: value, definition: definition),
        value_definition_compare);
}

func definition_set_source(state inout DefinitionMap, value usize,
                           source model.Span) {
    let at = sorted_index(state.entries,
        ValueDefinition(value: value,
            definition: Definition(block: 0, position: 0, type_id: 0,
                address: false, source: empty_span())),
        value_definition_compare);
    if at < vec.len(state.entries) {
        state.entries[at].definition.source = source;
    }
}

// std::map<ValueId, const Instruction *>.
struct InstructionEntry {
    value usize;
    instruction nativeir.Instruction;
}

struct InstructionMap {
    entries Vec[InstructionEntry];
}

func instruction_entry_compare(left InstructionEntry,
                               right InstructionEntry) i32 {
    return usize_compare(left.value, right.value);
}

func instruction_map() InstructionMap {
    return InstructionMap(entries: vec.empty[InstructionEntry]());
}

func instruction_find(state InstructionMap, value usize)
    option.Option[nativeir.Instruction] {
    let probe = InstructionEntry(value: value,
        instruction: nativeir.empty_instruction());
    let at = sorted_index(state.entries, probe, instruction_entry_compare);
    if at < vec.len(state.entries) {
        return option.Option[nativeir.Instruction].Some(
            state.entries[at].instruction);
    }
    return option.Option[nativeir.Instruction].None;
}

func instruction_require(state InstructionMap, value usize)
    nativeir.Instruction throws VerifyError {
    let found = instruction_find(state, value);
    switch found {
        case option.Option.Some(instruction): return instruction;
        case option.Option.None:
            throw support(model.SupportError.Invalid(
                "missing value instruction"));
    }
}

func instruction_insert(state inout InstructionMap, value usize,
                        instruction nativeir.Instruction) bool {
    let entry = InstructionEntry(value: value, instruction: instruction);
    return sorted_insert(inout state.entries, entry, instruction_entry_compare);
}

// std::map<ValueId, std::pair<ValueId, size_t>> for Vec element addresses.
struct AddressRoot {
    value usize;
    root usize;
    depth usize;
}

struct AddressRootMap {
    entries Vec[AddressRoot];
}

func address_root_compare(left AddressRoot, right AddressRoot) i32 {
    return usize_compare(left.value, right.value);
}

func address_root_map() AddressRootMap {
    return AddressRootMap(entries: vec.empty[AddressRoot]());
}

func address_root_find(state AddressRootMap, value usize)
    option.Option[AddressRoot] {
    let probe = AddressRoot(value: value, root: 0, depth: 0);
    let at = sorted_index(state.entries, probe, address_root_compare);
    if at < vec.len(state.entries) {
        return option.Option[AddressRoot].Some(state.entries[at]);
    }
    return option.Option[AddressRoot].None;
}

func address_root_insert(state inout AddressRootMap, value usize, root usize,
                         depth usize) bool {
    return sorted_insert(inout state.entries,
        AddressRoot(value: value, root: root, depth: depth),
        address_root_compare);
}

// std::map<ValueId, size_t> counters (address writes).
struct ValueCount {
    value usize;
    count usize;
}

struct ValueCountMap {
    entries Vec[ValueCount];
}

func value_count_compare(left ValueCount, right ValueCount) i32 {
    return usize_compare(left.value, right.value);
}

func value_count_map() ValueCountMap {
    return ValueCountMap(entries: vec.empty[ValueCount]());
}

func value_count_add(state inout ValueCountMap, value usize) {
    let at = sorted_index(state.entries, ValueCount(value: value, count: 0),
        value_count_compare);
    if at < vec.len(state.entries) {
        state.entries[at].count += 1;
        return;
    }
    sorted_insert(inout state.entries, ValueCount(value: value, count: 1),
        value_count_compare);
}

func value_count_get(state ValueCountMap, value usize) usize {
    let at = sorted_index(state.entries, ValueCount(value: value, count: 0),
        value_count_compare);
    if at < vec.len(state.entries) {
        return state.entries[at].count;
    }
    return 0;
}

// std::map<ValueId, std::set<LocalSlotId>> for owning receivers.
struct ValueOwners {
    value usize;
    slots BoolSet;
}

struct ValueOwnerMap {
    entries Vec[ValueOwners];
    slot_count usize;
}

func value_owners_compare(left ValueOwners, right ValueOwners) i32 {
    return usize_compare(left.value, right.value);
}

func value_owner_map(slot_count usize) ValueOwnerMap {
    return ValueOwnerMap(entries: vec.empty[ValueOwners](),
        slot_count: slot_count);
}

func value_owner_find(state ValueOwnerMap, value usize)
    option.Option[BoolSet] {
    let probe = ValueOwners(value: value, slots: bool_set(state.slot_count));
    let at = sorted_index(state.entries, probe, value_owners_compare);
    if at < vec.len(state.entries) {
        return option.Option[BoolSet].Some(state.entries[at].slots);
    }
    return option.Option[BoolSet].None;
}

func value_owner_add(state inout ValueOwnerMap, value usize, slot usize) {
    let at = sorted_index(state.entries,
        ValueOwners(value: value, slots: bool_set(state.slot_count)),
        value_owners_compare);
    if at < vec.len(state.entries) {
        bool_set_add(inout state.entries[at].slots, slot);
        return;
    }
    var slots = bool_set(state.slot_count);
    bool_set_add(inout slots, slot);
    sorted_insert(inout state.entries, ValueOwners(value: value, slots: slots),
        value_owners_compare);
}

// std::map<LocalSlotId, ValueId> for owning temporaries.
struct SlotTemporary {
    slot usize;
    value usize;
}

struct SlotTemporaryMap {
    entries Vec[SlotTemporary];
}

func slot_temporary_compare(left SlotTemporary, right SlotTemporary) i32 {
    return usize_compare(left.slot, right.slot);
}

func slot_temporary_map() SlotTemporaryMap {
    return SlotTemporaryMap(entries: vec.empty[SlotTemporary]());
}

func slot_temporary_insert(state inout SlotTemporaryMap, slot usize,
                           value usize) bool {
    return sorted_insert(inout state.entries,
        SlotTemporary(slot: slot, value: value), slot_temporary_compare);
}

func slot_temporary_require(state SlotTemporaryMap, slot usize) usize
    throws VerifyError {
    let at = sorted_index(state.entries, SlotTemporary(slot: slot, value: 0),
        slot_temporary_compare);
    if at < vec.len(state.entries) {
        return state.entries[at].value;
    }
    throw support(model.SupportError.Invalid("missing owning temporary"));
}

// std::map<HirNodeId, size_t> for the HIR evaluation order of system calls.
struct NodeOrder {
    node usize;
    order usize;
}

struct NodeOrderMap {
    entries Vec[NodeOrder];
}

func node_order_compare(left NodeOrder, right NodeOrder) i32 {
    return usize_compare(left.node, right.node);
}

func node_order_map() NodeOrderMap {
    return NodeOrderMap(entries: vec.empty[NodeOrder]());
}

func node_order_insert(state inout NodeOrderMap, node usize, order usize) bool {
    return sorted_insert(inout state.entries, NodeOrder(node: node, order: order),
        node_order_compare);
}

func node_order_find(state NodeOrderMap, node usize) option.Option[usize] {
    let at = sorted_index(state.entries, NodeOrder(node: node, order: 0),
        node_order_compare);
    if at < vec.len(state.entries) {
        return option.Option[usize].Some(state.entries[at].order);
    }
    return option.Option[usize].None;
}

// std::multimap<std::tuple<snapshot, begin, end, type>, HirNodeId>.  The C++
// equal_range preserves insertion order, which is ascending node index here.
struct ConstantRoot {
    snapshot u64;
    begin_byte u64;
    end_byte u64;
    type_id usize;
    node usize;
}


struct ConstantRootList {
    entries Vec[ConstantRoot];
}

func constant_root_list() ConstantRootList {
    return ConstantRootList(entries: vec.empty[ConstantRoot]());
}

func constant_root_insert(state inout ConstantRootList, snapshot u64,
                          begin_byte u64, end_byte u64, type_id usize,
                          node usize) {
    vec.push(state.entries, ConstantRoot(snapshot: snapshot,
        begin_byte: begin_byte, end_byte: end_byte, type_id: type_id,
        node: node));
}

// std::map<std::tuple<TryNode, index, BlockId>, const Handler *>.
struct HandlerKey {
    try_node usize;
    index u32;
    block usize;
}

struct HandlerEntry {
    key HandlerKey;
    handler nativeir.Handler;
}

struct HandlerMap {
    entries Vec[HandlerEntry];
}

func handler_key_compare(left HandlerKey, right HandlerKey) i32 {
    let node_order = usize_compare(left.try_node, right.try_node);
    if node_order != 0 {
        return node_order;
    }
    let index_order = usize_compare(usize(left.index), usize(right.index));
    if index_order != 0 {
        return index_order;
    }
    return usize_compare(left.block, right.block);
}

func handler_entry_compare(left HandlerEntry, right HandlerEntry) i32 {
    return handler_key_compare(left.key, right.key);
}

func handler_map() HandlerMap {
    return HandlerMap(entries: vec.empty[HandlerEntry]());
}

func handler_insert(state inout HandlerMap, try_node usize, index u32,
                    block usize, handler nativeir.Handler) bool {
    return sorted_insert(inout state.entries,
        HandlerEntry(key: HandlerKey(try_node: try_node, index: index,
            block: block), handler: handler),
        handler_entry_compare);
}

func handler_find(state HandlerMap, try_node usize, index u32, block usize)
    option.Option[nativeir.Handler] {
    let probe = HandlerEntry(key: HandlerKey(try_node: try_node, index: index,
        block: block), handler: default_handler());
    let at = sorted_index(state.entries, probe, handler_entry_compare);
    if at < vec.len(state.entries) {
        return option.Option[nativeir.Handler].Some(
            state.entries[at].handler);
    }
    return option.Option[nativeir.Handler].None;
}

func default_handler() nativeir.Handler {
    return nativeir.Handler(target: hir.CatchTarget(try_node: 0, index: 0),
        block: 0, slot: 0, protected_entry: 0);
}

// std::set<std::tuple<TryNode, uint32_t, BlockId>> for concrete Try instances.
struct InstanceKey {
    try_node usize;
    index u32;
    block usize;
}

func instance_key_compare(left InstanceKey, right InstanceKey) i32 {
    return handler_key_compare(HandlerKey(try_node: left.try_node,
            index: left.index, block: left.block),
        HandlerKey(try_node: right.try_node, index: right.index,
            block: right.block));
}

struct InstanceSet {
    values Vec[InstanceKey];
}

func instance_set() InstanceSet {
    return InstanceSet(values: vec.empty[InstanceKey]());
}

func instance_set_insert(state inout InstanceSet, try_node usize, index u32,
                         block usize) bool {
    return sorted_insert(inout state.values,
        InstanceKey(try_node: try_node, index: index, block: block),
        instance_key_compare);
}



// std::map<ValueId, unsigned> for owned-value flags (bit 1 transferred,
// bit 2 available).  Entries stay sorted by ValueId so equality is the C++
// std::map equality of the same contents.
struct ValueFlag {
    value usize;
    state u32;
}

struct ValueFlagMap {
    entries Vec[ValueFlag];
}

func value_flag_compare(left ValueFlag, right ValueFlag) i32 {
    return usize_compare(left.value, right.value);
}

func value_flag_map() ValueFlagMap {
    return ValueFlagMap(entries: vec.empty[ValueFlag]());
}

func value_flag_find(state ValueFlagMap, value usize) option.Option[u32] {
    let at = sorted_index(state.entries, ValueFlag(value: value, state: 0),
        value_flag_compare);
    if at < vec.len(state.entries) {
        return option.Option[u32].Some(state.entries[at].state);
    }
    return option.Option[u32].None;
}

func value_flag_require(state ValueFlagMap, value usize) u32
    throws VerifyError {
    let found = value_flag_find(state, value);
    switch found {
        case option.Option.Some(flags): return flags;
        case option.Option.None:
            throw support(model.SupportError.Invalid(
                "missing owned value state"));
    }
}

func value_flag_set(state inout ValueFlagMap, value usize, flags u32) {
    let at = sorted_index(state.entries, ValueFlag(value: value, state: 0),
        value_flag_compare);
    if at < vec.len(state.entries) {
        state.entries[at].state = flags;
        return;
    }
    sorted_insert(inout state.entries, ValueFlag(value: value, state: flags),
        value_flag_compare);
}

func value_flag_insert(state inout ValueFlagMap, value usize, flags u32) bool {
    return sorted_insert(inout state.entries,
        ValueFlag(value: value, state: flags), value_flag_compare);
}

func value_flag_copy(state ValueFlagMap) ValueFlagMap {
    let entries = vec.empty[ValueFlag]();
    vec.reserve(entries, vec.len(state.entries));
    for value in state.entries {
        vec.push(entries, value);
    }
    return ValueFlagMap(entries: entries);
}

func value_flag_equal(left ValueFlagMap, right ValueFlagMap) bool {
    if vec.len(left.entries) != vec.len(right.entries) {
        return false;
    }
    for var index usize = 0; index < vec.len(left.entries); index += 1 {
        if value_flag_compare(left.entries[index], right.entries[index]) != 0 ||
           left.entries[index].state != right.entries[index].state {
            return false;
        }
    }
    return true;
}


// Obligation keys: the C++ tuple order is Context (vector of
// (node, kind, error, defer) tuples), then the node, kind and optional error.
struct ContextEntry {
    origin usize;
    kind hir.ExitKind;
    error_type option.Option[usize];
    defer_node usize;
}

struct ExitKey {
    context Vec[ContextEntry];
    origin usize;
    kind hir.ExitKind;
    error_type option.Option[usize];
}

struct CallKey {
    context Vec[ContextEntry];
    origin usize;
}

struct ExitObligation {
    key ExitKey;
    count usize;
}

struct CallObligation {
    key CallKey;
    count usize;
}

struct Obligations {
    exits Vec[ExitObligation];
    calls Vec[CallObligation];
}

func context_entry_compare(left ContextEntry, right ContextEntry) i32 {
    let origin_order = usize_compare(left.origin, right.origin);
    if origin_order != 0 {
        return origin_order;
    }
    let kind_order = usize_compare(usize(exit_kind_id(left.kind)),
        usize(exit_kind_id(right.kind)));
    if kind_order != 0 {
        return kind_order;
    }
    let error_order = compare_option(left.error_type, right.error_type);
    if error_order != 0 {
        return error_order;
    }
    return usize_compare(left.defer_node, right.defer_node);
}

func context_compare(left Vec[ContextEntry], right Vec[ContextEntry]) i32 {
    var count = vec.len(left);
    if vec.len(right) < count {
        count = vec.len(right);
    }
    for var index usize = 0; index < count; index += 1 {
        let order = context_entry_compare(left[index], right[index]);
        if order != 0 {
            return order;
        }
    }
    return usize_compare(vec.len(left), vec.len(right));
}

func exit_key_compare(left ExitKey, right ExitKey) i32 {
    let context_order = context_compare(left.context, right.context);
    if context_order != 0 {
        return context_order;
    }
    let origin_order = usize_compare(left.origin, right.origin);
    if origin_order != 0 {
        return origin_order;
    }
    let kind_order = usize_compare(usize(exit_kind_id(left.kind)),
        usize(exit_kind_id(right.kind)));
    if kind_order != 0 {
        return kind_order;
    }
    return compare_option(left.error_type, right.error_type);
}

func call_key_compare(left CallKey, right CallKey) i32 {
    let context_order = context_compare(left.context, right.context);
    if context_order != 0 {
        return context_order;
    }
    return usize_compare(left.origin, right.origin);
}

func exit_obligation_compare(left ExitObligation,
                             right ExitObligation) i32 {
    return exit_key_compare(left.key, right.key);
}

func call_obligation_compare(left CallObligation,
                             right CallObligation) i32 {
    return call_key_compare(left.key, right.key);
}

func obligations() Obligations {
    return Obligations(exits: vec.empty[ExitObligation](),
        calls: vec.empty[CallObligation]());
}

func obligation_add_exit(state inout Obligations, context Vec[ContextEntry],
                         origin usize, kind hir.ExitKind,
                         error_type option.Option[usize]) {
    let key = ExitKey(context: context, origin: origin, kind: kind,
        error_type: error_type);
    let probe = ExitObligation(key: key, count: 0);
    let at = sorted_position(state.exits, probe, exit_obligation_compare);
    if at < vec.len(state.exits) &&
       exit_obligation_compare(state.exits[at], probe) == 0 {
        state.exits[at].count += 1;
        return;
    }
    let entry = ExitObligation(key: key, count: 1);
    vec.push(state.exits, entry);
    for var index usize = vec.len(state.exits) - 1; index > at; index -= 1 {
        state.exits[index] = state.exits[index - 1];
    }
    state.exits[at] = entry;
}

func obligation_add_call(state inout Obligations, context Vec[ContextEntry],
                         origin usize) {
    let key = CallKey(context: context, origin: origin);
    let probe = CallObligation(key: key, count: 0);
    let at = sorted_position(state.calls, probe, call_obligation_compare);
    if at < vec.len(state.calls) &&
       call_obligation_compare(state.calls[at], probe) == 0 {
        state.calls[at].count += 1;
        return;
    }
    let entry = CallObligation(key: key, count: 1);
    vec.push(state.calls, entry);
    for var index usize = vec.len(state.calls) - 1; index > at; index -= 1 {
        state.calls[index] = state.calls[index - 1];
    }
    state.calls[at] = entry;
}

func obligations_equal_exits(left Vec[ExitObligation],
                             right Vec[ExitObligation]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if exit_obligation_compare(left[index], right[index]) != 0 ||
           left[index].count != right[index].count {
            return false;
        }
    }
    return true;
}

func obligations_equal_calls(left Vec[CallObligation],
                             right Vec[CallObligation]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if call_obligation_compare(left[index], right[index]) != 0 ||
           left[index].count != right[index].count {
            return false;
        }
    }
    return true;
}

func owner_kind_id(kind hir.OwnerKind) u32 {
    switch kind {
        case hir.OwnerKind.Binding: return 0;
        case hir.OwnerKind.Temporary: return 1;
        case hir.OwnerKind.ReturnOutput: return 2;
        case hir.OwnerKind.ErrorOutput: return 3;
        case hir.OwnerKind.Iteration: return 4;
    }
}

func use_kind_id(kind hir.UseKind) u32 {
    switch kind {
        case hir.UseKind.Borrow: return 0;
        case hir.UseKind.Copy: return 1;
        case hir.UseKind.Take: return 2;
        case hir.UseKind.Inout: return 3;
    }
}

func cleanup_kind_id(kind hir.CleanupKind) u32 {
    switch kind {
        case hir.CleanupKind.SaveOutput: return 0;
        case hir.CleanupKind.EndBorrow: return 1;
        case hir.CleanupKind.DestroyIfLive: return 2;
        case hir.CleanupKind.Defer: return 3;
        case hir.CleanupKind.EndIteration: return 4;
    }
}

func callee_kind_id(kind hir.CalleeKind) u32 {
    switch kind {
        case hir.CalleeKind.Direct: return 0;
        case hir.CalleeKind.FunctionValue: return 1;
        case hir.CalleeKind.Foreign: return 2;
        case hir.CalleeKind.System: return 3;
        case hir.CalleeKind.CForeign: return 4;
    }
}

func param_mode_id(mode model.ParamMode) u32 {
    switch mode {
        case model.ParamMode.Ordinary: return 0;
        case model.ParamMode.Inout: return 1;
        case model.ParamMode.Move: return 2;
    }
}

func unary_op_id(op hir.UnaryOp) u32 {
    switch op {
        case hir.UnaryOp.Negate: return 0;
        case hir.UnaryOp.LogicalNot: return 1;
        case hir.UnaryOp.BitNot: return 2;
    }
}

func binary_op_id(op hir.BinaryOp) u32 {
    switch op {
        case hir.BinaryOp.Add: return 0;
        case hir.BinaryOp.Subtract: return 1;
        case hir.BinaryOp.Multiply: return 2;
        case hir.BinaryOp.Divide: return 3;
        case hir.BinaryOp.Remainder: return 4;
        case hir.BinaryOp.ShiftLeft: return 5;
        case hir.BinaryOp.ShiftRight: return 6;
        case hir.BinaryOp.BitAnd: return 7;
        case hir.BinaryOp.BitOr: return 8;
        case hir.BinaryOp.BitXor: return 9;
        case hir.BinaryOp.Equal: return 10;
        case hir.BinaryOp.NotEqual: return 11;
        case hir.BinaryOp.Less: return 12;
        case hir.BinaryOp.LessEqual: return 13;
        case hir.BinaryOp.Greater: return 14;
        case hir.BinaryOp.GreaterEqual: return 15;
    }
}

func owner_ref_equal(left hir.OwnerRef, right hir.OwnerRef) bool {
    return owner_kind_id(left.kind) == owner_kind_id(right.kind) &&
           left.identity == right.identity;
}

func owner_ref_option_equal(left option.Option[hir.OwnerRef],
                            right option.Option[hir.OwnerRef]) bool {
    var left_some = false;
    var right_some = false;
    var left_value = hir.OwnerRef(kind: hir.OwnerKind.Binding, identity: 0);
    var right_value = hir.OwnerRef(kind: hir.OwnerKind.Binding, identity: 0);
    switch left {
        case option.Option.Some(item): left_some = true; left_value = item;
        case option.Option.None: {}
    }
    switch right {
        case option.Option.Some(item): right_some = true; right_value = item;
        case option.Option.None: {}
    }
    if left_some != right_some {
        return false;
    }
    if !left_some {
        return true;
    }
    return owner_ref_equal(left_value, right_value);
}

func owner_kind_is(value option.Option[hir.OwnerRef],
                   kind hir.OwnerKind) bool {
    switch value {
        case option.Option.Some(item):
            return owner_kind_id(item.kind) == owner_kind_id(kind);
        case option.Option.None: return false;
    }
}

func owner_identity(value option.Option[hir.OwnerRef]) u64 {
    switch value {
        case option.Option.Some(item): return item.identity;
        case option.Option.None: return 0;
    }
}

func owner_ref_is(value option.Option[hir.OwnerRef], kind hir.OwnerKind,
                  identity u64) bool {
    switch value {
        case option.Option.Some(item):
            return owner_kind_id(item.kind) == owner_kind_id(kind) &&
                   item.identity == identity;
        case option.Option.None: return false;
    }
}

func exit_site_equal(left nativeir.ExitSite, right nativeir.ExitSite) bool {
    return left.origin == right.origin &&
           exit_kind_id(left.kind) == exit_kind_id(right.kind) &&
           compare_option(left.error_type, right.error_type) == 0;
}


func usize_vec_equal(left Vec[usize], right Vec[usize]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if left[index] != right[index] {
            return false;
        }
    }
    return true;
}

func u32_vec_equal(left Vec[u32], right Vec[u32]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if left[index] != right[index] {
            return false;
        }
    }
    return true;
}

func u32_vec_copy(value Vec[u32]) Vec[u32] {
    let result = vec.empty[u32]();
    vec.reserve(result, vec.len(value));
    for item in value {
        vec.push(result, item);
    }
    return result;
}

func usize_vec_copy(value Vec[usize]) Vec[usize] {
    let result = vec.empty[usize]();
    vec.reserve(result, vec.len(value));
    for item in value {
        vec.push(result, item);
    }
    return result;
}

// std::vector<bool> style helper used by the C++ result-presence test.
func op_writes_result(op nativeir.Op) bool {
    let id = nativeir.op_id(op);
    return id != nativeir.op_id(nativeir.Op.Store) &&
           id != nativeir.op_id(nativeir.Op.StoreIndirect) &&
           id != nativeir.op_id(nativeir.Op.ExitBegin) &&
           id != nativeir.op_id(nativeir.Op.CleanupBegin) &&
           id != nativeir.op_id(nativeir.Op.CleanupEnd) &&
           id != nativeir.op_id(nativeir.Op.Take) &&
           id != nativeir.op_id(nativeir.Op.Destroy) &&
           id != nativeir.op_id(nativeir.Op.EndBorrow) &&
           id != nativeir.op_id(nativeir.Op.SaveOutput) &&
           id != nativeir.op_id(nativeir.Op.VecSet) &&
           id != nativeir.op_id(nativeir.Op.IterationEnd) &&
           id != nativeir.op_id(nativeir.Op.IterationBegin) &&
           id != nativeir.op_id(nativeir.Op.IterationNext) &&
           id != nativeir.op_id(nativeir.Op.OwnershipBegin) &&
           id != nativeir.op_id(nativeir.Op.OwnershipEnd) &&
           id != nativeir.op_id(nativeir.Op.ReplaceIndirect) &&
           id != nativeir.op_id(nativeir.Op.BeginBorrow) &&
           id != nativeir.op_id(nativeir.Op.VecCheck) &&
           id != nativeir.op_id(nativeir.Op.CPtrWrite) &&
           id != nativeir.op_id(nativeir.Op.CBufferWrite);
}

func op_is(op nativeir.Op, expected nativeir.Op) bool {
    return nativeir.op_id(op) == nativeir.op_id(expected);
}

func exit_is(kind nativeir.Exit, expected nativeir.Exit) bool {
    return nativeir.exit_id(kind) == nativeir.exit_id(expected);
}

func bool_set_is_single(value BoolSet, index usize) bool {
    var found = false;
    for var position usize = 0; position < vec.len(value.bits); position += 1 {
        if !value.bits[position] {
            continue;
        }
        if found || position != index {
            return false;
        }
        found = true;
    }
    return found;
}

func bool_set_count(value BoolSet) usize {
    var count usize = 0;
    for item in value.bits {
        if item {
            count += 1;
        }
    }
    return count;
}

func bool_set_first(value BoolSet) usize throws VerifyError {
    for var position usize = 0; position < vec.len(value.bits); position += 1 {
        if value.bits[position] {
            return position;
        }
    }
    throw support(model.SupportError.Invalid("empty block predecessor set"));
}

func bool_set_vec(count usize, value BoolSet) Vec[BoolSet] {
    let result = vec.empty[BoolSet]();
    vec.reserve(result, count);
    for var index usize = 0; index < count; index += 1 {
        vec.push(result, bool_set_copy(value));
    }
    return result;
}

func fact_set_vec(count usize, value FactSet) Vec[FactSet] {
    let result = vec.empty[FactSet]();
    vec.reserve(result, count);
    for var index usize = 0; index < count; index += 1 {
        vec.push(result, fact_set_copy(value));
    }
    return result;
}
