// Required exit/call obligations derived solely from the immutable HIR
// control tree.  Direct port of src/ir/obligations.hpp.
//
// This is not machine lowering: there is no native block, value, slot or
// marker input.  Calls remain possibly successful/failing and conditionals
// retain both edges, just as the unoptimized native CFG does (including
// literal conditions).  The context records which exit and defer caused each
// surrounding expansion, so a count cannot be satisfied by moving an
// obligation to another inline copy of the same source body.
package obligations;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/pattern" as pattern;
import "app/wzcc/types" as types;
import "app/wzcc/nativeverify/containers" as nvcontainers;
import "app/wzcc/nativeverify/support" as nvsupport;
import "std/option" as option;
import "std/vec" as vec;

// Obligation keys: the C++ tuple order is Context (vector of
// (node, kind, error, defer) tuples), then the node, kind and optional error.
pub struct ContextEntry {
    pub origin usize;
    pub kind hir.ExitKind;
    pub error_type option.Option[usize];
    pub defer_node usize;
}

pub struct ExitKey {
    pub context Vec[ContextEntry];
    pub origin usize;
    pub kind hir.ExitKind;
    pub error_type option.Option[usize];
}

pub struct CallKey {
    pub context Vec[ContextEntry];
    pub origin usize;
}

pub struct ExitObligation {
    pub key ExitKey;
    pub count usize;
}

pub struct CallObligation {
    pub key CallKey;
    pub count usize;
}

pub struct Obligations {
    pub exits Vec[ExitObligation];
    pub calls Vec[CallObligation];
}

func context_entry_compare(left ContextEntry, right ContextEntry) i32 {
    let origin_order = nvsupport.usize_compare(left.origin, right.origin);
    if origin_order != 0 {
        return origin_order;
    }
    let kind_order = nvsupport.usize_compare(usize(nvsupport.exit_kind_id(left.kind)),
        usize(nvsupport.exit_kind_id(right.kind)));
    if kind_order != 0 {
        return kind_order;
    }
    let error_order = nvsupport.compare_option(left.error_type, right.error_type);
    if error_order != 0 {
        return error_order;
    }
    return nvsupport.usize_compare(left.defer_node, right.defer_node);
}

func context_compare(left Vec[ContextEntry], right Vec[ContextEntry]) i32 {
    var count = vec.len(left);
    if vec.len(right) < count {
        count = vec.len(right);
    }
    for var index usize = 0; index < count; index += 1 {
        let order = context_entry_compare(left[index], right[index]);
        if order != 0 {
            return order;
        }
    }
    return nvsupport.usize_compare(vec.len(left), vec.len(right));
}

func exit_key_compare(left ExitKey, right ExitKey) i32 {
    let context_order = context_compare(left.context, right.context);
    if context_order != 0 {
        return context_order;
    }
    let origin_order = nvsupport.usize_compare(left.origin, right.origin);
    if origin_order != 0 {
        return origin_order;
    }
    let kind_order = nvsupport.usize_compare(usize(nvsupport.exit_kind_id(left.kind)),
        usize(nvsupport.exit_kind_id(right.kind)));
    if kind_order != 0 {
        return kind_order;
    }
    return nvsupport.compare_option(left.error_type, right.error_type);
}

func call_key_compare(left CallKey, right CallKey) i32 {
    let context_order = context_compare(left.context, right.context);
    if context_order != 0 {
        return context_order;
    }
    return nvsupport.usize_compare(left.origin, right.origin);
}

func exit_obligation_compare(left ExitObligation,
                             right ExitObligation) i32 {
    return exit_key_compare(left.key, right.key);
}

func call_obligation_compare(left CallObligation,
                             right CallObligation) i32 {
    return call_key_compare(left.key, right.key);
}

pub func obligations() Obligations {
    return Obligations(exits: vec.empty[ExitObligation](),
        calls: vec.empty[CallObligation]());
}

pub func obligation_add_exit(state inout Obligations, context Vec[ContextEntry],
                         origin usize, kind hir.ExitKind,
                         error_type option.Option[usize]) {
    let key = ExitKey(context: context, origin: origin, kind: kind,
        error_type: error_type);
    let probe = ExitObligation(key: key, count: 0);
    let at = nvsupport.sorted_position(state.exits, probe, exit_obligation_compare);
    if at < vec.len(state.exits) &&
       exit_obligation_compare(state.exits[at], probe) == 0 {
        state.exits[at].count += 1;
        return;
    }
    let entry = ExitObligation(key: key, count: 1);
    vec.push(state.exits, entry);
    for var index usize = vec.len(state.exits) - 1; index > at; index -= 1 {
        state.exits[index] = state.exits[index - 1];
    }
    state.exits[at] = entry;
}

pub func obligation_add_call(state inout Obligations, context Vec[ContextEntry],
                         origin usize) {
    let key = CallKey(context: context, origin: origin);
    let probe = CallObligation(key: key, count: 0);
    let at = nvsupport.sorted_position(state.calls, probe, call_obligation_compare);
    if at < vec.len(state.calls) &&
       call_obligation_compare(state.calls[at], probe) == 0 {
        state.calls[at].count += 1;
        return;
    }
    let entry = CallObligation(key: key, count: 1);
    vec.push(state.calls, entry);
    for var index usize = vec.len(state.calls) - 1; index > at; index -= 1 {
        state.calls[index] = state.calls[index - 1];
    }
    state.calls[at] = entry;
}

pub func obligations_equal_exits(left Vec[ExitObligation],
                             right Vec[ExitObligation]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if exit_obligation_compare(left[index], right[index]) != 0 ||
           left[index].count != right[index].count {
            return false;
        }
    }
    return true;
}

pub func obligations_equal_calls(left Vec[CallObligation],
                             right Vec[CallObligation]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if call_obligation_compare(left[index], right[index]) != 0 ||
           left[index].count != right[index].count {
            return false;
        }
    }
    return true;
}

func context_copy(values Vec[ContextEntry]) Vec[ContextEntry] {
    let result = vec.empty[ContextEntry]();
    vec.reserve(result, vec.len(values));
    for value in values {
        vec.push(result, value);
    }
    return result;
}

struct Flow {
    falls bool;
    breaks nvcontainers.NodeSet;
    continues nvcontainers.NodeSet;
    catches nvcontainers.CatchSet;
}

func empty_flow() Flow {
    return Flow(falls: true, breaks: nvcontainers.node_set(), continues: nvcontainers.node_set(),
        catches: nvcontainers.catch_set());
}

func flow_merge(target inout Flow, other Flow) {
    for value in other.breaks.values {
        nvcontainers.node_set_insert(inout target.breaks, value);
    }
    for value in other.continues.values {
        nvcontainers.node_set_insert(inout target.continues, value);
    }
    for value in other.catches.values {
        nvcontainers.catch_set_insert(inout target.catches, value);
    }
}

struct Required {
    h hir.HirModule;
    obligations Obligations;
    context Vec[ContextEntry];
}

// The HIR node of a plan/exit; C++ uses nodes.at, i.e. an out-of-range id is
// an internal data error, never a silent skip.
func required_node(state Required, id usize) hir.HirNode throws nvsupport.VerifyError {
    return nvsupport.hir_node(state.h, id);
}

func required_exit(state inout Required, id usize, kind hir.ExitKind,
                   error_type option.Option[usize]) Flow throws nvsupport.VerifyError {
    let node = required_node(state, id);
    var flow = empty_flow();
    for plan in node.exits {
        if nvsupport.exit_kind_id(plan.kind) != nvsupport.exit_kind_id(kind) ||
           nvsupport.compare_option(plan.error_type, error_type) != 0 {
            continue;
        }
        obligation_add_exit(inout state.obligations,
            context_copy(state.context), id, kind, error_type);
        let defers = plan.defers;
        for defer_node in defers {
            vec.push(state.context, ContextEntry(origin: id, kind: kind,
                error_type: error_type, defer_node: defer_node));
            let defer_body = required_node(state, defer_node);
            let body = required_stmt(inout state, defer_body.children[0]);
            flow_merge(inout flow, body);
            let popped = vec.pop(state.context);
            switch popped {
                case option.Option.Some(item): {}
                case option.Option.None: {}
            }
        }
        switch plan.target {
            case hir.ExitTarget.CatchTarget(target): {
                nvcontainers.catch_set_insert(inout flow.catches,
                    nvcontainers.CatchKey(try_node: target.try_node, index: target.index));
            }
            default: {}
        }
    }
    return flow;
}

func required_expr(state inout Required, id usize) Flow throws nvsupport.VerifyError {
    let node = required_node(state, id);
    var flow = empty_flow();
    for child in node.children {
        let child_flow = required_expr(inout state, child);
        flow_merge(inout flow, child_flow);
    }
    switch node.data {
        case hir.NodeData.Call(call): {
            obligation_add_call(inout state.obligations,
                context_copy(state.context), id);
            let signature = nvsupport.require_type(state.h, call.signature,
                node.source.span);
            switch signature.throws_type {
                case option.Option.Some(error_type): {
                    let exit_flow = required_exit(inout state, id,
                        hir.ExitKind.Error, option.Option[usize].Some(error_type));
                    flow_merge(inout flow, exit_flow);
                }
                case option.Option.None: {}
            }
        }
        default: {}
    }
    if nvsupport.kind_is(hir.node_kind(node.data), hir.NodeKind.Await) {
        let child = required_node(state, node.children[0]);
        let task = nvsupport.require_type(state.h, child.type_id, node.source.span);
        if !nvsupport.type_is(task.kind, model.TypeKind.Task) ||
           vec.len(task.type_args) != 2 {
            throw nvsupport.support(model.SupportError.Invalid(
                "await child is not a Task"));
        }
        let error_type = task.type_args[1];
        let error = nvsupport.require_type(state.h, error_type, node.source.span);
        if !nvsupport.type_is(error.kind, model.TypeKind.Unit) {
            let error_flow = required_exit(inout state, id, hir.ExitKind.Error,
                option.Option[usize].Some(error_type));
            flow_merge(inout flow, error_flow);
        }
        let cancel_flow = required_exit(inout state, id, hir.ExitKind.Cancel,
            option.Option[usize].None);
        flow_merge(inout flow, cancel_flow);
    }
    return flow;
}

func required_stmt(state inout Required, id usize) Flow throws nvsupport.VerifyError {
    let node = required_node(state, id);
    var flow = empty_flow();
    switch node.data {
        case hir.NodeData.Defer(payload): return flow;
        case hir.NodeData.Noop(payload): return flow;
        case hir.NodeData.Block(payload): {
            for child in node.children {
                if !flow.falls {
                    break;
                }
                let next = required_stmt(inout state, child);
                flow_merge(inout flow, next);
                flow.falls = next.falls;
            }
            if flow.falls {
                let exit_flow = required_exit(inout state, id,
                    hir.ExitKind.Normal, option.Option[usize].None);
                flow_merge(inout flow, exit_flow);
            }
            return flow;
        }
        case hir.NodeData.Return(payload): {
            if vec.len(node.children) > 0 {
                let value_flow = required_expr(inout state, node.children[0]);
                flow_merge(inout flow, value_flow);
            }
            let exit_flow = required_exit(inout state, id,
                hir.ExitKind.Return, option.Option[usize].None);
            flow_merge(inout flow, exit_flow);
            flow.falls = false;
            return flow;
        }
        case hir.NodeData.Throw(payload): {
            let value_flow = required_expr(inout state, node.children[0]);
            flow_merge(inout flow, value_flow);
            let value = required_node(state, node.children[0]);
            let exit_flow = required_exit(inout state, id, hir.ExitKind.Error,
                option.Option[usize].Some(value.type_id));
            flow_merge(inout flow, exit_flow);
            flow.falls = false;
            return flow;
        }
        case hir.NodeData.Break(payload): {
            let exit_flow = required_exit(inout state, id, hir.ExitKind.Break,
                option.Option[usize].None);
            flow_merge(inout flow, exit_flow);
            nvcontainers.node_set_insert(inout flow.breaks, payload.loop);
            flow.falls = false;
            return flow;
        }
        case hir.NodeData.Continue(payload): {
            let exit_flow = required_exit(inout state, id,
                hir.ExitKind.Continue, option.Option[usize].None);
            flow_merge(inout flow, exit_flow);
            nvcontainers.node_set_insert(inout flow.continues, payload.loop);
            flow.falls = false;
            return flow;
        }
        case hir.NodeData.If(payload): {
            let condition_flow = required_expr(inout state, node.children[0]);
            flow_merge(inout flow, condition_flow);
            let yes = required_stmt(inout state, node.children[1]);
            var no = empty_flow();
            if vec.len(node.children) == 3 {
                no = required_stmt(inout state, node.children[2]);
            }
            flow_merge(inout flow, yes);
            flow_merge(inout flow, no);
            flow.falls = yes.falls || no.falls;
            return flow;
        }
        case hir.NodeData.ForIn(payload): {
            let iterable_flow = required_expr(inout state, node.children[0]);
            flow_merge(inout flow, iterable_flow);
            switch payload.iterator {
                case option.Option.Some(iterator): {
                    let next_flow = required_expr(inout state, iterator.next);
                    flow_merge(inout flow, next_flow);
                }
                case option.Option.None: {}
            }
            let body = required_stmt(inout state, payload.body);
            flow_merge(inout flow, body);
            nvcontainers.node_set_remove(inout flow.breaks, id);
            nvcontainers.node_set_remove(inout flow.continues, id);
            let exit_flow = required_exit(inout state, id,
                hir.ExitKind.Normal, option.Option[usize].None);
            flow_merge(inout flow, exit_flow);
            flow.falls = true;
            return flow;
        }
        case hir.NodeData.For(payload): {
            flow = required_stmt(inout state, node.children[0]);
            if !flow.falls {
                return flow;
            }
            let condition_flow = required_expr(inout state, node.children[1]);
            flow_merge(inout flow, condition_flow);
            let body = required_stmt(inout state, node.children[3]);
            // HIR stores step before body; execution performs body first.
            if body.falls || nvcontainers.node_set_has(body.continues, id) {
                let step = required_stmt(inout state, node.children[2]);
                flow_merge(inout flow, step);
            }
            flow_merge(inout flow, body);
            nvcontainers.node_set_remove(inout flow.breaks, id);
            nvcontainers.node_set_remove(inout flow.continues, id);
            let exit_flow = required_exit(inout state, id,
                hir.ExitKind.Normal, option.Option[usize].None);
            flow_merge(inout flow, exit_flow);
            flow.falls = true;
            return flow;
        }
        case hir.NodeData.Switch(payload): {
            let scrutinee_flow = required_expr(inout state, node.children[0]);
            flow_merge(inout flow, scrutinee_flow);
            flow.falls = false;
            // C++ copies the module TypeContext once per switch; substitution
            // inside the pattern package appends only to that private copy.
            // The lookup closure shares the same private entry array through
            // the Vec handle, so ids stay consistent across lookups.
            let module = state.h;
            let scratch = types.clone_context(state.h.types);
            let lookup = func(type_id usize) pattern.Domain
                throws model.SupportError {
                var context = scratch;
                return pattern.pattern_domain(module, type_id, inout context);
            };
            let scrutinee = required_node(state, node.children[0]);
            var coverage = pattern.coverage(scrutinee.type_id, lookup, 100000);
            for arm in payload.arms {
                var useful = false;
                try {
                    useful = pattern.add(inout coverage, arm.pattern);
                } catch error model.SupportError {
                    throw nvsupport.support(error);
                }
                // Recompute nested arm reachability with the same
                // constructor-column analysis as semantic checking and HIR
                // verification.  A flat outer-variant set cannot decide when
                // the same outer variant has several payload combinations.
                if !useful {
                    break;
                }
                let branch = required_stmt(inout state, arm.body);
                flow_merge(inout flow, branch);
                flow.falls = flow.falls || branch.falls;
            }
            if nvcontainers.node_set_remove(inout flow.breaks, id) {
                flow.falls = true;
            }
            return flow;
        }
        case hir.NodeData.Try(payload): {
            flow = required_stmt(inout state, node.children[0]);
            let catches = payload.catches;
            for var index usize = 0; index < vec.len(catches); index += 1 {
                let key = nvcontainers.CatchKey(try_node: id, index: u32(index));
                if nvcontainers.catch_set_remove(inout flow.catches, key) {
                    let handler = required_stmt(inout state,
                        catches[index].body);
                    flow_merge(inout flow, handler);
                    flow.falls = flow.falls || handler.falls;
                }
            }
            return flow;
        }
        default: {
            return required_expr(inout state, id);
        }
    }
}

pub func required_exits(h hir.HirModule, function hir.HirFunction) Obligations
    throws nvsupport.VerifyError {
    var state = Required(h: h, obligations: obligations(),
        context: vec.empty[ContextEntry]());
    let flow = required_stmt(inout state, function.body);
    return state.obligations;
}
