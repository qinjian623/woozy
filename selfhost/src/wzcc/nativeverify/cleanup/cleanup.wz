// Cleanup/exit dataflow.
//
// Direct port of the cleanup half of src/ir/verify.cpp.  It is an independent
// CFG dataflow over immutable HIR plans: it never calls lowering and never
// trusts the copied cleanup order in the Native IR.  Every instruction must
// stay inside the defer bodies of the cleanup frames that are active on its
// path; every exit must consume its HIR plan exactly once, in order, with the
// same owner identities and saved values.
package cleanup;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/nativeverify/cfg" as nvcfg;
import "app/wzcc/nativeverify/containers" as nvcontainers;
import "app/wzcc/nativeverify/obligations" as nvobligations;
import "app/wzcc/nativeverify/state" as nvstate;
import "app/wzcc/nativeverify/support" as nvsupport;
import "std/option" as option;
import "std/vec" as vec;

struct Frame {
    site nativeir.ExitSite;
    next usize;
    active bool;
    saved Vec[usize];
    action usize;
}

func frame_equal(left Frame, right Frame) bool {
    return nvsupport.exit_site_equal(left.site, right.site) && left.next == right.next &&
           left.active == right.active && left.action == right.action &&
           nvsupport.usize_vec_equal(left.saved, right.saved);
}

func frame_copy(value Frame) Frame {
    return Frame(site: value.site, next: value.next, active: value.active,
        saved: nvsupport.usize_vec_copy(value.saved), action: value.action);
}

func state_copy(value Vec[Frame]) Vec[Frame] {
    let result = vec.empty[Frame]();
    vec.reserve(result, vec.len(value));
    for frame in value {
        vec.push(result, frame_copy(frame));
    }
    return result;
}

func states_equal(left Vec[Frame], right Vec[Frame]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if !frame_equal(left[index], right[index]) {
            return false;
        }
    }
    return true;
}

// C++ node(): the plan/defer identity must belong to this function's HIR.
func cleanup_node(state nvstate.Body, id usize) hir.HirNode throws nvsupport.VerifyError {
    nvsupport.need(id < vec.len(state.m.h.nodes) &&
             nvsupport.hir_scope_function(state.m.h,
                 state.m.h.nodes[id].scope) == state.f.symbol,
         "exit/cleanup from another function", state.f.source);
    return state.m.h.nodes[id];
}

func exit_plan(state nvstate.Body, site nativeir.ExitSite) hir.ExitPlan
    throws nvsupport.VerifyError {
    let node = cleanup_node(state, site.origin);
    for plan in node.exits {
        if nvsupport.exit_kind_id(plan.kind) == nvsupport.exit_kind_id(site.kind) &&
           nvsupport.compare_option(plan.error_type, site.error_type) == 0 {
            return plan;
        }
    }
    throw nvsupport.bad("exit marker without HIR plan", state.f.source);
}

func cleanup_context(state nvstate.Body, frames Vec[Frame])
    Vec[nvobligations.ContextEntry] throws nvsupport.VerifyError {
    let result = vec.empty[nvobligations.ContextEntry]();
    for frame in frames {
        if !frame.active {
            continue;
        }
        let plan = exit_plan(state, frame.site);
        if frame.next >= vec.len(plan.defers) {
            throw nvsupport.support(model.SupportError.Invalid(
                "cleanup frame has no next defer"));
        }
        vec.push(result, nvobligations.ContextEntry(origin: frame.site.origin,
            kind: frame.site.kind, error_type: frame.site.error_type,
            defer_node: plan.defers[frame.next]));
    }
    return result;
}

func owning_action_kind(op nativeir.Op) hir.CleanupKind {
    if nvsupport.op_is(op, nativeir.Op.Destroy) {
        return hir.CleanupKind.DestroyIfLive;
    }
    if nvsupport.op_is(op, nativeir.Op.EndBorrow) {
        return hir.CleanupKind.EndBorrow;
    }
    if nvsupport.op_is(op, nativeir.Op.SaveOutput) {
        return hir.CleanupKind.SaveOutput;
    }
    return hir.CleanupKind.EndIteration;
}

func collect_handlers(state inout nvstate.Body, handlers inout nvcontainers.HandlerMap,
                      handler_blocks inout nvcontainers.BoolSet,
                      handler_slots inout nvcontainers.BoolSet,
                      instances inout nvcontainers.InstanceSet) throws nvsupport.VerifyError {
    for handler in state.f.handlers {
        let node = cleanup_node(state, handler.target.try_node);
        var catches = vec.empty[hir.Catch]();
        var is_try = false;
        switch node.data {
            case hir.NodeData.Try(try_value):
                catches = try_value.catches; is_try = true;
            default: {}
        }
        nvsupport.need(is_try && usize(handler.target.index) < vec.len(catches) &&
                 handler.block < vec.len(state.f.blocks) &&
                 handler.protected_entry < vec.len(state.f.blocks) &&
                 handler.slot < vec.len(state.f.slots),
             "invalid native handler", state.f.source);
        let incoming = state.predecessors[handler.protected_entry];
        nvsupport.need(nvcontainers.bool_set_count(incoming) == 1,
             "handler protected entry is not a concrete Try entry",
             state.f.source);
        let predecessor = nvcontainers.bool_set_first(incoming);
        let entry = state.f.blocks[predecessor].terminator;
        nvsupport.need(nvsupport.exit_is(entry.kind, nativeir.Exit.Branch) &&
                 nvsupport.compare_option(entry.origin,
                     option.Option[usize].Some(handler.target.try_node)) == 0 &&
                 nvsupport.same_span(entry.source, node.source.span),
             "handler protected entry differs from source Try",
             state.f.source);
        let catch_error = catches[usize(handler.target.index)].error_type;
        nvsupport.need(state.f.slots[handler.slot].type_id == catch_error &&
                 !option.is_some(state.f.slots[handler.slot].parameter) &&
                 handler.block != handler.protected_entry &&
                 nvcontainers.bool_set_add(inout handler_blocks, handler.block) &&
                 nvcontainers.bool_set_add(inout handler_slots, handler.slot) &&
                 nvcontainers.instance_set_insert(inout instances, handler.target.try_node,
                     handler.target.index, handler.protected_entry) &&
                 nvcontainers.handler_insert(inout handlers, handler.target.try_node,
                     handler.target.index, handler.block, handler),
             "handler binding type/identity", state.f.source);
    }
}

// Independent CFG dataflow over exit obligations.  Reads immutable HIR plans,
// never calls Lower and never trusts copied cleanup order in Native IR.
pub func cleanup(state inout nvstate.Body) throws nvsupport.VerifyError {
    var handlers = nvcontainers.handler_map();
    var handler_blocks = nvcontainers.bool_set(vec.len(state.f.blocks));
    var handler_slots = nvcontainers.bool_set(vec.len(state.f.slots));
    var instances = nvcontainers.instance_set();
    collect_handlers(inout state, inout handlers, inout handler_blocks,
        inout handler_slots, inout instances);
    var actual = nvobligations.obligations();
    var states = vec.make[option.Option[Vec[Frame]]](vec.len(state.f.blocks),
        option.Option[Vec[Frame]].None);
    states[0] = option.Option[Vec[Frame]].Some(vec.empty[Frame]());
    var work = vec.empty[usize]();
    vec.push(work, 0);
    for vec.len(work) > 0 {
        let popped = vec.pop(work);
        var block usize = 0;
        switch popped {
            case option.Option.Some(value): block = value;
            case option.Option.None: {}
        }
        var current = vec.empty[Frame]();
        switch states[block] {
            case option.Option.Some(value): current = state_copy(value);
            case option.Option.None: {}
        }
        let bb = state.f.blocks[block];
        var ownership_batch = false;
        for instruction in bb.instructions {
            if nvsupport.op_is(instruction.op, nativeir.Op.OwnershipBegin) ||
               nvsupport.op_is(instruction.op, nativeir.Op.OwnershipEnd) {
                ownership_batch =
                    nvsupport.op_is(instruction.op, nativeir.Op.OwnershipBegin);
            }
            if nvsupport.op_is(instruction.op, nativeir.Op.Destroy) &&
               instruction.slot < vec.len(state.f.slots) &&
               nvsupport.owner_kind_is(state.f.slots[instruction.slot].owner,
                   hir.OwnerKind.Temporary) {
                var allowed = ownership_batch;
                if !allowed {
                    allowed = vec.len(current) > 0 &&
                              !current[vec.len(current) - 1].active;
                }
                nvsupport.need(allowed,
                     "temporary destroy outside a verified cleanup plan",
                     instruction.source);
            }
            if !nvsupport.op_is(instruction.op, nativeir.Op.CleanupBegin) &&
               !nvsupport.op_is(instruction.op, nativeir.Op.CleanupEnd) {
                for frame in current {
                    if !frame.active {
                        continue;
                    }
                    let plan = exit_plan(state, frame.site);
                    if frame.next >= vec.len(plan.defers) {
                        throw nvsupport.support(model.SupportError.Invalid(
                            "cleanup frame has no next defer"));
                    }
                    let defer_node = cleanup_node(state,
                        plan.defers[frame.next]);
                    let range = cleanup_node(state,
                        nvcfg.hir_child(defer_node, 0)).source.span;
                    nvsupport.need(nvsupport.span_contains(range, instruction.source),
                         "instruction moved across cleanup bodies",
                         instruction.source);
                }
            }
            if (nvsupport.op_is(instruction.op, nativeir.Op.Call) ||
                nvsupport.op_is(instruction.op, nativeir.Op.SystemCall) ||
                nvsupport.op_is(instruction.op, nativeir.Op.ForeignCall)) &&
               !nvcontainers.bool_set_has(state.impossible, block) {
                nvobligations.obligation_add_call(inout actual,
                    cleanup_context(state, current),
                    nvsupport.option_usize(instruction.origin));
            }
            if nvsupport.op_is(instruction.op, nativeir.Op.ExitBegin) {
                var site = nativeir.ExitSite(origin: 0,
                    kind: hir.ExitKind.Normal,
                    error_type: option.Option[usize].None);
                var has_site = false;
                switch instruction.exit {
                    case option.Option.Some(value): site = value; has_site = true;
                    case option.Option.None: {}
                }
                nvsupport.need(has_site, "exit marker without HIR plan",
                    instruction.source);
                if !nvcontainers.bool_set_has(state.impossible, block) {
                    nvobligations.obligation_add_exit(inout actual,
                        cleanup_context(state, current), site.origin,
                        site.kind, site.error_type);
                }
                let plan = exit_plan(state, site);
                nvsupport.need(vec.len(current) == 0 ||
                         current[vec.len(current) - 1].active,
                     "exit begins during pending cleanup", instruction.source);
                var expected_inputs usize = 0;
                if plan.saves_value {
                    expected_inputs = 1;
                }
                nvsupport.need(vec.len(instruction.inputs) == expected_inputs,
                     "exit value not saved before cleanup", instruction.source);
                vec.push(current, Frame(site: site, next: 0, active: false,
                    saved: nvsupport.usize_vec_copy(instruction.inputs), action: 0));
            } else if nvsupport.op_is(instruction.op, nativeir.Op.CleanupBegin) {
                nvsupport.need(vec.len(current) > 0,
                     "cleanup without exit obligation", instruction.source);
                let last = vec.len(current) - 1;
                let top = current[last];
                let plan = exit_plan(state, top.site);
                var cleanup_id usize = 0;
                var has_cleanup = false;
                switch instruction.cleanup {
                    case option.Option.Some(value):
                        cleanup_id = value; has_cleanup = true;
                    case option.Option.None: {}
                }
                nvsupport.need(!top.active && top.next < vec.len(plan.defers) &&
                         has_cleanup &&
                         plan.defers[top.next] == cleanup_id &&
                         nvsupport.kind_is(hir.node_kind(cleanup_node(state,
                                      cleanup_id).data),
                             hir.NodeKind.Defer),
                     "cleanup registration/order differs from HIR",
                     instruction.source);
                if vec.len(plan.actions) > 0 {
                    nvsupport.need(top.action < vec.len(plan.actions) &&
                             nvsupport.cleanup_kind_id(
                                 plan.actions[top.action].kind) ==
                                 nvsupport.cleanup_kind_id(hir.CleanupKind.Defer) &&
                             plan.actions[top.action].owner.identity ==
                                 u64(cleanup_id),
                         "defer moved across destroy/output actions",
                         instruction.source);
                }
                var updated = top;
                updated.active = true;
                current[last] = updated;
            } else if nvsupport.op_is(instruction.op, nativeir.Op.CleanupEnd) {
                nvsupport.need(vec.len(current) > 0,
                     "cleanup end without begin", instruction.source);
                let last = vec.len(current) - 1;
                let top = current[last];
                let plan = exit_plan(state, top.site);
                var cleanup_id usize = 0;
                var has_cleanup = false;
                switch instruction.cleanup {
                    case option.Option.Some(value):
                        cleanup_id = value; has_cleanup = true;
                    case option.Option.None: {}
                }
                nvsupport.need(top.active && has_cleanup &&
                         top.next < vec.len(plan.defers) &&
                         plan.defers[top.next] == cleanup_id,
                     "cleanup end mismatch", instruction.source);
                var updated = top;
                updated.active = false;
                updated.next += 1;
                if vec.len(plan.actions) > 0 {
                    updated.action += 1;
                }
                current[last] = updated;
            } else if vec.len(current) > 0 &&
                      !current[vec.len(current) - 1].active &&
                      (nvsupport.op_is(instruction.op, nativeir.Op.Destroy) ||
                       nvsupport.op_is(instruction.op, nativeir.Op.EndBorrow) ||
                       nvsupport.op_is(instruction.op, nativeir.Op.SaveOutput) ||
                       nvsupport.op_is(instruction.op, nativeir.Op.IterationEnd)) {
                let last = vec.len(current) - 1;
                let top = current[last];
                let plan = exit_plan(state, top.site);
                nvsupport.need(top.action < vec.len(plan.actions),
                     "extra owning cleanup", instruction.source);
                let expected = plan.actions[top.action];
                var updated = top;
                updated.action += 1;
                current[last] = updated;
                let kind = owning_action_kind(instruction.op);
                nvsupport.need(nvsupport.cleanup_kind_id(kind) == nvsupport.cleanup_kind_id(expected.kind) &&
                         nvsupport.owner_ref_option_equal(instruction.owner,
                             option.Option[hir.OwnerRef].Some(expected.owner)),
                     "actual owning operation/order differs from HIR exit",
                     instruction.source);
                if nvsupport.op_is(instruction.op, nativeir.Op.SaveOutput) {
                    nvsupport.need(nvsupport.usize_vec_equal(instruction.inputs, top.saved),
                         "saved wrong owning output", instruction.source);
                }
                if nvsupport.op_is(instruction.op, nativeir.Op.Destroy) {
                    nvsupport.need(instruction.slot < vec.len(state.f.slots) &&
                             state.f.slots[instruction.slot].type_id ==
                                 expected.type_id,
                         "destroy type differs from HIR", instruction.source);
                }
            }
        }
        let terminator = bb.terminator;
        if nvsupport.exit_is(terminator.kind, nativeir.Exit.TryCall) &&
           !nvcontainers.bool_set_has(state.impossible, block) {
            nvobligations.obligation_add_call(inout actual, cleanup_context(state, current),
                nvsupport.option_usize(terminator.origin));
        }
        if option.is_some(terminator.origin) &&
           (nvsupport.exit_is(terminator.kind, nativeir.Exit.Return) ||
            nvsupport.exit_is(terminator.kind, nativeir.Exit.ErrorReturn)) {
            // A function-level edge must apply its matching HIR plan when one
            // is recorded.  Trivial exits have no plan.  Await's cancel plan
            // belongs to its separate cancel_return edge, and a caught error
            // plan is applied on a branch whose t.exit is validated below.
            var wanted = hir.ExitKind.Return;
            if nvsupport.exit_is(terminator.kind, nativeir.Exit.ErrorReturn) {
                wanted = hir.ExitKind.Error;
            }
            let origin = cleanup_node(state, nvsupport.option_usize(terminator.origin));
            for plan in origin.exits {
                if nvsupport.exit_kind_id(plan.kind) != nvsupport.exit_kind_id(wanted) {
                    continue;
                }
                var matches = false;
                switch terminator.exit {
                    case option.Option.Some(site): {
                        matches = site.origin ==
                                      nvsupport.option_usize(terminator.origin) &&
                                  nvsupport.exit_kind_id(site.kind) ==
                                      nvsupport.exit_kind_id(plan.kind) &&
                                  nvsupport.compare_option(site.error_type,
                                      plan.error_type) == 0;
                    }
                    case option.Option.None: {}
                }
                nvsupport.need(matches, "exit omitted required cleanup plan",
                    terminator.source);
            }
        }
        if nvsupport.exit_is(terminator.kind, nativeir.Exit.Await) {
            // The await node owns exactly one error plan (when E is not Unit)
            // and one cancel plan; both must be present at the matching exit
            // blocks.
            let node = cleanup_node(state, nvsupport.option_usize(terminator.origin));
            let task = nvsupport.require_type(state.m.h, terminator.signature,
                terminator.source);
            let error_type = nvsupport.type_arg(task, 1, terminator.source);
            var errors usize = 0;
            var cancels usize = 0;
            for plan in node.exits {
                if nvsupport.exit_kind_id(plan.kind) == nvsupport.exit_kind_id(hir.ExitKind.Error) {
                    errors += 1;
                }
                if nvsupport.exit_kind_id(plan.kind) ==
                   nvsupport.exit_kind_id(hir.ExitKind.Cancel) {
                    cancels += 1;
                }
            }
            var expected_errors usize = 1;
            if nvsupport.type_is(nvsupport.require_type(state.m.h, error_type,
                    terminator.source).kind, model.TypeKind.Unit) {
                expected_errors = 0;
            }
            nvsupport.need(errors == expected_errors && cancels == 1,
                 "await cleanup plans", terminator.source);
        }
        var has_exit = false;
        var exit_site = nativeir.ExitSite(origin: 0,
            kind: hir.ExitKind.Normal, error_type: option.Option[usize].None);
        switch terminator.exit {
            case option.Option.Some(value): has_exit = true; exit_site = value;
            case option.Option.None: {}
        }
        if has_exit {
            let plan = exit_plan(state, exit_site);
            nvsupport.need(nvsupport.compare_option(terminator.origin,
                     option.Option[usize].Some(exit_site.origin)) == 0 &&
                     vec.len(current) > 0,
                 "exit end without begin", terminator.source);
            let last = vec.len(current) - 1;
            let top = current[last];
            nvsupport.need(nvsupport.exit_site_equal(top.site, exit_site) && !top.active &&
                     top.next == vec.len(plan.defers) &&
                     top.action == vec.len(plan.actions),
                 "exit before all cleanups completed", terminator.source);
            if nvsupport.exit_kind_id(plan.kind) == nvsupport.exit_kind_id(hir.ExitKind.Return) ||
               nvsupport.exit_kind_id(plan.kind) == nvsupport.exit_kind_id(hir.ExitKind.Error) {
                var catch_target = hir.CatchTarget(try_node: 0, index: 0);
                var is_catch = false;
                switch plan.target {
                    case hir.ExitTarget.CatchTarget(value):
                        catch_target = value; is_catch = true;
                    default: {}
                }
                if is_catch {
                    nvsupport.need(nvsupport.exit_is(terminator.kind, nativeir.Exit.Branch),
                         "catch exit is not a branch", terminator.source);
                    let found = nvcontainers.handler_find(handlers, catch_target.try_node,
                        catch_target.index, terminator.targets[0]);
                    var handler = nvcontainers.default_handler();
                    var has_handler = false;
                    switch found {
                        case option.Option.Some(value):
                            handler = value; has_handler = true;
                        case option.Option.None: {}
                    }
                    nvsupport.need(has_handler &&
                             terminator.targets[0] == handler.block &&
                             vec.len(top.saved) > 0 &&
                             nvcontainers.bool_set_has(state.dom[block],
                                 handler.protected_entry),
                         "error delivered to wrong handler",
                         terminator.source);
                    nvsupport.need(vec.len(bb.instructions) > 0,
                         "missing error binding store", terminator.source);
                    let store = bb.instructions[vec.len(bb.instructions) - 1];
                    nvsupport.need(nvsupport.op_is(store.op, nativeir.Op.Store) &&
                             store.slot == handler.slot &&
                             nvsupport.usize_vec_equal(store.inputs, top.saved),
                         "handler received different error value",
                         terminator.source);
                } else {
                    var expected_kind = nativeir.Exit.Return;
                    if nvsupport.exit_kind_id(plan.kind) ==
                       nvsupport.exit_kind_id(hir.ExitKind.Error) {
                        expected_kind = nativeir.Exit.ErrorReturn;
                    }
                    nvsupport.need(nvsupport.exit_is(terminator.kind, expected_kind),
                         "wrong function exit kind", terminator.source);
                    if plan.saves_value {
                        nvsupport.need(nvsupport.usize_vec_equal(terminator.inputs, top.saved),
                             "exit value changed after cleanup",
                             terminator.source);
                    }
                }
            } else if nvsupport.exit_kind_id(plan.kind) ==
                      nvsupport.exit_kind_id(hir.ExitKind.Cancel) {
                nvsupport.need(nvsupport.exit_is(terminator.kind, nativeir.Exit.CancelReturn),
                     "cancel exit kind", terminator.source);
            } else {
                nvsupport.need(nvsupport.exit_is(terminator.kind, nativeir.Exit.Branch),
                     "normal/jump exit is not branch", terminator.source);
            }
            let popped_frame = vec.pop(current);
            switch popped_frame {
                case option.Option.Some(value): {}
                case option.Option.None: {}
            }
        }
        // An exhaustive enum switch's default edge cannot execute, even when
        // generated inside a cleanup.  Other unfinished exits remain invalid.
        if nvsupport.exit_is(terminator.kind, nativeir.Exit.Return) ||
           nvsupport.exit_is(terminator.kind, nativeir.Exit.ErrorReturn) ||
           nvsupport.exit_is(terminator.kind, nativeir.Exit.CancelReturn) ||
           (nvsupport.exit_is(terminator.kind, nativeir.Exit.Unreachable) &&
            !nvcontainers.bool_set_has(state.impossible, block)) {
            nvsupport.need(vec.len(current) == 0,
                 "function exits with unfinished cleanup", terminator.source);
        }
        for target in terminator.targets {
            var known = false;
            switch states[target] {
                case option.Option.Some(value): {
                    known = true;
                    nvsupport.need(states_equal(value, current),
                         "inconsistent cleanup state at CFG join",
                         terminator.source);
                }
                case option.Option.None: {}
            }
            if !known {
                states[target] = option.Option[Vec[Frame]].Some(
                    state_copy(current));
                vec.push(work, target);
            }
        }
    }
    var source_function = hir.HirFunction(symbol: 0, signature: 0,
        parameters: [], body: 0, scope: 0,
        source: hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: 0),
            span: nvsupport.empty_span()), captures: [], is_async: false);
    var found_source = false;
    for candidate in state.m.h.functions {
        if candidate.symbol == state.f.symbol {
            source_function = candidate;
            found_source = true;
        }
    }
    nvsupport.need(found_source, "missing HIR function for exit obligations",
        state.f.source);
    let expected = nvobligations.required_exits(state.m.h, source_function);
    nvsupport.need(nvobligations.obligations_equal_exits(actual.exits, expected.exits),
         "required HIR exit/cleanup occurrence missing or duplicated",
         state.f.source);
    nvsupport.need(nvobligations.obligations_equal_calls(actual.calls, expected.calls),
         "required HIR call occurrence missing or duplicated",
         state.f.source);
}
