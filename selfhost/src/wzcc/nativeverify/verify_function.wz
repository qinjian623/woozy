// Whole-module verifier setup and ordered function run.
package nativeverify;

import "app/wzcc/model" as model;
import "app/wzcc/nativeverify/containers" as nvcontainers;
import "app/wzcc/nativeverify/state" as nvstate;
import "app/wzcc/nativeverify/support" as nvsupport;
import "std/option" as option;
import "std/vec" as vec;

// C++ Verifier::run before any function body is inspected.
func run_module(state inout nvstate.ModuleState) throws nvsupport.VerifyError {
    var source = nvsupport.empty_span();
    if vec.len(state.h.functions) > 0 {
        source = state.h.functions[0].source.span;
    }
    nvsupport.need(nvsupport.backend_id(state.config.backend) == nvsupport.backend_id(model.Backend.Native) &&
             state.config.word_bits == 64,
         "native IR requires native64", source);
    for function in state.h.functions {
        nvstate.symbol_add(inout state.symbols, function.symbol, function.signature);
    }
    for external in state.externals {
        nvsupport.need(external.symbol < vec.len(state.h.resolved.symbols),
             "external function identity", source);
        let symbol = state.h.resolved.symbols[external.symbol];
        nvsupport.need(model.symbol_kind_id(symbol.kind) == model.symbol_kind_id(model.SymbolKind.Function) &&
                 external.owner < vec.len(state.h.resolved.project.modules) &&
                 symbol.module == external.owner &&
                 option.is_some(symbol.definition),
             "external function is not a visible source declaration",
             source);
        let signature = nvsupport.require_type(state.h, external.signature, source);
        nvsupport.need(nvsupport.type_is(signature.kind, model.TypeKind.Function),
             "external function signature is not a function type", source);
        nvstate.symbol_add(inout state.symbols, external.symbol, external.signature);
    }
    nvsupport.need(vec.len(state.h.functions) == vec.len(state.functions),
         "native function count differs from verified HIR", source);
    nvsupport.need(vec.len(state.symbols) == vec.len(state.h.functions) +
             vec.len(state.externals),
         "duplicate HIR definitions or external declarations",
         source);
    var seen = nvcontainers.node_set();
    for function in state.functions {
        nvsupport.need(nvcontainers.node_set_insert(inout seen, function.symbol),
             "duplicate native function", function.source);
        check_function(inout state, function);
    }
}
