// Native CFG verifier: per-instruction dispatch, terminator checks and final
// cross-block checks.
//
// The dispatch order and every diagnostic are the direct port of the
// instruction switch in src/ir/verify.cpp.  Domain checks live in the
// app/wzcc/nativeverify/ops package; this file keeps the ordered switch.
package nativeverify;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativelayout" as nativelayout;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/nativeverify/cfg" as nvcfg;
import "app/wzcc/nativeverify/cleanup" as nvcleanup;
import "app/wzcc/nativeverify/containers" as nvcontainers;
import "app/wzcc/nativeverify/ops" as nvops;
import "app/wzcc/nativeverify/ownership" as nvownership;
import "app/wzcc/nativeverify/state" as nvstate;
import "app/wzcc/nativeverify/support" as nvsupport;
import "std/option" as option;
import "std/vec" as vec;

func check_instruction(state inout nvstate.Body, block usize, position usize,
                       initialized inout nvcontainers.BoolSet,
                       previous_system inout option.Option[usize])
    throws nvsupport.VerifyError {
    let instruction = state.f.blocks[block].instructions[position];
    if nvsupport.op_is(instruction.op, nativeir.Op.CleanupBegin) ||
       nvsupport.op_is(instruction.op, nativeir.Op.CleanupEnd) {
        previous_system = option.Option[usize].None; // defer bodies: own order
    }
    let value_type = nvsupport.require_type(state.m.h, instruction.type_id,
        instruction.source);
    nvsupport.need(nvsupport.op_is(instruction.op, nativeir.Op.SystemCall) ||
             !option.is_some(instruction.system),
         "system metadata on a non-system instruction", instruction.source);
    nvsupport.need(nvsupport.op_is(instruction.op, nativeir.Op.StringLiteral) ||
             instruction.utf8 == "",
         "string bytes on a non-string instruction", instruction.source);
    var args = vec.empty[nvcontainers.Definition]();
    vec.reserve(args, vec.len(instruction.inputs));
    for value in instruction.inputs {
        vec.push(args, nvcfg.use_value(state, value, block, position + 1,
            instruction.source));
    }
    // A pure HIR constant expands to existing scalar/aggregate ops.
    nvops.check_constant_expansion(state, instruction, value_type);
    nvsupport.need(option.is_some(instruction.exit) ==
             nvsupport.op_is(instruction.op, nativeir.Op.ExitBegin) &&
             option.is_some(instruction.cleanup) ==
                 (nvsupport.op_is(instruction.op, nativeir.Op.CleanupBegin) ||
                  nvsupport.op_is(instruction.op, nativeir.Op.CleanupEnd)),
         "invalid cleanup metadata", instruction.source);
    if nvsupport.op_is(instruction.op, nativeir.Op.BeginBorrow) {
        nvops.require_arity(args, 1, instruction.source);
        var slot usize = 0;
        var has_slot = false;
        nvsupport.need(option.is_some(instruction.owner) &&
                 instruction.slot < vec.len(state.f.slots),
             "borrow actual storage differs from owner", instruction.source);
        let declared = state.f.slots[instruction.slot];
        var binding_matches = false;
        switch instruction.owner {
            case option.Option.Some(owner): {
                switch declared.binding {
                    case option.Option.Some(binding):
                        binding_matches =
                            nvsupport.owner_kind_id(owner.kind) ==
                                nvsupport.owner_kind_id(hir.OwnerKind.Binding) &&
                            u64(binding) == owner.identity;
                    case option.Option.None: {}
                }
                nvsupport.need(binding_matches ||
                         nvsupport.owner_ref_option_equal(declared.owner,
                             instruction.owner),
                     "borrow actual storage differs from owner",
                     instruction.source);
            }
            case option.Option.None: {}
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.OwnershipBegin) ||
              nvsupport.op_is(instruction.op, nativeir.Op.OwnershipEnd) {
        nvops.require_arity(args, 0, instruction.source);
        var origin_id usize = 0;
        var has_origin = false;
        switch instruction.origin {
            case option.Option.Some(value): origin_id = value; has_origin = true;
            case option.Option.None: {}
        }
        nvsupport.need(has_origin && origin_id < vec.len(state.m.h.nodes) &&
                 instruction.bits <= 1 &&
                 nvsupport.type_is(value_type.kind, model.TypeKind.Unit),
             "ownership batch shape", instruction.source);
        let origin = state.m.h.nodes[origin_id];
        nvsupport.need(nvsupport.same_span(origin.source.span, instruction.source) &&
                 nvsupport.hir_scope_function(state.m.h, origin.scope) ==
                     state.f.symbol,
             "ownership batch source differs from HIR", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Copy) ||
              nvsupport.op_is(instruction.op, nativeir.Op.Borrow) {
        nvops.require_arity(args, 1, instruction.source);
        nvops.operand_type(state, args, 0, instruction.source);
        nvsupport.need(args[0].type_id == instruction.type_id, "copy/borrow type",
            instruction.source);
        switch instruction.origin {
            case option.Option.Some(origin_id): {
                let source = nvsupport.hir_node(state.m.h, origin_id);
                if nvsupport.kind_is(hir.node_kind(source.data), hir.NodeKind.Read) {
                    var matches = false;
                    for value_use in state.m.h.ownership.uses {
                        if value_use.consumer != origin_id ||
                           option.is_some(value_use.destination) ||
                           value_use.operand != 0 {
                            continue;
                        }
                        var expected = nvsupport.use_kind_id(hir.UseKind.Borrow);
                        if nvsupport.op_is(instruction.op, nativeir.Op.Copy) {
                            expected = nvsupport.use_kind_id(hir.UseKind.Copy);
                        }
                        matches = nvsupport.use_kind_id(value_use.kind) == expected;
                    }
                    nvsupport.need(matches, "copy/borrow differs from HIR use",
                        instruction.source);
                    let definition = nvcontainers.instruction_require(
                        state.instructions, instruction.inputs[0]);
                    nvsupport.need(nvsupport.op_is(definition.op, nativeir.Op.Load),
                         "copy/borrow does not read binding",
                         instruction.source);
                    let slot = nvstate.slot_require(state, definition.slot);
                    switch slot.owner {
                        case option.Option.Some(owner): {
                            var symbol usize = 0;
                            switch source.data {
                                case hir.NodeData.Read(read): symbol = read.symbol;
                                default: {}
                            }
                            nvsupport.need(nvsupport.owner_kind_id(owner.kind) ==
                                     nvsupport.owner_kind_id(hir.OwnerKind.Binding) &&
                                     owner.identity == u64(symbol),
                                 "copy/borrow from wrong binding",
                                 instruction.source);
                        }
                        case option.Option.None: {}
                    }
                }
            }
            case option.Option.None: {}
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Move) {
        nvops.require_arity(args, 0, instruction.source);
        var has_origin = false;
        var origin_id usize = 0;
        switch instruction.origin {
            case option.Option.Some(value): has_origin = true; origin_id = value;
            case option.Option.None: {}
        }
        nvsupport.need(instruction.slot < vec.len(state.f.slots) &&
                 state.f.slots[instruction.slot].type_id ==
                     instruction.type_id &&
                 has_origin,
             "move slot/type/origin", instruction.source);
        let source = nvsupport.hir_node(state.m.h, origin_id);
        switch source.data {
            case hir.NodeData.Move(move_value): {
                var has_binding = false;
                var binding usize = 0;
                switch move_value.binding {
                    case option.Option.Some(value):
                        has_binding = true; binding = value;
                    case option.Option.None: {}
                }
                var owner_matches = true;
                switch state.f.slots[instruction.slot].owner {
                    case option.Option.Some(owner):
                        owner_matches =
                            has_binding &&
                            nvsupport.owner_kind_id(owner.kind) ==
                                nvsupport.owner_kind_id(hir.OwnerKind.Binding) &&
                            owner.identity == u64(binding);
                    case option.Option.None: {}
                }
                nvsupport.need(has_binding && owner_matches, "move differs from HIR",
                    instruction.source);
            }
            default: {
                nvsupport.need(false, "move differs from HIR", instruction.source);
            }
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Take) ||
              nvsupport.op_is(instruction.op, nativeir.Op.Destroy) ||
              nvsupport.op_is(instruction.op, nativeir.Op.IterationEnd) {
        nvops.require_arity(args, 0, instruction.source);
        nvsupport.need(nvsupport.type_is(value_type.kind, model.TypeKind.Unit) &&
                 instruction.slot < vec.len(state.f.slots) &&
                 option.is_some(state.f.slots[instruction.slot].owner),
             "owning action without live slot", instruction.source);
        if option.is_some(instruction.owner) {
            nvsupport.need(nvsupport.owner_ref_option_equal(instruction.owner,
                     state.f.slots[instruction.slot].owner),
                 "owning action uses another slot", instruction.source);
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.EndBorrow) {
        nvops.require_arity(args, 0, instruction.source);
        nvsupport.need(option.is_some(instruction.owner),
             "end borrow without identity", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.SaveOutput) {
        nvops.require_arity(args, 1, instruction.source);
        nvops.operand_type(state, args, 0, instruction.source);
        nvsupport.need(option.is_some(instruction.owner) &&
                 nvops.classify(state, args[0].type_id).needs_drop,
             "save output without owned value", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.VecInit) {
        nvsupport.need(nvsupport.type_is(value_type.kind, model.TypeKind.Vec),
             "Vec constructor type", instruction.source);
        let element = nvsupport.type_arg(value_type, 0, instruction.source);
        for var index usize = 0; index < vec.len(args); index += 1 {
            nvops.operand_type(state, args, index, instruction.source);
            nvsupport.need(args[index].type_id == element, "Vec element type",
                instruction.source);
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.VecRead) ||
              nvsupport.op_is(instruction.op, nativeir.Op.VecCheck) ||
              nvsupport.op_is(instruction.op, nativeir.Op.VecSet) {
        nvops.check_vec_index(inout state, instruction, args, block, position);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.VecElementAddress) {
        nvops.check_vec_element_address(inout state, instruction, args, block,
            position);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.VecSlice) {
        nvops.check_vec_slice(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.IterationBegin) ||
              nvsupport.op_is(instruction.op, nativeir.Op.IterationNext) ||
              nvsupport.op_is(instruction.op, nativeir.Op.IterationRead) ||
              nvsupport.op_is(instruction.op, nativeir.Op.IterationTest) {
        nvops.check_iteration(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.VecLength) {
        nvops.require_arity(args, 1, instruction.source);
        let receiver = nvops.operand_type(state, args, 0, instruction.source);
        nvsupport.need((nvsupport.type_is(receiver.kind, model.TypeKind.Vec) ||
              nvsupport.type_is(receiver.kind, model.TypeKind.Slice) ||
              nvsupport.type_is(receiver.kind, model.TypeKind.String)) &&
                 nvsupport.type_is(value_type.kind, model.TypeKind.Usize),
             "iteration/length type", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.ExitBegin) {
        nvsupport.need(nvsupport.type_is(value_type.kind, model.TypeKind.Unit),
             "exit marker type", instruction.source);
        for var index usize = 0; index < vec.len(args); index += 1 {
            nvops.operand_type(state, args, index, instruction.source);
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.CleanupBegin) ||
              nvsupport.op_is(instruction.op, nativeir.Op.CleanupEnd) {
        nvops.require_arity(args, 0, instruction.source);
        nvsupport.need(nvsupport.type_is(value_type.kind, model.TypeKind.Unit),
             "cleanup marker type", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.StringLiteral) {
        nvops.require_arity(args, 0, instruction.source);
        nvsupport.need(nvsupport.type_is(value_type.kind, model.TypeKind.String) &&
                 instruction.bits == 0,
             "invalid string literal type/bits", instruction.source);
        nvsupport.need(nvops.valid_utf8(instruction.utf8),
             "invalid UTF-8 string literal", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Constant) {
        nvops.require_arity(args, 0, instruction.source);
        nvsupport.need(nvsupport.integer(value_type.kind) ||
                 nvsupport.type_is(value_type.kind, model.TypeKind.Unit) ||
                 nvsupport.type_is(value_type.kind, model.TypeKind.Bool) ||
                 nvsupport.type_is(value_type.kind, model.TypeKind.Float),
             "invalid constant type", instruction.source);
        if nvsupport.type_is(value_type.kind, model.TypeKind.Unit) {
            nvsupport.need(instruction.bits == 0, "nonzero Unit", instruction.source);
        } else if nvsupport.type_is(value_type.kind, model.TypeKind.Bool) {
            nvsupport.need(instruction.bits <= 1, "invalid bool bits",
                instruction.source);
        } else {
            let width = nvops.bit_width(state, value_type);
            nvsupport.need(width == 64 || (instruction.bits >> u64(width)) == 0,
                 "constant exceeds width", instruction.source);
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Function) {
        nvops.check_function_instruction(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Load) ||
              nvsupport.op_is(instruction.op, nativeir.Op.Address) ||
              nvsupport.op_is(instruction.op, nativeir.Op.Store) {
        nvsupport.need(instruction.slot < vec.len(state.f.slots), "unknown slot",
            instruction.source);
        let slot_type = state.f.slots[instruction.slot].type_id;
        if nvsupport.op_is(instruction.op, nativeir.Op.Store) {
            nvops.require_arity(args, 1, instruction.source);
            nvops.operand_type(state, args, 0, instruction.source);
            nvsupport.need(args[0].type_id == slot_type &&
                     nvsupport.type_is(value_type.kind, model.TypeKind.Unit),
                 "store type mismatch", instruction.source);
            nvcontainers.bool_set_add(inout initialized, instruction.slot);
        } else {
            nvops.require_arity(args, 0, instruction.source);
            nvsupport.need(slot_type == instruction.type_id,
                 "load/address type mismatch", instruction.source);
            if nvcontainers.bool_set_has(state.reachable, block) {
                nvsupport.need(nvcontainers.bool_set_has(initialized, instruction.slot),
                     "slot used before initialization", instruction.source);
            }
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Unary) {
        nvops.require_arity(args, 1, instruction.source);
        let kind = nvops.operand_type(state, args, 0, instruction.source).kind;
        let unary = nvsupport.unary_op_id(instruction.unary);
        nvsupport.need(args[0].type_id == instruction.type_id &&
                 ((unary == nvsupport.unary_op_id(hir.UnaryOp.LogicalNot) &&
                   nvsupport.type_is(kind, model.TypeKind.Bool)) ||
                  (unary == nvsupport.unary_op_id(hir.UnaryOp.Negate) &&
                   (nvsupport.integer(kind) ||
                    nvsupport.type_is(kind, model.TypeKind.Float))) ||
                  (unary == nvsupport.unary_op_id(hir.UnaryOp.BitNot) &&
                   nvsupport.integer(kind))),
             "invalid unary types/op", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Binary) {
        nvops.require_arity(args, 2, instruction.source);
        let left = nvops.operand_type(state, args, 0, instruction.source);
        let right = nvops.operand_type(state, args, 1, instruction.source);
        let binary = nvsupport.binary_op_id(instruction.binary);
        let comparison = binary >= nvsupport.binary_op_id(hir.BinaryOp.Equal) &&
                         binary <= nvsupport.binary_op_id(hir.BinaryOp.GreaterEqual);
        let shift = binary == nvsupport.binary_op_id(hir.BinaryOp.ShiftLeft) ||
                    binary == nvsupport.binary_op_id(hir.BinaryOp.ShiftRight);
        let equal = binary == nvsupport.binary_op_id(hir.BinaryOp.Equal) ||
                    binary == nvsupport.binary_op_id(hir.BinaryOp.NotEqual);
        let floating = nvsupport.type_is(left.kind, model.TypeKind.Float) &&
                       nvsupport.type_is(right.kind, left.kind) &&
                       (comparison ||
                        binary == nvsupport.binary_op_id(hir.BinaryOp.Add) ||
                        binary == nvsupport.binary_op_id(hir.BinaryOp.Subtract) ||
                        binary == nvsupport.binary_op_id(hir.BinaryOp.Multiply) ||
                        binary == nvsupport.binary_op_id(hir.BinaryOp.Divide));
        // String patterns and source operators use the same binary ops.
        let string_equal = (comparison ||
                            binary == nvsupport.binary_op_id(hir.BinaryOp.Add)) &&
                           nvsupport.type_is(left.kind, model.TypeKind.String) &&
                           nvsupport.type_is(right.kind, left.kind);
        nvsupport.need(binary >= nvsupport.binary_op_id(hir.BinaryOp.Add) &&
                 binary <= nvsupport.binary_op_id(hir.BinaryOp.GreaterEqual) &&
                 ((nvsupport.integer(left.kind) && nvsupport.integer(right.kind)) || floating ||
                  string_equal ||
                  (equal && nvsupport.type_is(left.kind, model.TypeKind.Bool) &&
                   nvsupport.type_is(right.kind, left.kind))) &&
                 (shift || args[0].type_id == args[1].type_id) &&
                 nvops.binary_result_ok(comparison, value_type, instruction, args),
             "invalid binary types/op", instruction.source);
        if string_equal {
            nvops.check_text_binary(state, instruction, args);
        }
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Convert) {
        nvops.check_convert(state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.SystemCall) {
        nvops.check_system_call(inout state, instruction, args,
            inout previous_system);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.ForeignCall) {
        nvops.check_foreign_call(inout state, instruction, args,
            inout previous_system);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.CFieldRead) {
        nvops.check_c_field_read(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.CPtrRead) ||
              nvsupport.op_is(instruction.op, nativeir.Op.CBufferRead) {
        nvops.check_c_read(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.CPtrWrite) ||
              nvsupport.op_is(instruction.op, nativeir.Op.CBufferWrite) {
        nvops.check_c_write(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.TraitObject) {
        nvops.check_trait_object(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.TraitCall) {
        nvops.check_trait_call(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.Call) {
        nvops.check_call(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.StructInit) ||
              nvsupport.op_is(instruction.op, nativeir.Op.EnumInit) {
        nvops.check_aggregate_init(inout state, instruction, args, value_type);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.FieldRead) ||
              nvsupport.op_is(instruction.op, nativeir.Op.FieldAddress) {
        nvops.check_field(inout state, instruction, args);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.LoadIndirect) {
        nvops.require_arity(args, 1, instruction.source);
        nvsupport.need(args[0].address && args[0].type_id == instruction.type_id,
             "indirect load type/mode", instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.ReplaceIndirect) ||
              nvsupport.op_is(instruction.op, nativeir.Op.StoreIndirect) {
        nvops.require_arity(args, 2, instruction.source);
        nvops.operand_type(state, args, 1, instruction.source);
        nvsupport.need(args[0].address && args[0].type_id == args[1].type_id &&
                 nvsupport.type_is(value_type.kind, model.TypeKind.Unit),
             "indirect store type/mode", instruction.source);
        nvsupport.need(nvops.classify(state, args[1].type_id).needs_drop ==
                 nvsupport.op_is(instruction.op, nativeir.Op.ReplaceIndirect),
             "owned field replacement lacks actual destroy",
             instruction.source);
    } else if nvsupport.op_is(instruction.op, nativeir.Op.EnumTest) ||
              nvsupport.op_is(instruction.op, nativeir.Op.EnumPayload) {
        nvops.require_arity(args, 1, instruction.source);
        let receiver = nvops.operand_type(state, args, 0, instruction.source);
        nvsupport.need(nvsupport.type_is(receiver.kind, model.TypeKind.NominalEnum),
             "enum operation receiver", instruction.source);
        nvops.aggregate_variant_index(state, args[0].type_id, instruction.variant);
        if nvsupport.op_is(instruction.op, nativeir.Op.EnumTest) {
            nvsupport.need(nvsupport.type_is(value_type.kind, model.TypeKind.Bool),
                 "enum test result", instruction.source);
        } else {
            let variant = option.Option[usize].Some(instruction.variant);
            let fields = nvops.aggregate_fields(inout state, args[0].type_id,
                variant);
            let index = nvops.aggregate_field_index(inout state, args[0].type_id,
                instruction.field, variant);
            nvsupport.need(fields[index].type_id == instruction.type_id,
                 "enum payload result type", instruction.source);
            nvsupport.need(nvcontainers.fact_has(state.facts[block], instruction.inputs[0],
                     instruction.variant, true),
                 "enum payload without matching variant edge",
                 instruction.source);
        }
    } else {
        nvsupport.need(false, "unknown native operation", instruction.source);
    }
}

func terminator_operand_ok(state nvstate.Body, terminator nativeir.Terminator,
                           operand nvcontainers.Definition, return_id usize,
                           error_id usize) bool throws nvsupport.VerifyError {
    if nvsupport.exit_is(terminator.kind, nativeir.Exit.Return) {
        return operand.type_id == return_id;
    }
    if nvsupport.exit_is(terminator.kind, nativeir.Exit.ErrorReturn) {
        return operand.type_id == error_id;
    }
    let value = nvsupport.require_type(state.m.h, operand.type_id, terminator.source);
    return nvsupport.type_is(value.kind, model.TypeKind.Bool);
}

func check_terminator(state inout nvstate.Body, block usize) throws nvsupport.VerifyError {
    let bb = state.f.blocks[block];
    let terminator = bb.terminator;
    var async_return usize = 0;
    var async_error usize = 0;
    if state.f.is_async {
        let task = nvsupport.require_type(state.m.h, state.signature.result,
            terminator.source);
        nvsupport.need(nvsupport.type_is(task.kind, model.TypeKind.Task) &&
                 vec.len(task.type_args) == 2,
             "async function signature result", terminator.source);
        async_return = task.type_args[0];
        async_error = task.type_args[1];
    }
    if nvsupport.exit_is(terminator.kind, nativeir.Exit.ErrorReturn) {
        var wanted = state.signature.throws_type;
        if state.f.is_async {
            wanted = option.Option[usize].Some(async_error);
        }
        var matches = false;
        switch terminator.exit {
            case option.Option.Some(site): {
                matches = nvsupport.exit_kind_id(site.kind) ==
                              nvsupport.exit_kind_id(hir.ExitKind.Error) &&
                          nvsupport.compare_option(site.error_type, wanted) == 0;
            }
            case option.Option.None: {}
        }
        nvsupport.need(option.is_some(terminator.origin) && matches,
             "ErrorReturn without verified error exit", terminator.source);
    }
    if nvsupport.exit_is(terminator.kind, nativeir.Exit.Return) &&
       !option.is_some(terminator.origin) {
        var result_id = state.signature.result;
        if state.f.is_async {
            result_id = async_return;
        }
        let result = nvsupport.require_type(state.m.h, result_id, terminator.source);
        nvsupport.need(nvsupport.type_is(result.kind, model.TypeKind.Unit) &&
                 nvsupport.same_span(terminator.source, state.f.source),
             "explicit return without source exit identity",
             terminator.source);
    }
    var operands = vec.empty[nvcontainers.Definition]();
    vec.reserve(operands, vec.len(terminator.inputs));
    for value in terminator.inputs {
        vec.push(operands, nvcfg.use_value(state, value, block,
            vec.len(bb.instructions) + 1, terminator.source));
    }
    if nvsupport.exit_is(terminator.kind, nativeir.Exit.TryCall) {
        let cs = nvsupport.require_type(state.m.h, terminator.signature,
            terminator.source);
        nvsupport.need(nvsupport.type_is(cs.kind, model.TypeKind.Function) &&
                 option.is_some(cs.throws_type) &&
                 option.is_some(terminator.origin),
             "TryCall requires throwing signature and source call",
             terminator.source);
        nvsupport.need(nvsupport.option_usize(terminator.origin) < vec.len(state.m.h.nodes),
             "unknown TryCall origin", terminator.source);
        let origin = state.m.h.nodes[nvsupport.option_usize(terminator.origin)];
        switch origin.data {
            case hir.NodeData.Call(call): {
                nvsupport.need(call.signature == terminator.signature,
                     "TryCall differs from source signature",
                     terminator.source);
            }
            default: {
                nvsupport.need(false, "TryCall differs from source signature",
                    terminator.source);
            }
        }
        nvsupport.need(vec.len(operands) == vec.len(cs.parameters) + 1 &&
                 !operands[0].address &&
                 operands[0].type_id == terminator.signature,
             "TryCall callee/arity", terminator.source);
        for var index usize = 0; index < vec.len(cs.parameters); index += 1 {
            nvsupport.need(operands[index + 1].type_id == cs.parameters[index].type_id &&
                     operands[index + 1].address ==
                         (nvsupport.param_mode_id(cs.parameters[index].mode) ==
                          nvsupport.param_mode_id(model.ParamMode.Inout)),
                 "TryCall argument type/mode", terminator.source);
        }
        for var side usize = 0; side < 2; side += 1 {
            let target = terminator.targets[side];
            let parameters = state.f.blocks[target].parameters;
            var expected = cs.result;
            if side == 1 {
                expected = nvsupport.option_usize(cs.throws_type);
            }
            nvsupport.need(nvcontainers.bool_set_is_single(state.predecessors[target], block) &&
                     vec.len(parameters) == 1 &&
                     parameters[0].type_id == expected &&
                     parameters[0].call == nvsupport.option_usize(terminator.origin) &&
                     parameters[0].error == (side == 1),
                 "TryCall side parameter/predecessor", terminator.source);
        }
    } else if nvsupport.exit_is(terminator.kind, nativeir.Exit.Await) {
        nvsupport.need(vec.len(terminator.targets) == 3 &&
                 option.is_some(terminator.origin),
             "await arity/origin", terminator.source);
        let task = nvsupport.require_type(state.m.h, terminator.signature,
            terminator.source);
        nvsupport.need(nvsupport.type_is(task.kind, model.TypeKind.Task) &&
                 vec.len(task.type_args) == 2,
             "await task signature", terminator.source);
        nvsupport.need(vec.len(operands) == 1 && !operands[0].address &&
                 operands[0].type_id == terminator.signature,
             "await future operand", terminator.source);
        for var side usize = 0; side < 2; side += 1 {
            let target = terminator.targets[side];
            let parameters = state.f.blocks[target].parameters;
            let expected = task.type_args[side];
            let unit = nvsupport.type_is(nvsupport.require_type(state.m.h, expected,
                    terminator.source).kind, model.TypeKind.Unit);
            var expected_count usize = 1;
            if unit {
                expected_count = 0;
            }
            nvsupport.need(nvcontainers.bool_set_is_single(state.predecessors[target], block) &&
                     vec.len(parameters) == expected_count &&
                     (unit ||
                      (parameters[0].type_id == expected &&
                       parameters[0].call ==
                           nvsupport.option_usize(terminator.origin) &&
                       parameters[0].error == (side == 1))),
                 "await side parameter/predecessor", terminator.source);
        }
        nvsupport.need(vec.len(state.f.blocks[terminator.targets[2]].parameters) == 0,
             "await cancel parameter", terminator.source);
    } else {
        nvsupport.need(terminator.signature == 0, "signature on non-TryCall",
            terminator.source);
        var return_id = state.signature.result;
        var error_id = nvsupport.option_usize(state.signature.throws_type);
        if state.f.is_async {
            return_id = async_return;
            error_id = async_error;
        }
        for operand in operands {
            nvsupport.need(!operand.address &&
                     terminator_operand_ok(state, terminator, operand,
                         return_id, error_id),
                 "terminator type mismatch", terminator.source);
        }
    }
    if vec.len(bb.parameters) > 0 {
        nvsupport.need(block != 0 && nvcontainers.bool_set_count(state.predecessors[block]) == 1,
             "orphan block parameter", terminator.source);
        let predecessor = nvcontainers.bool_set_first(state.predecessors[block]);
        let pred = state.f.blocks[predecessor].terminator;
        nvsupport.need(nvsupport.exit_is(pred.kind, nativeir.Exit.TryCall) ||
                 nvsupport.exit_is(pred.kind, nativeir.Exit.Await),
             "parameter without TryCall/await edge", terminator.source);
    }
}

func check_blocks(state inout nvstate.Body) throws nvsupport.VerifyError {
    let block_count = vec.len(state.f.blocks);
    for var block usize = 0; block < block_count; block += 1 {
        var previous_system = state.system_in[block];
        var initialized = nvcontainers.bool_set_copy(state.initialized[block]);
        for var position usize = 0;
            position < vec.len(state.f.blocks[block].instructions);
            position += 1 {
            check_instruction(inout state, block, position,
                inout initialized, inout previous_system);
        }
        check_terminator(inout state, block);
    }
}

func check_impossible(state inout nvstate.Body) throws nvsupport.VerifyError {
    state.impossible = nvcontainers.bool_set(vec.len(state.f.blocks));
    for var block usize = 0; block < vec.len(state.f.blocks); block += 1 {
        for fact in state.facts[block].values {
            if fact.matches {
                continue;
            }
            let definition = nvcontainers.definition_require(state.definitions,
                fact.value);
            let declaration = nvops.aggregate_declaration(state, definition.type_id);
            if vec.len(declaration.variants) == 0 {
                continue;
            }
            var all_false = true;
            for variant in declaration.variants {
                if !nvcontainers.fact_has(state.facts[block], fact.value, variant.symbol,
                        false) {
                    all_false = false;
                }
            }
            if all_false {
                nvcontainers.bool_set_add(inout state.impossible, block);
            }
        }
    }
}

func check_required_checks(state inout nvstate.Body) throws nvsupport.VerifyError {
    for required in state.required_checks {
        var found = false;
        for var candidate_block usize = 0;
            candidate_block < vec.len(state.f.blocks); candidate_block += 1 {
            if !nvcontainers.bool_set_has(state.reachable, candidate_block) ||
               !nvcontainers.bool_set_has(state.dom[required.block], candidate_block) {
                continue;
            }
            let candidate_bb = state.f.blocks[candidate_block];
            for var candidate usize = 0;
                candidate < vec.len(candidate_bb.instructions);
                candidate += 1 {
                if candidate_block == required.block &&
                   candidate >= required.position {
                    continue;
                }
                let instruction = candidate_bb.instructions[candidate];
                if nvsupport.op_is(instruction.op, nativeir.Op.VecCheck) &&
                   nvsupport.compare_option(instruction.origin,
                       option.Option[usize].Some(required.origin)) == 0 &&
                   vec.len(instruction.inputs) == 2 &&
                   instruction.inputs[0] == required.receiver &&
                   instruction.inputs[1] == required.index {
                    found = true;
                    break;
                }
            }
            if found {
                break;
            }
        }
        nvsupport.need(found, "Vec/Slice write lacks matching source bounds check",
            required.source);
    }
}

func check_function(state inout nvstate.ModuleState, function nativeir.Function)
    throws nvsupport.VerifyError {
    let signature = nvsupport.require_type(state.h, function.signature,
        function.source);
    var body = nvstate.Body(m: state, f: function, signature: signature,
        aggregates: nativelayout.aggregate_types(state.h),
        definitions: nvcontainers.definition_map(), instructions: nvcontainers.instruction_map(),
        address_roots: nvcontainers.address_root_map(), address_writes: nvcontainers.value_count_map(),
        address_inout_roots: nvcontainers.node_set(), predecessors: [],
        reachable: nvcontainers.bool_set(vec.len(function.blocks)), dom: [], facts: [],
        initialized: [], initialized_out: [],
        constant_roots: nvcontainers.constant_root_list(), system_order: nvcontainers.node_order_map(),
        system_loop_sources: [], system_in: [], system_out: [],
        required_checks: vec.empty[nvstate.RequiredCheck](),
        impossible: nvcontainers.bool_set(vec.len(function.blocks)));
    nvcfg.check_slots(inout body);
    nvcfg.collect_definitions(inout body);
    nvcfg.collect_address_roots(inout body);
    nvcfg.check_address_usage(inout body);
    nvcfg.compute_reachability(inout body);
    nvcfg.compute_dominators(inout body);
    nvcfg.compute_facts(inout body);
    nvcfg.compute_initialization(inout body);
    nvcfg.compute_system_order(inout body);
    nvcfg.compute_system_flow(inout body);
    check_blocks(inout body);
    check_impossible(inout body);
    check_required_checks(inout body);
    nvcleanup.cleanup(inout body);
    nvownership.ownership(inout body);
}
