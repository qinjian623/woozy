// CPP check.cpp:6687-6798. Declaration/body algorithms remain in A/B files.
package sema;

import "app/wzcc/hir" as hir;
import "app/wzcc/frontcache" as frontcache;
import "app/wzcc/hirclone" as hirclone;
import "app/wzcc/model" as model;
import "app/wzcc/ownership" as ownership;
import "app/wzcc/types" as types;
import "app/wzcc/valueops" as valueops;
import "std/option" as option;
import "std/vec" as vec;

func run_key_less(left NodeKey, right NodeKey) bool {
    return node_key_less(left, right);
}

// emplace keeps the first definition; occurrence assignment keeps the last.
func run_put_node_symbol(entries Vec[NodeSymbolEntry], key NodeKey,
                         id usize, replace bool) {
    let position = node_symbol_position(entries, key);
    if position < vec.len(entries) && same_node_key(entries[position].key, key) {
        if replace { entries[position].symbol = id; }
        return;
    }
    let entry = NodeSymbolEntry(key: key, symbol: id);
    vec.push(entries, entry);
    var index = vec.len(entries) - 1;
    for index > position {
        entries[index] = entries[index - 1];
        index -= 1;
    }
    entries[position] = entry;
}

func run_insert_index(values Vec[usize], value usize) {
    var position usize = 0;
    for position < vec.len(values) && values[position] < value { position += 1; }
    if position < vec.len(values) && values[position] == value { return; }
    vec.push(values, value);
    var index = vec.len(values) - 1;
    for index > position {
        values[index] = values[index - 1];
        index -= 1;
    }
    values[position] = value;
}

func run_sort_node_symbols(entries Vec[NodeSymbolEntry]) {
    let n = vec.len(entries);
    if n < 2 { return; }
    let scratch = vec.empty[NodeSymbolEntry]();
    vec.reserve(scratch, n);
    for var index usize = 0; index < n; index += 1 { vec.push(scratch, entries[index]); }
    var width usize = 1;
    for width < n {
        var left usize = 0;
        for left < n {
            var mid = left + width; if mid > n { mid = n; }
            var right = left + width * 2; if right > n { right = n; }
            var i = left; var j = mid; var out = left;
            for i < mid && j < right {
                if run_key_less(entries[j].key, entries[i].key) {
                    scratch[out] = entries[j]; j += 1;
                } else {
                    scratch[out] = entries[i]; i += 1;
                }
                out += 1;
            }
            for i < mid { scratch[out] = entries[i]; i += 1; out += 1; }
            for j < right { scratch[out] = entries[j]; j += 1; out += 1; }
            left += width * 2;
        }
        for var index usize = 0; index < n; index += 1 { entries[index] = scratch[index]; }
        width *= 2;
    }
}

func run_sort_usize(values Vec[usize]) {
    let n = vec.len(values);
    if n < 2 { return; }
    let scratch = vec.empty[usize]();
    vec.reserve(scratch, n);
    for var index usize = 0; index < n; index += 1 { vec.push(scratch, values[index]); }
    var width usize = 1;
    for width < n {
        var left usize = 0;
        for left < n {
            var mid = left + width; if mid > n { mid = n; }
            var right = left + width * 2; if right > n { right = n; }
            var i = left; var j = mid; var out = left;
            for i < mid && j < right {
                if values[j] < values[i] { scratch[out] = values[j]; j += 1; }
                else { scratch[out] = values[i]; i += 1; }
                out += 1;
            }
            for i < mid { scratch[out] = values[i]; i += 1; out += 1; }
            for j < right { scratch[out] = values[j]; j += 1; out += 1; }
            left += width * 2;
        }
        for var index usize = 0; index < n; index += 1 { values[index] = scratch[index]; }
        width *= 2;
    }
}

func run_dedup_sorted(values Vec[usize]) Vec[usize] {
    run_sort_usize(values);
    let out = vec.empty[usize]();
    for value in values {
        if vec.len(out) == 0 || out[vec.len(out) - 1] != value {
            vec.push(out, value);
        }
    }
    return out;
}

// module already owns its mutable resolved/type arrays.
func initialize_checker(module hir.HirModule) Checker throws Error {
    var state = Checker(m: module, selected_body_module: option.Option[usize].None,
        selected_templates: [], occurrences: [], definitions: [],
        signatures: [], trait_signature_context: [], parameters: [], locals: [],
        constants: [], evaluating: [], function: 0, scope: 0, cleanup_depth: 0,
        async_function: false, current_result: 0,
        current_async_error: option.Option[usize].None, unsafe_depth: 0,
        c_named_types: [], unit: 0, boolean: 0, i64_type: 0, loops: [],
        break_targets: [], nominal_ids: [], self_types: [], generic_params: [],
        bounds: [], trait_parameters: [], bodies: [], template_ids: [],
        instance_cache: [], instantiation_depth: 0, constraint_depth: 0,
        trait_results: [], active_constraints: [], active_trait_bounds: [],
        instantiated_nodes: 0, active_params: [], signature_parameters: [],
        async_functions: [], closures: [], capture_by_origin: [],
        capture_by_local: [], current_captures: [], weak_validated: [],
        nominal_fields_ready: false);
    let unit = scalar(inout state, model.TypeKind.Unit, 0);
    state.unit = unit;
    let boolean = scalar(inout state, model.TypeKind.Bool, 0);
    state.boolean = boolean;
    let i64_type = scalar(inout state, model.TypeKind.SignedInt, 64);
    state.i64_type = i64_type;
    let raw_defs = vec.empty[NodeSymbolEntry]();
    vec.reserve(raw_defs, vec.len(state.m.resolved.symbols));
    for symbol in state.m.resolved.symbols {
        switch symbol.definition {
            case option.Option.Some(location):
                vec.push(raw_defs, NodeSymbolEntry(key: node_key(location),
                    symbol: symbol.id));
            case option.Option.None: {}
        }
    }
    run_sort_node_symbols(raw_defs);
    for entry in raw_defs {
        let len_defs = vec.len(state.definitions);
        if len_defs == 0 || !same_node_key(state.definitions[len_defs - 1].key, entry.key) {
            vec.push(state.definitions, entry);
        }
    }
    let raw_occ = vec.empty[NodeSymbolEntry]();
    vec.reserve(raw_occ, vec.len(state.m.resolved.occurrences));
    for occurrence in state.m.resolved.occurrences {
        vec.push(raw_occ, NodeSymbolEntry(key: node_key(occurrence.source),
            symbol: occurrence.symbol));
    }
    run_sort_node_symbols(raw_occ);
    for entry in raw_occ {
        let len_occ = vec.len(state.occurrences);
        if len_occ > 0 && same_node_key(state.occurrences[len_occ - 1].key, entry.key) {
            state.occurrences[len_occ - 1] = entry;
        } else {
            vec.push(state.occurrences, entry);
        }
    }
    return state;
}

func make_checker(resolved model.ResolvedProject,
                  config model.CheckConfig) Checker throws Error {
    var module = hir.empty_module(resolved, resolved.project.entry, config);
    // Wz Vec copies share storage; CPP's owned symbol table must be isolated.
    try { module = hirclone.clone_module(module); }
    catch error model.SupportError { throw Error.Support(error); }
    return initialize_checker(module);
}

func run_generic_owners(entries Vec[GenericParamsEntry]) Vec[usize] {
    let owners = vec.empty[usize]();
    vec.reserve(owners, vec.len(entries));
    for entry in entries { vec.push(owners, entry.owner); }
    return run_dedup_sorted(owners);
}

func run_body_symbols(entries Vec[BodyEntry]) Vec[usize] {
    let symbols = vec.empty[usize]();
    vec.reserve(symbols, vec.len(entries));
    for entry in entries { vec.push(symbols, entry.symbol); }
    return run_dedup_sorted(symbols);
}

func run_check_bounds(state inout Checker, parameters Vec[hir.GenericParam],
                      self option.Option[usize], environment Vec[usize],
                      impl_index option.Option[usize]) throws Error {
    let saved = state.signature_parameters;
    state.signature_parameters = vec.empty[usize]();
    for parameter in parameters {
        run_insert_index(state.signature_parameters, parameter.symbol);
    }
    switch self {
        case option.Option.Some(id): run_insert_index(state.signature_parameters, id);
        case option.Option.None: {}
    }
    for id in environment { run_insert_index(state.signature_parameters, id); }
    for parameter in parameters {
        switch parameter.trait_ref {
            case option.Option.Some(bound): {
                let application = parameter_type(inout state, parameter.symbol);
                check_trait_parameter_bounds(inout state, parameter.source.node,
                    bound, application, 0);
            }
            case option.Option.None: {}
        }
    }
    switch impl_index {
        case option.Option.Some(index): {
            if index >= vec.len(state.m.impls) { throw internal_error("invalid sema implementation reference"); }
            let implementation = state.m.impls[index];
            switch implementation.trait_ref {
                case option.Option.Some(bound):
                    check_trait_parameter_bounds(inout state, implementation.source.node,
                        bound, implementation.self_type, 0);
                case option.Option.None: {}
            }
        }
        case option.Option.None: {}
    }
    state.signature_parameters = saved;
}

// Return ownership's real phase result: its empty-diagnostic failure means
// Cancelled in CPP, which must not be disguised as Error.Support.
func run_checker(state inout Checker) model.UnitResult throws Error {
    return run_checker_cached(inout state, frontcache.context("", ""));
}
func run_checker_cached(state inout Checker, cache frontcache.Context) model.UnitResult throws Error {
    return run_checker_selected(inout state, cache, option.Option[usize].None, []);
}
func run_checker_package(state inout Checker, cache frontcache.Context,
                             package_id usize) model.UnitResult throws Error {
    return run_checker_selected(inout state, cache, option.Option[usize].Some(package_id), []);
}
// Package workers use the same project-wide declaration phase but inspect only
// function bodies owned by one canonical Module.  No body-cache reader or
// writer participates in this mode.
func run_checker_selected(state inout Checker, cache frontcache.Context,
                          selected option.Option[usize], templates Vec[model.NodeRef]) model.UnitResult throws Error {
    state.selected_body_module = selected;
    state.selected_templates = templates;
    prepare_declarations(inout state);
    return run_checker_bodies(inout state, cache, selected, templates);
}

func prepare_declarations(state inout Checker) throws Error {
    declarations(inout state);
    for trait_declaration in state.m.traits {
        run_check_bounds(inout state, trait_declaration.params,
            option.Option[usize].Some(trait_declaration.self), [], option.Option[usize].None);
    }
    for nominal in state.m.nominals {
        run_check_bounds(inout state, nominal.params,
            option.Option[usize].None, [], option.Option[usize].None);
    }
    for var index usize = 0; index < vec.len(state.m.impls); index += 1 {
        let implementation = state.m.impls[index];
        run_check_bounds(inout state, implementation.params,
            option.Option[usize].Some(implementation.self_parameter), [],
            option.Option[usize].Some(index));
    }
    // generic_params and bodies are CPP maps, not declaration-order arrays.
    for owner in run_generic_owners(state.generic_params) {
        var parameters = vec.empty[hir.GenericParam]();
        switch a_generic_params_get(state.generic_params, owner) {
            case option.Option.Some(found): parameters = found;
            case option.Option.None: {}
        }
        var self = option.Option[usize].None;
        switch a_trait_signature_get(state.trait_signature_context, owner) {
            case option.Option.Some(entry):
                self = option.Option[usize].Some(entry.trait_self);
            case option.Option.None: {}
        }
        let environment = vec.empty[usize]();
        for trait_declaration in state.m.traits {
            for method in trait_declaration.methods {
                if method.symbol == owner {
                    for parameter in trait_declaration.params {
                        run_insert_index(environment, parameter.symbol);
                    }
                    break;
                }
            }
        }
        run_check_bounds(inout state, parameters, self, environment,
            option.Option[usize].None);
    }
    for module in state.m.resolved.project.modules {
        for var file_index usize = 0; file_index < vec.len(module.files);
            file_index += 1 {
            let file_ref = model.NodeRef(module: module.id, file: file_index, node: 0);
            let file = parsed_file(inout state, file_ref);
            let root_ref = at(file_ref, file.root);
            let root = ast(inout state, root_ref);
            for id in root.children {
                let location = at(file_ref, id);
                let value = ast(inout state, location);
                switch value.kind {
                    case model.AstKind.Binding: {
                        let binding = definition(inout state, location);
                        constant(inout state, binding);
                    }
                    default: {}
                }
            }
        }
    }
    for symbol in state.m.resolved.symbols {
        switch symbol.kind {
            case model.SymbolKind.Constant: {
                if symbol.exported && option.is_some(symbol.definition) {
                    check_public_constant(inout state, symbol.id);
                }
            }
            default: {}
        }
    }
}

func run_checker_bodies(state inout Checker, cache frontcache.Context,
                        selected option.Option[usize],
                        templates Vec[model.NodeRef]) model.UnitResult throws Error {
    state.selected_body_module = selected;
    state.selected_templates = templates;
    for template_ref in templates {
        let template_symbol = definition(inout state, template_ref);
        check_body(inout state, template_symbol);
    }
    var restored = vec.empty[usize]();
    switch selected {
        case option.Option.None: restored = run_dedup_sorted(frontcache.restore(cache, inout state.m));
        case option.Option.Some(package_id): {}
    }
    var cached_index usize = 0;
    for id in run_body_symbols(state.bodies) {
        var selected_body = true;
        switch selected {
            case option.Option.None: {}
            case option.Option.Some(package_id): {
                selected_body = id < vec.len(state.m.resolved.symbols) &&
                    state.m.resolved.symbols[id].module == package_id;
            }
        }
        if !selected_body { continue; }
        for cached_index < vec.len(restored) && restored[cached_index] < id { cached_index += 1; }
        if cached_index < vec.len(restored) && restored[cached_index] == id { continue; }
        cache.counters[5] += 1; check_body(inout state, id);
    }
    // transform_node may append functions; CPP visits a concrete snapshot.
    let concrete_bodies = vec.empty[usize]();
    for function in state.m.functions { vec.push(concrete_bodies, function.body); }
    for body in concrete_bodies {
        transform_node(inout state, body, 0, option.Option[Vec[model.Substitution]].None);
    }
    let type_roots = types.size(state.m.types);
    for var id usize = 1; id <= type_roots; id += 1 {
        let value = lookup_type(inout state, id);
        var nominal_type = false;
        switch value.kind {
            case model.TypeKind.NominalStruct: nominal_type = true;
            case model.TypeKind.NominalEnum: nominal_type = true;
            default: {}
        }
        if !nominal_type { continue; }
        let declaration = nominal(inout state, id);
        let substitutions = vec.empty[model.Substitution]();
        for var parameter usize = 0; parameter < vec.len(declaration.params);
            parameter += 1 {
            if parameter >= vec.len(value.type_args) {
                throw internal_error("nominal type argument count");
            }
            vec.push(substitutions, model.Substitution(
                symbol: declaration.params[parameter].symbol,
                type_id: value.type_args[parameter]));
        }
        check_constraints(inout state, declaration.source.node, declaration.params,
            value.type_args, option.Option[Vec[model.Substitution]].Some(substitutions));
    }
    validate_weak_types_before_publish(inout state);
    var infinite = option.Option[usize].None;
    try { infinite = valueops.infinite_value_layout(state.m); }
    catch error model.SupportError { throw Error.Support(error); }
    switch infinite {
        case option.Option.Some(id): {
            var found = false;
            var index usize = 0;
            switch a_nominal_id_get(state.nominal_ids, id) {
                case option.Option.Some(nominal_index): {
                    found = true;
                    index = nominal_index;
                }
                case option.Option.None: {}
            }
            if !found { throw internal_error("map::at"); }
            if index >= vec.len(state.m.nominals) { throw internal_error("invalid sema nominal reference"); }
            let location = state.m.nominals[index].source.node;
            throw reject(inout state, location,
                "value type has an infinite recursive layout", "E_TYPE_MISMATCH");
        }
        case option.Option.None: {}
    }
    return ownership.produce_ownership(inout state.m);
}

func run_checker_templates(state inout Checker, cache frontcache.Context,
                           package_id usize, templates Vec[model.NodeRef])
    model.UnitResult throws Error {
    return run_checker_selected(inout state, cache, option.Option[usize].Some(package_id), templates);
}
