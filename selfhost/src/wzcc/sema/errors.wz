package sema;
import "app/wzcc/model" as model;
import "app/wzcc/types" as types;

// CPP Rejected must keep its source diagnostic AND failure classification.
// SupportError is the accepted shared-algorithm error, not a source diagnostic.
enum Error {
    Rejected(diagnostic model.Diagnostic, failure model.FailureKind);
    Support(error model.SupportError);
}
func support_from_type_error(error types.Error) model.SupportError {
    switch error {
        case types.Error.Invalid(message): return model.SupportError.Invalid(message);
    }
}
// Checker algorithm methods will use `throws Error` across files.
// A types operation is caught at its wrapper and converted with
// Error.Support(support_from_type_error(error)); do not leak types.Error.
// Public facade: Rejected => original diagnostic/failure; Support.Invalid or
// Support.Limit => CPP internal/error wrapper unless the original caller
// deliberately converts that helper failure to a source rejection.
