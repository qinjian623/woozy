// Exact IEEE-754 binary folding for the checker. Decoding and rounding stay
// in the published number package; the sema adapter supplies the float width
// and assembles the resulting Value.
package constfold;

import "app/wzcc/bigint" as bigint;
import "app/wzcc/hir" as hir;
import "app/wzcc/number" as number;

pub enum FloatFold {
    Empty;
    Floating(bits u64);
    Boolean(value bool);
}

func round_ratio(negative bool, numerator bigint.BigInt,
                 denominator bigint.BigInt,
                 width u32) u64 throws number.Error {
    return number.exact_ratio_to_ieee(negative, numerator, denominator, width);
}

func round_fraction(negative bool, numerator bigint.BigInt,
                    denominator bigint.BigInt, shift i64,
                    width u32) u64 throws number.Error {
    if shift >= 0 {
        return round_ratio(negative,
            bigint.shift_left(numerator, u64(shift)), denominator, width);
    }
    return round_ratio(negative, numerator,
        bigint.shift_left(denominator, u64(-shift)), width);
}

func binary_is_subtract(op hir.BinaryOp) bool {
    switch op { case hir.BinaryOp.Subtract: return true; default: return false; }
}

func ieee_nan(value number.Ieee) bool {
    switch value.kind { case number.IeeeKind.NaN: return true; default: return false; }
}

func ieee_inf(value number.Ieee) bool {
    switch value.kind { case number.IeeeKind.Infinity: return true; default: return false; }
}

func ieee_finite(value number.Ieee) bool {
    switch value.kind { case number.IeeeKind.Finite: return true; default: return false; }
}

func signed_infinity(negative bool, width u32, infinity u64) u64 {
    if negative { return (u64(1) << u64(width - 1)) | infinity; }
    return infinity;
}

func signed_zero(negative bool, width u32) u64 {
    if negative { return u64(1) << u64(width - 1); }
    return 0;
}

pub func fold_float(op hir.BinaryOp, a_bits u64, b_bits u64,
                    width u32) FloatFold throws number.Error {
    var infinity u64 = 0x7ff0000000000000;
    var nan_bits u64 = 0x7ff8000000000000;
    if width == 32 {
        infinity = 0x7f800000;
        nan_bits = 0x7fc00000;
    }
    var x = number.decode_ieee(a_bits, width);
    var y = number.decode_ieee(b_bits, width);
    switch op {
        case hir.BinaryOp.Add:
        case hir.BinaryOp.Subtract: {
            if binary_is_subtract(op) { y.negative = !y.negative; }
            if ieee_nan(x) || ieee_nan(y) {
                return FloatFold.Floating(nan_bits);
            }
            if ieee_inf(x) && ieee_inf(y) {
                var chosen = nan_bits;
                if x.negative == y.negative {
                    chosen = signed_infinity(x.negative, width, infinity);
                }
                return FloatFold.Floating(chosen);
            }
            if ieee_inf(x) {
                return FloatFold.Floating(
                    signed_infinity(x.negative, width, infinity));
            }
            if ieee_inf(y) {
                return FloatFold.Floating(
                    signed_infinity(y.negative, width, infinity));
            }
            var shift = x.shift;
            if y.shift < shift { shift = y.shift; }
            var sum = bigint.shift_left(x.significand, u64(x.shift - shift));
            if x.negative { sum = bigint.negate(sum); }
            var addend = bigint.shift_left(y.significand, u64(y.shift - shift));
            if y.negative { addend = bigint.negate(addend); }
            sum = bigint.add(sum, addend);
            var magnitude = sum;
            if sum.sign < 0 { magnitude = bigint.negate(sum); }
            let negative_zero = sum.sign == 0 &&
                x.significand.sign == 0 && y.significand.sign == 0 &&
                x.negative && y.negative;
            return FloatFold.Floating(
                round_fraction(sum.sign < 0 || negative_zero, magnitude,
                    one(), shift, width));
        }
        case hir.BinaryOp.Multiply: {
            let negative = x.negative != y.negative;
            if ieee_nan(x) || ieee_nan(y) {
                return FloatFold.Floating(nan_bits);
            }
            if ieee_inf(x) || ieee_inf(y) {
                var finite = x;
                if ieee_inf(x) { finite = y; }
                if ieee_finite(finite) && finite.significand.sign == 0 {
                    return FloatFold.Floating(nan_bits);
                }
                return FloatFold.Floating(
                    signed_infinity(negative, width, infinity));
            }
            return FloatFold.Floating(
                round_fraction(negative,
                    bigint.multiply(x.significand, y.significand),
                    one(), x.shift + y.shift, width));
        }
        case hir.BinaryOp.Divide: {
            let negative = x.negative != y.negative;
            if ieee_nan(x) || ieee_nan(y) {
                return FloatFold.Floating(nan_bits);
            }
            if ieee_inf(x) {
                var chosen = nan_bits;
                if !ieee_inf(y) {
                    chosen = signed_infinity(negative, width, infinity);
                }
                return FloatFold.Floating(chosen);
            }
            if ieee_inf(y) {
                return FloatFold.Floating(signed_zero(negative, width));
            }
            if y.significand.sign == 0 {
                var chosen = nan_bits;
                if x.significand.sign != 0 {
                    chosen = signed_infinity(negative, width, infinity);
                }
                return FloatFold.Floating(chosen);
            }
            if x.significand.sign == 0 {
                return FloatFold.Floating(signed_zero(negative, width));
            }
            return FloatFold.Floating(
                round_fraction(negative, x.significand, y.significand,
                    x.shift - y.shift, width));
        }
        case hir.BinaryOp.Equal:
        case hir.BinaryOp.NotEqual:
        case hir.BinaryOp.Less:
        case hir.BinaryOp.LessEqual:
        case hir.BinaryOp.Greater:
        case hir.BinaryOp.GreaterEqual: {
            var comparison i32 = 0;
            if ieee_nan(x) || ieee_nan(y) {
                comparison = 2;
            } else if ieee_inf(x) || ieee_inf(y) {
                if ieee_inf(x) && ieee_inf(y) {
                    comparison = 0;
                    if x.negative != y.negative {
                        comparison = 1;
                        if x.negative { comparison = -1; }
                    }
                } else if ieee_inf(x) {
                    comparison = 1;
                    if x.negative { comparison = -1; }
                } else {
                    comparison = -1;
                    if y.negative { comparison = 1; }
                }
            } else if x.significand.sign == 0 && y.significand.sign == 0 {
                comparison = 0;
            } else if x.negative != y.negative {
                comparison = 1;
                if x.negative { comparison = -1; }
            } else {
                var shift = x.shift;
                if y.shift < shift { shift = y.shift; }
                let xs = bigint.shift_left(x.significand,
                    u64(x.shift - shift));
                let ys = bigint.shift_left(y.significand,
                    u64(y.shift - shift));
                let order = bigint.compare(xs, ys);
                comparison = order;
                if x.negative { comparison = -comparison; }
            }
            var value = false;
            switch op {
                case hir.BinaryOp.Equal: value = comparison == 0;
                case hir.BinaryOp.NotEqual:
                    value = comparison == 2 || comparison != 0;
                case hir.BinaryOp.Less:
                    value = comparison != 2 && comparison < 0;
                case hir.BinaryOp.LessEqual:
                    value = comparison != 2 && comparison <= 0;
                case hir.BinaryOp.Greater:
                    value = comparison != 2 && comparison > 0;
                case hir.BinaryOp.GreaterEqual:
                    value = comparison != 2 && comparison >= 0;
                default: {}
            }
            return FloatFold.Boolean(value);
        }
        default: {}
    }
    return FloatFold.Empty;
}
