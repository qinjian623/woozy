// Writable place construction and inout place type checks (CPP 2454-2864).
package sema;
import "app/wzcc/sema/core" as semacore;
import "app/wzcc/sema/typecheck" as sematypes;

import "app/wzcc/semaeffects" as effects;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/sema/borrow" as borrow;
import "std/option" as option;
import "std/vec" as vec;

func check_inout_place_type(state inout semacore.Checker, r model.NodeRef,
                            type_id usize) throws semacore.Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    if !sematypes.owning_inout_type(inout state, type_id,
            option.Option[usize].None) &&
       !sematypes.template_inout_type(inout state, type_id) {
        let reason = sematypes.owning_inout_reason(inout state, type_id,
            option.Option[usize].None);
        if reason == "" {
            throw semacore.unavailable(inout state, r,
                "inout requires a whole Woozy value place");
        }
        throw semacore.unavailable(inout state, r, reason);
    }
}

func place_root(state inout semacore.Checker, id usize) option.Option[usize] throws semacore.Error {
    try { return borrow.place_root(state.m, id); }
    catch problem effects.Error { throw semacore.effect_error(inout state, problem); }
}

func place(state inout semacore.Checker, r model.NodeRef, inout_mode bool) semacore.Expr throws semacore.Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let n = semacore.b_ast_m(b_module, r);
    if semacore.b_kind_is(n.kind, model.AstKind.Parenthesized) {
        return place(inout state, semacore.b_child_m(b_module, r, 0), inout_mode);
    }
    if semacore.b_kind_is(n.kind, model.AstKind.NeutralBracket) {
        let base = expression(inout state, semacore.b_child_m(b_module, r, 0),
            option.Option[usize].None);
        let receiver = semacore.lookup_type(inout state, base.value.type_id);
        if effects.b_type_kind_is(receiver.kind, model.TypeKind.ForeignOpaque) {
            if inout_mode {
                throw semacore.unavailable(inout state, r,
                    "external indexed inout is not supported");
            }
            if vec.len(n.children) != 2 {
                throw semacore.reject(inout state, r,
                    "external indexing requires exactly one index",
                    "E_TYPE_MISMATCH");
            }
            let index_id = foreign_indexer(inout state, base.value.type_id);
            var binding usize = 0;
            switch index_id {
                case option.Option.Some(value): binding = value;
                case option.Option.None:
                    throw semacore.unavailable(inout state, r,
                        "external indexing is not declared");
            }
            let declaration = b_foreign_indexer_declaration(inout state, binding);
            if !declaration.writable {
                throw semacore.unavailable(inout state, r,
                    "external indexing is read-only");
            }
            let index_type = sematypes.declared_foreign_type(inout state,
                declaration.index_type);
            let index = expression(inout state, semacore.b_child_m(b_module, r, 1),
                option.Option[usize].Some(index_type));
            b_match(inout state, r, index.value.type_id,
                option.Option[usize].Some(index_type));
            let record = semacore.b_foreign_binding(inout state, binding);
            let access = hir.ForeignRead(binding: binding,
                access: option.Option[hir.ForeignAccessKind].Some(
                    hir.ForeignAccessKind.IndexPlace),
                start: option.Option[usize].None, end: option.Option[usize].None);
            return semacore.Expr(id: semacore.node(inout state, r, record.type_id,
                           hir.NodeData.ForeignRead(value: access),
                           [base.id, index.id]),
                value: semacore.b_empty_value(record.type_id));
        }
        if effects.b_type_kind_is(receiver.kind, model.TypeKind.CForeignPointer) ||
           effects.b_type_kind_is(receiver.kind, model.TypeKind.CForeignBuffer) {
            if inout_mode {
                throw semacore.unavailable(inout state, r,
                    "C pointer/buffer inout is not supported");
            }
            if state.unsafe_depth == 0 {
                throw semacore.reject(inout state, r,
                    "C pointer/buffer indexing requires unsafe",
                    "E_TYPE_MISMATCH");
            }
            if receiver.bits == 0 {
                throw semacore.reject(inout state, r,
                    "C pointer/buffer is read-only", "E_TYPE_MISMATCH");
            }
            if vec.len(n.children) != 2 {
                throw semacore.reject(inout state, r,
                    "C pointer requires one index", "E_CALL_ARGUMENT");
            }
            let index = expression(inout state, semacore.b_child_m(b_module, r, 1),
                option.Option[usize].None);
            if !semacore.integer(inout state, index.value.type_id) {
                throw semacore.reject(inout state, r,
                    "C pointer index must be integer", "E_TYPE_MISMATCH");
            }
            if vec.len(receiver.type_args) == 0 {
                throw semacore.internal_error("C pointer has no pointee");
            }
            let type_id = receiver.type_args[0];
            if effects.b_type_kind_is(semacore.lookup_type(inout state, type_id).kind,
                              model.TypeKind.Unit) {
                throw semacore.reject(inout state, r,
                    "void pointer cannot be indexed", "E_TYPE_MISMATCH");
            }
            return semacore.Expr(id: semacore.node(inout state, r, type_id,
                           hir.NodeData.IndexPlace(value: hir.IndexPlace()),
                           [base.id, index.id]),
                value: semacore.b_empty_value(type_id));
        }
        if !effects.b_type_kind_is(receiver.kind, model.TypeKind.Vec) &&
           !effects.b_type_kind_is(receiver.kind, model.TypeKind.Slice) {
            throw semacore.reject(inout state, r,
                "index receiver must be Vec or Slice", "E_TYPE_MISMATCH");
        }
        if vec.len(n.children) != 2 {
            throw semacore.reject(inout state, r, "indexing requires one index",
                "E_TYPE_MISMATCH");
        }
        let index = expression(inout state, semacore.b_child_m(b_module, r, 1),
            option.Option[usize].None);
        if !semacore.integer(inout state, index.value.type_id) {
            throw semacore.reject(inout state, r, "index must be integer", "E_TYPE_MISMATCH");
        }
        if vec.len(receiver.type_args) == 0 {
            throw semacore.internal_error("container has no element type");
        }
        let type_id = receiver.type_args[0];
        if inout_mode {
            switch place_root(inout state, base.id) {
                case option.Option.Some(root): {}
                case option.Option.None:
                    throw semacore.reject(inout state, r,
                        "inout index receiver must be binding-backed",
                        "E_CALL_ARGUMENT");
            }
            check_inout_place_type(inout state, r, type_id);
        }
        return semacore.Expr(id: semacore.node(inout state, r, type_id,
                       hir.NodeData.IndexPlace(value: hir.IndexPlace()),
                       [base.id, index.id]),
            value: semacore.b_empty_value(type_id));
    }
    if semacore.b_kind_is(n.kind, model.AstKind.Slice) {
        if inout_mode {
            throw semacore.unavailable(inout state, r, "slice inout is not supported");
        }
        let base = expression(inout state, semacore.b_child_m(b_module, r, 0),
            option.Option[usize].None);
        if !effects.b_type_kind_is(semacore.lookup_type(inout state, base.value.type_id).kind,
                           model.TypeKind.ForeignOpaque) {
            throw semacore.unavailable(inout state, r,
                "slice assignment requires a declared external slice");
        }
        let slice_id = foreign_slice(inout state, base.value.type_id);
        var binding usize = 0;
        switch slice_id {
            case option.Option.Some(value): binding = value;
            case option.Option.None:
                throw semacore.unavailable(inout state, r,
                    "external slicing is not declared");
        }
        let declaration = b_foreign_slice_declaration(inout state, binding);
        if !declaration.writable {
            throw semacore.unavailable(inout state, r, "external slicing is read-only");
        }
        var colon = semacore.b_ast_m(b_module, semacore.b_child_m(b_module, r, 0)).token_end + 1;
        if vec.len(n.children) > 1 &&
           semacore.b_kind_is(semacore.b_ast_m(b_module, semacore.b_child_m(b_module, r, 1)).kind,
                     model.AstKind.BracketItem) {
            colon = semacore.b_ast_m(b_module, semacore.b_child_m(b_module, r, 1)).token_end;
        }
        if semacore.b_token_index(inout state, r, colon) != ":" {
            throw semacore.reject(inout state, r, "invalid slice delimiter",
                "E_TYPE_MISMATCH");
        }
        let values = vec.empty[usize]();
        vec.push(values, base.id);
        var access = hir.ForeignRead(binding: binding,
            access: option.Option[hir.ForeignAccessKind].Some(
                hir.ForeignAccessKind.SlicePlace),
            start: option.Option[usize].None, end: option.Option[usize].None);
        for var index usize = 1; index < vec.len(n.children); index += 1 {
            let endpoint = semacore.b_child_m(b_module, r, index);
            let start = semacore.b_ast_m(b_module, endpoint).token_begin < colon;
            var declared = option.Option[string].None;
            if start { declared = declaration.start_type; }
            else { declared = declaration.end_type; }
            var type_name = "";
            switch declared {
                case option.Option.Some(value): type_name = value;
                case option.Option.None:
                    throw semacore.reject(inout state, r,
                        "external slice endpoint is not declared",
                        "E_TYPE_MISMATCH");
            }
            let type_id = sematypes.declared_foreign_type(inout state, type_name);
            let e = expression(inout state, endpoint,
                option.Option[usize].Some(type_id));
            b_match(inout state, endpoint, e.value.type_id,
                option.Option[usize].Some(type_id));
            vec.push(values, e.id);
            if start { access.start = option.Option[usize].Some(e.id); }
            else { access.end = option.Option[usize].Some(e.id); }
        }
        let record = semacore.b_foreign_binding(inout state, binding);
        return semacore.Expr(id: semacore.node(inout state, r, record.type_id,
                       hir.NodeData.ForeignRead(value: access), values),
            value: semacore.b_empty_value(record.type_id));
    }
    if semacore.b_kind_is(n.kind, model.AstKind.Member) {
        switch peek_type(inout state, semacore.b_child_m(b_module, r, 0)) {
            case option.Option.Some(type_id): {
                if effects.b_type_kind_is(semacore.lookup_type(inout state, type_id).kind,
                                  model.TypeKind.ForeignOpaque) {
                    if inout_mode {
                        throw semacore.unavailable(inout state, r,
                            "external property inout is not supported");
                    }
                    let base = expression(inout state, semacore.b_child_m(b_module, r, 0),
                        option.Option[usize].None);
                    let name = semacore.b_last_token_m(b_module, r);
                    let property = foreign_property(inout state, base.value.type_id,
                        name);
                    var binding usize = 0;
                    switch property {
                        case option.Option.Some(value): binding = value;
                        case option.Option.None:
                            throw semacore.unavailable(inout state, r,
                                "external property is not declared");
                    }
                    let declaration = b_foreign_property_declaration(inout state,
                        binding);
                    if vec.len(declaration.setter) == 0 {
                        throw semacore.unavailable(inout state, r,
                            "external property is read-only");
                    }
                    let record = semacore.b_foreign_binding(inout state, binding);
                    let access = hir.ForeignRead(binding: binding,
                        access: option.Option[hir.ForeignAccessKind].Some(
                            hir.ForeignAccessKind.PropertyPlace),
                        start: option.Option[usize].None,
                        end: option.Option[usize].None);
                    return semacore.Expr(id: semacore.node(inout state, r, record.type_id,
                                   hir.NodeData.ForeignRead(value: access),
                                   [base.id]),
                        value: semacore.b_empty_value(record.type_id));
                }
            }
            case option.Option.None: {}
        }
        let base = place(inout state, semacore.b_child_m(b_module, r, 0), false);
        let field = find_field(inout state, r, base.value.type_id);
        let type_id = sematypes.field_type(inout state, base.value.type_id, field);
        if inout_mode {
            switch place_root(inout state, base.id) {
                case option.Option.Some(root): {}
                case option.Option.None:
                    throw semacore.reject(inout state, r,
                        "inout field receiver must be binding-backed",
                        "E_CALL_ARGUMENT");
            }
            check_inout_place_type(inout state, r, type_id);
        }
        return semacore.Expr(id: semacore.node(inout state, r, type_id,
                       hir.NodeData.FieldPlace(value: hir.FieldPlace(
                           field: field.symbol)),
                       [base.id]),
            value: semacore.b_empty_value(type_id));
    }
    if !semacore.b_kind_is(n.kind, model.AstKind.Name) {
        throw semacore.unavailable(inout state, r,
            "only a whole writable scalar binding can be used as a place");
    }
    var symbol_id = option.Option[usize].None;
    switch semacore.occurrence(inout state, r) {
        case option.Option.Some(value): symbol_id = option.Option[usize].Some(value);
        case option.Option.None: {}
    }
    switch symbol_id {
        case option.Option.Some(value):
            switch semacore.b_capture_origin_find(inout state, value) {
                case option.Option.Some(mapped):
                    symbol_id = option.Option[usize].Some(mapped);
                case option.Option.None: {}
            }
        case option.Option.None: {}
    }
    var id usize = 0;
    var have_id = false;
    switch symbol_id {
        case option.Option.Some(value): { id = value; have_id = true; }
        case option.Option.None: {}
    }
    if !have_id {
        if inout_mode {
            throw semacore.reject(inout state, r, "place is not a local binding",
                "E_CALL_ARGUMENT");
        }
        throw semacore.reject(inout state, r, "place is not a local binding",
            "E_TYPE_MISMATCH");
    }
    var local = semacore.Local(type_id: 0, writable: false,
        ordinary_parameter: false, read_only_capture: false);
    var have_local = false;
    switch semacore.b_locals_find(inout state, id) {
        case option.Option.Some(value): { local = value; have_local = true; }
        case option.Option.None: {}
    }
    if !have_local {
        if inout_mode {
            throw semacore.reject(inout state, r, "place is not a local binding",
                "E_CALL_ARGUMENT");
        }
        throw semacore.reject(inout state, r, "place is not a local binding",
            "E_TYPE_MISMATCH");
    }
    if local.read_only_capture {
        if inout_mode {
            throw semacore.reject(inout state, r, "a captured binding is read-only",
                "E_CALL_ARGUMENT");
        }
        throw semacore.reject(inout state, r, "a captured binding is read-only",
            "E_TYPE_MISMATCH");
    }
    if local.ordinary_parameter {
        if inout_mode {
            throw semacore.reject(inout state, r,
                "an ordinary parameter is not a var or an exclusive inout binding",
                "E_CALL_ARGUMENT");
        }
        throw semacore.reject(inout state, r,
            "ordinary parameters are read-only; declare a var local to change the value",
            "E_TYPE_MISMATCH");
    }
    if !local.writable {
        if inout_mode {
            throw semacore.reject(inout state, r, "let/const bindings are not writable",
                "E_CALL_ARGUMENT");
        }
        throw semacore.reject(inout state, r, "let/const bindings are not writable",
            "E_TYPE_MISMATCH");
    }
    if inout_mode { check_inout_place_type(inout state, r, local.type_id); }
    return semacore.Expr(id: semacore.node(inout state, r, local.type_id,
                   hir.NodeData.Place(value: hir.Place(symbol: id)), []),
        value: semacore.b_empty_value(local.type_id));
}

func b_foreign_property_declaration(state inout semacore.Checker, binding usize)
    model.BindingProperty throws semacore.Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let project = state.m.resolved.project;
    if binding >= vec.len(project.foreign_bindings) {
        throw semacore.internal_error("invalid foreign property declaration");
    }
    switch project.foreign_bindings[binding].detail {
        case model.ForeignDetail.Property(value): return value;
        default: throw semacore.internal_error("foreign property binding has wrong kind");
    }
}
