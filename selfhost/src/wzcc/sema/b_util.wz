// Shared B-side helpers for the Checker port.
//
// These routines mirror the small C++ containers used by check.cpp: sorted
// maps/sets over integer keys, deep copies for value records, and the few
// AST/type predicates that are needed by more than one of the b_*.wz files.
package sema;

import "app/wzcc/bigint" as bigint;
import "app/wzcc/hir" as hir;
import "app/wzcc/hirclone" as hirclone;
import "app/wzcc/model" as model;
import "std/option" as option;
import "std/vec" as vec;

func b_support_message(error model.SupportError) string {
    switch error {
        case model.SupportError.Invalid(message): return message;
        case model.SupportError.Limit(message): return message;
    }
}

func b_kind_is(actual model.AstKind, expected model.AstKind) bool {
    return model.ast_kind_id(actual) == model.ast_kind_id(expected);
}

func b_type_kind_is(actual model.TypeKind, expected model.TypeKind) bool {
    return model.type_kind_id(actual) == model.type_kind_id(expected);
}

func b_node_kind_is(actual hir.NodeKind, expected hir.NodeKind) bool {
    return hir.node_kind_id(actual) == hir.node_kind_id(expected);
}

func b_symbol_kind_is(actual model.SymbolKind, expected model.SymbolKind) bool {
    return model.symbol_kind_id(actual) == model.symbol_kind_id(expected);
}

func b_foreign_export_kind_is(actual model.ForeignExportKind,
                              expected model.ForeignExportKind) bool {
    switch actual {
        case model.ForeignExportKind.Type:
            switch expected { case model.ForeignExportKind.Type: return true; default: return false; }
        case model.ForeignExportKind.Value:
            switch expected { case model.ForeignExportKind.Value: return true; default: return false; }
        case model.ForeignExportKind.Function:
            switch expected { case model.ForeignExportKind.Function: return true; default: return false; }
    }
}

func b_mode_is(actual model.ParamMode, expected model.ParamMode) bool {
    switch actual {
        case model.ParamMode.Ordinary:
            switch expected { case model.ParamMode.Ordinary: return true; default: return false; }
        case model.ParamMode.Inout:
            switch expected { case model.ParamMode.Inout: return true; default: return false; }
        case model.ParamMode.Move:
            switch expected { case model.ParamMode.Move: return true; default: return false; }
    }
}

func b_exit_kind_is(actual hir.ExitKind, expected hir.ExitKind) bool {
    switch actual {
        case hir.ExitKind.Normal:
            switch expected { case hir.ExitKind.Normal: return true; default: return false; }
        case hir.ExitKind.Return:
            switch expected { case hir.ExitKind.Return: return true; default: return false; }
        case hir.ExitKind.Break:
            switch expected { case hir.ExitKind.Break: return true; default: return false; }
        case hir.ExitKind.Continue:
            switch expected { case hir.ExitKind.Continue: return true; default: return false; }
        case hir.ExitKind.Error:
            switch expected { case hir.ExitKind.Error: return true; default: return false; }
        case hir.ExitKind.Cancel:
            switch expected { case hir.ExitKind.Cancel: return true; default: return false; }
    }
}

func b_option_is_some(value option.Option[usize]) bool {
    switch value { case option.Option.Some(id): return true; case option.Option.None: return false; }
}

func b_option_value(value option.Option[usize], fallback usize) usize {
    switch value { case option.Option.Some(id): return id; case option.Option.None: return fallback; }
}

func b_option_equal(left option.Option[usize], right option.Option[usize]) bool {
    switch left {
        case option.Option.Some(a):
            switch right {
                case option.Option.Some(b): return a == b;
                case option.Option.None: return false;
            }
        case option.Option.None:
            switch right {
                case option.Option.Some(b): return false;
                case option.Option.None: return true;
            }
    }
}

func b_vec_contains_unsorted(values Vec[usize], value usize) bool {
    for item in values { if item == value { return true; } }
    return false;
}

func b_vec_lower_bound(values Vec[usize], value usize) usize {
    var low usize = 0;
    var high = vec.len(values);
    for low < high {
        let mid = low + (high - low) / 2;
        if values[mid] < value {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

func b_vec_contains(values Vec[usize], value usize) bool {
    let position = b_vec_lower_bound(values, value);
    return position < vec.len(values) && values[position] == value;
}

// Sorted, unique set insertion. Flow errors/breaks/continues are std::set in
// C++, so their published order must not depend on traversal order.
func b_insert_sorted(values Vec[usize], value usize) {
    let position = b_vec_lower_bound(values, value);
    let n = vec.len(values);
    if position < n && values[position] == value { return; }
    vec.push(values, value);
    var index = n;
    for index > position {
        values[index] = values[index - 1];
        index -= 1;
    }
    values[position] = value;
}

func b_remove_id(values Vec[usize], value usize) {
    let position = b_vec_lower_bound(values, value);
    let n = vec.len(values);
    if position >= n || values[position] != value {
        return;
    }
    var shift = position;
    for shift + 1 < n {
        values[shift] = values[shift + 1];
        shift += 1;
    }
    let discarded = vec.pop(values);
}

func b_copy_ids(values Vec[usize]) Vec[usize] {
    let out = vec.empty[usize]();
    for value in values { vec.push(out, value); }
    return out;
}

func b_copy_u64_ids(values Vec[u64]) Vec[u64] {
    let out = vec.empty[u64]();
    for value in values { vec.push(out, value); }
    return out;
}

func b_ids_equal(left Vec[usize], right Vec[usize]) bool {
    if vec.len(left) != vec.len(right) { return false; }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if left[index] != right[index] { return false; }
    }
    return true;
}

func b_copy_bigint(value bigint.BigInt) bigint.BigInt {
    let limbs = vec.empty[u32]();
    for limb in value.limbs { vec.push(limbs, limb); }
    return bigint.BigInt(sign: value.sign, limbs: limbs);
}

func b_copy_value(value Value) Value {
    var out = value;
    switch value.integer {
        case option.Option.Some(integer):
            out.integer = option.Option[bigint.BigInt].Some(b_copy_bigint(integer));
        case option.Option.None: {}
    }
    return out;
}

func b_empty_value(type_id usize) Value {
    return Value(type_id: type_id, integer: option.Option[bigint.BigInt].None,
        boolean: option.Option[bool].None, floating: option.Option[u64].None,
        string_value: option.Option[string].None);
}

func b_integer_value(type_id usize, value bigint.BigInt) Value {
    return Value(type_id: type_id, integer: option.Option[bigint.BigInt].Some(value),
        boolean: option.Option[bool].None, floating: option.Option[u64].None,
        string_value: option.Option[string].None);
}

func b_bool_value(type_id usize, value bool) Value {
    return Value(type_id: type_id, integer: option.Option[bigint.BigInt].None,
        boolean: option.Option[bool].Some(value), floating: option.Option[u64].None,
        string_value: option.Option[string].None);
}

func b_float_value(type_id usize, value u64) Value {
    return Value(type_id: type_id, integer: option.Option[bigint.BigInt].None,
        boolean: option.Option[bool].None, floating: option.Option[u64].Some(value),
        string_value: option.Option[string].None);
}

func b_string_value(type_id usize, value string) Value {
    return Value(type_id: type_id, integer: option.Option[bigint.BigInt].None,
        boolean: option.Option[bool].None, floating: option.Option[u64].None,
        string_value: option.Option[string].Some(value));
}

func b_empty_expr() Expr {
    return Expr(id: 0, value: b_empty_value(0));
}

func b_clone_constant_value(value hir.ConstantValue) hir.ConstantValue throws Error {
    try { return hirclone.clone_constant(value); }
    catch error model.SupportError { throw Error.Support(error); }
}

func b_copy_constant(value Constant) Constant throws Error {
    var out = Constant(value: b_copy_value(value.value), function: value.function,
        type_args: b_copy_ids(value.type_args),
        aggregate: option.Option[hir.ConstantValue].None);
    switch value.aggregate {
        case option.Option.Some(aggregate):
            out.aggregate = option.Option[hir.ConstantValue].Some(
                b_clone_constant_value(aggregate));
        case option.Option.None: {}
    }
    return out;
}

func b_copy_trait_ref(value hir.TraitRef) hir.TraitRef {
    return hir.TraitRef(declaration: value.declaration,
        args: b_copy_ids(value.args));
}

func b_copy_optional_trait(value option.Option[hir.TraitRef])
    option.Option[hir.TraitRef] {
    switch value {
        case option.Option.Some(trait_ref):
            return option.Option[hir.TraitRef].Some(b_copy_trait_ref(trait_ref));
        case option.Option.None: return option.Option[hir.TraitRef].None;
    }
}

func b_trait_ref_equal(left hir.TraitRef, right hir.TraitRef) bool {
    return left.declaration == right.declaration &&
        b_ids_equal(left.args, right.args);
}

func b_optional_trait_equal(left option.Option[hir.TraitRef],
                            right option.Option[hir.TraitRef]) bool {
    switch left {
        case option.Option.Some(a):
            switch right {
                case option.Option.Some(b): return b_trait_ref_equal(a, b);
                case option.Option.None: return false;
            }
        case option.Option.None:
            switch right {
                case option.Option.Some(b): return false;
                case option.Option.None: return true;
            }
    }
}

func b_generic_params(state inout Checker,
                      owner usize) Vec[hir.GenericParam] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    switch a_generic_params_get(state.generic_params, owner) {
        case option.Option.Some(params): {
            let out = vec.empty[hir.GenericParam]();
            for parameter in params {
                var copied = parameter;
                copied.trait_ref = b_copy_optional_trait(parameter.trait_ref);
                vec.push(out, copied);
            }
            return out;
        }
        case option.Option.None: return vec.empty[hir.GenericParam]();
    }
}

func b_parameters_find(state inout Checker, owner usize)
    option.Option[Vec[hir.Parameter]] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    switch a_parameters_get(state.parameters, owner) {
        case option.Option.Some(values): {
            let out = vec.empty[hir.Parameter]();
            for parameter in values { vec.push(out, parameter); }
            return option.Option[Vec[hir.Parameter]].Some(out);
        }
        case option.Option.None: return option.Option[Vec[hir.Parameter]].None;
    }
}

func b_signature_find(state inout Checker, symbol usize)
    option.Option[usize] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    return a_symbol_type_get(state.signatures, symbol);
}

func b_locals_pos(entries Vec[LocalEntry], symbol usize) usize {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].symbol < symbol { low = mid + 1; } else { high = mid; }
    }
    return low;
}

func b_locals_find(state inout Checker, symbol usize) option.Option[Local] throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_locals_pos(state.locals, symbol);
    if position < vec.len(state.locals) && state.locals[position].symbol == symbol {
        return option.Option[Local].Some(state.locals[position].value);
    }
    return option.Option[Local].None;
}

func b_locals_set(state inout Checker, symbol usize, value Local) { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_locals_pos(state.locals, symbol);
    let n = vec.len(state.locals);
    if position < n && state.locals[position].symbol == symbol {
        state.locals[position].value = value;
        return;
    }
    vec.push(state.locals, LocalEntry(symbol: symbol, value: value));
    var index = n;
    for index > position {
        state.locals[index] = state.locals[index - 1];
        index -= 1;
    }
    state.locals[position] = LocalEntry(symbol: symbol, value: value);
}

func b_locals_clear(state inout Checker) { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    state.locals = vec.empty[LocalEntry]();
}

func b_constants_pos(entries Vec[ConstantEntry], symbol usize) usize {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].symbol < symbol { low = mid + 1; } else { high = mid; }
    }
    return low;
}

func b_constants_find(state inout Checker, symbol usize)
    option.Option[Constant] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_constants_pos(state.constants, symbol);
    if position < vec.len(state.constants) && state.constants[position].symbol == symbol {
        return option.Option[Constant].Some(b_copy_constant(state.constants[position].value));
    }
    return option.Option[Constant].None;
}

func b_constants_set(state inout Checker, symbol usize, value Constant) throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let copied = b_copy_constant(value);
    let position = b_constants_pos(state.constants, symbol);
    let n = vec.len(state.constants);
    if position < n && state.constants[position].symbol == symbol {
        state.constants[position].value = copied;
        return;
    }
    vec.push(state.constants, ConstantEntry(symbol: symbol, value: copied));
    var index = n;
    for index > position {
        state.constants[index] = state.constants[index - 1];
        index -= 1;
    }
    state.constants[position] = ConstantEntry(symbol: symbol, value: copied);
}

func b_evaluating_add(state inout Checker, symbol usize) bool { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    if b_vec_contains(state.evaluating, symbol) { return false; }
    b_insert_sorted(state.evaluating, symbol);
    return true;
}

func b_evaluating_remove(state inout Checker, symbol usize) { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    b_remove_id(state.evaluating, symbol);
}

func b_closures_pos(entries Vec[ClosureEntry], symbol usize) usize {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].symbol < symbol { low = mid + 1; } else { high = mid; }
    }
    return low;
}

func b_closures_find(state inout Checker, symbol usize)
    option.Option[ClosureInfo] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_closures_pos(state.closures, symbol);
    if position < vec.len(state.closures) && state.closures[position].symbol == symbol {
        return option.Option[ClosureInfo].Some(
            b_closure_copy(state.closures[position].value));
    }
    return option.Option[ClosureInfo].None;
}

func b_closure_copy(value ClosureInfo) ClosureInfo {
    let bindings = vec.empty[hir.CaptureBinding]();
    let sources = vec.empty[hir.CaptureSource]();
    for binding in value.bindings { vec.push(bindings, binding); }
    for source in value.sources { vec.push(sources, source); }
    return ClosureInfo(bindings: bindings, sources: sources,
        is_move: value.is_move);
}

func b_closures_set(state inout Checker, symbol usize, value ClosureInfo) { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let stored = b_closure_copy(value);
    let position = b_closures_pos(state.closures, symbol);
    let n = vec.len(state.closures);
    if position < n && state.closures[position].symbol == symbol {
        state.closures[position].value = stored;
        return;
    }
    vec.push(state.closures, ClosureEntry(symbol: symbol, value: stored));
    var index = n;
    for index > position {
        state.closures[index] = state.closures[index - 1];
        index -= 1;
    }
    state.closures[position] = ClosureEntry(symbol: symbol, value: stored);
}

func b_capture_origin_pos(entries Vec[CaptureOriginEntry], origin usize) usize {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].origin < origin { low = mid + 1; } else { high = mid; }
    }
    return low;
}

func b_capture_origin_find(state inout Checker, origin usize)
    option.Option[usize] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_capture_origin_pos(state.capture_by_origin, origin);
    if position < vec.len(state.capture_by_origin) &&
       state.capture_by_origin[position].origin == origin {
        return option.Option[usize].Some(state.capture_by_origin[position].local);
    }
    return option.Option[usize].None;
}

func b_capture_local_pos(entries Vec[CaptureLocalEntry], local usize) usize {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].local < local { low = mid + 1; } else { high = mid; }
    }
    return low;
}

func b_capture_local_find(state inout Checker, local usize)
    option.Option[hir.CaptureBinding] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_capture_local_pos(state.capture_by_local, local);
    if position < vec.len(state.capture_by_local) &&
       state.capture_by_local[position].local == local {
        return option.Option[hir.CaptureBinding].Some(state.capture_by_local[position].value);
    }
    return option.Option[hir.CaptureBinding].None;
}

func b_capture_origin_set(state inout Checker, origin usize, local usize) { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_capture_origin_pos(state.capture_by_origin, origin);
    let n = vec.len(state.capture_by_origin);
    if position < n && state.capture_by_origin[position].origin == origin {
        state.capture_by_origin[position].local = local;
        return;
    }
    vec.push(state.capture_by_origin, CaptureOriginEntry(origin: origin, local: local));
    var index = n;
    for index > position {
        state.capture_by_origin[index] = state.capture_by_origin[index - 1];
        index -= 1;
    }
    state.capture_by_origin[position] = CaptureOriginEntry(origin: origin, local: local);
}

func b_capture_local_set(state inout Checker, local usize,
                         value hir.CaptureBinding) {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let position = b_capture_local_pos(state.capture_by_local, local);
    let n = vec.len(state.capture_by_local);
    if position < n && state.capture_by_local[position].local == local {
        state.capture_by_local[position].value = value;
        return;
    }
    vec.push(state.capture_by_local, CaptureLocalEntry(local: local, value: value));
    var index = n;
    for index > position {
        state.capture_by_local[index] = state.capture_by_local[index - 1];
        index -= 1;
    }
    state.capture_by_local[position] = CaptureLocalEntry(local: local, value: value);
}

func b_captures_clear(state inout Checker) { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    state.capture_by_origin = vec.empty[CaptureOriginEntry]();
    state.capture_by_local = vec.empty[CaptureLocalEntry]();
    state.current_captures = vec.empty[hir.CaptureBinding]();
}

func b_bound_value(state inout Checker, symbol usize)
    option.Option[hir.TraitRef] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    switch a_bound_get(state.bounds, symbol) {
        case option.Option.Some(bound): {
            switch bound {
                case option.Option.Some(trait_ref):
                    return option.Option[hir.TraitRef].Some(b_copy_trait_ref(trait_ref));
                case option.Option.None: return option.Option[hir.TraitRef].None;
            }
        }
        case option.Option.None: return option.Option[hir.TraitRef].None;
    }
}

func b_async_contains(state inout Checker, symbol usize) bool { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    return b_vec_contains(state.async_functions, symbol);
}

func b_type_args0(state inout Checker, type_id usize) usize throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let value = lookup_type(inout state, type_id);
    if vec.len(value.type_args) == 0 {
        throw internal_error("type has no arguments");
    }
    return value.type_args[0];
}

func b_strip_parens(state inout Checker, input model.NodeRef)
    model.NodeRef throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    var value = input;
    for {
        let n = b_ast_m(b_module, value);
        if !b_kind_is(n.kind, model.AstKind.Parenthesized) { break; }
        value = b_child_m(b_module, value, 0);
    }
    return value;
}

func b_last_token(state inout Checker, r model.NodeRef) string throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let n = b_ast_m(b_module, r);
    if n.token_end <= n.token_begin { throw internal_error("empty AST token range"); }
    return b_token_m(b_module, r, n.token_end - n.token_begin - 1);
}

func b_token_index(state inout Checker, r model.NodeRef, index usize)
    string throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let file = b_file_m(b_module, r);
    if index >= vec.len(file.lexed.tokens) {
        throw internal_error("invalid sema token index");
    }
    return file.lexed.tokens[index].spelling;
}

func b_binary_token(state inout Checker, r model.NodeRef) string throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let left = b_child_m(b_module, r, 0);
    let n = b_ast_m(b_module, left);
    return b_token_index(inout state, r, n.token_end);
}

func b_foreign_export(state inout Checker, id usize)
    option.Option[model.ForeignExport] throws Error {
    let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let value = symbol(inout state, id);
    switch value.foreign {
        case option.Option.Some(reference): {
            let project = state.m.resolved.project;
            if reference.module >= vec.len(project.modules) {
                throw internal_error("invalid foreign export module");
            }
            let module = project.modules[reference.module];
            if reference.index >= vec.len(module.foreign_exports) {
                throw internal_error("invalid foreign export index");
            }
            return option.Option[model.ForeignExport].Some(
                module.foreign_exports[reference.index]);
        }
        case option.Option.None: return option.Option[model.ForeignExport].None;
    }
}

func b_module_path(state inout Checker, module usize) string throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    let project = state.m.resolved.project;
    if module >= vec.len(project.modules) {
        throw internal_error("invalid module index");
    }
    return project.modules[module].logical_path;
}

func b_foreign_binding(state inout Checker, binding usize) hir.ForeignBinding throws Error { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    if binding >= vec.len(state.m.foreign_bindings) {
        throw internal_error("invalid foreign binding index");
    }
    return state.m.foreign_bindings[binding];
}

func b_statement_result(id usize, falls bool, breaks bool) Statement {
    return Statement(id: id, falls: falls, breaks: breaks);
}

func b_flow_empty() Flow {
    return Flow(falls: true, errors: vec.empty[usize](),
        breaks: vec.empty[usize](), continues: vec.empty[usize]());
}

func b_flow_merge(out Flow, value Flow) {
    for id in value.errors { b_insert_sorted(out.errors, id); }
    for id in value.breaks { b_insert_sorted(out.breaks, id); }
    for id in value.continues { b_insert_sorted(out.continues, id); }
}

func b_flow_copy(value Flow) Flow {
    return Flow(falls: value.falls, errors: b_copy_ids(value.errors),
        breaks: b_copy_ids(value.breaks), continues: b_copy_ids(value.continues));
}

func b_node_read(node hir.HirNode) option.Option[hir.Read] {
    switch node.data {
        case hir.NodeData.Read(value): return option.Option[hir.Read].Some(value);
        default: return option.Option[hir.Read].None;
    }
}

