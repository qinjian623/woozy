func b_node_foreign_place(node hir.HirNode) bool {
    let read = b_node_foreign_read(node);
    switch read {
        case option.Option.Some(value): {
            switch value.access {
                case option.Option.Some(access): {
                    switch access {
                        case hir.ForeignAccessKind.PropertyPlace: return true;
                        case hir.ForeignAccessKind.IndexPlace: return true;
                        case hir.ForeignAccessKind.SlicePlace: return true;
                        default: return false;
                    }
                }
                case option.Option.None: return false;
            }
        }
        case option.Option.None: return false;
    }
}

func b_node_field_symbol(node hir.HirNode, place bool) option.Option[usize] {
    if place {
        switch node.data {
            case hir.NodeData.FieldPlace(value):
                return option.Option[usize].Some(value.field);
            default: {}
        }
    } else {
        switch node.data {
            case hir.NodeData.FieldRead(value):
                return option.Option[usize].Some(value.field);
            default: {}
        }
    }
    return option.Option[usize].None;
}

func b_copy_place_paths(values Vec[PlacePath]) Vec[PlacePath] {
    let out = vec.empty[PlacePath]();
    for value in values { vec.push(out, value); }
    return out;
}

func b_copy_container_path(value ContainerPath) ContainerPath {
    return ContainerPath(indexes: b_copy_place_paths(value.indexes),
        fields: b_copy_u64_ids(value.fields));
}

func b_path_contains_index(value Vec[PlacePath]) bool {
    for part in value { if part.is_index { return true; } }
    return false;
}

func b_paths_equal(left Vec[PlacePath], right Vec[PlacePath]) bool {
    if vec.len(left) != vec.len(right) { return false; }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if left[index].is_index != right[index].is_index ||
           left[index].known != right[index].known ||
           left[index].value != right[index].value { return false; }
    }
    return true;
}

func b_type_contains_weak_ready(state inout Checker) bool { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    return state.nominal_fields_ready;
}

func b_checked_index(values Vec[bool], index usize) bool {
    if index < vec.len(values) { return values[index]; }
    return false;
}

func b_bool_vec(size usize) Vec[bool] {
    return vec.make[bool](size, false);
}

func b_scope_is(state inout Checker, id usize) bool { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    return id < vec.len(state.m.scopes);
}

func b_node_id_valid(state inout Checker, id usize) bool { let b_module=state.m;
    let b_unit=state.unit; let b_boolean=state.boolean; let b_i64_type=state.i64_type;
    return id < vec.len(state.m.nodes);
}

func b_copy_substitutions(values Vec[model.Substitution]) Vec[model.Substitution] {
    let out = vec.empty[model.Substitution]();
    for value in values { vec.push(out, value); }
    return out;
}

// Read-only AST helpers.  They take the module value instead of Checker so a
// nested argument does not borrow the same inout Checker as the outer call.
func b_file_m(module hir.HirModule, r model.NodeRef) model.ParseResult throws Error {
    let project = module.resolved.project;
    if r.module >= vec.len(project.modules) {
        throw internal_error("invalid sema module reference");
    }
    let owner = project.modules[r.module];
    if r.file >= vec.len(owner.files) {
        throw internal_error("invalid sema file reference");
    }
    let index = owner.files[r.file];
    if index >= vec.len(project.files) {
        throw internal_error("invalid sema parse reference");
    }
    return project.files[index];
}

func b_ast_m(module hir.HirModule, r model.NodeRef) model.AstNode throws Error {
    let file = b_file_m(module, r);
    if r.node >= vec.len(file.nodes) {
        throw internal_error("invalid sema AST reference");
    }
    return file.nodes[r.node];
}

func b_child_m(module hir.HirModule, r model.NodeRef, index usize)
    model.NodeRef throws Error {
    let value = b_ast_m(module, r);
    if index >= vec.len(value.children) {
        throw internal_error("invalid sema child reference");
    }
    return at(r, value.children[index]);
}

func b_token_m(module hir.HirModule, r model.NodeRef, offset usize)
    string throws Error {
    let file = b_file_m(module, r);
    let node = b_ast_m(module, r);
    let length = vec.len(file.lexed.tokens);
    if node.token_begin >= length || offset >= length - node.token_begin {
        throw internal_error("invalid sema token reference");
    }
    return file.lexed.tokens[node.token_begin + offset].spelling;
}

func b_last_token_m(module hir.HirModule, r model.NodeRef) string throws Error {
    let n = b_ast_m(module, r);
    if n.token_end <= n.token_begin { throw internal_error("empty AST token range"); }
    return b_token_m(module, r, n.token_end - n.token_begin - 1);
}

func b_binary_token_m(module hir.HirModule, r model.NodeRef) string throws Error {
    let left = b_child_m(module, r, 0);
    let n = b_ast_m(module, left);
    return b_token_index_m(module, r, n.token_end);
}

func b_token_index_m(module hir.HirModule, r model.NodeRef, index usize)
    string throws Error {
    let file = b_file_m(module, r);
    if index >= vec.len(file.lexed.tokens) {
        throw internal_error("invalid sema token index");
    }
    return file.lexed.tokens[index].spelling;
}

const BINARY_ADD u32 = 0;
const BINARY_SUBTRACT u32 = 1;
const BINARY_MULTIPLY u32 = 2;
const BINARY_DIVIDE u32 = 3;
const BINARY_REMAINDER u32 = 4;
const BINARY_SHIFT_LEFT u32 = 5;
const BINARY_SHIFT_RIGHT u32 = 6;
const BINARY_BIT_AND u32 = 7;
const BINARY_BIT_OR u32 = 8;
const BINARY_BIT_XOR u32 = 9;
const BINARY_EQUAL u32 = 10;
const BINARY_NOT_EQUAL u32 = 11;

func b_binary_id(op hir.BinaryOp) u32 {
    switch op {
        case hir.BinaryOp.Add: return BINARY_ADD;
        case hir.BinaryOp.Subtract: return BINARY_SUBTRACT;
        case hir.BinaryOp.Multiply: return BINARY_MULTIPLY;
        case hir.BinaryOp.Divide: return BINARY_DIVIDE;
        case hir.BinaryOp.Remainder: return BINARY_REMAINDER;
        case hir.BinaryOp.ShiftLeft: return BINARY_SHIFT_LEFT;
        case hir.BinaryOp.ShiftRight: return BINARY_SHIFT_RIGHT;
        case hir.BinaryOp.BitAnd: return BINARY_BIT_AND;
        case hir.BinaryOp.BitOr: return BINARY_BIT_OR;
        case hir.BinaryOp.BitXor: return BINARY_BIT_XOR;
        case hir.BinaryOp.Equal: return BINARY_EQUAL;
        case hir.BinaryOp.NotEqual: return BINARY_NOT_EQUAL;
        case hir.BinaryOp.Less: return 12;
        case hir.BinaryOp.LessEqual: return 13;
        case hir.BinaryOp.Greater: return 14;
        case hir.BinaryOp.GreaterEqual: return 15;
    }
}
