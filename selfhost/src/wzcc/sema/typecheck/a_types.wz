// CPP check.cpp:208-413, 507-1464, 2865-3020, 3269-3457 and the
// declaration-side foreign wrappers at 3623-3662.
package typecheck;
import "app/wzcc/sema/core" as semacore;
import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/types" as types;
import "app/wzcc/foreign" as foreignlib;
import "app/wzcc/valueops" as valueopslib;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

func trait_key(state semacore.Checker,actual usize,trait_value hir.TraitRef) semacore.TraitKey {
    return semacore.TraitKey(actual:actual,declaration:trait_value.declaration,args:semacore.a_copy_ids(trait_value.args));
}
pub func trait_prototype(state inout semacore.Checker,method usize) option.Option[semacore.MethodPrototypeRef] throws semacore.Error {
    for var trait_index usize=0;trait_index<vec.len(state.m.traits);trait_index+=1 {
        var declaration=state.m.traits[trait_index];
        for var method_index usize=0;method_index<vec.len(declaration.methods);method_index+=1 {
            if declaration.methods[method_index].symbol==method {
                return option.Option[semacore.MethodPrototypeRef].Some(semacore.MethodPrototypeRef(
                    trait_index:trait_index,method_index:method_index));
            }
        }
    }
    return option.Option[semacore.MethodPrototypeRef].None;
}
pub func trait_decl(state inout semacore.Checker,symbol_id usize) option.Option[usize] throws semacore.Error {
    for var index usize=0;index<vec.len(state.m.traits);index+=1 {
        if state.m.traits[index].symbol==symbol_id {return option.Option[usize].Some(index);}
    }
    return option.Option[usize].None;
}
func symbol_from_module(state inout semacore.Checker,symbol_id usize,path string,name string) bool throws semacore.Error {
    var declaration=semacore.symbol(inout state,symbol_id);
    return declaration.name==name && semacore.a_module_path(inout state,declaration.module)==path;
}
pub func std_iterator_trait(state inout semacore.Checker) option.Option[usize] throws semacore.Error {
    for var index usize=0;index<vec.len(state.m.traits);index+=1 {
        let trait_symbol=state.m.traits[index].symbol;
        if symbol_from_module(inout state,trait_symbol,"std/iter","Iterator") {
            return option.Option[usize].Some(index);
        }
    }
    return option.Option[usize].None;
}
pub func std_option(state inout semacore.Checker,type_id usize) bool throws semacore.Error {
    var value=semacore.lookup_type(inout state,type_id);
    return semacore.a_kind(value.kind,model.TypeKind.NominalEnum) &&
        symbol_from_module(inout state,value.declaration,"std/option","Option");
}
pub func iterator_candidate(state inout semacore.Checker,r model.NodeRef,actual usize,trait_index usize)
    option.Option[semacore.IteratorCandidate] throws semacore.Error {
    if trait_index>=vec.len(state.m.traits) {throw semacore.internal_error("invalid sema trait reference");}
    var tr=state.m.traits[trait_index];
    var found=option.Option[semacore.IteratorCandidate].None;
    for var index usize=0;index<vec.len(state.m.impls);index+=1 {
        var implementation=state.m.impls[index];
        switch implementation.trait_ref {
            case option.Option.Some(application): {
                if application.declaration!=tr.symbol || vec.len(application.args)!=1 {continue;}
            }
            case option.Option.None: {continue;}
        }
        var application=option.unwrap_or(implementation.trait_ref,
            hir.TraitRef(declaration:0,args:[]));
        var sub=vec.empty[model.Substitution]();
        if !try_infer(inout state,r,implementation.self_type,actual,sub) {continue;}
        var saved_depth=state.constraint_depth;
        var accepted=true;
        try {let ignored=finish_arguments(inout state,r,implementation.params,sub);}
        catch error semacore.Error {
            switch error {
                case semacore.Error.Rejected(diagnostic,failure): {state.constraint_depth=saved_depth;accepted=false;}
                case semacore.Error.Support(support): throw error;
            }
        }
        if !accepted {continue;}
        let element=semacore.substitute_type(inout state,application.args[0],sub);
        if contains_parameter(inout state,element) {continue;}
        switch found {
            case option.Option.Some(previous): {
                throw semacore.reject(inout state,r,"ambiguous Iterator implementation for for-in","E_TYPE_MISMATCH");
            }
            case option.Option.None: {}
        }
        found=option.Option[semacore.IteratorCandidate].Some(semacore.IteratorCandidate(
            impl_index:option.Option[usize].Some(index),substitutions:sub,element:element));
    }
    return found;
}
func mentions_self(state inout semacore.Checker,type_id usize,self_symbol usize) bool throws semacore.Error {
    var pending=vec.empty[usize]();vec.push(pending,type_id);
    var seen=vec.empty[usize]();
    for vec.len(pending)>0 {
        var popped=vec.pop(pending);let current=option.unwrap_or(popped,0);
        if !semacore.a_insert(seen,current) {continue;}
        var value=semacore.lookup_type(inout state,current);
        if semacore.a_kind(value.kind,model.TypeKind.TypeParameter) && value.declaration==self_symbol {return true;}
        for arg in value.type_args {vec.push(pending,arg);}
        for parameter in value.parameters {vec.push(pending,parameter.type_id);}
        if semacore.a_kind(value.kind,model.TypeKind.Function) {
            vec.push(pending,value.result);
            switch value.throws_type {
                case option.Option.Some(error_type):vec.push(pending,error_type);
                case option.Option.None: {}
            }
        }
    }
    return false;
}
pub func require_object_safe(state inout semacore.Checker,r model.NodeRef,trait_symbol usize) throws semacore.Error {
    var found=trait_decl(inout state,trait_symbol);
    switch found {
        case option.Option.None:throw semacore.reject(inout state,r,"dyn requires a real trait declaration","E_OBJECT_UNSAFE");
        case option.Option.Some(trait_index): {
            var tr=state.m.traits[trait_index];
            for prototype in tr.methods {
                let method_name=semacore.symbol(inout state,prototype.symbol).name;
                var own=method_own_parameters(inout state,prototype.symbol);
                if vec.len(own)>0 {
                    throw semacore.reject(inout state,r,"trait method '"+method_name+
                        "' has generic type parameters and is not object-safe","E_OBJECT_UNSAFE");
                }
                var signature=semacore.lookup_type(inout state,prototype.signature);
                if vec.len(signature.parameters)==0 {
                    throw semacore.reject(inout state,r,"trait method '"+method_name+
                        "' has no Self receiver and is not object-safe","E_OBJECT_UNSAFE");
                }
                if !semacore.a_mode(signature.parameters[0].mode,model.ParamMode.Ordinary) {
                    throw semacore.reject(inout state,r,"trait method '"+method_name+
                        "' does not use an ordinary Self receiver","E_OBJECT_UNSAFE");
                }
                let self_type=semacore.lookup_type(inout state,signature.parameters[0].type_id);
                if !semacore.a_kind(self_type.kind,model.TypeKind.TypeParameter) || self_type.declaration!=tr.self {
                    throw semacore.reject(inout state,r,"trait method '"+method_name+
                        "' does not receive Self as its first parameter","E_OBJECT_UNSAFE");
                }
                switch signature.throws_type {
                    case option.Option.Some(error_type):
                        throw semacore.reject(inout state,r,"throwing trait method '"+method_name+
                            "' is not object-safe","E_OBJECT_UNSAFE");
                    case option.Option.None: {}
                }
                if mentions_self(inout state,signature.result,tr.self) {
                    throw semacore.reject(inout state,r,"trait method '"+method_name+
                        "' returns Self and is not object-safe","E_OBJECT_UNSAFE");
                }
                for var index usize=1;index<vec.len(signature.parameters);index+=1 {
                    var parameter=signature.parameters[index];
                    if !semacore.a_mode(parameter.mode,model.ParamMode.Ordinary) {
                        throw semacore.reject(inout state,r,"trait method '"+method_name+
                            "' uses an owning/inout dispatch parameter","E_OBJECT_UNSAFE");
                    }
                    if mentions_self(inout state,parameter.type_id,tr.self) {
                        throw semacore.reject(inout state,r,"trait method '"+method_name+
                            "' uses Self in a non-receiver parameter","E_OBJECT_UNSAFE");
                    }
                }
            }
        }
    }
}
pub func check_trait_application(state inout semacore.Checker,r model.NodeRef,declaration usize,args Vec[usize])
    hir.TraitRef throws semacore.Error {
    var found=semacore.a_generic_params_get(state.trait_parameters,declaration);
    switch found {
        case option.Option.None:throw semacore.reject(inout state,r,"trait application has no real declaration","E_NAME_KIND");
        case option.Option.Some(parameters): {
            if vec.len(args)!=vec.len(parameters) {
                throw semacore.reject(inout state,r,"wrong number of trait type arguments","E_TYPE_MISMATCH");
            }
        }
    }
    return hir.TraitRef(declaration:declaration,args:semacore.a_copy_ids(args));
}
pub func check_trait_parameter_bounds(state inout semacore.Checker,r model.NodeRef,trait_value hir.TraitRef,
    application usize,depth usize) throws semacore.Error {
    var found=semacore.a_generic_params_get(state.trait_parameters,trait_value.declaration);
    let declaration_found=trait_decl(inout state,trait_value.declaration);
    var declaration_index usize=0;
    switch declaration_found {
        case option.Option.None:throw semacore.reject(inout state,r,"trait application has no real declaration","E_NAME_KIND");
        case option.Option.Some(index):declaration_index=index;
    }
    var declaration=state.m.traits[declaration_index];
    switch found {
        case option.Option.None:throw semacore.reject(inout state,r,"trait application has no real declaration","E_NAME_KIND");
        case option.Option.Some(parameters): {
            if vec.len(trait_value.args)!=vec.len(parameters) {
                throw semacore.reject(inout state,r,"wrong number of trait type arguments","E_TYPE_MISMATCH");
            }
        }
    }
    if depth>=48 {throw semacore.reject(inout state,r,"trait constraint graph exceeds checking budget","E_TYPE_MISMATCH");}
    var key=semacore.TraitKey(actual:application,declaration:trait_value.declaration,args:semacore.a_copy_ids(trait_value.args));
    if !semacore.a_trait_keys_insert(state.active_trait_bounds,key) {return;}
    for arg in trait_value.args {let direct=check_inout_graph(inout state,r,arg,true,option.Option[usize].None,false);}
    var sub=vec.empty[model.Substitution]();
    vec.push(sub,model.Substitution(symbol:declaration.self,type_id:application));
    for var index usize=0;index<vec.len(declaration.params);index+=1 {
        vec.push(sub,model.Substitution(symbol:declaration.params[index].symbol,type_id:trait_value.args[index]));
    }
    let declared_parameters=option.unwrap_or(found,vec.empty[hir.GenericParam]());
    for var index usize=0;index<vec.len(declared_parameters);index+=1 {
        var parameter=declared_parameters[index];
        switch parameter.trait_ref {
            case option.Option.Some(bound_value): {
                var bound=semacore.a_copy_trait_ref(bound_value);
                for var arg_index usize=0;arg_index<vec.len(bound.args);arg_index+=1 {
                    bound.args[arg_index]=semacore.substitute_type(inout state,bound.args[arg_index],sub);
                }
                check_trait_parameter_bounds(inout state,r,bound,trait_value.args[index],depth+1);
                if !satisfies(inout state,r,trait_value.args[index],bound) {
                    throw semacore.reject(inout state,r,
                        "trait argument does not satisfy the trait declaration's parameter constraint",
                        "E_TYPE_MISMATCH");
                }
            }
            case option.Option.None: {}
        }
    }
    check_trait_application_data(inout state,r,trait_value,application);
    semacore.a_trait_keys_remove(state.active_trait_bounds,key);
}
pub func parameter_type(state inout semacore.Checker,symbol_id usize) usize throws semacore.Error {
    var value=model.empty_type(model.TypeKind.TypeParameter);
    value.declaration=symbol_id;
    return semacore.intern_type(inout state,value);
}
pub func template_inout_type(state inout semacore.Checker,type_id usize) bool throws semacore.Error {
    var value=semacore.lookup_type(inout state,type_id);
    if !semacore.a_kind(value.kind,model.TypeKind.TypeParameter) {return false;}
    var declaration=value.declaration;
    if !semacore.a_symbol_kind(semacore.symbol(inout state,declaration).kind,model.SymbolKind.TypeParameter) {return false;}
    if semacore.a_contains(state.signature_parameters,declaration) {return true;}
    for parameter in state.active_params {if parameter.symbol==declaration {return true;}}
    return false;
}
pub func owning_inout_type(state inout semacore.Checker,type_id usize,trait_self option.Option[usize]) bool throws semacore.Error {
    var parameters=semacore.a_copy_ids(state.signature_parameters);
    for parameter in state.active_params {semacore.a_insert(parameters,parameter.symbol);}
    switch trait_self {
        case option.Option.Some(id):semacore.a_insert(parameters,id);
        case option.Option.None: {}
    }
    try {
        switch valueopslib.inout_slot(state.m,type_id,parameters) {
            case hir.InoutSlot.Allowed:return true;
            default:return false;
        }
    } catch error model.SupportError {throw semacore.Error.Support(error);}
}
pub func owning_inout_reason(state inout semacore.Checker,type_id usize,trait_self option.Option[usize]) string throws semacore.Error {
    var parameters=semacore.a_copy_ids(state.signature_parameters);
    for parameter in state.active_params {semacore.a_insert(parameters,parameter.symbol);}
    switch trait_self {
        case option.Option.Some(id):semacore.a_insert(parameters,id);
        case option.Option.None: {}
    }
    try {
        return valueopslib.inout_slot_reason(valueopslib.inout_slot(state.m,type_id,parameters));
    } catch error model.SupportError {throw semacore.Error.Support(error);}
}
pub func trait_self_type(state inout semacore.Checker,type_id usize,self_symbol usize) bool throws semacore.Error {
    var value=semacore.lookup_type(inout state,type_id);
    return semacore.a_kind(value.kind,model.TypeKind.TypeParameter) && value.declaration==self_symbol &&
        semacore.a_symbol_kind(semacore.symbol(inout state,self_symbol).kind,model.SymbolKind.TypeParameter);
}
pub func impl_of(state inout semacore.Checker,target usize) option.Option[usize] throws semacore.Error {
    return semacore.a_impl_index_of(inout state,target);
}
func declared_self(state inout semacore.Checker,target usize) bool throws semacore.Error {
    var found_impl=semacore.a_impl_index_of(inout state,target);
    var implementation_index usize=0;
    switch found_impl {
        case option.Option.None:return false;
        case option.Option.Some(index):implementation_index=index;
    }
    var implementation=state.m.impls[implementation_index];
    var found=semacore.a_parameters_get(state.parameters,target);
    var declared=vec.empty[hir.Parameter]();
    switch found {
        case option.Option.Some(values):declared=values;
        case option.Option.None:return false;
    }
    if vec.len(declared)==0 || declared[0].label!="self" {return false;}
    var signature_found=semacore.a_symbol_type_get(state.signatures,target);
    switch signature_found {
        case option.Option.None:return false;
        case option.Option.Some(signature): {
            var parameters=semacore.lookup_type(inout state,signature).parameters;
            return vec.len(parameters)>0 && parameters[0].type_id==implementation.self_type;
        }
    }
}
pub func inherent_self_source(state inout semacore.Checker,target usize) bool throws semacore.Error {
    var found_impl=semacore.a_impl_index_of(inout state,target);
    var implementation_index usize=0;
    switch found_impl {
        case option.Option.None:return false;
        case option.Option.Some(index):implementation_index=index;
    }
    var implementation=state.m.impls[implementation_index];
    var found=semacore.a_parameters_get(state.parameters,target);
    var declared=vec.empty[hir.Parameter]();
    switch found {
        case option.Option.Some(values):declared=values;
        case option.Option.None:return false;
    }
    switch implementation.trait_ref {
        case option.Option.Some(application):return false;
        case option.Option.None: {}
    }
    if vec.len(declared)==0 {return false;}
    let definition_found=semacore.symbol(inout state,declared[0].symbol).definition;
    var definition=model.NodeRef(module:0,file:0,node:0);
    switch definition_found {
        case option.Option.None:return false;
        case option.Option.Some(value):definition=value;
    }
    if vec.len(semacore.ast(inout state,definition).children)==0 {return false;}
    let raw=semacore.child(inout state,definition,0);
    return semacore.a_option_some_usize(semacore.occurrence(inout state,raw),implementation.self_parameter);
}
pub func inherent_method_source(state inout semacore.Checker,target usize) bool throws semacore.Error {
    var found_impl=semacore.a_impl_index_of(inout state,target);
    var implementation_index usize=0;
    switch found_impl {
        case option.Option.None:return false;
        case option.Option.Some(index):implementation_index=index;
    }
    var implementation=state.m.impls[implementation_index];
    switch implementation.trait_ref {
        case option.Option.Some(application):return false;
        case option.Option.None: {}
    }
    var generics=semacore.a_generic_params_get(state.generic_params,target);
    var parameters=vec.empty[hir.GenericParam]();
    switch generics {
        case option.Option.None:return false;
        case option.Option.Some(values):parameters=values;
    }
    if vec.len(parameters)<vec.len(implementation.params) {return false;}
    for var index usize=0;index<vec.len(implementation.params);index+=1 {
        if parameters[index].symbol!=implementation.params[index].symbol {return false;}
    }
    return true;
}
pub func inherent_method_route(state inout semacore.Checker,target usize,receiver bool,signature usize) bool throws semacore.Error {
    if !inherent_method_source(inout state,target) {return false;}
    var parameters=semacore.lookup_type(inout state,signature).parameters;
    let self=declared_self(inout state,target);
    if receiver {return (self || inherent_self_source(inout state,target)) && vec.len(parameters)>0;}
    return !self;
}
pub func method_own_parameters(state inout semacore.Checker,method usize) Vec[hir.GenericParam] throws semacore.Error {
    var found=semacore.a_generic_params_get(state.generic_params,method);
    var parameters=vec.empty[hir.GenericParam]();
    switch found {
        case option.Option.None:return parameters;
        case option.Option.Some(values):parameters=values;
    }
    var prefix usize=0;
    var impl_found=semacore.a_impl_index_of(inout state,method);
    switch impl_found {
        case option.Option.Some(index):prefix=vec.len(state.m.impls[index].params);
        case option.Option.None: {}
    }
    if vec.len(parameters)<prefix {return vec.empty[hir.GenericParam]();}
    let out=vec.empty[hir.GenericParam]();
    for var index usize=prefix;index<vec.len(parameters);index+=1 {vec.push(out,parameters[index]);}
    return out;
}
pub func trait_impl_signature_matches(state inout semacore.Checker,tr hir.TraitDecl,implementation hir.ImplDecl,
    prototype hir.MethodPrototype,method usize) bool throws semacore.Error {
    let generics_found=semacore.a_generic_params_get(state.generic_params,method);
    var generics=vec.empty[hir.GenericParam]();
    switch generics_found {
        case option.Option.None:return false;
        case option.Option.Some(values):generics=values;
    }
    if vec.len(generics)<vec.len(implementation.params) {return false;}
    for var index usize=0;index<vec.len(implementation.params);index+=1 {
        if generics[index].symbol!=implementation.params[index].symbol {return false;}
    }
    let own=method_own_parameters(inout state,method);
    let prototype_own=method_own_parameters(inout state,prototype.symbol);
    if vec.len(own)!=vec.len(prototype_own) {return false;}
    switch implementation.trait_ref {
        case option.Option.None:return false;
        case option.Option.Some(application): {
            if application.declaration!=tr.symbol || vec.len(application.args)!=vec.len(tr.params) {
                return false;
            }
        }
    }
    var application=option.unwrap_or(implementation.trait_ref,hir.TraitRef(declaration:0,args:[]));
    var sub=vec.empty[model.Substitution]();
    vec.push(sub,model.Substitution(symbol:tr.self,type_id:implementation.self_type));
    for var index usize=0;index<vec.len(tr.params);index+=1 {
        vec.push(sub,model.Substitution(symbol:tr.params[index].symbol,type_id:application.args[index]));
    }
    for var index usize=0;index<vec.len(own);index+=1 {
        vec.push(sub,model.Substitution(symbol:prototype_own[index].symbol,
            type_id:parameter_type(inout state,own[index].symbol)));
    }
    for var index usize=0;index<vec.len(own);index+=1 {
        let left_some=option.is_some(prototype_own[index].trait_ref);
        let right_some=option.is_some(own[index].trait_ref);
        if left_some!=right_some {return false;}
        switch prototype_own[index].trait_ref {
            case option.Option.Some(expected_value): {
                var expected=semacore.a_copy_trait_ref(expected_value);
                for var arg_index usize=0;arg_index<vec.len(expected.args);arg_index+=1 {
                    expected.args[arg_index]=semacore.substitute_type(inout state,expected.args[arg_index],sub);
                }
                switch own[index].trait_ref {
                    case option.Option.Some(actual): {if !semacore.a_trait_equal(expected,actual) {return false;}}
                    case option.Option.None:return false;
                }
            }
            case option.Option.None: {}
        }
    }
    var signature_found=semacore.a_symbol_type_get(state.signatures,method);
    var signature usize=0;
    switch signature_found {
        case option.Option.None:return false;
        case option.Option.Some(value):signature=value;
    }
    let expected_signature=semacore.substitute_type(inout state,prototype.signature,sub);
    var actual_type=semacore.lookup_type(inout state,signature);
    let expected_type=semacore.lookup_type(inout state,expected_signature);
    if !types.equal(actual_type,expected_type) {
        return false;
    }
    let declared_found=semacore.a_parameters_get(state.parameters,method);
    var declared=vec.empty[hir.Parameter]();
    switch declared_found {
        case option.Option.None:return false;
        case option.Option.Some(values):declared=values;
    }
    if vec.len(declared)!=vec.len(prototype.parameters) {return false;}
    for var index usize=0;index<vec.len(declared);index+=1 {
        if declared[index].label!=prototype.parameters[index].label {return false;}
    }
    return true;
}
func a_trait_prototype_by_name(state inout semacore.Checker,tr hir.TraitDecl,name string)
    option.Option[usize] throws semacore.Error {
    var found=option.Option[usize].None;
    for var index usize=0;index<vec.len(tr.methods);index+=1 {
        if semacore.symbol(inout state,tr.methods[index].symbol).name==name {
            switch found {
                case option.Option.Some(previous):return option.Option[usize].None;
                case option.Option.None:found=option.Option[usize].Some(index);
            }
        }
    }
    return found;
}
pub func trait_impl_inout_source(state inout semacore.Checker,target usize,receiver bool)
    option.Option[semacore.TraitMethodSource] throws semacore.Error {
    var found_impl=semacore.a_impl_index_of(inout state,target);
    var implementation_index usize=0;
    switch found_impl {
        case option.Option.None:return option.Option[semacore.TraitMethodSource].None;
        case option.Option.Some(index):implementation_index=index;
    }
    var implementation=state.m.impls[implementation_index];
    var application=hir.TraitRef(declaration:0,args:[]);
    switch implementation.trait_ref {
        case option.Option.None:return option.Option[semacore.TraitMethodSource].None;
        case option.Option.Some(value):application=value;
