    var prototype_signature=semacore.lookup_type(inout state,prototype.signature);
    var method_signature=semacore.lookup_type(inout state,signature);
    if vec.len(prototype.parameters)==0 || vec.len(prototype_signature.parameters)==0 {
        if receiver {return option.Option[semacore.TraitMethodSource].None;}
        return option.Option[semacore.TraitMethodSource].Some(semacore.TraitMethodSource(
            impl_index:implementation_index,trait_index:trait_index,
            prototype_index:prototype_index));
    }
    if vec.len(method_signature.parameters)==0 {return option.Option[semacore.TraitMethodSource].None;}
    if receiver {
        var raw_self=semacore.lookup_type(inout state,prototype_signature.parameters[0].type_id);
        if !semacore.a_kind(raw_self.kind,model.TypeKind.TypeParameter) ||
           raw_self.declaration!=tr.self ||
