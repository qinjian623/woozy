func a_constraint_shared(state inout semacore.Checker,target usize,trait_value hir.TraitRef,receiver usize)
    option.Option[semacore.MethodPrototypeRef] throws semacore.Error {
    let trait_found=trait_decl(inout state,trait_value.declaration);
    var trait_index usize=0;
    switch trait_found {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(index):trait_index=index;
    }
    let receiver_type=semacore.lookup_type(inout state,receiver);
    if !semacore.a_kind(receiver_type.kind,model.TypeKind.TypeParameter) {
        return option.Option[semacore.MethodPrototypeRef].None;
    }
    let bounded=semacore.a_bound_get(state.bounds,receiver_type.declaration);
    var has_bound=false;
    switch bounded {
        case option.Option.Some(value): {
            switch value {
                case option.Option.Some(bound):has_bound=semacore.a_trait_equal(bound,trait_value);
                case option.Option.None: {}
            }
        }
        case option.Option.None: {}
    }
    if !has_bound {return option.Option[semacore.MethodPrototypeRef].None;}
    var active=false;
    for parameter in state.active_params {if parameter.symbol==receiver_type.declaration {active=true;}}
    if !active {return option.Option[semacore.MethodPrototypeRef].None;}
    let generics=semacore.a_generic_params_get(state.generic_params,target);
    switch generics {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(value): {}
    }
    let tr=state.m.traits[trait_index];
    var prototype_found=option.Option[usize].None;
    for var index usize=0;index<vec.len(tr.methods);index+=1 {
        if tr.methods[index].symbol==target {
            switch prototype_found {
                case option.Option.Some(previous):return option.Option[semacore.MethodPrototypeRef].None;
                case option.Option.None:prototype_found=option.Option[usize].Some(index);
            }
        }
    }
    switch prototype_found {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(index):return option.Option[semacore.MethodPrototypeRef].Some(
            semacore.MethodPrototypeRef(trait_index:trait_index,method_index:index));
    }
}
// Value-form T.method keeps the real first-position Self receiver requirement.
func a_constraint_value_self(state inout semacore.Checker,reference semacore.MethodPrototypeRef) bool throws semacore.Error {
    let prototype=state.m.traits[reference.trait_index].methods[reference.method_index];
    if vec.len(prototype.parameters)==0 {return false;}
    let signature=semacore.lookup_type(inout state,prototype.signature);
    if vec.len(signature.parameters)==0 {return false;}
    let raw_self=semacore.lookup_type(inout state,signature.parameters[0].type_id);
    let tr=state.m.traits[reference.trait_index];
    return semacore.a_kind(raw_self.kind,model.TypeKind.TypeParameter) &&
        raw_self.declaration==tr.self;
}
pub func constraint_method_source(state inout semacore.Checker,target usize,trait_value hir.TraitRef,receiver usize)
    option.Option[semacore.MethodPrototypeRef] throws semacore.Error {
    let found=a_constraint_shared(inout state,target,trait_value,receiver);
    switch found {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(reference): {
            if !a_constraint_value_self(inout state,reference) {
                return option.Option[semacore.MethodPrototypeRef].None;
            }
            return found;
        }
    }
}
pub func constraint_method_move_source(state inout semacore.Checker,target usize,trait_value hir.TraitRef,receiver usize)
    option.Option[semacore.MethodPrototypeRef] throws semacore.Error {
    let found=a_constraint_shared(inout state,target,trait_value,receiver);
    switch found {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(reference): {
            if !a_constraint_value_self(inout state,reference) {
                return option.Option[semacore.MethodPrototypeRef].None;
            }
            return found;
        }
    }
}
// CPP 868-909: static move source checks only the declared top-level modes.
pub func constraint_static_method_move_source(state inout semacore.Checker,target usize,trait_value hir.TraitRef,receiver usize)
    option.Option[semacore.MethodPrototypeRef] throws semacore.Error {
    let found=a_constraint_shared(inout state,target,trait_value,receiver);
    var reference=semacore.MethodPrototypeRef(trait_index:0,method_index:0);
    switch found {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(value):reference=value;
    }
    let prototype=state.m.traits[reference.trait_index].methods[reference.method_index];
    let signature=semacore.lookup_type(inout state,prototype.signature);
    var top_level_inout=false;
    for parameter in signature.parameters {
        if semacore.a_mode(parameter.mode,model.ParamMode.Inout) {top_level_inout=true;}
    }
    for parameter in signature.parameters {
        if top_level_inout {
            if !semacore.a_mode(parameter.mode,model.ParamMode.Ordinary) &&
               !semacore.a_mode(parameter.mode,model.ParamMode.Move) &&
               !semacore.a_mode(parameter.mode,model.ParamMode.Inout) {
                return option.Option[semacore.MethodPrototypeRef].None;
            }
        } else {
            if !semacore.a_mode(parameter.mode,model.ParamMode.Ordinary) &&
               !semacore.a_mode(parameter.mode,model.ParamMode.Move) {
                return option.Option[semacore.MethodPrototypeRef].None;
            }
        }
    }
    return found;
}
// CPP 914-959: static value-qualified source keeps its own mode filter.
pub func constraint_static_method_source(state inout semacore.Checker,target usize,trait_value hir.TraitRef,receiver usize)
    option.Option[semacore.MethodPrototypeRef] throws semacore.Error {
    let found=a_constraint_shared(inout state,target,trait_value,receiver);
    var reference=semacore.MethodPrototypeRef(trait_index:0,method_index:0);
    switch found {
        case option.Option.None:return option.Option[semacore.MethodPrototypeRef].None;
        case option.Option.Some(value):reference=value;
    }
    let prototype=state.m.traits[reference.trait_index].methods[reference.method_index];
    let signature=semacore.lookup_type(inout state,prototype.signature);
    var top_level_inout=false;
    for parameter in signature.parameters {
        if semacore.a_mode(parameter.mode,model.ParamMode.Inout) {top_level_inout=true;}
    }
    for parameter in signature.parameters {
        if top_level_inout {
            if !semacore.a_mode(parameter.mode,model.ParamMode.Ordinary) &&
               !semacore.a_mode(parameter.mode,model.ParamMode.Move) &&
               !semacore.a_mode(parameter.mode,model.ParamMode.Inout) {
                return option.Option[semacore.MethodPrototypeRef].None;
            }
        } else {
            if !semacore.a_mode(parameter.mode,model.ParamMode.Ordinary) &&
               !semacore.a_mode(parameter.mode,model.ParamMode.Move) {
                return option.Option[semacore.MethodPrototypeRef].None;
            }
        }
    }
    return found;
}
struct AInoutMemo { pub type_id usize; pub value bool; }
struct AInoutWork { pub type_id usize; pub depth usize; }
func a_inout_memo_get(memo Vec[AInoutMemo],type_id usize) option.Option[bool] {
    for entry in memo {if entry.type_id==type_id {return option.Option[bool].Some(entry.value);}}
    return option.Option[bool].None;
}
func a_inout_memo_set(memo Vec[AInoutMemo],type_id usize,value bool) {
    for var index usize=0;index<vec.len(memo);index+=1 {
        if memo[index].type_id==type_id {memo[index].value=value;return;}
    }
    vec.push(memo,AInoutMemo(type_id:type_id,value:value));
}
func a_has_inout(state inout semacore.Checker,root usize,memo Vec[AInoutMemo]) bool throws semacore.Error {
    var cached=a_inout_memo_get(memo,root);
    switch cached {
        case option.Option.Some(value):return value;
        case option.Option.None: {}
    }
    var seen_types=vec.empty[usize]();
    var seen_declarations=vec.empty[usize]();
    var pending=vec.empty[usize]();vec.push(pending,root);
    for vec.len(pending)>0 {
        var popped=vec.pop(pending);let id=option.unwrap_or(popped,0);
        if !semacore.a_insert(seen_types,id) {continue;}
        var value=semacore.lookup_type(inout state,id);
        for arg in value.type_args {vec.push(pending,arg);}
        if semacore.a_kind(value.kind,model.TypeKind.Function) {
            for parameter in value.parameters {
                if semacore.a_mode(parameter.mode,model.ParamMode.Inout) {
                    a_inout_memo_set(memo,root,true);return true;
                }
                vec.push(pending,parameter.type_id);
            }
            vec.push(pending,value.result);
            switch value.throws_type {
                case option.Option.Some(error_type):vec.push(pending,error_type);
                case option.Option.None: {}
            }
        }
        if !semacore.a_kind(value.kind,model.TypeKind.NominalStruct) &&
           !semacore.a_kind(value.kind,model.TypeKind.NominalEnum) {continue;}
        var declaration=nominal(inout state,id);
        if !semacore.a_insert(seen_declarations,declaration.symbol) {continue;}
        for field in declaration.fields {vec.push(pending,field.type_id);}
        for variant in declaration.variants {
            for field in variant.payload {vec.push(pending,field.type_id);}
        }
    }
    a_inout_memo_set(memo,root,false);
    return false;
}
pub func check_inout_graph(state inout semacore.Checker,r model.NodeRef,root usize,allow_template bool,
    trait_self option.Option[usize],trait_self_callback bool) bool throws semacore.Error {
    let visited_args=vec.empty[usize]();
    let expanded_nominals=vec.empty[usize]();
    var direct_inout=false;
    let inout_memo=vec.empty[AInoutMemo]();
    let work=vec.empty[AInoutWork]();vec.push(work,AInoutWork(type_id:root,depth:0));
    for var next usize=0;next<vec.len(work);next+=1 {
        var item=work[next];let id=item.type_id;let depth=item.depth;
        if depth>512 {
            throw semacore.unavailable(inout state,r,"inout type graph exceeds checking budget");
        }
        var value=semacore.lookup_type(inout state,id);
        if semacore.a_kind(value.kind,model.TypeKind.TypeParameter) {continue;}
        if semacore.a_kind(value.kind,model.TypeKind.Vec) {
            if !semacore.a_insert(visited_args,id) {continue;}
            for arg in value.type_args {vec.push(work,AInoutWork(type_id:arg,depth:depth+1));}
            continue;
        }
        if semacore.a_kind(value.kind,model.TypeKind.NominalStruct) ||
           semacore.a_kind(value.kind,model.TypeKind.NominalEnum) {
            if semacore.a_insert(visited_args,id) {
                for arg in value.type_args {vec.push(work,AInoutWork(type_id:arg,depth:depth+1));}
            }
            var declaration=nominal(inout state,id);
            if semacore.a_insert(expanded_nominals,id) && a_has_inout(inout state,id,inout_memo) {
                var subs=nominal_subs(inout state,id);
                for field in declaration.fields {
                    var concrete=semacore.substitute_type(inout state,field.type_id,subs);
                    vec.push(work,AInoutWork(type_id:concrete,depth:depth+1));
                }
                for variant in declaration.variants {
                    for field in variant.payload {
                        let concrete=semacore.substitute_type(inout state,field.type_id,subs);
                        vec.push(work,AInoutWork(type_id:concrete,depth:depth+1));
                    }
                }
            }
            continue;
        }
        if !semacore.a_kind(value.kind,model.TypeKind.Function) || !semacore.a_insert(visited_args,id) {continue;}
        for var index usize=0;index<vec.len(value.parameters);index+=1 {
            var parameter=value.parameters[index];
            if semacore.a_mode(parameter.mode,model.ParamMode.Inout) {
                if depth==0 {direct_inout=true;}
                var trait_self_slot=false;
                switch trait_self {
                    case option.Option.Some(self_symbol): {
                        trait_self_slot=trait_self_type(inout state,parameter.type_id,self_symbol);
                    }
                    case option.Option.None: {}
                }
                var data_self=option.Option[usize].None;
                switch trait_self {
                    case option.Option.Some(self_symbol): {
                        if depth>0 || index>0 {data_self=option.Option[usize].Some(self_symbol);}
                    }
                    case option.Option.None: {}
                }
                if !owning_inout_type(inout state,parameter.type_id,data_self) &&
                   !(allow_template && template_inout_type(inout state,parameter.type_id)) &&
                   !trait_self_slot {
                    var reason=owning_inout_reason(inout state,parameter.type_id,data_self);
                    if reason=="" {
                        throw semacore.unavailable(inout state,r,"inout accepts only whole Woozy value bindings");
                    }
                    throw semacore.unavailable(inout state,r,reason);
                }
            }
            vec.push(work,AInoutWork(type_id:parameter.type_id,depth:depth+1));
        }
        vec.push(work,AInoutWork(type_id:value.result,depth:depth+1));
        switch value.throws_type {
            case option.Option.Some(error_type):vec.push(work,AInoutWork(type_id:error_type,depth:depth+1));
            case option.Option.None: {}
        }
    }
    return direct_inout;
}
func a_allow_type(state inout semacore.Checker,type_id usize,base Vec[usize],seen Vec[usize]) throws semacore.Error {
    if !semacore.a_insert(seen,type_id) {return;}
    var value=semacore.lookup_type(inout state,type_id);
    if semacore.a_kind(value.kind,model.TypeKind.TypeParameter) {semacore.a_insert(base,value.declaration);return;}
    for arg in value.type_args {a_allow_type(inout state,arg,base,seen);}
    for parameter in value.parameters {a_allow_type(inout state,parameter.type_id,base,seen);}
    if semacore.a_kind(value.kind,model.TypeKind.Function) {
        a_allow_type(inout state,value.result,base,seen);
        switch value.throws_type {
            case option.Option.Some(error_type):a_allow_type(inout state,error_type,base,seen);
            case option.Option.None: {}
        }
    }
}
func check_trait_application_data(state inout semacore.Checker,r model.NodeRef,trait_value hir.TraitRef,application usize) throws semacore.Error {
    let trait_found=trait_decl(inout state,trait_value.declaration);
    var trait_index usize=0;
    switch trait_found {
        case option.Option.None:return;
        case option.Option.Some(index):trait_index=index;
    }
    let tr=state.m.traits[trait_index];
    if vec.len(trait_value.args)!=vec.len(tr.params) {return;}
    var sub=vec.empty[model.Substitution]();
    vec.push(sub,model.Substitution(symbol:tr.self,type_id:application));
    for var index usize=0;index<vec.len(tr.params);index+=1 {
        vec.push(sub,model.Substitution(symbol:tr.params[index].symbol,type_id:trait_value.args[index]));
    }
    let base=vec.empty[usize]();let seen=vec.empty[usize]();
    a_allow_type(inout state,application,base,seen);
    for arg in trait_value.args {a_allow_type(inout state,arg,base,seen);}
    let saved=state.signature_parameters;
    for method in tr.methods {
        state.signature_parameters=semacore.a_copy_ids(base);
        for parameter in method_own_parameters(inout state,method.symbol) {
            semacore.a_insert(state.signature_parameters,parameter.symbol);
        }
        var signature=semacore.substitute_type(inout state,method.signature,sub);
        var direct=check_inout_graph(inout state,r,signature,true,option.Option[usize].None,false);
    }
    state.signature_parameters=saved;
}
pub func check_generic_trait_method_modes(state inout semacore.Checker,r model.NodeRef,
    own Vec[hir.GenericParam],signature usize,trait_self option.Option[usize],generic_trait bool) throws semacore.Error {
    if !generic_trait && vec.len(own)==0 {return;}
    var parameters=semacore.lookup_type(inout state,signature).parameters;
    for parameter in parameters {
        if semacore.a_mode(parameter.mode,model.ParamMode.Ordinary) {continue;}
        if !semacore.a_mode(parameter.mode,model.ParamMode.Move) &&
           !semacore.a_mode(parameter.mode,model.ParamMode.Inout) {
            throw semacore.unavailable(inout state,r,"trait method parameter mode is not implemented");
        }
    }
}
pub func check_function_value_inout(state inout semacore.Checker,r model.NodeRef,target usize,signature usize) throws semacore.Error {
    var direct=check_inout_graph(inout state,r,signature,true,option.Option[usize].None,false);
    if !direct {return;}
    let generics=semacore.a_generic_params_get(state.generic_params,target);
    var has=false;
    switch generics {
        case option.Option.Some(values):has=vec.len(values)>0;
        case option.Option.None: {}
    }
    if has && !free_generic_template(inout state,target) {
        throw semacore.unavailable(inout state,r,"generic/method inout is not implemented");
    }
}
pub func check_method_value_modes(state inout semacore.Checker,r model.NodeRef,target usize,signature usize,
    required option.Option[hir.TraitRef],qualifier option.Option[usize]) throws semacore.Error {
    let direct=check_inout_graph(inout state,r,signature,true,option.Option[usize].None,false);
    if !direct {return;}
    var source=false;
    var have_required=false;var have_qualifier=false;
    var required_value=hir.TraitRef(declaration:0,args:[]);var qualifier_value usize=0;
    switch required {
        case option.Option.Some(value):have_required=true;required_value=value;
        case option.Option.None: {}
    }
    switch qualifier {
        case option.Option.Some(value):have_qualifier=true;qualifier_value=value;
        case option.Option.None: {}
    }
    if have_required && have_qualifier {
        switch constraint_static_method_source(inout state,target,required_value,qualifier_value) {
            case option.Option.Some(value):source=true;
            case option.Option.None: {}
        }
        if !source {
            switch constraint_static_method_move_source(inout state,target,required_value,qualifier_value) {
                case option.Option.Some(value):source=true;
                case option.Option.None: {}
            }
        }
    } else {
        let impl_found=semacore.a_impl_index_of(inout state,target);
        switch impl_found {
            case option.Option.Some(index): {
                switch state.m.impls[index].trait_ref {
                    case option.Option.None: {
                        if inherent_method_source(inout state,target) {source=true;}
                    }
                    case option.Option.Some(application): {}
                }
            }
            case option.Option.None: {}
        }
        if !source {
            switch trait_impl_inout_source(inout state,target,false) {
                case option.Option.Some(value):source=true;
                case option.Option.None: {}
            }
        }
        if !source {
            switch trait_impl_move_source(inout state,target,false) {
                case option.Option.Some(value):source=true;
                case option.Option.None: {}
            }
        }
    }
    if !source {
        throw semacore.unavailable(inout state,r,"method function value move/inout source is not implemented");
    }
}
pub func generics(state inout semacore.Checker,r model.NodeRef) Vec[hir.GenericParam] throws semacore.Error {
    var result=vec.empty[hir.GenericParam]();
    for id in semacore.ast(inout state,r).children {
        let generic_ref=semacore.at(r,id);
        if !a_kind_ast(semacore.ast(inout state,generic_ref).kind,model.AstKind.GenericParameter) {continue;}
        var symbol_id=semacore.definition(inout state,generic_ref);
        var trait_ref=option.Option[hir.TraitRef].None;
        if vec.len(semacore.ast(inout state,generic_ref).children)>0 {
            let bound_ref=semacore.child(inout state,generic_ref,0);
            var declaration=semacore.occurrence(inout state,bound_ref);
            var declaration_id usize=0;var valid=false;
            switch declaration {
                case option.Option.Some(value): {
                    declaration_id=value;
                    valid=semacore.a_symbol_kind(semacore.symbol(inout state,value).kind,model.SymbolKind.Trait);
                }
                case option.Option.None: {}
            }
            if !valid {throw semacore.reject(inout state,generic_ref,"generic constraint must name a trait","E_TYPE_MISMATCH");}
            var args=vec.empty[usize]();
            if a_kind_ast(semacore.ast(inout state,bound_ref).kind,model.AstKind.NeutralBracket) {
                for var index usize=1;index<vec.len(semacore.ast(inout state,bound_ref).children);index+=1 {
                    var argument_ref=semacore.child(inout state,bound_ref,index);
                    vec.push(args,parse_type(inout state,argument_ref,
                        option.Option[usize].None,false));
                }
            } else {
                for child_id in semacore.ast(inout state,bound_ref).children {
                    vec.push(args,parse_type(inout state,semacore.at(bound_ref,child_id),
                        option.Option[usize].None,false));
                }
            }
            trait_ref=option.Option[hir.TraitRef].Some(check_trait_application(
                inout state,bound_ref,declaration_id,args));
        }
        semacore.a_bound_set(state.bounds,symbol_id,trait_ref);
        vec.push(result,hir.GenericParam(symbol:symbol_id,trait_ref:trait_ref,
            source:semacore.source(inout state,generic_ref)));
        let created=parameter_type(inout state,symbol_id);
    }
    return result;
}
pub func a_kind_ast(kind model.AstKind,expected model.AstKind) bool {
    return model.ast_kind_id(kind)==model.ast_kind_id(expected);
}
pub func nominal(state inout semacore.Checker,type_id usize) hir.NominalDecl throws semacore.Error {
    var value=semacore.lookup_type(inout state,type_id);
    var found=semacore.a_nominal_id_get(state.nominal_ids,value.declaration);
    var index usize=0;
    switch found {
        case option.Option.None:throw semacore.internal_error("nominal declaration is missing");
        case option.Option.Some(value_index):index=value_index;
    }
    if index>=vec.len(state.m.nominals) {throw semacore.internal_error("invalid sema nominal reference");}
    return state.m.nominals[index];
}
func nominal_subs(state inout semacore.Checker,type_id usize) Vec[model.Substitution] throws semacore.Error {
    var declaration=nominal(inout state,type_id);
    var value=semacore.lookup_type(inout state,type_id);
    var result=vec.empty[model.Substitution]();
    for var index usize=0;index<vec.len(declaration.params);index+=1 {
        if index>=vec.len(value.type_args) {throw semacore.internal_error("nominal type argument count");}
        vec.push(result,model.Substitution(symbol:declaration.params[index].symbol,
            type_id:value.type_args[index]));
    }
    return result;
}
pub func field_type(state inout semacore.Checker,type_id usize,field hir.FieldDecl) usize throws semacore.Error {
    let subs=nominal_subs(inout state,type_id);
    return semacore.substitute_type(inout state,field.type_id,subs);
}
struct ASignatureParts {
    pub parameters Vec[usize];
    pub result option.Option[usize];
    pub throws_type option.Option[usize];
}
func a_split_signature(state inout semacore.Checker,r model.NodeRef) ASignatureParts throws semacore.Error {
    var n=semacore.ast(inout state,r);
    if !a_kind_ast(n.kind,model.AstKind.Function) &&
       !a_kind_ast(n.kind,model.AstKind.FunctionLiteral) &&
       !a_kind_ast(n.kind,model.AstKind.FunctionType) {
        throw semacore.internal_error("signature owner is not a function");
    }
    let parameters=vec.empty[usize]();
    var result=option.Option[usize].None;
    var throws_type=option.Option[usize].None;
    for id in n.children {
        var current=semacore.ast(inout state,semacore.at(r,id));
        if a_kind_ast(current.kind,model.AstKind.Parameter) {
            vec.push(parameters,id);continue;
        }
        if a_kind_ast(current.kind,model.AstKind.NamedType) ||
           a_kind_ast(current.kind,model.AstKind.FunctionType) ||
           a_kind_ast(current.kind,model.AstKind.ParenthesizedType) ||
           a_kind_ast(current.kind,model.AstKind.TraitObjectType) {
            if current.token_begin==0 {
                throw semacore.internal_error("invalid signature type token range");
            }
            let file=semacore.parsed_file(inout state,r);
            if current.token_end>vec.len(file.lexed.tokens) {
                throw semacore.internal_error("invalid signature type token range");
            }
            let spelling=file.lexed.tokens[current.token_begin-1].spelling;
            if spelling=="throws" {
                switch throws_type {
                    case option.Option.Some(previous):throw semacore.internal_error("duplicate signature type component");
                    case option.Option.None:throws_type=option.Option[usize].Some(id);
                }
            } else {
                switch result {
                    case option.Option.Some(previous):throw semacore.internal_error("duplicate signature type component");
                    case option.Option.None:result=option.Option[usize].Some(id);
                }
            }
        }
    }
    return ASignatureParts(parameters:parameters,result:result,throws_type:throws_type);
}
pub func parse_type(state inout semacore.Checker,r model.NodeRef,trait_self option.Option[usize],
    trait_self_callback bool) usize throws semacore.Error {
    let n=semacore.ast(inout state,r);
    if a_kind_ast(n.kind,model.AstKind.ParenthesizedType) ||
       a_kind_ast(n.kind,model.AstKind.Parenthesized) ||
       a_kind_ast(n.kind,model.AstKind.BracketItem) {
        let inner=semacore.child(inout state,r,0);
        return parse_type(inout state,inner,trait_self,trait_self_callback);
    }
    if a_kind_ast(n.kind,model.AstKind.TraitObjectType) {
        if vec.len(n.children)!=1 {
            throw semacore.reject(inout state,r,"dyn requires one trait application","E_OBJECT_UNSAFE");
        }
        let named=semacore.child(inout state,r,0);
        if !a_kind_ast(semacore.ast(inout state,named).kind,model.AstKind.NamedType) {
            throw semacore.reject(inout state,r,"dyn requires a trait name","E_OBJECT_UNSAFE");
        }
        var declaration=semacore.occurrence(inout state,named);
        var declaration_id usize=0;var valid=false;
        switch declaration {
            case option.Option.Some(value): {
                declaration_id=value;
                valid=semacore.a_symbol_kind(semacore.symbol(inout state,value).kind,model.SymbolKind.Trait);
            }
            case option.Option.None: {}
        }
        if !valid {throw semacore.reject(inout state,named,"dyn requires a trait name","E_NAME_KIND");}
        var args=vec.empty[usize]();
        for id in semacore.ast(inout state,named).children {
            vec.push(args,parse_type(inout state,semacore.at(named,id),
                option.Option[usize].None,false));
        }
        var application=check_trait_application(inout state,named,declaration_id,args);
        require_object_safe(inout state,r,declaration_id);
        var value=model.empty_type(model.TypeKind.TraitObject);
        value.declaration=declaration_id;value.type_args=application.args;
        return semacore.intern_type(inout state,value);
    }
    if a_kind_ast(n.kind,model.AstKind.FunctionType) {
        return signature(inout state,r,trait_self,true,trait_self_callback);
    }
    var symbol_found=option.Option[usize].None;
    var args=vec.empty[usize]();
    if a_kind_ast(n.kind,model.AstKind.NeutralBracket) {
        let head=semacore.child(inout state,r,0);
        symbol_found=semacore.occurrence(inout state,head);
        for var index usize=1;index<vec.len(n.children);index+=1 {
            let argument_ref=semacore.child(inout state,r,index);
            vec.push(args,parse_type(inout state,argument_ref,
                option.Option[usize].None,false));
        }
    } else if a_kind_ast(n.kind,model.AstKind.NamedType) ||
              a_kind_ast(n.kind,model.AstKind.Name) ||
              a_kind_ast(n.kind,model.AstKind.Member) {
        symbol_found=semacore.occurrence(inout state,r);
        if a_kind_ast(n.kind,model.AstKind.NamedType) {
            for id in n.children {
                vec.push(args,parse_type(inout state,semacore.at(r,id),
                    option.Option[usize].None,false));
            }
        }
    } else {
        throw semacore.reject(inout state,r,"generic arguments must be types","E_NAME_KIND");
    }
    var symbol_id usize=0;
    switch symbol_found {
        case option.Option.Some(value):symbol_id=value;
        case option.Option.None:throw semacore.reject(inout state,r,"type has no resolved symbol","E_NAME_KIND");
    }
    let kind=semacore.symbol(inout state,symbol_id).kind;
    if semacore.a_symbol_kind(kind,model.SymbolKind.TypeParameter) {
        if vec.len(args)>0 {throw semacore.reject(inout state,r,"type parameter does not accept arguments","E_TYPE_MISMATCH");}
        let self_found=semacore.a_symbol_type_get(state.self_types,symbol_id);
        switch self_found {
            case option.Option.Some(value):return value;
            case option.Option.None:return parameter_type(inout state,symbol_id);
        }
    }
    if semacore.a_symbol_kind(kind,model.SymbolKind.Type) {
        let export_found=semacore.a_foreign_export(inout state,symbol_id);
        switch export_found {
            case option.Option.Some(external): {
                if vec.len(args)>0 {
                    throw semacore.reject(inout state,r,"external type does not accept type arguments","E_TYPE_MISMATCH");
                }
                switch external.c_type {
                    case option.Option.Some(named_id): {
                        let reference=model.CTypeRef(kind:model.CTypeKind.Named,scalar:"",
                            writable:false,args:[],named:named_id);
                        return c_type(inout state,reference);
                    }
                    case option.Option.None: {}
                }
                switch external.c_type_ref {
                    case option.Option.Some(reference):return c_type(inout state,reference);
                    case option.Option.None: {}
                }
                switch external.declaration {
                    case option.Option.None:throw semacore.reject(inout state,r,"external type lacks declaration","E_TYPE_MISMATCH");
                    case option.Option.Some(declaration_id): {
                        if declaration_id>=vec.len(state.m.foreign_bindings) {
                            throw semacore.internal_error("invalid foreign binding reference");
                        }
                        return state.m.foreign_bindings[declaration_id].type_id;
                    }
                }
            }
            case option.Option.None: {}
        }
        let nominal_found=semacore.a_nominal_id_get(state.nominal_ids,symbol_id);
        var nominal_index usize=0;
        switch nominal_found {
            case option.Option.None:throw semacore.unavailable(inout state,r,"foreign types require T10/T11");
            case option.Option.Some(value):nominal_index=value;
        }
        var declaration=state.m.nominals[nominal_index];
        if vec.len(args)!=vec.len(declaration.params) {
            throw semacore.reject(inout state,r,"wrong number of type arguments","E_TYPE_MISMATCH");
        }
        var value=model.empty_type(declaration.kind);
        value.declaration=symbol_id;value.type_args=args;
        return semacore.intern_type(inout state,value);
    }
    if !semacore.a_symbol_kind(kind,model.SymbolKind.BuiltinType) {
        throw semacore.reject(inout state,r,"name does not denote a value type","E_NAME_KIND");
    }
    let name=semacore.symbol(inout state,symbol_id).name;
    if semacore.a_private_runtime_type_name(name) {
        let owner=semacore.a_module_path(inout state,r.module);
        var allowed=false;
        if name=="__woozy_IpcHandle" {allowed=owner=="std/ipc";}
        else {allowed=semacore.a_private_runtime_type_module(owner);}
        if !allowed {
            throw semacore.reject(inout state,r,"private runtime type is only available to its std module","E_PRIVATE_ACCESS");
        }
        if vec.len(args)>0 {
            throw semacore.reject(inout state,r,"private runtime type does not accept type arguments","E_CALL_ARGUMENT");
        }
        var value=model.empty_type(model.TypeKind.AtomicI64Handle);
        if name=="__woozy_Thread" {value.kind=model.TypeKind.ThreadHandle;}
        else if name=="__woozy_Mutex" {value.kind=model.TypeKind.MutexHandle;}
        else if name=="__woozy_Condvar" {value.kind=model.TypeKind.CondvarHandle;}
        else if name=="__woozy_IpcHandle" {value.kind=model.TypeKind.IpcHandle;}
        return semacore.intern_type(inout state,value);
    }
    if name=="Vec" {
        if vec.len(args)!=1 {throw semacore.reject(inout state,r,"Vec requires one element type","E_TYPE_MISMATCH");}
        var value=model.empty_type(model.TypeKind.Vec);value.type_args=args;
        return semacore.intern_type(inout state,value);
    }
    if name=="Slice" {
        if vec.len(args)!=1 {throw semacore.reject(inout state,r,"Slice requires one element type","E_TYPE_MISMATCH");}
        var value=model.empty_type(model.TypeKind.Slice);value.type_args=args;
        return semacore.intern_type(inout state,value);
    }
    if name=="Weak" {
        if vec.len(args)!=1 {throw semacore.reject(inout state,r,"Weak requires one target type","E_TYPE_MISMATCH");}
        var value=model.empty_type(model.TypeKind.Weak);value.type_args=args;
        var id=semacore.intern_type(inout state,value);
        validate_weak_type(inout state,r,id);
        return id;
    }
    if name=="Task" {
        if vec.len(args)!=2 {throw semacore.reject(inout state,r,"Task requires a result type and an error type","E_TYPE_MISMATCH");}
        let error_type=semacore.lookup_type(inout state,args[1]);
        if !semacore.a_kind(error_type.kind,model.TypeKind.Unit) &&
           (semacore.a_kind(error_type.kind,model.TypeKind.Vec) ||
            semacore.a_kind(error_type.kind,model.TypeKind.Function) ||
            semacore.a_kind(error_type.kind,model.TypeKind.Weak)) {
            throw semacore.reject(inout state,r,"Task error type must be a plain error value type","E_TYPE_MISMATCH");
        }
        var value=model.empty_type(model.TypeKind.Task);value.type_args=args;
        return semacore.intern_type(inout state,value);
    }
    if name=="Ptr" || name=="PtrMut" {
        if vec.len(args)!=1 {throw semacore.reject(inout state,r,name+" requires one pointee type","E_TYPE_MISMATCH");}
        var value=model.empty_type(model.TypeKind.CForeignPointer);
        if name=="PtrMut" {value.bits=1;}
        value.type_args=args;return semacore.intern_type(inout state,value);
    }
    if name=="Buffer" || name=="BufferMut" {
        if vec.len(args)!=1 {throw semacore.reject(inout state,r,name+" requires one element type","E_TYPE_MISMATCH");}
        let kind_value=semacore.lookup_type(inout state,args[0]).kind;
        if !(semacore.a_kind(kind_value,model.TypeKind.SignedInt) ||
             semacore.a_kind(kind_value,model.TypeKind.UnsignedInt) ||
             semacore.a_kind(kind_value,model.TypeKind.Isize) ||
             semacore.a_kind(kind_value,model.TypeKind.Usize) ||
             semacore.a_kind(kind_value,model.TypeKind.Float) ||
             semacore.a_kind(kind_value,model.TypeKind.Bool) ||
             semacore.a_kind(kind_value,model.TypeKind.TypeParameter)) {
            throw semacore.reject(inout state,r,"Buffer element must be a fixed scalar type","E_TYPE_MISMATCH");
        }
        var value=model.empty_type(model.TypeKind.CForeignBuffer);
        if name=="BufferMut" {value.bits=1;}
        value.type_args=args;return semacore.intern_type(inout state,value);
    }
    if name=="Result" {throw semacore.unavailable(inout state,r,"container, owned string and Result support requires T08/T09");}
    if vec.len(args)>0 {throw semacore.reject(inout state,r,"scalar type does not accept type arguments","E_TYPE_MISMATCH");}
    if name=="Unit" {return state.unit;}
    if name=="bool" {return state.boolean;}
    if name=="string" {return semacore.scalar(inout state,model.TypeKind.String,0);}
    if name=="isize" {return semacore.scalar(inout state,model.TypeKind.Isize,0);}
    if name=="usize" {return semacore.scalar(inout state,model.TypeKind.Usize,0);}
    if name=="f32" {return semacore.scalar(inout state,model.TypeKind.Float,32);}
    if name=="f64" {return semacore.scalar(inout state,model.TypeKind.Float,64);}
    if text.byte_len(name)>=2 && (name[0]==105 || name[0]==117) {
        var bits u32=64;
        if name=="i8" || name=="u8" {bits=8;}
        else if name=="i16" || name=="u16" {bits=16;}
        else if name=="i32" || name=="u32" {bits=32;}
        if name[0]==105 {return semacore.scalar(inout state,model.TypeKind.SignedInt,bits);}
        return semacore.scalar(inout state,model.TypeKind.UnsignedInt,bits);
    }
    throw semacore.unavailable(inout state,r,"type is not implemented");
}
pub func signature(state inout semacore.Checker,r model.NodeRef,trait_self option.Option[usize],
    callback bool,trait_self_callback bool) usize throws semacore.Error {
    var value=model.empty_type(model.TypeKind.Function);
    value.result=state.unit;
    let parts=a_split_signature(inout state,r);
    for var index usize=0;index<vec.len(parts.parameters);index+=1 {
        let parameter_ref=semacore.at(r,parts.parameters[index]);
        let parameter_mode=semacore.mode(inout state,parameter_ref);
        let parameter_type_ref=semacore.child(inout state,parameter_ref,0);
        let parameter_type_id=parse_type(inout state,parameter_type_ref,
            trait_self,trait_self_callback);
        if semacore.a_mode(parameter_mode,model.ParamMode.Inout) &&
           semacore.a_kind(semacore.lookup_type(inout state,parameter_type_id).kind,model.TypeKind.ForeignOpaque) {
            throw semacore.unavailable(inout state,parameter_ref,"external inout parameters are not supported");
        }
        var trait_self_slot=false;
        switch trait_self {
            case option.Option.Some(self_symbol): {
                trait_self_slot=trait_self_type(inout state,parameter_type_id,self_symbol);
            }
            case option.Option.None: {}
        }
        var data_self=option.Option[usize].None;
        switch trait_self {
            case option.Option.Some(self_symbol): {
                if callback || index>0 {data_self=option.Option[usize].Some(self_symbol);}
            }
            case option.Option.None: {}
        }
        if semacore.a_mode(parameter_mode,model.ParamMode.Inout) &&
           !owning_inout_type(inout state,parameter_type_id,data_self) &&
           !template_inout_type(inout state,parameter_type_id) &&
           !trait_self_slot {
            let reason=owning_inout_reason(inout state,parameter_type_id,data_self);
            if reason=="" {
                throw semacore.unavailable(inout state,parameter_ref,"inout accepts only whole Woozy value bindings");
            }
            throw semacore.unavailable(inout state,parameter_ref,reason);
        }
        vec.push(value.parameters,model.ParameterType(mode:parameter_mode,type_id:parameter_type_id));
    }
    switch parts.result {
        case option.Option.Some(result_ref):value.result=parse_type(inout state,semacore.at(r,result_ref),
            trait_self,trait_self_callback);
        case option.Option.None: {}
    }
    switch parts.throws_type {
        case option.Option.Some(throws_ref):value.throws_type=option.Option[usize].Some(
            parse_type(inout state,semacore.at(r,throws_ref),trait_self,trait_self_callback));
        case option.Option.None: {}
    }
    return semacore.intern_type(inout state,value);
}
pub func contains_parameter(state inout semacore.Checker,type_id usize) bool throws semacore.Error {
    var pending=vec.empty[usize]();vec.push(pending,type_id);
    var visited=vec.empty[usize]();
    for vec.len(pending)>0 {
        var popped=vec.pop(pending);let current=option.unwrap_or(popped,0);
        if !semacore.a_insert(visited,current) {continue;}
        var value=semacore.lookup_type(inout state,current);
        if semacore.a_kind(value.kind,model.TypeKind.TypeParameter) {return true;}
        for arg in value.type_args {vec.push(pending,arg);}
        for parameter in value.parameters {vec.push(pending,parameter.type_id);}
        if semacore.a_kind(value.kind,model.TypeKind.Function) {
            vec.push(pending,value.result);
            switch value.throws_type {
                case option.Option.Some(error_type):vec.push(pending,error_type);
                case option.Option.None: {}
            }
        }
    }
    return false;
}
func may_contain_weak(state inout semacore.Checker,type_id usize) bool throws semacore.Error {
    var pending=vec.empty[usize]();vec.push(pending,type_id);
    let seen_types=vec.empty[usize]();
    let seen_declarations=vec.empty[usize]();
    for vec.len(pending)>0 {
        var popped=vec.pop(pending);let current=option.unwrap_or(popped,0);
        if !semacore.a_insert(seen_types,current) {continue;}
        if vec.len(seen_types)>4096 {return true;}
        var found=types.find(state.m.types,current);
        var value=model.empty_type(model.TypeKind.Error);
        switch found {
            case option.Option.Some(actual):value=actual;
            case option.Option.None:return true;
        }
        if semacore.a_kind(value.kind,model.TypeKind.Weak) {return true;}
        for arg in value.type_args {vec.push(pending,arg);}
        for parameter in value.parameters {vec.push(pending,parameter.type_id);}
        if semacore.a_kind(value.kind,model.TypeKind.Function) {
            vec.push(pending,value.result);
            switch value.throws_type {
                case option.Option.Some(error_type):vec.push(pending,error_type);
                case option.Option.None: {}
            }
        }
        if !semacore.a_kind(value.kind,model.TypeKind.NominalStruct) &&
           !semacore.a_kind(value.kind,model.TypeKind.NominalEnum) {continue;}
        if !state.nominal_fields_ready {return true;}
        var entry=semacore.a_nominal_id_get(state.nominal_ids,value.declaration);
        var index usize=0;
        switch entry {
            case option.Option.None:return true;
            case option.Option.Some(value_index):index=value_index;
        }
        if !semacore.a_insert(seen_declarations,value.declaration) {continue;}
        var declaration=state.m.nominals[index];
        for field in declaration.fields {vec.push(pending,field.type_id);}
        for variant in declaration.variants {
            for field in variant.payload {vec.push(pending,field.type_id);}
        }
    }
    return false;
}
struct AWeakItem { pub type_id usize; at hir.HirSource; pub depth usize; }
pub func validate_weak_type(state inout semacore.Checker,r model.NodeRef,type_id usize) throws semacore.Error {
    let location=semacore.source(inout state,r);
    validate_weak_at(inout state,location,type_id);
}
func validate_weak_at(state inout semacore.Checker,location hir.HirSource,type_id usize) throws semacore.Error {
    if semacore.a_contains(state.weak_validated,type_id) {return;}
    if !may_contain_weak(inout state,type_id) {
        semacore.a_insert(state.weak_validated,type_id);return;
    }
    let pending=vec.empty[AWeakItem]();
    vec.push(pending,AWeakItem(type_id:type_id,at:location,depth:0));
    let visited=vec.empty[usize]();
    var complete=true;var work usize=0;
    for vec.len(pending)>0 {
        let popped=vec.pop(pending);let item=option.unwrap_or(popped,
            AWeakItem(type_id:0,at:location,depth:0));
        if semacore.a_contains(state.weak_validated,item.type_id) || !semacore.a_insert(visited,item.type_id) {continue;}
        work+=1;
        if item.depth>128 || work>4096 {
            throw semacore.reject_source(item.at,"Weak type validation exceeds its checking budget",
                "E_CAPABILITY_UNAVAILABLE");
        }
        var found=types.find(state.m.types,item.type_id);
        var value=model.empty_type(model.TypeKind.Error);
        switch found {
            case option.Option.Some(actual):value=actual;
            case option.Option.None: {complete=false;continue;}
        }
        if semacore.a_kind(value.kind,model.TypeKind.Weak) {
            if vec.len(value.type_args)!=1 {
                throw semacore.reject_source(item.at,"Weak requires one target type","E_TYPE_MISMATCH");
            }
            let target=value.type_args[0];
            if !contains_parameter(inout state,target) {
                let target_type=semacore.lookup_type(inout state,target);
                if !state.nominal_fields_ready &&
                   semacore.a_kind(target_type.kind,model.TypeKind.NominalStruct) {
                    complete=false;
                } else {
                    var valid=false;
                    try {valid=valueopslib.weak_target(state.m,target);}
                    catch error model.SupportError {throw semacore.Error.Support(error);}
                    if !valid {
                        throw semacore.reject_source(item.at,
                            "Weak target must be Vec, function value, std/box.Box, "+
                            "std/thread.Thread, std/sync.Mutex/Condvar/AtomicI64 or "+
                            "std/ipc.Memory","E_TYPE_MISMATCH");
                    }
                }
            }
        }
        for arg in value.type_args {vec.push(pending,AWeakItem(type_id:arg,at:item.at,depth:item.depth+1));}
        for parameter in value.parameters {vec.push(pending,AWeakItem(type_id:parameter.type_id,at:item.at,depth:item.depth+1));}
        if semacore.a_kind(value.kind,model.TypeKind.Function) {
            vec.push(pending,AWeakItem(type_id:value.result,at:item.at,depth:item.depth+1));
            switch value.throws_type {
                case option.Option.Some(error_type):vec.push(pending,AWeakItem(
                    type_id:error_type,at:item.at,depth:item.depth+1));
                case option.Option.None: {}
            }
        }
        if !semacore.a_kind(value.kind,model.TypeKind.NominalStruct) &&
           !semacore.a_kind(value.kind,model.TypeKind.NominalEnum) {continue;}
        var entry=semacore.a_nominal_id_get(state.nominal_ids,value.declaration);
        var declaration_index usize=0;var valid_entry=false;
        switch entry {
            case option.Option.Some(index):declaration_index=index;valid_entry=true;
            case option.Option.None: {}
        }
        if !state.nominal_fields_ready || !valid_entry {complete=false;continue;}
        var declaration=state.m.nominals[declaration_index];
        if vec.len(value.type_args)!=vec.len(declaration.params) {complete=false;continue;}
        var dependent=false;
        for arg in value.type_args {if contains_parameter(inout state,arg) {dependent=true;}}
        if dependent {continue;}
        for field in declaration.fields {
            vec.push(pending,AWeakItem(type_id:field_type(inout state,item.type_id,field),
                at:field.source,depth:item.depth+1));
        }
        for variant in declaration.variants {
            for field in variant.payload {
                vec.push(pending,AWeakItem(type_id:field_type(inout state,item.type_id,field),
                    at:field.source,depth:item.depth+1));
            }
        }
    }
    if complete {
        for id in visited {semacore.a_insert(state.weak_validated,id);}
    }
}
pub func validate_weak_types_before_publish(state inout semacore.Checker) throws semacore.Error {
    let type_roots=types.size(state.m.types);
    for declaration in state.m.nominals {
        for field in declaration.fields {validate_weak_at(inout state,field.source,field.type_id);}
        for variant in declaration.variants {
            for field in variant.payload {validate_weak_at(inout state,field.source,field.type_id);}
        }
    }
    for function in state.m.functions {validate_weak_at(inout state,function.source,function.signature);}
    for template in state.m.templates {
        validate_weak_at(inout state,template.function.source,template.function.signature);
    }
    for var id usize=1;id<=type_roots;id+=1 {
        var value=semacore.lookup_type(inout state,id);
        if !semacore.a_kind(value.kind,model.TypeKind.NominalStruct) &&
           !semacore.a_kind(value.kind,model.TypeKind.NominalEnum) {continue;}
        let entry=semacore.a_nominal_id_get(state.nominal_ids,value.declaration);
        switch entry {
            case option.Option.None: {}
            case option.Option.Some(index): {
                let nominal_source=state.m.nominals[index].source;
                validate_weak_at(inout state,nominal_source,id);
            }
        }
    }
}
pub func infer(state inout semacore.Checker,r model.NodeRef,pattern usize,actual usize,
    substitutions Vec[model.Substitution]) throws semacore.Error {
    let p=semacore.lookup_type(inout state,pattern);let a=semacore.lookup_type(inout state,actual);
    if semacore.a_kind(p.kind,model.TypeKind.TypeParameter) {
        for substitution in substitutions {
            if substitution.symbol==p.declaration {
                if !types.equal(semacore.lookup_type(inout state,substitution.type_id),
                    semacore.lookup_type(inout state,actual)) {
                    throw semacore.reject(inout state,r,"conflicting generic type inference","E_TYPE_MISMATCH");
                }
                return;
            }
        }
        vec.push(substitutions,model.Substitution(symbol:p.declaration,type_id:actual));
        return;
    }
    if !semacore.a_kind(p.kind,a.kind) || p.bits!=a.bits || p.declaration!=a.declaration ||
       vec.len(p.parameters)!=vec.len(a.parameters) ||
       vec.len(p.type_args)!=vec.len(a.type_args) ||
       option.is_some(p.throws_type)!=option.is_some(a.throws_type) {
        throw semacore.reject(inout state,r,"type inference mismatch","E_TYPE_MISMATCH");
    }
    for var index usize=0;index<vec.len(p.type_args);index+=1 {
        infer(inout state,r,p.type_args[index],a.type_args[index],substitutions);
    }
    if semacore.a_kind(p.kind,model.TypeKind.Function) {
        for var index usize=0;index<vec.len(p.parameters);index+=1 {
            if !semacore.a_mode(p.parameters[index].mode,a.parameters[index].mode) {
                throw semacore.reject(inout state,r,"function argument mode mismatch","E_TYPE_MISMATCH");
            }
            infer(inout state,r,p.parameters[index].type_id,a.parameters[index].type_id,substitutions);
        }
        infer(inout state,r,p.result,a.result,substitutions);
        switch p.throws_type {
            case option.Option.Some(error_type): {
                infer(inout state,r,error_type,option.unwrap_or(a.throws_type,0),substitutions);
            }
            case option.Option.None: {}
        }
    }
}
func try_infer(state inout semacore.Checker,r model.NodeRef,pattern usize,actual usize,
    substitutions Vec[model.Substitution]) bool throws semacore.Error {
    try {
        infer(inout state,r,pattern,actual,substitutions);
        return true;
    } catch error semacore.Error {
        switch error {
            case semacore.Error.Rejected(diagnostic,failure):return false;
            case semacore.Error.Support(support):throw error;
        }
    }
}
pub func finish_arguments(state inout semacore.Checker,r model.NodeRef,parameters Vec[hir.GenericParam],
    substitutions Vec[model.Substitution]) Vec[usize] throws semacore.Error {
    let args=vec.empty[usize]();
    for parameter in parameters {
        var found=false;var value usize=0;
        for substitution in substitutions {
            if substitution.symbol==parameter.symbol {found=true;value=substitution.type_id;}
        }
        if !found {
            throw semacore.reject(inout state,r,"cannot infer type argument; provide explicit type arguments",
                "E_TYPE_MISMATCH");
        }
        vec.push(args,value);
    }
    check_constraints(inout state,r,parameters,args,
        option.Option[Vec[model.Substitution]].Some(substitutions));
    return args;
}
pub func satisfies(state inout semacore.Checker,r model.NodeRef,actual usize,trait_value hir.TraitRef) bool throws semacore.Error {
    let key=trait_key(state,actual,trait_value);
    var cached=semacore.a_trait_key_get(state.trait_results,key);
    switch cached {
        case option.Option.Some(value):return value;
        case option.Option.None: {}
    }
    if state.constraint_depth>=48 || semacore.a_trait_keys_insert(state.active_constraints,key)==false {
        return false;
    }
    state.constraint_depth+=1;
    let actual_type=semacore.lookup_type(inout state,actual);
    var found usize=0;
    if semacore.a_kind(actual_type.kind,model.TypeKind.TypeParameter) {
        var bound=semacore.a_bound_get(state.bounds,actual_type.declaration);
        switch bound {
            case option.Option.Some(value): {
                switch value {
                    case option.Option.Some(bound_value): {
                        if semacore.a_trait_equal(bound_value,trait_value) {found=1;}
                    }
                    case option.Option.None: {}
                }
            }
            case option.Option.None: {}
        }
    } else {
        for implementation in state.m.impls {
            var application=hir.TraitRef(declaration:0,args:[]);
            switch implementation.trait_ref {
                case option.Option.None:continue;
                case option.Option.Some(value):application=value;
            }
            if application.declaration!=trait_value.declaration ||
               vec.len(application.args)!=vec.len(trait_value.args) {continue;}
            var sub=vec.empty[model.Substitution]();
            if !try_infer(inout state,r,implementation.self_type,actual,sub) {continue;}
            var matched=true;
            for var index usize=0;index<vec.len(trait_value.args);index+=1 {
                if !try_infer(inout state,r,application.args[index],trait_value.args[index],sub) {
                    matched=false;break;
                }
            }
            if !matched {continue;}
            var valid=true;
            for parameter in implementation.params {
                var parameter_found=false;var parameter_type_value usize=0;
                for substitution in sub {
                    if substitution.symbol==parameter.symbol {
                        parameter_found=true;parameter_type_value=substitution.type_id;
                    }
                }
                if !parameter_found {valid=false;break;}
                switch parameter.trait_ref {
                    case option.Option.Some(bound_value): {
                        var bound=semacore.a_copy_trait_ref(bound_value);
                        for var arg_index usize=0;arg_index<vec.len(bound.args);arg_index+=1 {
                            bound.args[arg_index]=semacore.substitute_type(inout state,bound.args[arg_index],sub);
                        }
                        if !satisfies(inout state,r,parameter_type_value,bound) {valid=false;break;}
                    }
                    case option.Option.None: {}
                }
            }
            if valid {found+=1;}
        }
    }
    state.constraint_depth-=1;
    semacore.a_trait_keys_remove(state.active_constraints,key);
    var result=found==1;
    semacore.a_trait_results_set(state.trait_results,key,result);
    return result;
}
pub func check_constraints(state inout semacore.Checker,r model.NodeRef,parameters Vec[hir.GenericParam],
    args Vec[usize],substitutions option.Option[Vec[model.Substitution]]) throws semacore.Error {
    let requested=semacore.a_copy_ids(args);
    for var index usize=0;index<vec.len(parameters);index+=1 {
        let parameter=parameters[index];
        switch parameter.trait_ref {
            case option.Option.None: {}
            case option.Option.Some(bound_value): {
                var bound=semacore.a_copy_trait_ref(bound_value);
                switch substitutions {
                    case option.Option.Some(sub): {
                        for var arg_index usize=0;arg_index<vec.len(bound.args);arg_index+=1 {
                            bound.args[arg_index]=semacore.substitute_type(inout state,bound.args[arg_index],sub);
                        }
                    }
                    case option.Option.None: {}
                }
                if index>=vec.len(requested) {throw semacore.internal_error("generic argument count");}
                check_trait_parameter_bounds(inout state,r,bound,requested[index],0);
                if !satisfies(inout state,r,requested[index],bound) {
                    throw semacore.reject(inout state,r,
                        "generic constraint requires one applicable explicit trait implementation",
                        "E_TYPE_MISMATCH");
                }
            }
        }
    }
}
pub func select_method(state inout semacore.Checker,r model.NodeRef,receiver usize,name string,
    required option.Option[hir.TraitRef]) semacore.Selection throws semacore.Error {
    var result=option.Option[semacore.Selection].None;
    for implementation in state.m.impls {
        var required_value=hir.TraitRef(declaration:0,args:[]);var has_required=false;
        switch required {
            case option.Option.Some(value):required_value=value;has_required=true;
            case option.Option.None: {}
        }
        var application=hir.TraitRef(declaration:0,args:[]);
        switch implementation.trait_ref {
            case option.Option.Some(value):application=value;
            case option.Option.None: {}
        }
        if has_required {
            if !option.is_some(implementation.trait_ref) ||
               application.declaration!=required_value.declaration {continue;}
        }
        let sub=vec.empty[model.Substitution]();
        if !try_infer(inout state,r,implementation.self_type,receiver,sub) {continue;}
        if has_required {
            if vec.len(application.args)!=vec.len(required_value.args) {continue;}
            var matched=true;
            for var index usize=0;index<vec.len(required_value.args);index+=1 {
                if !try_infer(inout state,r,application.args[index],required_value.args[index],sub) {
                    matched=false;break;
                }
            }
            if !matched {continue;}
        }
        let saved_depth=state.constraint_depth;
        var accepted=true;
        try {let ignored=finish_arguments(inout state,r,implementation.params,sub);}
        catch error semacore.Error {
            switch error {
                case semacore.Error.Rejected(diagnostic,failure): {state.constraint_depth=saved_depth;accepted=false;}
                case semacore.Error.Support(support):throw error;
            }
        }
        if !accepted {continue;}
        for method in implementation.methods {
            if semacore.symbol(inout state,method).name!=name {continue;}
            var exported=false;
            switch implementation.trait_ref {
                case option.Option.Some(application_value): {
                    exported=semacore.symbol(inout state,application_value.declaration).exported;
                }
                case option.Option.None:exported=semacore.symbol(inout state,method).exported;
            }
            if semacore.symbol(inout state,method).module!=r.module && !exported {
                throw semacore.reject(inout state,r,"method is private","E_PRIVATE_ACCESS");
            }
            switch result {
                case option.Option.Some(previous): {
                    throw semacore.reject(inout state,r,"ambiguous method implementation","E_TYPE_MISMATCH");
                }
                case option.Option.None:result=option.Option[semacore.Selection].Some(semacore.Selection(
                    method:method,substitutions:sub));
            }
        }
    }
    switch result {
        case option.Option.Some(value):return value;
        case option.Option.None:throw semacore.reject(inout state,r,
            "no matching explicit method implementation","E_TYPE_MISMATCH");
    }
}
pub func declared_foreign_type(state inout semacore.Checker,name string) usize throws semacore.Error {
    try {return foreignlib.binding_type(state.m.resolved.project,inout state.m.types,name);}
    catch error model.SupportError {throw semacore.Error.Support(error);}
}
pub func c_type(state inout semacore.Checker,reference model.CTypeRef) usize throws semacore.Error {
    if a_kind_ctype(reference.kind,model.CTypeKind.Named) {
        let cached=semacore.a_c_named_get(state.c_named_types,reference.named);
        switch cached {
            case option.Option.Some(value):return value;
            case option.Option.None: {}
        }
    }
    var id usize=0;
    try {id=foreignlib.c_type_id(state.m.resolved.project,inout state.m.types,reference);}
    catch error model.SupportError {throw semacore.Error.Support(error);}
    if a_kind_ctype(reference.kind,model.CTypeKind.Named) {
        semacore.a_c_named_set(state.c_named_types,reference.named,id);
    }
    return id;
}
func a_kind_ctype(kind model.CTypeKind,expected model.CTypeKind) bool {
    switch kind {
        case model.CTypeKind.Scalar: {
            switch expected {case model.CTypeKind.Scalar:return true;default:return false;}
        }
        case model.CTypeKind.Pointer: {
            switch expected {case model.CTypeKind.Pointer:return true;default:return false;}
        }
        case model.CTypeKind.Buffer: {
            switch expected {case model.CTypeKind.Buffer:return true;default:return false;}
        }
        case model.CTypeKind.Named: {
            switch expected {case model.CTypeKind.Named:return true;default:return false;}
        }
    }
}
pub func c_decl(state inout semacore.Checker,id u32) model.CTypeDecl throws semacore.Error {
    if id==0 || usize(id)>vec.len(state.m.resolved.project.c_types) {
        throw semacore.internal_error("invalid C type reference");
    }
    return state.m.resolved.project.c_types[usize(id)-1];
}
pub func c_callable(state inout semacore.Checker,id u32) model.CCallableDecl throws semacore.Error {
    if id==0 || usize(id)>vec.len(state.m.resolved.project.c_callables) {
        throw semacore.internal_error("invalid C callable reference");
    }
    return state.m.resolved.project.c_callables[usize(id)-1];
}
pub func check_c_callback(state inout semacore.Checker,r model.NodeRef,function_type usize,callback_type u32) throws semacore.Error {
    let declaration=c_decl(inout state,callback_type);
    let signature=semacore.lookup_type(inout state,function_type);
    if !semacore.a_kind(signature.kind,model.TypeKind.Function) || option.is_some(signature.throws_type) {
        throw semacore.reject(inout state,r,"C callback requires a non-throwing function value","E_TYPE_MISMATCH");
    }
    if vec.len(signature.parameters)!=vec.len(declaration.parameters) {
        throw semacore.reject(inout state,r,"C callback parameter count mismatch","E_CALL_ARGUMENT");
    }
    for var index usize=0;index<vec.len(declaration.parameters);index+=1 {
        let expected=c_type(inout state,declaration.parameters[index].type_ref);
        if !semacore.a_mode(signature.parameters[index].mode,model.ParamMode.Ordinary) ||
           signature.parameters[index].type_id!=expected {
            throw semacore.reject(inout state,r,"C callback parameter type mismatch","E_CALL_ARGUMENT");
        }
    }
    let expected_result=c_type(inout state,declaration.result);
    if signature.result!=expected_result {
        throw semacore.reject(inout state,r,"C callback result type mismatch","E_CALL_ARGUMENT");
    }
}
pub func free_generic_template(state inout semacore.Checker,target usize) bool throws semacore.Error {
    let found=semacore.a_generic_params_get(state.generic_params,target);
    var has=false;
    switch found {
        case option.Option.None:return false;
        case option.Option.Some(values):has=vec.len(values)>0;
    }
    return has && !semacore.a_impl_method(inout state,target);
}
