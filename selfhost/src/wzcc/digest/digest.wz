package digest;

import "std/vec" as vec;

// SHA-256 of the original bytes, independent of paths and process-local IDs.
// The input Vec is only read; padding is written to a separate buffer.
pub func sha256(bytes Vec[u8]) string {
    let length = vec.len(bytes);
    let padded_size = ((length + 9 + 63) / 64) * 64;
    let data = vec.make[u8](padded_size, 0);
    for var index usize = 0; index < length; index += 1 {
        data[index] = bytes[index];
    }
    data[length] = 0x80;
    let bits = u64(length) * 8;
    for var index usize = 0; index < 8; index += 1 {
        let shift = u64(7 - index) * 8;
        data[padded_size - 8 + index] = u8((bits >> shift) & 0xff);
    }

    let constants Vec[u32] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
    var h Vec[u32] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ];
    var schedule Vec[u32] = vec.make[u32](64, 0);
    for var offset usize = 0; offset < padded_size; offset += 64 {
        for var index usize = 0; index < 16; index += 1 {
            let base = offset + index * 4;
            schedule[index] = (u32(data[base]) << 24) |
                              (u32(data[base + 1]) << 16) |
                              (u32(data[base + 2]) << 8) |
                              u32(data[base + 3]);
        }
        for var index usize = 16; index < 64; index += 1 {
            let x = schedule[index - 15];
            let y = schedule[index - 2];
            schedule[index] = schedule[index - 16] +
                              (rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)) +
                              schedule[index - 7] +
                              (rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10));
        }
        var a = h[0];
        var b = h[1];
        var c = h[2];
        var d = h[3];
        var e = h[4];
        var f = h[5];
        var g = h[6];
        var t = h[7];
        for var index usize = 0; index < 64; index += 1 {
            let s = t + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) +
                    ((e & f) ^ ((~e) & g)) + constants[index] + schedule[index];
            let u = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) +
                    ((a & b) ^ (a & c) ^ (b & c));
            t = g;
            g = f;
            f = e;
            e = d + s;
            d = c;
            c = b;
            b = a;
            a = s + u;
        }
        h[0] += a;
        h[1] += b;
        h[2] += c;
        h[3] += d;
        h[4] += e;
        h[5] += f;
        h[6] += g;
        h[7] += t;
    }

    var output = "";
    for var word_index usize = 0; word_index < 8; word_index += 1 {
        let word = h[word_index];
        for var nibble u32 = 0; nibble < 8; nibble += 1 {
            let shift = (7 - nibble) * 4;
            output += hex_digit((word >> shift) & 0xf);
        }
    }
    return output;
}

func rotr(value u32, count u32) u32 {
    return (value >> count) | (value << (32 - count));
}

func hex_digit(value u32) string {
    switch value {
        case 0: return "0";
        case 1: return "1";
        case 2: return "2";
        case 3: return "3";
        case 4: return "4";
        case 5: return "5";
        case 6: return "6";
        case 7: return "7";
        case 8: return "8";
        case 9: return "9";
        case 10: return "a";
        case 11: return "b";
        case 12: return "c";
        case 13: return "d";
        case 14: return "e";
        case 15: return "f";
        default: return "?";
    }
}
