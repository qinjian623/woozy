// Independent ownership derivation for typed HIR.
//
// This is a direct port of the Analysis class in src/hir/ownership.cpp.  It
// derives records and exit plans from the HIR tree and never consults a
// supplied ownership/exits result.  The producer publishes the derived tree;
// the verifier compares it field by field with a freshly derived one.
package ownership;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/types" as types;
import "app/wzcc/valueops" as valueops;
import "std/option" as option;
import "std/vec" as vec;

const STATE_LIVE u32 = 1;
const STATE_MOVED u32 = 2;

struct StateEntry {
    symbol usize;
    value u32;
}

struct State {
    entries Vec[StateEntry];
}

struct Edge {
    kind hir.ExitKind;
    target usize;
    error usize;
    state State;
}

struct Flow {
    has_normal bool;
    normal State;
    edges Vec[Edge];
}

struct LocalEntry {
    symbol usize;
    value hir.LocalLifetime;
}

struct DeclEntry {
    symbol usize;
    node usize;
}

struct ScopeNodeEntry {
    scope usize;
    node usize;
}

struct ScopeLocalsEntry {
    scope usize;
    symbols Vec[usize];
}

struct PrefixEntry {
    node usize;
    actions Vec[hir.CleanupStep];
}

struct SubjectEntry {
    scope usize;
    node usize;
}

struct BindingEffect {
    expression usize;
    inout_argument option.Option[usize];
}

struct ValueEntry {
    type_id usize;
    operations hir.ValueOps;
}

struct Derived {
    records hir.Ownership;
    exits Vec[Vec[hir.ExitPlan]];
    checked_nodes Vec[usize];
    checked_node Vec[bool];
}

struct Analysis {
    module hir.HirModule;
    out Derived;
    parents Vec[option.Option[usize]];
    locals Vec[LocalEntry];
    declarations Vec[DeclEntry];
    scope_nodes Vec[ScopeNodeEntry];
    scope_locals Vec[ScopeLocalsEntry];
    failure_prefix Vec[PrefixEntry];
    enabled Vec[usize];
    active_borrows Vec[hir.CleanupStep];
    switch_subjects Vec[SubjectEntry];
    function hir.HirFunction;
    has_function bool;
    parameter_symbols Vec[usize];
    safe_borrow_receivers Vec[bool];
    full_expression_root option.Option[usize];
    effects_for option.Option[usize];
    effects_suspend bool;
    binding_effects Vec[BindingEffect];
    values Vec[ValueEntry];
    local_map Vec[i64];
    declaration_map Vec[i64];
    scope_node_map Vec[i64];
    scope_locals_map Vec[i64];
    prefix_map Vec[i64];
    subject_map Vec[i64];
    value_map Vec[i64];
    current_fn_locals Vec[usize];
}

func empty_ownership() hir.Ownership {
    return hir.Ownership(uses: [], temporaries: [], locals: [],
        full_expressions: [], calls: []);
}

func empty_local_lifetime() hir.LocalLifetime {
    return hir.LocalLifetime(symbol: 0, scope: 0, type_id: 0, order: 0,
        mode: model.ParamMode.Ordinary, read_only_capture: false);
}

func empty_hir_function() hir.HirFunction {
    return hir.HirFunction(symbol: 0, signature: 0, parameters: [], body: 0,
        scope: 0, source: empty_hir_source(), captures: [], is_async: false);
}

func empty_state() State {
    return State(entries: []);
}

func empty_flow() Flow {
    return Flow(has_normal: false, normal: empty_state(), edges: []);
}

func copy_state(state State) State {
    let entries = vec.empty[StateEntry]();
    vec.reserve(entries, vec.len(state.entries));
    for entry in state.entries {
        vec.push(entries, entry);
    }
    return State(entries: entries);
}

func state_lower_bound(entries Vec[StateEntry], symbol usize) usize {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].symbol < symbol {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

func state_index(state State, symbol usize) i64 {
    let pos = state_lower_bound(state.entries, symbol);
    if pos < vec.len(state.entries) && state.entries[pos].symbol == symbol {
        return i64(pos);
    }
    return -1;
}

func state_get(state State, symbol usize) u32 {
    let found = state_index(state, symbol);
    if found < 0 {
        return 0;
    }
    return state.entries[usize(found)].value;
}

func state_set(state State, symbol usize, value u32) {
    let pos = state_lower_bound(state.entries, symbol);
    let n = vec.len(state.entries);
    if pos < n && state.entries[pos].symbol == symbol {
        state.entries[pos].value = value;
        return;
    }
    vec.push(state.entries, StateEntry(symbol: 0, value: 0));
    var cur = n;
    for cur > pos {
        state.entries[cur] = state.entries[cur - 1];
        cur -= 1;
    }
    state.entries[pos] = StateEntry(symbol: symbol, value: value);
}

func state_erase(state State, symbol usize) {
    let pos = state_lower_bound(state.entries, symbol);
    let n = vec.len(state.entries);
    if pos >= n || state.entries[pos].symbol != symbol {
        return;
    }
    var cur = pos;
    for cur + 1 < n {
        state.entries[cur] = state.entries[cur + 1];
        cur += 1;
    }
    let discarded = vec.pop(state.entries);
}

func state_equal(left State, right State) bool {
    let n = vec.len(left.entries);
    if n != vec.len(right.entries) {
        return false;
    }
    for var index usize = 0; index < n; index += 1 {
        if left.entries[index].symbol != right.entries[index].symbol ||
           left.entries[index].value != right.entries[index].value {
            return false;
        }
    }
    return true;
}

func flow_join(flow inout Flow, source State) {
    if !flow.has_normal {
        flow.normal = copy_state(source);
        flow.has_normal = true;
        return;
    }
    let left = flow.normal.entries;
    let right = source.entries;
    let n_left = vec.len(left);
    let n_right = vec.len(right);
    if n_right == 0 {
        return;
    }
    let merged = vec.empty[StateEntry]();
    vec.reserve(merged, n_left + n_right);
    var i usize = 0;
    var j usize = 0;
    for i < n_left && j < n_right {
        if left[i].symbol < right[j].symbol {
            vec.push(merged, left[i]);
            i += 1;
        } else if right[j].symbol < left[i].symbol {
            vec.push(merged, right[j]);
            j += 1;
        } else {
            vec.push(merged, StateEntry(symbol: left[i].symbol,
                value: left[i].value | right[j].value));
            i += 1;
            j += 1;
        }
    }
    for i < n_left {
        vec.push(merged, left[i]);
        i += 1;
    }
    for j < n_right {
        vec.push(merged, right[j]);
        j += 1;
    }
    flow.normal = State(entries: merged);
}

func flow_set_normal(flow inout Flow, source State) {
    flow.normal = copy_state(source);
    flow.has_normal = true;
}

func flow_clear_normal(flow inout Flow) {
    flow.has_normal = false;
    flow.normal = empty_state();
}

func flow_edge(flow Flow, kind hir.ExitKind, target usize, error usize,
               state State) {
    vec.push(flow.edges, Edge(kind: kind, target: target, error: error,
        state: copy_state(state)));
}

func edge_flow(flow Flow, edge Edge) {
    vec.push(flow.edges, Edge(kind: edge.kind, target: edge.target,
        error: edge.error, state: copy_state(edge.state)));
}

func flow_edges(to Flow, from Flow) {
    for edge in from.edges {
        edge_flow(to, edge);
    }
}

func ids_contains_unsorted(values Vec[usize], value usize) bool {
    for item in values {
        if item == value {
            return true;
        }
    }
    return false;
}

func ids_lower_bound(values Vec[usize], value usize) usize {
    var low usize = 0;
    var high = vec.len(values);
    for low < high {
        let mid = low + (high - low) / 2;
        if values[mid] < value {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

func ids_contains(values Vec[usize], value usize) bool {
    let pos = ids_lower_bound(values, value);
    return pos < vec.len(values) && values[pos] == value;
}

func ids_insert(values Vec[usize], value usize) bool {
    let pos = ids_lower_bound(values, value);
    let n = vec.len(values);
    if pos < n && values[pos] == value {
        return false;
    }
    vec.push(values, 0);
    var cur = n;
    for cur > pos {
        values[cur] = values[cur - 1];
        cur -= 1;
    }
    values[pos] = value;
    return true;
}

func ids_remove(values Vec[usize], value usize) {
    let pos = ids_lower_bound(values, value);
    let n = vec.len(values);
    if pos >= n || values[pos] != value {
        return;
    }
    var cur = pos;
    for cur + 1 < n {
        values[cur] = values[cur + 1];
        cur += 1;
    }
    let discarded = vec.pop(values);
}

func int_index(values Vec[usize], value usize) i64 {
    for var index usize = 0; index < vec.len(values); index += 1 {
        if values[index] == value {
            return i64(index);
        }
    }
    return -1;
}

func node_at(analysis Analysis, id usize) hir.HirNode throws Problem {
    if id >= vec.len(analysis.module.nodes) {
        throw internal_problem("ownership node index is out of range");
    }
    return analysis.module.nodes[id];
}

func scope_at(analysis Analysis, id usize) hir.HirScope throws Problem {
    if id >= vec.len(analysis.module.scopes) {
        throw internal_problem("ownership scope index is out of range");
    }
    return analysis.module.scopes[id];
}

func type_at(module hir.HirModule, id usize) model.Type throws Problem {
    switch types.find(module.types, id) {
        case option.Option.Some(value): return value;
        case option.Option.None:
            throw internal_problem(
                "ownership type is not in public TypeContext");
    }
}

func support_error_message(error model.SupportError) string {
    switch error {
        case model.SupportError.Invalid(message): return message;
        case model.SupportError.Limit(message): return message;
    }
}

func value_entry_lookup(analysis Analysis, type_id usize) i64 {
    if type_id < vec.len(analysis.value_map) {
        return analysis.value_map[type_id];
    }
    for var index usize = 0; index < vec.len(analysis.values); index += 1 {
        if analysis.values[index].type_id == type_id {
            return i64(index);
        }
    }
    return -1;
}

func copy_value_fields(fields Vec[hir.ValueField]) Vec[hir.ValueField] {
    let out = vec.empty[hir.ValueField]();
    vec.reserve(out, vec.len(fields));
    for field in fields {
        vec.push(out, field);
    }
    return out;
}

// ValueOps owns its field array.  Return an independent array on every path so
// a caller can never mutate the Analysis-local cached record.
func copy_value_ops(operations hir.ValueOps) hir.ValueOps {
    return hir.ValueOps(kind: operations.kind,
        needs_drop: operations.needs_drop, pod_inout: operations.pod_inout,
        fields: copy_value_fields(operations.fields), reason: operations.reason);
}

func classify(analysis inout Analysis, id usize) hir.ValueOps throws Problem {
    let known = value_entry_lookup(analysis, id);
    if known >= 0 {
        return copy_value_ops(analysis.values[usize(known)].operations);
    }
    var operations = hir.ValueOps(kind: hir.ValueKind.Trivial,
        needs_drop: false, pod_inout: false, fields: [], reason: "");
    try {
        operations = valueops.classify_value(analysis.module, id);
    } catch error model.SupportError {
        // Failures are not recorded: every query starts from fresh classifier
        // traversal budgets and preserves its original code/message.
        throw internal_problem(support_error_message(error));
    }
    let slot = vec.len(analysis.values);
    vec.push(analysis.values,
        ValueEntry(type_id: id, operations: operations));
    if id < vec.len(analysis.value_map) {
        analysis.value_map[id] = i64(slot);
    }
    return copy_value_ops(operations);
}

func contains_type_parameter(module hir.HirModule, id usize) bool
    throws Problem {
    try {
        return valueops_contains_type_parameter(module, id);
    } catch error model.SupportError {
        throw internal_problem(support_error_message(error));
    }
}

func inout_data_type(module hir.HirModule, id usize) bool throws Problem {
    try {
        return valueops.inout_data_type(module, id, vec.empty[usize]());
    } catch error model.SupportError {
        throw internal_problem(support_error_message(error));
    }
}

func valueops_contains_type_parameter(module hir.HirModule, root usize) bool
    throws model.SupportError {
    let pending = vec.empty[usize]();
    vec.push(pending, root);
    let seen = vec.empty[usize]();
    for vec.len(pending) > 0 {
        let popped = vec.pop(pending);
        var id usize = 0;
        switch popped {
            case option.Option.Some(item): id = item;
            case option.Option.None: continue;
        }
        if !ids_contains(seen, id) {
            vec.push(seen, id);
            if vec.len(seen) > 65536 {
                throw model.SupportError.Invalid(
                    "concrete ownership type traversal budget exceeded");
            }
            var value = model.empty_type(model.TypeKind.Error);
            switch types.find(module.types, id) {
                case option.Option.Some(found): value = found;
                case option.Option.None:
                    throw model.SupportError.Invalid(
                        "ownership type is not in public TypeContext");
            }
            if model.type_kind_id(value.kind) == model.type_kind_id(
                    model.TypeKind.TypeParameter) {
                return true;
            }
            for argument in value.type_args {
                vec.push(pending, argument);
            }
            for parameter in value.parameters {
                vec.push(pending, parameter.type_id);
            }
            if model.type_kind_id(value.kind) == model.type_kind_id(
                    model.TypeKind.Function) {
                vec.push(pending, value.result);
                switch value.throws_type {
                    case option.Option.Some(item): vec.push(pending, item);
                    case option.Option.None: {}
                }
            }
        }
    }
    return false;
}

func kind_of(node hir.HirNode) hir.NodeKind {
    return hir.node_kind(node.data);
}

func kind_is(kind hir.NodeKind, expected hir.NodeKind) bool {
    return hir.node_kind_id(kind) == hir.node_kind_id(expected);
}

func type_kind_is(kind model.TypeKind, expected model.TypeKind) bool {
    return model.type_kind_id(kind) == model.type_kind_id(expected);
}

func node_read(node hir.HirNode) option.Option[hir.Read] {
    switch node.data {
        case hir.NodeData.Read(value): return option.Option[hir.Read].Some(value);
        case _: return option.Option[hir.Read].None;
    }
}

