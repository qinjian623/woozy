package llvmopt;

import "std/fs" as fs;
import "std/os" as os;

// Fold one staged optimized LLVM text file into a separate output file.
// The input is never modified. The result reports whether bytes changed so a
// caller can run the verifier again only when it has new text.
pub func fold_empty_gc_regions_file(input string, output string) bool throws os.Error {
    let before = fs.read_text(input);
    let after = fold_empty_gc_regions(before);
    fs.write_text(output, after, 0o600);
    return after != before;
}
