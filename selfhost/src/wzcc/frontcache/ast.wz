package frontcache;
import "app/wzcc/model" as model;
import "app/wzcc/source" as source;
import "app/wzcc/lexer" as lexer;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

func ast_name(cache Context, input model.Source) string {
    let key = vec.empty[u8]();
    put_string(key, cache.fingerprint); put_string(key, input.path); put_string(key, hash_bytes(input.original));
    return hash_bytes(key) + ".ast";
}
func offset(input model.Source, byte u64) usize throws Error {
    var low usize = 0; var high = vec.len(input.offsets);
    for low < high {
        let mid = low + (high - low) / 2;
        if input.offsets[mid] < byte { low = mid + 1; } else { high = mid; }
    }
    need(low < vec.len(input.offsets) && input.offsets[low] == byte);
    return low;
}
func spelling(input model.Source, start usize, end usize) string throws Error {
    need(start <= end && end <= vec.len(input.normalized));
    try { return text.from_bytes(input.normalized[start:end]); }
    catch problem text.Error { throw Error.Invalid; }
}
func decode_ast(bytes Vec[u8], cache Context, input model.Source) model.ParseResult throws Error {
    var reader = Reader(bytes: bytes, cursor: 0);
    need(string_value(inout reader) == "wz-ast/1");
    need(string_value(inout reader) == input.path);
    need(string_value(inout reader) == hash_bytes(input.original));
    need(string_value(inout reader) == cache.fingerprint);
    let token_count = count(inout reader); need(token_count <= vec.len(input.normalized) + 1);
    let tokens = vec.empty[model.Token]();
    var normalized_cursor usize = 0;
    for var index usize = 0; index < token_count; index += 1 {
        let kind = token_kind(number(inout reader));
        let span = get_span(inout reader, input);
        let start = usize(number(inout reader)); let end = usize(number(inout reader));
        let value = spelling(input, start, end);
        need(same_span(source.span(input, start, end), span));
        let has_string = flag(inout reader); var string_text = "";
        if has_string { string_text = string_value(inout reader); }
        if model.token_kind_id(kind) == 4 {
            cache.counters[8] += 1;
            let fragment = source.snapshot(0, 0, 0, "<cached-string-token>", input.normalized[start:end]);
            let decoded = lexer.lex(fragment);
            need(decoded.has_value && vec.len(decoded.diagnostics) == 0 && vec.len(decoded.tokens) == 2);
            let literal = decoded.tokens[0];
            need(model.token_kind_id(literal.kind) == 4 && literal.spelling == value && vec.len(literal.leading_trivia) == 0);
            need(has_string && literal.has_string_value && literal.string_value == string_text);
        } else { need(!has_string); }
        need(start >= normalized_cursor);
        if model.token_kind_id(kind) == 0 { need(index + 1 == token_count && start == vec.len(input.normalized) && end == start); }
        else { need(start != end); }
        var trivia_cursor = normalized_cursor;
        let trivia_count = count(inout reader); let trivia = vec.empty[model.Trivia]();
        for var item usize = 0; item < trivia_count; item += 1 {
            let trivia_kind_value = trivia_kind(number(inout reader));
            let trivia_span = get_span(inout reader, input);
            let begin = usize(number(inout reader)); let finish = usize(number(inout reader));
            need(begin == trivia_cursor && begin < finish && finish <= start); trivia_cursor = finish;
            let trivia_text = spelling(input, begin, finish);
            need(same_span(source.span(input, begin, finish), trivia_span));
            vec.push(trivia, model.Trivia(kind: trivia_kind_value, span: trivia_span, spelling: trivia_text));
        }
        need(trivia_cursor == start); normalized_cursor = end;
        vec.push(tokens, model.Token(kind: kind, span: span, spelling: value,
            leading_trivia: trivia, has_string_value: has_string, string_value: string_text));
    }
    let node_count = count(inout reader);
    need(node_count <= vec.len(input.normalized) * 4 + 16);
    let root = usize(number(inout reader));
    need(token_count > 0 && node_count > 0 && root < node_count);
    need(model.token_kind_id(tokens[token_count - 1].kind) == 0);
    let nodes = vec.empty[model.AstNode](); let parents = vec.make[usize](node_count, 0);
    for var index usize = 0; index < node_count; index += 1 {
        let kind = ast_kind(number(inout reader)); let span = get_span(inout reader, input);
        let start = usize(number(inout reader)); let end = usize(number(inout reader));
        need(start < token_count && start <= end && end <= token_count);
        var expected = tokens[start].span;
        if end > start { expected.end_byte = tokens[end - 1].span.end_byte; }
        need(same_span(expected, span));
        let size = count(inout reader); need(size <= node_count);
        let children = vec.empty[usize]();
        for var child_index usize = 0; child_index < size; child_index += 1 {
            let child = usize(number(inout reader)); need(child < node_count && child != index);
            parents[child] += 1; need(parents[child] <= 1); vec.push(children, child);
        }
        vec.push(nodes, model.AstNode(kind: kind, span: span, token_begin: start, token_end: end,
            children: children, recovered: false));
    }
    done(reader); need(parents[root] == 0 && model.ast_kind_id(nodes[root].kind) == 0);
    let visited = vec.make[bool](node_count, false); let pending = [root];
    for vec.len(pending) != 0 {
        let current = pending[vec.len(pending) - 1]; vec.pop(pending);
        need(!visited[current]); visited[current] = true;
        let parent = nodes[current];
        for child_id in parent.children {
            let child = nodes[child_id];
            need(child.span.begin_byte >= parent.span.begin_byte && child.span.end_byte <= parent.span.end_byte);
            need(child.token_begin >= parent.token_begin && child.token_end <= parent.token_end);
            vec.push(pending, child_id);
        }
    }
    need(vec.len(nodes[root].children) > 0);
    need(model.ast_kind_id(nodes[nodes[root].children[0]].kind) == 1);
    let lexed = model.LexResult(state: model.PhaseState.Complete, failure: model.FailureKind.Source,
        source: input, tokens: tokens, diagnostics: [], has_value: true);
    return model.ParseResult(state: model.PhaseState.Complete, failure: model.FailureKind.Source,
        lexed: lexed, nodes: nodes, root: root, recovered: false, diagnostics: [], has_value: true);
}
pub func load_ast(cache Context, input model.Source) option.Option[model.ParseResult] {
    if !active(cache) { return option.Option[model.ParseResult].None; }
    cache.counters[1] += 1;
    if !input.valid { return option.Option[model.ParseResult].None; }
    switch get(cache.directory + "/parse", ast_name(cache, input)) {
        case option.Option.None: return option.Option[model.ParseResult].None;
        case option.Option.Some(bytes): {
            try {
                let value = decode_ast(bytes, cache, input);
                cache.counters[1] -= 1; cache.counters[0] += 1;
                return option.Option[model.ParseResult].Some(value);
            } catch problem Error { return option.Option[model.ParseResult].None; }
        }
    }
}
pub func store_ast(cache Context, file model.ParseResult) {
    if !active(cache) { return; }
    try {
        let bytes = vec.empty[u8](); let input = file.lexed.source;
        put_string(bytes, "wz-ast/1"); put_string(bytes, input.path);
        put_string(bytes, hash_bytes(input.original)); put_string(bytes, cache.fingerprint);
        put_number(bytes, u64(vec.len(file.lexed.tokens)));
        for token in file.lexed.tokens {
            put_number(bytes, u64(model.token_kind_id(token.kind))); put_span(bytes, token.span);
            put_number(bytes, u64(offset(input, token.span.begin_byte))); put_number(bytes, u64(offset(input, token.span.end_byte)));
            if token.has_string_value { put_number(bytes, 1); put_string(bytes, token.string_value); }
            else { put_number(bytes, 0); }
            put_number(bytes, u64(vec.len(token.leading_trivia)));
            for trivia in token.leading_trivia {
                put_number(bytes, u64(model.trivia_kind_id(trivia.kind))); put_span(bytes, trivia.span);
                put_number(bytes, u64(offset(input, trivia.span.begin_byte))); put_number(bytes, u64(offset(input, trivia.span.end_byte)));
            }
        }
        put_number(bytes, u64(vec.len(file.nodes))); put_number(bytes, u64(file.root));
        for node in file.nodes {
            put_number(bytes, u64(model.ast_kind_id(node.kind))); put_span(bytes, node.span);
            put_number(bytes, u64(node.token_begin)); put_number(bytes, u64(node.token_end));
            put_number(bytes, u64(vec.len(node.children)));
            for child in node.children { put_number(bytes, u64(child)); }
        }
        put(cache.directory + "/parse", ast_name(cache, input), bytes);
    } catch problem Error {}
}
