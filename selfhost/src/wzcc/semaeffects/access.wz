}

pub func b_node_foreign_read(node hir.HirNode) option.Option[hir.ForeignRead] {
    switch node.data {
        case hir.NodeData.ForeignRead(value):
            return option.Option[hir.ForeignRead].Some(value);
        default: return option.Option[hir.ForeignRead].None;
    }
}

func b_node_await(node hir.HirNode) bool {
    switch node.data { case hir.NodeData.Await(value): return true; default: return false; }
}

func b_node_call(node hir.HirNode) option.Option[hir.Call] {
    switch node.data {
        case hir.NodeData.Call(value): return option.Option[hir.Call].Some(value);
        default: return option.Option[hir.Call].None;
    }
}

func b_node_constraint_call(node hir.HirNode)
    option.Option[hir.ConstraintCall] {
    switch node.data {
        case hir.NodeData.ConstraintCall(value):
            return option.Option[hir.ConstraintCall].Some(value);
        default: return option.Option[hir.ConstraintCall].None;
    }
}

