package nativebuild;

import "app/wzcc/model" as model;
import "app/wzcc/frontcache" as frontcache;
import "std/option" as option;
import "std/json" as json;
import "app/wzcc/llvmopt" as llvmopt;
import "app/wzcc/nativeemit" as nativeemit;
import "app/wzcc/resources" as resources;
import "app/wzcc/toolio" as toolio;
import "std/fs" as fs;
import "std/os" as os;
import "std/strconv" as strconv;
import "std/text" as text;
import "std/vec" as vec;

pub struct PackageInput {
    pub package_id usize; pub logical_path string; pub identity string; pub object_key string; pub frontend_key string; pub llvm_digest string;
    pub object option.Option[Vec[u8]]; pub output option.Option[nativeemit.Output];
}

enum Failure { Abort(kind model.FailureKind, diagnostic model.Diagnostic); }

func diagnostic(code string, phase string, message string, notes Vec[string]) model.Diagnostic {
    var result = model.diagnostic(code, phase, message, model.Span(snapshot: 0, begin_byte: 0, end_byte: 0));
    result.has_primary = false;
    result.notes = notes;
    return result;
}
func failed(kind model.FailureKind, value model.Diagnostic) model.UnitResult {
    return model.UnitResult(state: model.PhaseState.Failed, failure: kind,
        diagnostics: [value], has_value: false);
}
func abort(code string, phase string, kind model.FailureKind, message string,
           notes Vec[string]) Failure {
    return Failure.Abort(kind, diagnostic(code, phase, message, notes));
}
func llvm_tools(root string) string throws Failure {
    try { return resources.llvm_bin(root); }
    catch problem os.Error {
        throw abort("E_TOOLCHAIN_MISSING", "codegen", model.FailureKind.Environment,
            "cannot read WOOZY_LLVM_BIN: " + os_text(problem), []);
    }
}
func os_text(problem os.Error) string {
    switch problem {
        case os.Error.System(code, completed):
            return "os error " + strconv.format_i64(i64(code)) + ", completed=" + strconv.format_u64(u64(completed));
        case os.Error.Interrupted(code, completed):
            return "os error " + strconv.format_i64(i64(code)) + ", completed=" + strconv.format_u64(u64(completed));
        case os.Error.WouldBlock(code, completed):
            return "os error " + strconv.format_i64(i64(code)) + ", completed=" + strconv.format_u64(u64(completed));
        case os.Error.NoProgress(completed):
            return "no progress, completed=" + strconv.format_u64(u64(completed));
    }
}
func toolio_failure(problem toolio.Error, phase string, message string) Failure {
    switch problem {
        case toolio.Error.System(error):
            return abort("E_TOOLCHAIN_MISSING", phase, model.FailureKind.Environment,
                message + ": " + os_text(error), []);
        case toolio.Error.Rollback(backup, error):
            return abort("E_INPUT_IO", phase, model.FailureKind.Environment,
                "output recovery failed; retained at " + backup + ": " + os_text(error), [backup]);
    }
}

// Valid UTF-8 stays unchanged; otherwise hex preserves every original byte.
func output_text(bytes Vec[u8]) string throws Failure {
    try { return text.from_bytes(bytes); }
    catch error text.Error {}
    let hex = text.bytes("0123456789ABCDEF");
    let escaped = text.bytes("raw tool output bytes:");
    for byte in bytes {
        vec.push(escaped, 32);
        vec.push(escaped, hex[usize(byte / 16)]);
        vec.push(escaped, hex[usize(byte % 16)]);
    }
    try { return text.from_bytes(escaped); }
    catch error text.Error {
        throw abort("E_INTERNAL_ERROR", "codegen", model.FailureKind.Internal,
            "cannot encode ASCII tool diagnostic", []);
    }
}
func run(argv Vec[string], capture string, phase string) toolio.ProcessResult throws Failure {
    try { return toolio.run(argv, capture); }
    catch problem toolio.Error { throw toolio_failure(problem, phase, "cannot execute " + argv[0]); }
}
func version_is_fixed(value string) bool {
    let words = text.split(text.replace(text.replace(text.replace(value, "\r", " "), "\n", " "), "\t", " "), " ");
    var previous = "";
    for word in words {
        if word == "22.1.8" && (previous == "version" || previous == "LLD") { return true; }
        if word != "" { previous = word; }
    }
    return false;
}
func check_versions(directory string, capture string, linker string) throws Failure {
    for name in ["opt", "llc", "clang", linker] {
        let tool = directory + "/" + name;
        let result = run([tool, "--version"], capture, "codegen");
        let note = output_text(result.output);
        if result.exit_code != 0 || result.signalled || !version_is_fixed(note) {
            throw abort("E_TOOLCHAIN_MISSING", "codegen", model.FailureKind.Environment,
                "LLVM 22.1.8 required: " + tool, [note]);
        }
    }
}
func require_runtime(name string) throws Failure {
    try {
        if !fs.is_file(os.stat(name)) {
            throw abort("E_TOOLCHAIN_MISSING", "link", model.FailureKind.Environment,
                "runtime archive is not a regular file: " + name, []);
        }
    } catch problem os.Error {
        throw abort("E_TOOLCHAIN_MISSING", "link", model.FailureKind.Environment,
            "cannot read runtime archive " + name + ": " + os_text(problem), []);
    }
}
func require_darwin_sdk(capture string) string throws Failure {
    try { return resources.darwin_sdk(capture); }
    catch problem os.Error {
        throw abort("E_TOOLCHAIN_MISSING", "link", model.FailureKind.Environment,
            "macOS SDK required; install Xcode Command Line Tools or set SDKROOT", [os_text(problem)]);
    }
}
func write_sections(name string, sections Vec[string]) throws Failure {
    try {
        let file = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600);
        var closed = false;
        defer { if !closed { try { os.close(file); } catch problem os.Error {} } }
        for section in sections { os.write_all_text(file, section); }
        closed = true;
        os.close(file);
    } catch problem os.Error {
        throw abort("E_INPUT_IO", "codegen", model.FailureKind.Environment,
            "cannot write " + name + ": " + os_text(problem), []);
    }
}
func llvm_tool(argv Vec[string], capture string, name string) throws Failure {
    let result = run(argv, capture, "codegen");
    if result.exit_code != 0 || result.signalled {
        throw abort("E_IR_INVALID", "codegen", model.FailureKind.Internal,
            "LLVM " + name + " exited with status " + strconv.format_i64(i64(result.exit_code)),
            [output_text(result.output)]);
    }
}
func link_tool(argv Vec[string], capture string, adapter bool) throws Failure {
    let result = run(argv, capture, "link");
    if result.exit_code != 0 || result.signalled {
        let environment = result.signalled || result.exit_code == 126 || result.exit_code == 127;
        var code = "E_LINK_FAILED";
        var kind = model.FailureKind.Source;
        if environment { code = "E_TOOLCHAIN_MISSING"; kind = model.FailureKind.Environment; }
        var message = "native linker exited with status ";
        if adapter { message = "C adapter compilation failed with status "; }
        throw abort(code, "link", kind, message + strconv.format_i64(i64(result.exit_code)),
            [output_text(result.output)]);
    }
}

func compile(output nativeemit.Output, project model.Project, stage toolio.Stage,
             optimization u32, root string) throws Failure {
    let tools = llvm_tools(root);
    let capture = stage.path + "/tool-output";
    let source = stage.path + "/input.ll";
    var optimized = stage.path + "/verified.ll";
    let object = stage.path + "/program.o";
    let program = stage.path + "/program";
    let native_runtime = root + "/runtime/liblang_native_runtime.a";
    let hosted_runtime = root + "/runtime/liblang_hosted_runtime.a";
    let darwin = output.triple == nativeemit.DARWIN_ARM64_TRIPLE;
    var sdk = "";
    let darwin_runtime = root + "/runtime/liblang_darwin_core.a";
    if darwin {
        check_versions(tools, capture, "ld64.lld");
        sdk = require_darwin_sdk(capture);
        require_runtime(darwin_runtime);
    } else {
        check_versions(tools, capture, "ld.lld");
        require_runtime(native_runtime);
        if project.hosted { require_runtime(hosted_runtime); }
    }
    write_sections(source, output.llvm_sections);
    var passes = "verify";
    if optimization == 2 { passes = "verify,default<O2>,verify"; }
    else if output.has_async { passes = "verify,default<O0>,verify"; }
    let opt_command = [tools + "/opt"];
    if output.has_async {
        // LLVM 22 prints coroutine DILabels with an omitted zero line, which
        // its text reader rejects. Bitcode preserves the same verified IR.
        optimized = stage.path + "/verified.bc";
    } else { vec.push(opt_command, "-S"); }
    for argument in ["-passes=" + passes, "-verify-each", "-mtriple=" + output.triple,
                     "-mcpu=generic", source, "-o", optimized] { vec.push(opt_command, argument); }
    llvm_tool(opt_command, capture, "opt");
    if optimization == 2 && !output.has_async && !output.debug_info {
        let folded = stage.path + "/folded.ll";
        var modified = false;
        try { modified = llvmopt.fold_empty_gc_regions_file(optimized, folded); }
        catch problem os.Error {
            throw abort("E_INPUT_IO", "codegen", model.FailureKind.Environment,
                "cannot fold optimized GC regions: " + os_text(problem), []);
        }
        if modified {
            let verified_folded = stage.path + "/verified-folded.ll";
            let verify_command = [tools + "/opt", "-S", "-passes=verify", "-verify-each",
                "-mtriple=" + output.triple, "-mcpu=generic", folded, "-o", verified_folded];
            llvm_tool(verify_command, capture, "opt");
            optimized = verified_folded;
        }
    }
    let llc_command = [tools + "/llc", "-filetype=obj", "-O=" + strconv.format_u64(u64(optimization)),
        "-mtriple=" + output.triple, "-mcpu=generic", "-relocation-model=pic",
        "-code-model=small", optimized, "-o", object];
    // LLVM 22 GlobalISel can assign different stack offsets on the two sides
    // of a Darwin call that passes a large aggregate by value.
    if darwin { vec.push(llc_command, "-global-isel=0"); }
    llvm_tool(llc_command, capture, "llc");
    let adapter_source = stage.path + "/c_adapter.c";
    let adapter_object = stage.path + "/c_adapter.o";
    let adapter = output.c_adapter_source != "";
    if adapter {
        write_sections(adapter_source, [output.c_adapter_source]);
        var arguments = [tools + "/clang", "--target=" + output.triple];
        if darwin { arguments = resources.darwin_clang(tools, sdk); }
        for argument in ["-std=c11", "-O2", "-fPIC", "-c", adapter_source, "-o", adapter_object] {
            vec.push(arguments, argument);
        }
        link_tool(arguments, capture, true);
    }
    var arguments = [tools + "/clang", "--target=" + output.triple];
    var runtime = native_runtime;
    if darwin {
        arguments = resources.darwin_linker(tools, sdk);
        runtime = darwin_runtime;
    } else {
        if project.hosted {
            vec.push(arguments, "-Wl,-u,lang_hosted_startup_v1");
            vec.push(arguments, "-pthread");
            runtime = hosted_runtime;
        } else {
            vec.push(arguments, "-nostdlib");
            vec.push(arguments, "-static");
        }
        vec.push(arguments, "--ld-path=" + tools + "/ld.lld");
    }
    vec.push(arguments, object);
    if adapter { vec.push(arguments, adapter_object); }
    vec.push(arguments, runtime);
    for directory in project.c_library_dirs { vec.push(arguments, "-L" + directory); }
    for library in project.c_libraries { vec.push(arguments, "-l" + library); }
    vec.push(arguments, "-o");
    vec.push(arguments, program);
    link_tool(arguments, capture, false);
    if darwin && output.debug_info {
        link_tool(resources.darwin_debug_command(tools, program), capture, false);
    }
}

func shell_quote(value string) string { return "'" + text.replace(value, "'", "'\\''") + "'"; }
func ninja_escape(value string) string throws Failure {
    if text.contains(value, "\n") || text.contains(value, "\r") {
        throw abort("E_INPUT_IO", "codegen", model.FailureKind.Environment, "newline in Ninja path", []);
    }
    return text.replace(text.replace(text.replace(value, "$", "$$"), " ", "$ "), ":", "$:");
}
func compile_packages(inputs Vec[PackageInput], project model.Project, stage toolio.Stage,
                      settings nativeemit.Options, root string, cache frontcache.Context, emit_nanoseconds u64) throws Failure {
    try {
    let tools = llvm_tools(root);
    let capture = stage.path + "/tool-output";
    let darwin = settings.triple == nativeemit.DARWIN_ARM64_TRIPLE;
    var archive = root + "/runtime/liblang_native_runtime.a";
    var combine = ninja_escape(shell_quote(tools + "/ld.lld")) + " -r $in -o $out";
    var combined = "program.o";
    var link = shell_quote(tools + "/clang") + " --target=" + settings.triple + " --ld-path=" + shell_quote(tools + "/ld.lld");
    if darwin {
        check_versions(tools, capture, "ld64.lld");
        let sdk = require_darwin_sdk(capture);
        archive = root + "/runtime/liblang_darwin_core.a";
        combine = ninja_escape(shell_quote(tools + "/llvm-ar")) + " --format=darwin rcsD $out $in";
        combined = "program.a";
        link = "";
        for argument in resources.darwin_linker(tools, sdk) { link += shell_quote(argument) + " "; }
    } else {
        check_versions(tools, capture, "ld.lld");
        if project.hosted {
            archive = root + "/runtime/liblang_hosted_runtime.a";
            link += " -Wl,-u,lang_hosted_startup_v1 -pthread";
        } else { link += " -nostdlib -static"; }
    }
    require_runtime(archive);
    let opt = ninja_escape(shell_quote(tools + "/opt"));
    let opt_arguments = " -passes='verify,default<O" + strconv.format_u64(u64(settings.optimization)) +
        ">,verify' -verify-each -mtriple=" + settings.triple + " -mcpu=generic $in -o $out\n";
    var plan = "rule opt\n  command = " + opt + " -S" + opt_arguments;
    // Like the whole-module build, preserve CoroSplit's zero-line debug labels in bitcode.
    plan += "rule opt_bitcode\n  command = " + opt + opt_arguments;
    var target_flags = "";
    if darwin { target_flags = " -global-isel=0"; }
    plan += "rule object\n  command = " + ninja_escape(shell_quote(tools + "/llc")) +
        " -filetype=obj -O=" + strconv.format_u64(u64(settings.optimization)) +
        " -mtriple=" + settings.triple + " -mcpu=generic -relocation-model=pic -code-model=small" +
        target_flags + " $in -o $out\n";
    var fold_objects = false;
    if settings.optimization == 2 && !settings.debug_info {
        for input in inputs {
            if !option.is_some(input.object) {
                switch input.output {
                    case option.Option.Some(output): { if !output.has_async { fold_objects = true; } }
                    case option.Option.None: {}
                }
            }
        }
    }
    if fold_objects {
        let gc_fold = ninja_escape(shell_quote(os.executable_path())) + " __llvmopt_gc";
        plan += "rule gc_fold\n  command = " + gc_fold + " $in $out\n";
        plan += "rule gc_verify\n  command = " + opt +
            " -S -passes=verify -verify-each -mtriple=" + settings.triple +
            " -mcpu=generic $in -o $out\n";
    }
    var objects = "";
    var misses usize = 0; var records = "["; var first = true;
    for input in inputs {
        let name = "package-" + strconv.format_u64(u64(input.package_id)); var hit = false;
        switch input.object {
            case option.Option.Some(bytes): { fs.write_file(stage.path + "/" + name + ".o", bytes, 0o600); hit = true; }
            case option.Option.None: {
                switch input.output {
                    case option.Option.Some(output): {
                        write_sections(stage.path + "/" + name + ".ll", output.llvm_sections);
                        var verified = name + ".verified.ll";
                        var rule = "opt";
                        if output.has_async { verified = name + ".verified.bc"; rule = "opt_bitcode"; }
                        plan += "build " + verified + ": " + rule + " " + name + ".ll\n";
                        var llc_input = verified;
                        if settings.optimization == 2 && !output.has_async && !settings.debug_info {
                            let folded = name + ".folded.ll";
                            let checked = name + ".folded.verified.ll";
                            plan += "build " + folded + ": gc_fold " + verified + "\n";
                            plan += "build " + checked + ": gc_verify " + folded + "\n";
                            llc_input = checked;
                        }
                        plan += "build " + name + ".o: object " + llc_input + "\n";
                    }
                    case option.Option.None: throw abort("E_INTERNAL_ERROR", "codegen", model.FailureKind.Internal, "missing package emission", []);
                }
                misses += 1;
            }
        }
        objects += " " + name + ".o";
        if !first { records += ","; } first = false;
        var hit_text = "false"; if hit { hit_text = "true"; }
        records += "{\"logical_path\":" + quote_json(input.logical_path) + ",\"identity\":" + quote_json(input.identity) +
            ",\"object_key\":" + quote_json(input.object_key) + ",\"frontend_key\":" + quote_json(input.frontend_key) +
            ",\"llvm_ir_sha256\":" + quote_json(input.llvm_digest) + ",\"object\":" + quote_json(name + ".o") + ",\"object_cache_hit\":" + hit_text + "}";
    }
    records += "]\n";
    plan += "rule combine\n  command = " + combine + "\nbuild " + combined + ": combine" + objects + "\n";
    var libraries = "";
    for directory in project.c_library_dirs { libraries += " -L" + shell_quote(directory); }
    for library in project.c_libraries { libraries += " -l" + shell_quote(library); }
    plan += "rule link\n  command = " + ninja_escape(link) + " $in" + ninja_escape(libraries) +
        " -o $out\nbuild program: link" + objects + " " + ninja_escape(archive) + "\ndefault program " + combined + "\n";
    write_sections(stage.path + "/build.ninja", [plan]);
    var ninja = "";
    try { ninja = resources.ninja(); }
    catch problem os.Error {
        throw abort("E_TOOLCHAIN_MISSING", "codegen", model.FailureKind.Environment,
            "cannot find Ninja; set WOOZY_NINJA or PATH: " + os_text(problem), []);
    }
    let execution = run([ninja, "-C", stage.path, "-v"], capture, "codegen");
    write_sections(stage.path + "/package-build.log", [output_text(execution.output)]);
    if execution.exit_code != 0 || execution.signalled {
        throw abort("E_NATIVE_BUILD_FAILED", "codegen", model.FailureKind.Internal,
            "Ninja package build failed with status " + strconv.format_i64(i64(execution.exit_code)),
            [output_text(execution.output)]);
    }
    if darwin && settings.debug_info {
        link_tool(resources.darwin_debug_command(tools, stage.path + "/program"), capture, false);
    }
    for input in inputs {
        if input.object_key != "" && !option.is_some(input.object) {
            let bytes = fs.read_file(stage.path + "/package-" + strconv.format_u64(u64(input.package_id)) + ".o");
            frontcache.store_target_object(cache, input.object_key, bytes, settings.triple);
        }
    }
    write_sections(stage.path + "/package-records.json", [records]);
    write_sections(stage.path + "/cache-statistics.json", [statistics(cache, misses, vec.len(inputs), emit_nanoseconds)]);
    } catch problem os.Error { throw abort("E_INPUT_IO", "codegen", model.FailureKind.Environment, "package file IO: " + os_text(problem), []); }
}

func quote_json(value string) string throws Failure {
    try { return json.serialize(json.Value.String(value)); }
    catch problem json.Error { throw abort("E_INTERNAL_ERROR", "codegen", model.FailureKind.Internal, "cannot encode package metadata", []); }
}
func statistics(cache frontcache.Context, misses usize, emitted usize, emit_nanoseconds u64) string {
    let names = ["parse_hits", "parse_misses", "frontend_package_hits", "frontend_package_misses", "rejected_frontend_cache", "checked_bodies", "object_hits", "object_misses", "string_tokens_checked", "tool_digest_hits", "tool_digest_misses", "tool_digest_bytes_read"];
    var result = "{\"schema_version\":1,\"build_fingerprint\":\"" + cache.fingerprint + "\"";
    for var index usize = 0; index < vec.len(names); index += 1 { result += ",\"" + names[index] + "\":" + strconv.format_u64(u64(cache.counters[index])); }
    return result + ",\"llvm_emit_jobs\":" + strconv.format_u64(u64(emitted)) + ",\"llvm_emit_nanoseconds\":" + strconv.format_u64(emit_nanoseconds) + ",\"link_jobs\":1,\"opt_jobs\":" + strconv.format_u64(u64(misses)) + ",\"llc_jobs\":" + strconv.format_u64(u64(misses)) + "}\n";
}

pub func build_cached_packages(inputs Vec[PackageInput], project model.Project, out_directory string,
    settings nativeemit.Options, cache frontcache.Context, emit_nanoseconds u64) model.UnitResult {
    return build_all([], project, out_directory, settings, true, inputs, cache, emit_nanoseconds);
}
pub func build_packages(outputs Vec[nativeemit.Output], project model.Project, out_directory string,
                        optimization u32) model.UnitResult {
    let inputs = vec.empty[PackageInput]();
    for var index usize = 0; index < vec.len(outputs); index += 1 {
        vec.push(inputs, PackageInput(package_id: index, logical_path: "", identity: "", object_key: "", frontend_key: "", llvm_digest: "",
            object: option.Option[Vec[u8]].None, output: option.Option[nativeemit.Output].Some(outputs[index])));
    }
    var settings = nativeemit.default_options();
    settings.optimization = optimization;
    if vec.len(outputs) != 0 { settings.triple = outputs[0].triple; settings.debug_info = outputs[0].debug_info; }
    return build_all([], project, out_directory, settings, true, inputs, frontcache.context("", ""), 0);
}
pub func build(output nativeemit.Output, project model.Project, out_directory string,
               optimization u32) model.UnitResult {
    var settings = nativeemit.default_options();
    settings.optimization = optimization; settings.triple = output.triple; settings.debug_info = output.debug_info;
    return build_all([output], project, out_directory, settings, false, [], frontcache.context("", ""), 0);
}
func build_all(outputs Vec[nativeemit.Output], project model.Project, out_directory string,
               settings nativeemit.Options, packages bool, inputs Vec[PackageInput], cache frontcache.Context, emit_nanoseconds u64) model.UnitResult {
    let darwin = settings.triple == nativeemit.DARWIN_ARM64_TRIPLE;
    if settings.triple != "x86_64-unknown-linux-gnu" && !darwin {
        return failed(model.FailureKind.Unsupported, diagnostic("E_TARGET_UNSUPPORTED", "codegen",
            "unsupported native executable target: " + settings.triple, []));
    }
    if settings.optimization != 0 && settings.optimization != 2 {
        return failed(model.FailureKind.Unsupported, diagnostic("E_CAPABILITY_UNAVAILABLE", "codegen",
            "native executable build supports O0 and O2 only", []));
    }
    try {
        var stage = toolio.stage(out_directory, "native");
        defer { toolio.cleanup(stage); }
        try {
            let root = resources.directory();
            if packages {
                compile_packages(inputs, project, stage, settings, root, cache, emit_nanoseconds);
                let names = ["package-build.log", "package-records.json", "cache-statistics.json"];
                if darwin { vec.push(names, "program.a"); } else { vec.push(names, "program.o"); }
                if darwin && settings.debug_info { vec.push(names, "program.dwarf"); }
                vec.push(names, "program");
                toolio.publish_files(inout stage, names);
            } else {
                compile(outputs[0], project, stage, settings.optimization, root);
                if darwin && settings.debug_info {
                    toolio.publish_files(inout stage, ["program.o", "program.dwarf", "program"]);
                } else { toolio.publish_pair(inout stage, "program.o", "program"); }
            }
        } catch problem Failure {
            switch problem { case Failure.Abort(kind, value): return failed(kind, value); }
        } catch problem os.Error {
            return failed(model.FailureKind.Environment, diagnostic("E_INPUT_IO", "codegen",
                "cannot find compiler resources: " + os_text(problem), []));
        } catch problem toolio.Error {
            switch problem {
                case toolio.Error.System(error):
                    return failed(model.FailureKind.Environment, diagnostic("E_INPUT_IO", "codegen",
                        "cannot publish native outputs: " + os_text(error), []));
                case toolio.Error.Rollback(backup, error):
                    return failed(model.FailureKind.Environment, diagnostic("E_INPUT_IO", "codegen",
                        "output recovery failed; retained at " + backup + ": " + os_text(error), [backup]));
            }
        }
        return model.UnitResult(state: model.PhaseState.Complete, failure: model.FailureKind.Source,
            diagnostics: [], has_value: true);
    } catch problem toolio.Error {
        switch problem {
            case toolio.Error.System(error):
                return failed(model.FailureKind.Environment, diagnostic("E_INPUT_IO", "codegen",
                    "cannot create native output stage: " + os_text(error), []));
            case toolio.Error.Rollback(backup, error):
                return failed(model.FailureKind.Environment, diagnostic("E_INPUT_IO", "codegen",
                    "output recovery failed; retained at " + backup + ": " + os_text(error), [backup]));
        }
    }
}
