// C ABI v2 storage, calls, callbacks and managed registrations.
//
// This is a text-IR port of src/backend/native/c_ffi.cpp and the C portions of
// src/backend/native/emit.cpp.  The generated C11 adapter is in e_adapter.wz;
// this file never calls the C++ generator/helper/backend.
package nativeemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeadapter" as nativeadapter;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/vec" as vec;

func e_c_record_type(project model.Project, id u32,
                     state inout Emitter) string throws Error {
    for item in state.e.c_records {
        if item.c_type == id { return item.type_name; }
    }
    let declaration = e_c_type(project, id);
    if !e_c_decl_kind_is(declaration.kind, model.CDeclKind.Record) {
        throw invalid("C record cache referenced a non-record type");
    }
    let name = "c.record." + number(usize(id));
    let reference = type_reference(name);
    vec.push(state.e.c_records, CRecordLayout(c_type: id, type_name: reference));
    var fields Vec[string] = [];
    for field in declaration.fields {
        let spelling = c_ref_type(field.type_ref, inout state);
        vec.push(fields, spelling);
    }
    var body = "{}";
    if vec.len(fields) != 0 { body = "{ " + e_join_types(fields) + " }"; }
    let defined = define_type(name, body, inout state);
    return defined;
}

func c_ref_type(reference model.CTypeRef, state inout Emitter) string throws Error {
    switch reference.kind {
        case model.CTypeKind.Scalar: {
            if reference.scalar == "Unit" || reference.scalar == "bool" ||
               reference.scalar == "i8" || reference.scalar == "u8" {
                return "i8";
            }
            if reference.scalar == "i16" || reference.scalar == "u16" { return "i16"; }
            if reference.scalar == "i32" || reference.scalar == "u32" { return "i32"; }
            if reference.scalar == "i64" || reference.scalar == "u64" ||
               reference.scalar == "isize" || reference.scalar == "usize" {
                return "i64";
            }
            if reference.scalar == "f32" { return "float"; }
            if reference.scalar == "f64" { return "double"; }
            throw e_unsupported("unknown C scalar storage type");
        }
        case model.CTypeKind.Pointer:
            return "ptr";
        case model.CTypeKind.Buffer:
            return e_buffer_layout();
        case model.CTypeKind.Named: {
            let project = state.input.hir.resolved.project;
            let declaration = e_c_type(project, reference.named);
            switch declaration.kind {
                case model.CDeclKind.Record:
                    return e_c_record_type(project, declaration.id, inout state);
                case model.CDeclKind.Resource: return "ptr";
                case model.CDeclKind.Callback: return "ptr";
                case model.CDeclKind.Opaque: return "ptr";
            }
        }
    }
}

func c_lower_type(type_id usize, state inout Emitter) string throws Error {
    let config = state.input.hir.config;
    let value = type_of(state, type_id);
    if e_type_kind_is(value.kind, model.TypeKind.CForeignRecord) {
        let reference = model.CTypeRef(kind: model.CTypeKind.Named,
            scalar: "", writable: false, args: [], named: value.c_type);
        return c_ref_type(reference, inout state);
    }
    if e_type_kind_is(value.kind, model.TypeKind.Unit) || e_type_kind_is(value.kind, model.TypeKind.Bool) {
        return "i8";
    }
    if e_type_kind_is(value.kind, model.TypeKind.SignedInt) ||
       e_type_kind_is(value.kind, model.TypeKind.UnsignedInt) ||
       e_type_kind_is(value.kind, model.TypeKind.Isize) ||
       e_type_kind_is(value.kind, model.TypeKind.Usize) {
        let bits = e_type_bits(value.kind, value.bits, config.word_bits);
        return e_llvm_int_type(bits);
    }
    if e_type_kind_is(value.kind, model.TypeKind.Float) {
        if value.bits == 32 { return "float"; }
        return "double";
    }
    if e_type_kind_is(value.kind, model.TypeKind.CForeignPointer) ||
       e_type_kind_is(value.kind, model.TypeKind.CForeignResource) ||
       e_type_kind_is(value.kind, model.TypeKind.CForeignCallback) ||
       e_type_kind_is(value.kind, model.TypeKind.CForeignOpaque) {
        return "ptr";
    }
    if e_type_kind_is(value.kind, model.TypeKind.CForeignBuffer) {
        return e_buffer_layout();
    }
    throw e_unsupported("non-C type in C storage position");
}

func to_c_storage(type_id usize, value Value, state inout Emitter) Value throws Error {
    let value_type = type_of(state, type_id);
    if e_type_kind_is(value_type.kind, model.TypeKind.Bool) && value.type_name == "i1" {
        return result("i8", "zext i1 " + value.reference + " to i8", inout state);
    }
    return value;
}

func from_c_storage(type_id usize, value Value, state inout Emitter) Value throws Error {
    let value_type = type_of(state, type_id);
    if e_type_kind_is(value_type.kind, model.TypeKind.Bool) {
        return result("i1", "trunc " + typed(value) + " to i1", inout state);
    }
    return value;
}

func e_c_callback_source_type(reference model.CTypeRef,
                              state inout Emitter) string throws Error {
    if e_c_type_kind_is(reference.kind, model.CTypeKind.Scalar) && reference.scalar == "bool" {
        return "i1";
    }
    return c_ref_type(reference, inout state);
}

func resource_operation(c_type u32, copy bool,
                        state inout Emitter) Value throws Error {
    let project = state.input.hir.resolved.project;
    let declaration = e_c_type(project, c_type);
    if !e_c_decl_kind_is(declaration.kind, model.CDeclKind.Resource) {
        throw invalid("C resource operation on a non-resource type");
    }
    if copy {
        switch declaration.registration {
            case option.Option.Some(registration): {
                throw e_unsupported("managed registration resource is move-only");
            }
            case option.Option.None: {}
        }
    }
    if copy && declaration.retain_symbol == "" {
        throw e_unsupported("C resource has no retain_symbol and cannot be copied");
    }
    e_add_resource_used(c_type, inout state);
    var name = e_release_symbol(c_type);
    if copy { name = e_retain_symbol(c_type); }
    return declare_function(name, Signature(result: "void", parameters: ["ptr"]),
        inout state);
}

func callback_trampoline(symbol usize, c_type u32,
                         state inout Emitter) Value throws Error {
    e_add_callback_used(symbol, c_type, inout state);
    return declare_function(e_callback_trampoline_symbol(symbol, c_type),
        Signature(result: "void", parameters: []), inout state);
}

func callback_bridge(symbol usize, c_type u32,
                     state inout Emitter) Value throws Error {
    for item in state.e.callback_bridges {
        if item.symbol == symbol && item.c_type == c_type { return item.function; }
    }
    let project = state.input.hir.resolved.project;
    let declaration = e_c_type(project, c_type);
    if !e_c_decl_kind_is(declaration.kind, model.CDeclKind.Callback) {
        throw invalid("C callback bridge type is not a C callback");
    }
    let function_index = new_function(e_callback_bridge_symbol(symbol, c_type),
        Signature(result: "void", parameters: ["ptr", "ptr"]), "", "nounwind",
        inout state);
    let function = function_reference(state, function_index);
    vec.push(state.e.callback_bridges, CallbackBridge(symbol: symbol,
        c_type: c_type, function: function));
    let saved = save_cursor(state);
    let entry = new_block(function_index, "entry", inout state);
    position(entry, inout state);
    let target = call_target(state, symbol);
    let info = source_function(state, symbol);
    let target_signature = signature(info.signature, false, false, inout state);
    let target_type = type_of(state, info.signature);
    let out_pointer = parameter(state, function_index, 0);
    let packed_pointer = parameter(state, function_index, 1);
    var call_args Vec[Value] = [];
    for var index usize = 0; index < vec.len(declaration.parameters); index += 1 {
        let slot = result("ptr", "getelementptr ptr, ptr " +
            packed_pointer.reference + ", i64 " + number(index), inout state);
        let address = result("ptr", "load ptr, " + typed(slot), inout state);
        let spelling = c_ref_type(declaration.parameters[index].type_ref,
            inout state);
        var value = result(spelling, "load " + spelling + ", " + typed(address),
            inout state);
        if target_signature.parameters[index] == "i1" && spelling == "i8" {
            value = result("i1", "trunc i8 " + value.reference + " to i1",
                inout state);
        }
        vec.push(call_args, value);
    }
    let token_layout = e_gc_token_layout();
    let token = storage(token_layout, inout state);
    e_store(e_zero(token_layout), token, inout state);
    var enter_args Vec[Value] = [];
    vec.push(enter_args, token);
    let entered = runtime("lang_gc_program_callback_enter_v1", "i32", enter_args,
        inout state);
    let call_result = call(target_signature, target, call_args, inout state);
    let unit = e_c_type_kind_is(declaration.result.kind, model.CTypeKind.Scalar) &&
        declaration.result.scalar == "Unit";
    if !unit {
        let storage_type = c_ref_type(declaration.result, inout state);
        var stored = call_result;
        if storage_type == "i8" && stored.type_name == "i1" {
            stored = result("i8", "zext i1 " + stored.reference + " to i8",
                inout state);
        }
        e_store(stored, out_pointer, inout state);
    }
    var leave_args Vec[Value] = [];
    vec.push(leave_args, entered);
    vec.push(leave_args, token);
    runtime("lang_gc_program_callback_leave_v1", "void", leave_args, inout state);
    terminate("ret void", inout state);
    restore_cursor(saved, inout state);
    return function;
}

func e_gc_token_layout() string {
    return "{ ptr, ptr, i32, i32, i32, i32 }";
}
func e_registration_token_layout() string { return "{ ptr, ptr }"; }

func registration_dispatcher(c_type u32, userdata usize,
                             state inout Emitter) Value throws Error {
    for item in state.e.registration_dispatchers {
        if item.c_type == c_type && item.userdata == userdata {
            return item.function;
        }
    }
    let project = state.input.hir.resolved.project;
    let declaration = e_c_type(project, c_type);
    if !e_c_decl_kind_is(declaration.kind, model.CDeclKind.Callback) {
        throw invalid("managed callback type is not a C callback");
    }
    if userdata >= vec.len(declaration.parameters) {
        throw invalid("managed callback userdata index out of range");
    }
    let function_index = new_function(
        e_registration_callback_dispatch_symbol(c_type, userdata),
        Signature(result: "void", parameters: ["ptr", "ptr", "ptr"]), "",
        "nounwind", inout state);
    let function = function_reference(state, function_index);
    vec.push(state.e.registration_dispatchers,
        RegistrationDispatcher(c_type: c_type, userdata: userdata,
            function: function));
    let saved = save_cursor(state);
    let entry = new_block(function_index, "entry", inout state);
    position(entry, inout state);
    let context_pointer = parameter(state, function_index, 0);
    let out_pointer = parameter(state, function_index, 1);
    let packed_pointer = parameter(state, function_index, 2);
    let gc_layout = e_gc_token_layout();
    let gc_token = storage(gc_layout, inout state);
    e_store(e_zero(gc_layout), gc_token, inout state);
    var gc_enter_args Vec[Value] = [];
    vec.push(gc_enter_args, gc_token);
    let gc_entered = runtime("lang_gc_program_callback_enter_v1", "i32",
        gc_enter_args, inout state);
    let token_layout = e_registration_token_layout();
    let token = storage(token_layout, inout state);
    e_store(e_zero(token_layout), token, inout state);
    var enter_args Vec[Value] = [];
    vec.push(enter_args, context_pointer);
    vec.push(enter_args, token);
    let registration_state = runtime("lang_c_registration_enter_v1", "ptr",
        enter_args, inout state);
    let code_slot = result("ptr", "getelementptr ptr, ptr " +
        registration_state.reference + ", i64 0", inout state);
    let code = result("ptr", "load ptr, " + typed(code_slot), inout state);
    let env_slot = result("ptr", "getelementptr ptr, ptr " +
        registration_state.reference + ", i64 1", inout state);
    let env = result("ptr", "load ptr, " + typed(env_slot), inout state);
    var parameter_types Vec[string] = ["ptr"];
    var call_args Vec[Value] = [];
    vec.push(call_args, env);
    var packed usize = 0;
    for var index usize = 0; index < vec.len(declaration.parameters); index += 1 {
        if index == userdata { continue; }
        let slot = result("ptr", "getelementptr ptr, ptr " +
            packed_pointer.reference + ", i64 " + number(packed), inout state);
        packed += 1;
        let address = result("ptr", "load ptr, " + typed(slot), inout state);
        let storage_spelling = c_ref_type(declaration.parameters[index].type_ref,
            inout state);
        var value = result(storage_spelling, "load " + storage_spelling + ", " +
            typed(address), inout state);
        let source_spelling = e_c_callback_source_type(
            declaration.parameters[index].type_ref, inout state);
        if source_spelling == "i1" && value.type_name == "i8" {
            value = result("i1", "trunc i8 " + value.reference + " to i1",
                inout state);
        }
        vec.push(parameter_types, source_spelling);
        vec.push(call_args, value);
    }
    let unit = e_c_type_kind_is(declaration.result.kind, model.CTypeKind.Scalar) &&
        declaration.result.scalar == "Unit";
    var source_result = "i8";
    if !unit {
        source_result = e_c_callback_source_type(declaration.result, inout state);
    }
    let call_signature = Signature(result: source_result,
        parameters: parameter_types);
    let call_result = call(call_signature, code, call_args, inout state);
    if !unit {
        let storage_type = c_ref_type(declaration.result, inout state);
        var stored = call_result;
        if storage_type == "i8" && stored.type_name == "i1" {
            stored = result("i8", "zext i1 " + stored.reference + " to i8",
                inout state);
        }
        e_store(stored, out_pointer, inout state);
    }
    var gc_leave_args Vec[Value] = [];
    vec.push(gc_leave_args, gc_entered);
    vec.push(gc_leave_args, gc_token);
    runtime("lang_gc_program_callback_leave_v1", "void", gc_leave_args, inout state);
    var leave_args Vec[Value] = [];
    vec.push(leave_args, token);
    runtime("lang_c_registration_leave_v1", "void", leave_args, inout state);
    terminate("ret void", inout state);
    restore_cursor(saved, inout state);
    return function;
}

func borrow_registration(owner Value, state inout Emitter) RegistrationBorrow throws Error {
    let layout = e_registration_token_layout();
    let token = storage(layout, inout state);
    e_store(e_zero(layout), token, inout state);
    let present = result("i1", "icmp ne " + typed(owner) + ", null", inout state);
    let function_index = current_function(state);
    let lease = new_block(function_index, "c.reg.lease", inout state);
    let absent = new_block(function_index, "c.reg.no.lease", inout state);
    let done = new_block(function_index, "c.reg.leased", inout state);
    terminate("br " + typed(present) + ", label " + lease.reference +
        ", label " + absent.reference, inout state);
    position(lease, inout state);
    var borrow_args Vec[Value] = [];
    vec.push(borrow_args, owner);
    vec.push(borrow_args, token);
    let raw = runtime("lang_c_registration_borrow_v1", "ptr", borrow_args,
        inout state);
    let lease_end = here(state);
    terminate("br label " + done.reference, inout state);
    position(absent, inout state);
    let absent_end = here(state);
    terminate("br label " + done.reference, inout state);
    position(done, inout state);
    let phi = result("ptr", "phi ptr [ " + raw.reference + ", " +
        lease_end.reference + " ], [ null, " + absent_end.reference + " ]",
        inout state);
    return RegistrationBorrow(token: token, present: present, raw: phi);
}

func end_registration_borrow(borrow RegistrationBorrow,
                             state inout Emitter) throws Error {
    let function_index = current_function(state);
    let ending = new_block(function_index, "c.reg.end.lease", inout state);
    let done = new_block(function_index, "c.reg.lease.done", inout state);
    terminate("br " + typed(borrow.present) + ", label " + ending.reference +
        ", label " + done.reference, inout state);
    position(ending, inout state);
    var args Vec[Value] = [];
    vec.push(args, borrow.token);
    runtime("lang_c_registration_end_borrow_v1", "void", args, inout state);
    terminate("br label " + done.reference, inout state);
    position(done, inout state);
}

func e_c_source_parameter_indices(callable model.CCallableDecl) Vec[usize] {
    var out Vec[usize] = [];
    for var index usize = 0; index < vec.len(callable.parameters); index += 1 {
        var skip = false;
        switch callable.registers {
            case option.Option.Some(registers): {
                if index == registers.userdata_parameter { skip = true; }
            }
            case option.Option.None: {}
        }
        if !skip { vec.push(out, index); }
    }
    return out;
}

func e_note_resource(project model.Project, value model.Type,
                     state inout Emitter) {
    if e_type_kind_is(value.kind, model.TypeKind.CForeignResource) {
        e_add_resource_used(value.c_type, inout state);
    }
}

func c_foreign_call(instruction nativeir.Instruction, args Vec[Value],
                    state inout Emitter) Value throws Error {
    switch instruction.c_callable {
        case option.Option.None: throw invalid("C call missing callable metadata");
        case option.Option.Some(id): {
            let project = state.input.hir.resolved.project;
            let declaration = e_c_callable(project, id);
            let call_signature = type_of(state, instruction.signature);
            e_add_callable_used(id, inout state);
            let result_type = type_of(state, call_signature.result);
            e_note_resource(project, result_type, inout state);
            for parameter in call_signature.parameters {
                let parameter_type = type_of(state, parameter.type_id);
                e_note_resource(project, parameter_type, inout state);
            }
            let registration = e_registration_callback_checked(project, declaration);
            let close = registration_close(project, declaration);
            let source_indices = e_c_source_parameter_indices(declaration);
            if vec.len(source_indices) != vec.len(call_signature.parameters) {
                throw invalid("C call signature does not match source parameters");
            }
            var source_of Vec[usize] = [];
            for var index usize = 0; index < vec.len(declaration.parameters); index += 1 {
                vec.push(source_of, vec.len(declaration.parameters));
            }
            for var index usize = 0; index < vec.len(source_indices); index += 1 {
                source_of[source_indices[index]] = index;
            }
            var has_out = !e_type_kind_is(result_type.kind, model.TypeKind.Unit);
            var out = e_null();
            if has_out {
                let layout = c_lower_type(call_signature.result, inout state);
                out = storage(layout, inout state);
                start_lifetime(out, inout state);
            }
            var actual Vec[Value] = [];
            var slots Vec[Value] = [];
            var borrows Vec[RegistrationBorrow] = [];
            var registration_code = e_null();
            var registration_env = e_null();
            var registration_userdata = e_null();
            var has_registration_userdata = false;
            var registration_trampoline = e_null();
            var registration_context = e_null();
            switch registration {
                case option.Option.Some(mapping): {
                    registration_trampoline = declare_function(
                        e_registration_callback_trampoline_symbol(
                            mapping.callback_type,
                            mapping.callback_userdata_parameter),
                        Signature(result: "void", parameters: []), inout state);
                }
                case option.Option.None: {}
            }
            for var index usize = 0; index < vec.len(declaration.parameters); index += 1 {
                let spelling = c_ref_type(declaration.parameters[index].type_ref,
                    inout state);
                let slot = storage(spelling, inout state);
                start_lifetime(slot, inout state);
                vec.push(slots, slot);
                var handled = false;
                switch registration {
                    case option.Option.Some(mapping): {
                        if index == mapping.callback_parameter {
                            let source_index = source_of[index];
                            if source_index >= vec.len(call_signature.parameters) {
                                throw invalid("C raw parameter has no source argument");
                            }
                            let parameter_id = call_signature.parameters[source_index].type_id;
                            let parameter_type = type_of(state, parameter_id);
                            if !e_type_kind_is(parameter_type.kind, model.TypeKind.Function) {
                                throw invalid("managed registration callback is not a source function value");
                            }
                            let value = args[source_index];
                            registration_code = e_extract(value, 0, "ptr", inout state);
                            registration_env = e_extract(value, 1, "ptr", inout state);
                            e_store(registration_trampoline, slot, inout state);
                            vec.push(actual, slot);
                            handled = true;
                        } else if index == mapping.userdata_parameter {
                            registration_userdata = slot;
                            has_registration_userdata = true;
                            vec.push(actual, slot);
                            handled = true;
                        }
                    }
                    case option.Option.None: {}
                }
                if handled { continue; }
                let source_index = source_of[index];
                if source_index >= vec.len(call_signature.parameters) {
                    throw invalid("C raw parameter has no source argument");
                }
                let parameter_id = call_signature.parameters[source_index].type_id;
                let parameter_type = type_of(state, parameter_id);
                if e_type_kind_is(parameter_type.kind, model.TypeKind.CForeignCallback) {
                    switch function_value_info(state, instruction.inputs[source_index]) {
                        case option.Option.Some(info): {
                            if info.dynamic {
                                throw invalid("C callback cannot be a capturing or bound function value");
                            }
                            let trampoline = callback_trampoline(info.symbol,
                                parameter_type.c_type, inout state);
                            let ignored = callback_bridge(info.symbol,
                                parameter_type.c_type, inout state);
                            e_store(trampoline, slot, inout state);
                        }
                        case option.Option.None: {
                            throw invalid("C callback argument has no function identity");
                        }
                    }
                } else {
                    let value = args[source_index];
                    var leased = false;
                    if !close && e_type_kind_is(parameter_type.kind, model.TypeKind.CForeignResource) {
                        let resource = e_c_type(project, parameter_type.c_type);
                        switch resource.registration {
                            case option.Option.Some(item): {
                                let borrow = borrow_registration(value, inout state);
                                e_store(borrow.raw, slot, inout state);
                                vec.push(borrows, borrow);
                                leased = true;
                            }
                            case option.Option.None: {}
                        }
                    }
                    if !leased {
                        let stored = to_c_storage(parameter_id, value,
                            inout state);
                        e_store(stored, slot, inout state);
                    }
                }
                vec.push(actual, slot);
            }
            switch registration {
                case option.Option.Some(mapping): {
                    let unregister = declare_function(
                        e_registration_unregister_symbol(mapping.resource_type),
                        Signature(result: "void", parameters: ["ptr"]), inout state);
                    var create_args Vec[Value] = [];
                    vec.push(create_args, registration_code);
                    vec.push(create_args, registration_env);
                    vec.push(create_args, unregister);
                    registration_context = runtime("lang_c_registration_new_v1",
                        "ptr", create_args, inout state);
                    if !has_registration_userdata {
                        throw invalid("registration userdata slot is absent");
                    }
                    e_store(registration_context, registration_userdata, inout state);
                }
                case option.Option.None: {}
            }
            var adapter_parameters Vec[string] = ["ptr"];
            for var index usize = 0; index < vec.len(declaration.parameters); index += 1 {
                vec.push(adapter_parameters, "ptr");
            }
            let adapter_signature = Signature(result: "void",
                parameters: adapter_parameters);
            let adapter = declare_function(e_adapter_symbol(id), adapter_signature,
                inout state);
            var call_args Vec[Value] = [];
            if has_out {
                vec.push(call_args, out);
            } else {
                vec.push(call_args, e_null());
            }
            for item in actual { vec.push(call_args, item); }
            let safe = gc_enter_safe(inout state);
            let ignored = call(adapter_signature, adapter, call_args, inout state);
            gc_leave_safe(safe, inout state);
            for var index usize = vec.len(borrows); index > 0; index -= 1 {
                end_registration_borrow(borrows[index - 1], inout state);
            }
            for slot in slots {
                end_lifetime(slot, inout state);
            }
            switch registration {
                case option.Option.Some(mapping): {
                    let raw = e_load("ptr", out, inout state);
                    if has_out { end_lifetime(out, inout state); }
                    var finish_args Vec[Value] = [];
                    vec.push(finish_args, registration_context);
                    vec.push(finish_args, raw);
                    return runtime("lang_c_registration_finish_v1", "ptr",
                        finish_args, inout state);
                }
                case option.Option.None: {}
            }
            if !has_out { return Value(type_name: "i8", reference: "0"); }
            let layout = c_lower_type(call_signature.result, inout state);
            let loaded = e_load(layout, out, inout state);
            end_lifetime(out, inout state);
            return from_c_storage(call_signature.result, loaded, inout state);
        }
    }
}

func e_c_index(instruction nativeir.Instruction, args Vec[Value],
               state inout Emitter) Value throws Error {
    let receiver_id = value_type(state, instruction.inputs[0]);
    let receiver = type_of(state, receiver_id);
    let element = receiver.type_args[0];
    let index_id = value_type(state, instruction.inputs[1]);
    let index_type = type_of(state, index_id);
    let index = e_int_cast(args[1], "i64", e_type_signed(index_type.kind),
        inout state);
    let element_spelling = c_lower_type(element, inout state);
    if e_op_is(instruction.op, nativeir.Op.CPtrRead) ||
       e_op_is(instruction.op, nativeir.Op.CPtrWrite) {
        let address = result("ptr", "getelementptr " + element_spelling +
            ", ptr " + args[0].reference + ", i64 " + index.reference,
            inout state);
        return address;
    }
    let data = e_extract(args[0], 0, "ptr", inout state);
    let length = e_extract(args[0], 1, "i64", inout state);
    let bad = result("i1", "icmp uge i64 " + index.reference + ", " +
        length.reference, inout state);
    guard(bad, 4, instruction.source, inout state);
    let address = result("ptr", "getelementptr " + element_spelling +
        ", ptr " + data.reference + ", i64 " + index.reference, inout state);
    return address;
}

func emit_c_instruction(instruction nativeir.Instruction, args Vec[Value],
                        state inout Emitter) option.Option[Value] throws Error {
    if e_op_is(instruction.op, nativeir.Op.ForeignCall) {
        let value = c_foreign_call(instruction, args, inout state);
        return option.Option[Value].Some(value);
    }
    if e_op_is(instruction.op, nativeir.Op.CFieldRead) {
        let field = number(usize(instruction.c_field));
        let field_layout = c_lower_type(instruction.type_id, inout state);
        let raw = result(field_layout, "extractvalue " + args[0].type_name +
            " " + args[0].reference + ", " + field, inout state);
        let value = from_c_storage(instruction.type_id, raw, inout state);
        return option.Option[Value].Some(value);
    }
    if e_op_is(instruction.op, nativeir.Op.CPtrRead) ||
       e_op_is(instruction.op, nativeir.Op.CBufferRead) {
        let receiver = value_type(state, instruction.inputs[0]);
        let receiver_type = type_of(state, receiver);
        let element = receiver_type.type_args[0];
        let address = e_c_index(instruction, args, inout state);
        let spelling = c_lower_type(element, inout state);
        let loaded = e_load(spelling, address, inout state);
        let value = from_c_storage(element, loaded, inout state);
        return option.Option[Value].Some(value);
    }
    if e_op_is(instruction.op, nativeir.Op.CPtrWrite) ||
       e_op_is(instruction.op, nativeir.Op.CBufferWrite) {
        let receiver = value_type(state, instruction.inputs[0]);
        let receiver_type = type_of(state, receiver);
        let element = receiver_type.type_args[0];
        let address = e_c_index(instruction, args, inout state);
        let stored = to_c_storage(element, args[2], inout state);
        e_store(stored, address, inout state);
        return option.Option[Value].Some(Value(type_name: "i8", reference: "0"));
    }
    return option.Option[Value].None;
}

func e_registration_callback_checked(project model.Project,
    callable model.CCallableDecl) option.Option[RegistrationCallback] throws Error {
    try {
        switch nativeadapter.e_registration_callback_checked(project, callable) {
            case option.Option.None: return option.Option[RegistrationCallback].None;
            case option.Option.Some(value): return option.Option[RegistrationCallback].Some(
                RegistrationCallback(resource_type: value.resource_type, callback_type: value.callback_type,
                    callback_parameter: value.callback_parameter, userdata_parameter: value.userdata_parameter,
                    callback_userdata_parameter: value.callback_userdata_parameter));
        }
    } catch error nativeadapter.Error { throw adapter_error(error); }
}

func registration_callback(project model.Project,
                           callable model.CCallableDecl)
    option.Option[RegistrationCallback] {
    try {
        return e_registration_callback_checked(project, callable);
    }
    catch error Error {
        return option.Option[RegistrationCallback].None;
    }
}

func registration_close(project model.Project, callable model.CCallableDecl) bool {
    return nativeadapter.registration_close(project, callable);
}
