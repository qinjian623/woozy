func e_extra_math(instruction nativeir.Instruction, operation u32,
                  args Vec[Value], state inout Emitter) option.Option[Value] throws Error {
    let name = e_math_name(operation);
    if name == "" { return option.Option[Value].None; }
    if operation == 133 {
        let exponent = storage("i32", inout state);
        start_lifetime(exponent, inout state);
        var actual Vec[Value] = [];
        vec.push(actual, args[0]);
        vec.push(actual, exponent);
        let fraction = runtime(name, "double", actual, inout state);
        let layout = lower_type(instruction.type_id, inout state);
        var value = result(layout, "insertvalue " + layout +
            " zeroinitializer, double " + fraction.reference + ", 0", inout state);
        let high = e_load("i32", exponent, inout state);
        end_lifetime(exponent, inout state);
        value = e_insert_value(layout, value, high, "1", inout state);
        return option.Option[Value].Some(value);
    }
    let layout = lower_type(instruction.type_id, inout state);
    let value = runtime(name, layout, args, inout state);
    return option.Option[Value].Some(value);
}

func e_extra_numeric(instruction nativeir.Instruction, operation u32,
                     args Vec[Value], state inout Emitter) option.Option[Value] throws Error {
    let name = e_num_name(operation);
    if name == "" { return option.Option[Value].None; }
    let parse = operation <= 80;
    let signature = type_of(state, instruction.signature);
    let declared = type_of(state, instruction.type_id);
    var result_type = instruction.type_id;
    if parse { result_type = declared.type_args[0]; }
    let layout = lower_type(result_type, inout state);
    let out = storage(layout, inout state);
    start_lifetime(out, inout state);
    if parse {
        let parameter = signature.parameters[0].type_id;
        let address = element_storage(parameter, args[0], inout state);
        var actual Vec[Value] = [];
        vec.push(actual, address);
        vec.push(actual, out);
        let status = runtime(name, "i64", actual, inout state);
        let join = e_stdlib_result_begin(instruction.type_id, status, inout state);
        let payload = e_load(layout, out, inout state);
        let joined = e_stdlib_finish(join, payload, inout state);
        end_lifetime(out, inout state);
        return option.Option[Value].Some(joined);
    }
    var actual Vec[Value] = [];
    vec.push(actual, out);
    vec.push(actual, args[0]);
    runtime(name, "void", actual, inout state);
    let loaded = e_load(layout, out, inout state);
    end_lifetime(out, inout state);
    return option.Option[Value].Some(loaded);
}

func e_extra_fs(instruction nativeir.Instruction, operation u32,
                args Vec[Value], state inout Emitter) option.Option[Value] throws Error {
    let name = e_extra_fs_name(operation);
    if name == "" { return option.Option[Value].None; }
    let declared = type_of(state, instruction.type_id);
    let signature = type_of(state, instruction.signature);
    var actual = e_extra_fs_actual(operation, signature, args, inout state);
    var out = e_null();
    var result_type = instruction.type_id;
    let has_output = e_extra_fs_output(operation);
    if has_output {
        result_type = declared.type_args[0];
        let layout = lower_type(result_type, inout state);
        out = storage(layout, inout state);
        start_lifetime(out, inout state);
        if operation == 61 {
            var with_out Vec[Value] = [];
            vec.push(with_out, out);
            for item in actual { vec.push(with_out, item); }
            actual = with_out;
        } else {
            vec.push(actual, out);
        }
    } else if !e_extra_fs_raw(operation) {
        result_type = declared.type_args[0];
    }
    let status = runtime(name, "i64", actual, inout state);
    if e_extra_fs_raw(operation) {
        if has_output { end_lifetime(out, inout state); }
        return option.Option[Value].Some(status);
    }
    let join = e_stdlib_result_begin(instruction.type_id, status, inout state);
    if has_output {
        let layout = lower_type(result_type, inout state);
        let payload = e_load(layout, out, inout state);
        let joined = e_stdlib_finish(join, payload, inout state);
        end_lifetime(out, inout state);
        return option.Option[Value].Some(joined);
    }
    let success = type_of(state, result_type);
    if e_type_kind_is(success.kind, model.TypeKind.Unit) {
        let joined = e_stdlib_finish(join, Value(type_name: "i8", reference: "0"),
            inout state);
        return option.Option[Value].Some(joined);
    }
    let layout = lower_type(result_type, inout state);
    let cast = e_int_cast(status, layout, e_type_signed(success.kind), inout state);
    let joined = e_stdlib_finish(join, cast, inout state);
    return option.Option[Value].Some(joined);
}

func e_extra_system_call(instruction nativeir.Instruction,
                         args Vec[Value],
                         state inout Emitter) option.Option[Value] throws Error {
    switch instruction.system {
        case option.Option.None: throw invalid("system operation missing");
        case option.Option.Some(operation): {
            if operation >= 85 && operation <= 105 {
                return e_network_system_call(instruction, args, inout state);
            }
            switch e_extra_math(instruction, operation, args, inout state) {
                case option.Option.Some(value): return option.Option[Value].Some(value);
                case option.Option.None: {}
            }
            switch e_extra_numeric(instruction, operation, args, inout state) {
                case option.Option.Some(value): return option.Option[Value].Some(value);
                case option.Option.None: {}
            }
            if (operation >= 43 && operation <= 76) || (operation >= 213 && operation <= 215) {
                return e_extra_fs(instruction, operation, args, inout state);
            }
            return e_process_system_call(instruction, args, inout state);
        }
    }
}

func e_value_system_call(instruction nativeir.Instruction,
                         args Vec[Value],
                         state inout Emitter) option.Option[Value] throws Error {
    switch instruction.system {
        case option.Option.None: throw invalid("system operation missing");
        case option.Option.Some(operation): {
            if operation == 188 || operation == 189 {
                let layout = lower_type(instruction.type_id, inout state);
                let out = storage(layout, inout state);
                start_lifetime(out, inout state);
                let receiver_type = value_type(state, instruction.inputs[0]);
                let source_address = value_address(receiver_type, args[0], inout state);
                var actual Vec[Value] = [];
                vec.push(actual, out);
                vec.push(actual, source_address);
                if operation == 188 { vec.push(actual, args[1]); }
                var name = "lang_unicode_casefold_v1";
                if operation == 188 { name = "lang_unicode_normalize_v1"; }
                let status = runtime(name, "i64", actual, inout state);
                let bad = result("i1", "icmp slt " + typed(status) + ", 0",
                    inout state);
                guard(bad, 10, instruction.source, inout state);
                let loaded = e_load(layout, out, inout state);
                end_lifetime(out, inout state);
                return option.Option[Value].Some(loaded);
            }
            if operation == 190 {
                let receiver_type = value_type(state, instruction.inputs[0]);
                let source_address = value_address(receiver_type, args[0], inout state);
                var actual Vec[Value] = [];
                vec.push(actual, source_address);
                let value = runtime("lang_unicode_grapheme_boundaries_v1", "ptr",
                    actual, inout state);
                return option.Option[Value].Some(value);
            }
            if operation == 29 {
                let length = e_extract(args[0], 2, "i64", inout state);
                return option.Option[Value].Some(length);
            }
            if operation == 30 {
                let length = e_extract(args[0], 1, "i64", inout state);
                return option.Option[Value].Some(length);
            }
            if operation == 33 {
                let receiver_type = value_type(state, instruction.inputs[0]);
                let address = value_address(receiver_type, args[0], inout state);
                var actual Vec[Value] = [];
                vec.push(actual, address);
                let value = runtime("lang_text_bytes_v1", "ptr", actual, inout state);
                return option.Option[Value].Some(value);
            }
            if operation == 31 || operation == 32 {
                let declared = type_of(state, instruction.type_id);
                let text_type = declared.type_args[0];
                let layout = lower_type(text_type, inout state);
                let out = storage(layout, inout state);
                start_lifetime(out, inout state);
                var actual Vec[Value] = [];
                vec.push(actual, out);
                vec.push(actual, args[0]);
                var name = "lang_text_from_rune_v1";
                if operation == 31 { name = "lang_text_from_bytes_v1"; }
                let status = runtime(name, "i64", actual, inout state);
                let join = e_stdlib_result_begin(instruction.type_id, status,
                    inout state);
                let payload = e_load(layout, out, inout state);
                let joined = e_stdlib_finish(join, payload, inout state);
                end_lifetime(out, inout state);
                return option.Option[Value].Some(joined);
            }
            if operation >= 34 && operation <= 42 {
                let declared = type_of(state, instruction.type_id);
                var element = instruction.type_id;
                if operation == 34 || operation == 35 {
                    element = declared.type_args[0];
                } else {
                    let signature = type_of(state, instruction.signature);
                    let parameter = signature.parameters[0].type_id;
                    let parameter_type = type_of(state, parameter);
                    element = parameter_type.type_args[0];
                }
                if operation == 34 || operation == 35 {
                    var copy = e_null();
                    if owning(element, inout state) {
                        copy = value_op(element, true, inout state);
                    }
                    var drop = e_null();
                    if owning(element, inout state) {
                        drop = value_op(element, false, inout state);
                    }
                    let element_stride = stride(element, inout state);
                    var actual Vec[Value] = [];
                    vec.push(actual, e_i64(0));
                    vec.push(actual, element_stride);
                    vec.push(actual, copy);
                    vec.push(actual, drop);
                    let value = runtime("lang_vec_new_v1", "ptr", actual, inout state);
                    if operation == 35 {
                        let fill = element_storage(element, args[1], inout state);
                        var resize_args Vec[Value] = [];
                        vec.push(resize_args, value);
                        vec.push(resize_args, args[0]);
                        vec.push(resize_args, fill);
                        runtime("lang_vec_resize_v1", "void", resize_args, inout state);
                    }
                    gc_register_vec(value, element, inout state);
                    return option.Option[Value].Some(value);
                }
                if operation == 36 {
                    let length = vec_field(args[0], 1, "i64", inout state);
                    return option.Option[Value].Some(length);
                }
                if operation == 37 {
                    let capacity = vec_field(args[0], 8, "i64", inout state);
                    return option.Option[Value].Some(capacity);
                }
                if operation == 38 {
                    var actual Vec[Value] = [];
                    vec.push(actual, args[0]);
                    vec.push(actual, args[1]);
                    runtime("lang_vec_reserve_v1", "void", actual, inout state);
                    return option.Option[Value].Some(Value(type_name: "i8",
                        reference: "0"));
                }
                if operation == 39 {
                    let copy = copy_value(element, args[1], inout state);
                    let address = element_storage(element, copy, inout state);
                    var actual Vec[Value] = [];
                    vec.push(actual, args[0]);
                    vec.push(actual, address);
                    runtime("lang_vec_push_v1", "void", actual, inout state);
                    return option.Option[Value].Some(Value(type_name: "i8",
                        reference: "0"));
                }
                if operation == 40 {
                    let layout = lower_type(element, inout state);
                    let out = element_storage(element, e_zero(layout), inout state);
                    var actual Vec[Value] = [];
                    vec.push(actual, args[0]);
                    vec.push(actual, out);
                    let present = runtime("lang_vec_pop_v1", "i1", actual, inout state);
                    let join = e_stdlib_option_begin(instruction.type_id, present,
                        inout state);
                    let payload = e_load(layout, out, inout state);
                    let joined = e_stdlib_finish(join, payload, inout state);
                    return option.Option[Value].Some(joined);
                }
                if operation == 41 {
                    let fill = element_storage(element, args[2], inout state);
                    var actual Vec[Value] = [];
                    vec.push(actual, args[0]);
                    vec.push(actual, args[1]);
                    vec.push(actual, fill);
                    runtime("lang_vec_resize_v1", "void", actual, inout state);
                    return option.Option[Value].Some(Value(type_name: "i8",
                        reference: "0"));
                }
                if operation == 42 {
                    var actual Vec[Value] = [];
                    vec.push(actual, args[0]);
                    runtime("lang_vec_clear_v1", "void", actual, inout state);
                    return option.Option[Value].Some(Value(type_name: "i8",
                        reference: "0"));
                }
            }
            return option.Option[Value].None;
        }
    }
}

func e_async_zero(instruction nativeir.Instruction, state inout Emitter) Value throws Error {
    let layout = lower_type(instruction.type_id, inout state);
    return e_zero(layout);
}

func e_sync_system_call(operation u32, args Vec[Value],
                        state inout Emitter) option.Option[Value] throws Error {
    if operation == 17 {
        let value = runtime("lang_mutex_new_v1", "ptr", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 20 {
        let value = runtime("lang_condvar_new_v1", "ptr", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 24 {
        let value = runtime("lang_atomic_i64_new_v1", "ptr", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 25 {
        let value = runtime("lang_atomic_i64_load_v1", "i64", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 26 || operation == 18 || operation == 19 ||
       operation == 21 || operation == 22 || operation == 23 {
        var name = "lang_condvar_notify_all_v1";
        if operation == 26 { name = "lang_atomic_i64_store_v1"; }
        else if operation == 18 { name = "lang_mutex_lock_v1"; }
        else if operation == 19 { name = "lang_mutex_unlock_v1"; }
        else if operation == 21 { name = "lang_condvar_wait_v1"; }
        else if operation == 22 { name = "lang_condvar_notify_one_v1"; }
        runtime(name, "void", args, inout state);
        return option.Option[Value].Some(Value(type_name: "i8", reference: "0"));
    }
    if operation == 27 {
        let value = runtime("lang_atomic_i64_fetch_add_v1", "i64", args,
            inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 28 {
        let value = runtime("lang_atomic_i64_compare_exchange_v1", "i1", args,
            inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 192 {
        let value = runtime("lang_condvar_wait_for_v1", "i1", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 14 {
        let value = runtime("lang_thread_error_v1", "i64", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 15 {
        let value = runtime("lang_thread_wait_v1", "i64", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 191 {
        let value = runtime("lang_thread_wait_for_v1", "i64", args, inout state);
        return option.Option[Value].Some(value);
    }
    if operation == 16 {
        let value = runtime("lang_thread_result_v1", "i64", args, inout state);
        return option.Option[Value].Some(value);
    }
    return option.Option[Value].None;
}

func e_main_system_call(operation u32, instruction nativeir.Instruction,
                        args Vec[Value], state inout Emitter) Value throws Error {
    if operation == 0 { return runtime("lang_os_read_vec_v1", "i64", args, inout state); }
    if operation == 1 { return runtime("lang_os_write_vec_v1", "i64", args, inout state); }
    if operation == 2 {
        var actual Vec[Value] = [];
        vec.push(actual, args[0]);
        let pointer = e_text_pointer(args[1], inout state);
        let length = e_text_length(args[1], inout state);
        vec.push(actual, pointer);
        vec.push(actual, length);
        vec.push(actual, args[2]);
        vec.push(actual, args[3]);
        return runtime("lang_os_write_text_v1", "i64", actual, inout state);
    }
    if operation == 3 {
        var actual Vec[Value] = [];
        let pointer = e_text_pointer(args[0], inout state);
        let length = e_text_length(args[0], inout state);
        vec.push(actual, pointer);
        vec.push(actual, length);
        vec.push(actual, args[1]);
        vec.push(actual, args[2]);
        return runtime("lang_os_open_v1", "i64", actual, inout state);
    }
    if operation == 4 { return runtime("lang_os_close_v1", "i64", args, inout state); }
    if operation == 5 { return runtime("lang_os_seek_v1", "i64", args, inout state); }
    if operation == 6 {
        var actual Vec[Value] = [];
        let pointer = e_text_pointer(args[0], inout state);
        let length = e_text_length(args[0], inout state);
        vec.push(actual, pointer);
        vec.push(actual, length);
        return runtime("lang_os_unlink_v1", "i64", actual, inout state);
    }
    if operation == 7 {
        var actual Vec[Value] = [];
        let pointer = e_text_pointer(args[0], inout state);
        let length = e_text_length(args[0], inout state);
        vec.push(actual, pointer);
        vec.push(actual, length);
        vec.push(actual, args[1]);
        return runtime("lang_os_mkdir_v1", "i64", actual, inout state);
    }
    if operation == 8 {
        var actual Vec[Value] = [];
        let pointer = e_text_pointer(args[0], inout state);
        let length = e_text_length(args[0], inout state);
        vec.push(actual, pointer);
        vec.push(actual, length);
        return runtime("lang_os_rmdir_v1", "i64", actual, inout state);
    }
    if operation == 9 {
        var actual Vec[Value] = [];
        return runtime("lang_os_getpid_v1", "i64", actual, inout state);
    }
    if operation == 10 {
        runtime("lang_os_exit_v1", "void", args, inout state);
        return Value(type_name: "i8", reference: "0");
    }
    if operation == 11 { return runtime("lang_vec_length_v1", "i64", args, inout state); }
    if operation == 12 { return e_text_length(args[0], inout state); }
    if operation == 193 || operation == 194 {
        let layout = lower_type(instruction.type_id, inout state);
        var value = result(layout, "insertvalue " + layout +
            " zeroinitializer, " + typed(args[0]) + ", 0", inout state);
        value = e_insert_value(layout, value, args[1], "1", inout state);
        return value;
    }
    if operation == 195 || operation == 196 {
        let length = e_extract(args[0], 1, "i64", inout state);
        return length;
    }
    if operation == 197 || operation == 199 {
        let layout = lower_type(instruction.type_id, inout state);
        let out = storage(layout, inout state);
        start_lifetime(out, inout state);
        let receiver_type = value_type(state, instruction.inputs[0]);
        let source_address = value_address(receiver_type, args[0], inout state);
        var actual Vec[Value] = [];
        vec.push(actual, out);
        if operation == 197 {
            vec.push(actual, args[0]);
        } else {
            vec.push(actual, source_address);
        }
        vec.push(actual, args[1]);
        vec.push(actual, args[2]);
        var name = "lang_slice_sub_v1";
        if operation == 197 { name = "lang_slice_new_v1"; }
        runtime(name, "void", actual, inout state);
        let loaded = e_load(layout, out, inout state);
        end_lifetime(out, inout state);
        return loaded;
    }
    if operation == 198 {
        let receiver_type = value_type(state, instruction.inputs[0]);
        let address = value_address(receiver_type, args[0], inout state);
        var actual Vec[Value] = [];
        vec.push(actual, address);
        return runtime("lang_slice_length_v1", "i64", actual, inout state);
    }
    if operation == 200 {
        let owner = e_extract(args[0], 0, "ptr", inout state);
        let start = e_extract(args[0], 1, "i64", inout state);
        let length = e_extract(args[0], 2, "i64", inout state);
        let end = result("i64", "add i64 " + start.reference + ", " +
            length.reference, inout state);
        var actual Vec[Value] = [];
        vec.push(actual, owner);
        vec.push(actual, start);
        vec.push(actual, end);
        let value = runtime("lang_vec_slice_v1", "ptr", actual, inout state);
        let declared = type_of(state, instruction.type_id);
        gc_register_vec(value, declared.type_args[0], inout state);
        return value;
    }
    if operation == 204 || operation == 205 {
        var name = "lang_async_cancel_v1";
        if operation == 204 { name = "lang_async_spawn_v1"; }
        runtime(name, "void", args, inout state);
        return e_async_zero(instruction, inout state);
    }
    if operation == 206 {
        let status = runtime("lang_async_finished_v1", "i32", args, inout state);
        return result("i1", "icmp ne i32 " + status.reference + ", 0", inout state);
    }
    if operation == 207 { return runtime("lang_async_sleep_v1", "ptr", args, inout state); }
    if operation == 208 || operation == 209 {
        var actual Vec[Value] = [];
        vec.push(actual, args[0]);
        if operation == 208 {
            vec.push(actual, e_i32(1));
        } else {
            vec.push(actual, e_i32(4));
        }
        return runtime("lang_async_wait_fd_v1", "ptr", actual, inout state);
    }
    if operation == 210 {
        var actual Vec[Value] = [];
        runtime("lang_async_run_v1", "void", actual, inout state);
        return e_async_zero(instruction, inout state);
    }
    if operation == 211 {
        runtime("lang_async_run_until_v1", "void", args, inout state);
        return e_async_zero(instruction, inout state);
    }
    if operation == 212 {
        var actual Vec[Value] = [];
        runtime("lang_async_shutdown_v1", "void", actual, inout state);
        return e_async_zero(instruction, inout state);
    }
    throw invalid("unknown system operation");
}

func system_call(instruction nativeir.Instruction, args Vec[Value],
                 state inout Emitter) Value throws Error {
    switch instruction.system {
        case option.Option.None: throw invalid("system operation missing");
        case option.Option.Some(operation): {
            if operation == 13 {
                return thread_spawn(instruction, args, inout state);
            }
            if operation == 201 || operation == 202 || operation == 203 {
                switch weak_system_call(instruction, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            if operation >= 138 && operation <= 192 {
                switch e_extra_system_call(instruction, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            if operation == 85 || operation == 105 {
                switch e_network_system_call(instruction, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            if (operation >= 29 && operation <= 42) || operation >= 188 {
                switch e_value_system_call(instruction, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            if (operation >= 14 && operation <= 28) ||
               operation == 191 || operation == 192 {
                switch e_sync_system_call(operation, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            if (operation >= 43 && operation <= 84) || (operation >= 213 && operation <= 215) {
                switch e_extra_system_call(instruction, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            if operation >= 85 && operation <= 137 {
                switch e_extra_system_call(instruction, args, inout state) {
                    case option.Option.Some(value): return value;
                    case option.Option.None: {}
                }
            }
            return e_main_system_call(operation, instruction, args, inout state);
        }
    }
}
