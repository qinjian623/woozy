// Native system_operation text routes (process, network, extra, value, async,
// text/Unicode, Vec/Slice and the runtime ABI scalar operations).
//
// The routing order and runtime symbol names follow
// src/backend/native/emit.cpp and the .inc files it includes.  This file only
// writes LLVM text; it never calls the C++ backend.
package nativeemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/vec" as vec;

func e_process_runtime_name(operation u32) string {
    switch operation {
        case 138: return "lang_process_args_v1";
        case 139: return "lang_process_args_bytes_v1";
        case 140: return "lang_process_environment_v1";
        case 141: return "lang_process_environment_bytes_v1";
        case 142: return "lang_process_getenv_v1";
        case 143: return "lang_process_getenv_bytes_v1";
        case 144: return "lang_process_setenv_v1";
        case 145: return "lang_process_unsetenv_v1";
        case 146: return "lang_process_execve_v1";
        case 147: return "lang_process_spawn_v1";
        case 148: return "lang_process_setenv_bytes_v1";
        case 149: return "lang_process_unsetenv_bytes_v1";
        case 150: return "lang_process_execve_bytes_v1";
        case 151: return "lang_process_spawn_bytes_v1";
        case 152: return "lang_process_fork_v1";
        case 153: return "lang_process_waitpid_v1";
        case 154: return "lang_signal_mask_v1";
        case 155: return "lang_signal_pending_v1";
        case 156: return "lang_signal_wait_v1";
        case 157: return "lang_signal_disposition_v1";
        case 158: return "lang_ipc_map_anon_v1";
        case 159: return "lang_ipc_map_file_v1";
        case 160: return "lang_ipc_shm_open_v1";
        case 161: return "lang_ipc_shm_unlink_v1";
        case 162: return "lang_ipc_read_bytes_v1";
        case 163: return "lang_ipc_write_bytes_v1";
        case 164: return "lang_ipc_read_i32_v1";
        case 165: return "lang_ipc_write_i32_v1";
        case 166: return "lang_ipc_read_i64_v1";
        case 167: return "lang_ipc_write_i64_v1";
        case 168: return "lang_ipc_atomic_load_v1";
        case 169: return "lang_ipc_atomic_store_v1";
        case 170: return "lang_ipc_atomic_add_v1";
        case 171: return "lang_ipc_atomic_compare_v1";
        case 172: return "lang_ipc_mutex_init_v1";
        case 173: return "lang_ipc_cond_init_v1";
        case 174: return "lang_ipc_sem_init_v1";
        case 175: return "lang_ipc_length_v1";
        case 176: return "lang_ipc_mutex_lock_v1";
        case 177: return "lang_ipc_mutex_unlock_v1";
        case 178: return "lang_ipc_mutex_destroy_v1";
        case 179: return "lang_ipc_cond_signal_v1";
        case 180: return "lang_ipc_cond_broadcast_v1";
        case 181: return "lang_ipc_cond_destroy_v1";
        case 182: return "lang_ipc_sem_post_v1";
        case 183: return "lang_ipc_sem_destroy_v1";
        case 184: return "lang_ipc_cond_wait_v1";
        case 185: return "lang_ipc_sem_wait_v1";
        case 186: return "lang_ipc_sem_trywait_v1";
        case 187: return "lang_ipc_sem_value_v1";
        default: return "";
    }
}

func e_process_output(operation u32) bool {
    if operation == 138 || operation == 139 || operation == 140 ||
       operation == 141 || operation == 142 || operation == 143 {
        return true;
    }
    return operation == 154 || operation == 155 || operation == 156 ||
        operation == 158 || operation == 159 || operation == 162 ||
        operation == 164 || operation == 166 || operation == 168 ||
        operation == 170 || operation == 171;
}

func e_process_wait(operation u32) bool {
    return operation == 184 || operation == 185 || operation == 186;
}

func e_process_plain(operation u32, result_kind model.TypeKind) bool {
    return e_type_kind_is(result_kind, model.TypeKind.Unit) || e_process_wait(operation) ||
        operation == 187;
}

func e_process_actual(signature model.Type, args Vec[Value],
                      state inout Emitter) Vec[Value] throws Error {
    var actual Vec[Value] = [];
    for var index usize = 0; index < vec.len(args); index += 1 {
        let parameter = signature.parameters[index].type_id;
        let parameter_type = type_of(state, parameter);
        if e_type_kind_is(parameter_type.kind, model.TypeKind.String) {
            let address = element_storage(parameter, args[index], inout state);
            vec.push(actual, address);
        } else {
            vec.push(actual, args[index]);
        }
    }
    return actual;
}

func e_process_system_call(instruction nativeir.Instruction,
                           args Vec[Value],
                           state inout Emitter) option.Option[Value] throws Error {
    switch instruction.system {
        case option.Option.None: throw invalid("system operation missing");
        case option.Option.Some(operation): {
            let name = e_process_runtime_name(operation);
            if name == "" { return option.Option[Value].None; }
            let signature = type_of(state, instruction.signature);
            let declared_result = type_of(state, instruction.type_id);
            var actual = e_process_actual(signature, args, inout state);
            if operation == 175 {
                let length = runtime(name, "i64", actual, inout state);
                return option.Option[Value].Some(length);
            }
            if e_process_plain(operation, declared_result.kind) {
                var out = e_null();
                var has_out = false;
                if operation == 187 {
                    out = storage("i32", inout state);
                    start_lifetime(out, inout state);
                    has_out = true;
                    var with_out Vec[Value] = [];
                    vec.push(with_out, out);
                    for item in actual { vec.push(with_out, item); }
                    actual = with_out;
                }
                let status = runtime(name, "i64", actual, inout state);
                var bad = result("i1", "icmp slt " + typed(status) + ", 0",
                    inout state);
                if e_process_wait(operation) {
                    var expected = "-110";
                    if operation == 186 { expected = "-11"; }
                    let not_expected = result("i1", "icmp ne " + typed(status) + ", " +
                        expected, inout state);
                    bad = result("i1", "and " + typed(bad) + ", " +
                        not_expected.reference, inout state);
                }
                guard(bad, 10, instruction.source, inout state);
                if has_out {
                    let loaded = e_load("i32", out, inout state);
                    end_lifetime(out, inout state);
                    return option.Option[Value].Some(loaded);
                }
                if e_process_wait(operation) {
                    let completed = result("i1", "icmp eq " + typed(status) + ", 0",
                        inout state);
                    return option.Option[Value].Some(completed);
                }
                return option.Option[Value].Some(Value(type_name: "i8",
                    reference: "0"));
            }
            let payload_type = declared_result.type_args[0];
            let getenv = operation == 142 || operation == 143;
            var output_type = payload_type;
            if getenv {
                let option_type = type_of(state, payload_type);
                output_type = option_type.type_args[0];
            }
            var has_output = e_process_output(operation);
            var out = e_null();
            if has_output {
                let layout = lower_type(output_type, inout state);
                out = storage(layout, inout state);
                start_lifetime(out, inout state);
                var with_out Vec[Value] = [];
                vec.push(with_out, out);
                for item in actual { vec.push(with_out, item); }
                actual = with_out;
            }
            var wait_status = e_null();
            if operation == 153 {
                wait_status = storage("i32", inout state);
                start_lifetime(wait_status, inout state);
                vec.push(actual, wait_status);
            }
            let status = runtime(name, "i64", actual, inout state);
            let join = e_stdlib_result_begin(instruction.type_id, status, inout state);
            if getenv {
                let present = result("i1", "icmp eq " + typed(status) + ", 1",
                    inout state);
                let option_join = e_stdlib_option_begin(payload_type, present,
                    inout state);
                let layout = lower_type(output_type, inout state);
                let payload = e_load(layout, out, inout state);
                let inner = e_stdlib_finish(option_join, payload, inout state);
                let joined = e_stdlib_finish(join, inner, inout state);
                if has_output { end_lifetime(out, inout state); }
                return option.Option[Value].Some(joined);
            }
            if operation == 153 {
                let layout = lower_type(payload_type, inout state);
                let low = result("i32", "trunc i64 " + status.reference + " to i32",
                    inout state);
                var value = result(layout, "insertvalue " + layout +
                    " zeroinitializer, i32 " + low.reference + ", 0", inout state);
                let high = e_load("i32", wait_status, inout state);
                value = e_insert_value(layout, value, high, "1", inout state);
                let joined = e_stdlib_finish(join, value, inout state);
                end_lifetime(wait_status, inout state);
                if has_output { end_lifetime(out, inout state); }
                return option.Option[Value].Some(joined);
            }
            if has_output {
                let layout = lower_type(output_type, inout state);
                let payload = e_load(layout, out, inout state);
                let joined = e_stdlib_finish(join, payload, inout state);
                end_lifetime(out, inout state);
                return option.Option[Value].Some(joined);
            }
            let success = type_of(state, payload_type);
            if e_type_kind_is(success.kind, model.TypeKind.Unit) {
                let joined = e_stdlib_finish(join, Value(type_name: "i8",
                    reference: "0"), inout state);
                return option.Option[Value].Some(joined);
            }
            let layout = lower_type(payload_type, inout state);
            let cast = e_int_cast(status, layout, e_type_signed(success.kind),
                inout state);
            let joined = e_stdlib_finish(join, cast, inout state);
            return option.Option[Value].Some(joined);
        }
    }
}

func e_network_runtime_name(operation u32) string {
    switch operation {
        case 85: return "lang_net_socket_v1";
        case 86: return "lang_net_bind_v1";
        case 87: return "lang_net_connect_v1";
        case 88: return "lang_net_listen_v1";
        case 89: return "lang_net_accept_record_v1";
        case 90: return "lang_net_send_vec_v1";
        case 91: return "lang_net_recv_vec_v1";
        case 92: return "lang_net_sendto_vec_v1";
        case 93: return "lang_net_recvfrom_vec_v1";
        case 94: return "lang_net_shutdown_v1";
        case 95: return "lang_net_getsockname_v1";
        case 96: return "lang_net_getpeername_v1";
        case 97: return "lang_net_setsockopt_int_v1";
        case 98: return "lang_net_getsockopt_int_v1";
        case 99: return "lang_net_setsockopt_vec_v1";
        case 100: return "lang_net_getsockopt_vec_v1";
        case 101: return "lang_net_socketpair_v1";
        case 102: return "lang_net_poll_vec_v1";
        case 103: return "lang_net_inet_pton_v1";
        case 104: return "lang_net_format_address_v1";
        case 105: return "lang_net_lookup_v1";
        default: return "";
    }
}

func e_network_output(operation u32) bool {
    return operation == 89 || operation == 93 || operation == 95 ||
        operation == 96 || operation == 98 || operation == 101 ||
        operation == 103 || operation == 104 || operation == 105;
}

func e_network_actual(operation u32, signature model.Type, args Vec[Value],
                      state inout Emitter) Vec[Value] throws Error {
    var actual Vec[Value] = [];
    for var index usize = 0; index < vec.len(args); index += 1 {
        let parameter = signature.parameters[index].type_id;
        let parameter_type = type_of(state, parameter);
        if e_type_kind_is(parameter_type.kind, model.TypeKind.String) {
            if operation == 105 {
                let address = element_storage(parameter, args[index], inout state);
                vec.push(actual, address);
            } else {
                let pointer = e_text_pointer(args[index], inout state);
                let length = e_text_length(args[index], inout state);
                vec.push(actual, pointer);
                vec.push(actual, length);
            }
        } else if e_type_kind_is(parameter_type.kind, model.TypeKind.NominalStruct) {
            let address = element_storage(parameter, args[index], inout state);
            vec.push(actual, address);
        } else {
            vec.push(actual, args[index]);
        }
    }
    return actual;
}

func e_network_system_call(instruction nativeir.Instruction,
                           args Vec[Value],
                           state inout Emitter) option.Option[Value] throws Error {
    switch instruction.system {
        case option.Option.None: throw invalid("system operation missing");
        case option.Option.Some(operation): {
            let name = e_network_runtime_name(operation);
            if name == "" { return option.Option[Value].None; }
            let signature = type_of(state, instruction.signature);
            var actual = e_network_actual(operation, signature, args, inout state);
            let declared = type_of(state, instruction.type_id);
            let payload_type = declared.type_args[0];
            var out = e_null();
            let output = e_network_output(operation);
            if output {
                let layout = lower_type(payload_type, inout state);
                out = storage(layout, inout state);
                start_lifetime(out, inout state);
                vec.push(actual, out);
            }
            let status = runtime(name, "i64", actual, inout state);
            let join = e_stdlib_result_begin(instruction.type_id, status, inout state);
            if output {
                let layout = lower_type(payload_type, inout state);
                let payload = e_load(layout, out, inout state);
                let joined = e_stdlib_finish(join, payload, inout state);
                end_lifetime(out, inout state);
                return option.Option[Value].Some(joined);
            }
            let success = type_of(state, payload_type);
            if e_type_kind_is(success.kind, model.TypeKind.Unit) {
                let joined = e_stdlib_finish(join, Value(type_name: "i8",
                    reference: "0"), inout state);
                return option.Option[Value].Some(joined);
            }
            let layout = lower_type(payload_type, inout state);
            let cast = e_int_cast(status, layout, e_type_signed(success.kind),
                inout state);
            let joined = e_stdlib_finish(join, cast, inout state);
            return option.Option[Value].Some(joined);
        }
    }
}

func e_extra_fs_name(operation u32) string {
    switch operation {
        case 43: return "lang_sys_stat_v1";
        case 44: return "lang_sys_lstat_v1";
        case 45: return "lang_sys_fstat_v1";
        case 46: return "lang_sys_rename_v1";
        case 47: return "lang_sys_chmod_v1";
        case 48: return "lang_sys_fchmod_v1";
        case 49: return "lang_sys_chdir_v1";
        case 50: return "lang_sys_getcwd_vec_v1";
        case 51: return "lang_sys_getdents_vec_v1";
        case 52: return "lang_sys_readlink_vec_v1";
        case 53: return "lang_sys_symlink_v1";
        case 54: return "lang_sys_link_v1";
        case 55: return "lang_sys_truncate_v1";
        case 56: return "lang_sys_ftruncate_v1";
        case 57: return "lang_sys_fsync_v1";
        case 58: return "lang_sys_fdatasync_v1";
        case 59: return "lang_sys_dup_v1";
        case 60: return "lang_sys_dup2_v1";
        case 61: return "lang_sys_pipe_v1";
        case 62: return "lang_sys_mkfifo_v1";
        case 63: return "lang_sys_access_v1";
        case 64: return "lang_sys_getuid_v1";
        case 65: return "lang_sys_geteuid_v1";
        case 66: return "lang_sys_getgid_v1";
        case 67: return "lang_sys_getegid_v1";
        case 68: return "lang_sys_getppid_v1";
        case 69: return "lang_sys_gettid_v1";
        case 70: return "lang_sys_setpgid_v1";
        case 71: return "lang_sys_getpgid_v1";
        case 72: return "lang_sys_setsid_v1";
        case 73: return "lang_sys_kill_v1";
        case 74: return "lang_sys_clock_gettime_v1";
        case 75: return "lang_sys_nanosleep_vec_v1";
        case 76: return "lang_sys_getrandom_vec_v1";
        case 213: return "lang_sys_stat_v1";
        case 214: return "lang_sys_flock_v1";
        case 215: return "lang_sys_executable_path_vec_v1";
        default: return "";
    }
}

func e_extra_fs_output(operation u32) bool {
    return operation == 43 || operation == 44 || operation == 45 ||
        operation == 61 || operation == 74 || operation == 213;
}

func e_extra_fs_raw(operation u32) bool {
    return operation == 50 || operation == 51 || operation == 52 ||
        operation == 75 || operation == 76 || operation == 215;
}

func e_extra_fs_actual(operation u32, signature model.Type, args Vec[Value],
                       state inout Emitter) Vec[Value] throws Error {
    var actual Vec[Value] = [];
    for var index usize = 0; index < vec.len(args); index += 1 {
        let parameter = signature.parameters[index].type_id;
        let parameter_type = type_of(state, parameter);
        if e_type_kind_is(parameter_type.kind, model.TypeKind.String) {
            let pointer = e_text_pointer(args[index], inout state);
            let length = e_text_length(args[index], inout state);
            vec.push(actual, pointer);
            vec.push(actual, length);
        } else if e_type_kind_is(parameter_type.kind, model.TypeKind.Vec) && operation == 213 {
            // Only the byte-path stat expands a Vec into borrowed path bytes.
            // Field 5 is the element pointer and field 1 the current length.
            // These plain loads use the same descriptor layout without adding
            // a new TBAA dependency to the filesystem route; the five existing
            // buffer operations keep their descriptor ABI below.
            let data_base = result("ptr", "getelementptr inbounds " + VEC_TYPE +
                ", ptr " + args[index].reference + ", i32 0, i32 5", inout state);
            let data = result("ptr", "load ptr, ptr " + data_base.reference, inout state);
            let length_base = result("ptr", "getelementptr inbounds " + VEC_TYPE +
                ", ptr " + args[index].reference + ", i32 0, i32 1", inout state);
            let length = result("i64", "load i64, ptr " + length_base.reference, inout state);
            vec.push(actual, data);
            vec.push(actual, length);
        } else if e_type_kind_is(parameter_type.kind, model.TypeKind.Vec) {
            vec.push(actual, args[index]);
        } else if e_type_kind_is(parameter_type.kind, model.TypeKind.NominalStruct) {
            let address = element_storage(parameter, args[index], inout state);
            vec.push(actual, address);
        } else {
            vec.push(actual, args[index]);
        }
    }
    return actual;
}

