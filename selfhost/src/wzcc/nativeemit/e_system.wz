func e_num_name(operation u32) string {
    switch operation {
        case 77: return "lang_num_parse_i64_v1";
        case 78: return "lang_num_parse_u64_v1";
        case 79: return "lang_num_parse_f32_v1";
        case 80: return "lang_num_parse_f64_v1";
        case 81: return "lang_num_format_i64_v1";
        case 82: return "lang_num_format_u64_v1";
