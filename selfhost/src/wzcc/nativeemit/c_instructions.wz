package nativeemit;

import "app/wzcc/model" as model;
import "app/wzcc/nativeemit/core" as emitcore;
import "app/wzcc/nativeemit/debug" as emitdebug;
import "app/wzcc/nativeemit/systemops" as emitops;
import "app/wzcc/nativeemit/values" as emitvalues;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

// C: NativeIR instructions whose emission belongs to the value layer.
//
// Direct port of the value_ops/weak_ops/concurrency parts of
// src/backend/native/emit.cpp::instruction.  Storage, stride, checked index,
// vec fields/TBAA and guard belong to B; C resource calls belong to E; GC
// registration belongs to D.  Copy/Move/Take/Destroy/Borrow/Function,
// Vec/iterator, TraitObject/TraitCall are handled here.
//
// The contract fixes the return shape: ops owned by another group return
// Option.None, and an op handled here that produces no SSA result returns
// Some(i8 0) because language Unit is an ordinary i8 value.  B registers
// instruction.result afterwards; C never writes frame.values.


func c_native_slot_type(slot usize, state emitcore.Emitter) usize throws emitcore.Error {
    switch state.frame.native_index {
        case option.Option.None: {
            throw emitcore.invalid("instruction outside a source function");
        }
        case option.Option.Some(index): {
            if index >= vec.len(state.input.functions) {
                throw emitcore.invalid("source function index out of range");
            }
            if slot >= vec.len(state.input.functions[index].slots) {
                throw emitcore.invalid("native slot index out of range");
            }
            return state.input.functions[index].slots[slot].type_id;
        }
    }
}

func c_slot_iteration_length(slot usize, state emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let entry = emitvalues.c_slot_storage(slot, state);
    switch entry.iteration_length {
        case option.Option.Some(value): return value;
        case option.Option.None: throw emitcore.invalid("iteration slot has no length storage");
    }
}

func c_slot_iteration_index(slot usize, state emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let entry = emitvalues.c_slot_storage(slot, state);
    switch entry.iteration_index {
        case option.Option.Some(value): return value;
        case option.Option.None: throw emitcore.invalid("iteration slot has no index storage");
    }
}

// The preceding verified vec_check fixed the panic location.  Reuse the
// current Vec/Slice bounds-checking accessor for the address.
func c_emit_vec_check(vec_value emitcore.Value, index emitcore.Value, source model.Span,
                      state inout emitcore.Emitter) throws emitcore.Error {
    let length = emitcore.vec_field(vec_value, 1, "i64", inout state);
    let initialized = emitcore.vec_field(vec_value, 2, "i64", inout state);
    let past_length = emitvalues.c_icmp("uge", "i64", index.reference, length.reference,
        inout state);
    let past_initialized = emitvalues.c_icmp("uge", "i64", index.reference,
        initialized.reference, inout state);
    let bad = emitcore.result("i1", "or i1 " + past_length.reference + ", " +
        past_initialized.reference, inout state);
    emitcore.guard(bad, 4, source, inout state);
}

// Constant scalars need no element cleanup or runtime evaluation.  The table is
// copied once, then the fully initialized element count is published.
func c_constant_vec_init(target emitcore.Value, element usize, values Vec[emitcore.Value],
                         state inout emitcore.Emitter) throws emitcore.Error {
    let element_type = emitcore.lower_type(element, inout state);
    let count = vec.len(values);
    let array_type = "[" + emitcore.number(count) + " x " + element_type + "]";
    var members = vec.empty[string]();
    for value in values {
        vec.push(members, emitcore.typed(value));
    }
    let name = emitvalues.c_unique_name("vec.constants", state);
    let body = "private unnamed_addr constant [" + emitcore.number(count) + " x " +
        element_type + "] [" + text_join(members) + "]";
    let data = emitcore.define_global(name, body, inout state);
    let field = emitcore.vec_field(target, 5, "ptr", inout state);
    let bytes = emitcore.allocation_size(array_type);
    emitvalues.c_memcpy(field, data, bytes, inout state);
    let header = emitvalues.c_gep(VEC_TYPE, target, 2, inout state);
    let suffix = emitcore.vec_memory(true, inout state);
    emitcore.append("store i64 " + emitcore.number(count) + ", ptr " + header.reference + suffix,
        inout state);
}

func text_join(values Vec[string]) string {
    var out = "";
    for var index usize = 0; index < vec.len(values); index += 1 {
        if index != 0 {
            out += ", ";
        }
        out += values[index];
    }
    return out;
}

func c_constant_vec_element(type_id usize, state emitcore.Emitter) bool throws emitcore.Error {
    switch emitcore.type_of(state, type_id).kind {
        case model.TypeKind.Bool: return true;
        case model.TypeKind.SignedInt: return true;
        case model.TypeKind.UnsignedInt: return true;
        case model.TypeKind.Isize: return true;
        case model.TypeKind.Usize: return true;
        case model.TypeKind.Float: return true;
        default: return false;
    }
}

func c_emit_vec_init(instruction nativeir.Instruction, args Vec[emitcore.Value],
                     state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let init_type = emitcore.type_of(state, instruction.type_id);
    if vec.len(init_type.type_args) == 0 {
        throw emitcore.invalid("Vec initialization has no element type");
    }
    let element = init_type.type_args[0];
    var copy_op = emitvalues.c_null();
    var drop_op = emitvalues.c_null();
    if emitvalues.owning(element, inout state) {
        copy_op = emitvalues.value_op(element, true, inout state);
        drop_op = emitvalues.value_op(element, false, inout state);
    }
    let element_stride = emitcore.stride(element, inout state);
    let object = emitcore.runtime("lang_vec_new_v1", "ptr",
        [emitvalues.c_int("i64", vec.len(args)), element_stride, copy_op, drop_op], inout state);
    var constants = vec.len(args) != 0 && c_constant_vec_element(element, state);
    var constant_values = vec.empty[emitcore.Value]();
    for var index usize = 0; index < vec.len(args); index += 1 {
        switch emitcore.constant_value(state, instruction.inputs[index]) {
            case option.Option.Some(value): { vec.push(constant_values, value); }
            case option.Option.None: { constants = false; }
        }
    }
    if constants {
        c_constant_vec_init(object, element, constant_values, inout state);
        let registered = emitvalues.gc_register_vec(object, element, inout state);
        return object;
    }
    // The constructor's storage is fresh and every argument has already been
    // evaluated, so copy each element directly and publish the initialized
    // prefix one element at a time.  The scratch byte for Unit and other
    // zero-sized elements stays zero.  Ownership is already arranged by
    // NativeIR; no extra retain or drop belongs here.  This prefix only writes
    // stack scratch, element bytes, and the initialized count; it has no
    // callback or safepoint.  The Vec is not registered until the prefix is
    // complete, so no critical window is needed here.  This reasoning does not
    // extend to set/push/resize/clear.
    let data = emitcore.vec_field(object, 5, "ptr", inout state);
    for var index usize = 0; index < vec.len(args); index += 1 {
        let address = emitcore.element_storage(element, args[index], inout state);
        var target = data;
        if index != 0 {
            let offset = emitvalues.c_binop("mul", "i64", element_stride.reference,
                emitcore.number(index), inout state);
            target = emitcore.result("ptr", "getelementptr i8, ptr " + data.reference +
                ", i64 " + offset.reference, inout state);
        }
        emitvalues.c_memcpy(target, address, element_stride, inout state);
        let header = emitvalues.c_gep(VEC_TYPE, object, 2, inout state);
        let suffix = emitcore.vec_memory(true, inout state);
        emitcore.append("store i64 " + emitcore.number(index + 1) + ", ptr " + header.reference +
            suffix, inout state);
    }
    let registered = emitvalues.gc_register_vec(object, element, inout state);
    return object;
}

// Reuse the ordinary Vec read emission only for a concrete non-owning element
// whose LLVM allocation size equals the published runtime stride. The direct
// path repeats both the length and initialized-prefix guards; owned, empty and
// other layouts keep the runtime accessor and copy.
func c_vec_read_value(vec emitcore.Value, element_type usize, index emitcore.Value, source model.Span,
                      direct bool, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    if direct {
        c_emit_vec_check(vec, index, source, inout state);
        let data = emitcore.vec_field(vec, 5, "ptr", inout state);
        let element_type_name = emitcore.lower_type(element_type, inout state);
        let address = emitcore.result("ptr", "getelementptr " + element_type_name +
            ", ptr " + data.reference + ", i64 " + index.reference, inout state);
        return emitvalues.c_load_tagged(element_type_name, address, inout state);
    }
    let address = emitcore.runtime("lang_vec_at_v1", "ptr", [vec, index], inout state);
    let loaded_type = emitcore.lower_type(element_type, inout state);
    let loaded = emitvalues.c_load(loaded_type, address, inout state);
    return emitvalues.copy_value(element_type, loaded, inout state);
}

func c_direct_vec_element(type_id usize, state inout emitcore.Emitter) bool throws emitcore.Error {
    // stride() uses the LLVM allocation size except for empty layouts.
    return !emitvalues.owning(type_id, inout state) && !emitcore.b_empty_size_id(type_id, inout state);
}

func c_emit_vec_read(instruction nativeir.Instruction, args Vec[emitcore.Value],
                     state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let index_type = emitcore.value_type(state, instruction.inputs[1]);
    let index = emitcore.checked_index(args[1], index_type, instruction.source, 4,
        inout state);
    let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
    let receiver = emitcore.type_of(state, receiver_type);
    switch receiver.kind {
        case model.TypeKind.String: {
            let length = emitvalues.c_extract("i64", args[0], 2, inout state);
            let bad = emitvalues.c_icmp("uge", "i64", index.reference, length.reference,
                inout state);
            emitcore.guard(bad, 4, instruction.source, inout state);
            let address = emitvalues.value_address(receiver_type, args[0], inout state);
            return emitcore.runtime("lang_text_at_v1", "i32", [address, index], inout state);
        }
        default: {}
    }
    if vec.len(receiver.type_args) == 0 {
        throw emitcore.invalid("Vec read has no element type");
    }
    let element_type = receiver.type_args[0];
    switch receiver.kind {
        case model.TypeKind.Slice: {
            let slice_address = emitvalues.value_address(receiver_type, args[0], inout state);
            let address = emitcore.runtime("lang_slice_at_v1", "ptr",
                [slice_address, index], inout state);
            let element_layout = emitcore.lower_type(element_type, inout state);
            let loaded = emitvalues.c_load(element_layout, address, inout state);
            if emitvalues.owning(element_type, inout state) {
                return emitvalues.copy_value(instruction.type_id, loaded, inout state);
            }
            return loaded;
        }
        default: {}
    }
    let direct = !emitvalues.owning(element_type, inout state);
    return c_vec_read_value(args[0], element_type, index, instruction.source,
        direct, inout state);
}

func c_emit_vec_set(instruction nativeir.Instruction, args Vec[emitcore.Value],
                    state inout emitcore.Emitter) throws emitcore.Error {
    let index_type = emitcore.value_type(state, instruction.inputs[1]);
    let index = emitcore.checked_index(args[1], index_type, instruction.source, 4,
        inout state);
    let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
    let receiver = emitcore.type_of(state, receiver_type);
    let value_type_id = emitcore.value_type(state, instruction.inputs[2]);
    if vec.len(receiver.type_args) == 0 {
        throw emitcore.invalid("Vec set has no element type");
    }
    let element_type = receiver.type_args[0];
    switch receiver.kind {
        case model.TypeKind.Slice: {
            let slice_address = emitvalues.value_address(receiver_type, args[0], inout state);
            if !emitvalues.owning(element_type, inout state) {
                let target = emitcore.runtime("lang_slice_at_v1", "ptr",
                    [slice_address, index], inout state);
                emitvalues.c_store(args[2], target, inout state);
                return;
            }
            // Translate the relative index to the owner's absolute slot.  The
            // verified runtime setter drops the replaced element exactly once.
            let owner = emitvalues.c_extract("ptr", args[0], 0, inout state);
            let start = emitvalues.c_extract("i64", args[0], 1, inout state);
            let absolute = emitvalues.c_binop("add", "i64", start.reference, index.reference,
                inout state);
            let address = emitcore.element_storage(value_type_id, args[2], inout state);
            let ignored = emitcore.runtime("lang_vec_set_v1", "void",
                [owner, absolute, address], inout state);
            return;
        }
        default: {}
    }
    if !emitvalues.owning(element_type, inout state) {
        c_emit_vec_check(args[0], index, instruction.source, inout state);
        let data = emitcore.vec_field(args[0], 5, "ptr", inout state);
        let element_type_name = emitcore.lower_type(element_type, inout state);
        let address = emitcore.result("ptr", "getelementptr " + element_type_name +
            ", ptr " + data.reference + ", i64 " + index.reference, inout state);
        emitvalues.c_store_tagged(args[2], address, inout state);
        return;
    }
    let address = emitcore.element_storage(value_type_id, args[2], inout state);
    let ignored = emitcore.runtime("lang_vec_set_v1", "void", [args[0], index, address],
        inout state);
}

func c_emit_vec_slice(instruction nativeir.Instruction, args Vec[emitcore.Value],
                      state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    var position_index usize = 1;
    var start = emitvalues.c_int("i64", 0);
    if (instruction.bits & 1) != 0 {
        let start_type = emitcore.value_type(state, instruction.inputs[position_index]);
        start = emitcore.checked_index(args[position_index], start_type, instruction.source,
            9, inout state);
        position_index += 1;
    }
    let result_type = emitcore.type_of(state, instruction.type_id);
    var end = emitvalues.c_int("i64", 0);
    if (instruction.bits & 2) != 0 {
        let end_type = emitcore.value_type(state, instruction.inputs[position_index]);
        end = emitcore.checked_index(args[position_index], end_type, instruction.source, 9,
            inout state);
    } else {
        switch result_type.kind {
            case model.TypeKind.String: {
                end = emitvalues.c_extract("i64", args[0], 2, inout state);
            }
            case model.TypeKind.Slice: {
                end = emitvalues.c_int("i64", 0);
            }
            default: {
                end = emitcore.runtime("lang_vec_length_v1", "i64", [args[0]], inout state);
            }
        }
    }
    switch result_type.kind {
        case model.TypeKind.String: {
            let length = emitvalues.c_extract("i64", args[0], 2, inout state);
            let reversed = emitvalues.c_icmp("ugt", "i64", start.reference, end.reference,
                inout state);
            let past = emitvalues.c_icmp("ugt", "i64", end.reference, length.reference,
                inout state);
            let bad = emitcore.result("i1", "or i1 " + reversed.reference + ", " +
                past.reference, inout state);
            emitcore.guard(bad, 9, instruction.source, inout state);
            let layout = emitcore.lower_type(instruction.type_id, inout state);
            let out = emitcore.storage(layout, inout state);
            let address = emitvalues.value_address(instruction.type_id, args[0], inout state);
            let ignored = emitcore.runtime("lang_text_slice_v1", "void",
                [out, address, start, end], inout state);
            return emitvalues.c_load(layout, out, inout state);
        }
        case model.TypeKind.Slice: {
            let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
            let source_address = emitvalues.value_address(receiver_type, args[0], inout state);
            if (instruction.bits & 2) == 0 {
                end = emitcore.runtime("lang_slice_length_v1", "i64", [source_address],
                    inout state);
            }
            let layout = emitcore.lower_type(instruction.type_id, inout state);
            let out = emitcore.storage(layout, inout state);
            let ignored = emitcore.runtime("lang_slice_sub_v1", "void",
                [out, source_address, start, end], inout state);
            return emitvalues.c_load(layout, out, inout state);
        }
        default: {}
    }
    let sliced = emitcore.runtime("lang_vec_slice_v1", "ptr", [args[0], start, end],
        inout state);
    if vec.len(result_type.type_args) == 0 {
        throw emitcore.invalid("Vec slice has no element type");
    }
    let registered = emitvalues.gc_register_vec(sliced, result_type.type_args[0], inout state);
    return sliced;
}

func c_emit_iteration_begin(instruction nativeir.Instruction,
                            state inout emitcore.Emitter) throws emitcore.Error {
    let collection_type = c_native_slot_type(instruction.slot, state);
    let entry = emitvalues.c_slot_storage(instruction.slot, state);
    let length_address = c_slot_iteration_length(instruction.slot, state);
    let index_address = c_slot_iteration_index(instruction.slot, state);
    let collection_layout = emitcore.lower_type(collection_type, inout state);
    let collection = emitvalues.c_load(collection_layout, entry.address, inout state);
    let kind = emitcore.type_of(state, collection_type);
    var length = emitvalues.c_int("i64", 0);
    switch kind.kind {
        case model.TypeKind.String: {
            // The hidden index is a UTF-8 byte cursor, so the loop bound is
            // the checked byte length, not the scalar count.
            length = emitvalues.c_extract("i64", collection, 1, inout state);
        }
        case model.TypeKind.Slice: {
            // A Slice already owns an iteration pin for its whole lifetime.
            length = emitcore.runtime("lang_slice_length_v1", "i64", [entry.address],
                inout state);
        }
        default: {
            length = emitcore.runtime("lang_vec_begin_v1", "i64", [collection], inout state);
        }
    }
    emitvalues.c_store(length, length_address, inout state);
    emitvalues.c_store(emitvalues.c_int("i64", 0), index_address, inout state);
}

func c_emit_iteration_test(instruction nativeir.Instruction,
                           state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let length_address = c_slot_iteration_length(instruction.slot, state);
    let index_address = c_slot_iteration_index(instruction.slot, state);
    let length = emitvalues.c_load("i64", length_address, inout state);
    let index = emitvalues.c_load("i64", index_address, inout state);
    return emitvalues.c_icmp("ult", "i64", index.reference, length.reference, inout state);
}

func c_emit_iteration_read(instruction nativeir.Instruction, args Vec[emitcore.Value],
                           state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let collection_type = c_native_slot_type(instruction.slot, state);
    let entry = emitvalues.c_slot_storage(instruction.slot, state);
    let index_address = c_slot_iteration_index(instruction.slot, state);
    let index = emitvalues.c_load("i64", index_address, inout state);
    let kind = emitcore.type_of(state, collection_type);
    switch kind.kind {
        case model.TypeKind.String: {
            // Reading does not advance the byte cursor; next owns the step.
            // Reuse the same checked packed read as __woozy_text_cursor_read
            // instead of a second runtime call.
            let collection_layout = emitcore.lower_type(collection_type, inout state);
            let collection = emitvalues.c_load(collection_layout, entry.address, inout state);
            let packed = emitops.e_text_cursor_read_value(collection, index, entry.address,
                false, 0, inout state);
            let scalar = emitvalues.c_binop("lshr", "i64", packed.reference, "32",
                inout state);
            return emitcore.result("i32", "trunc i64 " + scalar.reference + " to i32",
                inout state);
        }
        case model.TypeKind.Slice: {
            let address = emitcore.runtime("lang_slice_at_v1", "ptr",
                [entry.address, index], inout state);
            let element_layout = emitcore.lower_type(instruction.type_id, inout state);
            let loaded = emitvalues.c_load(element_layout, address, inout state);
            return emitvalues.copy_value(instruction.type_id, loaded, inout state);
        }
        default: {}
    }
    if vec.len(kind.type_args) == 0 {
        throw emitcore.invalid("Vec iteration has no element type");
    }
    let element_type = kind.type_args[0];
    let collection = emitvalues.c_load("ptr", entry.address, inout state);
    let direct = c_direct_vec_element(element_type, inout state);
    return c_vec_read_value(collection, element_type, index, instruction.source,
        direct, inout state);
}

func c_emit_trait_object(instruction nativeir.Instruction, args Vec[emitcore.Value],
                         state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let concrete = emitcore.value_type(state, instruction.inputs[0]);
    let concrete_type = emitcore.type_of(state, concrete);
    switch concrete_type.kind {
        case model.TypeKind.TraitObject: {
            throw emitcore.invalid("trait object constructor received another trait object");
        }
        default: {}
    }
    var copy_op = emitvalues.c_null();
    var drop_op = emitvalues.c_null();
    if emitvalues.owning(concrete, inout state) {
        copy_op = emitvalues.value_op(concrete, true, inout state);
        drop_op = emitvalues.value_op(concrete, false, inout state);
    }
    let element_stride = emitcore.stride(concrete, inout state);
    let object = emitcore.runtime("lang_vec_new_v1", "ptr",
        [emitvalues.c_int("i64", 1), element_stride, copy_op, drop_op], inout state);
    let address = emitcore.element_storage(concrete, args[0], inout state);
    let initialized = emitcore.runtime("lang_vec_init_v1", "void", [object, address],
        inout state);
    if emitvalues.owning(concrete, inout state) {
        let element = emitcore.runtime("lang_vec_at_v1", "ptr",
            [object, emitvalues.c_int("i64", 0)], inout state);
        let copy_operation = emitvalues.value_op(concrete, true, inout state);
        let copied = emitvalues.c_call(copy_operation, [element], "void", inout state);
    }
    let registered = emitvalues.gc_register_vec(object, concrete, inout state);
    let data = emitcore.runtime("lang_vec_at_v1", "ptr", [object, emitvalues.c_int("i64", 0)],
        inout state);
    let table = emitvalues.trait_vtable(instruction.type_id, concrete, instruction.methods,
        inout state);
    let fat = emitcore.Value(type_name: DYN_TYPE, reference: "undef");
    let with_data = emitvalues.c_insert(DYN_TYPE, fat, data, 0, inout state);
    return emitvalues.c_insert(DYN_TYPE, with_data, table, 1, inout state);
}

func c_emit_trait_call(instruction nativeir.Instruction, args Vec[emitcore.Value],
                       state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
    let receiver = emitcore.type_of(state, receiver_type);
    switch receiver.kind {
        case model.TypeKind.TraitObject: {}
        default: throw emitcore.invalid("trait call receiver is not a trait object");
    }
    let data = emitvalues.c_extract("ptr", args[0], 0, inout state);
    let table = emitvalues.c_extract("ptr", args[0], 1, inout state);
    let offset = instruction.bits + 2;
    let slot = emitcore.result("ptr", "getelementptr ptr, ptr " + table.reference +
        ", i64 " + emitcore.number(usize(offset)), inout state);
    let code = emitvalues.c_load("ptr", slot, inout state);
    let abi = emitcore.type_of(state, instruction.signature);
    var abi_invalid = false;
    switch abi.kind {
        case model.TypeKind.Function: {}
        default: { abi_invalid = true; }
    }
    switch abi.throws_type {
        case option.Option.Some(throws_type): { abi_invalid = true; }
        case option.Option.None: {}
    }
    if abi_invalid {
        throw emitcore.invalid("trait call ABI is not a nonthrowing function");
    }
    var actual = vec.empty[emitcore.Value]();
    vec.push(actual, data);
    for var index usize = 1; index < vec.len(args); index += 1 {
        vec.push(actual, args[index]);
    }
    let result_type = emitcore.lower_type(abi.result, inout state);
    return emitvalues.c_call(code, actual, result_type, inout state);
}

func emit_value_instruction(instruction nativeir.Instruction, args Vec[emitcore.Value],
                            state inout emitcore.Emitter) option.Option[emitcore.Value] throws emitcore.Error {
    switch instruction.op {
        case nativeir.Op.Copy: {
            let value = emitvalues.c_argument(args, 0);
            return option.Option[emitcore.Value].Some(
                emitvalues.copy_value(instruction.type_id, value, inout state));
        }
        case nativeir.Op.Borrow: {
            return option.Option[emitcore.Value].Some(emitvalues.c_argument(args, 0));
        }
        case nativeir.Op.Move: {
            let entry = emitvalues.c_slot_storage(instruction.slot, state);
            let layout = emitcore.lower_type(instruction.type_id, inout state);
            let value = emitvalues.c_load(layout, entry.address, inout state);
            switch entry.active {
                case option.Option.Some(active): {
                    emitvalues.c_store(emitvalues.c_false(), active, inout state);
                }
                case option.Option.None: {}
            }
            if state.options.debug_info { emitdebug.debug_unavailable(instruction.slot, inout state); }
            return option.Option[emitcore.Value].Some(value);
        }
        case nativeir.Op.Take: {
            let entry = emitvalues.c_slot_storage(instruction.slot, state);
            switch entry.active {
                case option.Option.Some(active): {
                    emitvalues.c_store(emitvalues.c_false(), active, inout state);
                }
                case option.Option.None: {
                    throw emitcore.invalid("take of a slot without an active flag");
                }
            }
            if state.options.debug_info { emitdebug.debug_unavailable(instruction.slot, inout state); }
            return emitvalues.c_none_result();
        }
        case nativeir.Op.Destroy: {
            let slot_type = c_native_slot_type(instruction.slot, state);
            emitvalues.destroy_slot(instruction.slot, slot_type, inout state);
            if state.options.debug_info { emitdebug.debug_unavailable(instruction.slot, inout state); }
            return emitvalues.c_none_result();
        }
        case nativeir.Op.Function: {
            return option.Option[emitcore.Value].Some(
                emitvalues.function_value(instruction, args, inout state));
        }
        case nativeir.Op.VecInit: {
            return option.Option[emitcore.Value].Some(
                c_emit_vec_init(instruction, args, inout state));
        }
        case nativeir.Op.VecLength: {
            let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
            let receiver = emitcore.type_of(state, receiver_type);
            switch receiver.kind {
                case model.TypeKind.String: {
                    let length = emitvalues.c_extract("i64", emitvalues.c_argument(args, 0), 2,
                        inout state);
                    return option.Option[emitcore.Value].Some(length);
                }
                default: {
                    let length = emitcore.vec_field(emitvalues.c_argument(args, 0), 1, "i64",
                        inout state);
                    return option.Option[emitcore.Value].Some(length);
                }
            }
        }
        case nativeir.Op.VecCheck: {
            let index_type = emitcore.value_type(state, instruction.inputs[1]);
            let index = emitcore.checked_index(emitvalues.c_argument(args, 1), index_type,
                instruction.source, 4, inout state);
            let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
            let receiver = emitcore.type_of(state, receiver_type);
            switch receiver.kind {
                case model.TypeKind.Slice: {
                    let address = emitvalues.value_address(receiver_type, emitvalues.c_argument(args, 0),
                        inout state);
                    let length = emitcore.runtime("lang_slice_length_v1", "i64", [address],
                        inout state);
                    let bad = emitvalues.c_icmp("uge", "i64", index.reference,
                        length.reference, inout state);
                    emitcore.guard(bad, 4, instruction.source, inout state);
                }
                default: {
                    c_emit_vec_check(emitvalues.c_argument(args, 0), index,
                        instruction.source, inout state);
                }
            }
            return emitvalues.c_none_result();
        }
        case nativeir.Op.VecRead: {
            return option.Option[emitcore.Value].Some(
                c_emit_vec_read(instruction, args, inout state));
        }
        case nativeir.Op.VecSet: {
            c_emit_vec_set(instruction, args, inout state);
            return emitvalues.c_none_result();
        }
        case nativeir.Op.VecSlice: {
            return option.Option[emitcore.Value].Some(
                c_emit_vec_slice(instruction, args, inout state));
        }
        case nativeir.Op.VecElementAddress: {
            let index_type = emitcore.value_type(state, instruction.inputs[1]);
            let index = emitcore.checked_index(emitvalues.c_argument(args, 1), index_type,
                instruction.source, 4, inout state);
            let receiver_type = emitcore.value_type(state, instruction.inputs[0]);
            let receiver = emitcore.type_of(state, receiver_type);
            switch receiver.kind {
                case model.TypeKind.Slice: {
                    let address = emitvalues.value_address(receiver_type, emitvalues.c_argument(args, 0),
                        inout state);
                    let element = emitcore.runtime("lang_slice_at_v1", "ptr",
                        [address, index], inout state);
                    return option.Option[emitcore.Value].Some(element);
                }
                default: {
                    // The preceding check fixed the bounds and Panic point.
                    // An empty element uses a stride of one, not a typed GEP.
                    if state.reuse_vec_address_check &&
                        !emitvalues.owning(instruction.type_id, inout state) &&
                        !emitcore.b_empty_size_id(instruction.type_id, inout state) {
                        let data = emitcore.vec_field(emitvalues.c_argument(args, 0), 5, "ptr", inout state);
                        let layout = emitcore.lower_type(instruction.type_id, inout state);
                        let address = emitcore.result("ptr", "getelementptr " + layout +
                            ", ptr " + data.reference + ", i64 " + index.reference,
                            inout state);
                        return option.Option[emitcore.Value].Some(address);
                    }
                    let element = emitcore.runtime("lang_vec_at_v1", "ptr",
                        [emitvalues.c_argument(args, 0), index], inout state);
                    return option.Option[emitcore.Value].Some(element);
                }
            }
        }
        case nativeir.Op.IterationBegin: {
            c_emit_iteration_begin(instruction, inout state);
            return emitvalues.c_none_result();
        }
        case nativeir.Op.IterationEnd: {
            let collection_type = c_native_slot_type(instruction.slot, state);
            let entry = emitvalues.c_slot_storage(instruction.slot, state);
            let kind = emitcore.type_of(state, collection_type);
            switch kind.kind {
                case model.TypeKind.Vec: {
                    let collection = emitvalues.c_load("ptr", entry.address, inout state);
                    let ignored = emitcore.runtime("lang_vec_end_v1", "void", [collection],
                        inout state);
                }
                // A Slice already owns an iteration pin for its whole lifetime;
                // the loop adds no second pin and has nothing to end here.
                default: {}
            }
            return emitvalues.c_none_result();
        }
        case nativeir.Op.IterationTest: {
            let more = c_emit_iteration_test(instruction, inout state);
            return option.Option[emitcore.Value].Some(more);
        }
        case nativeir.Op.IterationNext: {
            let index_address = c_slot_iteration_index(instruction.slot, state);
            let index = emitvalues.c_load("i64", index_address, inout state);
            let collection_type = c_native_slot_type(instruction.slot, state);
            let kind = emitcore.type_of(state, collection_type);
            var width = emitvalues.c_int("i64", 1);
            switch kind.kind {
                case model.TypeKind.String: {
                    // The hidden index is a byte offset for a String loop.
                    // Derive the width from the checked UTF-8 lead byte; next
                    // must not depend on a read having cached a width.
                    let entry = emitvalues.c_slot_storage(instruction.slot, state);
                    let collection_layout = emitcore.lower_type(collection_type, inout state);
                    let collection = emitvalues.c_load(collection_layout, entry.address,
                        inout state);
                    let bytes = emitvalues.c_extract("i64", collection, 1, inout state);
                    let scalars = emitvalues.c_extract("i64", collection, 2, inout state);
                    let data = emitvalues.c_extract("ptr", collection, 0, inout state);
                    // A finished or untested next still advances without a
                    // read outside the string's byte range.
                    let function_index = emitcore.current_function(state);
                    let before = emitcore.here(state);
                    let inside = emitcore.new_block(function_index, "text.iter.next.read", inout state);
                    let done = emitcore.new_block(function_index, "text.iter.next.done", inout state);
                    let bounded = emitvalues.c_icmp("ult", "i64", index.reference, bytes.reference, inout state);
                    let nonascii = emitvalues.c_icmp("ne", "i64", bytes.reference, scalars.reference, inout state);
                    let needs_width = emitvalues.c_binop("and", "i1", bounded.reference, nonascii.reference, inout state);
                    emitvalues.c_cond_branch(needs_width, inside, done, inout state);
                    emitcore.position(inside, inout state);
                    let address = emitcore.result("ptr", "getelementptr i8, ptr " +
                        data.reference + ", i64 " + index.reference, inout state);
                    let byte = emitvalues.c_load("i8", address, inout state);
                    let ascii = emitvalues.c_icmp("ult", "i8", byte.reference,
                        emitvalues.c_int("i8", 128).reference, inout state);
                    let two = emitvalues.c_icmp("ult", "i8", byte.reference,
                        emitvalues.c_int("i8", 224).reference, inout state);
                    let three = emitvalues.c_icmp("ult", "i8", byte.reference,
                        emitvalues.c_int("i8", 240).reference, inout state);
                    let tail = emitcore.result("i64", "select i1 " + three.reference +
                        ", i64 3, i64 4", inout state);
                    let middle = emitcore.result("i64", "select i1 " + two.reference +
                        ", i64 2, i64 " + tail.reference, inout state);
                    let step = emitcore.result("i64", "select i1 " + ascii.reference +
                        ", i64 1, i64 " + middle.reference, inout state);
                    emitvalues.c_branch(done, inout state);
                    emitcore.position(done, inout state);
                    width = emitcore.result("i64", "phi i64 [ 1, " + before.reference +
                        " ], [ " + step.reference + ", " + inside.reference + " ]",
                        inout state);
                }
                default: {}
            }
            let next = emitvalues.c_binop("add", "i64", index.reference, width.reference,
                inout state);
            emitvalues.c_store(next, index_address, inout state);
            return emitvalues.c_none_result();
        }
        case nativeir.Op.IterationRead: {
            return option.Option[emitcore.Value].Some(
                c_emit_iteration_read(instruction, args, inout state));
        }
        case nativeir.Op.TraitObject: {
            return option.Option[emitcore.Value].Some(
                c_emit_trait_object(instruction, args, inout state));
        }
        case nativeir.Op.TraitCall: {
            return option.Option[emitcore.Value].Some(
                c_emit_trait_call(instruction, args, inout state));
        }
        default: return option.Option[emitcore.Value].None;
    }
}
