package nativeemit;

import "app/wzcc/model" as model;
import "app/wzcc/nativeadapter" as nativeadapter;
import "std/option" as option;
import "std/vec" as vec;

pub func e_adapter_symbol(callable u32) string {
    return nativeadapter.e_adapter_symbol(callable);
}

pub func e_release_symbol(c_type u32) string {
    return nativeadapter.e_release_symbol(c_type);
}

pub func e_retain_symbol(c_type u32) string {
    return nativeadapter.e_retain_symbol(c_type);
}

pub func e_callback_bridge_symbol(function usize, c_type u32) string {
    return nativeadapter.e_callback_bridge_symbol(function, c_type);
}

pub func e_callback_trampoline_symbol(function usize, c_type u32) string {
    return nativeadapter.e_callback_trampoline_symbol(function, c_type);
}

pub func e_registration_callback_trampoline_symbol(c_type u32, userdata usize) string {
    return nativeadapter.e_registration_callback_trampoline_symbol(c_type, userdata);
}

pub func e_registration_callback_dispatch_symbol(c_type u32, userdata usize) string {
    return nativeadapter.e_registration_callback_dispatch_symbol(c_type, userdata);
}

pub func e_registration_unregister_symbol(c_type u32) string {
    return nativeadapter.e_registration_unregister_symbol(c_type);
}

func e_unit_pointer(ref model.CTypeRef) bool {
    return nativeadapter.e_unit_pointer(ref);
}

func adapter_error(error nativeadapter.Error) Error {
    switch error { case nativeadapter.Error.Failure(code, kind, message):
        return Error.Failure(code, kind, message); }
}

pub func finalize_c_adapter(state inout Emitter) throws Error {
    let project = state.input.hir.resolved.project;
    for id in state.e.used_callables {
        let callable = e_c_callable(project, id);
        switch e_registration_callback_checked(project, callable) {
            case option.Option.Some(mapping): {
                let ignored = registration_dispatcher(mapping.callback_type,
                    mapping.callback_userdata_parameter, inout state);
            }
            case option.Option.None: {}
        }
    }
    let callbacks = vec.empty[nativeadapter.UsedCallback]();
    for item in state.e.used_callbacks {
        vec.push(callbacks, nativeadapter.UsedCallback(symbol: item.symbol, c_type: item.c_type));
    }
    var adapter = nativeadapter.AdapterState(project: project, used_callables: state.e.used_callables,
        used_resources: state.e.used_resources, used_callbacks: callbacks, adapter_source: "");
    try { nativeadapter.finalize_c_adapter(inout adapter); }
    catch error nativeadapter.Error { throw adapter_error(error); }
    state.e.adapter_source = adapter.adapter_source;
}
