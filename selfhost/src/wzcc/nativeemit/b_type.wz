// B: scalar type spelling, exact signatures, storage primitives and the
// cross-group lookup helpers.  This is the pure-Wz counterpart of the
// type/layout/guard/binary/convert/vec_memory region of
// src/backend/native/emit.cpp plus value_ops.inc's storage helpers.
//
// Aggregate layout is never re-implemented here: every fields/field_index/
// variant_index/declaration query goes through the nativelayout package and
// the private types.Context stored in Emitter.storage_types is written back
// after each inout request.
package nativeemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/nativelayout" as nativelayout;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/strconv" as strconv;
import "std/text" as text;
import "std/vec" as vec;

// ---- error conversion -------------------------------------------------------

func b_unsupported(message string) Error {
    return Error.Failure("E_CAPABILITY_UNAVAILABLE", model.FailureKind.Unsupported,
        message);
}

func b_support_error(value model.SupportError) Error {
    switch value {
        case model.SupportError.Invalid(message): return invalid(message);
        case model.SupportError.Limit(message): return invalid(message);
    }
}

func b_type_error(value types.Error) Error {
    switch value {
        case types.Error.Invalid(message): return invalid(message);
    }
}

// ---- canonical constant spelling -------------------------------------------

// LLVM integer literals are signless; print the signed decimal form the LLVM
// writer emits.  Values are already reduced modulo the type width, so this is
// exact for every width and never needs a lossy cast.
func b_signed_bits_text(bits u64) string {
    if bits <= 9223372036854775807 {
        return strconv.format_u64(bits);
    }
    return "-" + strconv.format_u64(u64(0) - bits);
}

func b_integer_literal(bits u64, width u32) string {
    if width == 1 {
        if bits == 0 {
            return "false";
        }
        return "true";
    }
    if width >= 64 {
        return b_signed_bits_text(bits);
    }
    let modulus = u64(1) << u64(width);
    let half = modulus >> 1;
    if bits >= half {
        return "-" + strconv.format_u64(modulus - bits);
    }
    return strconv.format_u64(bits);
}

// Exact float constants: the bit pattern is spelled through an integer
// bitcast, so NaN payloads, subnormals and negative zero keep their exact
// bits instead of depending on decimal conversion.
func b_float_value(bits u64, width u32) Value {
    if width == 32 {
        return Value(type_name: "float", reference: "bitcast (i32 " +
            strconv.format_u64(bits & 4294967295) + " to float)");
    }
    return Value(type_name: "double", reference: "bitcast (i64 " +
        strconv.format_u64(bits) + " to double)");
}

// Recover the exact bits of a canonical b_float_value spelling.  Used only for
// the pure fneg-of-constant case that the Vec constant table recognizes.
func b_float_bits_of(reference string) option.Option[u64] {
    let parts = text.split(reference, " ");
    if vec.len(parts) != 5 {
        return option.Option[u64].None;
    }
    if parts[0] != "bitcast" {
        return option.Option[u64].None;
    }
    if parts[1] != "(i32" && parts[1] != "(i64" {
        return option.Option[u64].None;
    }
    try { return option.Option[u64].Some(strconv.parse_u64(parts[2])); }
    catch error strconv.Error {
        return option.Option[u64].None;
    }
}

func b_float_pow2(power u32, negative bool, width u32) Value {
    var bits u64 = 0;
    if width == 32 {
        bits = (u64(power) + 127) << 23;
        if negative {
            bits = bits | 2147483648;
        }
        return b_float_value(bits, 32);
    }
    bits = (u64(power) + 1023) << 52;
    if negative {
        bits = bits | 9223372036854775808;
    }
    return b_float_value(bits, 64);
}

// ---- type table access ------------------------------------------------------

func type_of(state Emitter, type_id usize) model.Type throws Error {
    switch types.find(state.storage_types, type_id) {
        case option.Option.Some(value): return value;
        case option.Option.None: throw invalid("invalid type reference");
    }
}

func b_field_of(value hir.FieldDecl) usize {
    return value.type_id;
}

func aggregate_declaration(state Emitter, type_id usize) hir.NominalDecl throws Error {
    let aggregates = nativelayout.AggregateTypes(module: state.input.hir,
        context: state.storage_types);
    try { return nativelayout.declaration(aggregates, type_id); }
    catch error model.SupportError { throw b_support_error(error); }
}

func aggregate_fields(type_id usize, variant option.Option[usize],
                      state inout Emitter) Vec[hir.FieldDecl] throws Error {
    var aggregates = nativelayout.AggregateTypes(module: state.input.hir,
        context: state.storage_types);
    var fields = vec.empty[hir.FieldDecl]();
    try { fields = nativelayout.fields(inout aggregates, type_id, variant); }
    catch error model.SupportError { throw b_support_error(error); }
    state.storage_types = aggregates.context;
    return fields;
}

func field_index(type_id usize, field usize, variant option.Option[usize],
                 state inout Emitter) usize throws Error {
    var aggregates = nativelayout.AggregateTypes(module: state.input.hir,
        context: state.storage_types);
    var index usize = 0;
    try { index = nativelayout.field_index(inout aggregates, type_id, field, variant); }
    catch error model.SupportError { throw b_support_error(error); }
    state.storage_types = aggregates.context;
    return index;
}

func variant_index(state Emitter, type_id usize, variant usize) usize throws Error {
    let aggregates = nativelayout.AggregateTypes(module: state.input.hir,
        context: state.storage_types);
    try { return nativelayout.variant_index(aggregates, type_id, variant); }
    catch error model.SupportError { throw b_support_error(error); }
}

func b_integer_width(state Emitter, type_id usize) u32 throws Error {
    let value = type_of(state, type_id);
    try { return types.bit_width(value, state.input.hir.config); }
    catch error types.Error { throw b_type_error(error); }
}

func b_signed(value model.Type) bool {
    return b_kind_is(value.kind, model.TypeKind.SignedInt) ||
        b_kind_is(value.kind, model.TypeKind.Isize);
}

func b_kind_is(kind model.TypeKind, expected model.TypeKind) bool {
    return model.type_kind_id(kind) == model.type_kind_id(expected);
}

func b_inout_mode(mode model.ParamMode) bool {
    switch mode {
        case model.ParamMode.Inout: return true;
        default: return false;
    }
}

func b_type_arg(value model.Type, index usize) usize throws Error {
    if index >= vec.len(value.type_args) {
        throw invalid("missing type argument");
    }
    return value.type_args[index];
}

func b_throws_type(state Emitter, value model.Type) usize throws Error {
    switch value.throws_type {
        case option.Option.Some(item): return item;
        case option.Option.None: throw invalid("missing throws type");
    }
}

// ---- lower_type -------------------------------------------------------------

func b_struct_body(type_id usize, state inout Emitter) string throws Error {
    let fields = aggregate_fields(type_id, option.Option[usize].None, inout state);
    if vec.len(fields) == 0 {
        return "{}";
    }
    var parts = vec.empty[string]();
    for field in fields {
        vec.push(parts, lower_type(b_field_of(field), inout state));
    }
    return "{ " + text.join(parts, ", ") + " }";
}

func b_enum_body(type_id usize, state inout Emitter) string throws Error {
    let declaration = aggregate_declaration(state, type_id);
    var body = "{ i32";
    for variant in declaration.variants {
        let fields = aggregate_fields(type_id,
            option.Option[usize].Some(variant.symbol), inout state);
        if vec.len(fields) == 0 {
            body += ", {}";
        } else {
            var parts = vec.empty[string]();
            for field in fields {
                vec.push(parts, lower_type(b_field_of(field), inout state));
            }
            body += ", { " + text.join(parts, ", ") + " }";
        }
    }
    return body + " }";
}

func lower_type(type_id usize, state inout Emitter) string throws Error {
    for layout in state.b.layouts {
        if layout.type_id == type_id {
            return layout.type_name;
        }
    }
    let value = type_of(state, type_id);
    var name = "";
    switch value.kind {
        case model.TypeKind.Unit: name = "i8";
        case model.TypeKind.Bool: name = "i1";
        case model.TypeKind.SignedInt: {
            name = "i" + number(usize(b_integer_width(state, type_id)));
        }
        case model.TypeKind.UnsignedInt: {
            name = "i" + number(usize(b_integer_width(state, type_id)));
        }
        case model.TypeKind.Isize: {
            name = "i" + number(usize(b_integer_width(state, type_id)));
        }
        case model.TypeKind.Usize: {
            name = "i" + number(usize(b_integer_width(state, type_id)));
        }
        case model.TypeKind.Float: {
            name = "double";
            if value.bits == 32 {
                name = "float";
            }
        }
        case model.TypeKind.Function: name = FN_TYPE;
        case model.TypeKind.Weak: name = WEAK_TYPE;
        case model.TypeKind.TraitObject: name = DYN_TYPE;
        case model.TypeKind.Vec: name = "ptr";
        case model.TypeKind.ThreadHandle: name = "ptr";
        case model.TypeKind.MutexHandle: name = "ptr";
        case model.TypeKind.CondvarHandle: name = "ptr";
        case model.TypeKind.AtomicI64Handle: name = "ptr";
        case model.TypeKind.IpcHandle: name = "ptr";
        case model.TypeKind.Task: name = "ptr";
        case model.TypeKind.String: name = "{ ptr, i64, i64, ptr }";
        case model.TypeKind.Slice: name = SLICE_TYPE;
        case model.TypeKind.CForeignPointer: name = c_lower_type(type_id, inout state);
        case model.TypeKind.CForeignBuffer: name = c_lower_type(type_id, inout state);
        case model.TypeKind.CForeignRecord: name = c_lower_type(type_id, inout state);
        case model.TypeKind.CForeignResource: name = c_lower_type(type_id, inout state);
        case model.TypeKind.CForeignCallback: name = c_lower_type(type_id, inout state);
        case model.TypeKind.CForeignOpaque: name = c_lower_type(type_id, inout state);
        case model.TypeKind.NominalStruct: {
            let body = b_struct_body(type_id, inout state);
            name = define_type("value." + number(type_id), body, inout state);
        }
        case model.TypeKind.NominalEnum: {
            let body = b_enum_body(type_id, inout state);
            name = define_type("value." + number(type_id), body, inout state);
        }
        default: throw b_unsupported("native scalar type is not implemented");
    }
    vec.push(state.b.layouts, TypeLayout(type_id: type_id, type_name: name));
    return name;
}

// ---- type_key ---------------------------------------------------------------

func b_nominal_key(state Emitter, value model.Type, prefix string) string throws Error {
    let resolved = state.input.hir.resolved;
    if value.declaration >= vec.len(resolved.symbols) {
        throw invalid("invalid type declaration symbol");
    }
    let symbol = resolved.symbols[value.declaration];
    if symbol.module >= vec.len(resolved.project.modules) {
        throw invalid("invalid type symbol module");
    }
    var key = prefix + resolved.project.modules[symbol.module].logical_path +
        "." + symbol.name;
    if vec.len(value.type_args) != 0 {
        key += "[";
        for var index usize = 0; index < vec.len(value.type_args); index += 1 {
            if index != 0 {
                key += ",";
            }
            key += type_key(state, value.type_args[index]);
        }
        key += "]";
    }
    return key;
}

func b_function_key(state Emitter, value model.Type) string throws Error {
    var key = "func(";
    for var index usize = 0; index < vec.len(value.parameters); index += 1 {
        if index != 0 {
            key += ",";
        }
        let parameter = value.parameters[index];
        if b_inout_mode(parameter.mode) {
            key += "inout ";
        }
        key += type_key(state, parameter.type_id);
    }
    key += ")->(" + type_key(state, value.result) + ")";
    switch value.throws_type {
        case option.Option.Some(item): {
            key += " throws(" + type_key(state, item) + ")";
        }
        case option.Option.None: {}
    }
    return key;
}

func type_key(state Emitter, type_id usize) string throws Error {
    let value = type_of(state, type_id);
    switch value.kind {
        case model.TypeKind.Unit: return "Unit";
        case model.TypeKind.Bool: return "bool";
        case model.TypeKind.String: return "string";
        case model.TypeKind.Isize: return "isize";
        case model.TypeKind.Usize: return "usize";
        case model.TypeKind.SignedInt: return "i" + number(usize(value.bits));
        case model.TypeKind.UnsignedInt: return "u" + number(usize(value.bits));
        case model.TypeKind.Float: return "f" + number(usize(value.bits));
        case model.TypeKind.NominalStruct: return b_nominal_key(state, value, "");
        case model.TypeKind.NominalEnum: return b_nominal_key(state, value, "");
        case model.TypeKind.ThreadHandle: return "std/thread.Thread";
        case model.TypeKind.MutexHandle: return "std/sync.Mutex";
        case model.TypeKind.CondvarHandle: return "std/sync.Condvar";
        case model.TypeKind.AtomicI64Handle: return "std/sync.AtomicI64";
        case model.TypeKind.IpcHandle: return "std/ipc.Handle";
        case model.TypeKind.Vec: {
            return "Vec[" + type_key(state, b_type_arg(value, 0)) + "]";
        }
        case model.TypeKind.Slice: {
            return "Slice[" + type_key(state, b_type_arg(value, 0)) + "]";
        }
        case model.TypeKind.Weak: {
            return "Weak[" + type_key(state, b_type_arg(value, 0)) + "]";
        }
        case model.TypeKind.TraitObject: return b_nominal_key(state, value, "dyn ");
        case model.TypeKind.Function: return b_function_key(state, value);
        default: throw invalid("non-concrete entry error type");
    }
}

// ---- signature --------------------------------------------------------------

func signature(type_id usize, env_first bool, skip_first_parameter bool,
               state inout Emitter) Signature throws Error {
    let value = type_of(state, type_id);
    var parameters = vec.empty[string]();
    if env_first {
        vec.push(parameters, "ptr");
    }
    var index usize = 0;
    if skip_first_parameter {
        index = 1;
    }
    for index < vec.len(value.parameters) {
        let parameter = value.parameters[index];
        if b_inout_mode(parameter.mode) {
            vec.push(parameters, "ptr");
        } else {
            vec.push(parameters, lower_type(parameter.type_id, inout state));
        }
        index += 1;
    }
    var result = "";
    switch value.throws_type {
        case option.Option.Some(item): {
            let payload = type_of(state, value.result);
            if !b_kind_is(payload.kind, model.TypeKind.Unit) {
                vec.push(parameters, "ptr");
            }
            vec.push(parameters, "ptr");
            result = "i1";
        }
        case option.Option.None: result = lower_type(value.result, inout state);
    }
    return Signature(result: result, parameters: parameters);
}

// ---- function / value lookup ------------------------------------------------

func find_hir_function(state Emitter, symbol usize) option.Option[hir.HirFunction] {
    for function in state.input.hir.functions {
        if function.symbol == symbol {
            return option.Option[hir.HirFunction].Some(function);
        }
    }
    return option.Option[hir.HirFunction].None;
}

func b_hir_index(state Emitter, symbol usize) option.Option[usize] {
    for var index usize = 0; index < vec.len(state.input.hir.functions); index += 1 {
        if state.input.hir.functions[index].symbol == symbol {
            return option.Option[usize].Some(index);
        }
    }
    return option.Option[usize].None;
}

func b_capturing(state Emitter, symbol usize) bool {
    switch find_hir_function(state, symbol) {
        case option.Option.Some(value): return vec.len(value.captures) != 0;
        case option.Option.None: return false;
    }
}

func source_function(state Emitter, symbol usize) SourceFunction throws Error {
    for function in state.b.source_functions {
        if function.symbol == symbol {
            return function;
        }
    }
    throw invalid("missing source function " + number(symbol));
}

func b_native_function(state Emitter, native_index usize) nativeir.Function throws Error {
    if native_index >= vec.len(state.input.functions) {
        throw invalid("source function index out of range");
    }
    return state.input.functions[native_index];
}

func b_source_by_native(state Emitter, native_index usize) SourceFunction throws Error {
    for function in state.b.source_functions {
        if function.native_index == native_index {
            return function;
        }
    }
    throw invalid("missing source function record");
}

func b_async_symbol(state Emitter, symbol usize) option.Option[AsyncSymbols] {
    for entry in state.d.async_symbols {
        if entry.symbol == symbol {
            return option.Option[AsyncSymbols].Some(entry);
        }
    }
    return option.Option[AsyncSymbols].None;
}

func call_target(state Emitter, symbol usize) Value throws Error {
    switch b_async_symbol(state, symbol) {
        case option.Option.Some(entry): return entry.start;
        case option.Option.None: {}
    }
    return source_function(state, symbol).code;
}

func b_value_binding(state Emitter, value_id usize) ValueBinding throws Error {
    for binding in state.frame.values {
        if binding.value_id == value_id {
            return binding;
        }
    }
    throw invalid("missing emitted value " + number(value_id));
}

func value(state Emitter, value_id usize) Value throws Error {
    return b_value_binding(state, value_id).value;
}

func value_type(state Emitter, value_id usize) usize throws Error {
    return b_value_binding(state, value_id).type_id;
}

func constant_value(state Emitter, value_id usize) option.Option[Value] {
    for entry in state.frame.constants {
        if entry.value_id == value_id {
            return option.Option[Value].Some(entry.value);
        }
    }
    return option.Option[Value].None;
}

func b_constant_binding(value_id usize, value Value) ValueConstant {
    return ValueConstant(value_id: value_id, value: value);
}

// ---- storage ----------------------------------------------------------------

// `alloca T` has LLVM type ptr; only the allocated type spelling is T.
func storage(type_name string, state inout Emitter) Value throws Error {
    return entry_result("ptr", "alloca " + type_name, inout state);
}

func start_lifetime(address Value, state inout Emitter) throws Error {
    let sig = Signature(result: "void", parameters: ["ptr"]);
    let declaration = declare_function("llvm.lifetime.start.p0", sig,
        inout state);
    append("call void " + declaration.reference + "(ptr " + address.reference + ")",
        inout state);
}

func end_lifetime(address Value, state inout Emitter) throws Error {
    let sig = Signature(result: "void", parameters: ["ptr"]);
    let declaration = declare_function("llvm.lifetime.end.p0", sig,
        inout state);
    append("call void " + declaration.reference + "(ptr " + address.reference + ")",
        inout state);
}

// An empty LLVM aggregate has allocation size zero; every stride and scratch
// slot for it uses one byte, exactly as the C++ backend does.
func b_empty_size_id(type_id usize, state inout Emitter) bool throws Error {
    let value = type_of(state, type_id);
    switch value.kind {
        case model.TypeKind.NominalStruct: {
            let fields = aggregate_fields(type_id, option.Option[usize].None,
                inout state);
            for field in fields {
                if !b_empty_size_id(b_field_of(field), inout state) {
                    return false;
                }
            }
            return true;
        }
        case model.TypeKind.CForeignRecord: {
            if value.c_type < 1 ||
               usize(value.c_type) > vec.len(state.input.hir.resolved.project.c_types) {
                throw invalid("C record type index out of range");
            }
            let declaration = state.input.hir.resolved.project.c_types[usize(value.c_type) - 1];
            return vec.len(declaration.fields) == 0;
        }
        default: return false;
    }
}

func stride(type_id usize, state inout Emitter) Value throws Error {
    if b_empty_size_id(type_id, inout state) {
        return Value(type_name: "i64", reference: "1");
    }
    let type_name = lower_type(type_id, inout state);
    return allocation_size(type_name);
}

func element_storage(type_id usize, value Value, state inout Emitter) Value throws Error {
    let empty = b_empty_size_id(type_id, inout state);
    var type_name = "i8";
    if !empty {
        type_name = lower_type(type_id, inout state);
    }
    let scratch = storage(type_name, inout state);
    if empty {
        append("store i8 0, ptr " + scratch.reference, inout state);
    } else {
        append("store " + typed(value) + ", ptr " + scratch.reference, inout state);
    }
    return scratch;
}

// ---- Vec TBAA ---------------------------------------------------------------

// LLVM metadata strings use the `!"..."` spelling, not the `c"..."` spelling
// used by globals.  Escape bytes exactly like llvm_string, but prefix the
// metadata marker; MDBuilder emits this same textual shape.
func b_metadata_string(value string) string throws Error {
    return "!\"" + escape_bytes(text.bytes(value)) + "\"";
}

func b_define_vec_tbaa(state inout Emitter) throws Error {
    switch state.b.vec_header_tag {
        case option.Option.Some(item): return;
        case option.Option.None: {}
    }
    let root = define_metadata("tbaa.vec.root",
        "!{" + b_metadata_string("lang.vec.storage") + "}", inout state);
    let descriptor = define_metadata("tbaa.vec.descriptor",
        "!{" + b_metadata_string("descriptor") + ", " + root + "}", inout state);
    let elements = define_metadata("tbaa.vec.elements",
        "!{" + b_metadata_string("elements") + ", " + root + "}", inout state);
    let header = define_metadata("tbaa.vec.descriptor.tag",
        "!{" + descriptor + ", " + descriptor + ", i64 0}", inout state);
    let data = define_metadata("tbaa.vec.elements.tag",
        "!{" + elements + ", " + elements + ", i64 0}", inout state);
    state.b.vec_header_tag = option.Option[string].Some(header);
    state.b.vec_data_tag = option.Option[string].Some(data);
}

// Returns the ", !tbaa !N" suffix for one Vec descriptor/element access.  A
// Vec descriptor and its element storage never overlap; all element payload
// accesses share the element tag.
func vec_memory(header bool, state inout Emitter) string throws Error {
    b_define_vec_tbaa(inout state);
    if header {
        switch state.b.vec_header_tag {
            case option.Option.Some(item): return ", !tbaa " + item;
            case option.Option.None: {}
        }
    }
    switch state.b.vec_data_tag {
        case option.Option.Some(item): return ", !tbaa " + item;
        case option.Option.None: {}
    }
    throw invalid("missing Vec TBAA tag");
}

func vec_field(vec Value, field u32, type_name string,
               state inout Emitter) Value throws Error {
    let index = number(usize(field));
    let base = result("ptr", "getelementptr inbounds " + VEC_TYPE + ", ptr " +
        vec.reference + ", i32 0, i32 " + index, inout state);
    let suffix = vec_memory(true, inout state);
    return result(type_name, "load " + type_name + ", ptr " + base.reference +
        suffix, inout state);
}

// ---- guard and checked index -------------------------------------------------

func guard(bad Value, cause u32, source model.Span, state inout Emitter) throws Error {
    let function_index = current_function(state);
    let panic_block = new_block(function_index, "panic", inout state);
    let ok_block = new_block(function_index, "checked", inout state);
    terminate("br " + typed(bad) + ", label " + panic_block.reference +
        ", label " + ok_block.reference, inout state);
    position(panic_block, inout state);
    let signature = Signature(result: "void", parameters: ["i32", "i64", "i64", "i64"]);
    let target = declare_function("lang_native_panic_v1", signature, inout state);
    let cause_value = Value(type_name: "i32", reference: number(usize(cause)));
    let snapshot = Value(type_name: "i64", reference: strconv.format_u64(source.snapshot));
    let begin = Value(type_name: "i64", reference: strconv.format_u64(source.begin_byte));
    let end = Value(type_name: "i64", reference: strconv.format_u64(source.end_byte));
    append("call void " + target.reference + "(" + typed(cause_value) + ", " +
        typed(snapshot) + ", " + typed(begin) + ", " + typed(end) +
        ") noreturn nounwind", inout state);
    terminate("unreachable", inout state);
    position(ok_block, inout state);
}

func checked_index(index Value, type_id usize, source model.Span, cause u32,
                   state inout Emitter) Value throws Error {
    let value = type_of(state, type_id);
    let signed = b_signed(value);
    var cast = "zext ";
    if signed {
        cast = "sext ";
    }
    let wide = result("i65", cast + typed(index) + " to i65", inout state);
    let negative = result("i1", "icmp slt i65 " + wide.reference + ", 0", inout state);
    let oversized = result("i1", "icmp ugt i65 " + wide.reference +
        ", 18446744073709551615", inout state);
    let bad = result("i1", "or i1 " + negative.reference + ", " +
        oversized.reference, inout state);
    guard(bad, cause, source, inout state);
    return result("i64", "trunc i65 " + wide.reference + " to i64", inout state);
}

// ---- calls ------------------------------------------------------------------

func call(sig Signature, callee Value, args Vec[Value],
          state inout Emitter) Value throws Error {
    var parts = vec.empty[string]();
    for arg in args {
        vec.push(parts, typed(arg));
    }
    let actual = text.join(parts, ", ");
    if sig.result == "void" {
        append("call void " + callee.reference + "(" + actual + ")", inout state);
        return Value(type_name: "void", reference: "");
    }
    return result(sig.result, "call " + sig.result + " " + callee.reference +
        "(" + actual + ")", inout state);
}

func runtime(name string, result_type string, args Vec[Value],
             state inout Emitter) Value throws Error {
    var parameters = vec.empty[string]();
    for arg in args {
        vec.push(parameters, arg.type_name);
    }
    let sig = Signature(result: result_type, parameters: parameters);
    let target = declare_function(name, sig, inout state);
    return call(sig, target, args, inout state);
}

// A global read-only byte array with exact UTF-8 bytes and no added sentinel.
func b_bytes_global(bytes_text string, state inout Emitter) Value throws Error {
    var count usize = 0;
    for global in state.globals {
        if text.starts_with(global.name, "string.bytes") {
            count += 1;
        }
    }
    let bytes = text.bytes(bytes_text);
    let name = "string.bytes." + number(count);
    let body = "private unnamed_addr constant [" + number(vec.len(bytes)) +
        " x i8] " + llvm_bytes(bytes) + ", align 1";
    return define_global(name, body, inout state);
}
