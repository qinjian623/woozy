package values;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeadapter" as nativeadapter;
import "app/wzcc/nativeemit/core" as emitcore;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/vec" as vec;

// Native system/value text helpers.
//
// This file contains only small shared helpers owned by the E worker.  All
// private names use the e_ prefix required by SELFHOST_NATIVEEMIT.md.  The
// public contract entry points live in e_system.wz and e_c_ffi.wz.


// std::function replacement for stdlib Result/Option joins.  The success side
// is generated by the caller after begin; the failure side is built inside
// begin so it never loads an uninitialised success out parameter.
pub struct EVariantJoin {
    pub type_id usize;
    pub success_tag u32;
    pub done emitcore.BlockRef;
    pub fallback emitcore.Value;
    pub fallback_block emitcore.BlockRef;
    pub phi emitcore.Value;
    pub prefix emitcore.PrefixRef;
}

func e_c_callable(project model.Project, id u32) model.CCallableDecl throws emitcore.Error {
    try { return nativeadapter.e_c_callable(project, id); }
    catch error nativeadapter.Error { throw emitcore.adapter_error(error); }
}

func e_op_is(op nativeir.Op, expected nativeir.Op) bool {
    return nativeir.op_id(op) == nativeir.op_id(expected);
}

func e_binary_id(op hir.BinaryOp) u32 {
    switch op {
        case hir.BinaryOp.Add: return 0;
        case hir.BinaryOp.Subtract: return 1;
        case hir.BinaryOp.Multiply: return 2;
        case hir.BinaryOp.Divide: return 3;
        case hir.BinaryOp.Remainder: return 4;
        case hir.BinaryOp.ShiftLeft: return 5;
        case hir.BinaryOp.ShiftRight: return 6;
        case hir.BinaryOp.BitAnd: return 7;
        case hir.BinaryOp.BitOr: return 8;
        case hir.BinaryOp.BitXor: return 9;
        case hir.BinaryOp.Equal: return 10;
        case hir.BinaryOp.NotEqual: return 11;
        case hir.BinaryOp.Less: return 12;
        case hir.BinaryOp.LessEqual: return 13;
        case hir.BinaryOp.Greater: return 14;
        case hir.BinaryOp.GreaterEqual: return 15;
    }
}

func e_binary_is(op hir.BinaryOp, expected hir.BinaryOp) bool {
    return e_binary_id(op) == e_binary_id(expected);
}

pub func e_type_signed(kind model.TypeKind) bool {
    if emitcore.e_type_kind_is(kind, model.TypeKind.SignedInt) || emitcore.e_type_kind_is(kind, model.TypeKind.Isize) {
        return true;
    }
    return false;
}

func e_int_bits(name string) u32 {
    if name == "i1" { return 1; }
    if name == "i8" { return 8; }
    if name == "i16" { return 16; }
    if name == "i32" { return 32; }
    if name == "i64" { return 64; }
    return 0;
}

pub func e_int_cast(value emitcore.Value, target string, signed bool, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    if value.type_name == target { return value; }
    let source_bits = e_int_bits(value.type_name);
    let target_bits = e_int_bits(target);
    if source_bits != 0 && target_bits != 0 && target_bits < source_bits {
        return emitcore.result(target, "trunc " + emitcore.typed(value) + " to " + target, inout state);
    }
    var operation = "zext ";
    if signed { operation = "sext "; }
    return emitcore.result(target, operation + emitcore.typed(value) + " to " + target, inout state);
}

pub func e_zero(type_name string) emitcore.Value {
    if type_name == "ptr" {
        return emitcore.Value(type_name: "ptr", reference: "null");
    }
    if type_name == "i1" {
        return emitcore.Value(type_name: "i1", reference: "false");
    }
    return emitcore.Value(type_name: type_name, reference: "zeroinitializer");
}

pub func e_null() emitcore.Value { return emitcore.Value(type_name: "ptr", reference: "null"); }
pub func e_false() emitcore.Value { return emitcore.Value(type_name: "i1", reference: "false"); }
pub func e_true() emitcore.Value { return emitcore.Value(type_name: "i1", reference: "true"); }
pub func e_i32(value i32) emitcore.Value {
    if value < 0 { return emitcore.Value(type_name: "i32", reference: "-" + emitcore.number(usize(-value))); }
    return emitcore.Value(type_name: "i32", reference: emitcore.number(usize(value)));
}
pub func e_i64(value usize) emitcore.Value { return emitcore.Value(type_name: "i64", reference: emitcore.number(value)); }

pub func e_extract(value emitcore.Value, index u32, type_name string, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return emitcore.result(type_name, "extractvalue " + value.type_name + " " +
        value.reference + ", " + emitcore.number(usize(index)), inout state);
}

pub func e_insert_value(layout string, value emitcore.Value, payload emitcore.Value, path string,
                    state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return emitcore.result(layout, "insertvalue " + layout + " " + value.reference + ", " +
        emitcore.typed(payload) + ", " + path, inout state);
}

pub func e_load(type_name string, address emitcore.Value, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return emitcore.result(type_name, "load " + type_name + ", " + emitcore.typed(address), inout state);
}

func e_store(value emitcore.Value, address emitcore.Value, state inout emitcore.Emitter) throws emitcore.Error {
    emitcore.append("store " + emitcore.typed(value) + ", " + emitcore.typed(address), inout state);
}

pub func e_text_pointer(value emitcore.Value, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return e_extract(value, 0, "ptr", inout state);
}

pub func e_text_length(value emitcore.Value, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return e_extract(value, 1, "i64", inout state);
}

func e_string_value_address(type_id usize, value emitcore.Value, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return value_address(type_id, value, inout state);
}

func e_lower(type_id usize, state inout emitcore.Emitter) string throws emitcore.Error {
    return emitcore.lower_type(type_id, inout state);
}

func e_type(state emitcore.Emitter, type_id usize) model.Type throws emitcore.Error {
    return emitcore.type_of(state, type_id);
}

func e_is_unit(state emitcore.Emitter, type_id usize) bool throws emitcore.Error {
    let value = emitcore.type_of(state, type_id);
    return emitcore.e_type_kind_is(value.kind, model.TypeKind.Unit);
}

func e_is_bool(state emitcore.Emitter, type_id usize) bool throws emitcore.Error {
    let value = emitcore.type_of(state, type_id);
    return emitcore.e_type_kind_is(value.kind, model.TypeKind.Bool);
}

func e_is_string(state emitcore.Emitter, type_id usize) bool throws emitcore.Error {
    let value = emitcore.type_of(state, type_id);
    return emitcore.e_type_kind_is(value.kind, model.TypeKind.String);
}

func e_is_nominal(state emitcore.Emitter, type_id usize) bool throws emitcore.Error {
    let value = emitcore.type_of(state, type_id);
    return emitcore.e_type_kind_is(value.kind, model.TypeKind.NominalStruct) ||
        emitcore.e_type_kind_is(value.kind, model.TypeKind.NominalEnum);
}

func e_result_payload_type(state emitcore.Emitter, result_type usize) usize throws emitcore.Error {
    let value = emitcore.type_of(state, result_type);
    if vec.len(value.type_args) == 0 {
        throw emitcore.invalid("Result/Option type has no payload argument");
    }
    return value.type_args[0];
}

func e_first_type_arg(state emitcore.Emitter, type_id usize) usize throws emitcore.Error {
    let value = emitcore.type_of(state, type_id);
    if vec.len(value.type_args) == 0 {
        throw emitcore.invalid("generic value type has no first type argument");
    }
    return value.type_args[0];
}

func e_add_u32_sorted(values inout Vec[u32], value u32) {
    nativeadapter.e_add_u32_sorted(inout values, value);
}

func e_has_u32(values Vec[u32], value u32) bool {
    return nativeadapter.e_has_u32(values, value);
}

func e_add_callback_used(symbol usize, c_type u32, state inout emitcore.Emitter) {
    var out Vec[emitcore.UsedCallback] = [];
    var inserted = false;
    for item in state.e.used_callbacks {
        if item.symbol == symbol && item.c_type == c_type { return; }
        if !inserted && (symbol < item.symbol ||
            (symbol == item.symbol && c_type < item.c_type)) {
            vec.push(out, emitcore.UsedCallback(symbol: symbol, c_type: c_type));
            inserted = true;
        }
        vec.push(out, item);
    }
    if !inserted {
        vec.push(out, emitcore.UsedCallback(symbol: symbol, c_type: c_type));
    }
    state.e.used_callbacks = out;
}

func e_add_callable_used(id u32, state inout emitcore.Emitter) {
    e_add_u32_sorted(inout state.e.used_callables, id);
}

func e_add_resource_used(id u32, state inout emitcore.Emitter) {
    e_add_u32_sorted(inout state.e.used_resources, id);
}


pub func stdlib_variant(type_id usize, tag u32, payload option.Option[emitcore.Value],
                    state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let layout = emitcore.lower_type(type_id, inout state);
    var value = emitcore.result(layout, "insertvalue " + layout + " zeroinitializer, i32 " +
        emitcore.number(usize(tag)) + ", 0", inout state);
    switch payload {
        case option.Option.Some(item): {
            let path = emitcore.number(usize(tag + 1)) + ", 0";
            value = e_insert_value(layout, value, item, path, inout state);
        }
        case option.Option.None: {}
    }
    return value;
}

pub func e_stdlib_result_begin(type_id usize, status emitcore.Value, state inout emitcore.Emitter) EVariantJoin throws emitcore.Error {
    let function_index = emitcore.current_function(state);
    var join = EVariantJoin(type_id: type_id, success_tag: 0,
        done: emitcore.BlockRef(function_index: function_index, block_index: 0, reference: ""),
        fallback: e_zero("i8"),
        fallback_block: emitcore.BlockRef(function_index: function_index, block_index: 0, reference: ""),
        phi: e_zero("i8"),
        prefix: emitcore.PrefixRef(function_index: function_index, block_index: 0, index: 0));
    let layout = emitcore.lower_type(type_id, inout state);
    let success = emitcore.new_block(function_index, "result.ok", inout state);
    let failure = emitcore.new_block(function_index, "result.error", inout state);
    let done = emitcore.new_block(function_index, "result.done", inout state);
    let bad = emitcore.result("i1", "icmp slt " + emitcore.typed(status) + ", 0", inout state);
    emitcore.terminate("br " + emitcore.typed(bad) + ", label " + failure.reference + ", label " +
        success.reference, inout state);
    emitcore.position(failure, inout state);
    let negated = emitcore.result("i64", "sub i64 0, " + status.reference, inout state);
    let code = emitcore.result("i32", "trunc i64 " + negated.reference + " to i32", inout state);
    let fallback = stdlib_variant(type_id, 1, option.Option[emitcore.Value].Some(code), inout state);
    let failure_end = emitcore.here(state);
    emitcore.terminate("br label " + done.reference, inout state);
    emitcore.position(done, inout state);
    let phi = emitcore.fresh_value(layout, inout state);
    let prefix = emitcore.reserve_prefix(inout state);
    join.done = emitcore.here(state);
    join.fallback = fallback;
    join.fallback_block = failure_end;
    join.phi = phi;
    join.prefix = prefix;
    emitcore.position(success, inout state);
    return join;
}

pub func e_stdlib_option_begin(type_id usize, present emitcore.Value, state inout emitcore.Emitter) EVariantJoin throws emitcore.Error {
    let function_index = emitcore.current_function(state);
    var join = EVariantJoin(type_id: type_id, success_tag: 1,
        done: emitcore.BlockRef(function_index: function_index, block_index: 0, reference: ""),
        fallback: e_zero("i8"),
        fallback_block: emitcore.BlockRef(function_index: function_index, block_index: 0, reference: ""),
        phi: e_zero("i8"),
        prefix: emitcore.PrefixRef(function_index: function_index, block_index: 0, index: 0));
    let layout = emitcore.lower_type(type_id, inout state);
    let some = emitcore.new_block(function_index, "option.some", inout state);
    let none = emitcore.new_block(function_index, "option.none", inout state);
    let done = emitcore.new_block(function_index, "option.done", inout state);
    emitcore.terminate("br " + emitcore.typed(present) + ", label " + some.reference + ", label " +
        none.reference, inout state);
    emitcore.position(none, inout state);
    let fallback = stdlib_variant(type_id, 0, option.Option[emitcore.Value].None, inout state);
    let none_end = emitcore.here(state);
    emitcore.terminate("br label " + done.reference, inout state);
    emitcore.position(done, inout state);
    let phi = emitcore.fresh_value(layout, inout state);
    let prefix = emitcore.reserve_prefix(inout state);
    join.done = emitcore.here(state);
    join.fallback = fallback;
    join.fallback_block = none_end;
    join.phi = phi;
    join.prefix = prefix;
    emitcore.position(some, inout state);
    return join;
}

pub func e_stdlib_finish(join EVariantJoin, payload emitcore.Value, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let layout = emitcore.lower_type(join.type_id, inout state);
    let value = stdlib_variant(join.type_id, join.success_tag,
        option.Option[emitcore.Value].Some(payload), inout state);
    let success_end = emitcore.here(state);
    emitcore.terminate("br label " + join.done.reference, inout state);
    let phi_line = join.phi.reference + " = phi " + layout + " [ " +
        value.reference + ", " + success_end.reference + " ], [ " +
        join.fallback.reference + ", " + join.fallback_block.reference + " ]";
    emitcore.set_prefix(join.prefix, phi_line, inout state);
    emitcore.position(join.done, inout state);
    return join.phi;
}

pub func value_address(type_id usize, value emitcore.Value, state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let layout = emitcore.lower_type(type_id, inout state);
    let address = emitcore.storage(layout, inout state);
    e_store(value, address, inout state);
    return address;
}

pub func text_binary(instruction nativeir.Instruction, left emitcore.Value, right emitcore.Value,
                 state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    let input_type = emitcore.value_type(state, instruction.inputs[0]);
    let left_address = value_address(input_type, left, inout state);
    let right_address = value_address(input_type, right, inout state);
    if e_binary_is(instruction.binary, hir.BinaryOp.Add) {
        let layout = emitcore.lower_type(instruction.type_id, inout state);
        let out = emitcore.storage(layout, inout state);
        var args Vec[emitcore.Value] = [];
        vec.push(args, out);
        vec.push(args, left_address);
        vec.push(args, right_address);
        emitcore.runtime("lang_text_concat_v1", "void", args, inout state);
        return e_load(layout, out, inout state);
    }
    var compare_args Vec[emitcore.Value] = [];
    vec.push(compare_args, left_address);
    vec.push(compare_args, right_address);
    let order = emitcore.runtime("lang_text_compare_v1", "i32", compare_args, inout state);
    let zero = "0";
    if e_binary_is(instruction.binary, hir.BinaryOp.Equal) {
        return emitcore.result("i1", "icmp eq " + emitcore.typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.NotEqual) {
        return emitcore.result("i1", "icmp ne " + emitcore.typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.Less) {
        return emitcore.result("i1", "icmp slt " + emitcore.typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.LessEqual) {
        return emitcore.result("i1", "icmp sle " + emitcore.typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.Greater) {
        return emitcore.result("i1", "icmp sgt " + emitcore.typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.GreaterEqual) {
        return emitcore.result("i1", "icmp sge " + emitcore.typed(order) + ", 0", inout state);
    }
    throw emitcore.invalid("invalid verified text operator");
}

func e_runtime_value(name string, result_type string, args Vec[emitcore.Value],
                     state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return emitcore.runtime(name, result_type, args, inout state);
}

func e_call_runtime(name string, signature emitcore.Signature, callee emitcore.Value,
                    args Vec[emitcore.Value], state inout emitcore.Emitter) emitcore.Value throws emitcore.Error {
    return emitcore.call(signature, callee, args, inout state);
}


func e_function_type(result string, parameters Vec[string]) string {
    if vec.len(parameters) == 0 { return result + " ()"; }
    return result + " (" + emitcore.e_join_types(parameters) + ")";
}
