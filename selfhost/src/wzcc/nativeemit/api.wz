package nativeemit;

import "app/wzcc/model" as model;
import "std/option" as option;


pub const RUNTIME_ABI string = "lang-native-scalars/1";
pub const OWNERSHIP_RUNTIME_ABI string = "lang-native-values/1";
// Captured from fixed Clang 22.1.8 target probes, not host sizeof.
pub const DATA_LAYOUT string = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
pub const DARWIN_ARM64_TRIPLE string = "arm64-apple-macosx11.0.0";
pub const VEC_TYPE string = "%\"lang.vec\"";
pub const FN_TYPE string = "%\"lang.fn\"";
pub const WEAK_TYPE string = "%\"lang.weak\"";
pub const DYN_TYPE string = "%\"lang.dyn\"";
pub const HANDLE_TYPE string = "%\"lang.handle\"";
pub const SLICE_TYPE string = "%\"lang.slice\"";
pub const STRING_TYPE string = "%\"lang.string\"";

pub struct Options {
    pub triple string;
    pub cpu string;
    pub features string;
    pub optimization u32;
    pub debug_info bool;
}
pub struct Output {
    // Pre-optimization text only; the Root driver owns tools and object bytes.
    pub llvm_sections Vec[string];
    pub c_adapter_source string;
    pub triple string;
    pub data_layout string;
    pub has_async bool;
    pub debug_info bool;
}
pub struct EmitResult {
    pub state model.PhaseState;
    pub failure model.FailureKind;
    pub diagnostics Vec[model.Diagnostic];
    pub value option.Option[Output];
}

pub func default_options() Options {
    return Options(triple: "x86_64-unknown-linux-gnu", cpu: "generic",
        features: "", optimization: 0, debug_info: false);
}

pub enum Error {
    Failure(code string, kind model.FailureKind, message string);
}
