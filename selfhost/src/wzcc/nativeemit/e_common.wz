// Native system/value text helpers.
//
// This file contains only small shared helpers owned by the E worker.  All
// private names use the e_ prefix required by SELFHOST_NATIVEEMIT.md.  The
// public contract entry points live in e_system.wz and e_c_ffi.wz.
package nativeemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

// std::function replacement for stdlib Result/Option joins.  The success side
// is generated by the caller after begin; the failure side is built inside
// begin so it never loads an uninitialised success out parameter.
pub struct EVariantJoin {
    pub type_id usize;
    pub success_tag u32;
    pub done BlockRef;
    pub fallback Value;
    pub fallback_block BlockRef;
    pub phi Value;
    pub prefix PrefixRef;
}

func e_unsupported(message string) Error {
    return Error.Failure("E_CAPABILITY_UNAVAILABLE", model.FailureKind.Unsupported,
        message);
}

func e_c_type(project model.Project, id u32) model.CTypeDecl throws Error {
    if id == 0 || usize(id) > vec.len(project.c_types) {
        throw invalid("C type index out of range");
    }
    return project.c_types[usize(id) - 1];
}

func e_c_callable(project model.Project, id u32) model.CCallableDecl throws Error {
    if id == 0 || usize(id) > vec.len(project.c_callables) {
        throw invalid("C callable index out of range");
    }
    return project.c_callables[usize(id) - 1];
}

func e_type_kind_is(kind model.TypeKind, expected model.TypeKind) bool {
    return model.type_kind_id(kind) == model.type_kind_id(expected);
}

func e_c_type_kind_is(kind model.CTypeKind, expected model.CTypeKind) bool {
    switch kind {
        case model.CTypeKind.Scalar: {
            switch expected {
                case model.CTypeKind.Scalar: return true;
                default: return false;
            }
        }
        case model.CTypeKind.Pointer: {
            switch expected {
                case model.CTypeKind.Pointer: return true;
                default: return false;
            }
        }
        case model.CTypeKind.Buffer: {
            switch expected {
                case model.CTypeKind.Buffer: return true;
                default: return false;
            }
        }
        case model.CTypeKind.Named: {
            switch expected {
                case model.CTypeKind.Named: return true;
                default: return false;
            }
        }
    }
}

func e_c_decl_kind_is(kind model.CDeclKind, expected model.CDeclKind) bool {
    switch kind {
        case model.CDeclKind.Record: {
            switch expected {
                case model.CDeclKind.Record: return true;
                default: return false;
            }
        }
        case model.CDeclKind.Resource: {
            switch expected {
                case model.CDeclKind.Resource: return true;
                default: return false;
            }
        }
        case model.CDeclKind.Callback: {
            switch expected {
                case model.CDeclKind.Callback: return true;
                default: return false;
            }
        }
        case model.CDeclKind.Opaque: {
            switch expected {
                case model.CDeclKind.Opaque: return true;
                default: return false;
            }
        }
    }
}

func e_op_is(op nativeir.Op, expected nativeir.Op) bool {
    return nativeir.op_id(op) == nativeir.op_id(expected);
}

func e_binary_id(op hir.BinaryOp) u32 {
    switch op {
        case hir.BinaryOp.Add: return 0;
        case hir.BinaryOp.Subtract: return 1;
        case hir.BinaryOp.Multiply: return 2;
        case hir.BinaryOp.Divide: return 3;
        case hir.BinaryOp.Remainder: return 4;
        case hir.BinaryOp.ShiftLeft: return 5;
        case hir.BinaryOp.ShiftRight: return 6;
        case hir.BinaryOp.BitAnd: return 7;
        case hir.BinaryOp.BitOr: return 8;
        case hir.BinaryOp.BitXor: return 9;
        case hir.BinaryOp.Equal: return 10;
        case hir.BinaryOp.NotEqual: return 11;
        case hir.BinaryOp.Less: return 12;
        case hir.BinaryOp.LessEqual: return 13;
        case hir.BinaryOp.Greater: return 14;
        case hir.BinaryOp.GreaterEqual: return 15;
    }
}

func e_binary_is(op hir.BinaryOp, expected hir.BinaryOp) bool {
    return e_binary_id(op) == e_binary_id(expected);
}

func e_type_signed(kind model.TypeKind) bool {
    if e_type_kind_is(kind, model.TypeKind.SignedInt) || e_type_kind_is(kind, model.TypeKind.Isize) {
        return true;
    }
    return false;
}

func e_type_bits(kind model.TypeKind, bits u32, word_bits u32) u32 {
    if e_type_kind_is(kind, model.TypeKind.Isize) || e_type_kind_is(kind, model.TypeKind.Usize) {
        return word_bits;
    }
    return bits;
}

func e_llvm_int_type(bits u32) string throws Error {
    switch bits {
        case 1: return "i1";
        case 8: return "i8";
        case 16: return "i16";
        case 32: return "i32";
        case 64: return "i64";
        default: throw invalid("unsupported integer width in LLVM text emission");
    }
}

func e_int_bits(name string) u32 {
    if name == "i1" { return 1; }
    if name == "i8" { return 8; }
    if name == "i16" { return 16; }
    if name == "i32" { return 32; }
    if name == "i64" { return 64; }
    return 0;
}

func e_int_cast(value Value, target string, signed bool, state inout Emitter) Value throws Error {
    if value.type_name == target { return value; }
    let source_bits = e_int_bits(value.type_name);
    let target_bits = e_int_bits(target);
    if source_bits != 0 && target_bits != 0 && target_bits < source_bits {
        return result(target, "trunc " + typed(value) + " to " + target, inout state);
    }
    var operation = "zext ";
    if signed { operation = "sext "; }
    return result(target, operation + typed(value) + " to " + target, inout state);
}

func e_zero(type_name string) Value {
    if type_name == "ptr" {
        return Value(type_name: "ptr", reference: "null");
    }
    if type_name == "i1" {
        return Value(type_name: "i1", reference: "false");
    }
    return Value(type_name: type_name, reference: "zeroinitializer");
}

func e_null() Value { return Value(type_name: "ptr", reference: "null"); }
func e_false() Value { return Value(type_name: "i1", reference: "false"); }
func e_true() Value { return Value(type_name: "i1", reference: "true"); }
func e_i32(value i32) Value {
    if value < 0 { return Value(type_name: "i32", reference: "-" + number(usize(-value))); }
    return Value(type_name: "i32", reference: number(usize(value)));
}
func e_i64(value usize) Value { return Value(type_name: "i64", reference: number(value)); }

func e_extract(value Value, index u32, type_name string, state inout Emitter) Value throws Error {
    return result(type_name, "extractvalue " + value.type_name + " " +
        value.reference + ", " + number(usize(index)), inout state);
}

func e_insert_value(layout string, value Value, payload Value, path string,
                    state inout Emitter) Value throws Error {
    return result(layout, "insertvalue " + layout + " " + value.reference + ", " +
        typed(payload) + ", " + path, inout state);
}

func e_load(type_name string, address Value, state inout Emitter) Value throws Error {
    return result(type_name, "load " + type_name + ", " + typed(address), inout state);
}

func e_store(value Value, address Value, state inout Emitter) throws Error {
    append("store " + typed(value) + ", " + typed(address), inout state);
}

func e_text_pointer(value Value, state inout Emitter) Value throws Error {
    return e_extract(value, 0, "ptr", inout state);
}

func e_text_length(value Value, state inout Emitter) Value throws Error {
    return e_extract(value, 1, "i64", inout state);
}

func e_string_value_address(type_id usize, value Value, state inout Emitter) Value throws Error {
    return value_address(type_id, value, inout state);
}

func e_lower(type_id usize, state inout Emitter) string throws Error {
    return lower_type(type_id, inout state);
}

func e_type(state Emitter, type_id usize) model.Type throws Error {
    return type_of(state, type_id);
}

func e_is_unit(state Emitter, type_id usize) bool throws Error {
    let value = type_of(state, type_id);
    return e_type_kind_is(value.kind, model.TypeKind.Unit);
}

func e_is_bool(state Emitter, type_id usize) bool throws Error {
    let value = type_of(state, type_id);
    return e_type_kind_is(value.kind, model.TypeKind.Bool);
}

func e_is_string(state Emitter, type_id usize) bool throws Error {
    let value = type_of(state, type_id);
    return e_type_kind_is(value.kind, model.TypeKind.String);
}

func e_is_nominal(state Emitter, type_id usize) bool throws Error {
    let value = type_of(state, type_id);
    return e_type_kind_is(value.kind, model.TypeKind.NominalStruct) ||
        e_type_kind_is(value.kind, model.TypeKind.NominalEnum);
}

func e_result_payload_type(state Emitter, result_type usize) usize throws Error {
    let value = type_of(state, result_type);
    if vec.len(value.type_args) == 0 {
        throw invalid("Result/Option type has no payload argument");
    }
    return value.type_args[0];
}

func e_first_type_arg(state Emitter, type_id usize) usize throws Error {
    let value = type_of(state, type_id);
    if vec.len(value.type_args) == 0 {
        throw invalid("generic value type has no first type argument");
    }
    return value.type_args[0];
}

func e_add_u32_sorted(values inout Vec[u32], value u32) {
    var out Vec[u32] = [];
    var inserted = false;
    for item in values {
        if item == value { return; }
        if !inserted && value < item {
            vec.push(out, value);
            inserted = true;
        }
        vec.push(out, item);
    }
    if !inserted { vec.push(out, value); }
    values = out;
}

func e_has_u32(values Vec[u32], value u32) bool {
    for item in values { if item == value { return true; } }
    return false;
}

func e_add_callback_used(symbol usize, c_type u32, state inout Emitter) {
    var out Vec[UsedCallback] = [];
    var inserted = false;
    for item in state.e.used_callbacks {
        if item.symbol == symbol && item.c_type == c_type { return; }
        if !inserted && (symbol < item.symbol ||
            (symbol == item.symbol && c_type < item.c_type)) {
            vec.push(out, UsedCallback(symbol: symbol, c_type: c_type));
            inserted = true;
        }
        vec.push(out, item);
    }
    if !inserted {
        vec.push(out, UsedCallback(symbol: symbol, c_type: c_type));
    }
    state.e.used_callbacks = out;
}

func e_add_callable_used(id u32, state inout Emitter) {
    e_add_u32_sorted(inout state.e.used_callables, id);
}

func e_add_resource_used(id u32, state inout Emitter) {
    e_add_u32_sorted(inout state.e.used_resources, id);
}

// LLVM literal aggregate spelling for C buffers.
func e_buffer_layout() string { return "{ ptr, i64 }"; }

func stdlib_variant(type_id usize, tag u32, payload option.Option[Value],
                    state inout Emitter) Value throws Error {
    let layout = lower_type(type_id, inout state);
    var value = result(layout, "insertvalue " + layout + " zeroinitializer, i32 " +
        number(usize(tag)) + ", 0", inout state);
    switch payload {
        case option.Option.Some(item): {
            let path = number(usize(tag + 1)) + ", 0";
            value = e_insert_value(layout, value, item, path, inout state);
        }
        case option.Option.None: {}
    }
    return value;
}

func e_stdlib_result_begin(type_id usize, status Value, state inout Emitter) EVariantJoin throws Error {
    let function_index = current_function(state);
    var join = EVariantJoin(type_id: type_id, success_tag: 0,
        done: BlockRef(function_index: function_index, block_index: 0, reference: ""),
        fallback: e_zero("i8"),
        fallback_block: BlockRef(function_index: function_index, block_index: 0, reference: ""),
        phi: e_zero("i8"),
        prefix: PrefixRef(function_index: function_index, block_index: 0, index: 0));
    let layout = lower_type(type_id, inout state);
    let success = new_block(function_index, "result.ok", inout state);
    let failure = new_block(function_index, "result.error", inout state);
    let done = new_block(function_index, "result.done", inout state);
    let bad = result("i1", "icmp slt " + typed(status) + ", 0", inout state);
    terminate("br " + typed(bad) + ", label " + failure.reference + ", label " +
        success.reference, inout state);
    position(failure, inout state);
    let negated = result("i64", "sub i64 0, " + status.reference, inout state);
    let code = result("i32", "trunc i64 " + negated.reference + " to i32", inout state);
    let fallback = stdlib_variant(type_id, 1, option.Option[Value].Some(code), inout state);
    let failure_end = here(state);
    terminate("br label " + done.reference, inout state);
    position(done, inout state);
    let phi = fresh_value(layout, inout state);
    let prefix = reserve_prefix(inout state);
    join.done = here(state);
    join.fallback = fallback;
    join.fallback_block = failure_end;
    join.phi = phi;
    join.prefix = prefix;
    position(success, inout state);
    return join;
}

func e_stdlib_option_begin(type_id usize, present Value, state inout Emitter) EVariantJoin throws Error {
    let function_index = current_function(state);
    var join = EVariantJoin(type_id: type_id, success_tag: 1,
        done: BlockRef(function_index: function_index, block_index: 0, reference: ""),
        fallback: e_zero("i8"),
        fallback_block: BlockRef(function_index: function_index, block_index: 0, reference: ""),
        phi: e_zero("i8"),
        prefix: PrefixRef(function_index: function_index, block_index: 0, index: 0));
    let layout = lower_type(type_id, inout state);
    let some = new_block(function_index, "option.some", inout state);
    let none = new_block(function_index, "option.none", inout state);
    let done = new_block(function_index, "option.done", inout state);
    terminate("br " + typed(present) + ", label " + some.reference + ", label " +
        none.reference, inout state);
    position(none, inout state);
    let fallback = stdlib_variant(type_id, 0, option.Option[Value].None, inout state);
    let none_end = here(state);
    terminate("br label " + done.reference, inout state);
    position(done, inout state);
    let phi = fresh_value(layout, inout state);
    let prefix = reserve_prefix(inout state);
    join.done = here(state);
    join.fallback = fallback;
    join.fallback_block = none_end;
    join.phi = phi;
    join.prefix = prefix;
    position(some, inout state);
    return join;
}

func e_stdlib_finish(join EVariantJoin, payload Value, state inout Emitter) Value throws Error {
    let layout = lower_type(join.type_id, inout state);
    let value = stdlib_variant(join.type_id, join.success_tag,
        option.Option[Value].Some(payload), inout state);
    let success_end = here(state);
    terminate("br label " + join.done.reference, inout state);
    let phi_line = join.phi.reference + " = phi " + layout + " [ " +
        value.reference + ", " + success_end.reference + " ], [ " +
        join.fallback.reference + ", " + join.fallback_block.reference + " ]";
    set_prefix(join.prefix, phi_line, inout state);
    position(join.done, inout state);
    return join.phi;
}

func value_address(type_id usize, value Value, state inout Emitter) Value throws Error {
    let layout = lower_type(type_id, inout state);
    let address = storage(layout, inout state);
    e_store(value, address, inout state);
    return address;
}

func text_binary(instruction nativeir.Instruction, left Value, right Value,
                 state inout Emitter) Value throws Error {
    let input_type = value_type(state, instruction.inputs[0]);
    let left_address = value_address(input_type, left, inout state);
    let right_address = value_address(input_type, right, inout state);
    if e_binary_is(instruction.binary, hir.BinaryOp.Add) {
        let layout = lower_type(instruction.type_id, inout state);
        let out = storage(layout, inout state);
        var args Vec[Value] = [];
        vec.push(args, out);
        vec.push(args, left_address);
        vec.push(args, right_address);
        runtime("lang_text_concat_v1", "void", args, inout state);
        return e_load(layout, out, inout state);
    }
    var compare_args Vec[Value] = [];
    vec.push(compare_args, left_address);
    vec.push(compare_args, right_address);
    let order = runtime("lang_text_compare_v1", "i32", compare_args, inout state);
    let zero = "0";
    if e_binary_is(instruction.binary, hir.BinaryOp.Equal) {
        return result("i1", "icmp eq " + typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.NotEqual) {
        return result("i1", "icmp ne " + typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.Less) {
        return result("i1", "icmp slt " + typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.LessEqual) {
        return result("i1", "icmp sle " + typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.Greater) {
        return result("i1", "icmp sgt " + typed(order) + ", 0", inout state);
    }
    if e_binary_is(instruction.binary, hir.BinaryOp.GreaterEqual) {
        return result("i1", "icmp sge " + typed(order) + ", 0", inout state);
    }
    throw invalid("invalid verified text operator");
}

func e_runtime_value(name string, result_type string, args Vec[Value],
                     state inout Emitter) Value throws Error {
    return runtime(name, result_type, args, inout state);
}

func e_call_runtime(name string, signature Signature, callee Value,
                    args Vec[Value], state inout Emitter) Value throws Error {
    return call(signature, callee, args, inout state);
}

func e_join_types(types Vec[string]) string {
    return text.join(types, ", ");
}

func e_function_type(result string, parameters Vec[string]) string {
    if vec.len(parameters) == 0 { return result + " ()"; }
    return result + " (" + e_join_types(parameters) + ")";
}
