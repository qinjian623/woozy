// C: source Weak operations.
//
// Direct port of src/backend/native/weak_ops.inc.  Weak[T] is {control, code}.
// The canonical projection is selected from the verified target declaration,
// never from a type_key string, and the runtime owns the control block.
//
// All helpers are prefixed c_ except the contract-published weak_system_call.
package nativeemit;

import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/vec" as vec;

enum CWeakKind {
    Vec;
    Handle;
    Box;
}

struct CWeakProjection {
    kind CWeakKind;
    // Canonical wrapper carrying the shared private field; zero for a direct
    // Vec identity.
    wrapper usize;
}

struct CWeakSlotAddress {
    object Value;
    slot Value;
}

func c_weak_projection(target usize, state inout Emitter) CWeakProjection throws Error {
    let value = type_of(state, target);
    switch value.kind {
        case model.TypeKind.Vec: {
            return CWeakProjection(kind: CWeakKind.Vec, wrapper: 0);
        }
        case model.TypeKind.NominalStruct: {}
        default: {
            throw invalid("Weak target is not a canonical source declaration");
        }
    }
    // Only the exact resolved std declaration selected by weak_target is
    // accepted.  A same-shaped user struct is not a Weak target even if its
    // bytes happen to look like one.
    if !c_weak_target(target, state) {
        throw invalid("Weak target is not a canonical source declaration");
    }
    let fields = aggregate_fields(target, option.Option[usize].None, inout state);
    if vec.len(fields) != 1 {
        throw invalid("Weak target does not have the canonical private field");
    }
    let private_type = type_of(state, fields[0].type_id);
    switch private_type.kind {
        // std/box.Box[T]: the canonical target is the private cell Vec.
        case model.TypeKind.Vec: {
            return CWeakProjection(kind: CWeakKind.Box, wrapper: target);
        }
        case model.TypeKind.ThreadHandle: {
            return CWeakProjection(kind: CWeakKind.Handle, wrapper: target);
        }
        case model.TypeKind.MutexHandle: {
            return CWeakProjection(kind: CWeakKind.Handle, wrapper: target);
        }
        case model.TypeKind.CondvarHandle: {
            return CWeakProjection(kind: CWeakKind.Handle, wrapper: target);
        }
        case model.TypeKind.AtomicI64Handle: {
            return CWeakProjection(kind: CWeakKind.Handle, wrapper: target);
        }
        case model.TypeKind.IpcHandle: {
            return CWeakProjection(kind: CWeakKind.Handle, wrapper: target);
        }
        default: {
            throw invalid("Weak target private field is not a canonical runtime identity");
        }
    }
}

// LangVec.weak_control is the tenth field, at byte offset 72.
func c_weak_vec_slot(value Value, state inout Emitter) Value throws Error {
    return c_gep(VEC_TYPE, value, 9, inout state);
}

// LangHandle.weak_control is the fourth field, at byte offset 24.
func c_weak_handle_slot(value Value, state inout Emitter) Value throws Error {
    return c_gep(HANDLE_TYPE, value, 3, inout state);
}

// Resolve the owned object whose ARC identity the target observes and the
// canonical slot whose installed control block belongs to that identity.
func c_weak_slot_address(projection CWeakProjection, value Value,
                         state inout Emitter) CWeakSlotAddress throws Error {
    switch projection.kind {
        case CWeakKind.Vec: {
            let slot = c_weak_vec_slot(value, inout state);
            return CWeakSlotAddress(object: value, slot: slot);
        }
        case CWeakKind.Box: {
            let object = c_extract("ptr", value, 0, inout state);
            let slot = c_weak_vec_slot(object, inout state);
            return CWeakSlotAddress(object: object, slot: slot);
        }
        case CWeakKind.Handle: {
            let object = c_extract("ptr", value, 0, inout state);
            let slot = c_weak_handle_slot(object, inout state);
            return CWeakSlotAddress(object: object, slot: slot);
        }
    }
}

// LangWeak is exactly {control, code}.
func c_weak_value(control Value, code Value, state inout Emitter) Value throws Error {
    let zero = Value(type_name: WEAK_TYPE, reference: "zeroinitializer");
    let with_control = c_insert(WEAK_TYPE, zero, control, 0, inout state);
    return c_insert(WEAK_TYPE, with_control, code, 1, inout state);
}

// LangFn is exactly {code, env}.  The env-first code pointer is preserved.
func c_function_value_of(code Value, environment Value,
                         state inout Emitter) Value throws Error {
    let zero = Value(type_name: FN_TYPE, reference: "zeroinitializer");
    let with_code = c_insert(FN_TYPE, zero, code, 0, inout state);
    return c_insert(FN_TYPE, with_code, environment, 1, inout state);
}

// Downgrade a function value.  An empty environment denotes the immortal
// {null, code} encoding and must never be treated as a failed downgrade.  A
// failed downgrade of a real environment denotes dead {null, null}; it must
// never be reinterpreted as immortal.
func c_weak_downgrade_function(function_value Value,
                               state inout Emitter) Value throws Error {
    let code = c_extract("ptr", function_value, 0, inout state);
    let environment = c_extract("ptr", function_value, 1, inout state);
    let current = here(state);
    let function_index = current.function_index;
    let captured = new_block(function_index, "weak.fn.env", inout state);
    let immortal = new_block(function_index, "weak.fn.immortal", inout state);
    let alive = new_block(function_index, "weak.fn.alive", inout state);
    let dead = new_block(function_index, "weak.fn.dead", inout state);
    let done = new_block(function_index, "weak.fn.done", inout state);
    let present = c_icmp("ne", "ptr", environment.reference, "null", inout state);
    c_cond_branch(present, captured, immortal, inout state);

    position(captured, inout state);
    let slot = c_weak_vec_slot(environment, inout state);
    let control = runtime("lang_weak_downgrade_v1", "ptr",
        [environment, slot], inout state);
    let missing = c_icmp("eq", "ptr", control.reference, "null", inout state);
    c_cond_branch(missing, dead, alive, inout state);

    position(alive, inout state);
    let alive_value = c_weak_value(control, code, inout state);
    c_branch(done, inout state);
    let alive_end = here(state);

    position(dead, inout state);
    let dead_value = c_weak_value(c_null(), c_null(), inout state);
    c_branch(done, inout state);
    let dead_end = here(state);

    position(immortal, inout state);
    let immortal_value = c_weak_value(c_null(), code, inout state);
    c_branch(done, inout state);
    let immortal_end = here(state);

    position(done, inout state);
    let phi = c_phi_begin(WEAK_TYPE, inout state);
    var incoming = vec.empty[CPhiIncoming]();
    vec.push(incoming, CPhiIncoming(value: alive_value, block: alive_end));
    vec.push(incoming, CPhiIncoming(value: dead_value, block: dead_end));
    vec.push(incoming, CPhiIncoming(value: immortal_value, block: immortal_end));
    c_phi_set(phi, incoming, inout state);
    return phi.value;
}

// Downgrade a Vec, Box or canonical handle.  The caller holds a strong
// reference for the duration of the call, so the returned control block owns
// exactly one real Weak reference.
func c_weak_downgrade_object(projection CWeakProjection, value Value,
                             state inout Emitter) Value throws Error {
    let address = c_weak_slot_address(projection, value, inout state);
    let control = runtime("lang_weak_downgrade_v1", "ptr",
        [address.object, address.slot], inout state);
    return c_weak_value(control, c_null(), inout state);
}

func c_resolved_symbol(index usize, state Emitter) model.Symbol throws Error {
    let resolved = state.input.hir.resolved;
    if index >= vec.len(resolved.symbols) {
        throw invalid("invalid resolved symbol reference");
    }
    return resolved.symbols[index];
}

// upgrade returns the canonical std/option.Option[T].  The exact declaration
// and None/Some payload shape are re-checked here so forged or swapped HIR
// metadata cannot silently produce a different nominal field layout.
func c_check_weak_option(option_type usize, state inout Emitter) throws Error {
    let value = type_of(state, option_type);
    switch value.kind {
        case model.TypeKind.NominalEnum: {}
        default: throw invalid("Weak upgrade result is not Option[T]");
    }
    if vec.len(value.type_args) != 1 {
        throw invalid("Weak upgrade result is not Option[T]");
    }
    let declaration = aggregate_declaration(state, option_type);
    let symbol = c_resolved_symbol(value.declaration, state);
    let project = state.input.hir.resolved.project;
    if symbol.module >= vec.len(project.modules) {
        throw invalid("invalid resolved module reference");
    }
    let module = project.modules[symbol.module];
    if module.logical_path != "std/option" || symbol.name != "Option" ||
       vec.len(declaration.variants) != 2 {
        throw invalid("Weak upgrade result is not the canonical std/option.Option");
    }
    let none_symbol = c_resolved_symbol(declaration.variants[0].symbol, state);
    let some_symbol = c_resolved_symbol(declaration.variants[1].symbol, state);
    if none_symbol.name != "None" || some_symbol.name != "Some" ||
       vec.len(declaration.variants[0].payload) != 0 ||
       vec.len(declaration.variants[1].payload) != 1 {
        throw invalid("Weak upgrade result does not have the canonical Option shape");
    }
    let payload = aggregate_fields(option_type,
        option.Option[usize].Some(declaration.variants[1].symbol), inout state);
    if vec.len(payload) != 1 || payload[0].type_id != value.type_args[0] {
        throw invalid("Weak upgrade Option payload differs from the Weak target");
    }
}

// Wrap one transferred strong reference in the exact nominal payload type.
// Vec and handle targets are already the lowered identity; Box and the
// standard handle wrappers carry that identity in their single private field.
func c_weak_payload(target usize, projection option.Option[CWeakProjection],
                    upgraded Value, code Value, state inout Emitter) Value throws Error {
    let target_type = type_of(state, target);
    switch target_type.kind {
        case model.TypeKind.Function: {
            return c_function_value_of(code, upgraded, inout state);
        }
        default: {}
    }
    var projection_value = CWeakProjection(kind: CWeakKind.Box, wrapper: target);
    switch projection {
        case option.Option.Some(value): { projection_value = value; }
        case option.Option.None: {
            throw invalid("Weak upgrade lost its target projection");
        }
    }
    switch projection_value.kind {
        case CWeakKind.Vec: return upgraded;
        default: {}
    }
    let layout = lower_type(target, inout state);
    let zero = Value(type_name: layout, reference: "zeroinitializer");
    return c_insert(layout, zero, upgraded, 0, inout state);
}

// Upgrade a Weak value.  The control block may already be dead, and a function
// environment may be absent because the value is immortal.  upgrade never
// calls the stored code on the dead path, and it transfers the new strong
// reference from lang_weak_upgrade_v1 exactly once.
func c_weak_upgrade(option_type usize, target usize,
                    projection option.Option[CWeakProjection], weak Value,
                    state inout Emitter) Value throws Error {
    let control = c_extract("ptr", weak, 0, inout state);
    let code = c_extract("ptr", weak, 1, inout state);
    var function_target = false;
    switch type_of(state, target).kind {
        case model.TypeKind.Function: { function_target = true; }
        default: {}
    }
    let current = here(state);
    let function_index = current.function_index;
    let has_control = new_block(function_index, "weak.up.control", inout state);
    let no_control = new_block(function_index, "weak.up.empty", inout state);
    let some = new_block(function_index, "weak.up.some", inout state);
    let none = new_block(function_index, "weak.up.none", inout state);
    let done = new_block(function_index, "weak.up.done", inout state);
    let present = c_icmp("ne", "ptr", control.reference, "null", inout state);
    c_cond_branch(present, has_control, no_control, inout state);

    position(has_control, inout state);
    let upgraded = runtime("lang_weak_upgrade_v1", "ptr", [control], inout state);
    let live = c_icmp("ne", "ptr", upgraded.reference, "null", inout state);
    let live_payload = c_weak_payload(target, projection, upgraded, code,
        inout state);
    c_cond_branch(live, some, none, inout state);
    let live_end = here(state);

    position(no_control, inout state);
    var immortal_payload = c_null();
    if function_target {
        // A null control with a non-null code is the only immortal encoding.
        // Dead {null, null} and empty values fall through to None.
        let immortal = c_icmp("ne", "ptr", code.reference, "null", inout state);
        immortal_payload = c_function_value_of(code, c_null(), inout state);
        c_cond_branch(immortal, some, none, inout state);
    } else {
        c_branch(none, inout state);
    }
    let empty_end = here(state);

    position(some, inout state);
    let payload_type = lower_type(target, inout state);
    let payload = c_phi_begin(payload_type, inout state);
    let some_value = stdlib_variant(option_type, 1,
        option.Option[Value].Some(payload.value), inout state);
    c_branch(done, inout state);
    let some_end = here(state);

    position(none, inout state);
    let none_value = stdlib_variant(option_type, 0,
        option.Option[Value].None, inout state);
    c_branch(done, inout state);
    let none_end = here(state);

    position(done, inout state);
    let option_layout = lower_type(option_type, inout state);
    let join = c_phi_begin(option_layout, inout state);

    var payload_incoming = vec.empty[CPhiIncoming]();
    vec.push(payload_incoming, CPhiIncoming(value: live_payload, block: live_end));
    if function_target {
        vec.push(payload_incoming, CPhiIncoming(value: immortal_payload,
            block: empty_end));
    }
    c_phi_set(payload, payload_incoming, inout state);
    var join_incoming = vec.empty[CPhiIncoming]();
    vec.push(join_incoming, CPhiIncoming(value: some_value, block: some_end));
    vec.push(join_incoming, CPhiIncoming(value: none_value, block: none_end));
    c_phi_set(join, join_incoming, inout state);
    return join.value;
}

// Recover the single Weak[T] type argument from a verified operation type.
func c_weak_operand(type_id usize, state inout Emitter) model.Type throws Error {
    let value = type_of(state, type_id);
    switch value.kind {
        case model.TypeKind.Weak: {}
        default: throw invalid("Weak operation did not receive a Weak[T] value");
    }
    if vec.len(value.type_args) != 1 {
        throw invalid("Weak operation did not receive a Weak[T] value");
    }
    return value;
}

func c_weak_operation(system u32) bool {
    return system == 201 || system == 202 || system == 203;
}

func weak_system_call(instruction nativeir.Instruction, args Vec[Value],
                      state inout Emitter) option.Option[Value] throws Error {
    var operation u32 = 0;
    switch instruction.system {
        case option.Option.None: return option.Option[Value].None;
        case option.Option.Some(value): {
            if !c_weak_operation(value) {
                return option.Option[Value].None;
            }
            operation = value;
        }
    }
    if state.input.hir.config.word_bits != 64 {
        throw c_unsupported("Weak runtime operations require the native/64 ABI");
    }
    let system_signature = type_of(state, instruction.signature);
    var invalid_signature = false;
    switch system_signature.kind {
        case model.TypeKind.Function: {}
        default: { invalid_signature = true; }
    }
    switch system_signature.throws_type {
        case option.Option.Some(throws_type): { invalid_signature = true; }
        case option.Option.None: {}
    }
    if invalid_signature {
        throw invalid("Weak operation signature is invalid");
    }
    if operation == 201 {
        if vec.len(args) != 0 {
            throw invalid("Weak empty takes no value arguments");
        }
        let weak = c_weak_operand(system_signature.result, inout state);
        if !c_weak_target(weak.type_args[0], state) {
            throw invalid("Weak target is not a canonical source declaration");
        }
        let layout = lower_type(instruction.type_id, inout state);
        return option.Option[Value].Some(
            Value(type_name: layout, reference: "zeroinitializer"));
    }
    if operation == 202 {
        if vec.len(args) != 1 || vec.len(system_signature.parameters) != 1 {
            throw invalid("Weak downgrade requires one value argument");
        }
        let target = system_signature.parameters[0].type_id;
        let weak = c_weak_operand(instruction.type_id, inout state);
        if weak.type_args[0] != target {
            throw invalid("Weak downgrade result differs from its target");
        }
        switch type_of(state, target).kind {
            case model.TypeKind.Function: {
                return option.Option[Value].Some(
                    c_weak_downgrade_function(args[0], inout state));
            }
            default: {
                let projection = c_weak_projection(target, inout state);
                return option.Option[Value].Some(
                    c_weak_downgrade_object(projection, args[0], inout state));
            }
        }
    }
    if vec.len(args) != 1 || vec.len(system_signature.parameters) != 1 {
        throw invalid("Weak upgrade requires one Weak value");
    }
    let weak = c_weak_operand(system_signature.parameters[0].type_id, inout state);
    let target = weak.type_args[0];
    let option_value = type_of(state, instruction.type_id);
    if vec.len(option_value.type_args) != 1 || option_value.type_args[0] != target {
        throw invalid("Weak upgrade result does not carry the target type");
    }
    c_check_weak_option(instruction.type_id, inout state);
    switch type_of(state, target).kind {
        case model.TypeKind.Function: {
            return option.Option[Value].Some(c_weak_upgrade(instruction.type_id,
                target, option.Option[CWeakProjection].None, args[0], inout state));
        }
        default: {
            let projection = c_weak_projection(target, inout state);
            return option.Option[Value].Some(c_weak_upgrade(instruction.type_id,
                target, option.Option[CWeakProjection].Some(projection), args[0],
                inout state));
        }
    }
}
