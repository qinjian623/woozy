// Source effect/cleanup construct preservation.  This is the
// Verifier::source_effect_nodes section of hir.cpp.
package flow;

import "app/wzcc/hirverify/calls" as hircalls;
import "app/wzcc/hirverify/core" as hircore;
import "app/wzcc/hirverify/nodes" as hirnodes;
import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "std/hash" as hash;
import "std/map" as map;
import "std/option" as option;
import "std/vec" as vec;

struct CountEntry {
    node usize;
    count usize;
}

struct NodeTypeEntry {
    source model.NodeRef;
    types Vec[usize];
    next option.Option[usize];
}

struct NodeTypeIndex {
    entries Vec[NodeTypeEntry];
    heads map.Map[u64, usize];
}

func count_add(entries Vec[CountEntry], node usize) {
    for var index usize = 0; index < vec.len(entries); index += 1 {
        if entries[index].node == node {
            entries[index].count += 1;
            return;
        }
    }
    vec.push(entries, CountEntry(node: node, count: 1));
}

func count_get(entries Vec[CountEntry], node usize) usize {
    for entry in entries {
        if entry.node == node {
            return entry.count;
        }
    }
    return 0;
}

func count_equal(left Vec[CountEntry], right Vec[CountEntry]) bool {
    if vec.len(left) != vec.len(right) {
        return false;
    }
    for entry in left {
        if count_get(right, entry.node) != entry.count {
            return false;
        }
    }
    return true;
}

func node_type_hash(source model.NodeRef) u64 {
    return hash.combine(hash.combine(hash.combine(0, u64(source.module)),
        u64(source.file)), u64(source.node));
}

func node_type_find(index NodeTypeIndex, source model.NodeRef) option.Option[usize] {
    var current = map.get(index.heads, node_type_hash(source));
    for {
        switch current {
            case option.Option.None: return option.Option[usize].None;
            case option.Option.Some(position): {
                let entry = index.entries[position];
                if entry.source.module == source.module &&
                   entry.source.file == source.file && entry.source.node == source.node {
                    return option.Option[usize].Some(position);
                }
                current = entry.next;
            }
        }
    }
}

func node_type_add(index NodeTypeIndex, source model.NodeRef, type_id usize) {
    switch node_type_find(index, source) {
        case option.Option.Some(position): {
            hircore.ids_insert(index.entries[position].types, type_id);
            return;
        }
        case option.Option.None: {}
    }
    let key = node_type_hash(source);
    let types = vec.empty[usize]();
    hircore.ids_insert(types, type_id);
    let position = vec.len(index.entries);
    vec.push(index.entries, NodeTypeEntry(source: source, types: types,
        next: map.get(index.heads, key)));
    let ignored = map.insert(index.heads, key, position);
}

// One index for the whole run.  The entries are sorted by function symbol and
// each node list keeps the original module-node order, so source_effect_nodes
// no longer rescans every function over the complete node table.
func function_node_index_find(entries Vec[hircore.FunctionNodeIndex], symbol usize) i64 {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let middle = low + (high - low) / 2;
        if entries[middle].symbol < symbol {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < vec.len(entries) && entries[low].symbol == symbol {
        return i64(low);
    }
    return -1;
}

func function_node_index_add(entries Vec[hircore.FunctionNodeIndex], symbol usize,
                             node usize) {
    let found = function_node_index_find(entries, symbol);
    if found >= 0 {
        vec.push(entries[usize(found)].nodes, node);
        return;
    }
    var position usize = 0;
    for position < vec.len(entries) && entries[position].symbol < symbol {
        position += 1;
    }
    let nodes = vec.empty[usize]();
    vec.push(nodes, node);
    vec.push(entries, hircore.FunctionNodeIndex(symbol: symbol, nodes: nodes));
    var index = vec.len(entries) - 1;
    for index > position {
        entries[index] = entries[index - 1];
        index -= 1;
    }
    entries[position] = hircore.FunctionNodeIndex(symbol: symbol, nodes: nodes);
}

func sort_function_node_index(values Vec[hircore.FunctionNodeIndex]) {
    let n = vec.len(values);
    if n < 2 {
        return;
    }
    let scratch = vec.empty[hircore.FunctionNodeIndex]();
    vec.reserve(scratch, n);
    for var index usize = 0; index < n; index += 1 {
        vec.push(scratch, values[index]);
    }
    var width usize = 1;
    for width < n {
        var left usize = 0;
        for left < n {
            var mid = left + width;
            if mid > n {
                mid = n;
            }
            var right = left + width * 2;
            if right > n {
                right = n;
            }
            var i = left;
            var j = mid;
            var out = left;
            for i < mid && j < right {
                if values[j].symbol < values[i].symbol {
                    scratch[out] = values[j];
                    j += 1;
                } else {
                    scratch[out] = values[i];
                    i += 1;
                }
                out += 1;
            }
            for i < mid {
                scratch[out] = values[i];
                i += 1;
                out += 1;
            }
            for j < right {
                scratch[out] = values[j];
                j += 1;
                out += 1;
            }
            left += width * 2;
        }
        for var index usize = 0; index < n; index += 1 {
            values[index] = scratch[index];
        }
        width *= 2;
    }
}

pub func build_function_node_index(state inout hircore.Verifier) {
    let sym_count = vec.len(state.m.resolved.symbols);
    let slot_by_sym = vec.make[i64](sym_count, -1);
    let entries = vec.empty[hircore.FunctionNodeIndex]();
    let overflow = vec.empty[hircore.FunctionNodeIndex]();
    for var index usize = 0; index < vec.len(state.m.nodes); index += 1 {
        let node = state.m.nodes[index];
        if node.scope < vec.len(state.m.scopes) {
            let symbol = state.m.scopes[node.scope].function;
            if symbol < sym_count {
                let slot = slot_by_sym[symbol];
                if slot < 0 {
                    slot_by_sym[symbol] = i64(vec.len(entries));
                    let nodes = vec.empty[usize]();
                    vec.push(nodes, index);
                    vec.push(entries, hircore.FunctionNodeIndex(symbol: symbol,
                        nodes: nodes));
                } else {
                    vec.push(entries[usize(slot)].nodes, index);
                }
            } else {
                function_node_index_add(overflow, symbol, index);
            }
        }
    }
    for entry in overflow {
        vec.push(entries, entry);
    }
    sort_function_node_index(entries);
    state.function_node_index = entries;
}

func node_type_unique(index NodeTypeIndex, source model.NodeRef)
    option.Option[usize] {
    switch node_type_find(index, source) {
        case option.Option.Some(position): {
            let types = index.entries[position].types;
            if vec.len(types) == 1 { return option.Option[usize].Some(types[0]); }
        }
        case option.Option.None: {}
    }
    return option.Option[usize].None;
}

pub func source_effect_nodes(state inout hircore.Verifier, function_value hir.HirFunction)
    throws hircore.Invalid {
    let reference = function_value.source.node;
    let file = hircore.verifier_file(state, reference.module, reference.file);
    let expected = vec.empty[CountEntry]();
    let actual = vec.empty[CountEntry]();
    let expected_foreign_reads = vec.empty[usize]();
    let expected_foreign_calls = vec.empty[usize]();
    let actual_foreign_reads = vec.empty[usize]();
    let actual_foreign_calls = vec.empty[usize]();
    let node_types = NodeTypeIndex(entries: vec.empty[NodeTypeEntry](),
        heads: map.new[u64, usize]());
    let function_nodes = function_node_index_find(state.function_node_index,
        function_value.symbol);
    if function_nodes >= 0 {
        for node_id in state.function_node_index[usize(function_nodes)].nodes {
            let node = state.m.nodes[node_id];
            node_type_add(node_types, node.source.node, node.type_id);
        }
    }
    let todo = vec.empty[usize]();
    vec.push(todo, reference.node);
    for vec.len(todo) > 0 {
        let id = hircore.option_usize(vec.pop(todo));
        let syntax = file.nodes[id];
        if id != reference.node &&
           (hircore.ast_is(syntax.kind, model.AstKind.Function) ||
            hircore.ast_is(syntax.kind, model.AstKind.FunctionLiteral) ||
            hircore.ast_is(syntax.kind, model.AstKind.FunctionType)) {
            continue;
        }
        if hircore.ast_is(syntax.kind, model.AstKind.Call) && vec.len(syntax.children) > 0 {
            let callee_raw = syntax.children[0];
            let target = source_unwrap_ast(state, file, callee_raw);
            let target_node = file.nodes[target];
            var is_foreign = false;
            let symbol = source_ast_symbol(state, reference.module, reference.file, file, target);
            if option.is_some(symbol) {
                let exported = hircore.foreign_export(state, hircore.option_usize(symbol));
                if option.is_some(exported) &&
                   vec.len(hircore.option_foreign_export(exported).candidates) > 0 {
                    hircore.ids_insert(expected_foreign_reads, target);
                    is_foreign = true;
                }
            }
            var method = target;
            if hircore.ast_is(target_node.kind, model.AstKind.NeutralBracket) &&
               vec.len(target_node.children) > 0 {
                method = source_unwrap_ast(state, file, target_node.children[0]);
            }
            let method_node = file.nodes[method];
            if !is_foreign && hircore.ast_is(method_node.kind, model.AstKind.Member) &&
               !option.is_some(source_ast_symbol(state, reference.module, reference.file, file, method)) {
                let base = source_ast_type(inout state, reference.module, reference.file, file, method_node.children[0],
                    0, node_types, function_value.symbol);
                if option.is_some(base) &&
                   hircore.kind_is(hircore.verifier_type(state, hircore.option_usize(base)).kind,
                       model.TypeKind.ForeignOpaque) {
                    hircore.ids_insert(expected_foreign_reads,
                        source_unwrap_ast(state, file, method));
                    is_foreign = true;
                }
            }
            if !is_foreign {
                let callee_type = source_ast_type(inout state, reference.module, reference.file, file,
                    syntax.children[0], 0, node_types, function_value.symbol);
                if option.is_some(callee_type) &&
                   hircore.kind_is(hircore.verifier_type(state, hircore.option_usize(callee_type)).kind,
                       model.TypeKind.ForeignOpaque) {
                    hircore.ids_insert(expected_foreign_reads, target);
                    is_foreign = true;
                }
            }
            if is_foreign {
                hircore.ids_insert(expected_foreign_calls, id);
            }
        }
        if hircore.ast_is(syntax.kind, model.AstKind.Name) ||
           hircore.ast_is(syntax.kind, model.AstKind.Member) {
            let key = source_unwrap_ast(state, file, id);
            let symbol = source_ast_symbol(state, reference.module, reference.file, file, id);
            if option.is_some(symbol) {
                let exported = hircore.foreign_export(state, hircore.option_usize(symbol));
                if option.is_some(exported) {
                    let export_value = hircore.option_foreign_export(exported);
                    if !option.is_some(export_value.c_type) &&
                       !option.is_some(export_value.c_callable) &&
                       (hircore.export_kind_is(export_value.kind,
                            model.ForeignExportKind.Value) ||
                        hircore.export_kind_is(export_value.kind,
                            model.ForeignExportKind.Function)) {
                        hircore.ids_insert(expected_foreign_reads, key);
                    }
                }
            }
            if hircore.ast_is(syntax.kind, model.AstKind.Member) &&
               !option.is_some(source_ast_symbol(state, reference.module, reference.file, file, id)) {
                let base = source_ast_type(inout state, reference.module, reference.file, file, syntax.children[0], 0,
                    node_types, function_value.symbol);
                if option.is_some(base) &&
                   hircore.kind_is(hircore.verifier_type(state, hircore.option_usize(base)).kind,
                       model.TypeKind.ForeignOpaque) {
                    hircore.ids_insert(expected_foreign_reads, key);
                }
            }
        }
        if hircore.ast_is(syntax.kind, model.AstKind.Try) ||
           hircore.ast_is(syntax.kind, model.AstKind.Defer) ||
           hircore.ast_is(syntax.kind, model.AstKind.Throw) ||
           hircore.ast_is(syntax.kind, model.AstKind.Catch) ||
           hircore.ast_is(syntax.kind, model.AstKind.List) ||
           hircore.ast_is(syntax.kind, model.AstKind.Slice) ||
           hircore.ast_is(syntax.kind, model.AstKind.ForIn) ||
           source_index_syntax(state, reference.module, reference.file, file, syntax) ||
           (hircore.ast_is(syntax.kind, model.AstKind.Unary) &&
            file.lexed.tokens[syntax.token_begin].spelling == "move") {
            count_add(expected, id);
        }
        for child in syntax.children {
            vec.push(todo, child);
        }
    }
    let synthetic_iterator_nodes = vec.empty[usize]();
    let scan = vec.empty[usize]();
    vec.push(scan, function_value.body);
    for vec.len(scan) > 0 {
        let scan_id = hircore.option_usize(vec.pop(scan));
        let scan_node = hircore.verifier_node(state, scan_id);
        switch scan_node.data {
            case hir.NodeData.ForIn(value): {
                if option.is_some(value.iterator) {
                    let iterator = hirnodes.option_iterator(value.iterator);
                    hircore.ids_insert(synthetic_iterator_nodes, iterator.next);
                    for child in hircore.verifier_node(state, iterator.next).children {
                        hircore.ids_insert(synthetic_iterator_nodes, child);
                    }
                }
            }
            default: {}
        }
        for child in scan_node.children {
            vec.push(scan, child);
        }
    }
    let pending = vec.empty[usize]();
    vec.push(pending, function_value.body);
    for vec.len(pending) > 0 {
        let current_id = hircore.option_usize(vec.pop(pending));
        let node = hircore.verifier_node(state, current_id);
        let syntax = file.nodes[node.source.node.node];
        if hircore.node_is(hir.node_kind(node.data), hir.NodeKind.ForeignRead) {
            var access = option.Option[hir.ForeignAccessKind].None;
            switch node.data {
                case hir.NodeData.ForeignRead(value): access = value.access;
                default: {}
            }
            if !option.is_some(access) || hircore.foreign_access_id(
                    option_foreign_access(access)) == 0 ||
               hircore.foreign_access_id(option_foreign_access(access)) == 1 {
                hircore.ids_insert(actual_foreign_reads,
                    source_unwrap_ast(state, file, node.source.node.node));
            }
        }
        if hircore.node_is(hir.node_kind(node.data), hir.NodeKind.Call) {
            var is_foreign = false;
            switch node.data {
                case hir.NodeData.Call(value): is_foreign = hircore.callee_id(value.kind) == 2;
                default: {}
            }
            if is_foreign {
                hircore.ids_insert(actual_foreign_calls, node.source.node.node);
            }
        }
        if !hircore.ids_contains(synthetic_iterator_nodes, current_id) &&
           (hircore.ast_is(syntax.kind, model.AstKind.Try) ||
            hircore.ast_is(syntax.kind, model.AstKind.Defer) ||
            hircore.ast_is(syntax.kind, model.AstKind.Throw) ||
            hircore.ast_is(syntax.kind, model.AstKind.List) ||
            hircore.ast_is(syntax.kind, model.AstKind.Slice) ||
            hircore.ast_is(syntax.kind, model.AstKind.ForIn) ||
            source_index_syntax(state, reference.module, reference.file, file, syntax) ||
            (hircore.ast_is(syntax.kind, model.AstKind.Unary) &&
             file.lexed.tokens[syntax.token_begin].spelling == "move")) {
            var matches = false;
            let node_kind = hir.node_kind(node.data);
            if hircore.ast_is(syntax.kind, model.AstKind.Try) &&
               hircore.node_is(node_kind, hir.NodeKind.Try) {
                matches = true;
            }
            if hircore.ast_is(syntax.kind, model.AstKind.Defer) &&
               hircore.node_is(node_kind, hir.NodeKind.Defer) {
                matches = true;
            }
            if hircore.ast_is(syntax.kind, model.AstKind.Throw) &&
               hircore.node_is(node_kind, hir.NodeKind.Throw) {
                matches = true;
            }
            if hircore.ast_is(syntax.kind, model.AstKind.List) &&
               hircore.node_is(node_kind, hir.NodeKind.VecInit) {
                matches = true;
            }
            if hircore.ast_is(syntax.kind, model.AstKind.Slice) {
                if hircore.node_is(node_kind, hir.NodeKind.VecSlice) {
                    matches = true;
                }
                if hircore.node_is(node_kind, hir.NodeKind.ForeignRead) {
                    var access = option.Option[hir.ForeignAccessKind].None;
                    switch node.data {
                        case hir.NodeData.ForeignRead(value): access = value.access;
                        default: {}
                    }
                    if option.is_some(access) &&
                       (hircore.foreign_access_id(option_foreign_access(access)) == 4 ||
                        hircore.foreign_access_id(option_foreign_access(access)) == 5) {
                        matches = true;
                    }
                }
            }
            if hircore.ast_is(syntax.kind, model.AstKind.ForIn) &&
               hircore.node_is(node_kind, hir.NodeKind.ForIn) {
                matches = true;
            }
            if hircore.ast_is(syntax.kind, model.AstKind.Unary) &&
               file.lexed.tokens[syntax.token_begin].spelling == "move" {
                if hircore.node_is(node_kind, hir.NodeKind.Move) {
                    matches = true;
                }
                if hircore.node_is(node_kind, hir.NodeKind.FunctionValue) {
                    var move_capture = false;
                    switch node.data {
                        case hir.NodeData.FunctionValue(value):
                            move_capture = value.move_capture;
                        default: {}
                    }
                    if move_capture {
                        matches = true;
                    }
                }
            }
            if source_index_syntax(state, reference.module, reference.file, file, syntax) {
                if hircore.node_is(node_kind, hir.NodeKind.IndexRead) ||
                   hircore.node_is(node_kind, hir.NodeKind.IndexPlace) {
                    matches = true;
                }
                if hircore.node_is(node_kind, hir.NodeKind.ForeignRead) {
                    var access = option.Option[hir.ForeignAccessKind].None;
                    switch node.data {
                        case hir.NodeData.ForeignRead(value): access = value.access;
                        default: {}
                    }
                    if option.is_some(access) &&
                       (hircore.foreign_access_id(option_foreign_access(access)) == 2 ||
                        hircore.foreign_access_id(option_foreign_access(access)) == 3) {
                        matches = true;
                    }
                }
            }
            hircore.need(matches,
                "source effect construct was erased or replaced");
            count_add(actual, node.source.node.node);
        }
        if hircore.node_is(hir.node_kind(node.data), hir.NodeKind.Try) {
            var try_value = hir.Try(catches: []);
            switch node.data {
                case hir.NodeData.Try(value): try_value = value;
                default: {}
            }
            for handler in try_value.catches {
                count_add(actual, handler.source.node.node);
            }
        }
        for child in node.children {
            vec.push(pending, child);
        }
    }
    hircore.need(hircore.ids_equal(actual_foreign_reads, expected_foreign_reads),
        "HIR foreign reads differ from source operations");
    hircore.need(hircore.ids_equal(actual_foreign_calls, expected_foreign_calls),
        "HIR foreign calls differ from source operations");
    hircore.need(count_equal(actual, expected),
        "HIR omits or duplicates source error/cleanup constructs");
    var owning = false;
    if function_nodes >= 0 {
        for node_id in state.function_node_index[usize(function_nodes)].nodes {
            let node = state.m.nodes[node_id];
            let kind = hir.node_kind(node.data);
            if hircore.node_is(kind, hir.NodeKind.Move) ||
               hircore.node_is(kind, hir.NodeKind.ForIn) ||
               (!hircore.node_is(kind, hir.NodeKind.FunctionValue) &&
                hircore.classify_needs_drop(inout state, node.type_id)) {
                owning = true;
            }
        }
    }
    if vec.len(expected) == 0 && !owning {
        return;
    }
    let syntax_function = file.nodes[reference.node];
    hircore.need(vec.len(syntax_function.children) > 0, "function has no source body");
    hircore.need(exact_source_child(state, function_value, function_value.body,
             syntax_function.children[vec.len(syntax_function.children) - 1]),
        "HIR statement source order/control owner differs from AST");
    let statements = vec.empty[usize]();
    vec.push(statements, function_value.body);
    for vec.len(statements) > 0 {
        let id = hircore.option_usize(vec.pop(statements));
        let node = hircore.verifier_node(state, id);
        let syntax = file.nodes[node.source.node.node];
        let node_kind = hir.node_kind(node.data);
        if hircore.node_is(node_kind, hir.NodeKind.Block) {
            let sequence = vec.empty[usize]();
            if hircore.ast_is(syntax.kind, model.AstKind.Block) {
                for child in syntax.children {
                    vec.push(sequence, child);
                }
            } else if hircore.ast_is(syntax.kind, model.AstKind.Case) {
                var start usize = 0;
                if file.lexed.tokens[syntax.token_begin].spelling != "default" {
                    start = 1;
                }
                for var index usize = start; index < vec.len(syntax.children);
                    index += 1 {
                    vec.push(sequence, syntax.children[index]);
                }
            } else if hircore.ast_is(syntax.kind, model.AstKind.If) {
                vec.push(sequence, node.source.node.node);
            } else {
                hircore.fail("lexical block has no supported AST statement sequence");
            }
            hircore.need(vec.len(node.children) == vec.len(sequence),
                "HIR omits or adds a source statement");
            for var index usize = 0; index < vec.len(sequence); index += 1 {
                hircore.need(exact_source_child(state, function_value, node.children[index],
                         sequence[index]),
                    "HIR statement source order/control owner differs from AST");
            }
        } else if hircore.node_is(node_kind, hir.NodeKind.If) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.If), "statement kind differs from its AST source");
            hircore.need(vec.len(node.children) == vec.len(syntax.children),
                "if source branch count");
            for var branch usize = 1; branch < vec.len(node.children); branch += 1 {
                hircore.need(exact_source_child(state, function_value,
                         node.children[branch], syntax.children[branch]),
                    "HIR statement source order/control owner differs from AST");
            }
        } else if hircore.node_is(node_kind, hir.NodeKind.ForIn) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.ForIn),
                "statement kind differs from its AST source");
            hircore.need(exact_source_child(state, function_value, node.children[1],
                     syntax.children[vec.len(syntax.children) - 1]),
                "HIR statement source order/control owner differs from AST");
        } else if hircore.node_is(node_kind, hir.NodeKind.For) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.For),
                "statement kind differs from its AST source");
            hircore.need(exact_source_child(state, function_value, node.children[3],
                     syntax.children[vec.len(syntax.children) - 1]),
                "HIR statement source order/control owner differs from AST");
        } else if hircore.node_is(node_kind, hir.NodeKind.Switch) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Switch),
                "statement kind differs from its AST source");
            var switch_value = hir.Switch(arms: [], exhaustive: false);
            switch node.data {
                case hir.NodeData.Switch(value): switch_value = value;
                default: {}
            }
            hircore.need(vec.len(syntax.children) == vec.len(switch_value.arms) + 1,
                "switch source arm count");
            for var arm usize = 0; arm < vec.len(switch_value.arms); arm += 1 {
                hircore.need(exact_source_child(state, function_value,
                         switch_value.arms[arm].body,
                         syntax.children[arm + 1]),
                    "HIR statement source order/control owner differs from AST");
            }
        } else if hircore.node_is(node_kind, hir.NodeKind.Binding) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Binding),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Assign) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Assign),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.ExpressionStatement) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.ExpressionStatement),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Return) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Return),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Break) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Break),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Continue) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Continue),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Noop) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.For),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Try) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Try),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Defer) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Defer),
                "statement kind differs from its AST source");
        } else if hircore.node_is(node_kind, hir.NodeKind.Throw) {
            hircore.need(hircore.ast_is(syntax.kind, model.AstKind.Throw),
                "statement kind differs from its AST source");
        }
        for child in node.children {
            vec.push(statements, child);
        }
    }
}

func exact_source_child(state hircore.Verifier, function_value hir.HirFunction,
                        child usize, syntax usize) bool throws hircore.Invalid {
    let file = hircore.verifier_file(state, function_value.source.node.module,
        function_value.source.node.file);
    var expected = function_value.source.node;
    let syntax_node = file.nodes[syntax];
    if hircore.ast_is(syntax_node.kind, model.AstKind.Unsafe) {
        if vec.len(syntax_node.children) != 1 ||
           !hircore.ast_is(file.nodes[syntax_node.children[0]].kind,
               model.AstKind.Block) {
            return false;
        }
        expected.node = syntax_node.children[0];
    } else {
        expected.node = syntax;
    }
    return hircore.same_ref(hircore.verifier_node(state, child).source.node, expected);
}

func source_unwrap_ast(state hircore.Verifier, file model.ParseResult, id usize)
    usize {
    var value = id;
    for true {
        let node = file.nodes[value];
        var transparent = hircore.ast_is(node.kind, model.AstKind.Parenthesized) ||
                          hircore.ast_is(node.kind, model.AstKind.BracketItem);
        if hircore.ast_is(node.kind, model.AstKind.Unary) {
            transparent = node.token_begin < vec.len(file.lexed.tokens) &&
                file.lexed.tokens[node.token_begin].spelling == "+";
        }
        if !transparent {
            return value;
        }
        if vec.len(node.children) == 0 {
            return value;
        }
        value = node.children[0];
    }
    return value;
}

func source_ast_symbol(state hircore.Verifier, module usize, file_index usize,
                       file model.ParseResult, id usize)
    option.Option[usize] {
    let target = source_unwrap_ast(state, file, id);
    for occurrence in state.m.resolved.occurrences {
        if occurrence.source.module == module &&
           occurrence.source.file == file_index &&
           occurrence.source.node == target {
            return option.Option[usize].Some(occurrence.symbol);
        }
    }
    return option.Option[usize].None;
}

func source_index_syntax(state hircore.Verifier, module usize, file_index usize,
                         file model.ParseResult, syntax model.AstNode) bool
    throws hircore.Invalid {
    if !hircore.ast_is(syntax.kind, model.AstKind.NeutralBracket) {
        return false;
    }
    var types_only = vec.len(syntax.children) > 1;
    for var index usize = 1; index < vec.len(syntax.children); index += 1 {
        if !source_type_syntax(state, module, file_index, file, syntax.children[index]) {
            types_only = false;
        }
    }
    if types_only {
        return false;
    }
    if vec.len(syntax.children) == 0 {
        return true;
    }
    let symbol = source_ast_symbol(state, module, file_index, file, syntax.children[0]);
    if option.is_some(symbol) {
        let kind = hircore.verifier_symbol(state, hircore.option_usize(symbol)).kind;
        return !hircore.symbol_is(kind, model.SymbolKind.Function) &&
               !hircore.symbol_is(kind, model.SymbolKind.Type) &&
               !hircore.symbol_is(kind, model.SymbolKind.BuiltinType) &&
               !hircore.symbol_is(kind, model.SymbolKind.TypeParameter);
    }
    return true;
}

func source_type_syntax(state hircore.Verifier, module usize, file_index usize,
                        file model.ParseResult, id usize) bool throws hircore.Invalid {
    let node = file.nodes[id];
    if hircore.ast_is(node.kind, model.AstKind.FunctionType) ||
       hircore.ast_is(node.kind, model.AstKind.NamedType) {
        return true;
    }
    if hircore.ast_is(node.kind, model.AstKind.BracketItem) ||
       hircore.ast_is(node.kind, model.AstKind.Parenthesized) ||
       hircore.ast_is(node.kind, model.AstKind.ParenthesizedType) {
        return vec.len(node.children) > 0 &&
            source_type_syntax(state, module, file_index, file, node.children[0]);
    }
    if hircore.ast_is(node.kind, model.AstKind.NeutralBracket) {
        return vec.len(node.children) > 0 &&
            source_type_syntax(state, module, file_index, file, node.children[0]);
    }
    let symbol = source_ast_symbol(state, module, file_index, file, id);
    if option.is_some(symbol) {
        let kind = hircore.verifier_symbol(state, hircore.option_usize(symbol)).kind;
        return hircore.symbol_is(kind, model.SymbolKind.Type) ||
               hircore.symbol_is(kind, model.SymbolKind.BuiltinType) ||
               hircore.symbol_is(kind, model.SymbolKind.TypeParameter);
    }
    return false;
}

// A source occurrence can name a local whose HIR has more than one node at
// the same source identity.  In particular a foreign callable local has the
// owner-typed receiver Read and the synthetic ForeignCallable callee
// ForeignRead at the same source node, so the unique-node-type fallback cannot
// recover the local's declared type.  Resolve the local first, including
// instance renames, exactly like the C++ verifier's local_type lookup.
func source_local_type(state hircore.Verifier, module usize, file_index usize,
                       file model.ParseResult, id usize,
                       function_symbol usize) option.Option[usize] {
    let symbol = source_ast_symbol(state, module, file_index, file, id);
    if !option.is_some(symbol) {
        return option.Option[usize].None;
    }
    var symbol_id = hircore.option_usize(symbol);
    for instance in state.m.instances {
        if instance.symbol == function_symbol {
            for rename in instance.renamed {
                if rename.origin == symbol_id {
                    symbol_id = rename.replacement;
                    break;
                }
            }
        }
    }
    let found = hircore.local_index(state, symbol_id);
    if found < 0 {
        return option.Option[usize].None;
    }
    let local = state.locals[usize(found)].value;
    if local.function != function_symbol {
        return option.Option[usize].None;
    }
    return option.Option[usize].Some(local.type_id);
}

func source_ast_type(state inout hircore.Verifier, module usize, file_index usize,
                     file model.ParseResult, id usize, depth usize,
                     node_types NodeTypeIndex, function_symbol usize)
    option.Option[usize] throws hircore.Invalid {
    if depth > 64 {
        return option.Option[usize].None;
    }
    let unwrapped = source_unwrap_ast(state, file, id);
    let node = file.nodes[unwrapped];
    if hircore.ast_is(node.kind, model.AstKind.Name) ||
       hircore.ast_is(node.kind, model.AstKind.Member) {
        let local = source_local_type(state, module, file_index, file,
            unwrapped, function_symbol);
        if option.is_some(local) {
            return local;
        }
        let symbol = source_ast_symbol(state, module, file_index, file, unwrapped);
        if option.is_some(symbol) {
            let exported = hircore.foreign_export(state, hircore.option_usize(symbol));
            if option.is_some(exported) {
                let declaration = hircore.option_foreign_export(exported).declaration;
                if option.is_some(declaration) &&
                   hircore.option_usize(declaration) < vec.len(state.m.foreign_bindings) {
                    return option.Option[usize].Some(
                        state.m.foreign_bindings[hircore.option_usize(declaration)].type_id);
                }
            }
        }
        if hircore.ast_is(node.kind, model.AstKind.Member) &&
           vec.len(node.children) > 0 {
            let base = source_ast_type(inout state, module, file_index, file, node.children[0], depth + 1,
                node_types, function_symbol);
            if option.is_some(base) {
                let base_type = hircore.verifier_type(state, hircore.option_usize(base));
                if hircore.kind_is(base_type.kind, model.TypeKind.ForeignOpaque) {
                    let owner = hircalls.foreign_declaration(state, base_type.binding);
                    let owner_type = hircalls.option_binding_type(owner.detail);
                    let name = source_member_name(file, unwrapped);
                    for member in owner_type.members {
                        let member_decl = hircalls.foreign_declaration(state, member);
                        var callable = false;
                        switch member_decl.detail {
                            case model.ForeignDetail.Callable(value):
                                callable = value.call_kind == "method" &&
                                    member_decl.name == name;
                            default: {}
                        }
                        if callable {
                            return option.Option[usize].Some(
                                state.m.foreign_bindings[member].type_id);
                        }
                    }
                    for member in owner_type.properties {
                        if hircalls.foreign_declaration(state, member).name == name {
                            return option.Option[usize].Some(
                                state.m.foreign_bindings[member].type_id);
                        }
                    }
                }
                if hircore.kind_is(base_type.kind, model.TypeKind.NominalStruct) {
                    let declaration = hircore.nominal_type(state, hircore.option_usize(base));
                    for field in declaration.fields {
                        if hircore.verifier_symbol(state, field.symbol).name ==
                           source_member_name(file, unwrapped) {
                            return option.Option[usize].Some(
                                hircore.field_type(inout state, hircore.option_usize(base), field));
                        }
                    }
                }
            }
        }
        let unique = node_type_unique(node_types, model.NodeRef(module: module, file: file_index, node: unwrapped));
        if option.is_some(unique) {
            return unique;
        }
        return option.Option[usize].None;
    }
    if hircore.ast_is(node.kind, model.AstKind.Call) && vec.len(node.children) > 0 {
        let callee = node.children[0];
        let target = source_unwrap_ast(state, file, callee);
        let target_node = file.nodes[target];
        let symbol = source_ast_symbol(state, module, file_index, file, target);
        if option.is_some(symbol) {
            let exported = hircore.foreign_export(state, hircore.option_usize(symbol));
            if option.is_some(exported) &&
               vec.len(hircore.option_foreign_export(exported).candidates) > 0 {
                return common_foreign_result(state,
                    hircore.option_foreign_export(exported).candidates);
            }
            if hircore.symbol_is(hircore.verifier_symbol(state, hircore.option_usize(symbol)).kind,
                         model.SymbolKind.Function) {
                let found = hircore.function_entry_index(state, hircore.option_usize(symbol));
                if found >= 0 {
                    return option.Option[usize].Some(hircore.verifier_type(state,
                        hircore.verifier_function(state,
                            hircore.option_usize(symbol)).signature).result);
                }
            }
        }
        var method = target;
        if hircore.ast_is(target_node.kind, model.AstKind.NeutralBracket) &&
           vec.len(target_node.children) > 0 {
            method = source_unwrap_ast(state, file, target_node.children[0]);
        }
        let method_node = file.nodes[method];
        if hircore.ast_is(method_node.kind, model.AstKind.Member) &&
           !option.is_some(source_ast_symbol(state, module, file_index, file, method)) {
            let base = source_ast_type(inout state, module, file_index, file, method_node.children[0],
                depth + 1, node_types, function_symbol);
            if option.is_some(base) &&
               hircore.kind_is(hircore.verifier_type(state, hircore.option_usize(base)).kind,
                   model.TypeKind.ForeignOpaque) {
                let candidates = source_method_candidates(state,
                    hircore.option_usize(base), source_member_name(file, method));
                if vec.len(candidates) > 0 {
                    return common_foreign_result(state, candidates);
                }
            }
        }
        let callee_type = source_ast_type(inout state, module, file_index, file, callee, depth + 1,
            node_types, function_symbol);
        if option.is_some(callee_type) {
            let kind = hircore.verifier_type(state, hircore.option_usize(callee_type)).kind;
            if hircore.kind_is(kind, model.TypeKind.Function) {
                return option.Option[usize].Some(
                    hircore.verifier_type(state, hircore.option_usize(callee_type)).result);
            }
            if hircore.kind_is(kind, model.TypeKind.ForeignOpaque) {
                let candidates = source_callable_candidates(state,
                    hircore.option_usize(callee_type));
                if vec.len(candidates) > 0 {
                    return common_foreign_result(state, candidates);
                }
            }
        }
        return node_type_unique(node_types, model.NodeRef(module: module, file: file_index, node: unwrapped));
    }
    if hircore.ast_is(node.kind, model.AstKind.NeutralBracket) &&
       vec.len(node.children) == 2 {
        let base = source_ast_type(inout state, module, file_index, file, node.children[0], depth + 1,
            node_types, function_symbol);
        if option.is_some(base) {
            let base_type = hircore.verifier_type(state, hircore.option_usize(base));
            if hircore.kind_is(base_type.kind, model.TypeKind.ForeignOpaque) {
                let owner = hircalls.foreign_declaration(state, base_type.binding);
                let owner_type = hircalls.option_binding_type(owner.detail);
                if vec.len(owner_type.indexers) > 0 {
                    return option.Option[usize].Some(
                        state.m.foreign_bindings[owner_type.indexers[0]].type_id);
                }
            }
            if hircore.kind_is(base_type.kind, model.TypeKind.Vec) ||
               hircore.kind_is(base_type.kind, model.TypeKind.Slice) {
                return option.Option[usize].Some(base_type.type_args[0]);
            }
        }
    }
    if hircore.ast_is(node.kind, model.AstKind.Slice) {
        let base = source_ast_type(inout state, module, file_index, file, node.children[0], depth + 1,
            node_types, function_symbol);
        if option.is_some(base) {
            let base_type = hircore.verifier_type(state, hircore.option_usize(base));
            if hircore.kind_is(base_type.kind, model.TypeKind.ForeignOpaque) {
                let owner = hircalls.foreign_declaration(state, base_type.binding);
                let owner_type = hircalls.option_binding_type(owner.detail);
                if vec.len(owner_type.slices) > 0 {
                    return option.Option[usize].Some(
                        state.m.foreign_bindings[owner_type.slices[0]].type_id);
                }
            }
            if hircore.kind_is(base_type.kind, model.TypeKind.Vec) ||
               hircore.kind_is(base_type.kind, model.TypeKind.Slice) {
                return base;
            }
        }
    }
    return option.Option[usize].None;
}

func source_member_name(file model.ParseResult, id usize) string {
    let node = file.nodes[id];
    if node.token_end <= node.token_begin ||
       node.token_end > vec.len(file.lexed.tokens) {
        return "";
    }
    return file.lexed.tokens[node.token_end - 1].spelling;
}

func common_foreign_result(state hircore.Verifier, candidates Vec[usize])
    option.Option[usize] throws hircore.Invalid {
    var result = option.Option[usize].None;
    for candidate in candidates {
        if candidate >= vec.len(state.m.foreign_bindings) {
            return option.Option[usize].None;
        }
        let binding = state.m.foreign_bindings[candidate];
        if !option.is_some(binding.signature) {
            return option.Option[usize].None;
        }
        let value = hircore.verifier_type(state, hircore.option_usize(binding.signature)).result;
        if option.is_some(result) && hircore.option_usize(result) != value {
            return option.Option[usize].None;
        }
        result = option.Option[usize].Some(value);
    }
    return result;
}

func source_method_candidates(state hircore.Verifier, receiver usize, name string)
    Vec[usize] throws hircore.Invalid {
    let result = vec.empty[usize]();
    let receiver_type = hircore.verifier_type(state, receiver);
    if !hircore.kind_is(receiver_type.kind, model.TypeKind.ForeignOpaque) {
        return result;
    }
    let owner = hircalls.foreign_declaration(state, receiver_type.binding);
    var owner_type = hircalls.option_binding_type(owner.detail);
    for member in owner_type.members {
        let declaration = hircalls.foreign_declaration(state, member);
        var callable = false;
        switch declaration.detail {
            case model.ForeignDetail.Callable(value):
                callable = value.call_kind == "method" &&
                    declaration.name == name;
            default: {}
        }
        if callable {
            vec.push(result, member);
        }
    }
    return result;
}

func source_callable_candidates(state hircore.Verifier, receiver usize) Vec[usize]
    throws hircore.Invalid {
    let result = vec.empty[usize]();
    let receiver_type = hircore.verifier_type(state, receiver);
    if !hircore.kind_is(receiver_type.kind, model.TypeKind.ForeignOpaque) {
        return result;
    }
    let owner = hircalls.foreign_declaration(state, receiver_type.binding);
    let owner_type = hircalls.option_binding_type(owner.detail);
    for member in owner_type.members {
        let declaration = hircalls.foreign_declaration(state, member);
        var callable = false;
        switch declaration.detail {
            case model.ForeignDetail.Callable(value):
                callable = value.call_kind == "callable";
            default: {}
        }
        if callable {
            vec.push(result, member);
        }
    }
    return result;
}

func option_foreign_access(value option.Option[hir.ForeignAccessKind])
    hir.ForeignAccessKind {
    switch value {
        case option.Option.Some(item): return item;
        case option.Option.None: return hir.ForeignAccessKind.PropertyRead;
    }
}
