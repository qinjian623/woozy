package hirverify;

import "app/wzcc/hirverify/backend" as hirbackend;
import "app/wzcc/hirverify/core" as hircore;
import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;

pub func check_backend_capabilities(input hir.HirModule) model.UnitResult {
    let verified = verify_types(input);
    if !hircore.phase_is(verified.state, model.PhaseState.Complete) ||
       !verified.has_value {
        return verified;
    }
    return hirbackend.check_backend_capabilities_verified(input);
}

pub func check_backend_capabilities_verified(input hir.HirModule) model.UnitResult {
    return hirbackend.check_backend_capabilities_verified(input);
}
