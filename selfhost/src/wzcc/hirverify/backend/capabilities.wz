// Backend capability checks.  Only executable functions and the concrete
// storage types they reach are examined; unused templates are not rejected.
package backend;

import "app/wzcc/hirverify/calls" as hircalls;
import "app/wzcc/hirverify/core" as hircore;
import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/vec" as vec;

struct CapabilityFlags {
    ownership_values bool;
    foreign_values bool;
    runtime_handle_values bool;
    slice_values bool;
    weak_values bool;
    c_values bool;
}

struct CapabilityState {
    storage types.Context;
    checked Vec[usize];
    budget bool;
    nominal_map Vec[i64];
    nominal_overflow Vec[hircore.NominalEntry];
}

func capability_flags(config model.CheckConfig) CapabilityFlags {
    let native = hircore.backend_is(config.backend, model.Backend.Native);
    let python = hircore.backend_is(config.backend, model.Backend.Python);
    let word64 = config.word_bits == 64;
    return CapabilityFlags(
        ownership_values: (native || python) && word64,
        foreign_values: python && word64,
        runtime_handle_values: native && word64,
        slice_values: (native || python) && word64,
        weak_values: (native || python) && word64,
        c_values: native && word64);
}

func capability_supported(state inout CapabilityState, module hir.HirModule,
                          flags CapabilityFlags, id usize, depth usize) bool
    throws hircore.Invalid {
    if depth > 512 || vec.len(state.checked) > 65536 {
        state.budget = true;
        return false;
    }
    var value = option.Option[model.Type].None;
    switch types.find(state.storage, id) {
        case option.Option.Some(item): value = option.Option[model.Type].Some(item);
        case option.Option.None: return false;
    }
    let t = hircore.option_usize_type(value);
    if hircore.runtime_handle_kind(t.kind) {
        return flags.runtime_handle_values;
    }
    if hircore.kind_is(t.kind, model.TypeKind.ForeignOpaque) ||
       hircore.kind_is(t.kind, model.TypeKind.ForeignCallable) {
        return flags.foreign_values;
    }
    if hircore.c_pointer_kind(t.kind) || hircore.c_named_kind(t.kind) {
        if !flags.c_values {
            return false;
        }
        for argument in t.type_args {
            let exists = types.find(state.storage, argument);
            if !option.is_some(exists) ||
               !capability_supported(inout state, module, flags, argument,
                   depth + 1) {
                return false;
            }
        }
        return true;
    }
    if hircore.ids_contains(state.checked, id) {
        return true;
    }
    hircore.ids_insert(state.checked, id);
    if hircore.kind_is(t.kind, model.TypeKind.Vec) ||
       hircore.kind_is(t.kind, model.TypeKind.Slice) ||
       hircore.kind_is(t.kind, model.TypeKind.Weak) {
        if hircore.kind_is(t.kind, model.TypeKind.Slice) && !flags.slice_values {
            return false;
        }
        if hircore.kind_is(t.kind, model.TypeKind.Weak) && !flags.weak_values {
            return false;
        }
        if !flags.ownership_values || vec.len(t.type_args) != 1 ||
           !option.is_some(types.find(state.storage, t.type_args[0])) {
            return false;
        }
        return capability_supported(inout state, module, flags, t.type_args[0],
            depth + 1);
    }
    if hircore.kind_is(t.kind, model.TypeKind.TraitObject) {
        if !flags.ownership_values {
            return false;
        }
        for argument in t.type_args {
            if !option.is_some(types.find(state.storage, argument)) ||
               !capability_supported(inout state, module, flags, argument,
                   depth + 1) {
                return false;
            }
        }
        return true;
    }
    if hircore.kind_is(t.kind, model.TypeKind.NominalStruct) ||
       hircore.kind_is(t.kind, model.TypeKind.NominalEnum) {
        let declared = capability_nominal_index(state, t.declaration);
        if declared < 0 ||
           vec.len(t.type_args) != vec.len(module.nominals[usize(declared)].params) {
            return false;
        }
        let declaration = module.nominals[usize(declared)];
        let substitutions = vec.empty[model.Substitution]();
        for var p usize = 0; p < vec.len(declaration.params); p += 1 {
            vec.push(substitutions, model.Substitution(
                symbol: declaration.params[p].symbol,
                type_id: t.type_args[p]));
        }
        for field in declaration.fields {
            let concrete = substitute_backend(inout state, field.type_id,
                substitutions);
            if !option.is_some(types.find(module.types, concrete)) ||
               !option.is_some(types.find(state.storage, concrete)) ||
               !capability_supported(inout state, module, flags, concrete,
                   depth + 1) {
                return false;
            }
        }
        for variant in declaration.variants {
            for field in variant.payload {
                let concrete = substitute_backend(inout state, field.type_id,
                    substitutions);
                if !option.is_some(types.find(module.types, concrete)) ||
                   !option.is_some(types.find(state.storage, concrete)) ||
                   !capability_supported(inout state, module, flags, concrete,
                       depth + 1) {
                    return false;
                }
            }
        }
        return true;
    }
    if hircore.kind_is(t.kind, model.TypeKind.Function) {
        let pending = vec.empty[usize]();
        vec.push(pending, id);
        let seen = vec.empty[usize]();
        for vec.len(pending) > 0 {
            if vec.len(pending) > 65536 {
                state.budget = true;
                return false;
            }
            let current = hircore.option_usize(vec.pop(pending));
            if !hircore.ids_insert(seen, current) {
                continue;
            }
            var found = option.Option[model.Type].None;
            switch types.find(state.storage, current) {
                case option.Option.Some(item): found = option.Option[model.Type].Some(item);
                case option.Option.None: return false;
            }
            let value = hircore.option_usize_type(found);
            if hircore.runtime_handle_kind(value.kind) {
                if !flags.runtime_handle_values {
                    return false;
                }
                continue;
            }
            if hircore.kind_is(value.kind, model.TypeKind.ForeignOpaque) ||
               hircore.kind_is(value.kind, model.TypeKind.ForeignCallable) {
                if !flags.foreign_values {
                    return false;
                }
                continue;
            }
            if hircore.kind_is(value.kind, model.TypeKind.Vec) ||
               hircore.kind_is(value.kind, model.TypeKind.Slice) ||
               hircore.kind_is(value.kind, model.TypeKind.Weak) {
                if hircore.kind_is(value.kind, model.TypeKind.Slice) &&
                   !flags.slice_values {
                    return false;
                }
                if hircore.kind_is(value.kind, model.TypeKind.Weak) &&
                   !flags.weak_values {
                    return false;
                }
                if !flags.ownership_values || vec.len(value.type_args) != 1 ||
                   !option.is_some(types.find(state.storage,
                       value.type_args[0])) {
                    return false;
                }
            }
            if hircore.kind_is(value.kind, model.TypeKind.NominalStruct) ||
               hircore.kind_is(value.kind, model.TypeKind.NominalEnum) {
                let declared = capability_nominal_index(state,
                    value.declaration);
                if declared >= 0 {
                    let declaration = module.nominals[usize(declared)];
                    for field in declaration.fields {
                        if !option.is_some(types.find(module.types,
                                field.type_id)) ||
                           !option.is_some(types.find(state.storage,
                                field.type_id)) {
                            return false;
                        }
                        vec.push(pending, field.type_id);
                    }
                    for variant in declaration.variants {
                        for field in variant.payload {
                            if !option.is_some(types.find(module.types,
                                    field.type_id)) ||
                               !option.is_some(types.find(state.storage,
                                    field.type_id)) {
                                return false;
                            }
                            vec.push(pending, field.type_id);
                        }
                    }
                }
            }
            for argument in value.type_args {
                vec.push(pending, argument);
            }
            if hircore.kind_is(value.kind, model.TypeKind.Function) {
                vec.push(pending, value.result);
                if option.is_some(value.throws_type) {
                    vec.push(pending, hircore.option_usize(value.throws_type));
                }
                for parameter in value.parameters {
                    if hircore.mode_is_id(parameter.mode, 2) &&
                       !flags.ownership_values {
                        return false;
                    }
                    vec.push(pending, parameter.type_id);
                }
            }
        }
    }
    return !hircore.kind_is(t.kind, model.TypeKind.Vec) &&
           !hircore.kind_is(t.kind, model.TypeKind.Slice) &&
           !hircore.kind_is(t.kind, model.TypeKind.TypeParameter) &&
           !hircore.kind_is(t.kind, model.TypeKind.Error) &&
           !hircore.kind_is(t.kind, model.TypeKind.ForeignOpaque) &&
           !hircore.kind_is(t.kind, model.TypeKind.ForeignCallable) &&
           !hircore.c_pointer_kind(t.kind) && !hircore.c_named_kind(t.kind);
}

func capability_nominal_insert(entries Vec[hircore.NominalEntry], symbol usize,
                               index usize) {
    var low usize = 0;
    var high = vec.len(entries);
    for low < high {
        let mid = low + (high - low) / 2;
        if entries[mid].symbol < symbol {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    if low < vec.len(entries) && entries[low].symbol == symbol {
        return;
    }
    vec.push(entries, hircore.NominalEntry(symbol: 0, index: 0));
    var cur = vec.len(entries) - 1;
    for cur > low {
        entries[cur] = entries[cur - 1];
        cur -= 1;
    }
    entries[low] = hircore.NominalEntry(symbol: symbol, index: index);
}

func capability_nominal_index(state CapabilityState, symbol usize) i64 {
    if symbol < vec.len(state.nominal_map) {
        return state.nominal_map[symbol];
    }
    var low usize = 0;
    var high = vec.len(state.nominal_overflow);
    for low < high {
        let mid = low + (high - low) / 2;
        if state.nominal_overflow[mid].symbol < symbol {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    if low < vec.len(state.nominal_overflow) &&
       state.nominal_overflow[low].symbol == symbol {
        return i64(state.nominal_overflow[low].index);
    }
    return -1;
}

func make_capability_state(input hir.HirModule) CapabilityState {
    let sym_count = vec.len(input.resolved.symbols);
    let nominal_map = vec.make[i64](sym_count, -1);
    let overflow = vec.empty[hircore.NominalEntry]();
    for var index usize = 0; index < vec.len(input.nominals); index += 1 {
        let sym = input.nominals[index].symbol;
        if sym < sym_count {
            if nominal_map[sym] < 0 {
                nominal_map[sym] = i64(index);
            }
        } else {
            capability_nominal_insert(overflow, sym, index);
        }
    }
    return CapabilityState(storage: types.clone_context(input.types),
        checked: vec.empty[usize](), budget: false, nominal_map: nominal_map,
        nominal_overflow: overflow);
}

func substitute_backend(state inout CapabilityState, id usize,
                        substitutions Vec[model.Substitution]) usize
    throws hircore.Invalid {
    try {
        return types.substitute(id, substitutions, inout state.storage);
    } catch error types.Error {
        hircore.type_error_to_invalid(error);
        return 0;
    }
}

func capability_signature_supported(state inout CapabilityState,
                                    module hir.HirModule,
                                    flags CapabilityFlags, id usize) bool
    throws hircore.Invalid {
    let found = types.find(module.types, id);
    if !option.is_some(found) {
        return false;
    }
    let signature = hircore.option_usize_type(found);
    if option.is_some(signature.throws_type) &&
       !capability_supported(inout state, module, flags,
           hircore.option_usize(signature.throws_type), 0) {
        return false;
    }
    for parameter in signature.parameters {
        if hircore.mode_is_id(parameter.mode, 2) && !flags.ownership_values {
            return false;
        }
        if !capability_supported(inout state, module, flags, parameter.type_id,
                                 0) {
            return false;
        }
    }
    return capability_supported(inout state, module, flags, signature.result, 0);
}

func capability_unavailable(feature string, span model.Span)
    model.UnitResult {
    let diagnostics = vec.empty[model.Diagnostic]();
    vec.push(diagnostics, model.diagnostic("E_CAPABILITY_UNAVAILABLE", "type",
        feature, span));
    return model.UnitResult(state: model.PhaseState.Failed,
        failure: model.FailureKind.Unsupported, diagnostics: diagnostics,
        has_value: false);
}

// Categories mirror the C++ capability gate: 0 is the
// value_system_operations family that Python can lower, 1/2 are the
// separately gated std/slice and std/weak families, and 3 is every remaining
// operation (std/os, runtime handles, network, process, ffi, async, ...),
// which requires Native/64.  The generated OperationSpec.owner field is the
// typed identity; this is not a source-name check.
func system_op_category(operation u32) u32 {
    let spec = hircalls.system_spec(operation);
    if !spec.has {
        return 3;
    }
    if spec.owner == "std/slice" {
        return 1;
    }
    if spec.owner == "std/weak" {
        return 2;
    }
    if spec.owner == "std/unicode" || spec.owner == "std/text" ||
       spec.owner == "std/vec" || spec.owner == "std/strconv" ||
       spec.owner == "std/math" || spec.name == "__woozy_map_probe_requires_copy" {
        return 0;
    }
    return 3;
}

// Capability scan over an already verified module.  Package verification calls
// this after its external-aware verify_types pass.
pub func check_backend_capabilities_verified(input hir.HirModule) model.UnitResult {
    let flags = capability_flags(input.config);
    var capability = make_capability_state(input);
    let native64 = hircore.backend_is(input.config.backend, model.Backend.Native) &&
        input.config.word_bits == 64;
    for function_value in input.functions {
        var signature_ok = false;
        try {
            signature_ok = capability_signature_supported(inout capability,
                input, flags, function_value.signature);
        } catch error hircore.Invalid {
            signature_ok = false;
        }
        if !signature_ok {
            if capability.budget {
                return capability_unavailable(
                    "backend concrete type expansion budget exceeded",
                    function_value.source.span);
            }
            return capability_unavailable(
                "backend does not support this concrete function signature",
                function_value.source.span);
        }
        let todo = vec.empty[usize]();
        vec.push(todo, function_value.body);
        for vec.len(todo) > 0 {
            let id = hircore.option_usize(vec.pop(todo));
            let node = input.nodes[id];
            let node_kind = hir.node_kind(node.data);
            if hircore.node_is(node_kind, hir.NodeKind.Call) {
                var call = hir.Call(kind: hir.CalleeKind.Direct, signature: 0,
                    direct_symbol: option.Option[usize].None,
                    callee: option.Option[usize].None, args: [], type_args: [],
                    binding: option.Option[usize].None,
                    c_callable: option.Option[u32].None, omitted: [],
                    system: option.Option[u32].None);
                switch node.data {
                    case hir.NodeData.Call(value): call = value;
                    default: {}
                }
                if hircore.callee_id(call.kind) == 3 {
                    let operation = hircore.option_u32_value(call.system);
                    if !native64 {
                        let category = system_op_category(operation);
                        if (category == 1 && !flags.slice_values) ||
                           (category == 2 && !flags.weak_values) ||
                           category == 3 {
                            return capability_unavailable(
                                "system operations require the Native/64 profile",
                                node.source.span);
                        }
                    }
                }
            }
            if hircore.node_is(node_kind, hir.NodeKind.ForeignRead) ||
               (hircore.node_is(node_kind, hir.NodeKind.Call) && call_kind_of(node) == 2) {
                if !flags.foreign_values {
                    return capability_unavailable(
                        "foreign reads/calls/access require the Python/64 profile",
                        node.source.span);
                }
                var binding_id usize = 0;
                if hircore.node_is(node_kind, hir.NodeKind.ForeignRead) {
                    switch node.data {
                        case hir.NodeData.ForeignRead(value):
                            binding_id = value.binding;
                        default: {}
                    }
                } else {
                    switch node.data {
                        case hir.NodeData.Call(value):
                            binding_id = hircore.option_usize(value.binding);
                        default: {}
                    }
                }
                if binding_id >= vec.len(input.foreign_bindings) {
                    return capability_unavailable(
                        "foreign binding index is invalid", node.source.span);
                }
                let declaration = input.resolved.project.foreign_bindings[
                    binding_id];
                switch declaration.detail {
                    case model.ForeignDetail.Callable(callable): {
                        var error_ok = false;
                        switch callable.error_type {
                            case option.Option.Some(name):
                                error_ok = name == "lang.py.Error";
                            case option.Option.None: {}
                        }
                        if !error_ok {
                            return capability_unavailable(
                                "Python foreign callable requires declared lang.py.Error",
                                node.source.span);
                        }
                        for parameter in callable.parameters {
                            if parameter.mode != "ordinary" {
                                return capability_unavailable(
                                    "Python foreign callable supports ordinary parameters only",
                                    node.source.span);
                            }
                        }
                    }
                    case model.ForeignDetail.Property(property): {
                        if property.error_type != "lang.py.Error" {
                            return capability_unavailable(
                                "Python foreign property requires lang.py.Error",
                                node.source.span);
                        }
                    }
                    case model.ForeignDetail.Indexer(indexer): {
                        if indexer.error_type != "lang.py.Error" {
                            return capability_unavailable(
                                "Python foreign indexer requires lang.py.Error",
                                node.source.span);
                        }
                    }
                    case model.ForeignDetail.Slice(slice): {
                        if slice.error_type != "lang.py.Error" {
                            return capability_unavailable(
                                "Python foreign slice requires lang.py.Error",
                                node.source.span);
                        }
                    }
                    default: {}
                }
            }
            if hircore.node_is(node_kind, hir.NodeKind.StructInit) ||
               hircore.node_is(node_kind, hir.NodeKind.EnumInit) ||
               hircore.node_is(node_kind, hir.NodeKind.FieldRead) ||
               hircore.node_is(node_kind, hir.NodeKind.FieldPlace) ||
               hircore.node_is(node_kind, hir.NodeKind.Switch) ||
               hircore.node_is(node_kind, hir.NodeKind.TraitObjectInit) ||
               hircore.node_is(node_kind, hir.NodeKind.TraitDispatch) {
                if (hircore.node_is(node_kind, hir.NodeKind.TraitObjectInit) ||
                    hircore.node_is(node_kind, hir.NodeKind.TraitDispatch)) &&
                   !flags.ownership_values {
                    return capability_unavailable(
                        "backend has not implemented dyn trait objects",
                        node.source.span);
                }
            }
            if hircore.node_is(node_kind, hir.NodeKind.Move) ||
               hircore.node_is(node_kind, hir.NodeKind.VecInit) ||
               hircore.node_is(node_kind, hir.NodeKind.IndexRead) ||
               hircore.node_is(node_kind, hir.NodeKind.IndexPlace) ||
               hircore.node_is(node_kind, hir.NodeKind.VecSlice) ||
               hircore.node_is(node_kind, hir.NodeKind.ForIn) {
                if !flags.ownership_values {
                    return capability_unavailable(
                        "backend has not implemented this aggregate operation",
                        node.source.span);
                }
            } else if hircore.node_is(node_kind, hir.NodeKind.ConstraintCall) {
                return capability_unavailable(
                    "backend has not implemented this aggregate operation",
                    node.source.span);
            }
            if hircore.node_is(node_kind, hir.NodeKind.Call) {
                var signature usize = 0;
                switch node.data {
                    case hir.NodeData.Call(value): signature = value.signature;
                    default: {}
                }
                var call_signature_ok = false;
                try {
                    call_signature_ok = capability_signature_supported(
                        inout capability, input, flags, signature);
                } catch error hircore.Invalid {
                    call_signature_ok = false;
                }
                if !call_signature_ok {
                    return capability_unavailable(
                        "backend does not support this call signature",
                        node.source.span);
                }
            }
            var node_type_ok = false;
            try {
                node_type_ok = capability_supported(inout capability, input,
                    flags, node.type_id, 0);
            } catch error hircore.Invalid {
                node_type_ok = false;
            }
            if !node_type_ok {
                if capability.budget {
                    return capability_unavailable(
                        "backend concrete type expansion budget exceeded",
                        node.source.span);
                }
                return capability_unavailable(
                    "backend does not support this concrete aggregate type",
                    node.source.span);
            }
            for child in node.children {
                vec.push(todo, child);
            }
        }
    }
    return model.UnitResult(state: model.PhaseState.Complete,
        failure: model.FailureKind.Internal, diagnostics: [], has_value: true);
}

func call_kind_of(node hir.HirNode) u32 {
    switch node.data {
        case hir.NodeData.Call(value): return hircore.callee_id(value.kind);
        default: return 0;
    }
}
