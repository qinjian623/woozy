// Type/source reconstruction, trait application and declaration checks.
// This is a direct port of the corresponding Verifier members in
// src/hir/hir.cpp.  Producer TypeIds are only accepted after every shape,
// declaration identity and source spelling is rebuilt independently.
package core;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/types" as types;
import "app/wzcc/valueops" as valueops;
import "std/option" as option;
import "std/vec" as vec;

pub struct ProtoRef {
    pub trait_index usize;
    pub method usize;
}

struct GenericOffset {
    offset u64;
    symbol usize;
}

struct PairTypes {
    left usize;
    right usize;
}

struct InoutWork {
    type_id usize;
    depth usize;
}

pub func type_error_to_invalid(error types.Error) throws Invalid {
    switch error {
        case types.Error.Invalid(message): fail(message);
    }
}

pub func support_error(error model.SupportError) throws Invalid {
    switch error {
        case model.SupportError.Invalid(message): fail(message);
        case model.SupportError.Limit(message): fail(message);
    }
}

pub func intern_type(state inout Verifier, value model.Type) usize
    throws Invalid {
    try {
        return types.intern(inout state.substituted, value);
    } catch error types.Error {
        type_error_to_invalid(error);
        return 0;
    }
}

pub func substitute_type(state inout Verifier, id usize,
                     substitutions Vec[model.Substitution]) usize
    throws Invalid {
    try {
        return types.substitute(id, substitutions, inout state.substituted);
    } catch error types.Error {
        type_error_to_invalid(error);
        return 0;
    }
}

pub func inout_slot_type(module hir.HirModule, id usize,
                     allowed Vec[usize]) bool throws Invalid {
    try {
        let slot = valueops.inout_slot(module, id, allowed);
        switch slot {
            case hir.InoutSlot.Allowed: return true;
            default: return false;
        }
    } catch error model.SupportError {
        support_error(error);
        return false;
    }
}

func inout_slot_type_state(state inout Verifier, id usize,
                           allowed Vec[usize]) bool throws Invalid {
    return inout_slot_type(state.m, id, allowed);
}

pub func weak_target(module hir.HirModule, id usize) bool {
    return valueops.weak_target(module, id);
}

pub func classify_needs_drop(state inout Verifier, id usize) bool
    throws Invalid {
    if id > 0 && id <= vec.len(state.drop_known) {
        if state.drop_known[id - 1] {
            return state.drop_result[id - 1];
        }
    }
    var result = false;
    try {
        result = valueops.classify_value(state.m, id).needs_drop;
    } catch error model.SupportError {
        support_error(error);
        return false;
    }
    if id > 0 && id <= vec.len(state.drop_known) {
        state.drop_result[id - 1] = result;
        state.drop_known[id - 1] = true;
    }
    return result;
}

pub func ordinary_copyable(module hir.HirModule, id usize) bool
    throws Invalid {
    try {
        return valueops.ordinary_copyable(module, id);
    } catch error model.SupportError {
        support_error(error);
        return false;
    }
}

pub func valid_type(state inout Verifier, id usize, allowed Vec[usize])
    throws Invalid {
    valid_type_depth(inout state, id, allowed, 0);
}

func valid_type_depth(state inout Verifier, id usize, allowed Vec[usize],
                      depth usize) throws Invalid {
    need(depth < 128, "type nesting exceeds verification budget");
    if validated_find(state, id, allowed) {
        return;
    }
    let value = verifier_type(state, id);
    need(!kind_is(value.kind, model.TypeKind.Error),
        "invalid/unimplemented type");
    if kind_is(value.kind, model.TypeKind.ForeignOpaque) ||
       kind_is(value.kind, model.TypeKind.ForeignCallable) {
        need(value.declaration == 0 &&
             value.binding < vec.len(state.m.foreign_bindings),
            "foreign type binding index");
        let declaration = state.m.resolved.project.foreign_bindings[value.binding];
        var category = false;
        switch declaration.detail {
            case model.ForeignDetail.Type(_):
                category = kind_is(value.kind, model.TypeKind.ForeignOpaque);
            case model.ForeignDetail.Callable(_):
                category = kind_is(value.kind, model.TypeKind.ForeignCallable);
            default: {}
        }
        need(category, "foreign type declaration category");
    }
    if kind_is(value.kind, model.TypeKind.CForeignPointer) ||
       kind_is(value.kind, model.TypeKind.CForeignBuffer) {
        need(vec.len(value.type_args) == 1 && value.bits <= 1 &&
             value.c_type == 0 && value.declaration == 0 &&
             value.binding == 0, "C pointer/buffer type shape");
        let element = verifier_type(state, value.type_args[0]);
        if kind_is(value.kind, model.TypeKind.CForeignBuffer) {
            need(integer_kind(element.kind) ||
                 kind_is(element.kind, model.TypeKind.Float) ||
                 kind_is(element.kind, model.TypeKind.Bool) ||
                 kind_is(element.kind, model.TypeKind.TypeParameter),
                "C buffer element type");
        }
        if kind_is(element.kind, model.TypeKind.CForeignOpaque) {
            need(element.c_type >= 1 &&
                 usize(element.c_type) <= vec.len(state.m.resolved.project.c_types),
                "C opaque pointee");
            let declaration = state.m.resolved.project.c_types[usize(element.c_type) - 1];
            var opaque = false;
            switch declaration.kind {
                case model.CDeclKind.Opaque: opaque = true;
                default: {}
            }
            need(opaque, "C opaque pointee");
        } else {
            valid_type_depth(inout state, value.type_args[0], allowed,
                depth + 1);
        }
    }
    need(!kind_is(value.kind, model.TypeKind.CForeignOpaque),
        "C opaque type must be used behind a pointer");
    if c_named_kind(value.kind) {
        need(value.c_type >= 1 &&
             usize(value.c_type) <= vec.len(state.m.resolved.project.c_types) &&
             vec.len(value.type_args) == 0 && value.bits == 0 &&
             value.declaration == 0 && value.binding == 0,
            "C named type index");
        let declaration = state.m.resolved.project.c_types[usize(value.c_type) - 1];
        var matches = false;
        switch declaration.kind {
            case model.CDeclKind.Record:
                matches = kind_is(value.kind, model.TypeKind.CForeignRecord);
            case model.CDeclKind.Resource:
                matches = kind_is(value.kind, model.TypeKind.CForeignResource);
            case model.CDeclKind.Callback:
                matches = kind_is(value.kind, model.TypeKind.CForeignCallback);
            default: {}
        }
        need(matches, "C named type declaration kind");
    }
    if kind_is(value.kind, model.TypeKind.TypeParameter) {
        need(ids_contains(allowed, value.declaration),
            "unbound type parameter in function/declaration");
        let symbol = verifier_symbol(state, value.declaration);
        need(symbol_is(symbol.kind, model.SymbolKind.TypeParameter),
            "type parameter identity");
    }
    if kind_is(value.kind, model.TypeKind.NominalStruct) ||
       kind_is(value.kind, model.TypeKind.NominalEnum) {
        let found = nominal_index(state, value.declaration);
        need(found >= 0, "nominal declaration identity/kind");
        let declaration = state.m.nominals[usize(found)];
        need(kind_is(declaration.kind, value.kind),
            "nominal declaration identity/kind");
        need(vec.len(value.type_args) == vec.len(declaration.params),
            "nominal type argument count");
        for argument in value.type_args {
            valid_type_depth(inout state, argument, allowed, depth + 1);
        }
    }
    if kind_is(value.kind, model.TypeKind.Vec) ||
       kind_is(value.kind, model.TypeKind.Slice) ||
       kind_is(value.kind, model.TypeKind.Weak) {
        var arity_message = "Weak target arity";
        if kind_is(value.kind, model.TypeKind.Vec) { arity_message = "Vec element arity"; }
        if kind_is(value.kind, model.TypeKind.Slice) { arity_message = "Slice element arity"; }
        need(vec.len(value.type_args) == 1, arity_message);
        valid_type_depth(inout state, value.type_args[0], allowed, depth + 1);
        if kind_is(value.kind, model.TypeKind.Weak) &&
           !type_contains_parameter(state.m, value.type_args[0]) {
            need(weak_target(state.m, value.type_args[0]),
                "Weak target is not a canonical source declaration");
        }
    }
    if kind_is(value.kind, model.TypeKind.Task) {
        need(vec.len(value.type_args) == 2, "Task result/error arity");
        for argument in value.type_args {
            valid_type_depth(inout state, argument, allowed, depth + 1);
        }
    }
    if kind_is(value.kind, model.TypeKind.TraitObject) {
        let found = trait_declaration(state, value.declaration);
        need(found >= 0, "dyn type has no real trait declaration");
        let trait_value = state.m.traits[usize(found)];
        need(vec.len(value.type_args) == vec.len(trait_value.params),
            "dyn trait application arity");
        need(value.bits == 0 && value.binding == 0 && value.c_type == 0 &&
             vec.len(value.parameters) == 0 && value.result == 0 &&
             !option.is_some(value.throws_type), "dyn type shape");
        for argument in value.type_args {
            valid_type_depth(inout state, argument, allowed, depth + 1);
        }
        check_object_safe(inout state, value.declaration, empty_span());
    }
    if kind_is(value.kind, model.TypeKind.Function) {
        if option.is_some(value.throws_type) {
            valid_type_depth(inout state, option_usize(value.throws_type),
                allowed, depth + 1);
        }
        need(!kind_is(verifier_type(state, value.result).kind,
                      model.TypeKind.ForeignCallable) &&
             (!option.is_some(value.throws_type) ||
              !kind_is(verifier_type(state, option_usize(value.throws_type)).kind,
                       model.TypeKind.ForeignCallable)),
            "internal foreign callable in function output");
        for parameter in value.parameters {
            let parameter_type = verifier_type(state, parameter.type_id);
            need(!kind_is(parameter_type.kind, model.TypeKind.ForeignCallable) &&
                 (!kind_is(parameter_type.kind, model.TypeKind.ForeignOpaque) ||
                  mode_is_id(parameter.mode, 0) || mode_is_id(parameter.mode, 2)),
                "internal callable/external inout parameter");
            need(mode_is_id(parameter.mode, 0) || mode_is_id(parameter.mode, 2) ||
                 (mode_is_id(parameter.mode, 1) &&
                  inout_slot_type(state.m, parameter.type_id, allowed)),
                "unsupported move/nontrivial inout");
            valid_type_depth(inout state, parameter.type_id, allowed,
                depth + 1);
        }
        valid_type_depth(inout state, value.result, allowed, depth + 1);
    }
    validated_insert(inout state, id, allowed);
}

pub func instantiated_signature(state inout Verifier, target usize,
                            args Vec[usize]) usize throws Invalid {
    let found_function = verifier_function(state, target);
    let found_template = template_index(state, target);
    if found_template < 0 {
        need(vec.len(args) == 0, "type arguments on concrete function");
        return found_function.signature;
    }
    let template_value = state.m.templates[usize(found_template)];
    need(vec.len(args) == vec.len(template_value.params),
        "template call argument count");
    constraints(inout state, template_value.params, args,
        vec.empty[model.Substitution]());
    let substitutions = vec.empty[model.Substitution]();
    for var index usize = 0; index < vec.len(args); index += 1 {
        vec.push(substitutions, model.Substitution(
            symbol: template_value.params[index].symbol, type_id: args[index]));
    }
    return substitute_type(inout state, found_function.signature, substitutions);
}

pub func nominal_type(state Verifier, id usize) hir.NominalDecl throws Invalid {
    let value = verifier_type(state, id);
    let found = nominal_index(state, value.declaration);
    need(found >= 0, "missing nominal declaration");
    return state.m.nominals[usize(found)];
}

pub func field_type(state inout Verifier, id usize, field hir.FieldDecl) usize
    throws Invalid {
    let declaration = nominal_type(state, id);
    let value = verifier_type(state, id);
    need(vec.len(declaration.params) == vec.len(value.type_args),
        "nominal substitution arity");
    let substitutions = vec.empty[model.Substitution]();
    for var index usize = 0; index < vec.len(declaration.params); index += 1 {
        vec.push(substitutions, model.Substitution(
            symbol: declaration.params[index].symbol,
            type_id: value.type_args[index]));
    }
    return substitute_type(inout state, field.type_id, substitutions);
}

pub func operator_types(state Verifier, op hir.BinaryOp, left usize, right usize,
                    result usize) throws Invalid {
    let kind = verifier_type(state, left).kind;
    let op_id = binary_id(op);
    if kind_is(kind, model.TypeKind.String) {
        var string_result = result == left;
        if op_id != 0 { string_result = kind_is(verifier_type(state, result).kind, model.TypeKind.Bool); }
        need(left == right &&
             (op_id == 0 || (op_id >= 10 && op_id <= 15)) &&
             string_result, "string operator types");
        return;
    }
    if op_id == 5 || op_id == 6 {
        need(integer_kind(kind) &&
             integer_kind(verifier_type(state, right).kind) && result == left,
            "shift types");
        return;
    }
    if op_id == 0 || op_id == 1 || op_id == 2 || op_id == 3 {
        need(number_kind(kind) && left == right && result == left,
            "arithmetic types");
        return;
    }
    if op_id == 4 || op_id == 7 || op_id == 8 || op_id == 9 {
        need(integer_kind(kind) && left == right && result == left,
            "integer operation types");
        return;
    }
    if op_id == 10 || op_id == 11 {
        need((number_kind(kind) || kind_is(kind, model.TypeKind.Bool)) &&
             left == right &&
             kind_is(verifier_type(state, result).kind, model.TypeKind.Bool),
            "equality types");
        return;
    }
    if op_id >= 12 && op_id <= 15 {
        need(number_kind(kind) && left == right &&
             kind_is(verifier_type(state, result).kind, model.TypeKind.Bool),
            "comparison types");
        return;
    }
    fail("unknown binary operator");
}

pub func iteration_element(state inout Verifier, collection usize) usize
    throws Invalid {
    let value = verifier_type(state, collection);
    if kind_is(value.kind, model.TypeKind.Vec) ||
       kind_is(value.kind, model.TypeKind.Slice) {
        need(vec.len(value.type_args) > 0, "iteration element type");
        return value.type_args[0];
    }
    need(kind_is(value.kind, model.TypeKind.String),
        "iteration collection type");
    var rune = model.empty_type(model.TypeKind.UnsignedInt);
    rune.bits = 32;
    return intern_type(inout state, rune);
}

pub func integer_literal(state Verifier, node hir.HirNode,
                     literal hir.IntegerLiteral) throws Invalid {
    let value = verifier_type(state, node.type_id);
    need(integer_kind(value.kind), "integer literal type");
    let spelling = literal.decimal;
    need(text_len(spelling) > 0, "empty integer mathematical value");
    let negative = spelling[0:1] == "-";
    var begin usize = 0;
    if negative {
        begin = 1;
    }
    let length = text_len(spelling);
    need(begin < length && !(spelling[begin:begin + 1] == "0" &&
         (negative || length - begin != 1)),
        "noncanonical decimal integer");
    var magnitude u64 = 0;
    var index = begin;
    for index < length {
        let byte = text_byte(spelling, index);
        need(byte >= 48 && byte <= 57, "nondecimal integer value");
        let digit = u64(byte) - 48;
        need(magnitude <= (18446744073709551615 - digit) / 10,
            "integer literal exceeds u64 magnitude");
        magnitude = magnitude * 10 + digit;
        index += 1;
    }
    let width = width_of(state.m, value);
    var mask u64 = 18446744073709551615;
    if width != 64 {
        mask = (u64(1) << width) - 1;
    }
    var limit = mask;
    if signed_integer_kind(value.kind) {
        limit = u64(1) << (width - 1);
    }
    need(!negative || signed_integer_kind(value.kind),
        "negative unsigned literal");
    var maximum = limit;
    if signed_integer_kind(value.kind) && !negative { maximum = limit - 1; }
    need(magnitude <= maximum, "integer literal range");
    var expected = magnitude;
    if negative {
        expected = u64(0) - magnitude;
    }
    need(literal.bits == (expected & mask), "integer bit pattern mismatch");
}

func text_len(value string) usize {
    var length usize = 0;
    for _ in value {
        length += 1;
    }
    return length;
}

func text_byte(value string, index usize) u8 {
    var position usize = 0;
    for item in value {
        if position == index {
            return u8(item);
        }
        position += 1;
    }
    return 0;
}

func width_of(module hir.HirModule, value model.Type) u32 throws Invalid {
    try {
        return types.bit_width(value, module.config);
    } catch error types.Error {
        type_error_to_invalid(error);
        return 0;
    }
}
