// Method-source reconstruction and direct-call selection checks.
package hirverify;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/signature" as signature;
import "app/wzcc/system" as system;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

func source_method_member(state Verifier, reference model.NodeRef)
    option.Option[SourceMethodCall] throws Invalid {
    let file = verifier_file(state, reference.module, reference.file);
    var ref = unwrapped(state, reference);
    var explicit_arguments = vec.empty[model.NodeRef]();
    var explicit = false;
    if ast_is(file.nodes[ref.node].kind, model.AstKind.NeutralBracket) {
        need(vec.len(file.nodes[ref.node].children) > 0,
            "method type suffix has no target");
        explicit = true;
        for var index usize = 1;
            index < vec.len(file.nodes[ref.node].children); index += 1 {
            var argument = ref;
            argument.node = file.nodes[ref.node].children[index];
            vec.push(explicit_arguments, argument);
        }
        ref.node = file.nodes[ref.node].children[0];
        ref = unwrapped(state, ref);
    }
    let member = file.nodes[ref.node];
    if !ast_is(member.kind, model.AstKind.Member) ||
       option.is_some(resolved_source(state, ref)) {
        return option.Option[SourceMethodCall].None;
    }
    need(vec.len(member.children) > 0, "method member has no base");
    var base = ref;
    base.node = member.children[0];
    var symbolized = base;
    for true {
        symbolized = unwrapped(state, symbolized);
        let value = file.nodes[symbolized.node];
        if !ast_is(value.kind, model.AstKind.NeutralBracket) {
            break;
        }
        need(vec.len(value.children) > 0, "type qualifier has no base");
        symbolized.node = value.children[0];
    }
    let base_symbol = resolved_source(state, symbolized);
    need(member.token_end > member.token_begin, "method member token range");
    need(member.token_end <= vec.len(file.lexed.tokens),
        "method member token range");
    var has_base_symbol = false;
    var symbol_value usize = 0;
    switch base_symbol {
        case option.Option.Some(value): {
            has_base_symbol = true;
            symbol_value = value;
        }
        case option.Option.None: {}
    }
    return option.Option[SourceMethodCall].Some(SourceMethodCall(base: base,
        has_base_symbol: has_base_symbol, base_symbol: symbol_value,
        name: file.lexed.tokens[member.token_end - 1].spelling,
        explicit_type_arguments: explicit,
        explicit_arguments: explicit_arguments));
}

func source_method_call(state Verifier, node hir.HirNode)
    option.Option[SourceMethodCall] throws Invalid {
    let file = verifier_file(state, node.source.node.module,
        node.source.node.file);
    var ref = node.source.node;
    let call = file.nodes[ref.node];
    if !ast_is(call.kind, model.AstKind.Call) ||
       vec.len(call.children) == 0 {
        return option.Option[SourceMethodCall].None;
    }
    ref.node = call.children[0];
    return source_method_member(state, ref);
}

func source_method_call_value(value option.Option[SourceMethodCall])
    SourceMethodCall {
    switch value {
        case option.Option.Some(item): return item;
        case option.Option.None: return SourceMethodCall(
            base: model.NodeRef(module: 0, file: 0, node: 0),
            has_base_symbol: false, base_symbol: 0, name: "",
            explicit_type_arguments: false, explicit_arguments: []);
    }
}

func receiver_input(state Verifier, base model.NodeRef) ReceiverInput
    throws Invalid {
    let file = verifier_file(state, base.module, base.file);
    var value = base;
    for true {
        let syntax = file.nodes[value.node];
        if !ast_is(syntax.kind, model.AstKind.Parenthesized) {
            break;
        }
        need(vec.len(syntax.children) > 0, "receiver parentheses");
        value.node = syntax.children[0];
    }
    let syntax = file.nodes[value.node];
    var mode = model.ParamMode.Ordinary;
    if ast_is(syntax.kind, model.AstKind.Unary) {
        let marker = file.lexed.tokens[syntax.token_begin].spelling;
        if marker == "move" {
            mode = model.ParamMode.Move;
        }
        if marker == "inout" {
            mode = model.ParamMode.Inout;
            need(vec.len(syntax.children) == 1, "inout receiver has no operand");
            value.node = syntax.children[0];
            for true {
                let inner = file.nodes[value.node];
                if !ast_is(inner.kind, model.AstKind.Parenthesized) {
                    break;
                }
                need(vec.len(inner.children) > 0, "inout receiver parentheses");
                value.node = inner.children[0];
            }
        }
    }
    if mode_is_id(mode, 0) {
        value = unwrapped(state, value);
    }
    return ReceiverInput(node: value, mode: mode);
}

func check_receiver_source(state inout Verifier, node hir.HirNode,
                           args Vec[hir.CallArg], base model.NodeRef,
                           declared model.ParamMode) throws Invalid {
    let input = receiver_input(state, base);
    let file = verifier_file(state, base.module, base.file);
    let call = file.nodes[node.source.node.node];
    need(vec.len(args) > 0 && vec.len(args) == vec.len(call.children),
        "value call receiver differs from source arguments (source arity)");
    let receiver = args[0];
    let value = verifier_node(state, receiver.expression);
    need(receiver.source_index == 0 && receiver.parameter_index == 0 &&
         !option.is_some(receiver.label) &&
         mode_is_id(receiver.mode, mode_id_value(input.mode)) &&
         mode_is_id(input.mode, mode_id_value(declared)) &&
         same_ref(unwrapped(state, value.source.node), input.node),
        "value call receiver source/mode differs from the real Member base");
    if !mode_is_id(input.mode, 0) {
        let actual_file = verifier_file(state, value.source.node.module,
            value.source.node.file);
        need(same_span(value.source.span,
                 actual_file.nodes[value.source.node.node].span),
            "explicit receiver source span differs from its complete AST node");
        let kind = hir.node_kind(value.data);
        if mode_is_id(input.mode, 2) {
            need(node_is(kind, hir.NodeKind.Move),
                "explicit receiver must keep its Move or writable Place");
        } else {
            need(inout_place(value),
                "explicit receiver must keep its Move or writable Place");
        }
        if mode_is_id(input.mode, 1) && node_is(kind, hir.NodeKind.Place) {
            let binding = resolved_source(state, input.node);
            need(option.is_some(binding), "inout receiver has no source binding");
            var expected = option_usize(binding);
            let owner = verifier_scope(state, node.scope).function;
            for instance in state.m.instances {
                if instance.symbol == owner {
                    for rename in instance.renamed {
                        if rename.origin == expected {
                            expected = rename.replacement;
                            break;
                        }
                    }
                }
            }
            var place_symbol usize = 0;
            switch value.data {
                case hir.NodeData.Place(place): place_symbol = place.symbol;
                default: {}
            }
            need(place_symbol == expected,
                "inout receiver Place differs from its real source binding");
        }
    }
}

func inherent_self_source(state Verifier, method usize, implementation hir.ImplDecl)
    bool throws Invalid {
    let source = verifier_function(state, method).source;
    let file = verifier_file(state, source.node.module, source.node.file);
    let owner = file.nodes[source.node.node];
    for id in owner.children {
        let parameter = file.nodes[id];
        if !ast_is(parameter.kind, model.AstKind.Parameter) {
            continue;
        }
        need(vec.len(parameter.children) > 0,
            "method parameter has no source type");
        var reference = source.node;
        reference.node = parameter.children[0];
        let found = resolved_source(state, reference);
        return option.is_some(found) &&
               option_usize(found) == implementation.self_parameter;
    }
    return false;
}

func template_trait_parameter(state Verifier, source SourceMethodCall,
                              owner usize) bool throws Invalid {
    if !source.has_base_symbol {
        return false;
    }
    let id = source.base_symbol;
    if !symbol_is(verifier_symbol(state, id).kind,
                  model.SymbolKind.TypeParameter) {
        return false;
    }
    var origin = owner;
    for instance in state.m.instances {
        if instance.symbol == owner {
            origin = instance.origin;
            break;
        }
    }
    let found = template_index(state, origin);
    if found < 0 {
        return false;
    }
    for parameter in state.m.templates[usize(found)].params {
        if parameter.symbol == id {
            return option.is_some(parameter.trait_ref);
        }
    }
    return false;
}

func constraint_method_arguments(state inout Verifier, node hir.HirNode,
                                 call hir.ConstraintCall, trait_value hir.TraitDecl,
                                 prototype hir.MethodPrototype)
    ConstraintMethodArguments throws Invalid {
    let written = source_method_call(state, node);
    need(option.is_some(written), "constraint call lost its source method");
    let source = source_method_call_value(written);
    let parameters = source_parameters(inout state, prototype.source);
    let owner = verifier_scope(state, node.scope).function;
    let sub = vec.empty[model.Substitution]();
    vec.push(sub, model.Substitution(symbol: trait_value.self,
        type_id: call.receiver));
    need(vec.len(call.trait_ref.args) == vec.len(trait_value.params),
        "constraint call trait application arity");
    for var index usize = 0; index < vec.len(trait_value.params); index += 1 {
        vec.push(sub, model.Substitution(symbol: trait_value.params[index].symbol,
            type_id: call.trait_ref.args[index]));
    }
    let values = vec.empty[usize]();
    if source.explicit_type_arguments {
        need(vec.len(source.explicit_arguments) == vec.len(parameters),
            "constraint method type argument count");
        let allowed_values = allowed_for(state, owner);
        for var index usize = 0; index < vec.len(parameters); index += 1 {
            let value = source_type_in_function(inout state,
                source.explicit_arguments[index], owner);
            valid_type(inout state, value, allowed_values);
            vec.push(values, value);
            vec.push(sub, model.Substitution(symbol: parameters[index].symbol,
                type_id: value));
        }
        need(call.signature == substitute_type(inout state,
                 prototype.signature, sub),
            "constraint method type arguments differ from signature");
    } else {
        let match_sub = sub;
        need(matches(inout state, prototype.signature, call.signature,
                 match_sub),
            "constraint method signature does not determine type arguments");
        for parameter in parameters {
            let found = substitution_index(match_sub, parameter.symbol);
            need(found >= 0,
                "constraint method type argument is missing from source");
            vec.push(values, match_sub[usize(found)].type_id);
        }
    }
    constraints(inout state, parameters, values, sub);
    return ConstraintMethodArguments(parameters: parameters, values: values);
}

func check_qualified_method_source(state inout Verifier, node hir.HirNode,
                                   call hir.Call) throws Invalid {
    let written = source_method_call(state, node);
    if !option.is_some(written) {
        return;
    }
    let source = source_method_call_value(written);
    let template_qualifier = template_trait_parameter(state, source,
        verifier_scope(state, node.scope).function);
    var type_qualifier = false;
    if source.has_base_symbol {
        let symbol = verifier_symbol(state, source.base_symbol);
        type_qualifier = template_qualifier ||
            symbol_is(symbol.kind, model.SymbolKind.Type) ||
            symbol_is(symbol.kind, model.SymbolKind.BuiltinType) ||
            symbol_is(symbol.kind, model.SymbolKind.TypeParameter);
    }
    need(callee_id(call.kind) == 0 && option.is_some(call.direct_symbol),
        "type-qualified method source is not a direct call");
    var origin = option_usize(call.direct_symbol);
    var instance_found = -1;
    for var index usize = 0; index < vec.len(state.m.instances); index += 1 {
        if state.m.instances[index].symbol == origin {
            instance_found = i64(index);
            origin = state.m.instances[index].origin;
            break;
        }
    }
    need(verifier_symbol(state, origin).name == source.name,
        "type-qualified call target name differs from source");
    var impl_index i64 = -1;
    for var index usize = 0; index < vec.len(state.m.impls); index += 1 {
        if ids_contains(state.m.impls[index].methods, origin) {
            need(impl_index < 0,
                "type-qualified call target belongs to two impls");
            impl_index = i64(index);
        }
    }
    var has_impl = impl_index >= 0;
    var impl_has_trait = false;
    if has_impl {
        impl_has_trait = option.is_some(state.m.impls[usize(impl_index)].trait_ref);
    }
    if !type_qualifier && (!has_impl || !impl_has_trait) {
        if mode_is_id(receiver_input(state, source.base).mode, 0) {
            return;
        }
        need(has_impl && inherent_self_source(state, origin,
                 state.m.impls[usize(impl_index)]),
            "explicit receiver requires the real inherent first Self");
        let signature = verifier_type(state, verifier_function(state, origin).signature);
        need(vec.len(signature.parameters) > 0,
            "method receiver signature is empty");
        check_receiver_source(inout state, node, call.args, source.base,
            signature.parameters[0].mode);
        return;
    }
    need(has_impl, "type-qualified call target is not an impl method");
    let implementation = state.m.impls[usize(impl_index)];
    if option.is_some(implementation.trait_ref) {
        let application = option_trait_ref(implementation.trait_ref);
        let trait_index = trait_declaration(state, application.declaration);
        need(trait_index >= 0, "type-qualified call impl has no real trait");
        let trait_value = state.m.traits[usize(trait_index)];
        var prototype_index i64 = -1;
        for var index usize = 0; index < vec.len(trait_value.methods); index += 1 {
            if verifier_symbol(state, trait_value.methods[index].symbol).name ==
               source.name {
                need(prototype_index < 0,
                    "type-qualified call has duplicate trait prototype");
                prototype_index = i64(index);
            }
        }
        need(prototype_index >= 0,
            "type-qualified call has no source trait prototype");
        if !type_qualifier {
            let raw = verifier_type(state,
                trait_value.methods[usize(prototype_index)].signature);
            need(vec.len(raw.parameters) > 0,
                "value call requires a trait Self parameter");
            let first = verifier_type(state, raw.parameters[0].type_id);
            need(kind_is(first.kind, model.TypeKind.TypeParameter) &&
                 first.declaration == trait_value.self,
                "value call first parameter must be the real trait Self");
            check_receiver_source(inout state, node, call.args, source.base,
                raw.parameters[0].mode);
            return;
        }
    }
    var args = vec.empty[usize]();
    if instance_found >= 0 {
        args = state.m.instances[usize(instance_found)].type_args;
    } else if template_index(state, origin) >= 0 {
        args = call.type_args;
    }
    need(vec.len(implementation.params) <= vec.len(args),
        "type-qualified call lost impl type arguments");
    let sub = vec.empty[model.Substitution]();
    for var index usize = 0; index < vec.len(implementation.params); index += 1 {
        vec.push(sub, model.Substitution(
            symbol: implementation.params[index].symbol, type_id: args[index]));
    }
    let qualified_owner = verifier_scope(state, node.scope).function;
    let source_value = source_type_in_function(inout state, source.base,
        qualified_owner);
    need(substitute_type(inout state, implementation.self_type, sub) ==
             source_value,
        "type-qualified call source type differs from impl Self");
    if template_qualifier {
        need(option.is_some(implementation.trait_ref),
            "T-qualified call selected an inherent method");
        let application = option_trait_ref(implementation.trait_ref);
        let trait_index = trait_declaration(state, application.declaration);
        need(trait_index >= 0, "T-qualified call impl has no real trait");
        let trait_value = state.m.traits[usize(trait_index)];
        var declared = false;
        for method in trait_value.methods {
            declared = declared ||
                verifier_symbol(state, method.symbol).name == source.name;
        }
        need(declared, "T-qualified call has no source trait prototype");
    } else {
        var candidates usize = 0;
        for implementation_option in state.m.impls {
            let match_sub = vec.empty[model.Substitution]();
            if !matches(inout state, implementation_option.self_type,
                        source_value, match_sub) {
                continue;
            }
            var valid = true;
            for parameter in implementation_option.params {
                let found = substitution_index(match_sub, parameter.symbol);
                if found < 0 {
                    valid = false;
                    break;
                }
                switch parameter.trait_ref {
                    case option.Option.Some(bound): {
                        let concrete = hir.TraitRef(declaration: bound.declaration,
                            args: vec.empty[usize]());
                        for argument in bound.args {
                            vec.push(concrete.args, substitute_type(inout state,
                                argument, match_sub));
                        }
                        if !satisfies(inout state,
                            match_sub[usize(found)].type_id, concrete, 0) {
                            valid = false;
                            break;
                        }
                    }
                    case option.Option.None: {}
                }
            }
            if !valid {
                continue;
            }
            for method in implementation_option.methods {
                if verifier_symbol(state, method).name == source.name {
                    candidates += 1;
                }
            }
        }
        need(candidates == 1,
            "type-qualified method source selection is not unique");
    }
}

func option_trait_ref(value option.Option[hir.TraitRef]) hir.TraitRef {
    switch value {
        case option.Option.Some(item): return item;
        case option.Option.None: return hir.TraitRef(declaration: 0, args: []);
    }
}

func check_explicit_method_arguments(state inout Verifier, node hir.HirNode,
                                     call hir.Call) throws Invalid {
    let written = source_method_call(state, node);
    if !option.is_some(written) {
        return;
    }
    let source = source_method_call_value(written);
    if !source.explicit_type_arguments {
        return;
    }
    need(callee_id(call.kind) == 0 && option.is_some(call.direct_symbol),
        "explicit method type arguments require a direct call");
    var origin = option_usize(call.direct_symbol);
    var has_instance = false;
    for instance in state.m.instances {
        if instance.symbol == origin {
            has_instance = true;
            origin = instance.origin;
            break;
        }
    }
    var impl_index i64 = -1;
    for var index usize = 0; index < vec.len(state.m.impls); index += 1 {
        if ids_contains(state.m.impls[index].methods, origin) {
            need(impl_index < 0, "explicit method target belongs to two impls");
            impl_index = i64(index);
        }
    }
    need(impl_index >= 0, "explicit method target is not an impl method");
    let implementation = state.m.impls[usize(impl_index)];
    let origin_source = verifier_function(state, origin).source;
    let all = source_parameters(inout state, origin_source);
    need(vec.len(all) >= vec.len(implementation.params),
        "explicit method source lost its impl prefix");
    for var index usize = 0; index < vec.len(implementation.params); index += 1 {
        need(all[index].symbol == implementation.params[index].symbol,
            "explicit method impl prefix differs from source");
    }
    let own = vec.len(all) - vec.len(implementation.params);
    need(vec.len(source.explicit_arguments) == own,
        "explicit method type argument count differs from declaration");
    var actual = call.type_args;
    if has_instance {
        for instance in state.m.instances {
            if instance.symbol == option_usize(call.direct_symbol) {
                actual = instance.type_args;
                break;
            }
        }
    }
    need(vec.len(actual) == vec.len(all),
        "explicit method call lost complete type arguments");
    let owner = verifier_scope(state, node.scope).function;
    let allowed_values = allowed_for(state, owner);
    for var index usize = 0; index < own; index += 1 {
        let value = source_type_in_function(inout state,
            source.explicit_arguments[index], owner);
        valid_type(inout state, value, allowed_values);
        need(value == actual[vec.len(implementation.params) + index],
            "explicit method type argument differs from complete instance key");
    }
}

func source_template_bound(state inout Verifier, source SourceMethodCall,
                           owner usize) TraitBoundResult throws Invalid {
    if !source.has_base_symbol {
        return TraitBoundResult(has: false, bound: hir.TraitRef(
            declaration: 0, args: []), parameter: 0);
    }
    let id = source.base_symbol;
    if !symbol_is(verifier_symbol(state, id).kind,
                  model.SymbolKind.TypeParameter) {
        return TraitBoundResult(has: false, bound: hir.TraitRef(
            declaration: 0, args: []), parameter: 0);
    }
    var origin = owner;
    var has_instance = false;
    var instance_index usize = 0;
    for var index usize = 0; index < vec.len(state.m.instances); index += 1 {
        if state.m.instances[index].symbol == owner {
            has_instance = true;
            instance_index = index;
            origin = state.m.instances[index].origin;
            break;
        }
    }
    let found = template_index(state, origin);
    if found < 0 {
        return TraitBoundResult(has: false, bound: hir.TraitRef(
            declaration: 0, args: []), parameter: 0);
    }
    let template = state.m.templates[usize(found)];
    let real = source_parameters(inout state, template.function.source);
    var declared = -1;
    for var index usize = 0; index < vec.len(real); index += 1 {
        if real[index].symbol == id {
            declared = i64(index);
        }
    }
    if declared < 0 || !option.is_some(real[usize(declared)].trait_ref) {
        return TraitBoundResult(has: false, bound: hir.TraitRef(
            declaration: 0, args: []), parameter: 0);
    }
    var bound = option_trait_ref(real[usize(declared)].trait_ref);
    if has_instance {
        let instance = state.m.instances[instance_index];
        need(vec.len(real) == vec.len(instance.type_args),
            "template instance parameter count");
        let sub = vec.empty[model.Substitution]();
        for var index usize = 0; index < vec.len(real); index += 1 {
            vec.push(sub, model.Substitution(symbol: real[index].symbol,
                type_id: instance.type_args[index]));
        }
        for var index usize = 0; index < vec.len(bound.args); index += 1 {
            bound.args[index] = substitute_type(inout state, bound.args[index],
                sub);
        }
    }
    return TraitBoundResult(has: true, bound: bound, parameter: id);
}

struct MatchedArgs {
    ok bool;
    args Vec[usize];
}

struct UniqueMethod {
    found i64;
    substitution Vec[model.Substitution];
    args Vec[usize];
}

func method_value_target(state Verifier, node hir.HirNode,
                         value hir.FunctionValue) MethodValueTarget
    throws Invalid {
    var target = MethodValueTarget(origin: value.symbol, has_instance: false,
        instance: 0, complete: vec.empty[usize](), signature: node.type_id);
    if template_index(state, value.symbol) >= 0 {
        need(template_index(state, verifier_scope(state, node.scope).function) >= 0,
            "template method value survived into concrete execution");
        target.origin = value.symbol;
        target.complete = value.type_args;
        return target;
    }
    let found = instance_index(state, value.symbol);
    if found >= 0 {
        need(vec.len(value.type_args) == 0,
            "instance method value has a type suffix");
        let instance = state.m.instances[usize(found)];
        target.has_instance = true;
        target.instance = usize(found);
        target.origin = instance.origin;
        target.complete = instance.type_args;
        return target;
    }
    need(vec.len(value.type_args) == 0,
        "concrete method value has a type suffix");
    target.origin = value.symbol;
    return target;
}

func method_impl_index(state Verifier, origin usize) i64 throws Invalid {
    var result i64 = -1;
    for var index usize = 0; index < vec.len(state.m.impls); index += 1 {
        if ids_contains(state.m.impls[index].methods, origin) {
            need(result < 0, "method value target belongs to two impls");
            result = i64(index);
        }
    }
    need(result >= 0, "method value target is not an impl method");
    return result;
}

func impl_method_exists(state Verifier, method usize) bool {
    for implementation in state.m.impls {
        if ids_contains(implementation.methods, method) {
            return true;
        }
    }
    return false;
}

func method_value_is_impl(state Verifier, value hir.FunctionValue) bool {
    var origin = value.symbol;
    if template_index(state, value.symbol) < 0 {
        let found = instance_index(state, value.symbol);
        if found >= 0 {
            origin = state.m.instances[usize(found)].origin;
        }
    }
    return impl_method_exists(state, origin);
}

func constant_method_source(state Verifier, node hir.HirNode)
    option.Option[SourceMethodCall] throws Invalid {
    let initial = resolved_source(state, node.source.node);
    if !option.is_some(initial) ||
       !symbol_is(verifier_symbol(state, option_usize(initial)).kind,
                  model.SymbolKind.Constant) {
        return option.Option[SourceMethodCall].None;
    }
    var constant_id = option_usize(initial);
    let seen = vec.empty[usize]();
    for true {
        need(ids_insert(seen, constant_id),
            "constant method value alias cycle");
        let symbol = verifier_symbol(state, constant_id);
        need(option.is_some(symbol.definition),
            "constant method value has no initializer");
        let definition_ref = option_ref(symbol.definition);
        let file = verifier_file(state, definition_ref.module,
            definition_ref.file);
        let binding = file.nodes[definition_ref.node];
        need(ast_is(binding.kind, model.AstKind.Binding) &&
             vec.len(binding.children) > 0,
            "constant method value source is not a binding");
        var initializer = definition_ref;
        initializer.node = binding.children[vec.len(binding.children) - 1];
        let next = resolved_source(state, initializer);
        if option.is_some(next) &&
           symbol_is(verifier_symbol(state, option_usize(next)).kind,
                     model.SymbolKind.Constant) {
            constant_id = option_usize(next);
            continue;
        }
        return source_method_member(state, initializer);
    }
    return option.Option[SourceMethodCall].None;
}

func matched_impl_arguments(state inout Verifier, implementation hir.ImplDecl,
                            match Vec[model.Substitution]) MatchedArgs
    throws Invalid {
    var args = vec.empty[usize]();
    for parameter in implementation.params {
        let found = substitution_index(match, parameter.symbol);
        if found < 0 {
            return MatchedArgs(ok: false, args: []);
        }
        switch parameter.trait_ref {
            case option.Option.Some(bound): {
                let concrete = hir.TraitRef(declaration: bound.declaration,
                    args: vec.empty[usize]());
                for argument in bound.args {
                    vec.push(concrete.args, substitute_type(inout state,
                        argument, match));
                }
                if !satisfies(inout state, match[usize(found)].type_id,
                              concrete, 0) {
                    return MatchedArgs(ok: false, args: []);
                }
            }
            case option.Option.None: {}
        }
        vec.push(args, match[usize(found)].type_id);
    }
    return MatchedArgs(ok: true, args: args);
}

func unique_source_method(state inout Verifier, receiver usize, name string,
                          required option.Option[hir.TraitRef])
    UniqueMethod throws Invalid {
    var selected i64 = -1;
    var selected_sub = vec.empty[model.Substitution]();
    var selected_args = vec.empty[usize]();
    for var index usize = 0; index < vec.len(state.m.impls); index += 1 {
        let implementation = state.m.impls[index];
        var has_required = false;
        switch required {
            case option.Option.Some(bound): {
                switch implementation.trait_ref {
                    case option.Option.Some(application):
                        has_required = application.declaration == bound.declaration;
                    case option.Option.None: {}
                }
                if !has_required {
                    continue;
                }
            }
            case option.Option.None: {}
        }
        let match = vec.empty[model.Substitution]();
        if !matches(inout state, implementation.self_type, receiver, match) {
            continue;
        }
        switch required {
            case option.Option.Some(bound): {
                let application = option_trait_ref(implementation.trait_ref);
                if vec.len(application.args) != vec.len(bound.args) {
                    continue;
                }
                var matched = true;
                for var a usize = 0; a < vec.len(bound.args); a += 1 {
                    if !matches(inout state, application.args[a], bound.args[a],
                                match) {
                        matched = false;
                        break;
                    }
                }
                if !matched {
                    continue;
                }
            }
            case option.Option.None: {}
        }
        var has_method = false;
        for method in implementation.methods {
            if verifier_symbol(state, method).name == name {
                has_method = true;
            }
        }
        if !has_method {
            continue;
        }
        let args = matched_impl_arguments(inout state, implementation, match);
        if !args.ok {
            continue;
        }
        need(selected < 0, "method value source selection is ambiguous");
        selected = i64(index);
        selected_sub = match;
        selected_args = args.args;
    }
    need(selected >= 0, "method value source selection has no impl");
    return UniqueMethod(found: selected, substitution: selected_sub,
        args: selected_args);
}

func check_method_visibility(state Verifier, method usize,
                             implementation hir.ImplDecl, module usize)
    throws Invalid {
    if verifier_symbol(state, method).module == module {
        return;
    }
    var exported = false;
    switch implementation.trait_ref {
        case option.Option.Some(application):
            exported = verifier_symbol(state, application.declaration).exported;
        case option.Option.None:
            exported = verifier_symbol(state, method).exported;
    }
    need(exported, "method value target is private");
}

func check_concrete_method_value_source(state inout Verifier, node hir.HirNode,
    value hir.FunctionValue, source SourceMethodCall, has_source_module bool,
    source_module usize, has_source_owner bool, source_owner usize)
    throws Invalid {
    let owner = verifier_scope(state, node.scope).function;
    let module = node.source.node.module;
    let bounded = source_template_bound(inout state, source, owner);
    var type_parameter = false;
    if source.has_base_symbol {
        type_parameter = symbol_is(verifier_symbol(state, source.base_symbol).kind,
            model.SymbolKind.TypeParameter);
    }
    need(source.has_base_symbol, "method value lost its base symbol");
    if type_parameter {
        need(bounded.has, "method value source is not a concrete Type or bounded T");
    } else {
        let base_symbol = verifier_symbol(state, source.base_symbol);
        need(symbol_is(base_symbol.kind, model.SymbolKind.Type) ||
             symbol_is(base_symbol.kind, model.SymbolKind.BuiltinType),
            "method value source is not a concrete Type or bounded T");
    }
    let receiver = source_type_in_function(inout state, source.base, owner);
    if bounded.has {
        let allowed_values = allowed_for(state, owner);
        check_trait_application(inout state, bounded.bound, allowed_values);
        check_trait_parameter_bounds(inout state, bounded.bound, receiver, 0);
    }
    let target = method_value_target(state, node, value);
    let impl_index = method_impl_index(state, target.origin);
    let implementation = state.m.impls[usize(impl_index)];
    need(verifier_symbol(state, target.origin).name == source.name,
        "method value target name differs from source");
    check_method_visibility(state, target.origin, implementation, module);
    var required = option.Option[hir.TraitRef].None;
    if bounded.has {
        required = option.Option[hir.TraitRef].Some(bounded.bound);
    }
    let unique = unique_source_method(inout state, receiver, source.name,
        required);
    let selected = state.m.impls[usize(unique.found)];
    need(unique.found == impl_index,
        "method value source selected another impl than its target");
    let declaration_source = source_declaration(state, target.origin);
    let declared = source_parameters(inout state, declaration_source);
    need(vec.len(declared) >= vec.len(implementation.params),
        "method value source lost its impl generic prefix");
    for var index usize = 0; index < vec.len(implementation.params); index += 1 {
        need(declared[index].symbol == implementation.params[index].symbol,
            "method value impl prefix differs from source");
    }
    let own = vec.empty[hir.GenericParam]();
    for var index usize = vec.len(implementation.params);
        index < vec.len(declared); index += 1 {
        vec.push(own, declared[index]);
    }
    let has_type_arguments = template_index(state, value.symbol) >= 0 ||
                             target.has_instance;
    if has_type_arguments {
        need(vec.len(target.complete) == vec.len(declared),
            "method value complete type argument count");
        for var index usize = 0; index < vec.len(implementation.params); index += 1 {
            need(target.complete[index] == unique.args[index],
                "method value impl type argument differs from qualifier");
        }
    } else {
        need(vec.len(implementation.params) == 0 && vec.len(own) == 0 &&
             vec.len(target.complete) == 0,
            "generic method value has no instance target");
    }
    let own_args = vec.empty[usize]();
    if has_type_arguments {
        for var index usize = vec.len(implementation.params);
            index < vec.len(target.complete); index += 1 {
            vec.push(own_args, target.complete[index]);
        }
    }
    need(vec.len(own_args) == vec.len(own),
        "method value method-own argument count");
    if source.explicit_type_arguments {
        need(vec.len(source.explicit_arguments) == vec.len(own),
            "method value explicit type argument count");
        let allowed_values = allowed_for(state, owner);
        for var index usize = 0; index < vec.len(own); index += 1 {
            let value_type = source_type_in_function(inout state,
                source.explicit_arguments[index], owner);
            valid_type(inout state, value_type, allowed_values);
            need(value_type == own_args[index],
                "method value explicit type argument differs from target");
        }
    } else {
        let match = vec.empty[model.Substitution]();
        for var index usize = 0; index < vec.len(implementation.params); index += 1 {
            vec.push(match, model.Substitution(
                symbol: implementation.params[index].symbol,
                type_id: unique.args[index]));
        }
        let declaration_signature = source_declaration_signature(state,
            target.origin);
        need(matches(inout state, declaration_signature, target.signature,
                 match),
            "method value signature does not determine its own arguments");
        for var index usize = 0; index < vec.len(own); index += 1 {
            let found = substitution_index(match, own[index].symbol);
            need(found >= 0,
                "method value phantom argument requires an explicit suffix");
            need(match[usize(found)].type_id == own_args[index],
                "method value inferred own argument differs from target");
        }
    }
    let outer = vec.empty[model.Substitution]();
    for var index usize = 0; index < vec.len(implementation.params); index += 1 {
        vec.push(outer, model.Substitution(
            symbol: implementation.params[index].symbol,
            type_id: unique.args[index]));
    }
    constraints(inout state, own, own_args, outer);
    switch implementation.trait_ref {
        case option.Option.Some(application): {
            let trait_index = trait_declaration(state, application.declaration);
            need(trait_index >= 0, "method value impl has no real trait");
            let trait_value = state.m.traits[usize(trait_index)];
            var prototype_index i64 = -1;
            for var index usize = 0; index < vec.len(trait_value.methods); index += 1 {
                if verifier_symbol(state, trait_value.methods[index].symbol).name ==
                   source.name {
                    need(prototype_index < 0,
                        "method value has duplicate trait prototype");
                    prototype_index = i64(index);
                }
            }
            need(prototype_index >= 0, "method value has no trait prototype");
            let prototype = trait_value.methods[usize(prototype_index)];
            let concrete = hir.TraitRef(declaration: application.declaration,
                args: ids_copy(application.args));
            for var index usize = 0; index < vec.len(concrete.args); index += 1 {
                concrete.args[index] = substitute_type(inout state,
                    concrete.args[index], unique.substitution);
            }
            if bounded.has {
                need(same_trait_ref(concrete, bounded.bound),
                    "method value full trait application differs from its bound");
            }
            let prototype_own = source_parameters(inout state, prototype.source);
            need(vec.len(prototype_own) == vec.len(own),
                "method value prototype own count");
            let alpha = vec.empty[model.Substitution]();
            vec.push(alpha, model.Substitution(symbol: trait_value.self,
                type_id: receiver));
            for var index usize = 0; index < vec.len(trait_value.params); index += 1 {
                vec.push(alpha, model.Substitution(
                    symbol: trait_value.params[index].symbol,
                    type_id: concrete.args[index]));
            }
            for var index usize = 0; index < vec.len(prototype_own); index += 1 {
                vec.push(alpha, model.Substitution(
                    symbol: prototype_own[index].symbol,
                    type_id: own_args[index]));
            }
            need(substitute_type(inout state, prototype.signature, alpha) ==
                     target.signature,
                "method value prototype signature differs from target");
        }
        case option.Option.None:
            need(!bounded.has,
                "bounded T method value selected an inherent method");
    }
    need(node.type_id == target.signature, "method value type mismatch");
}

func check_template_method_value_source(state inout Verifier, node hir.HirNode,
    value hir.FunctionValue, trait_value hir.TraitDecl, prototype hir.MethodPrototype,
    source SourceMethodCall) throws Invalid {
    let owner = verifier_scope(state, node.scope).function;
    need(template_index(state, owner) >= 0,
        "trait prototype method value is outside a template");
    let bounded = source_template_bound(inout state, source, owner);
    need(bounded.has, "trait prototype method value has no bound");
    need(source.has_base_symbol && source.base_symbol == bounded.parameter,
        "trait prototype method value base differs from its parameter");
    need(trait_value.symbol == bounded.bound.declaration,
        "trait prototype belongs to another bound");
    need(value.symbol == prototype.symbol,
        "trait prototype method value target differs from source");
    need(verifier_symbol(state, prototype.symbol).name == source.name,
        "trait prototype method value name differs from source");
    let qualifier = source_type_in_function(inout state, source.base, owner);
    let qualifier_type = verifier_type(state, qualifier);
    need(kind_is(qualifier_type.kind, model.TypeKind.TypeParameter) &&
         qualifier_type.declaration == bounded.parameter,
        "trait prototype qualifier is not the bounded T");
    let allowed_values = allowed_for(state, owner);
    check_trait_application(inout state, bounded.bound, allowed_values);
    check_trait_parameter_bounds(inout state, bounded.bound, qualifier, 0);
    let own = source_parameters(inout state, prototype.source);
    need(vec.len(value.type_args) == vec.len(own),
        "trait prototype method-own argument count");
    if source.explicit_type_arguments {
        need(vec.len(source.explicit_arguments) == vec.len(own),
            "trait prototype explicit type argument count");
        let allowed_values = allowed_for(state, owner);
        for var index usize = 0; index < vec.len(own); index += 1 {
            let value_type = source_type_in_function(inout state,
                source.explicit_arguments[index], owner);
            valid_type(inout state, value_type, allowed_values);
            need(value_type == value.type_args[index],
                "trait prototype explicit type argument differs from target");
        }
    } else {
        let match = vec.empty[model.Substitution]();
        vec.push(match, model.Substitution(symbol: trait_value.self,
            type_id: qualifier));
        for var index usize = 0; index < vec.len(trait_value.params); index += 1 {
            vec.push(match, model.Substitution(
                symbol: trait_value.params[index].symbol,
                type_id: bounded.bound.args[index]));
        }
        need(matches(inout state, prototype.signature, node.type_id, match),
            "trait prototype signature does not determine its own arguments");
        for var index usize = 0; index < vec.len(own); index += 1 {
            let found = substitution_index(match, own[index].symbol);
            need(found >= 0,
                "trait prototype phantom argument requires an explicit suffix");
            need(match[usize(found)].type_id == value.type_args[index],
                "trait prototype inferred argument differs from target");
        }
    }
    let alpha = vec.empty[model.Substitution]();
    vec.push(alpha, model.Substitution(symbol: trait_value.self,
        type_id: qualifier));
    for var index usize = 0; index < vec.len(trait_value.params); index += 1 {
        vec.push(alpha, model.Substitution(
            symbol: trait_value.params[index].symbol,
            type_id: bounded.bound.args[index]));
    }
    for var index usize = 0; index < vec.len(own); index += 1 {
        vec.push(alpha, model.Substitution(symbol: own[index].symbol,
            type_id: value.type_args[index]));
    }
    constraints(inout state, own, value.type_args, alpha);
    need(node.type_id == substitute_type(inout state, prototype.signature,
             alpha),
        "trait prototype method value signature mismatch");
    need(function_entry_index(state, value.symbol) < 0 &&
         template_index(state, value.symbol) < 0,
        "trait prototype method value has a fake executable body");
}

struct SystemSpec {
    has bool;
    operation u32;
    name string;
    owner string;
    type_arity u32;
    count usize;
}

func system_spec(operation u32) SystemSpec {
    for spec in system.operations() {
        if spec.operation == operation {
            return SystemSpec(has: true, operation: spec.operation,
                name: spec.name, owner: spec.owner, type_arity: spec.type_arity,
                count: 0);
        }
    }
    return SystemSpec(has: false, operation: 0, name: "", owner: "",
        type_arity: 0, count: 0);
}

func is_weak_operation(operation u32) bool {
    let spec = system_spec(operation);
    return spec.has && (spec.name == "__woozy_weak_empty" ||
        spec.name == "__woozy_weak_downgrade" ||
        spec.name == "__woozy_weak_upgrade");
}

func check_call(state inout Verifier, node hir.HirNode, call hir.Call)
    throws Invalid {
    need((callee_id(call.kind) == 3) == option.is_some(call.system),
        "system operation metadata on wrong call kind");
    if callee_id(call.kind) == 2 {
        foreign_call(inout state, node, call);
        return;
    }
    if callee_id(call.kind) == 4 {
        c_foreign_call(inout state, node, call);
        return;
    }
    need(!option.is_some(call.binding) && !option.is_some(call.c_callable) &&
         vec.len(call.omitted) == 0, "foreign metadata on ordinary call");
    let call_owner = verifier_scope(state, node.scope).function;
    let call_allowed = allowed_for(state, call_owner);
    for argument in call.type_args {
        valid_type(inout state, argument, call_allowed);
    }
    let signature = verifier_type(state, call.signature);
    need(kind_is(signature.kind, model.TypeKind.Function),
        "call signature kind");
    need(node.type_id == signature.result, "call result mismatch");
    var direct_found = false;
    var direct_index usize = 0;
    var offset usize = 0;
    if callee_id(call.kind) == 0 {
        need(option.is_some(call.direct_symbol) && !option.is_some(call.callee),
            "direct callee metadata");
        let owner = verifier_scope(state, node.scope).function;
        if template_index(state, owner) < 0 {
            need(template_index(state, option_usize(call.direct_symbol)) < 0 &&
                 vec.len(call.type_args) == 0,
                "template call survived into concrete execution");
        }
        let found = function_entry_index(state,
            option_usize(call.direct_symbol));
        need(found >= 0, "function identity has no HIR definition");
        direct_found = true;
        direct_index = usize(found);
        need(instantiated_signature(inout state,
                 option_usize(call.direct_symbol), call.type_args) ==
             call.signature,
            "direct signature mismatch");
    } else if callee_id(call.kind) == 1 {
        need(vec.len(call.type_args) == 0,
            "type arguments on indirect call");
        need(!option.is_some(call.direct_symbol) &&
             option.is_some(call.callee),
            "function value callee metadata");
        need(verifier_expr(state, option_usize(call.callee)).type_id ==
             call.signature, "function value signature mismatch");
        offset = 1;
    } else if callee_id(call.kind) == 3 {
        let operation = option_u32_value(call.system);
        let spec = system_spec(operation);
        need(spec.has && option.is_some(call.direct_symbol) &&
             !option.is_some(call.callee),
            "system operation target metadata");
        need(vec.len(call.type_args) == usize(spec.type_arity),
            "system operation type argument count");
        let target = verifier_symbol(state, option_usize(call.direct_symbol));
        need(symbol_is(target.kind, model.SymbolKind.BuiltinFunction) &&
             target.name == spec.name && !option.is_some(target.definition) &&
             !option.is_some(target.declaration) && !target.exported &&
             !option.is_some(target.target) && !option.is_some(target.foreign),
            "system operation target is not the real builtin");
        var builtins usize = 0;
        for symbol in state.m.resolved.symbols {
            if symbol_is(symbol.kind, model.SymbolKind.BuiltinFunction) &&
               symbol.name == spec.name {
                builtins += 1;
            }
        }
        need(builtins == 1,
            "system operation builtin identity is ambiguous");
        let module = verifier_module(state, node.source.node.module);
        need(module.logical_path == spec.owner &&
             !option.is_some(module.binding),
            "system operation source is outside " + spec.owner);
        let actual_signature = system_operation_signature(inout state,
            operation, call.type_args);
        need(call.signature == actual_signature,
            "system operation fixed signature mismatch");
        let file = verifier_file(state, node.source.node.module,
            node.source.node.file);
        let syntax = file.nodes[node.source.node.node];
        need(ast_is(syntax.kind, model.AstKind.Call) &&
             vec.len(syntax.children) == spec_count(operation) + 1 &&
             vec.len(call.args) == spec_count(operation),
            "system operation source call/arity");
        var callee = node.source.node;
        callee.node = syntax.children[0];
        for true {
            if !ast_is(file.nodes[callee.node].kind,
                       model.AstKind.Parenthesized) {
                break;
            }
            need(vec.len(file.nodes[callee.node].children) > 0,
                "system operation source callee");
            callee.node = file.nodes[callee.node].children[0];
        }
        let syntax_target = file.nodes[callee.node];
        if spec.type_arity > 0 {
            need(ast_is(syntax_target.kind, model.AstKind.NeutralBracket) &&
                 vec.len(syntax_target.children) == usize(spec.type_arity) + 1,
                "system operation source type argument shape");
            var base = callee;
            base.node = syntax_target.children[0];
            for true {
                if !ast_is(file.nodes[base.node].kind,
                           model.AstKind.Parenthesized) {
                    break;
                }
                need(vec.len(file.nodes[base.node].children) > 0,
                    "system operation source base");
                base.node = file.nodes[base.node].children[0];
            }
            let syntax_base = file.nodes[base.node];
            need(ast_is(syntax_base.kind, model.AstKind.Name) &&
                 syntax_base.token_begin < vec.len(file.lexed.tokens) &&
                 file.lexed.tokens[syntax_base.token_begin].spelling == spec.name &&
                 same_option_symbol(resolved_source(state, base),
                     call.direct_symbol),
                "system operation differs from resolved source builtin");
            for var index usize = 0; index < usize(spec.type_arity); index += 1 {
                var source_argument = callee;
                source_argument.node = syntax_target.children[index + 1];
                let source_type_id = source_type_in_function(inout state,
                    source_argument, call_owner);
                valid_type(inout state, source_type_id, call_allowed);
                need(source_type_id == call.type_args[index],
                    "system operation source type argument differs from Call");
            }
        } else {
            need(ast_is(syntax_target.kind, model.AstKind.Name) &&
                 syntax_target.token_begin < vec.len(file.lexed.tokens) &&
                 file.lexed.tokens[syntax_target.token_begin].spelling == spec.name &&
                 same_option_symbol(resolved_source(state, callee),
                     call.direct_symbol),
                "system operation differs from resolved source builtin");
        }
        if is_weak_operation(operation) {
            need(vec.len(call.type_args) == 1 &&
                 (type_contains_parameter(state.m, call.type_args[0]) ||
                  weak_target(state.m, call.type_args[0])),
                "Weak operation target is not a canonical source declaration");
        }
        for var index usize = 0; index < vec.len(call.args); index += 1 {
            let argument = file.nodes[syntax.children[index + 1]];
            need(ast_is(argument.kind, model.AstKind.Argument) &&
                 vec.len(argument.children) == 1 &&
                 argument.token_begin + 1 < vec.len(file.lexed.tokens) &&
                 file.lexed.tokens[argument.token_begin + 1].spelling != ":" &&
                 !option.is_some(call.args[index].label) &&
                 mode_is_id(call.args[index].mode, 0),
                "system operation source argument label/mode");
            var reference = node.source.node;
            reference.node = argument.children[0];
            reference = unwrapped(state, reference);
            let value = file.nodes[reference.node];
            need(!(ast_is(value.kind, model.AstKind.Unary) &&
                   (file.lexed.tokens[value.token_begin].spelling == "move" ||
                    file.lexed.tokens[value.token_begin].spelling == "inout")),
                "system operation source argument marker");
            let expression = verifier_expr(state, call.args[index].expression);
            need(!node_is(hir.node_kind(expression.data), hir.NodeKind.Move) &&
                 same_ref(unwrapped(state, expression.source.node), reference),
                "system operation argument differs from source");
        }
    } else {
        fail("unsupported callee kind");
    }
    need(vec.len(call.args) == vec.len(signature.parameters) &&
         vec.len(node.children) == vec.len(call.args) + offset,
        "call arity/children");
    if offset > 0 {
        need(node.children[0] == option_usize(call.callee),
            "callee must be evaluated first");
    }
    if callee_id(call.kind) == 1 {
        let file = verifier_file(state, node.source.node.module,
            node.source.node.file);
        let syntax = file.nodes[node.source.node.node];
        need(ast_is(syntax.kind, model.AstKind.Call) &&
             vec.len(syntax.children) > 0 &&
             vec.len(syntax.children) == vec.len(call.args) + 1,
            "function value call lost source call/arity");
        var target = node.source.node;
        target.node = syntax.children[0];
        need(same_ref(unwrapped(state,
                 verifier_node(state, option_usize(call.callee)).source.node),
                 unwrapped(state, target)),
            "function value callee differs from source");
        for var index usize = 0; index < vec.len(call.args); index += 1 {
            let argument = file.nodes[syntax.children[index + 1]];
            need(ast_is(argument.kind, model.AstKind.Argument) &&
                 vec.len(argument.children) == 1,
                "function value source argument kind");
            let original = file.nodes[argument.children[0]];
            let value = verifier_node(state, call.args[index].expression).source;
            need(value.node.module == node.source.node.module &&
                 value.node.file == node.source.node.file &&
                 value.span.begin_byte >= original.span.begin_byte &&
                 value.span.end_byte <= original.span.end_byte,
                "function value argument differs from source");
        }
    }
    let seen = vec.make[bool](vec.len(signature.parameters), false);
    let owner_allowed = call_allowed;
    var named = false;
    for var index usize = 0; index < vec.len(call.args); index += 1 {
        let argument = call.args[index];
        need(argument.source_index == u32(index) &&
             usize(argument.parameter_index) < vec.len(seen),
            "call source/parameter index");
        need(!seen[usize(argument.parameter_index)],
            "duplicate call parameter");
        seen[usize(argument.parameter_index)] = true;
        need(node.children[index + offset] == argument.expression,
            "call children must preserve source order");
        let parameter = signature.parameters[usize(argument.parameter_index)];
        let value = verifier_node(state, argument.expression);
        need(mode_is_id(argument.mode, mode_id_value(parameter.mode)) &&
             value.type_id == parameter.type_id,
            "call argument mode/type");
        if mode_is_id(parameter.mode, 1) {
            need(inout_place(value) &&
                 inout_slot_type(state.m, parameter.type_id, owner_allowed),
                "inout requires a whole Woozy value place");
        } else {
            need(mode_is_id(parameter.mode, 0) ||
                 mode_is_id(parameter.mode, 2),
                "unsupported argument mode");
            let ignored = verifier_expr(state, argument.expression);
        }
        if option.is_some(argument.label) {
            named = true;
            need(direct_found && option_string_value(argument.label) != "" &&
                 option_string_value(argument.label) ==
                     verifier_function(state,
                         option_usize(call.direct_symbol)).parameters[
                             usize(argument.parameter_index)].label,
                "call label mismatch or label on function value");
        } else {
            need(!named && usize(argument.parameter_index) == index,
                "positional argument index/order");
        }
    }
    check_call_aliases(inout state, call.args, option.is_some(call.callee));
    if callee_id(call.kind) == 0 {
        check_qualified_method_source(inout state, node, call);
        check_explicit_method_arguments(inout state, node, call);
    }
}

func spec_count(operation u32) usize {
    for spec in system.operations() {
        if spec.operation == operation {
            return vec.len(spec.parameters);
        }
    }
    return 0;
}

func same_option_symbol(left option.Option[usize],
                        right option.Option[usize]) bool {
    if option.is_some(left) != option.is_some(right) {
        return false;
    }
    if !option.is_some(left) {
        return true;
    }
    return option_usize(left) == option_usize(right);
}

func system_operation_signature(state inout Verifier, operation u32,
                                arguments Vec[usize]) usize throws Invalid {
    let module_value = state.m;
    try {
        return signature.system_operation_signature(inout state.substituted,
            option.Option[hir.HirModule].Some(module_value), operation,
            arguments);
    } catch error model.SupportError {
        support_error(error);
        return 0;
    }
}
