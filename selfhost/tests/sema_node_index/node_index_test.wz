// Test-only package-sema driver for the private sorted NodeKey index.
// It calls the real run_put_node_symbol, node_symbol_position, definition,
// occurrence and b_occurrence_raw code.  The linear routines at the end are a
// test oracle copied from the pre-change product rules; they are not product
// code and are used only to compare inputs and results.
package sema;

import "app/wzcc/hir" as hir;
import "app/wzcc/lexer" as lexer;
import "app/wzcc/model" as model;
import "app/wzcc/parser" as parser;
import "app/wzcc/resolve" as resolve;
import "app/wzcc/source" as sources;
import "std/io" as io;
import "std/option" as option;
import "std/os" as os;
import "std/strconv" as strconv;
import "std/text" as text;
import "std/time" as time;
import "std/vec" as vec;

struct NodeIndexTest {
    checks usize;
    failures usize;
    failed Vec[string];
}

struct NodeIndexBench {
    scale usize;
    product_insert_ns i64;
    oracle_insert_ns i64;
    product_lookup_ns i64;
    oracle_lookup_ns i64;
    insert_calls usize;
    lookup_calls usize;
    oracle_insert_comparisons usize;
    oracle_lookup_comparisons usize;
    product_insert_sum u64;
    oracle_insert_sum u64;
    product_lookup_sum u64;
    oracle_lookup_sum u64;
    product_missing usize;
    oracle_missing usize;
}

func node_index_check(t inout NodeIndexTest, ok bool, label string) {
    t.checks += 1;
    if !ok {
        t.failures += 1;
        vec.push(t.failed, label);
    }
}

func node_index_key(module usize, file usize, node usize) NodeKey {
    return NodeKey(module: module, file: file, node: node);
}

func node_index_sorted(entries Vec[NodeSymbolEntry]) bool {
    for var index usize = 1; index < vec.len(entries); index += 1 {
        if node_key_less(entries[index].key, entries[index - 1].key) {
            return false;
        }
        if same_node_key(entries[index].key, entries[index - 1].key) {
            return false;
        }
    }
    return true;
}

func node_index_same_entries(left Vec[NodeSymbolEntry],
                             right Vec[NodeSymbolEntry]) bool {
    if vec.len(left) != vec.len(right) { return false; }
    for var index usize = 0; index < vec.len(left); index += 1 {
        if !same_node_key(left[index].key, right[index].key) { return false; }
        if left[index].symbol != right[index].symbol { return false; }
    }
    return true;
}

func node_index_option_id(value option.Option[usize]) usize {
    switch value {
        case option.Option.Some(id): return id;
        case option.Option.None: return 0;
    }
}

func node_index_option_some(value option.Option[usize]) bool {
    switch value {
        case option.Option.Some(_): return true;
        case option.Option.None: return false;
    }
}

func node_index_option_equal(left option.Option[usize],
                             right option.Option[usize]) bool {
    switch left {
        case option.Option.Some(a): {
            switch right {
                case option.Option.Some(b): return a == b;
                case option.Option.None: return false;
            }
        }
        case option.Option.None: {
            switch right {
                case option.Option.Some(b): return false;
                case option.Option.None: return true;
            }
        }
    }
}

// Actual shared lookup, with the same absent-neighbour check as the callers.
func node_index_lookup_id(entries Vec[NodeSymbolEntry],
                          key NodeKey) option.Option[usize] {
    let position = node_symbol_position(entries, key);
    if position < vec.len(entries) &&
       same_node_key(entries[position].key, key) {
        return option.Option[usize].Some(entries[position].symbol);
    }
    return option.Option[usize].None;
}

// Test oracle copied verbatim from the old linear insertion rule.
func node_index_oracle_less(left NodeKey, right NodeKey) bool {
    if left.module != right.module { return left.module < right.module; }
    if left.file != right.file { return left.file < right.file; }
    return left.node < right.node;
}

func node_index_oracle_put(entries Vec[NodeSymbolEntry], key NodeKey,
                           id usize, replace bool,
                           comparisons inout usize) {
    var position usize = 0;
    for position < vec.len(entries) {
        comparisons += 1;
        if node_index_oracle_less(entries[position].key, key) {
            position += 1;
        } else {
            break;
        }
    }
    if position < vec.len(entries) &&
       same_node_key(entries[position].key, key) {
        if replace { entries[position].symbol = id; }
        return;
    }
    let entry = NodeSymbolEntry(key: key, symbol: id);
    vec.push(entries, entry);
    var index = vec.len(entries) - 1;
    for index > position {
        entries[index] = entries[index - 1];
        index -= 1;
    }
    entries[position] = entry;
}

func node_index_oracle_get(entries Vec[NodeSymbolEntry], key NodeKey,
                           comparisons inout usize) option.Option[usize] {
    for entry in entries {
        comparisons += 1;
        if same_node_key(entry.key, key) {
            return option.Option[usize].Some(entry.symbol);
        }
    }
    return option.Option[usize].None;
}

func node_index_checksum(entries Vec[NodeSymbolEntry]) u64 {
    var sum u64 = 0;
    for entry in entries {
        sum += u64(entry.key.module) * 1000003 +
            u64(entry.key.file) * 10007 +
            u64(entry.key.node) * 31 + u64(entry.symbol);
    }
    return sum;
}

func node_index_order(count usize, mode u32) Vec[usize] {
    let order = vec.empty[usize]();
    if mode == 0 {
        for var index usize = 0; index < count; index += 1 {
            vec.push(order, index);
        }
    } else if mode == 1 {
        for var index usize = count; index > 0; index -= 1 {
            vec.push(order, index - 1);
        }
    } else {
        var low usize = 0;
        var high usize = count;
        var take_low = true;
        for low < high {
            if take_low {
                vec.push(order, low);
                low += 1;
            } else {
                high -= 1;
                vec.push(order, high);
            }
            take_low = !take_low;
        }
    }
    return order;
}

func node_index_direct_tests(t inout NodeIndexTest) {
    let empty = vec.empty[NodeSymbolEntry]();
    let nowhere = node_index_key(3, 4, 5);
    node_index_check(inout t, node_symbol_position(empty, nowhere) == 0,
        "empty lower_bound");
    node_index_check(inout t, !node_index_option_some(
        node_index_lookup_id(empty, nowhere)), "empty lookup");

    let single = vec.empty[NodeSymbolEntry]();
    run_put_node_symbol(single, nowhere, 17, false);
    node_index_check(inout t, vec.len(single) == 1 && single[0].symbol == 17,
        "single insertion");
    node_index_check(inout t, node_index_option_id(
        node_index_lookup_id(single, nowhere)) == 17, "single lookup");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        single, node_index_key(3, 4, 6))), "single missing above");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        single, node_index_key(3, 3, 5))), "single missing file");

    for var mode u32 = 0; mode < 3; mode += 1 {
        let order = node_index_order(24, mode);
        let actual = vec.empty[NodeSymbolEntry]();
        let oracle = vec.empty[NodeSymbolEntry]();
        var oracle_comparisons usize = 0;
        for var step usize = 0; step < vec.len(order); step += 1 {
            let node = order[step];
            let key = node_index_key(0, 0, node);
            let id = node + 100;
            run_put_node_symbol(actual, key, id, false);
            node_index_oracle_put(oracle, key, id, false,
                inout oracle_comparisons);
            node_index_check(inout t, node_index_sorted(actual),
                "incremental product sort");
            node_index_check(inout t, node_index_same_entries(actual, oracle),
                "incremental oracle equality");
        }
        node_index_check(inout t, vec.len(actual) == vec.len(oracle),
            "order length");
        for node in order {
            let key = node_index_key(0, 0, node);
            let actual_id = node_index_lookup_id(actual, key);
            let oracle_id = node_index_oracle_get(oracle, key,
                inout oracle_comparisons);
            node_index_check(inout t, node_index_option_equal(actual_id, oracle_id),
                "order lookup equality");
        }
        node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
            actual, node_index_key(0, 0, 24))), "order missing above");
        node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
            actual, node_index_key(0, 1, 0))), "order missing file");
        node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
            actual, node_index_key(1, 0, 0))), "order missing module");
    }

    let defs = vec.empty[NodeSymbolEntry]();
    let duplicate = node_index_key(3, 4, 5);
    run_put_node_symbol(defs, node_index_key(3, 4, 4), 40, false);
    run_put_node_symbol(defs, duplicate, 10, false);
    run_put_node_symbol(defs, node_index_key(3, 4, 6), 41, false);
    run_put_node_symbol(defs, duplicate, 11, false);
    node_index_check(inout t, vec.len(defs) == 3, "first definition count");
    node_index_check(inout t, defs[1].symbol == 10, "first definition retained");
    node_index_check(inout t, node_index_sorted(defs), "first definition sorted");

    let occurrences = vec.empty[NodeSymbolEntry]();
    run_put_node_symbol(occurrences, duplicate, 20, true);
    run_put_node_symbol(occurrences, duplicate, 21, true);
    node_index_check(inout t, vec.len(occurrences) == 1, "last occurrence count");
    node_index_check(inout t, occurrences[0].symbol == 21,
        "last occurrence retained");

    let cross = vec.empty[NodeSymbolEntry]();
    run_put_node_symbol(cross, node_index_key(1, 1, 7), 4, false);
    run_put_node_symbol(cross, node_index_key(0, 1, 7), 2, false);
    run_put_node_symbol(cross, node_index_key(1, 0, 7), 3, false);
    run_put_node_symbol(cross, node_index_key(0, 0, 7), 1, false);
    node_index_check(inout t, node_index_sorted(cross), "cross tuple sorted");
    node_index_check(inout t, vec.len(cross) == 4, "cross tuple count");
    node_index_check(inout t, cross[0].symbol == 1 && cross[1].symbol == 2 &&
        cross[2].symbol == 3 && cross[3].symbol == 4,
        "cross tuple module/file order");
    for var node usize = 0; node < 2; node += 1 {
        for var file usize = 0; file < 2; file += 1 {
            let key = node_index_key(node, file, 7);
            node_index_check(inout t, node_index_option_id(
                node_index_lookup_id(cross, key)) == node * 2 + file + 1,
                "cross tuple lookup");
        }
    }
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        cross, node_index_key(0, 2, 7))), "cross missing file");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        cross, node_index_key(2, 0, 7))), "cross missing module");

    let edge = vec.empty[NodeSymbolEntry]();
    let max_key = node_index_key(18446744073709551615,
        18446744073709551615, 18446744073709551615);
    run_put_node_symbol(edge, node_index_key(0, 0, 0), 1, false);
    run_put_node_symbol(edge, node_index_key(0, 0, 8), 2, false);
    run_put_node_symbol(edge, max_key, 3, false);
    node_index_check(inout t, node_index_sorted(edge), "edge sorted");
    node_index_check(inout t, node_index_option_id(
        node_index_lookup_id(edge, max_key)) == 3, "max key lookup");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        edge, node_index_key(0, 0, 1))), "edge missing between");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        edge, node_index_key(18446744073709551615,
            18446744073709551615, 18446744073709551614))),
        "edge missing just below max node");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        edge, node_index_key(18446744073709551615,
            18446744073709551614, 18446744073709551615))),
        "edge missing just below max file");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        edge, node_index_key(18446744073709551614,
            18446744073709551615, 18446744073709551615))),
        "edge missing just below max module");
}

func node_index_project() model.Project {
    let body = "package p; " +
        "func f()i32{return 1;} " +
        "func g()i32{let x i32=1;return (((x)));} " +
        "func h()i32{return f();}";
    let parsed = parser.parse(lexer.lex(sources.snapshot(2, 2, 2,
        "/tmp/sema-node-index/input.wz", text.bytes(body))));
    let other = parser.parse(lexer.lex(sources.snapshot(1, 1, 1,
        "/tmp/sema-node-index/other.wz", text.bytes("package q;"))));
    var project = model.empty_project();
    project.entry = 1;
    project.files = [other, parsed];
    project.modules = [
        model.Module(id: 0, logical_path: "q", identity: "q",
            package_name: "q", files: [0], imports: [],
            foreign_exports: [],
            binding: option.Option[model.BindingModuleRef].None,
            c_binding: option.Option[usize].None),
        model.Module(id: 1, logical_path: "p", identity: "p",
            package_name: "p", files: [1], imports: [],
            foreign_exports: [],
            binding: option.Option[model.BindingModuleRef].None,
            c_binding: option.Option[usize].None)
    ];
    return project;
}

func node_index_symbol_id(state inout Checker, name string) usize throws Error {
    for value in state.m.resolved.symbols {
        if value.name == name { return value.id; }
    }
    throw internal_error("test symbol missing: " + name);
}

func node_index_symbol_ref(state inout Checker, name string)
    model.NodeRef throws Error {
    let id = node_index_symbol_id(inout state, name);
    let value = symbol(inout state, id);
    switch value.definition {
        case option.Option.Some(location): return location;
        case option.Option.None:
            throw internal_error("test definition missing: " + name);
    }
}

func node_index_missing_definition(state inout Checker, r model.NodeRef) bool {
    try {
        let ignored = definition(inout state, r);
        return false;
    } catch error Error {
        switch error {
            case Error.Support(support): {
                switch support {
                    case model.SupportError.Invalid(message):
                        return message == "missing sema definition";
                    case model.SupportError.Limit(message):
                        return false;
                }
            }
            case Error.Rejected(diagnostic, failure): return false;
        }
    }
    return false;
}

func node_index_monotonic() os.Timespec throws Error {
    try { return time.monotonic(); }
    catch error os.Error {
        throw internal_error("monotonic clock unavailable");
    }
    return os.Timespec(seconds: 0, nanoseconds: 0);
}

func node_index_elapsed(start os.Timespec, finish os.Timespec) i64 {
    return (finish.seconds - start.seconds) * 1000000000 +
        (finish.nanoseconds - start.nanoseconds);
}

func node_index_bench(state inout Checker, scale usize)
    NodeIndexBench throws Error {
    let product = vec.empty[NodeSymbolEntry]();
    let oracle = vec.empty[NodeSymbolEntry]();
    var oracle_insert_comparisons usize = 0;

    var start = node_index_monotonic();
    for var index usize = 0; index < scale; index += 1 {
        run_put_node_symbol(product, node_index_key(0, 0, index),
            index + 1, false);
    }
    var finish = node_index_monotonic();
    let product_insert_ns = node_index_elapsed(start, finish);

    start = node_index_monotonic();
    for var index usize = 0; index < scale; index += 1 {
        node_index_oracle_put(oracle, node_index_key(0, 0, index),
            index + 1, false, inout oracle_insert_comparisons);
    }
    finish = node_index_monotonic();
    let oracle_insert_ns = node_index_elapsed(start, finish);

    var probe = state;
    probe.definitions = product;
    probe.occurrences = product;
    var product_lookup_sum u64 = 0;
    var product_missing usize = 0;
    start = node_index_monotonic();
    for var index usize = 0; index < scale; index += 1 {
        let location = model.NodeRef(module: 0, file: 0, node: index);
        let definition_id = definition(inout probe, location);
        product_lookup_sum += u64(definition_id);
        switch b_occurrence_raw(inout probe, location) {
            case option.Option.Some(id):
                product_lookup_sum += u64(id);
            case option.Option.None:
                product_missing += 1;
        }
    }
    finish = node_index_monotonic();
    let product_lookup_ns = node_index_elapsed(start, finish);

    var oracle_lookup_sum u64 = 0;
    var oracle_missing usize = 0;
    var oracle_lookup_comparisons usize = 0;
    start = node_index_monotonic();
    for var index usize = 0; index < scale; index += 1 {
        let key = node_index_key(0, 0, index);
        switch node_index_oracle_get(oracle, key,
            inout oracle_lookup_comparisons) {
            case option.Option.Some(id): oracle_lookup_sum += u64(id);
            case option.Option.None: oracle_missing += 1;
        }
        switch node_index_oracle_get(oracle, key,
            inout oracle_lookup_comparisons) {
            case option.Option.Some(id): oracle_lookup_sum += u64(id);
            case option.Option.None: oracle_missing += 1;
        }
    }
    finish = node_index_monotonic();
    let oracle_lookup_ns = node_index_elapsed(start, finish);

    return NodeIndexBench(scale: scale,
        product_insert_ns: product_insert_ns,
        oracle_insert_ns: oracle_insert_ns,
        product_lookup_ns: product_lookup_ns,
        oracle_lookup_ns: oracle_lookup_ns,
        insert_calls: scale, lookup_calls: scale * 2,
        oracle_insert_comparisons: oracle_insert_comparisons,
        oracle_lookup_comparisons: oracle_lookup_comparisons,
        product_insert_sum: node_index_checksum(product),
        oracle_insert_sum: node_index_checksum(oracle),
        product_lookup_sum: product_lookup_sum,
        oracle_lookup_sum: oracle_lookup_sum,
        product_missing: product_missing,
        oracle_missing: oracle_missing);
}

func node_index_real_checks(t inout NodeIndexTest, small usize, large usize)
    Vec[NodeIndexBench] throws Error {
    let benches = vec.empty[NodeIndexBench]();
    let resolved = resolve.resolve_project(node_index_project());
    var complete = false;
    switch resolved.state {
        case model.PhaseState.Complete: complete = true;
        default: {}
    }
    node_index_check(inout t, resolved.has_value && complete &&
        vec.len(resolved.diagnostics) == 0, "real source parse/resolve");
    if !resolved.has_value || !complete ||
       vec.len(resolved.diagnostics) != 0 {
        return benches;
    }
    let module = hir.empty_module(resolved.value, 1,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    var base = initialize_checker(module);

    node_index_check(inout t, vec.len(base.definitions) > 0,
        "initialized definitions nonempty");
    node_index_check(inout t, vec.len(base.occurrences) > 0,
        "initialized occurrences nonempty");
    node_index_check(inout t, node_index_sorted(base.definitions),
        "initialized definitions sorted");
    node_index_check(inout t, node_index_sorted(base.occurrences),
        "initialized occurrences sorted");
    for entry in base.definitions {
        let location = model.NodeRef(module: entry.key.module,
            file: entry.key.file, node: entry.key.node);
        node_index_check(inout t, definition(inout base, location) == entry.symbol,
            "definition table entry lookup");
    }
    for entry in base.occurrences {
        let location = model.NodeRef(module: entry.key.module,
            file: entry.key.file, node: entry.key.node);
        switch b_occurrence_raw(inout base, location) {
            case option.Option.Some(id):
                node_index_check(inout t, id == entry.symbol,
                    "occurrence table entry lookup");
            case option.Option.None:
                node_index_check(inout t, false, "occurrence table entry missing");
        }
    }

    let f = node_index_symbol_id(inout base, "f");
    let g = node_index_symbol_id(inout base, "g");
    let h = node_index_symbol_id(inout base, "h");
    let x = node_index_symbol_id(inout base, "x");
    let f_ref = node_index_symbol_ref(inout base, "f");
    let g_ref = node_index_symbol_ref(inout base, "g");
    let h_ref = node_index_symbol_ref(inout base, "h");
    let x_ref = node_index_symbol_ref(inout base, "x");
    node_index_check(inout t, definition(inout base, f_ref) == f,
        "real definition f");
    node_index_check(inout t, definition(inout base, g_ref) == g,
        "real definition g");
    node_index_check(inout t, definition(inout base, h_ref) == h,
        "real definition h");
    node_index_check(inout t, definition(inout base, x_ref) == x,
        "real definition x binding");

    var found_parenthesized = false;
    var found_name_x = false;
    for module_value in base.m.resolved.project.modules {
        for var file_index usize = 0; file_index < vec.len(module_value.files);
            file_index += 1 {
            let file_ref = model.NodeRef(module: module_value.id,
                file: file_index, node: 0);
            let file = parsed_file(inout base, file_ref);
            for var node_index usize = 0; node_index < vec.len(file.nodes);
                node_index += 1 {
                let location = model.NodeRef(module: module_value.id,
                    file: file_index, node: node_index);
                let node_value = ast(inout base, location);
                switch node_value.kind {
                    case model.AstKind.Parenthesized: {
                        found_parenthesized = true;
                        switch occurrence(inout base, location) {
                            case option.Option.Some(id):
                                node_index_check(inout t, id == x,
                                    "parenthesized occurrence x");
                            case option.Option.None:
                                node_index_check(inout t, false,
                                    "parenthesized occurrence missing");
                        }
                        switch b_occurrence_raw(inout base, location) {
                            case option.Option.Some(id):
                                node_index_check(inout t, false,
                                    "raw occurrence unwrapped");
                            case option.Option.None:
                                node_index_check(inout t, true,
                                    "raw occurrence keeps parentheses absent");
                        }
                    }
                    case model.AstKind.Name: {
                        if token(inout base, location, 0) == "x" {
                            found_name_x = true;
                            switch occurrence(inout base, location) {
                                case option.Option.Some(id):
                                    node_index_check(inout t, id == x,
                                        "name occurrence x");
                                case option.Option.None:
                                    node_index_check(inout t, false,
                                        "name occurrence missing");
                            }
                            switch b_occurrence_raw(inout base, location) {
                                case option.Option.Some(id):
                                    node_index_check(inout t, id == x,
                                        "raw name occurrence x");
                                case option.Option.None:
                                    node_index_check(inout t, false,
                                        "raw name occurrence missing");
                            }
                        }
                    }
                    default: {}
                }
            }
        }
    }
    node_index_check(inout t, found_parenthesized && found_name_x,
        "real parenthesized and name nodes found");

    let root_ref = model.NodeRef(module: 1, file: 0, node: 0);
    node_index_check(inout t, node_index_missing_definition(inout base, root_ref),
        "missing definition keeps original error");
    node_index_check(inout t, !node_index_option_some(
        occurrence(inout base, root_ref)), "missing occurrence root");
    node_index_check(inout t, !node_index_option_some(
        b_occurrence_raw(inout base, root_ref)), "missing raw occurrence root");

    let f_key = node_key(f_ref);
    let custom_defs = vec.empty[NodeSymbolEntry]();
    run_put_node_symbol(custom_defs, f_key, 700, false);
    run_put_node_symbol(custom_defs, f_key, 701, false);
    let custom_occurrences = vec.empty[NodeSymbolEntry]();
    run_put_node_symbol(custom_occurrences, f_key, 800, true);
    run_put_node_symbol(custom_occurrences, f_key, 801, true);
    node_index_check(inout t, vec.len(custom_defs) == 1 &&
        custom_defs[0].symbol == 700, "custom first definition");
    node_index_check(inout t, vec.len(custom_occurrences) == 1 &&
        custom_occurrences[0].symbol == 801, "custom last occurrence");

    var probe = base;
    probe.definitions = custom_defs;
    probe.occurrences = custom_occurrences;
    node_index_check(inout t, definition(inout probe, f_ref) == 700,
        "definition caller keeps first");
    switch occurrence(inout probe, f_ref) {
        case option.Option.Some(id):
            node_index_check(inout t, id == 801, "occurrence caller keeps last");
        case option.Option.None:
            node_index_check(inout t, false, "occurrence caller missing");
    }
    switch b_occurrence_raw(inout probe, f_ref) {
        case option.Option.Some(id):
            node_index_check(inout t, id == 801, "raw caller keeps last");
        case option.Option.None:
            node_index_check(inout t, false, "raw caller missing");
    }

    probe.definitions = vec.empty[NodeSymbolEntry]();
    probe.occurrences = vec.empty[NodeSymbolEntry]();
    node_index_check(inout t, node_index_missing_definition(inout probe, f_ref),
        "empty custom definition error");
    node_index_check(inout t, !node_index_option_some(
        occurrence(inout probe, f_ref)), "empty custom occurrence");
    node_index_check(inout t, !node_index_option_some(
        b_occurrence_raw(inout probe, f_ref)), "empty custom raw occurrence");

    let base_defs_len = vec.len(base.definitions);
    let base_occurrences_len = vec.len(base.occurrences);
    var copy = clone_checker(base);
    node_index_check(inout t, node_index_same_entries(copy.definitions,
        base.definitions), "clone definitions equal");
    node_index_check(inout t, node_index_same_entries(copy.occurrences,
        base.occurrences), "clone occurrences equal");
    node_index_check(inout t, node_index_sorted(copy.definitions),
        "clone definitions sorted");
    node_index_check(inout t, node_index_sorted(copy.occurrences),
        "clone occurrences sorted");
    run_put_node_symbol(copy.definitions, node_index_key(9, 9, 9), 900, false);
    run_put_node_symbol(copy.occurrences, node_index_key(9, 9, 8), 901, true);
    node_index_check(inout t, vec.len(base.definitions) == base_defs_len,
        "clone definitions independent from copy");
    node_index_check(inout t, vec.len(base.occurrences) == base_occurrences_len,
        "clone occurrences independent from copy");
    node_index_check(inout t, vec.len(copy.definitions) == base_defs_len + 1,
        "copy definitions grew");
    node_index_check(inout t, vec.len(copy.occurrences) == base_occurrences_len + 1,
        "copy occurrences grew");
    node_index_check(inout t, node_index_sorted(copy.definitions),
        "copy definitions stay sorted");
    node_index_check(inout t, node_index_sorted(copy.occurrences),
        "copy occurrences stay sorted");
    run_put_node_symbol(base.definitions, node_index_key(8, 8, 8), 902, false);
    node_index_check(inout t, vec.len(copy.definitions) == base_defs_len + 1,
        "copy definitions independent from base");
    node_index_check(inout t, vec.len(base.definitions) == base_defs_len + 1,
        "base definitions grew separately");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        copy.definitions, node_index_key(8, 8, 8))),
        "base mutation absent from copy");
    node_index_check(inout t, !node_index_option_some(node_index_lookup_id(
        base.definitions, node_index_key(9, 9, 9))),
        "copy mutation absent from base");

    vec.push(benches, node_index_bench(inout base, small));
    vec.push(benches, node_index_bench(inout base, large));
    return benches;
}

func node_index_print_bench(value NodeIndexBench) throws os.Error {
    io.println("BENCH scale=" + strconv.format_u64(u64(value.scale)) +
        " product_insert_ns=" +
        strconv.format_i64(value.product_insert_ns) +
        " oracle_insert_ns=" +
        strconv.format_i64(value.oracle_insert_ns) +
        " product_lookup_ns=" +
        strconv.format_i64(value.product_lookup_ns) +
        " oracle_lookup_ns=" +
        strconv.format_i64(value.oracle_lookup_ns) +
        " insert_calls=" + strconv.format_u64(u64(value.insert_calls)) +
        " lookup_calls=" + strconv.format_u64(u64(value.lookup_calls)) +
        " oracle_insert_comparisons=" +
        strconv.format_u64(u64(value.oracle_insert_comparisons)) +
        " oracle_lookup_comparisons=" +
        strconv.format_u64(u64(value.oracle_lookup_comparisons)) +
        " product_insert_sum=" +
        strconv.format_u64(value.product_insert_sum) +
        " oracle_insert_sum=" +
        strconv.format_u64(value.oracle_insert_sum) +
        " product_lookup_sum=" +
        strconv.format_u64(value.product_lookup_sum) +
        " oracle_lookup_sum=" +
        strconv.format_u64(value.oracle_lookup_sum) +
        " product_missing=" +
        strconv.format_u64(u64(value.product_missing)) +
        " oracle_missing=" +
        strconv.format_u64(u64(value.oracle_missing)));
}

pub func run_node_index_tests(small usize, large usize) i32 throws os.Error {
    var test = NodeIndexTest(checks: 0, failures: 0,
        failed: vec.empty[string]());
    node_index_direct_tests(inout test);
    var benches = vec.empty[NodeIndexBench]();
    try {
        benches = node_index_real_checks(inout test, small, large);
    } catch error Error {
        node_index_check(inout test, false, "real checks threw an Error");
    }
    for bench in benches {
        node_index_check(inout test,
            bench.product_insert_sum == bench.oracle_insert_sum,
            "bench insertion checksum");
        node_index_check(inout test,
            bench.product_lookup_sum == bench.oracle_lookup_sum,
            "bench lookup checksum");
        node_index_check(inout test,
            bench.product_missing == 0 && bench.oracle_missing == 0,
            "bench lookup missing");
        node_index_check(inout test,
            bench.insert_calls == bench.scale &&
            bench.lookup_calls == bench.scale * 2,
            "bench call counts");
        node_index_print_bench(bench);
    }
    for label in test.failed {
        io.println("FAIL " + label);
    }
    io.println("NODE_INDEX passed=" +
        strconv.format_u64(u64(test.checks - test.failures)) +
        " failed=" + strconv.format_u64(u64(test.failures)));
    if test.failures != 0 { return 1; }
    return 0;
}
