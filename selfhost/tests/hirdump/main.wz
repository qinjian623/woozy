func public_module_dump(module hir.HirModule) string throws model.SupportError {
    return hirdump.dump_module(module);
}

func public_types_dump(context types.Context) string {
    return hirdump.dump_types(context);
}

func bool_text(value bool) string {
    if value { return "1"; }
    return "0";
}

func phase_id(state model.PhaseState) u32 {
    switch state {
        case model.PhaseState.Complete: return 0;
        case model.PhaseState.Recovered: return 1;
        case model.PhaseState.Failed: return 2;
        case model.PhaseState.Cancelled: return 3;
    }
}

func run(fixture string, mode_name string) i32 throws os.Error {
    let bytes = fs.read_file(fixture);
    let snapshot = source.snapshot(1, 1, 1, "fixture.wz", bytes);
    let lexed = lexer.lex(snapshot);
    let parsed = parser.parse(lexed);
    var parsed_ok = false;
    switch parsed.state {
        case model.PhaseState.Complete: parsed_ok = true;
        case model.PhaseState.Recovered: parsed_ok = true;
        default: {}
    }
    if !parsed_ok || !parsed.has_value || vec.len(parsed.nodes) == 0 {
        io.eprintln("parse failed: state=" +
            strconv.format_u64(u64(phase_id(parsed.state))) +
            " has=" + bool_text(parsed.has_value) +
            " nodes=" + usize_text(vec.len(parsed.nodes)));
        return 3;
    }
    var built = BuiltTypes(context: types.context(), signature: 0);
    try { built = build_types(); }
    catch error model.SupportError {
        switch error {
            case model.SupportError.Invalid(message):
                io.eprintln("type build failed: " + message);
            case model.SupportError.Limit(message):
                io.eprintln("type build limit: " + message);
        }
        return 4;
    }
    var module = build_module(parsed, built.context, built.signature,
        model.empty_project());
    if mode_name == "width-error" {
        module.config.word_bits = 48;
        try { let ignored = hirdump.dump_module(module); }
        catch error model.SupportError {
            switch error {
                case model.SupportError.Invalid(message):
                    io.println("ERROR: " + message);
                    return 0;
                case model.SupportError.Limit(message):
                    io.eprintln("width-error: unexpected limit: " + message);
                    return 5;
            }
        }
        io.eprintln("width-error: no exception");
        return 5;
    }
    var output = "";
    try {
    output = "== types\n" + public_types_dump(module.types) +
        "== module\n" + public_module_dump(module);
    output += "== empty-types\ntypes=" +
        usize_text(types.size(types.context())) + "\n";
    let empty_resolved = model.ResolvedProject(project: model.empty_project(),
        symbols: [], occurrences: [], deferred_members: [], self_parameters: []);
    let empty_module = hir.empty_module(empty_resolved, 0,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    output += "== empty-module\n" + public_module_dump(empty_module);
    } catch error model.SupportError {
        io.eprintln("unexpected dump error");
        return 6;
    }
    io.print(output);
    return 0;
}

func main() i32 throws os.Error {
    let arguments = process.args();
    if vec.len(arguments) < 2 {
        io.eprintln("usage: program FIXTURE [width-error]");
        return 2;
    }
    var mode_name = "full";
    if vec.len(arguments) > 2 { mode_name = arguments[2]; }
    return run(arguments[1], mode_name);
}
