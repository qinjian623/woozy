package hirverify;
import "app/wzcc/model" as model;
import "app/wzcc/hir" as hir;
import "std/map" as map;
import "std/option" as option;
import "std/vec" as vec;

pub func test_node_type_index() bool {
    let index = NodeTypeIndex(entries: vec.empty[NodeTypeEntry](), heads: map.new[u64, usize]());
    let a = model.NodeRef(module: 1, file: 2, node: 3);
    let b = model.NodeRef(module: 1, file: 9, node: 3);
    let c = model.NodeRef(module: 8, file: 2, node: 3);
    node_type_add(index, a, 9); node_type_add(index, a, 9);
    if vec.len(index.entries) != 1 || vec.len(index.entries[0].types) != 1 { return false; }
    node_type_add(index, a, 4); node_type_add(index, b, 7); node_type_add(index, c, 8);
    if vec.len(index.entries[0].types) != 2 || index.entries[0].types[0] != 4 || index.entries[0].types[1] != 9 { return false; }
    if option.is_some(node_type_unique(index, a)) { return false; }
    switch node_type_unique(index, b) { case option.Option.Some(v): if v != 7 { return false; } case option.Option.None: return false; }
    switch node_type_unique(index, c) { case option.Option.Some(v): if v != 8 { return false; } case option.Option.None: return false; }
    // Force a full-hash collision chain to exercise key comparison.
    let d = model.NodeRef(module: 3, file: 7, node: 55);
    let collision = map.insert(index.heads, node_type_hash(d), 0);
    node_type_add(index, d, 31);
    switch node_type_unique(index, d) { case option.Option.Some(v): if v != 31 { return false; } case option.Option.None: return false; }
    var d_position usize = 0;
    switch node_type_find(index, d) {
        case option.Option.Some(position): d_position = position;
        case option.Option.None: return false;
    }
    // Point a's hash at d so finding a must pass the nonmatching head.
    let replaced = map.insert(index.heads, node_type_hash(a), d_position);
    switch node_type_find(index, a) {
        case option.Option.Some(position): {
            if position != 0 || vec.len(index.entries[position].types) != 2 ||
               index.entries[position].types[0] != 4 || index.entries[position].types[1] != 9 {
                return false;
            }
        }
        case option.Option.None: return false;
    }
    switch node_type_unique(index, b) { case option.Option.Some(v): if v != 7 { return false; } case option.Option.None: return false; }
    switch node_type_unique(index, c) { case option.Option.Some(v): if v != 8 { return false; } case option.Option.None: return false; }
    for var i usize = 0; i < 2048; i += 1 {
        let key = model.NodeRef(module: 6, file: 4, node: i);
        node_type_add(index, key, i + 100);
    }
    for var i usize = 0; i < 2048; i += 1 {
        let key = model.NodeRef(module: 6, file: 4, node: i);
        switch node_type_unique(index, key) { case option.Option.Some(v): if v != i + 100 { return false; } case option.Option.None: return false; }
    }
    return true;
}

// Test-only entry point to the actual source/effect verifier.
pub func test_source_effect(input hir.HirModule, expect_rejection bool) bool {
    var state = make_verifier(input);
    build_function_node_index(inout state);
    try {
        source_effect_nodes(inout state, input.functions[0]);
    } catch error Invalid {
        return expect_rejection && error.message == "source effect construct was erased or replaced";
    }
    return !expect_rejection;
}
