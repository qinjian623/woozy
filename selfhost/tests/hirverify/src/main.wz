// Real Source/lexer/parser fixture for the independent HIR verifier tests.
// The HIR is assembled independently from the parsed AST; the C++ oracle
// assembles the equivalent records from the same bytes.
package app;

import "app/wzcc/hir" as hir;
import "app/wzcc/hirclone" as hirclone;
import "app/wzcc/hirverify" as hirverify;
import "app/wzcc/lexer" as lexer;
import "app/wzcc/model" as model;
import "app/wzcc/parser" as parser;
import "app/wzcc/source" as source;
import "app/wzcc/types" as types;
import "std/fs" as fs;
import "std/io" as io;
import "std/option" as option;
import "std/os" as os;
import "std/process" as process;
import "std/vec" as vec;

struct Built {
    module hir.HirModule;
    valid bool;
}

func is_complete(state model.PhaseState) bool {
    switch state {
        case model.PhaseState.Complete: return true;
        default: return false;
    }
}

func diagnostic_text(result model.UnitResult) string {
    if vec.len(result.diagnostics) == 0 { return "none"; }
    return result.diagnostics[0].code + ":" + result.diagnostics[0].message;
}

func build(parsed model.ParseResult) Built {
    var function_node usize = 0;
    var block_node usize = 0;
    var named_node usize = 0;
    for var index usize = 0; index < vec.len(parsed.nodes); index += 1 {
        if model.ast_kind_id(parsed.nodes[index].kind) == 4 { function_node = index; }
        if model.ast_kind_id(parsed.nodes[index].kind) == 15 { named_node = index; }
        if model.ast_kind_id(parsed.nodes[index].kind) == 18 { block_node = index; }
    }
    var context = types.context();
    var unit usize = 0;
    var signature_id usize = 0;
    try {
        unit = types.intern(inout context, model.empty_type(model.TypeKind.Unit));
        var signature = model.empty_type(model.TypeKind.Function);
        signature.result = unit;
        signature_id = types.intern(inout context, signature);
    } catch error types.Error {
        return Built(module: hir.empty_module(model.ResolvedProject(
            project: model.empty_project(), symbols: [], occurrences: [],
            deferred_members: [], self_parameters: []), 0,
            model.CheckConfig(backend: model.Backend.Native, word_bits: 64)),
            valid: false);
    }
    let module_source = model.Module(id: 0, logical_path: "app",
        identity: "app", package_name: "app", files: [0], imports: [],
        foreign_exports: [], binding: option.Option[model.BindingModuleRef].None,
        c_binding: option.Option[usize].None);
    var project = model.empty_project();
    project.modules = [module_source];
    project.files = [parsed];
    let function_ref = model.NodeRef(module: 0, file: 0, node: function_node);
    let block_ref = model.NodeRef(module: 0, file: 0, node: block_node);
    let function_source = hir.HirSource(node: function_ref,
        span: parsed.nodes[function_node].span);
    let block_source = hir.HirSource(node: block_ref,
        span: parsed.nodes[block_node].span);
    let function_symbol = model.Symbol(id: 0, name: "main",
        kind: model.SymbolKind.Function, module: 0,
        definition: option.Option[model.NodeRef].Some(function_ref),
        declaration: option.Option[model.Span].Some(
            parsed.nodes[function_node].span), exported: true,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None);
    let builtin_symbol = model.Symbol(id: 1, name: "Unit",
        kind: model.SymbolKind.BuiltinType, module: 0,
        definition: option.Option[model.NodeRef].None,
        declaration: option.Option[model.Span].None, exported: true,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None);
    let type_ref = model.NodeRef(module: 0, file: 0, node: named_node);
    let occurrence = model.Occurrence(source: type_ref, symbol: 1,
        span: parsed.nodes[named_node].span);
    let resolved = model.ResolvedProject(project: project,
        symbols: [function_symbol, builtin_symbol], occurrences: [occurrence],
        deferred_members: [], self_parameters: []);
    var module = hir.empty_module(resolved, 0,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    module.types = context;
    module.functions = [hir.HirFunction(symbol: 0, signature: signature_id,
        parameters: [], body: 0, scope: 0, source: function_source,
        captures: [], is_async: false)];
    module.nodes = [hir.HirNode(type_id: unit, source: block_source, scope: 0,
        children: [], data: hir.NodeData.Block(hir.Block()), errors: [],
        exits: [])];
    module.scopes = [hir.HirScope(function: 0,
        parent: option.Option[usize].None, source: block_source)];
    return Built(module: module, valid: true);
}

func copy(module hir.HirModule) option.Option[hir.HirModule] {
    try {
        return option.Option[hir.HirModule].Some(
            hirclone.clone_module(module));
    } catch error model.SupportError {
        return option.Option[hir.HirModule].None;
    }
}

func module_of(value option.Option[hir.HirModule]) hir.HirModule {
    switch value {
        case option.Option.Some(item): return item;
        case option.Option.None: return hir.empty_module(model.ResolvedProject(
            project: model.empty_project(), symbols: [], occurrences: [],
            deferred_members: [], self_parameters: []), 0,
            model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    }
}

func run(fixture string) i32 throws os.Error {
    let bytes = fs.read_file(fixture);
    let snapshot = source.snapshot(1, 1, 1, fixture,
        text_bytes(bytes));
    let lexed = lexer.lex(snapshot);
    let parsed = parser.parse(lexed);
    if !parsed.has_value || parsed.recovered {
        io.println("FIXTURE parse-failed");
        return 2;
    }
    var built = build(parsed);
    if !built.valid {
        io.println("FIXTURE build-failed");
        return 3;
    }
    let valid = hirverify.verify_types(built.module);
    io.println("PROBE valid state=" + phase_name(valid.state) +
        " diags=" + decimal(vec.len(valid.diagnostics)) +
        " detail=" + diagnostic_text(valid));
    let backend_valid = hirverify.check_backend_capabilities(built.module);
    io.println("PROBE backend state=" + phase_name(backend_valid.state) +
        " diags=" + decimal(vec.len(backend_valid.diagnostics)) +
        " detail=" + diagnostic_text(backend_valid));
    let verified = hirverify.verify(built.module, hirverify.VerifyMode.Backend);
    io.println("PROBE verify state=" + phase_name(verified.state) +
        " diags=" + decimal(vec.len(verified.diagnostics)) +
        " has=" + bool_text(option.is_some(verified.value)));
    var first = hir.empty_module(model.ResolvedProject(
        project: model.empty_project(), symbols: [], occurrences: [],
        deferred_members: [], self_parameters: []), 0,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    switch verified.value {
        case option.Option.Some(value): {
            var snap = option.Option[hir.HirModule].None;
            try { snap = option.Option[hir.HirModule].Some(
                hirverify.snapshot(value)); }
            catch error model.SupportError { io.println("PROBE snapshot error"); return 4; }
            first = module_of(snap);
            io.println("PROBE snapshot_children=" +
                decimal(vec.len(first.nodes[0].children)));
            // Mutate the original builder after publication.
            built.module.nodes[0].children = [0];
            try { let extra_type = types.intern(inout built.module.types,
                model.empty_type(model.TypeKind.Bool)); }
            catch error types.Error { io.println("PROBE builder-intern-error"); }
            var after_builder = first;
            try { after_builder = hirverify.snapshot(value); }
            catch error model.SupportError { io.println("PROBE after-builder-error"); return 5; }
            io.println("PROBE snapshot_after_builder=" +
                decimal(vec.len(after_builder.nodes[0].children)) + ":" +
                decimal(types.size(after_builder.types)));
            // Mutate a returned snapshot; a second snapshot stays independent.
            first.nodes[0].children = [0];
            var after_snapshot = first;
            try { after_snapshot = hirverify.snapshot(value); }
            catch error model.SupportError { io.println("PROBE after-returned-error"); return 6; }
            io.println("PROBE snapshot_after_returned=" +
                decimal(vec.len(after_snapshot.nodes[0].children)) + ":" +
                decimal(types.size(after_snapshot.types)));
        }
        case option.Option.None: io.println("PROBE verify-no-value");
    }
    var private_module = built.module;
    private_module.config.word_bits = 48;
    let bad_width = hirverify.verify_types(private_module);
    io.println("PROBE bad-width state=" + phase_name(bad_width.state) +
        " detail=" + diagnostic_text(bad_width));
    var bad = module_of(copy(built.module));
    bad.nodes[0].type_id = 999;
    let bad_type = hirverify.verify_types(bad);
    io.println("PROBE bad-type detail=" + diagnostic_text(bad_type));
    bad = module_of(copy(built.module));
    bad.nodes[0].children = [77];
    let bad_child = hirverify.verify_types(bad);
    io.println("PROBE bad-child detail=" + diagnostic_text(bad_child));
    bad = module_of(copy(built.module));
    bad.functions[0].source.span.end_byte = bad.functions[0].source.span.begin_byte - 1;
    let bad_source = hirverify.verify_types(bad);
    io.println("PROBE bad-source detail=" + diagnostic_text(bad_source));
    bad = module_of(copy(built.module));
    bad.nodes[0].data = hir.NodeData.Unsupported(hir.Unsupported(feature: "probe"));
    let bad_unsupported = hirverify.verify_types(bad);
    io.println("PROBE bad-unsupported detail=" + diagnostic_text(bad_unsupported));
    bad = module_of(copy(built.module));
    bad.nodes[0].children = [0];
    let bad_cycle = hirverify.verify_types(bad);
    io.println("PROBE bad-cycle detail=" + diagnostic_text(bad_cycle));
    bad = module_of(copy(built.module));
    bad.scopes[0].parent = option.Option[usize].Some(0);
    let bad_scope = hirverify.verify_types(bad);
    io.println("PROBE bad-scope detail=" + diagnostic_text(bad_scope));
    let bad_verify = hirverify.verify(bad, hirverify.VerifyMode.Backend);
    io.println("PROBE bad-verify has=" + bool_text(option.is_some(bad_verify.value)) +
        " detail=" + diagnostic_text(model.UnitResult(state: bad_verify.state,
            failure: bad_verify.failure, diagnostics: bad_verify.diagnostics,
            has_value: option.is_some(bad_verify.value))));
    io.println("SUMMARY probes=13 fixture=" + fixture);
    return 0;
}

func phase_name(state model.PhaseState) string {
    switch state {
        case model.PhaseState.Complete: return "complete";
        case model.PhaseState.Recovered: return "recovered";
        case model.PhaseState.Failed: return "failed";
        case model.PhaseState.Cancelled: return "cancelled";
    }
}

func bool_text(value bool) string {
    if value { return "1"; }
    return "0";
}

func decimal(value usize) string {
    if value == 0 { return "0"; }
    let digits = "0123456789";
    var result = "";
    var remaining = value;
    for remaining > 0 {
        let digit = remaining % 10;
        result = digits[digit:digit + 1] + result;
        remaining = remaining / 10;
    }
    return result;
}

func text_bytes(value Vec[u8]) Vec[u8] {
    return value[0:vec.len(value)];
}

func main() i32 throws os.Error {
    let arguments = process.args();
    if vec.len(arguments) < 2 {
        io.eprintln("usage: program FIXTURE [mode]");
        return 2;
    }
    if vec.len(arguments) > 2 && arguments[2] != "unit" {
        return run_fixes(arguments[2], parse_fixture(arguments[1]),
            arguments[1]);
    }
    return run(arguments[1]);
}

func parse_fixture(fixture string) model.ParseResult throws os.Error {
    let bytes = fs.read_file(fixture);
    let snapshot = source.snapshot(1, 1, 1, fixture,
        bytes[0:vec.len(bytes)]);
    let lexed = lexer.lex(snapshot);
    return parser.parse(lexed);
}
