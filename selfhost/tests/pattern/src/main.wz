}

func main() i32 throws os.Error {
    let out = vec.empty[string]();
    var context = types.context();
    var failed = false;
    try {
        context = build(out);
    } catch error types.Error {
        failed = true;
    }
    if failed {
        io.println("woozy-pattern/1");
        io.println("types 0");
        return 2;
    }
    let type_out = vec.empty[string]();
    dump_types(type_out, context);
    io.println("woozy-pattern/1");
    for line in type_out {
        io.println(line);
    }
    for line in out {
        io.println(line);
    }
    return 0;
}
