package nativeemit;

// This reduced fixture tests debug-off text emission. The full emitter and
// its source-language types are exercised by the real compiler's GDB tests.
func debug_type(type_id usize, state inout Emitter) string throws Error {
    throw invalid("type descriptions require the full native emitter");
}

struct DebugTypeLayout {
    pub known bool;
    pub size usize;
    pub alignment usize;
    pub offsets Vec[usize];
}

func debug_storage_layout(type_id usize, depth usize,
                          state inout Emitter) DebugTypeLayout throws Error {
    throw invalid("debug storage layouts require the full native emitter");
}
