// Real differential tests for app/wzcc/foreign and app/wzcc/signature.
//
// This program is the Woozy side of the comparison.  It builds only test
// fixture data, calls the ported production modules, and prints a canonical
// line for every case.  selfhost/tests/foreign_signature/oracle.cpp performs
// the same sequence with the C++ implementation, and run.py requires the two
// outputs to be byte-identical at O0 and O2.
package app;

import "app/wzcc/model" as model;
import "app/wzcc/types" as types;
import "app/wzcc/hir" as hir;
import "app/wzcc/system" as system;
import "app/wzcc/foreign" as foreign;
import "app/wzcc/signature" as signature;
import "std/option" as option;
import "std/os" as os;
import "std/strconv" as strconv;
import "std/vec" as vec;

func num(value usize) string {
    return strconv.format_u64(u64(value));
}

func num32(value u32) string {
    return strconv.format_u64(u64(value));
}

func emit(line string) throws os.Error {
    os.write_all_text(os.stdout(), line + "\n");
}

func emit_line(head string, body string) throws os.Error {
    emit(head + " " + body);
}

func empty_span() model.Span {
    return model.Span(snapshot: 0, begin_byte: 0, end_byte: 0);
}

func empty_hir_source() hir.HirSource {
    return hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: 0),
        span: empty_span());
}

func none_usize() option.Option[usize] {
    return option.Option[usize].None;
}

func support_message(error model.SupportError) string {
    switch error {
        case model.SupportError.Invalid(message): return message;
        case model.SupportError.Limit(message): return "limit: " + message;
    }
}

func mode_id(mode model.ParamMode) u32 {
    switch mode {
        case model.ParamMode.Ordinary: return 0;
        case model.ParamMode.Inout: return 1;
        case model.ParamMode.Move: return 2;
    }
}

func dump_ids(values Vec[usize]) string {
    var out = "";
    for var index usize = 0; index < vec.len(values); index += 1 {
        if index != 0 {
            out = out + ",";
        }
        out = out + num(values[index]);
    }
    return out;
}

func dump_parameters(values Vec[model.ParameterType]) string {
    var out = "";
    for var index usize = 0; index < vec.len(values); index += 1 {
        if index != 0 {
            out = out + ",";
        }
        out = out + num32(mode_id(values[index].mode)) + ":" +
            num(values[index].type_id);
    }
    return out;
}

func id_text(value option.Option[usize]) string {
    switch value {
        case option.Option.Some(id): return num(id);
        case option.Option.None: return "-";
    }
}

func dump_type(context types.Context, id usize) throws os.Error {
    let found = types.find(context, id);
    switch found {
        case option.Option.Some(value): {
            var line = "type " + num(id) +
                " kind=" + num32(model.type_kind_id(value.kind)) +
                " bits=" + num32(value.bits) +
                " decl=" + num(value.declaration) +
                " bind=" + num(value.binding) +
                " params=" + dump_parameters(value.parameters) +
                " result=" + num(value.result) + " throws=" +
                id_text(value.throws_type) +
                " args=" + dump_ids(value.type_args) +
                " c=" + num32(value.c_type);
            emit(line);
        }
        case option.Option.None: {
            emit("type " + num(id) + " missing");
        }
    }
}

func dump_table(label string, context types.Context) throws os.Error {
    emit("table " + label + " " + num(types.size(context)));
    for var id usize = 1; id <= types.size(context); id += 1 {
        dump_type(context, id);
    }
}

// ---------------------------------------------------------------------------
// Python foreign declarations

func foreign_type_decl(id usize, identity string) model.ForeignDeclaration {
    return model.ForeignDeclaration(id: id, bundle: 0, source: empty_span(),
        json_pointer: "", identity: identity, module: "demo", name: identity,
        host_attribute: [],
        detail: model.ForeignDetail.Type(model.BindingType(kind: "type",
            copy: "copy", members: [], properties: [], indexers: [],
            slices: [])),
        stable_identity: identity);
}

func foreign_value_decl(id usize, identity string,
                        type_name string) model.ForeignDeclaration {
    return model.ForeignDeclaration(id: id, bundle: 0, source: empty_span(),
        json_pointer: "", identity: identity, module: "demo", name: identity,
        host_attribute: [],
        detail: model.ForeignDetail.Value(model.BindingValue(type_name: type_name)),
        stable_identity: identity);
}

func foreign_parameter(name string, type_name string, kind string,
                       optional bool, mode string) model.BindingParameter {
    return model.BindingParameter(name: name, type_name: type_name, kind: kind,
        optional: optional, mode: mode, escapes: "none", source: empty_span());
}

func foreign_callable_decl(id usize, identity string,
                           return_type string) model.ForeignDeclaration {
    let parameters = vec.empty[model.BindingParameter]();
    vec.push(parameters, foreign_parameter("self", "demo.Point",
        "positional_or_keyword", false, "ordinary"));
    vec.push(parameters, foreign_parameter("count", "i32",
        "positional_or_keyword", true, "ordinary"));
    vec.push(parameters, foreign_parameter("flag", "bool",
        "positional_or_keyword", false, "move"));
    vec.push(parameters, foreign_parameter("slot", "demo.Point",
        "keyword_only", false, "inout"));
    return model.ForeignDeclaration(id: id, bundle: 0, source: empty_span(),
        json_pointer: "", identity: identity, module: "demo", name: identity,
        host_attribute: [],
        detail: model.ForeignDetail.Callable(model.BindingCallable(
            call_kind: "method", owner_type: option.Option[string].Some("demo.Point"),
            parameters: parameters, return_type: return_type,
            error_type: option.Option[string].Some("lang.py.Error"),
            return_ownership: "owned", storage: "reference",
            receiver_escapes: "none", effects: [])),
        stable_identity: identity);
}

func foreign_property_decl(id usize, identity string,
                           type_name string) model.ForeignDeclaration {
    return model.ForeignDeclaration(id: id, bundle: 0, source: empty_span(),
        json_pointer: "", identity: identity, module: "demo", name: identity,
        host_attribute: [],
        detail: model.ForeignDetail.Property(model.BindingProperty(
            owner_type: "demo.Point", name: identity, type_name: type_name,
            getter: ["size"], setter: [], error_type: "lang.py.Error")),
        stable_identity: identity);
}

func foreign_indexer_decl(id usize, identity string,
                          result_type string) model.ForeignDeclaration {
    return model.ForeignDeclaration(id: id, bundle: 0, source: empty_span(),
        json_pointer: "", identity: identity, module: "demo", name: identity,
        host_attribute: [],
        detail: model.ForeignDetail.Indexer(model.BindingIndexer(
            owner_type: "demo.Items", index_type: "usize",
            result_type: result_type, error_type: "lang.py.Error",
            readable: true, writable: false)),
        stable_identity: identity);
}

func foreign_slice_decl(id usize, identity string,
                        result_type string) model.ForeignDeclaration {
    return model.ForeignDeclaration(id: id, bundle: 0, source: empty_span(),
        json_pointer: "", identity: identity, module: "demo", name: identity,
        host_attribute: [],
        detail: model.ForeignDetail.Slice(model.BindingSlice(
            owner_type: "demo.Items", result_type: result_type,
            error_type: "lang.py.Error",
            start_type: option.Option[string].Some("usize"),
            end_type: option.Option[string].Some("usize"),
            readable: true, writable: false)),
        stable_identity: identity);
}

func build_python_project() model.Project {
    let declarations = vec.empty[model.ForeignDeclaration]();
    vec.push(declarations, foreign_type_decl(0, "lang.py.Error"));
    vec.push(declarations, foreign_type_decl(1, "demo.Point"));
    vec.push(declarations, foreign_value_decl(2, "demo.number", "i64"));
    vec.push(declarations, foreign_callable_decl(3, "demo.make", "string"));
    vec.push(declarations, foreign_property_decl(4, "demo.Point.size", "bool"));
    vec.push(declarations, foreign_indexer_decl(5, "demo.Items.at", "u8"));
    vec.push(declarations, foreign_slice_decl(6, "demo.Items.window", "string"));
    vec.push(declarations, foreign_value_decl(7, "demo.point_value", "demo.Point"));
    vec.push(declarations, foreign_value_decl(8, "demo.ready", "Unit"));
    var project = model.empty_project();
    project.foreign_bindings = declarations;
    return project;
}

func project_with(declarations Vec[model.ForeignDeclaration]) model.Project {
    var project = model.empty_project();
    project.foreign_bindings = declarations;
    return project;
}

func case_binding_type(label string, project model.Project,
                       context inout types.Context, name string)
    throws os.Error {
    try {
        let id = foreign.binding_type(project, inout context, name);
        emit("case " + label + " ok " + num(id));
    } catch error model.SupportError {
        emit("case " + label + " invalid " + support_message(error));
    }
}

func print_records(records Vec[hir.ForeignBinding]) throws os.Error {
    emit("records " + num(vec.len(records)));
    for record in records {
        emit("record " + num(record.binding) + " binding=" + num(record.binding) +
            " type=" + num(record.type_id) +
            " signature=" + id_text(record.signature) +
            " owner=" + id_text(record.owner) +
            " read_error=" + num(record.read_error));
    }
}

func case_binding_records(label string, project model.Project,
                          context inout types.Context) throws os.Error {
    try {
        let records = foreign.binding_records(project, inout context);
        emit("case " + label + " ok " + num(vec.len(records)));
        print_records(records);
    } catch error model.SupportError {
        emit("case " + label + " invalid " + support_message(error));
    }
}

func bind_callable() model.BindingCallable {
    let parameters = vec.empty[model.BindingParameter]();
    vec.push(parameters, foreign_parameter("first", "i32",
        "positional_or_keyword", false, "ordinary"));
    vec.push(parameters, foreign_parameter("second", "i32",
        "positional_or_keyword", true, "ordinary"));
    vec.push(parameters, foreign_parameter("only", "i32",
        "positional_only", true, "ordinary"));
    vec.push(parameters, foreign_parameter("later", "i32",
        "keyword_only", true, "ordinary"));
    vec.push(parameters, foreign_parameter("last", "i32",
        "keyword_only", false, "ordinary"));
    return model.BindingCallable(call_kind: "function",
        owner_type: option.Option[string].None, parameters: parameters,
        return_type: "Unit", error_type: option.Option[string].None,
        return_ownership: "value", storage: "reference",
        receiver_escapes: "none", effects: []);
}

func optional_callable() model.BindingCallable {
    let parameters = vec.empty[model.BindingParameter]();
    vec.push(parameters, foreign_parameter("first", "i32",
        "positional_or_keyword", true, "ordinary"));
    vec.push(parameters, foreign_parameter("later", "i32",
        "keyword_only", true, "ordinary"));
    return model.BindingCallable(call_kind: "function",
        owner_type: option.Option[string].None, parameters: parameters,
        return_type: "Unit", error_type: option.Option[string].None,
        return_ownership: "value", storage: "reference",
        receiver_escapes: "none", effects: []);
}

func empty_callable() model.BindingCallable {
    return model.BindingCallable(call_kind: "function",
        owner_type: option.Option[string].None, parameters: [],
        return_type: "Unit", error_type: option.Option[string].None,
        return_ownership: "value", storage: "reference",
        receiver_escapes: "none", effects: []);
}

func two_positional_callable() model.BindingCallable {
    let parameters = vec.empty[model.BindingParameter]();
    vec.push(parameters, foreign_parameter("left", "i32",
        "positional_or_keyword", false, "ordinary"));
    vec.push(parameters, foreign_parameter("right", "i32",
        "positional_or_keyword", false, "ordinary"));
    return model.BindingCallable(call_kind: "function",
        owner_type: option.Option[string].None, parameters: parameters,
        return_type: "Unit", error_type: option.Option[string].None,
        return_ownership: "value", storage: "reference",
        receiver_escapes: "none", effects: []);
}

func label(text_value string) option.Option[string] {
    return option.Option[string].Some(text_value);
}

func positional() option.Option[string] {
    return option.Option[string].None;
}

func case_bind(label string, callable model.BindingCallable,
               labels Vec[option.Option[string]]) throws os.Error {
    let result = foreign.bind_arguments(callable, labels);
    switch result {
        case option.Option.None: emit("bind " + label + " none");
        case option.Option.Some(bound): {
            var omitted = "";
            for var index usize = 0; index < vec.len(bound.omitted);
                index += 1 {
                if index != 0 {
                    omitted = omitted + ",";
                }
                omitted = omitted + num32(bound.omitted[index]);
            }
            var parameters = "";
            for var index usize = 0; index < vec.len(bound.parameters);
                index += 1 {
                if index != 0 {
                    parameters = parameters + ",";
                }
                parameters = parameters + num32(bound.parameters[index]);
            }
            emit("bind " + label + " ok params=" + parameters +
                " omitted=" + omitted);
        }
    }
}

func run_python_phase() throws os.Error {
    emit("phase python");
    let project = build_python_project();
    var context = types.context();
    case_binding_type("binding_type.foreign-error", project, inout context,
        "lang.py.Error");
    case_binding_type("binding_type.named-type", project, inout context,
        "demo.Point");
    case_binding_type("binding_type.i64", project, inout context, "i64");
    case_binding_type("binding_type.u8", project, inout context, "u8");
    case_binding_type("binding_type.i32", project, inout context, "i32");
    case_binding_type("binding_type.bool", project, inout context, "bool");
    case_binding_type("binding_type.string", project, inout context, "string");
    case_binding_type("binding_type.unit", project, inout context, "Unit");
    case_binding_type("binding_type.isize", project, inout context, "isize");
    case_binding_type("binding_type.usize", project, inout context, "usize");
    case_binding_type("binding_type.f32", project, inout context, "f32");
    case_binding_type("binding_type.f64", project, inout context, "f64");
    case_binding_type("binding_type.i8", project, inout context, "i8");
    case_binding_type("binding_type.i16", project, inout context, "i16");
    case_binding_type("binding_type.u16", project, inout context, "u16");
    case_binding_type("binding_type.u32", project, inout context, "u32");
    case_binding_type("binding_type.u64", project, inout context, "u64");
    case_binding_type("binding_type.unknown", project, inout context, "unknown");
    case_binding_type("binding_type.empty", project, inout context, "");
    case_binding_type("binding_type.value-identity", project, inout context,
        "demo.number");
    case_binding_records("binding_records.full", project, inout context);
    case_binding_records("binding_records.empty", model.empty_project(),
        inout context);
    let only_value = vec.empty[model.ForeignDeclaration]();
    vec.push(only_value, foreign_value_decl(0, "demo.value", "i64"));
    case_binding_records("binding_records.no-error", project_with(only_value),
        inout context);
    let bad_index = vec.empty[model.ForeignDeclaration]();
    vec.push(bad_index, foreign_type_decl(1, "lang.py.Error"));
    case_binding_records("binding_records.bad-index", project_with(bad_index),
        inout context);
    let bad_type = vec.empty[model.ForeignDeclaration]();
    vec.push(bad_type, foreign_type_decl(0, "lang.py.Error"));
    vec.push(bad_type, foreign_value_decl(1, "demo.value", "nope.Type"));
    case_binding_records("binding_records.bad-type", project_with(bad_type),
        inout context);
    let bad_callable = vec.empty[model.ForeignDeclaration]();
    vec.push(bad_callable, foreign_type_decl(0, "lang.py.Error"));
    vec.push(bad_callable, foreign_callable_decl(1, "demo.make", "nope.Type"));
    case_binding_records("binding_records.bad-callable",
        project_with(bad_callable), inout context);

    let bindable = bind_callable();
    let empty_labels = vec.empty[option.Option[string]]();
    case_bind("bind.none-supplied", bindable, empty_labels);
    let one = vec.empty[option.Option[string]]();
    vec.push(one, positional());
    case_bind("bind.one-positional", bindable, one);
    let three_and_last = vec.empty[option.Option[string]]();
    vec.push(three_and_last, positional());
    vec.push(three_and_last, positional());
    vec.push(three_and_last, positional());
    vec.push(three_and_last, label("last"));
    case_bind("bind.three-and-last", bindable, three_and_last);
    let reordered = vec.empty[option.Option[string]]();
    vec.push(reordered, label("second"));
    vec.push(reordered, label("first"));
    vec.push(reordered, label("last"));
    case_bind("bind.reordered", bindable, reordered);
    let positional_only = vec.empty[option.Option[string]]();
    vec.push(positional_only, label("only"));
    vec.push(positional_only, label("last"));
    case_bind("bind.positional-only-named", bindable, positional_only);
    let duplicate = vec.empty[option.Option[string]]();
    vec.push(duplicate, positional());
    vec.push(duplicate, label("first"));
    vec.push(duplicate, label("last"));
    case_bind("bind.duplicate", bindable, duplicate);
    let four_positional = vec.empty[option.Option[string]]();
    vec.push(four_positional, positional());
    vec.push(four_positional, positional());
    vec.push(four_positional, positional());
    vec.push(four_positional, positional());
    case_bind("bind.keyword-only-positional", bindable, four_positional);
    let unknown_label = vec.empty[option.Option[string]]();
    vec.push(unknown_label, label("nope"));
    case_bind("bind.unknown-label", bindable, unknown_label);
    let missing_required = vec.empty[option.Option[string]]();
    vec.push(missing_required, label("last"));
    case_bind("bind.missing-required", bindable, missing_required);
    let extra = vec.empty[option.Option[string]]();
    vec.push(extra, positional());
    vec.push(extra, positional());
    vec.push(extra, positional());
    vec.push(extra, label("later"));
    vec.push(extra, label("last"));
    vec.push(extra, label("x"));
    case_bind("bind.extra-label", bindable, extra);
    let keyword_without_last = vec.empty[option.Option[string]]();
    vec.push(keyword_without_last, positional());
    vec.push(keyword_without_last, positional());
    vec.push(keyword_without_last, positional());
    vec.push(keyword_without_last, label("later"));
    case_bind("bind.optional-only-omitted", bindable, keyword_without_last);
    case_bind("bind.all-optional", optional_callable(), empty_labels);
    case_bind("bind.empty-callable", empty_callable(), empty_labels);
    let empty_callable_one = vec.empty[option.Option[string]]();
    vec.push(empty_callable_one, positional());
    case_bind("bind.empty-callable-positional", empty_callable(),
        empty_callable_one);
    let too_many = vec.empty[option.Option[string]]();
    vec.push(too_many, positional());
    vec.push(too_many, positional());
    vec.push(too_many, positional());
    case_bind("bind.too-many-positional", two_positional_callable(), too_many);
    let named_then_positional = vec.empty[option.Option[string]]();
    vec.push(named_then_positional, label("second"));
    vec.push(named_then_positional, positional());
    case_bind("bind.named-then-positional", bindable, named_then_positional);
    dump_table("python", context);
}

// ---------------------------------------------------------------------------
// C ABI declarations

func scalar_ref(name string) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Scalar, scalar: name,
        writable: false, args: [], named: 0);
}

func ptr_ref(inner model.CTypeRef, writable bool) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Pointer, scalar: "",
        writable: writable, args: [inner], named: 0);
}

func buffer_ref(inner model.CTypeRef, writable bool) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Buffer, scalar: "",
        writable: writable, args: [inner], named: 0);
}

func named_ref(index u32) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Named, scalar: "",
        writable: false, args: [], named: index);
}

func ptr_arity_ref(count usize) model.CTypeRef {
    let args = vec.empty[model.CTypeRef]();
    for var index usize = 0; index < count; index += 1 {
        vec.push(args, scalar_ref("i32"));
    }
    return model.CTypeRef(kind: model.CTypeKind.Pointer, scalar: "",
        writable: false, args: args, named: 0);
}

func deep_pointer(depth usize) model.CTypeRef {
    var result = scalar_ref("i32");
    for var index usize = 0; index < depth; index += 1 {
        result = ptr_ref(result, false);
    }
    return result;
}

func c_parameter(name string, ref model.CTypeRef) model.CParameterDecl {
    return model.CParameterDecl(name: name, type_ref: ref,
        source: empty_span());
}

func c_return(ref model.CTypeRef) model.CReturnDecl {
    return model.CReturnDecl(type_ref: ref, ownership: "value",
        release_symbol: "", retain_symbol: "", source: empty_span());
}

func c_type_decl(id u32, identity string,
                 kind model.CDeclKind) model.CTypeDecl {
    return model.CTypeDecl(id: id, bundle: 0, source: empty_span(),
        identity: identity, module: "demo", name: identity, c_name: identity,
        kind: kind, fields: [], size: 0, align: 0, release_symbol: "",
        retain_symbol: "", result: scalar_ref("Unit"), parameters: [],
        registration: option.Option[model.CRegistrationDecl].None);
}

func callback_decl(id u32, identity string, parameters Vec[model.CParameterDecl],
                   result model.CTypeRef) model.CTypeDecl {
    return model.CTypeDecl(id: id, bundle: 0, source: empty_span(),
        identity: identity, module: "demo", name: identity, c_name: identity,
        kind: model.CDeclKind.Callback, fields: [], size: 0, align: 0,
        release_symbol: "", retain_symbol: "", result: result,
        parameters: parameters,
        registration: option.Option[model.CRegistrationDecl].None);
}

func c_callable(id u32, identity string, parameters Vec[model.CParameterDecl],
                result model.CTypeRef,
                registers option.Option[model.CRegistrationCall])
    model.CCallableDecl {
    return model.CCallableDecl(id: id, bundle: 0, source: empty_span(),
        identity: identity, module: "demo", name: identity, symbol: identity,
        parameters: parameters, result: c_return(result),
        stable_identity: identity, registers: registers);
}

func build_c_project() model.Project {
    let types_list = vec.empty[model.CTypeDecl]();
    vec.push(types_list, c_type_decl(1, "demo.Record", model.CDeclKind.Record));
    vec.push(types_list, c_type_decl(2, "demo.Resource", model.CDeclKind.Resource));
    let callback_parameters = vec.empty[model.CParameterDecl]();
    vec.push(callback_parameters, c_parameter("count", scalar_ref("i32")));
    vec.push(callback_parameters, c_parameter("state", ptr_ref(named_ref(4), true)));
    vec.push(callback_parameters, c_parameter("tag", scalar_ref("u8")));
    vec.push(types_list, callback_decl(3, "demo.Callback", callback_parameters,
        scalar_ref("Unit")));
    vec.push(types_list, c_type_decl(4, "demo.Opaque", model.CDeclKind.Opaque));
    let other_parameters = vec.empty[model.CParameterDecl]();
    vec.push(other_parameters, c_parameter("value", scalar_ref("i32")));
    vec.push(types_list, callback_decl(5, "demo.Other", other_parameters,
        scalar_ref("i32")));

    let callables = vec.empty[model.CCallableDecl]();
    let plain = vec.empty[model.CParameterDecl]();
    vec.push(plain, c_parameter("count", scalar_ref("i32")));
    vec.push(plain, c_parameter("record", ptr_ref(named_ref(1), false)));
    vec.push(plain, c_parameter("bytes", buffer_ref(scalar_ref("u8"), true)));
    vec.push(callables, c_callable(1, "demo.plain", plain, scalar_ref("i64"),
        option.Option[model.CRegistrationCall].None));

    let registered = vec.empty[model.CParameterDecl]();
    vec.push(registered, c_parameter("callback", named_ref(3)));
    vec.push(registered, c_parameter("userdata", ptr_ref(scalar_ref("u8"), true)));
    vec.push(registered, c_parameter("count", scalar_ref("i32")));
    vec.push(callables, c_callable(2, "demo.registered", registered,
        scalar_ref("i64"), option.Option[model.CRegistrationCall].Some(
            model.CRegistrationCall(callback_parameter: 0,
                userdata_parameter: 1, callback_userdata_parameter: 1))));

    let first_slot = vec.empty[model.CParameterDecl]();
    vec.push(first_slot, c_parameter("userdata", ptr_ref(scalar_ref("u8"), true)));
    vec.push(first_slot, c_parameter("count", scalar_ref("i32")));
    vec.push(first_slot, c_parameter("callback", named_ref(3)));
    vec.push(callables, c_callable(3, "demo.first_slot", first_slot,
        scalar_ref("Unit"), option.Option[model.CRegistrationCall].Some(
            model.CRegistrationCall(callback_parameter: 2,
                userdata_parameter: 0, callback_userdata_parameter: 0))));

    let bad_kind = vec.empty[model.CParameterDecl]();
    vec.push(bad_kind, c_parameter("callback", scalar_ref("i32")));
    vec.push(bad_kind, c_parameter("userdata", ptr_ref(scalar_ref("u8"), true)));
    vec.push(callables, c_callable(4, "demo.bad_kind", bad_kind,
        scalar_ref("Unit"), option.Option[model.CRegistrationCall].Some(
            model.CRegistrationCall(callback_parameter: 0,
                userdata_parameter: 1, callback_userdata_parameter: 0))));

    let bad_userdata = vec.empty[model.CParameterDecl]();
    vec.push(bad_userdata, c_parameter("callback", named_ref(3)));
    vec.push(bad_userdata, c_parameter("userdata", ptr_ref(scalar_ref("u8"), true)));
    vec.push(callables, c_callable(5, "demo.bad_userdata", bad_userdata,
        scalar_ref("Unit"), option.Option[model.CRegistrationCall].Some(
            model.CRegistrationCall(callback_parameter: 0,
                userdata_parameter: 1, callback_userdata_parameter: 99))));

    let unknown_callback = vec.empty[model.CParameterDecl]();
    vec.push(unknown_callback, c_parameter("callback", named_ref(3)));
    vec.push(unknown_callback, c_parameter("userdata", ptr_ref(scalar_ref("u8"), true)));
    vec.push(callables, c_callable(6, "demo.unknown_callback", unknown_callback,
        scalar_ref("Unit"), option.Option[model.CRegistrationCall].Some(
            model.CRegistrationCall(callback_parameter: 99,
                userdata_parameter: 1, callback_userdata_parameter: 0))));

    let unknown_userdata = vec.empty[model.CParameterDecl]();
    vec.push(unknown_userdata, c_parameter("callback", named_ref(3)));
    vec.push(unknown_userdata, c_parameter("userdata", ptr_ref(scalar_ref("u8"), true)));
    vec.push(callables, c_callable(7, "demo.unknown_userdata", unknown_userdata,
        scalar_ref("Unit"), option.Option[model.CRegistrationCall].Some(
            model.CRegistrationCall(callback_parameter: 0,
                userdata_parameter: 99, callback_userdata_parameter: 0))));

    let bad_result = vec.empty[model.CParameterDecl]();
    vec.push(callables, c_callable(8, "demo.bad_result", bad_result,
        scalar_ref("zz"), option.Option[model.CRegistrationCall].None));

    var project = model.empty_project();
    project.c_types = types_list;
    project.c_callables = callables;
    return project;
}

func case_c_type(label string, project model.Project,
                 context inout types.Context, ref model.CTypeRef)
    throws os.Error {
    try {
        let id = foreign.c_type_id(project, inout context, ref);
        emit("case " + label + " ok " + num(id));
    } catch error model.SupportError {
        emit("case " + label + " invalid " + support_message(error));
    }
}

func case_closure(label string, project model.Project,
                  context inout types.Context, callback_type u32,
                  userdata_index usize) throws os.Error {
    try {
        let id = foreign.c_callback_closure_signature(project, inout context,
            callback_type, userdata_index);
        emit("case " + label + " ok " + num(id));
    } catch error model.SupportError {
        emit("case " + label + " invalid " + support_message(error));
    }
}

func case_callable_signature(label string, project model.Project,
                             context inout types.Context,
                             callable model.CCallableDecl) throws os.Error {
    try {
        let id = foreign.c_callable_signature(project, inout context, callable);
        emit("case " + label + " ok " + num(id));
    } catch error model.SupportError {
        emit("case " + label + " invalid " + support_message(error));
    }
}

func case_source_indices(label string, callable model.CCallableDecl)
    throws os.Error {
    let indices = foreign.c_source_parameter_indices(callable);
    var body = "";
    for var index usize = 0; index < vec.len(indices); index += 1 {
        if index != 0 {
            body = body + ",";
        }
        body = body + num(indices[index]);
    }
    emit("indices " + label + " [" + body + "]");
}

func run_c_phase() throws os.Error {
    emit("phase c");
    let project = build_c_project();
    var context = types.context();
    case_c_type("c_type.scalar-i32", project, inout context, scalar_ref("i32"));
    case_c_type("c_type.scalar-u8", project, inout context, scalar_ref("u8"));
    case_c_type("c_type.scalar-f64", project, inout context, scalar_ref("f64"));
    case_c_type("c_type.scalar-unit", project, inout context, scalar_ref("Unit"));
    case_c_type("c_type.scalar-bool", project, inout context, scalar_ref("bool"));
    case_c_type("c_type.scalar-isize", project, inout context, scalar_ref("isize"));
    case_c_type("c_type.scalar-usize", project, inout context, scalar_ref("usize"));
    case_c_type("c_type.scalar-leading", project, inout context, scalar_ref("i32x"));
    case_c_type("c_type.scalar-nodigit", project, inout context, scalar_ref("iabc"));
    case_c_type("c_type.scalar-empty", project, inout context, scalar_ref(""));
    case_c_type("c_type.scalar-one", project, inout context, scalar_ref("i"));
    case_c_type("c_type.scalar-other", project, inout context, scalar_ref("x8"));
    case_c_type("c_type.scalar-i128", project, inout context, scalar_ref("i128"));
    case_c_type("c_type.scalar-f16", project, inout context, scalar_ref("f16"));
    case_c_type("c_type.ptr", project, inout context,
        ptr_ref(scalar_ref("i32"), false));
    case_c_type("c_type.ptr-mut", project, inout context,
        ptr_ref(scalar_ref("i32"), true));
    case_c_type("c_type.ptr-zero", project, inout context, ptr_arity_ref(0));
    case_c_type("c_type.ptr-two", project, inout context, ptr_arity_ref(2));
    case_c_type("c_type.buffer", project, inout context,
        buffer_ref(scalar_ref("u8"), true));
    case_c_type("c_type.buffer-record", project, inout context,
        buffer_ref(named_ref(1), false));
    case_c_type("c_type.named-record", project, inout context, named_ref(1));
    case_c_type("c_type.named-resource", project, inout context, named_ref(2));
    case_c_type("c_type.named-callback", project, inout context, named_ref(3));
    case_c_type("c_type.named-opaque", project, inout context, named_ref(4));
    case_c_type("c_type.named-zero", project, inout context, named_ref(0));
    case_c_type("c_type.named-outside", project, inout context, named_ref(99));
    case_c_type("c_type.ptr-depth-32", project, inout context, deep_pointer(32));
    case_c_type("c_type.ptr-depth-33", project, inout context, deep_pointer(33));

    case_source_indices("plain", project.c_callables[0]);
    case_source_indices("registered", project.c_callables[1]);
    case_source_indices("first-slot", project.c_callables[2]);
    case_source_indices("bad-userdata", project.c_callables[4]);
    case_source_indices("unknown-userdata", project.c_callables[6]);

    case_closure("closure.userdata-1", project, inout context, 3, 1);
    case_closure("closure.userdata-0", project, inout context, 3, 0);
    case_closure("closure.userdata-2", project, inout context, 3, 2);
    case_closure("closure.zero", project, inout context, 0, 0);
    case_closure("closure.outside", project, inout context, 99, 0);
    case_closure("closure.record", project, inout context, 1, 0);
    case_closure("closure.userdata-outside", project, inout context, 3, 3);

    case_callable_signature("callable.plain", project, inout context,
        project.c_callables[0]);
    case_callable_signature("callable.registered", project, inout context,
        project.c_callables[1]);
    case_callable_signature("callable.first-slot", project, inout context,
        project.c_callables[2]);
    case_callable_signature("callable.bad-kind", project, inout context,
        project.c_callables[3]);
    case_callable_signature("callable.bad-userdata", project, inout context,
        project.c_callables[4]);
    case_callable_signature("callable.unknown-callback", project, inout context,
        project.c_callables[5]);
    case_callable_signature("callable.unknown-userdata", project, inout context,
        project.c_callables[6]);
    case_callable_signature("callable.bad-result", project, inout context,
        project.c_callables[7]);
    dump_table("c", context);
}

// ---------------------------------------------------------------------------
// Public interface visibility

func private_symbol(id usize, name string, kind model.SymbolKind,
                    exported bool) model.Symbol {
    return model.Symbol(id: id, name: name, kind: kind, module: 0,
        definition: option.Option[model.NodeRef].None,
        declaration: option.Option[model.Span].None, exported: exported,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None);
}

func build_private_resolved() model.ResolvedProject {
    let symbols = vec.empty[model.Symbol]();
    vec.push(symbols, private_symbol(0, "PubStruct", model.SymbolKind.Type, true));
    vec.push(symbols, private_symbol(1, "PrivStruct", model.SymbolKind.Type, false));
    vec.push(symbols, private_symbol(2, "PubTrait", model.SymbolKind.Trait, true));
    vec.push(symbols, private_symbol(3, "PrivTrait", model.SymbolKind.Trait, false));
    vec.push(symbols, private_symbol(4, "ValueSym", model.SymbolKind.Value, false));
    vec.push(symbols, private_symbol(5, "ParamSym",
        model.SymbolKind.TypeParameter, false));
    vec.push(symbols, private_symbol(6, "PubEnum", model.SymbolKind.Type, true));
    vec.push(symbols, private_symbol(7, "PrivEnum", model.SymbolKind.Type, false));
    let modules = vec.empty[model.Module]();
    vec.push(modules, model.Module(id: 0, logical_path: "demo",
        identity: "demo", package_name: "demo", files: [], imports: [],
        foreign_exports: [], binding: option.Option[model.BindingModuleRef].None,
        c_binding: option.Option[usize].None));
    var project = model.empty_project();
    project.modules = modules;
    return model.ResolvedProject(project: project, symbols: symbols,
        occurrences: [], deferred_members: [], self_parameters: []);
}

func intern_named(context inout types.Context, kind model.TypeKind,
                  declaration usize) usize {
    var value = model.empty_type(model.TypeKind.Unit);
    value.kind = kind;
    value.declaration = declaration;
    try {
        return types.intern(inout context, value);
    } catch error types.Error {
        return 0;
    }
}

func intern_function(context inout types.Context,
                     parameters Vec[model.ParameterType], result usize,
                     throws_type option.Option[usize]) usize {
    var value = model.empty_type(model.TypeKind.Function);
    value.kind = model.TypeKind.Function;
    value.parameters = parameters;
    value.result = result;
    value.throws_type = throws_type;
    try {
        return types.intern(inout context, value);
    } catch error types.Error {
        return 0;
    }
}

func ordinary_parameter(type_id usize) model.ParameterType {
    return model.ParameterType(mode: model.ParamMode.Ordinary, type_id: type_id);
}

func intern_vec(context inout types.Context, element usize) usize {
    var value = model.empty_type(model.TypeKind.Vec);
    value.kind = model.TypeKind.Vec;
    vec.push(value.type_args, element);
    try {
        return types.intern(inout context, value);
    } catch error types.Error {
        return 0;
    }
}

func case_private(label string, context types.Context,
                  resolved model.ResolvedProject, roots Vec[usize])
    throws os.Error {
    let found = foreign.private_interface_type(context, resolved, roots);
    emit("private " + label + " " + id_text(found));
}

func roots_one(value usize) Vec[usize] {
    let roots = vec.empty[usize]();
    vec.push(roots, value);
    return roots;
}

func roots_two(first usize, second usize) Vec[usize] {
    let roots = vec.empty[usize]();
    vec.push(roots, first);
    vec.push(roots, second);
    return roots;
}

func run_private_phase() throws os.Error {
    emit("phase private");
    let resolved = build_private_resolved();
    var context = types.context();
    let pub_struct = intern_named(inout context, model.TypeKind.NominalStruct, 0);
    let priv_struct = intern_named(inout context, model.TypeKind.NominalStruct, 1);
    let pub_trait = intern_named(inout context, model.TypeKind.TraitObject, 2);
    let priv_trait = intern_named(inout context, model.TypeKind.TraitObject, 3);
    let value_sym = intern_named(inout context, model.TypeKind.NominalStruct, 4);
    let param_sym = intern_named(inout context, model.TypeKind.TypeParameter, 5);
    let priv_enum = intern_named(inout context, model.TypeKind.NominalEnum, 7);
    let vec_priv = intern_vec(inout context, priv_struct);
    let vec_pub = intern_vec(inout context, pub_struct);
    let parameter_priv = vec.empty[model.ParameterType]();
    vec.push(parameter_priv, ordinary_parameter(priv_struct));
    let parameter_two = vec.empty[model.ParameterType]();
    vec.push(parameter_two, ordinary_parameter(priv_struct));
    vec.push(parameter_two, ordinary_parameter(priv_struct));
    let fn_param_priv = intern_function(inout context, parameter_priv,
        pub_struct, option.Option[usize].None);
    let fn_result_priv = intern_function(inout context, [],
        priv_struct, option.Option[usize].None);
    let fn_throws_priv = intern_function(inout context, [], pub_struct,
        option.Option[usize].Some(priv_struct));
    let fn_throws_pub = intern_function(inout context, [], pub_struct,
        option.Option[usize].Some(pub_struct));
    let fn_two_refs = intern_function(inout context, parameter_two,
        pub_struct, option.Option[usize].None);
    let nom_outside = intern_named(inout context, model.TypeKind.NominalStruct, 99);
    case_private("public-struct", context, resolved, roots_one(pub_struct));
    case_private("private-struct", context, resolved, roots_one(priv_struct));
    case_private("public-trait", context, resolved, roots_one(pub_trait));
    case_private("private-trait", context, resolved, roots_one(priv_trait));
    case_private("value-symbol", context, resolved, roots_one(value_sym));
    case_private("type-parameter", context, resolved, roots_one(param_sym));
    case_private("vec-private", context, resolved, roots_one(vec_priv));
    case_private("vec-public", context, resolved, roots_one(vec_pub));
    case_private("function-param", context, resolved, roots_one(fn_param_priv));
    case_private("function-result", context, resolved, roots_one(fn_result_priv));
    case_private("function-throws", context, resolved, roots_one(fn_throws_priv));
    case_private("function-throws-public", context, resolved,
        roots_one(fn_throws_pub));
    case_private("function-two-refs", context, resolved, roots_one(fn_two_refs));
    case_private("roots-two", context, resolved,
        roots_two(pub_struct, priv_enum));
    let no_roots = vec.empty[usize]();
    case_private("roots-empty", context, resolved, no_roots);
    case_private("zero-root", context, resolved, roots_one(0));
    case_private("nominal-outside", context, resolved, roots_one(nom_outside));
    case_private("order-private", context, resolved,
        roots_two(priv_struct, priv_enum));
    case_private("order-private-enum", context, resolved,
        roots_two(priv_enum, priv_struct));
    dump_table("private", context);
}

// ---------------------------------------------------------------------------
// Standard module fixture

func fixture_symbol(symbols Vec[model.Symbol], name string,
                    kind model.SymbolKind, module usize,
                    exported bool) usize {
    let id = vec.len(symbols);
    vec.push(symbols, model.Symbol(id: id, name: name, kind: kind,
        module: module, definition: option.Option[model.NodeRef].None,
        declaration: option.Option[model.Span].None, exported: exported,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None));
    return id;
}

func fixture_module(logical_path string) model.Module {
    return model.Module(id: 0, logical_path: logical_path,
        identity: logical_path, package_name: "", files: [], imports: [],
        foreign_exports: [], binding: option.Option[model.BindingModuleRef].None,
        c_binding: option.Option[usize].None);
}

func generic_parameter(symbol usize) hir.GenericParam {
    return hir.GenericParam(symbol: symbol,
        trait_ref: option.Option[hir.TraitRef].None,
        source: empty_hir_source());
}

func field_decl(symbol usize, type_id usize) hir.FieldDecl {
    return hir.FieldDecl(symbol: symbol, type_id: type_id, exported: true,
        source: empty_hir_source());
}

func variant_decl(symbol usize, payload Vec[hir.FieldDecl]) hir.VariantDecl {
    return hir.VariantDecl(symbol: symbol, payload: payload,
        source: empty_hir_source());
}

func fixture_type_parameter(context inout types.Context,
                            declaration usize) usize {
    var value = model.empty_type(model.TypeKind.Unit);
    value.kind = model.TypeKind.TypeParameter;
    value.declaration = declaration;
    try {
        return types.intern(inout context, value);
    } catch error types.Error {
        return 0;
    }
}

func fixture_leaf(context inout types.Context, kind model.TypeKind,
                  bits u32) usize {
    var value = model.empty_type(model.TypeKind.Unit);
    value.kind = kind;
    value.bits = bits;
    try {
        return types.intern(inout context, value);
    } catch error types.Error {
        return 0;
    }
}

func fixture_vec(context inout types.Context, element usize) usize {
    return intern_vec(inout context, element);
}

func fixture_named(context inout types.Context, kind model.TypeKind,
                   declaration usize) usize {
    return intern_named(inout context, kind, declaration);
}

func fixture_field_type(context inout types.Context, name string,
                        symbols Vec[model.Symbol]) usize {
    if name == "i16" {
        return fixture_leaf(inout context, model.TypeKind.SignedInt, 16);
    }
    if name == "i32" {
        return fixture_leaf(inout context, model.TypeKind.SignedInt, 32);
    }
    if name == "i64" {
        return fixture_leaf(inout context, model.TypeKind.SignedInt, 64);
    }
    if name == "u8" {
        return fixture_leaf(inout context, model.TypeKind.UnsignedInt, 8);
    }
    if name == "u16" {
        return fixture_leaf(inout context, model.TypeKind.UnsignedInt, 16);
    }
    if name == "u32" {
        return fixture_leaf(inout context, model.TypeKind.UnsignedInt, 32);
    }
    if name == "u64" {
        return fixture_leaf(inout context, model.TypeKind.UnsignedInt, 64);
    }
    if name == "usize" {
        return fixture_leaf(inout context, model.TypeKind.Usize, 0);
    }
    if name == "f64" {
        return fixture_leaf(inout context, model.TypeKind.Float, 64);
    }
    if name == "string" {
        return fixture_leaf(inout context, model.TypeKind.String, 0);
    }
    if name == "bool" {
        return fixture_leaf(inout context, model.TypeKind.Bool, 0);
    }
    if name == "Unit" {
        return fixture_leaf(inout context, model.TypeKind.Unit, 0);
    }
    if name == "Vec[u8]" {
        let element = fixture_leaf(inout context, model.TypeKind.UnsignedInt, 8);
        return fixture_vec(inout context, element);
    }
    if name == "std/os.File" {
        return fixture_named(inout context, model.TypeKind.NominalStruct,
            symbols[9].id);
    }
    if name == "std/os.Timespec" {
        return fixture_named(inout context, model.TypeKind.NominalStruct,
            symbols[10].id);
    }
    if name == "std/net.Socket" {
        return fixture_named(inout context, model.TypeKind.NominalStruct,
            symbols[13].id);
    }
    if name == "std/net.Address" {
        return fixture_named(inout context, model.TypeKind.NominalStruct,
            symbols[14].id);
    }
    return 0;
}

func push_struct(context inout types.Context, symbols Vec[model.Symbol],
                 nominals Vec[hir.NominalDecl], name string, module usize,
                 fields Vec[hir.FieldDecl], field_names Vec[string],
                 field_types Vec[string]) {
    for var index usize = 0; index < vec.len(field_names); index += 1 {
        let symbol = fixture_symbol(symbols, field_names[index],
            model.SymbolKind.Field, module, true);
        vec.push(fields, field_decl(symbol,
            fixture_field_type(inout context, field_types[index], symbols)));
    }
    let symbol_id = symbol_by_name(symbols, name);
    vec.push(nominals, hir.NominalDecl(symbol: symbol_id,
        kind: model.TypeKind.NominalStruct, params: [], fields: fields,
        variants: [], source: empty_hir_source()));
}

func symbol_by_name(symbols Vec[model.Symbol], name string) usize {
    for var index usize = 0; index < vec.len(symbols); index += 1 {
        if symbols[index].name == name {
            return index;
        }
    }
    return 0;
}

func build_std_module(context inout types.Context) hir.HirModule {
    var project = model.empty_project();
    let modules = vec.empty[model.Module]();
    vec.push(modules, fixture_module("std/result"));
    vec.push(modules, fixture_module("std/option"));
    vec.push(modules, fixture_module("std/os"));
    vec.push(modules, fixture_module("std/net"));
    vec.push(modules, fixture_module("std/math"));
    vec.push(modules, fixture_module("std/process"));
    vec.push(modules, fixture_module("std/signal"));
    project.modules = modules;
    let symbols = vec.empty[model.Symbol]();
    let nominals = vec.empty[hir.NominalDecl]();
    let result_symbol = fixture_symbol(symbols, "Result", model.SymbolKind.Type, 0, true);
    let result_a = fixture_symbol(symbols, "A", model.SymbolKind.TypeParameter, 0, false);
    let result_b = fixture_symbol(symbols, "B", model.SymbolKind.TypeParameter, 0, false);
    let ok_symbol = fixture_symbol(symbols, "Ok", model.SymbolKind.Variant, 0, true);
    let err_symbol = fixture_symbol(symbols, "Err", model.SymbolKind.Variant, 0, true);
    let option_symbol = fixture_symbol(symbols, "Option", model.SymbolKind.Type, 1, true);
    let option_a = fixture_symbol(symbols, "A", model.SymbolKind.TypeParameter, 1, false);
    let none_symbol = fixture_symbol(symbols, "None", model.SymbolKind.Variant, 1, true);
    let some_symbol = fixture_symbol(symbols, "Some", model.SymbolKind.Variant, 1, true);
    let file_symbol = fixture_symbol(symbols, "File", model.SymbolKind.Type, 2, true);
    let timespec_symbol = fixture_symbol(symbols, "Timespec", model.SymbolKind.Type, 2, true);
    let pipe_symbol = fixture_symbol(symbols, "Pipe", model.SymbolKind.Type, 2, true);
    let fileinfo_symbol = fixture_symbol(symbols, "FileInfo", model.SymbolKind.Type, 2, true);
    let socket_symbol = fixture_symbol(symbols, "Socket", model.SymbolKind.Type, 3, true);
    let address_symbol = fixture_symbol(symbols, "Address", model.SymbolKind.Type, 3, true);
    let accepted_symbol = fixture_symbol(symbols, "Accepted", model.SymbolKind.Type, 3, true);
    let received_symbol = fixture_symbol(symbols, "Received", model.SymbolKind.Type, 3, true);
    let pair_symbol = fixture_symbol(symbols, "Pair", model.SymbolKind.Type, 3, true);
    let pollfd_symbol = fixture_symbol(symbols, "PollFd", model.SymbolKind.Type, 3, true);
    let fraction_symbol = fixture_symbol(symbols, "Fraction", model.SymbolKind.Type, 4, true);
    let waitstatus_symbol = fixture_symbol(symbols, "WaitStatus", model.SymbolKind.Type, 5, true);
    let info_symbol = fixture_symbol(symbols, "Info", model.SymbolKind.Type, 6, true);
    let a_type = fixture_type_parameter(inout context, result_a);
    let b_type = fixture_type_parameter(inout context, result_b);
    let option_a_type = fixture_type_parameter(inout context, option_a);
    let result_params = vec.empty[hir.GenericParam]();
    vec.push(result_params, generic_parameter(result_a));
    vec.push(result_params, generic_parameter(result_b));
    let ok_payload = vec.empty[hir.FieldDecl]();
    vec.push(ok_payload, field_decl(ok_symbol, a_type));
    let err_payload = vec.empty[hir.FieldDecl]();
    vec.push(err_payload, field_decl(err_symbol, b_type));
    let result_variants = vec.empty[hir.VariantDecl]();
    vec.push(result_variants, variant_decl(ok_symbol, ok_payload));
    vec.push(result_variants, variant_decl(err_symbol, err_payload));
    vec.push(nominals, hir.NominalDecl(symbol: result_symbol,
        kind: model.TypeKind.NominalEnum, params: result_params, fields: [],
        variants: result_variants, source: empty_hir_source()));
    let option_params = vec.empty[hir.GenericParam]();
    vec.push(option_params, generic_parameter(option_a));
    let none_payload = vec.empty[hir.FieldDecl]();
    let some_payload = vec.empty[hir.FieldDecl]();
    vec.push(some_payload, field_decl(some_symbol, option_a_type));
    let option_variants = vec.empty[hir.VariantDecl]();
    vec.push(option_variants, variant_decl(none_symbol, none_payload));
    vec.push(option_variants, variant_decl(some_symbol, some_payload));
    vec.push(nominals, hir.NominalDecl(symbol: option_symbol,
        kind: model.TypeKind.NominalEnum, params: option_params, fields: [],
        variants: option_variants, source: empty_hir_source()));
    let file_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "File", 2, file_fields,
        ["descriptor"], ["i32"]);
    let timespec_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Timespec", 2,
        timespec_fields, ["seconds", "nanoseconds"], ["i64", "i64"]);
    let pipe_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Pipe", 2, pipe_fields,
        ["read_end", "write_end"], ["std/os.File", "std/os.File"]);
    let fileinfo_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "FileInfo", 2,
        fileinfo_fields, ["device", "inode", "links", "mode", "uid", "gid",
            "rdev", "size", "block_size", "blocks", "accessed", "modified",
            "changed"], ["u64", "u64", "u64", "u32", "u32", "u32", "u64",
            "i64", "i64", "i64", "std/os.Timespec", "std/os.Timespec",
            "std/os.Timespec"]);
    let socket_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Socket", 3, socket_fields,
        ["descriptor"], ["i32"]);
    let address_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Address", 3, address_fields,
        ["family", "port", "flags", "scope", "reserved", "data"],
        ["i32", "u16", "u16", "u32", "u32", "Vec[u8]"]);
    let accepted_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Accepted", 3,
        accepted_fields, ["socket", "address"],
        ["std/net.Socket", "std/net.Address"]);
    let received_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Received", 3,
        received_fields, ["count", "address"],
        ["usize", "std/net.Address"]);
    let pair_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Pair", 3, pair_fields,
        ["first", "second"], ["std/net.Socket", "std/net.Socket"]);
    let pollfd_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "PollFd", 3, pollfd_fields,
        ["fd", "events", "revents"], ["i32", "i16", "i16"]);
    let fraction_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Fraction", 4,
        fraction_fields, ["fraction", "exponent"], ["f64", "i32"]);
    let waitstatus_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "WaitStatus", 5,
        waitstatus_fields, ["pid", "status"], ["i32", "i32"]);
    let info_fields = vec.empty[hir.FieldDecl]();
    push_struct(inout context, symbols, nominals, "Info", 6, info_fields,
        ["number", "code", "pid", "uid", "status", "reserved", "value"],
        ["i32", "i32", "i32", "u32", "i32", "u32", "i64"]);
    var resolved = model.ResolvedProject(project: project, symbols: symbols,
        occurrences: [], deferred_members: [], self_parameters: []);
    return hir.HirModule(resolved: resolved, identity: 0, types: context,
        config: model.CheckConfig(backend: model.Backend.Native, word_bits: 64),
        functions: [], nodes: [], scopes: [], nominals: nominals, traits: [],
        impls: [], templates: [], instances: [],
        ownership: hir.empty_ownership(), foreign_bindings: []);
}

// The test mutates module fixtures; Vec is a shared handle, so a field-level
// copy must duplicate every array this test writes through.
func copy_fields(values Vec[hir.FieldDecl]) Vec[hir.FieldDecl] {
    let out = vec.empty[hir.FieldDecl]();
    for value in values {
        vec.push(out, value);
    }
    return out;
}

func copy_variants(values Vec[hir.VariantDecl]) Vec[hir.VariantDecl] {
    let out = vec.empty[hir.VariantDecl]();
    for value in values {
        vec.push(out, hir.VariantDecl(symbol: value.symbol,
            payload: copy_fields(value.payload), source: value.source));
    }
    return out;
}

func copy_nominals(values Vec[hir.NominalDecl]) Vec[hir.NominalDecl] {
    let out = vec.empty[hir.NominalDecl]();
    for value in values {
        let params = vec.empty[hir.GenericParam]();
        for parameter in value.params {
            vec.push(params, parameter);
        }
        vec.push(out, hir.NominalDecl(symbol: value.symbol, kind: value.kind,
            params: params, fields: copy_fields(value.fields),
            variants: copy_variants(value.variants), source: value.source));
    }
    return out;
}

func copy_symbols(values Vec[model.Symbol]) Vec[model.Symbol] {
    let out = vec.empty[model.Symbol]();
    for value in values {
        vec.push(out, value);
    }
    return out;
}

func copy_modules(values Vec[model.Module]) Vec[model.Module] {
    let out = vec.empty[model.Module]();
    for value in values {
        vec.push(out, value);
    }
    return out;
}

func copy_module(module hir.HirModule) hir.HirModule {
    var project = module.resolved.project;
    project.modules = copy_modules(project.modules);
    var resolved = module.resolved;
    resolved.project = project;
    resolved.symbols = copy_symbols(resolved.symbols);
    var result = module;
    result.resolved = resolved;
    result.nominals = copy_nominals(module.nominals);
    return result;
}

func without_nominal(module hir.HirModule, skip usize) hir.HirModule {
    let kept = vec.empty[hir.NominalDecl]();
    for var index usize = 0; index < vec.len(module.nominals); index += 1 {
        if index != skip {
            vec.push(kept, module.nominals[index]);
        }
    }
    var result = module;
    result.nominals = kept;
    return result;
}

func keep_parameters(module hir.HirModule, index usize, count usize)
    hir.HirModule {
    var result = copy_module(module);
    let kept = vec.empty[hir.GenericParam]();
    for var position usize = 0; position < count; position += 1 {
        vec.push(kept, module.nominals[index].params[position]);
    }
    result.nominals[index].params = kept;
    return result;
}

func keep_fields(module hir.HirModule, index usize, count usize)
    hir.HirModule {
    var result = copy_module(module);
    let kept = vec.empty[hir.FieldDecl]();
    for var position usize = 0; position < count; position += 1 {
        vec.push(kept, module.nominals[index].fields[position]);
    }
    result.nominals[index].fields = kept;
    return result;
}

func case_operation(label string, context inout types.Context,
                    module option.Option[hir.HirModule], operation u32,
                    arguments Vec[usize]) throws os.Error {
    try {
        let id = signature.system_operation_signature(inout context, module,
            operation, arguments);
        emit("case " + label + " ok " + num(id));
    } catch error model.SupportError {
        emit("case " + label + " invalid " + support_message(error));
    }
}

func op_args1(first usize) Vec[usize] {
    let arguments = vec.empty[usize]();
    vec.push(arguments, first);
    return arguments;
}

func op_args2(first usize, second usize) Vec[usize] {
    let arguments = vec.empty[usize]();
    vec.push(arguments, first);
    vec.push(arguments, second);
    return arguments;
}

func op_args3(first usize, second usize, third usize) Vec[usize] {
    let arguments = vec.empty[usize]();
    vec.push(arguments, first);
    vec.push(arguments, second);
    vec.push(arguments, third);
    return arguments;
}

func op_args4(first usize, second usize, third usize, fourth usize)
    Vec[usize] {
    let arguments = vec.empty[usize]();
    vec.push(arguments, first);
    vec.push(arguments, second);
    vec.push(arguments, third);
    vec.push(arguments, fourth);
    return arguments;
}

func op_args5(first usize, second usize, third usize, fourth usize,
              fifth usize) Vec[usize] {
    let arguments = op_args4(first, second, third, fourth);
    vec.push(arguments, fifth);
    return arguments;
}

func some_module(module hir.HirModule) option.Option[hir.HirModule] {
    return option.Option[hir.HirModule].Some(module);
}

func no_module() option.Option[hir.HirModule] {
    return option.Option[hir.HirModule].None;
}

func run_system_phase() throws os.Error {
    emit("phase system");
    var context = types.context();
    let base = build_std_module(inout context);
    let a_type = fixture_field_type(inout context, "i32", base.resolved.symbols);
    let b_type = fixture_field_type(inout context, "i64", base.resolved.symbols);
    let string_type = fixture_field_type(inout context, "string",
        base.resolved.symbols);
    let vec_u8 = fixture_field_type(inout context, "Vec[u8]",
        base.resolved.symbols);
    let u32_type = fixture_field_type(inout context, "u32",
        base.resolved.symbols);
    let u64_type = fixture_field_type(inout context, "u64",
        base.resolved.symbols);
    let f64_type = fixture_field_type(inout context, "f64",
        base.resolved.symbols);
    let c_type = u32_type;
    let d_type = f64_type;
    let pollfd_type = fixture_named(inout context, model.TypeKind.NominalStruct,
        base.resolved.symbols[18].id);
    let vec_pollfd = fixture_vec(inout context, pollfd_type);
    let specs = system.operations();
    var operation_count u32 = 0;
    for spec in specs {
        let arguments = vec.empty[usize]();
        if spec.type_arity >= 1 {
            vec.push(arguments, a_type);
        }
        if spec.type_arity >= 2 {
            vec.push(arguments, b_type);
        }
        if spec.type_arity >= 3 {
            vec.push(arguments, c_type);
        }
        if spec.type_arity >= 4 {
            vec.push(arguments, d_type);
        }
        case_operation("op." + num32(spec.operation) + ".module", inout context,
            some_module(base), spec.operation, arguments);
        case_operation("op." + num32(spec.operation) + ".none", inout context,
            no_module(), spec.operation, arguments);
        if spec.operation >= 213 && spec.operation <= 226 {
            emit("registry op." + num32(spec.operation) + " owner=" +
                spec.owner + " arity=" + num32(spec.type_arity));
        }
        operation_count += 1;
    }
    emit("operations " + num32(operation_count));
    let bool_type = fixture_leaf(inout context, model.TypeKind.Bool, 0);
    let f32_type = fixture_leaf(inout context, model.TypeKind.Float, 32);
    let param_type = fixture_type_parameter(inout context, 42);
    case_operation("op.buffer-bool", inout context, some_module(base), 193,
        op_args1(bool_type));
    case_operation("op.buffer-float", inout context, some_module(base), 193,
        op_args1(f32_type));
    case_operation("op.buffer-parameter", inout context, some_module(base), 193,
        op_args1(param_type));
    case_operation("op.vec-parameter", inout context, some_module(base), 34,
        op_args1(param_type));
    case_operation("op.task-parameters", inout context, some_module(base), 204,
        op_args2(param_type, bool_type));

    case_operation("op.scope-add-missing", inout context, some_module(base),
        223, op_args2(a_type, b_type));
    case_operation("op.scope-add-wrong-arity", inout context,
        some_module(base), 223, op_args3(a_type, b_type, c_type));
    case_operation("op.scope-add-extra-type-args", inout context,
        some_module(base), 223,
        op_args5(a_type, b_type, c_type, d_type, string_type));
    case_operation("op.scope-add-none", inout context, no_module(), 223,
        op_args4(a_type, b_type, c_type, d_type));
    case_operation("op.scope-begin-missing", inout context, some_module(base),
        222, []);
    case_operation("op.scope-activate-missing", inout context,
        some_module(base), 224, []);
    case_operation("op.scope-wait-extra-type-arg", inout context,
        some_module(base), 225, op_args1(a_type));
    case_operation("op.task-status-missing", inout context, some_module(base),
        226, []);

    let empty_module = hir.empty_module(model.ResolvedProject(
        project: model.empty_project(), symbols: [], occurrences: [],
        deferred_members: [], self_parameters: []), 0,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    case_operation("op.unknown", inout context, some_module(base), 65535, []);
    case_operation("op.read-zero", inout context, some_module(base), 0, []);
    case_operation("op.read-four", inout context, some_module(base), 0,
        op_args4(a_type, vec_u8, b_type, b_type));
    case_operation("op.zero-not-public", inout context, some_module(base), 36,
        op_args1(0));
    case_operation("op.outside-not-public", inout context, some_module(base),
        36, op_args1(9999));
    case_operation("op.extra-type-args", inout context, some_module(base), 9,
        op_args1(a_type));
    case_operation("op.thread-no-type-args", inout context, some_module(base),
        13, []);
    case_operation("op.thread-two-type-args", inout context, some_module(base),
        13, op_args2(a_type, b_type));
    case_operation("op.async-one-type-arg", inout context, some_module(base),
        204, op_args1(a_type));
    case_operation("op.fs-stat-none", inout context, no_module(), 43, []);
    case_operation("op.text-from-bytes-none", inout context, no_module(), 31, []);
    case_operation("op.vec-len-none", inout context, no_module(), 36,
        op_args1(a_type));
    case_operation("op.uid-none", inout context, no_module(), 64, []);
    case_operation("op.thread-spawn-none", inout context, no_module(), 13,
        op_args1(a_type));
    case_operation("op.empty-module-std", inout context, some_module(empty_module),
        43, []);
    case_operation("op.empty-module-builtin", inout context,
        some_module(empty_module), 36, op_args1(a_type));

    var module = without_nominal(base, 0);
    case_operation("op.missing-result", inout context, some_module(module), 31,
        []);
    module = keep_parameters(base, 0, 1);
    case_operation("op.result-wrong-arity", inout context, some_module(module),
        31, []);
    module = copy_module(base);
    vec.push(module.nominals, module.nominals[0]);
    case_operation("op.duplicate-result", inout context, some_module(module), 31,
        []);
    module = copy_module(base);
    module.resolved.symbols[3].name = "Bad";
    case_operation("op.result-variant-name", inout context, some_module(module),
        31, []);
    module = copy_module(base);
    module.nominals[0].variants[0].payload = vec.empty[hir.FieldDecl]();
    case_operation("op.result-payload-count", inout context, some_module(module),
        31, []);
    module = copy_module(base);
    module.nominals[0].variants[0].payload[0].type_id = a_type;
    case_operation("op.result-payload-type", inout context, some_module(module),
        31, []);
    module = copy_module(base);
    module.nominals[0].kind = model.TypeKind.NominalStruct;
    case_operation("op.result-kind", inout context, some_module(module), 31,
        []);
    module = copy_module(base);
    module.resolved.symbols[0].exported = false;
    case_operation("op.result-private", inout context, some_module(module), 31,
        []);
    module = copy_module(base);
    module.resolved.project.modules[0].binding = option.Option[model.BindingModuleRef].Some(
        model.BindingModuleRef(bundle: 0, index: 0));
    case_operation("op.result-binding", inout context, some_module(module), 31,
        []);
    module = copy_module(base);
    module.resolved.project.modules[0].logical_path = "std/other";
    case_operation("op.result-path", inout context, some_module(module), 31,
        []);
    module = copy_module(base);
    module.resolved.symbols[0].name = "Res";
    case_operation("op.result-name", inout context, some_module(module), 31,
        []);
    module = copy_module(base);
    module.resolved.symbols[0].kind = model.SymbolKind.Value;
    case_operation("op.result-symbol-kind", inout context, some_module(module),
        31, []);
    let one_variant = vec.empty[hir.VariantDecl]();
    vec.push(one_variant, base.nominals[0].variants[0]);
    module = copy_module(base);
    module.nominals[0].variants = one_variant;
    case_operation("op.result-variant-count", inout context, some_module(module),
        31, []);

    module = without_nominal(base, 1);
    case_operation("op.missing-option", inout context, some_module(module), 40,
        op_args1(a_type));
    module = keep_parameters(base, 1, 0);
    case_operation("op.option-wrong-arity", inout context, some_module(module),
        40, op_args1(a_type));
    module = copy_module(base);
    module.resolved.symbols[7].name = "No";
    case_operation("op.option-variant-name", inout context, some_module(module),
        40, op_args1(a_type));
    module = copy_module(base);
    module.nominals[1].variants[1].payload[0].type_id = a_type;
    case_operation("op.option-payload-param", inout context, some_module(module),
        40, op_args1(a_type));
    module = copy_module(base);
    vec.push(module.nominals[1].variants[0].payload,
        field_decl(7, a_type));
    case_operation("op.option-none-payload", inout context, some_module(module),
        40, op_args1(a_type));

    module = without_nominal(base, 2);
    case_operation("op.pipe-missing-file", inout context, some_module(module),
        61, []);
    module = keep_fields(base, 5, 12);
    case_operation("op.fileinfo-field-count", inout context, some_module(module),
        43, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[5].fields[0].symbol].name = "dev";
    case_operation("op.fileinfo-field-name", inout context, some_module(module),
        43, []);
    module = copy_module(base);
    module.nominals[5].fields[0].type_id = a_type;
    case_operation("op.fileinfo-field-type", inout context, some_module(module),
        43, []);
    module = copy_module(base);
    module.nominals[5].kind = model.TypeKind.NominalEnum;
    case_operation("op.fileinfo-kind", inout context, some_module(module), 43, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[3].fields[0].symbol].name = "sec";
    case_operation("op.timespec-field", inout context, some_module(module), 74, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[12].fields[0].symbol].name = "frac";
    case_operation("op.fraction-field", inout context, some_module(module), 133, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[13].fields[1].symbol].name = "code";
    case_operation("op.waitstatus-field", inout context, some_module(module),
        153, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[14].fields[6].symbol].name = "data";
    case_operation("op.signalinfo-field", inout context, some_module(module),
        156, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[8].fields[0].symbol].name = "sock";
    case_operation("op.accepted-field", inout context, some_module(module), 89, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[9].fields[0].symbol].name = "total";
    case_operation("op.received-field", inout context, some_module(module), 93, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[10].fields[1].symbol].name = "next";
    case_operation("op.pair-field", inout context, some_module(module), 101, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[11].fields[0].symbol].name = "handle";
    case_operation("op.pollfd-field", inout context, some_module(module), 102, []);
    module = copy_module(base);
    module.resolved.symbols[module.nominals[7].fields[0].symbol].name = "fam";
    case_operation("op.address-field", inout context, some_module(module), 95, []);
    case_operation("op.buffer-element", inout context, some_module(base), 193,
        op_args1(string_type));
    dump_table("system", context);
}

func main() i32 throws os.Error {
    emit("operation_id woozy-SH06f-foreign-signature-20261113");
    emit("protocol woozy-selfhost-foreign-signature/1");
    run_python_phase();
    run_c_phase();
    run_private_phase();
    run_system_phase();
    return 0;
}
