// Test-only nativeverify package self test. The runner stages this and the
// private component tests with the real production source.
package nativeverify;

import "app/wzcc/model" as model;
import "app/wzcc/nativeverify/containers" as vfcontainers;
import "app/wzcc/nativeverify/obligations" as vfobligations;
import "app/wzcc/nativeverify/ownership" as vfownership;
import "app/wzcc/nativeverify/state" as vfstate;
import "app/wzcc/nativeverify/support" as vfsupport;
import "std/io" as io;
import "std/option" as option;
import "std/os" as os;
import "std/strconv" as strconv;
import "std/vec" as vec;

func num(value usize) string {
    return strconv.format_u64(u64(value));
}

func definition(value usize) vfcontainers.Definition {
    return vfcontainers.Definition(block: value, position: value + 1, type_id: value + 2,
        address: false, source: vfsupport.empty_span());
}

func test_sorted_maps(failures inout usize) throws os.Error {
    var definitions = vfcontainers.definition_map();
    vfsupport.selftest_check("insert 5", vfcontainers.definition_insert(inout definitions, 5, definition(5)),
        inout failures);
    vfsupport.selftest_check("insert 1", vfcontainers.definition_insert(inout definitions, 1, definition(1)),
        inout failures);
    vfsupport.selftest_check("insert 9", vfcontainers.definition_insert(inout definitions, 9, definition(9)),
        inout failures);
    vfsupport.selftest_check("insert 3", vfcontainers.definition_insert(inout definitions, 3, definition(3)),
        inout failures);
    vfsupport.selftest_check("duplicate 3 rejected",
        !vfcontainers.definition_insert(inout definitions, 3, definition(3)),
        inout failures);
    vfsupport.selftest_check("insert 7", vfcontainers.definition_insert(inout definitions, 7, definition(7)),
        inout failures);
    vfsupport.selftest_check("definitions ascending",
        vec.len(definitions.entries) == 5 &&
        definitions.entries[0].value == 1 &&
        definitions.entries[1].value == 3 &&
        definitions.entries[2].value == 5 &&
        definitions.entries[3].value == 7 &&
        definitions.entries[4].value == 9, inout failures);
    let found = vfcontainers.definition_find(definitions, 7);
    var value = vfcontainers.Definition(block: 0, position: 0, type_id: 0, address: false,
        source: vfsupport.empty_span());
    var present = false;
    switch found {
        case option.Option.Some(item): value = item; present = true;
        case option.Option.None: {}
    }
    vfsupport.selftest_check("definition_find 7", present && value.block == 7 &&
        value.type_id == 9, inout failures);
    var nodes = vfcontainers.node_set();
    vfcontainers.node_set_insert(inout nodes, 4);
    vfcontainers.node_set_insert(inout nodes, 2);
    vfcontainers.node_set_insert(inout nodes, 6);
    vfsupport.selftest_check("node duplicate rejected", !vfcontainers.node_set_insert(inout nodes, 4),
        inout failures);
    vfsupport.selftest_check("node order", vec.len(nodes.values) == 3 && nodes.values[0] == 2 &&
        nodes.values[1] == 4 && nodes.values[2] == 6, inout failures);
    vfsupport.selftest_check("node remove", vfcontainers.node_set_remove(inout nodes, 4) &&
        !vfcontainers.node_set_has(nodes, 4) && vfcontainers.node_set_has(nodes, 2), inout failures);
    var facts = vfcontainers.fact_set();
    vfcontainers.fact_insert(inout facts, 2, 7, true);
    vfcontainers.fact_insert(inout facts, 1, 3, false);
    vfsupport.selftest_check("fact duplicate rejected", !vfcontainers.fact_insert(inout facts, 2, 7, true),
        inout failures);
    vfsupport.selftest_check("fact order", vec.len(facts.values) == 2 &&
        facts.values[0].value == 1 && facts.values[1].value == 2,
        inout failures);
    var other_facts = vfcontainers.fact_set();
    vfcontainers.fact_insert(inout other_facts, 2, 7, true);
    vfcontainers.fact_insert(inout other_facts, 1, 3, true);
    let common = vfcontainers.fact_set_intersect(facts, other_facts);
    vfsupport.selftest_check("fact intersect", vec.len(common.values) == 1 &&
        common.values[0].value == 2, inout failures);
    vfsupport.selftest_check("compare_option None<Some0",
        vfsupport.compare_option(option.Option[usize].None,
            option.Option[usize].Some(0)) < 0 &&
        vfsupport.compare_option(option.Option[usize].Some(0),
            option.Option[usize].Some(3)) < 0 &&
        vfsupport.compare_option(option.Option[usize].Some(3),
            option.Option[usize].Some(3)) == 0, inout failures);
    var bits = vfcontainers.bool_set(8);
    vfcontainers.bool_set_add(inout bits, 0);
    vfcontainers.bool_set_add(inout bits, 2);
    vfcontainers.bool_set_add(inout bits, 5);
    vfsupport.selftest_check("bool duplicate rejected", !vfcontainers.bool_set_add(inout bits, 2),
        inout failures);
    vfsupport.selftest_check("bool remove", vfcontainers.bool_set_remove(inout bits, 2) &&
        !vfcontainers.bool_set_has(bits, 2) && vfcontainers.bool_set_has(bits, 5), inout failures);
    var mask = vfcontainers.bool_set(8);
    vfcontainers.bool_set_add(inout mask, 0);
    vfcontainers.bool_set_add(inout mask, 5);
    vfcontainers.bool_set_add(inout mask, 7);
    let both = vfcontainers.bool_set_intersect(bits, mask);
    vfsupport.selftest_check("bool intersect", vfcontainers.bool_set_has(both, 0) && vfcontainers.bool_set_has(both, 5) &&
        !vfcontainers.bool_set_has(both, 7) && vfcontainers.bool_set_count(both) == 2, inout failures);
    vfsupport.selftest_check("bool single", vfcontainers.bool_set_is_single(both, 0) == false &&
        vfcontainers.bool_set_count(both) == 2, inout failures);
    var one = vfcontainers.bool_set(4);
    vfcontainers.bool_set_add(inout one, 3);
    var first_index usize = 99;
    try {
        first_index = vfcontainers.bool_set_first(one);
    } catch error vfsupport.VerifyError {
        failures += 1;
    }
    vfsupport.selftest_check("bool single positive", vfcontainers.bool_set_is_single(one, 3) &&
        first_index == 3, inout failures);
}

func test_more_maps(failures inout usize) throws os.Error {
    var counts = vfcontainers.value_count_map();
    vfcontainers.value_count_add(inout counts, 7);
    vfcontainers.value_count_add(inout counts, 7);
    vfcontainers.value_count_add(inout counts, 2);
    vfsupport.selftest_check("value count", vfcontainers.value_count_get(counts, 7) == 2 &&
        vfcontainers.value_count_get(counts, 2) == 1 &&
        vfcontainers.value_count_get(counts, 9) == 0, inout failures);
    var owners = vfcontainers.value_owner_map(8);
    vfcontainers.value_owner_add(inout owners, 4, 6);
    vfcontainers.value_owner_add(inout owners, 4, 2);
    vfcontainers.value_owner_add(inout owners, 1, 3);
    vfsupport.selftest_check("value owner order", vec.len(owners.entries) == 2 &&
        owners.entries[0].value == 1 && owners.entries[1].value == 4,
        inout failures);
    let owner = vfcontainers.value_owner_find(owners, 4);
    var owner_set = vfcontainers.bool_set(8);
    switch owner {
        case option.Option.Some(item): owner_set = item;
        case option.Option.None: {}
    }
    vfsupport.selftest_check("value owner membership", vfcontainers.bool_set_has(owner_set, 6) &&
        vfcontainers.bool_set_has(owner_set, 2) && vfcontainers.bool_set_count(owner_set) == 2,
        inout failures);
    var temporaries = vfcontainers.slot_temporary_map();
    vfsupport.selftest_check("temporary insert", vfcontainers.slot_temporary_insert(inout temporaries, 3, 9),
        inout failures);
    vfsupport.selftest_check("temporary duplicate", !vfcontainers.slot_temporary_insert(inout temporaries, 3, 8),
        inout failures);
    var temporary_value usize = 0;
    try {
        temporary_value = vfcontainers.slot_temporary_require(temporaries, 3);
    } catch error vfsupport.VerifyError {
        failures += 1;
    }
    vfsupport.selftest_check("temporary require", temporary_value == 9, inout failures);
    var orders = vfcontainers.node_order_map();
    vfcontainers.node_order_insert(inout orders, 6, 60);
    vfcontainers.node_order_insert(inout orders, 2, 20);
    vfsupport.selftest_check("node order sorted", vec.len(orders.entries) == 2 &&
        orders.entries[0].node == 2 && orders.entries[1].node == 6,
        inout failures);
    let order = vfcontainers.node_order_find(orders, 6);
    var order_value usize = 0;
    switch order {
        case option.Option.Some(item): order_value = item;
        case option.Option.None: {}
    }
    vfsupport.selftest_check("node order find", order_value == 60, inout failures);
    var handlers = vfcontainers.handler_map();
    vfcontainers.handler_insert(inout handlers, 2, 1, 5, vfcontainers.default_handler());
    vfcontainers.handler_insert(inout handlers, 1, 9, 3, vfcontainers.default_handler());
    vfcontainers.handler_insert(inout handlers, 1, 2, 4, vfcontainers.default_handler());
    vfsupport.selftest_check("handler tuple order", vec.len(handlers.entries) == 3 &&
        handlers.entries[0].key.try_node == 1 &&
        handlers.entries[0].key.index == 2 &&
        handlers.entries[1].key.index == 9 &&
        handlers.entries[2].key.try_node == 2, inout failures);
    vfsupport.selftest_check("handler duplicate rejected",
        !vfcontainers.handler_insert(inout handlers, 2, 1, 5, vfcontainers.default_handler()),
        inout failures);
    var instances = vfcontainers.instance_set();
    vfcontainers.instance_set_insert(inout instances, 3, 1, 7);
    vfcontainers.instance_set_insert(inout instances, 1, 2, 4);
    vfsupport.selftest_check("instance order", vec.len(instances.values) == 2 &&
        instances.values[0].try_node == 1 &&
        instances.values[1].try_node == 3, inout failures);
    var catches = vfcontainers.catch_set();
    vfcontainers.catch_set_insert(inout catches, vfcontainers.CatchKey(try_node: 4, index: 2));
    vfcontainers.catch_set_insert(inout catches, vfcontainers.CatchKey(try_node: 1, index: 7));
    vfsupport.selftest_check("catch order", vec.len(catches.values) == 2 &&
        catches.values[0].try_node == 1, inout failures);
    vfsupport.selftest_check("catch remove", vfcontainers.catch_set_remove(inout catches,
        vfcontainers.CatchKey(try_node: 4, index: 2)) && vec.len(catches.values) == 1,
        inout failures);
    var symbols = vec.empty[vfstate.FunctionEntry]();
    vfstate.symbol_add(inout symbols, 9, 90);
    vfstate.symbol_add(inout symbols, 2, 20);
    vfstate.symbol_add(inout symbols, 5, 50);
    vfsupport.selftest_check("symbol order", vec.len(symbols) == 3 && symbols[0].symbol == 2 &&
        symbols[1].symbol == 5 && symbols[2].symbol == 9, inout failures);
    let symbol_signature = vfstate.symbol_find(symbols, 5);
    var signature usize = 0;
    switch symbol_signature {
        case option.Option.Some(item): signature = item;
        case option.Option.None: {}
    }
    vfsupport.selftest_check("symbol find", signature == 50, inout failures);
    var flags = vfcontainers.value_flag_map();
    vfcontainers.value_flag_insert(inout flags, 4, 1);
    vfcontainers.value_flag_insert(inout flags, 2, 1);
    vfcontainers.value_flag_set(inout flags, 4, 2);
    var flag_value u32 = 0;
    try {
        flag_value = vfcontainers.value_flag_require(flags, 4);
    } catch error vfsupport.VerifyError {
        failures += 1;
    }
    vfsupport.selftest_check("value flag order/update", vec.len(flags.entries) == 2 &&
        flags.entries[0].value == 2 && flag_value == 2, inout failures);
    var definitions = vfcontainers.definition_map();
    vfcontainers.definition_insert(inout definitions, 3, vfcontainers.Definition(block: 3,
        position: 1, type_id: 8, address: false, source: vfsupport.empty_span()));
    vfcontainers.definition_set_source(inout definitions, 3, model.Span(snapshot: 9,
        begin_byte: 1, end_byte: 2));
    var updated_source = model.Span(snapshot: 0, begin_byte: 0, end_byte: 0);
    try {
        updated_source = vfcontainers.definition_require(definitions, 3).source;
    } catch error vfsupport.VerifyError {
        failures += 1;
    }
    vfsupport.selftest_check("definition source update", updated_source.snapshot == 9,
        inout failures);
}

pub func selftest() i32 throws os.Error {
    var failures usize = 0;
    test_sorted_maps(inout failures);
    vfownership.test_ownership_maps(inout failures);
    test_more_maps(inout failures);
    vfobligations.test_obligations(inout failures);
    vfsupport.test_copies(inout failures);
    vfsupport.test_errors(inout failures);
    io.println("selftest failures=" + num(failures));
    if failures > 0 {
        return 1;
    }
    return 0;
}
