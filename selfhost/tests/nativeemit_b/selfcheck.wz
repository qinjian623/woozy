                     op hir.UnaryOp) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.Unary;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.inputs = [input];
    instruction.unary = op;
    instruction.source = b_harness_span();
    return instruction;
}

