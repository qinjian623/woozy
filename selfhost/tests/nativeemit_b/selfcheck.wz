// TEST-ONLY harness (never merged): real B behaviour driven from a tiny
// synthetic NativeIR module.  This file lives in package nativeemit so it can
// call the non-pub b_* helpers B owns.
//
// The synthetic module exercises: integer/float constants, add/sub/mul,
// guarded signed division and remainder (including the wrap block and PHI),
// float fcmp/fneg, float->int convert, direct calls through a function value,
// block parameters-free branch/conditional CFG, reverse post order, string
// literal storage, the executable main wrapper and the GC poll at entry.
package nativeemit;
import "app/wzcc/nativeemit/core" as emitcore;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/strconv" as strconv;
import "std/vec" as vec;

// ---- pure helper checks -----------------------------------------------------

pub func b_harness_pure() i32 {
    if emitcore.b_integer_literal(0, 1) != "false" { return 1; }
    if emitcore.b_integer_literal(1, 1) != "true" { return 2; }
    if emitcore.b_integer_literal(255, 8) != "-1" { return 3; }
    if emitcore.b_integer_literal(128, 8) != "-128" { return 4; }
    if emitcore.b_integer_literal(127, 8) != "127" { return 5; }
    if emitcore.b_integer_literal(4294967295, 32) != "-1" { return 6; }
    if emitcore.b_integer_literal(2147483648, 32) != "-2147483648" { return 7; }
    if emitcore.b_integer_literal(12, 32) != "12" { return 8; }
    if emitcore.b_integer_literal(18446744073709551615, 64) != "-1" { return 9; }
    if emitcore.b_integer_literal(9223372036854775808, 64) != "-9223372036854775808" {
        return 10;
    }
    if b_all_ones(8) != 255 { return 11; }
    if b_all_ones(64) != 18446744073709551615 { return 12; }
    if b_signed_minimum(8) != 128 { return 13; }
    if b_signed_minimum(64) != 9223372036854775808 { return 14; }
    if b_wide_literal(true, 2147483648) != "-2147483648" { return 15; }
    if b_wide_literal(false, 18446744073709551615) != "18446744073709551615" {
        return 16;
    }
    let narrow = emitcore.b_float_bits_of(emitcore.b_float_value(4294967295, 32).reference);
    switch narrow {
        case option.Option.Some(item): {
            if item != 4294967295 { return 17; }
        }
        case option.Option.None: return 17;
    }
    let wide = emitcore.b_float_bits_of(emitcore.b_float_value(18446744073709551615, 64).reference);
    switch wide {
        case option.Option.Some(item): {
            if item != 18446744073709551615 { return 18; }
        }
        case option.Option.None: return 18;
    }
    if emitcore.b_float_value(0, 32).reference != "bitcast (i32 0 to float)" { return 19; }
    if emitcore.b_float_value(0, 64).reference != "bitcast (i64 0 to double)" { return 20; }
    // Conversion bounds: -1.0, -2^63, 2^63, 2^64 for both widths.
    if emitcore.b_float_pow2(0, true, 64).reference !=
       "bitcast (i64 13830554455654793216 to double)" { return 21; }
    if emitcore.b_float_pow2(63, false, 64).reference !=
       "bitcast (i64 4890909195324358656 to double)" { return 22; }
    if emitcore.b_float_pow2(64, false, 64).reference !=
       "bitcast (i64 4895412794951729152 to double)" { return 23; }
    if emitcore.b_float_pow2(63, true, 64).reference !=
       "bitcast (i64 14114281232179134464 to double)" { return 24; }
    if emitcore.b_float_pow2(0, true, 32).reference != "bitcast (i32 3212836864 to float)" {
        return 25;
    }
    if emitcore.b_float_pow2(63, true, 32).reference != "bitcast (i32 3741319168 to float)" {
        return 26;
    }
    if emitcore.b_float_pow2(64, false, 32).reference !=
       "bitcast (i32 1602224128 to float)" { return 27; }
    let none = emitcore.b_float_bits_of("not a constant");
    switch none {
        case option.Option.Some(item): return 28;
        case option.Option.None: {}
    }
    // Canonical literal spelling round-trips through the LLVM-independent
    // signed printer for every width the backend uses.
    if emitcore.b_integer_literal(255, 64) != "255" { return 29; }
    if emitcore.b_integer_literal(18446744073709551614, 64) != "-2" { return 30; }
    return 0;
}

// ---- synthetic module construction -----------------------------------------

func b_harness_span() model.Span {
    return model.Span(snapshot: 0, begin_byte: 0, end_byte: 0);
}

func b_harness_source(node usize) hir.HirSource {
    return hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: node),
        span: b_harness_span());
}

func b_harness_int(state inout types.Context, bits u32) usize throws emitcore.Error {
    var value = model.empty_type(model.TypeKind.SignedInt);
    value.bits = bits;
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern test int type"); }
}

func b_harness_float(state inout types.Context, bits u32) usize throws emitcore.Error {
    var value = model.empty_type(model.TypeKind.Float);
    value.bits = bits;
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern test float type"); }
}

func b_harness_type(kind model.TypeKind, state inout types.Context) usize throws emitcore.Error {
    let value = model.empty_type(kind);
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern test type"); }
}

func b_harness_vec(element usize, state inout types.Context) usize throws emitcore.Error {
    var value = model.empty_type(model.TypeKind.Vec);
    value.type_args = [element];
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern test vec type"); }
}

func b_harness_nominal(kind model.TypeKind, declaration usize,
                       state inout types.Context) usize throws emitcore.Error {
    var value = model.empty_type(kind);
    value.declaration = declaration;
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern test nominal type"); }
}

func b_harness_function(result usize, parameters Vec[model.ParameterType],
                        state inout types.Context) usize throws emitcore.Error {
    var value = model.empty_type(model.TypeKind.Function);
    value.result = result;
    value.parameters = parameters;
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern test function type"); }
}

func b_harness_throws(result usize, parameters Vec[model.ParameterType],
                      error_type usize, state inout types.Context) usize throws emitcore.Error {
    var value = model.empty_type(model.TypeKind.Function);
    value.result = result;
    value.parameters = parameters;
    value.throws_type = option.Option[usize].Some(error_type);
    try { return types.intern(inout state, value); }
    catch error types.Error { throw emitcore.invalid("cannot intern throwing type"); }
}

func b_harness_constant(result usize, type_id usize,
                        bits u64) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.Constant;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.bits = bits;
    instruction.source = b_harness_span();
    return instruction;
}

func b_harness_binary(result usize, type_id usize, left usize, right usize,
                      op hir.BinaryOp) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.Binary;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.inputs = [left, right];
    instruction.binary = op;
    instruction.source = b_harness_span();
    return instruction;
}

