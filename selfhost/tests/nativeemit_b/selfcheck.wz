func b_harness_function_value(result usize, type_id usize,
                              symbol usize) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.Function;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.function = symbol;
    instruction.source = b_harness_span();
    return instruction;
}

func b_harness_call(result usize, type_id usize, signature usize,
                    inputs Vec[usize], origin usize) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.Call;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.inputs = inputs;
    instruction.signature = signature;
    instruction.origin = option.Option[usize].Some(origin);
    instruction.source = b_harness_span();
    return instruction;
}

func b_harness_load(result usize, type_id usize,
                    slot usize) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.Load;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.slot = slot;
    instruction.source = b_harness_span();
    return instruction;
}

func b_harness_string(result usize, type_id usize,
                      utf8 string) nativeir.Instruction {
    var instruction = nativeir.empty_instruction();
    instruction.op = nativeir.Op.StringLiteral;
    instruction.result = option.Option[usize].Some(result);
    instruction.type_id = type_id;
    instruction.utf8 = utf8;
    instruction.source = b_harness_span();
    return instruction;
}

func b_harness_terminator(kind nativeir.Exit, inputs Vec[usize],
                          targets Vec[usize]) nativeir.Terminator {
    var terminator = nativeir.empty_terminator();
    terminator.kind = kind;
    terminator.inputs = inputs;
    terminator.targets = targets;
    terminator.source = b_harness_span();
    return terminator;
}

func b_harness_block(instructions Vec[nativeir.Instruction],
                     terminator nativeir.Terminator) nativeir.BasicBlock {
    return nativeir.BasicBlock(instructions: instructions, terminator: terminator,
        parameters: []);
}

func b_harness_block_with(instructions Vec[nativeir.Instruction],
                          terminator nativeir.Terminator,
                          parameters Vec[nativeir.BlockParameter]) nativeir.BasicBlock {
    return nativeir.BasicBlock(instructions: instructions, terminator: terminator,
        parameters: parameters);
}

func b_harness_parameter(value usize, type_id usize,
                         error bool) nativeir.BlockParameter {
    return nativeir.BlockParameter(value: value, type_id: type_id, call: 0,
        error: error);
}

func b_harness_try(signature usize, inputs Vec[usize], success usize,
                   failure usize, origin usize) nativeir.Terminator {
    var terminator = nativeir.empty_terminator();
    terminator.kind = nativeir.Exit.TryCall;
    terminator.inputs = inputs;
    terminator.targets = [success, failure];
    terminator.signature = signature;
    terminator.origin = option.Option[usize].Some(origin);
    terminator.source = b_harness_span();
    return terminator;
}

func b_harness_call_origin(signature usize, symbol usize) hir.NodeData {
    let call = hir.Call(kind: hir.CalleeKind.Direct, signature: signature,
        direct_symbol: option.Option[usize].Some(symbol),
        callee: option.Option[usize].None, args: [], type_args: [],
        binding: option.Option[usize].None,
        c_callable: option.Option[u32].None, omitted: [],
        system: option.Option[u32].None);
    return hir.NodeData.Call(call);
}

func b_harness_hir_function(symbol usize, signature usize,
                            node usize) hir.HirFunction {
    return hir.HirFunction(symbol: symbol, signature: signature, parameters: [],
        body: 0, scope: 0, source: b_harness_source(node), captures: [],
        is_async: false);
}

func b_harness_empty_slot() nativeir.Slot {
    return nativeir.Slot(type_id: 0, parameter: option.Option[u32].None,
        is_inout: false, owner: option.Option[hir.OwnerRef].None,
        owning_parameter: false, binding: option.Option[usize].None);
}

pub func b_harness_emit() Vec[string] throws emitcore.Error {
    var context = types.context();
    let i32_type = b_harness_int(inout context, 32);
    let i64_type = b_harness_int(inout context, 64);
    let f64_type = b_harness_float(inout context, 64);
    let bool_type = b_harness_type(model.TypeKind.Bool, inout context);
    let string_type = b_harness_type(model.TypeKind.String, inout context);
    let unit_type = b_harness_type(model.TypeKind.Unit, inout context);
    let usize_type = b_harness_type(model.TypeKind.Usize, inout context);
    let vec_i32 = b_harness_vec(i32_type, inout context);
    let pair_type = b_harness_nominal(model.TypeKind.NominalStruct, 100,
        inout context);
    let choice_type = b_harness_nominal(model.TypeKind.NominalEnum, 110,
        inout context);
    let parameter = model.ParameterType(mode: model.ParamMode.Ordinary,
        type_id: i32_type);
    let fn1 = b_harness_function(i32_type, [parameter], inout context);
    let fn0 = b_harness_function(i32_type, [], inout context);
    let fn_i64 = b_harness_function(i64_type, [], inout context);
    let fn_bool = b_harness_function(bool_type, [], inout context);
    let fn_unit = b_harness_function(unit_type, [], inout context);
    let fthrow1 = b_harness_throws(i32_type, [parameter], i32_type, inout context);
    let fthrow0 = b_harness_throws(i32_type, [], i32_type, inout context);

    let resolved = model.ResolvedProject(project: model.empty_project(),
        symbols: [], occurrences: [], deferred_members: [], self_parameters: []);
    var module = hir.empty_module(resolved, 0,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    module.types = context;
    module.nodes = [
        hir.HirNode(type_id: i32_type, source: b_harness_source(0), scope: 0,
            children: [], data: b_harness_call_origin(fn1, 11), errors: [],
            exits: []),
        hir.HirNode(type_id: i32_type, source: b_harness_source(1), scope: 0,
            children: [], data: b_harness_call_origin(fn0, 12), errors: [],
            exits: []),
        hir.HirNode(type_id: i32_type, source: b_harness_source(2), scope: 0,
            children: [], data: b_harness_call_origin(fthrow0, 13), errors: [],
            exits: []),
        hir.HirNode(type_id: i32_type, source: b_harness_source(3), scope: 0,
            children: [], data: b_harness_call_origin(fthrow1, 14), errors: [],
            exits: []),
        hir.HirNode(type_id: i32_type, source: b_harness_source(4), scope: 0,
            children: [], data: b_harness_call_origin(fn0, 15), errors: [],
            exits: [])
    ];
    module.functions = [
        b_harness_hir_function(10, fthrow0, 0),
        b_harness_hir_function(11, fn1, 0),
        b_harness_hir_function(12, fn0, 1),
        b_harness_hir_function(13, fthrow0, 2),
        b_harness_hir_function(14, fthrow1, 3),
        b_harness_hir_function(15, fn0, 4),
        b_harness_hir_function(16, fn1, 0),
        b_harness_hir_function(17, fn_i64, 0),
        b_harness_hir_function(18, fn0, 0),
        b_harness_hir_function(19, fn0, 0),
        b_harness_hir_function(20, fn_bool, 0),
        b_harness_hir_function(21, fn_bool, 0),
        b_harness_hir_function(22, fn_unit, 0)
    ];
    module.nominals = [
        hir.NominalDecl(symbol: 100, kind: model.TypeKind.NominalStruct,
            params: [], fields: [
                hir.FieldDecl(symbol: 101, type_id: i32_type, exported: false,
                    source: b_harness_source(0)),
                hir.FieldDecl(symbol: 102, type_id: i32_type, exported: false,
                    source: b_harness_source(0))
            ], variants: [], source: b_harness_source(0)),
        hir.NominalDecl(symbol: 110, kind: model.TypeKind.NominalEnum,
            params: [], fields: [], variants: [
                hir.VariantDecl(symbol: 111, payload: [
                    hir.FieldDecl(symbol: 113, type_id: i32_type,
                        exported: false, source: b_harness_source(0))
                ], source: b_harness_source(0)),
                hir.VariantDecl(symbol: 112, payload: [],
                    source: b_harness_source(0))
            ], source: b_harness_source(0))
    ];

    var cfg = nativeir.empty_module(module);
    // symbol 10 (throwing entry):
    //   double(21) + 7 / 2 - 7 % 2 - 8 + floatmath() + vecmath() + f13() == 84
    var compute = vec.empty[nativeir.Instruction]();
    vec.push(compute, b_harness_constant(0, i32_type, 21));
    vec.push(compute, b_harness_function_value(1, fn1, 11));
    vec.push(compute, b_harness_call(2, i32_type, fn1, [1, 0], 0));
    vec.push(compute, b_harness_constant(3, i32_type, 7));
    vec.push(compute, b_harness_constant(4, i32_type, 2));
    vec.push(compute, b_harness_binary(5, i32_type, 3, 4, hir.BinaryOp.Divide));
    vec.push(compute, b_harness_binary(6, i32_type, 3, 4,
        hir.BinaryOp.Remainder));
    vec.push(compute, b_harness_binary(7, i32_type, 2, 5, hir.BinaryOp.Add));
    vec.push(compute, b_harness_binary(8, i32_type, 7, 6, hir.BinaryOp.Subtract));
    vec.push(compute, b_harness_constant(9, i32_type, 8));
    vec.push(compute, b_harness_binary(10, i32_type, 8, 9,
        hir.BinaryOp.Subtract));
    vec.push(compute, b_harness_function_value(11, fn0, 12));
    vec.push(compute, b_harness_call(12, i32_type, fn0, [11], 1));
    vec.push(compute, b_harness_binary(13, i32_type, 10, 12, hir.BinaryOp.Add));
    vec.push(compute, b_harness_string(14, string_type, "a\"b\\c\td\u{e9}"));
    vec.push(compute, b_harness_function_value(15, fthrow0, 13));
    vec.push(compute, b_harness_function_value(16, fn0, 15));
    vec.push(compute, b_harness_call(17, i32_type, fn0, [16], 4));
    var compute_success = vec.empty[nativeir.Instruction]();
    vec.push(compute_success, b_harness_binary(18, i32_type, 13, 20,
        hir.BinaryOp.Add));
    vec.push(compute_success, b_harness_binary(21, i32_type, 18, 17,
        hir.BinaryOp.Add));
    let compute_error = vec.empty[nativeir.Instruction]();

    // symbol 11: double(x) = x * 2
    var double = vec.empty[nativeir.Instruction]();
    vec.push(double, b_harness_load(0, i32_type, 0));
    vec.push(double, b_harness_constant(1, i32_type, 2));
    vec.push(double, b_harness_binary(2, i32_type, 0, 1, hir.BinaryOp.Multiply));
    var double_slot = b_harness_empty_slot();
    double_slot.type_id = i32_type;
    double_slot.parameter = option.Option[u32].Some(0);

    // symbol 12: floatmath() -> 0 with a two-way branch
    var entry = vec.empty[nativeir.Instruction]();
    vec.push(entry, b_harness_constant(0, f64_type, 4611686018427387904));
    vec.push(entry, b_harness_constant(1, f64_type, 0));
    vec.push(entry, b_harness_binary(2, f64_type, 0, 1, hir.BinaryOp.Add));
    vec.push(entry, b_harness_unary(3, f64_type, 2, hir.UnaryOp.Negate));
    vec.push(entry, b_harness_convert(4, i32_type, 3));
    vec.push(entry, b_harness_binary(5, bool_type, 0, 1, hir.BinaryOp.Less));
    var joined = vec.empty[nativeir.Instruction]();
    vec.push(joined, b_harness_constant(6, i32_type, 2));
    vec.push(joined, b_harness_binary(7, i32_type, 4, 6, hir.BinaryOp.Add));
    var empty = vec.empty[nativeir.Instruction]();
    vec.push(empty, b_harness_constant(8, i32_type, 0));

    // symbol 13: () -> i32 throws i32, forwards a try-call to symbol 14.
    var throw13 = vec.empty[nativeir.Instruction]();
    vec.push(throw13, b_harness_function_value(0, fthrow1, 14));
    vec.push(throw13, b_harness_constant(1, i32_type, 7));
    var throw13_error = vec.empty[nativeir.Instruction]();

    // symbol 14: (i32) -> i32 throws i32, returns x * 6.
    var throw14 = vec.empty[nativeir.Instruction]();
    vec.push(throw14, b_harness_load(0, i32_type, 0));
    vec.push(throw14, b_harness_constant(1, i32_type, 6));
    vec.push(throw14, b_harness_binary(2, i32_type, 0, 1,
        hir.BinaryOp.Multiply));
    var throw14_slot = b_harness_empty_slot();
    throw14_slot.type_id = i32_type;
    throw14_slot.parameter = option.Option[u32].Some(0);

    // symbol 15: real Vec instructions.  VecSet rewrites element 0, VecRead
    // reads element 1, and VecLength yields 2, so the result is 6.  C emits
    // the VecInit/VecRead/VecSet/VecLength bodies; B's vec_field and
    // vec_memory supply the descriptor and payload TBAA tags.
    var vecmath = vec.empty[nativeir.Instruction]();
    vec.push(vecmath, b_harness_constant(0, i32_type, 3));
    vec.push(vecmath, b_harness_constant(1, i32_type, 4));
    vec.push(vecmath, b_harness_vec_init(2, vec_i32, [0, 1]));
    vec.push(vecmath, b_harness_constant(3, i32_type, 0));
    vec.push(vecmath, b_harness_constant(4, i32_type, 9));
    vec.push(vecmath, b_harness_vec_set(unit_type, [2, 3, 4]));
    vec.push(vecmath, b_harness_constant(5, i32_type, 1));
    vec.push(vecmath, b_harness_vec_read(6, i32_type, [2, 5]));
    vec.push(vecmath, b_harness_vec_length(7, usize_type, 2));
    vec.push(vecmath, b_harness_convert(8, i32_type, 7));
    vec.push(vecmath, b_harness_binary(9, i32_type, 6, 8,
        hir.BinaryOp.Add));

    // symbol 16: identity, widening and narrowing integer conversions.  This
    // must spell no `trunc i32 ... to i32` and no invalid same-width trunc.
    var int_convert = vec.empty[nativeir.Instruction]();
    vec.push(int_convert, b_harness_load(0, i32_type, 0));
    vec.push(int_convert, b_harness_convert(1, i32_type, 0));
    vec.push(int_convert, b_harness_convert(2, i64_type, 1));
    vec.push(int_convert, b_harness_convert(3, i32_type, 2));
    var int_convert_slot = b_harness_empty_slot();
    int_convert_slot.type_id = i32_type;
    int_convert_slot.parameter = option.Option[u32].Some(0);

    // symbol 17: float-to-i64 conversion.  The width-64 case is the identity
    // after fptosi and must not append `trunc i64 ... to i64`.
    var float_to_i64 = vec.empty[nativeir.Instruction]();
    vec.push(float_to_i64, b_harness_constant(0, f64_type,
        4611686018427387904));
    vec.push(float_to_i64, b_harness_convert(1, i64_type, 0));

    // symbol 18: nominal struct construction and field lookup.
    var pair = vec.empty[nativeir.Instruction]();
    vec.push(pair, b_harness_constant(0, i32_type, 11));
    vec.push(pair, b_harness_constant(1, i32_type, 31));
    vec.push(pair, b_harness_struct_init(2, pair_type, [0, 1]));
    vec.push(pair, b_harness_field_read(3, i32_type, 2, 101));
    vec.push(pair, b_harness_field_read(4, i32_type, 2, 102));
    vec.push(pair, b_harness_binary(5, i32_type, 3, 4, hir.BinaryOp.Add));

    // symbol 19: nominal enum tag test and payload projection.
    var choice = vec.empty[nativeir.Instruction]();
    vec.push(choice, b_harness_constant(0, i32_type, 7));
    vec.push(choice, b_harness_enum_init(1, choice_type, 111, [0]));
    vec.push(choice, b_harness_enum_test(2, bool_type, 1, 111));
    vec.push(choice, b_harness_enum_payload(3, i32_type, 1, 111, 113));

    // symbols 20..22: Bool/Unit Constants must dispatch through the ordinary
    // instruction path, not types.bit_width.  They are emitted through
    // declare_source_functions -> emit_function -> emit_instruction.
    var false_fn = vec.empty[nativeir.Instruction]();
    vec.push(false_fn, b_harness_constant(0, bool_type, 0));
    var true_fn = vec.empty[nativeir.Instruction]();
    vec.push(true_fn, b_harness_constant(0, bool_type, 1));
    var unit_fn = vec.empty[nativeir.Instruction]();
    vec.push(unit_fn, b_harness_constant(0, unit_type, 0));

    vec.push(cfg.functions, nativeir.Function(symbol: 10, signature: fthrow0,
        is_async: false, slots: [],
        blocks: [
            b_harness_block(compute,
                b_harness_try(fthrow0, [15], 1, 2, 2)),
            b_harness_block_with(compute_success,
                b_harness_terminator(nativeir.Exit.Return, [21], []),
                [b_harness_parameter(20, i32_type, false)]),
            b_harness_block_with(compute_error,
                b_harness_terminator(nativeir.Exit.ErrorReturn, [22], []),
                [b_harness_parameter(22, i32_type, true)])
        ],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 11, signature: fn1,
        is_async: false, slots: [double_slot],
        blocks: [b_harness_block(double,
            b_harness_terminator(nativeir.Exit.Return, [2], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 12, signature: fn0,
        is_async: false, slots: [],
        blocks: [
            b_harness_block(entry,
                b_harness_terminator(nativeir.Exit.Conditional, [5], [1, 2])),
            b_harness_block(joined,
                b_harness_terminator(nativeir.Exit.Return, [7], [])),
            b_harness_block(empty,
                b_harness_terminator(nativeir.Exit.Return, [8], []))
        ],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 13, signature: fthrow0,
        is_async: false, slots: [],
        blocks: [
            b_harness_block(throw13,
                b_harness_try(fthrow1, [0, 1], 1, 2, 3)),
            b_harness_block_with(vec.empty[nativeir.Instruction](),
                b_harness_terminator(nativeir.Exit.Return, [10], []),
                [b_harness_parameter(10, i32_type, false)]),
            b_harness_block_with(throw13_error,
                b_harness_terminator(nativeir.Exit.ErrorReturn, [11], []),
                [b_harness_parameter(11, i32_type, true)])
        ],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 14, signature: fthrow1,
        is_async: false, slots: [throw14_slot],
        blocks: [b_harness_block(throw14,
            b_harness_terminator(nativeir.Exit.Return, [2], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 15, signature: fn0,
        is_async: false, slots: [],
        blocks: [b_harness_block(vecmath,
            b_harness_terminator(nativeir.Exit.Return, [9], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 16, signature: fn1,
        is_async: false, slots: [int_convert_slot],
        blocks: [b_harness_block(int_convert,
            b_harness_terminator(nativeir.Exit.Return, [3], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 17, signature: fn_i64,
        is_async: false, slots: [],
        blocks: [b_harness_block(float_to_i64,
            b_harness_terminator(nativeir.Exit.Return, [1], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 18, signature: fn0,
        is_async: false, slots: [],
        blocks: [b_harness_block(pair,
            b_harness_terminator(nativeir.Exit.Return, [5], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 19, signature: fn0,
        is_async: false, slots: [],
        blocks: [b_harness_block(choice,
            b_harness_terminator(nativeir.Exit.Return, [3], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 20, signature: fn_bool,
        is_async: false, slots: [],
        blocks: [b_harness_block(false_fn,
            b_harness_terminator(nativeir.Exit.Return, [0], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 21, signature: fn_bool,
        is_async: false, slots: [],
        blocks: [b_harness_block(true_fn,
            b_harness_terminator(nativeir.Exit.Return, [0], []))],
        source: b_harness_span(), handlers: []));
    vec.push(cfg.functions, nativeir.Function(symbol: 22, signature: fn_unit,
        is_async: false, slots: [],
        blocks: [b_harness_block(unit_fn,
            b_harness_terminator(nativeir.Exit.Return, [0], []))],
        source: b_harness_span(), handlers: []));

    var state = emitcore.new_emitter(cfg, emitcore.Settings(
        triple: "x86_64-unknown-linux-gnu", cpu: "generic", features: "",
        optimization: 0, debug_info: false));
    // Root sets the executable entry before emitting functions, exactly as
    // src/backend/native/emit.cpp::run does; B.emit_main repeats and validates.
    state.gc_entry_symbol = option.Option[usize].Some(10);
    emitcore.declare_runtime_types(inout state);
    declare_source_functions(inout state);
    for var index usize = 0; index < vec.len(state.input.functions); index += 1 {
        emit_function(index, inout state);
    }
    emit_main(10, inout state);
    return emitcore.sections(state);
}
