func value_address(type_id usize, value Value, state inout Emitter) Value throws Error {
    let type_name = lower_type(type_id, inout state);
    let address = storage(type_name, inout state);
    append("store " + typed(value) + ", ptr " + address.reference, inout state);
    return address;
}

