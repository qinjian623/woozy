// TEST-ONLY SCAFFOLD for the nativeemit_b harness.
//
// The C/D/E owners of SELFHOST_NATIVEEMIT.md are written by other workers and
// are absent from the tree while SH08 is in progress.  This file supplies only
// their documented symbol names so that nativeemit/b_* can be parsed, resolved
// and type-checked, plus a few honest minimal bodies that the B harness really
// exercises (owning=false for the scalar-only test module, non-capturing
// function values, and the GC runtime hooks).
//
// It is never merged: the production definitions live in values.wz, async_gc.wz
// and system.wz.
package nativeemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "std/option" as option;
import "std/vec" as vec;

// ---- C: values.wz stand-ins -------------------------------------------------

func owning(type_id usize, state inout Emitter) bool throws Error {
    // The harness module contains only scalar/string types, which never own.
    return false;
}

func value_op(type_id usize, copy bool, state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: value_op");
}

func copy_value(type_id usize, value Value, state inout Emitter) Value throws Error {
    return value;
}

func destroy_slot(slot usize, type_id usize, state inout Emitter) throws Error {
    throw invalid("nativeemit_b harness scaffold: destroy_slot");
}

func env_record_type(fields Vec[usize], state inout Emitter) string throws Error {
    throw invalid("nativeemit_b harness scaffold: env_record_type");
}

func env_record_op(fields Vec[usize], copy bool, state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: env_record_op");
}

func make_environment(fields Vec[usize], children Vec[Value],
                      state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: make_environment");
}

func function_thunk(symbol usize, state inout Emitter) Value throws Error {
    return call_target(state, symbol);
}

func bound_adapter(schema hir.FunctionValue, state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: bound_adapter");
}

func function_value(instruction nativeir.Instruction, args Vec[Value],
                    state inout Emitter) Value throws Error {
    // Correct for a non-capturing, non-bound function value only.
    let code = call_target(state, instruction.function);
    return Value(type_name: FN_TYPE, reference: FN_TYPE + " { ptr " +
        code.reference + ", ptr null }");
}

func function_value_info(state Emitter, value_id usize) option.Option[FunctionValueInfo] {
    return option.Option[FunctionValueInfo].None;
}

func trait_box_op(concrete usize, clone bool, state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: trait_box_op");
}

func trait_method_thunk(dyn_type usize, concrete usize, target usize,
                        state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: trait_method_thunk");
}

func trait_vtable(dyn_type usize, concrete usize, methods Vec[usize],
                  state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: trait_vtable");
}

func thread_bridge(entry_type usize, state inout Emitter) ThreadBridge throws Error {
    throw invalid("nativeemit_b harness scaffold: thread_bridge");
}

func thread_spawn(instruction nativeir.Instruction, args Vec[Value],
                  state inout Emitter) Value throws Error {
    throw invalid("nativeemit_b harness scaffold: thread_spawn");
}

func weak_system_call(instruction nativeir.Instruction, args Vec[Value],
                      state inout Emitter) option.Option[Value] throws Error {
    return option.Option[Value].None;
}

func emit_value_instruction(instruction nativeir.Instruction, args Vec[Value],
                            state inout Emitter) option.Option[Value] throws Error {
    // Only the non-capturing Op::Function path is exercised by the B harness.
    switch instruction.op {
        case nativeir.Op.Function: {
            let value = function_value(instruction, args, inout state);
            return option.Option[Value].Some(value);
        }
        default: throw invalid("nativeemit_b harness scaffold: emit_value_instruction");
    }
}

