package app;

// Acceptance tests for the pure-Wz literal and constant packages.  Every
// source AST used here comes from the real app/wzcc/lexer + parser; HIR
// records are constructed explicitly because this branch has no sema yet.
import "compiler/wzcc/constant" as constant;
import "compiler/wzcc/hir" as hir;
import "compiler/wzcc/lexer" as lexer;
import "compiler/wzcc/literal" as literal;
import "compiler/wzcc/model" as model;
import "compiler/wzcc/parser" as parser;
import "compiler/wzcc/source" as source;
import "compiler/wzcc/types" as types;
import "std/io" as io;
import "std/option" as option;
import "std/os" as os;
import "std/strconv" as strconv;
import "std/text" as text;
import "std/vec" as vec;

func none_type() option.Option[usize] {
    return option.Option[usize].None;
}

func config() model.CheckConfig {
    return model.CheckConfig(backend: model.Backend.Native, word_bits: 64);
}

func scalar(state inout types.Context, kind model.TypeKind,
            bits u32) usize {
    let value = model.Type(kind: kind, bits: bits,
        declaration: 0, binding: 0, parameters: [], result: 0,
        throws_type: none_type(), type_args: [], c_type: 0);
    try {
        return types.intern(inout state, value);
    } catch error types.Error {
        return 0;
    }
}

func nominal_type(state inout types.Context, kind model.TypeKind,
                  declaration usize) usize {
    let value = model.Type(kind: kind, bits: 0, declaration: declaration,
        binding: 0, parameters: [], result: 0, throws_type: none_type(),
        type_args: [], c_type: 0);
    try {
        return types.intern(inout state, value);
    } catch error types.Error {
        return 0;
    }
}

func parse_source(value string) model.ParseResult {
    let snapshot = source.snapshot(1, 1, 1, "test.wz", text.bytes(value));
    let lexed = lexer.lex(snapshot);
    return parser.parse(lexed);
}

func make_project(parsed model.ParseResult) model.Project {
    var project = model.empty_project();
    project.files = [parsed];
    project.modules = [model.Module(id: 0, logical_path: "app",
        identity: "app", package_name: "app", files: [0], imports: [],
        foreign_exports: [],
        binding: option.Option[model.BindingModuleRef].None,
        c_binding: option.Option[usize].None)];
    return project;
}

func find_kind(file model.ParseResult, kind model.AstKind) usize {
    var found usize = 0;
    for var index usize = 0; index < vec.len(file.nodes); index += 1 {
        if model.ast_kind_id(file.nodes[index].kind) ==
           model.ast_kind_id(kind) {
            found = index;
        }
    }
    return found;
}

func hex_digit(value u64) string {
    if value < 10 { return strconv.format_u64(value); }
    if value == 10 { return "a"; }
    if value == 11 { return "b"; }
    if value == 12 { return "c"; }
    if value == 13 { return "d"; }
    if value == 14 { return "e"; }
    return "f";
}

func hex(value string) string {
    let bytes = text.bytes(value);
    var out = "";
    for byte in bytes {
        let number = u64(byte);
        out = out + hex_digit((number >> 4) & 15) + hex_digit(number & 15);
    }
    return out;
}

func print_pattern(label string,
                   value hir.PatternLiteral) throws os.Error {
    switch value {
        case hir.PatternLiteral.BoolLiteral(payload): {
            var spelling = "false";
            if payload.value { spelling = "true"; }
            io.println(label + "=bool:" + spelling);
        }
        case hir.PatternLiteral.IntegerLiteral(payload): {
            io.println(label + "=int:" + payload.decimal + ":" +
                strconv.format_u64(payload.bits));
        }
        case hir.PatternLiteral.FloatLiteral(payload): {
            io.println(label + "=float:" +
                strconv.format_u64(payload.bits));
        }
        case hir.PatternLiteral.StringLiteral(payload): {
            io.println(label + "=string:" + hex(payload.utf8));
        }
    }
}

func report_error(label string, message string) throws os.Error {
    io.println(label + "=error:" + message);
}

func decode_case(label string, snippet string, expected usize,
                 state types.Context, check model.CheckConfig)
                 throws os.Error {
    let parsed = parse_source(snippet);
    if !parsed.has_value || parsed.recovered {
        io.println(label + "=parse_failed");
        return;
    }
    let project = make_project(parsed);
    let node = find_kind(parsed, model.AstKind.LiteralPattern);
    try {
        let value = literal.decode_pattern_literal(project, state,
            model.NodeRef(module: 0, file: 0, node: node), expected, check);
        print_pattern(label, value);
    } catch error model.SupportError {
        switch error {
            case model.SupportError.Invalid(message): {
                report_error(label, message);
            }
            case model.SupportError.Limit(message): {
                report_error(label, message);
            }
        }
    }
}

func literal_tests(state inout types.Context) throws os.Error {
    let u8_type = scalar(inout state, model.TypeKind.UnsignedInt, 8);
    let i8_type = scalar(inout state, model.TypeKind.SignedInt, 8);
    let i32_type = scalar(inout state, model.TypeKind.SignedInt, 32);
    let u32_type = scalar(inout state, model.TypeKind.UnsignedInt, 32);
    let i64_type = scalar(inout state, model.TypeKind.SignedInt, 64);
    let u64_type = scalar(inout state, model.TypeKind.UnsignedInt, 64);
    let isize_type = scalar(inout state, model.TypeKind.Isize, 0);
    let usize_type = scalar(inout state, model.TypeKind.Usize, 0);
    let f32_type = scalar(inout state, model.TypeKind.Float, 32);
    let f64_type = scalar(inout state, model.TypeKind.Float, 64);
    let bool_type = scalar(inout state, model.TypeKind.Bool, 0);
    let string_type = scalar(inout state, model.TypeKind.String, 0);
    let check = config();
    let bool_source = `package app;
func f(x bool) i32 { switch x { case true: return 0; default: return 1; } }
`;
    let bool_false_source = `package app;
func f(x bool) i32 { switch x { case false: return 0; default: return 1; } }
`;
    decode_case("bool.true", bool_source, bool_type, state, check);
    decode_case("bool.false", bool_false_source, bool_type, state, check);
    decode_case("bool.integer", `package app;
func f(x bool) i32 { switch x { case 1: return 0; default: return 1; } }
`, bool_type, state, check);
    decode_case("bool.negative", `package app;
func f(x bool) i32 { switch x { case -0: return 0; default: return 1; } }
`, bool_type, state, check);
    let int_source = `package app;
func f(x i32) i32 { switch x { case 42: return 0; default: return 1; } }
`;
    let neg_source = `package app;
func f(x i32) i32 { switch x { case -42: return 0; default: return 1; } }
`;
    decode_case("i32.42", int_source, i32_type, state, check);
    decode_case("i32.minus42", neg_source, i32_type, state, check);
    decode_case("i8.min", `package app;
func f(x i8) i32 { switch x { case -128: return 0; default: return 1; } }
`, i8_type, state, check);
    decode_case("i8.minus129", `package app;
func f(x i8) i32 { switch x { case -129: return 0; default: return 1; } }
`, i8_type, state, check);
    decode_case("i8.hex", `package app;
func f(x i8) i32 { switch x { case 0x7f: return 0; default: return 1; } }
`, i8_type, state, check);
    decode_case("u8.max", `package app;
func f(x u8) i32 { switch x { case 255: return 0; default: return 1; } }
`, u8_type, state, check);
    decode_case("u8.overflow", `package app;
func f(x u8) i32 { switch x { case 256: return 0; default: return 1; } }
`, u8_type, state, check);
    decode_case("u64.max", `package app;
func f(x u64) i32 { switch x { case 0xffff_ffff_ffff_ffff: return 0; default: return 1; } }
`, u64_type, state, check);
    decode_case("u64.max.dec", `package app;
func f(x u64) i32 { switch x { case 18446744073709551615: return 0; default: return 1; } }
`, u64_type, state, check);
    decode_case("u64.overflow", `package app;
func f(x u64) i32 { switch x { case 18446744073709551616: return 0; default: return 1; } }
`, u64_type, state, check);
    decode_case("isize.word64.min", `package app;
func f(x isize) i32 { switch x { case -9223372036854775808: return 0; default: return 1; } }
`, isize_type, state, check);
    decode_case("usize.word64.max", `package app;
func f(x usize) i32 { switch x { case 18446744073709551615: return 0; default: return 1; } }
`, usize_type, state, check);
    let word32 = model.CheckConfig(backend: model.Backend.Native, word_bits: 32);
    decode_case("usize.word32.max", `package app;
func f(x usize) i32 { switch x { case 4294967295: return 0; default: return 1; } }
`, usize_type, state, word32);
    decode_case("usize.word32.overflow", `package app;
func f(x usize) i32 { switch x { case 4294967296: return 0; default: return 1; } }
`, usize_type, state, word32);
    decode_case("f32.1.5", `package app;
func f(x f32) i32 { switch x { case 1.5: return 0; default: return 1; } }
`, f32_type, state, check);
    decode_case("f32.negative.zero", `package app;
func f(x f32) i32 { switch x { case -0.0: return 0; default: return 1; } }
`, f32_type, state, check);
    decode_case("f32.overflow", `package app;
func f(x f32) i32 { switch x { case 1e40: return 0; default: return 1; } }
`, f32_type, state, check);
    decode_case("f64.ulp", `package app;
func f(x f64) i32 { switch x { case 1.0000000000000002: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("f64.overflow", `package app;
func f(x f64) i32 { switch x { case 1e400: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("f64.underflow", `package app;
func f(x f64) i32 { switch x { case 1e-400: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("f32.tie", `package app;
func f(x f32) i32 { switch x { case 16777217.0: return 0; default: return 1; } }
`, f32_type, state, check);
    decode_case("f32.subnormal", `package app;
func f(x f32) i32 { switch x { case 1e-45: return 0; default: return 1; } }
`, f32_type, state, check);
    decode_case("f32.min.normal", `package app;
func f(x f32) i32 { switch x { case 1.1754943508222875e-38: return 0; default: return 1; } }
`, f32_type, state, check);
    decode_case("f64.min.subnormal", `package app;
func f(x f64) i32 { switch x { case 5e-324: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("f64.max", `package app;
func f(x f64) i32 { switch x { case 1.7976931348623157e308: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("f64.tie", `package app;
func f(x f64) i32 { switch x { case 1.00000000000000011102230246251565404236316680908203125: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("u8.underscore", `package app;
func f(x u8) i32 { switch x { case 0b1111_1111: return 0; default: return 1; } }
`, u8_type, state, check);
    decode_case("u8.octal", `package app;
func f(x u8) i32 { switch x { case 0o377: return 0; default: return 1; } }
`, u8_type, state, check);
    decode_case("i32.hex.min", `package app;
func f(x i32) i32 { switch x { case -0x8000_0000: return 0; default: return 1; } }
`, i32_type, state, check);
    decode_case("f64.negative", `package app;
func f(x f64) i32 { switch x { case -1.25: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("f64.integer.token", `package app;
func f(x f64) i32 { switch x { case 1: return 0; default: return 1; } }
`, f64_type, state, check);
    decode_case("i32.float.token", `package app;
func f(x i32) i32 { switch x { case 1.0: return 0; default: return 1; } }
`, i32_type, state, check);
    decode_case("string.value", `package app;
func f(x string) i32 { switch x { case "a\u{0}😀": return 0; default: return 1; } }
`, string_type, state, check);
    decode_case("string.negative", `package app;
func f(x string) i32 { switch x { case -1: return 0; default: return 1; } }
`, string_type, state, check);
    decode_case("unsupported.target", int_source, bool_type, state, check);
}


func type_text(state types.Context, id usize) string {
    switch types.find(state, id) {
        case option.Option.Some(value): {
            return strconv.format_u64(u64(model.type_kind_id(value.kind))) +
                ":" + strconv.format_u64(u64(value.bits)) + ":" +
                strconv.format_u64(u64(value.declaration));
        }
        case option.Option.None: { return "missing"; }
    }
}

func print_constant(label string, state types.Context,
                    value hir.ConstantValue) throws os.Error {
    let prefix = label + "=type=" + type_text(state, value.type_id) + "|";
    switch value.data {
        case hir.ConstantData.UnitLiteral(payload): {
            io.println(prefix + "unit");
        }
        case hir.ConstantData.BoolLiteral(payload): {
            var spelling = "false";
            if payload.value { spelling = "true"; }
            io.println(prefix + "bool:" + spelling);
        }
        case hir.ConstantData.IntegerLiteral(payload): {
            io.println(prefix + "int:" + payload.decimal + ":" +
                strconv.format_u64(payload.bits));
        }
        case hir.ConstantData.FloatLiteral(payload): {
            io.println(prefix + "float:" +
                strconv.format_u64(payload.bits));
        }
        case hir.ConstantData.StringLiteral(payload): {
            io.println(prefix + "string:" + hex(payload.utf8));
        }
        case hir.ConstantData.FunctionValue(payload): {
            var args = "";
            for arg in payload.type_args {
                args = args + "," + type_text(state, arg);
            }
            var moved = "false";
            if payload.move_capture { moved = "true"; }
            var bound = "none";
            if option.is_some(payload.bound) {
                let receiver = option.unwrap_or(payload.bound,
                    hir.BoundReceiver(type_id: 0,
                        mode: model.ParamMode.Ordinary));
                bound = type_text(state, receiver.type_id);
            }
            io.println(prefix + "function:" +
                strconv.format_u64(u64(payload.symbol)) + args +
                ":caps:" + strconv.format_u64(u64(vec.len(payload.captures))) +
                ":move:" + moved + ":bound:" + bound);
        }
        case hir.ConstantData.ConstantAggregate(payload): {
            var variant = "none";
            if option.is_some(payload.variant) {
                variant = strconv.format_u64(u64(
                    option.unwrap_or(payload.variant, 0)));
            }
            io.println(prefix + "aggregate:" + variant + ":" +
                strconv.format_u64(u64(vec.len(payload.fields))));
            for var index usize = 0; index < vec.len(payload.fields);
                index += 1 {
                print_constant(label + ".field" +
                    strconv.format_u64(u64(index)), state,
                    payload.fields[index]);
            }
        }
    }
}

func parse_unused(node model.NodeRef) usize throws model.SupportError {
    throw model.SupportError.Invalid("test parse callback unavailable");
    return 0;
}

func function_unused(node model.NodeRef,
                     expected usize) hir.FunctionValue
                     throws model.SupportError {
    throw model.SupportError.Invalid("test function callback unavailable");
    return hir.FunctionValue(symbol: 0, type_args: [],
        captures: [], move_capture: false,
        bound: option.Option[hir.BoundReceiver].None);
}

struct Bindings {
    resolved model.ResolvedProject;
    type_ids Vec[usize];
}

func bindings_with(parsed model.ParseResult, names Vec[string],
                   kinds Vec[model.SymbolKind], ids Vec[usize],
                   definitions Vec[option.Option[usize]]) Bindings {
    let project = make_project(parsed);
    let symbols = vec.empty[model.Symbol]();
    for var index usize = 0; index < vec.len(names); index += 1 {
        var definition = option.Option[model.NodeRef].None;
        if index < vec.len(definitions) &&
           option.is_some(definitions[index]) {
            definition = option.Option[model.NodeRef].Some(
                model.NodeRef(module: 0, file: 0,
                    node: option.unwrap_or(definitions[index], 0)));
        }
        vec.push(symbols, model.Symbol(id: index, name: names[index],
            kind: kinds[index], module: 0, definition: definition,
            declaration: option.Option[model.Span].None,
            exported: false, target: option.Option[usize].None,
            foreign: option.Option[model.ForeignExportRef].None));
    }
    let occurrences = vec.empty[model.Occurrence]();
    for var index usize = 0; index < vec.len(parsed.nodes); index += 1 {
        let node = parsed.nodes[index];
        if model.ast_kind_id(node.kind) !=
           model.ast_kind_id(model.AstKind.Name) {
            continue;
        }
        let spelling = parsed.lexed.tokens[node.token_begin].spelling;
        for var symbol usize = 0; symbol < vec.len(names); symbol += 1 {
            if names[symbol] == spelling {
                vec.push(occurrences, model.Occurrence(
                    source: model.NodeRef(module: 0, file: 0, node: index),
                    symbol: symbol,
                    span: node.span));
            }
        }
    }
    return Bindings(resolved: model.ResolvedProject(project: project,
        symbols: symbols, occurrences: occurrences, deferred_members: [],
        self_parameters: []), type_ids: ids);
}

func builtin_bindings(parsed model.ParseResult, names Vec[string],
                      kinds Vec[model.SymbolKind],
                      ids Vec[usize]) Bindings {
    return bindings_with(parsed, names, kinds, ids,
        vec.empty[option.Option[usize]]());
}

func source_case(label string, snippet string, kind model.AstKind,
                 expected usize, state inout types.Context,
                 names Vec[string], kinds Vec[model.SymbolKind],
                 ids Vec[usize], nominals Vec[hir.NominalDecl],
                 function func(model.NodeRef, usize)
                          hir.FunctionValue throws model.SupportError)
                 throws os.Error {
    let parsed = parse_source(snippet);
    if !parsed.has_value || parsed.recovered {
        io.println(label + "=parse_failed");
        return;
    }
    let bindings = builtin_bindings(parsed, names, kinds, ids);
    var module = hir.empty_module(bindings.resolved, 1, config());
    module.nominals = nominals;
    let node = find_kind(parsed, kind);
    let resolve = func(candidate model.NodeRef) usize
                        throws model.SupportError {
        for occurrence in bindings.resolved.occurrences {
            if occurrence.source.module == candidate.module &&
               occurrence.source.file == candidate.file &&
               occurrence.source.node == candidate.node {
                return bindings.type_ids[occurrence.symbol];
            }
        }
        throw model.SupportError.Invalid(
            "test builtin type resolution failed");
        return 0;
    };
    try {
        let value = constant.source_constant_value(module, inout state,
            model.NodeRef(module: 0, file: 0, node: node), expected,
            resolve, function);
        print_constant(label, state, value);
    } catch error model.SupportError {
        switch error {
            case model.SupportError.Invalid(message): {
                report_error(label, message);
            }
            case model.SupportError.Limit(message): {
                report_error(label, message);
            }
        }
    }
}

func source_full_case(label string, snippet string, kind model.AstKind,
                      expected usize, state inout types.Context,
                      names Vec[string], kinds Vec[model.SymbolKind],
                      ids Vec[usize],
                      definitions Vec[option.Option[usize]],
                      nominals Vec[hir.NominalDecl],
                      function func(model.NodeRef, usize) hir.FunctionValue
                               throws model.SupportError) throws os.Error {
    let parsed = parse_source(snippet);
    if !parsed.has_value || parsed.recovered {
        io.println(label + "=parse_failed");
        return;
    }
    let bindings = bindings_with(parsed, names, kinds, ids, definitions);
    var module = hir.empty_module(bindings.resolved, 1, config());
    module.nominals = nominals;
    let node = find_kind(parsed, kind);
    let resolve = func(candidate model.NodeRef) usize
                        throws model.SupportError {
        for occurrence in bindings.resolved.occurrences {
            if occurrence.source.module == candidate.module &&
               occurrence.source.file == candidate.file &&
               occurrence.source.node == candidate.node {
                return bindings.type_ids[occurrence.symbol];
            }
        }
        throw model.SupportError.Invalid(
            "test type resolution failed");
        return 0;
    };
    try {
        let value = constant.source_constant_value(module, inout state,
            model.NodeRef(module: 0, file: 0, node: node), expected,
            resolve, function);
        print_constant(label, state, value);
    } catch error model.SupportError {
        switch error {
            case model.SupportError.Invalid(message): {
                report_error(label, message);
            }
            case model.SupportError.Limit(message): {
                report_error(label, message);
            }
        }
    }
}

func expression(value string) string {
    return "package app;\nfunc f() i32 { return " + value + "; }\n";
}

func source_tests(state inout types.Context) throws os.Error {
    let u8_type = scalar(inout state, model.TypeKind.UnsignedInt, 8);
    let i8_type = scalar(inout state, model.TypeKind.SignedInt, 8);
    let i32_type = scalar(inout state, model.TypeKind.SignedInt, 32);
    let u32_type = scalar(inout state, model.TypeKind.UnsignedInt, 32);
    let i64_type = scalar(inout state, model.TypeKind.SignedInt, 64);
    let u64_type = scalar(inout state, model.TypeKind.UnsignedInt, 64);
    let f32_type = scalar(inout state, model.TypeKind.Float, 32);
    let f64_type = scalar(inout state, model.TypeKind.Float, 64);
    let bool_type = scalar(inout state, model.TypeKind.Bool, 0);
    let string_type = scalar(inout state, model.TypeKind.String, 0);
    let names = ["i8", "u8", "i32", "u32", "i64", "u64", "isize",
        "usize", "f32", "f64", "bool", "string"];
    let kinds = [model.SymbolKind.BuiltinType,
        model.SymbolKind.BuiltinType, model.SymbolKind.BuiltinType,
        model.SymbolKind.BuiltinType, model.SymbolKind.BuiltinType,
        model.SymbolKind.BuiltinType, model.SymbolKind.BuiltinType,
        model.SymbolKind.BuiltinType, model.SymbolKind.BuiltinType,
        model.SymbolKind.BuiltinType, model.SymbolKind.BuiltinType,
        model.SymbolKind.BuiltinType];
    let ids = [i8_type, u8_type, i32_type, u32_type, i64_type, u64_type,
        scalar(inout state, model.TypeKind.Isize, 0),
        scalar(inout state, model.TypeKind.Usize, 0), f32_type, f64_type,
        bool_type, string_type];
    let no_nominals = vec.empty[hir.NominalDecl]();
    source_case("src.i8.127", expression("127"), model.AstKind.Literal,
        i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.min", expression("-128"), model.AstKind.Unary,
        i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.min.double", expression("-(-128)"),
        model.AstKind.Unary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.overflow", expression("128"), model.AstKind.Literal,
        i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.u8.255", expression("255"), model.AstKind.Literal,
        u8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.u8.overflow", expression("256"),
        model.AstKind.Literal, u8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.not", expression("~0"), model.AstKind.Unary,
        i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.u8.not", expression("~0"), model.AstKind.Unary,
        u8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.add.wrap", expression("i8(127)+i8(1)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.u8.add.wrap", expression("u8(255)+u8(1)"),
        model.AstKind.Binary, u8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.sub.wrap", expression("i8(-128)-i8(1)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.mul.wrap", expression("i8(100)*i8(3)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.div.trunc", expression("i8(-7)/i8(2)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.rem.trunc", expression("i8(-7)%i8(2)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.div.zero", expression("i8(1)/i8(0)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.shr.neg", expression("i8(-7)>>i8(1)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.shl.wrap", expression("i8(1)<<i8(7)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.u8.shr", expression("u8(255)>>u8(1)"),
        model.AstKind.Binary, u8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.and", expression("i8(-1)&i8(15)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.or", expression("i8(-2)|i8(1)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.xor", expression("i8(-1)^i8(127)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.shl.panic", expression("i8(1)<<i8(8)"),
        model.AstKind.Binary, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.bool.and", expression("true&&false"),
        model.AstKind.Binary, bool_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.bool.short.and",
        expression("false&&(i32(1)/i32(0)==i32(0))"),
        model.AstKind.Binary, bool_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.bool.short.or",
        expression("true||(i32(1)/i32(0)==i32(0))"),
        model.AstKind.Binary, bool_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f32.add", expression("f32(1.5)+f32(0.5)"),
        model.AstKind.Binary, f32_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.div.zero", expression("f64(1.0)/f64(0.0)"),
        model.AstKind.Binary, f64_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.nan", expression("f64(0.0)/f64(0.0)"),
        model.AstKind.Binary, f64_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.negzero.add",
        expression("f64(-0.0)+f64(-0.0)"),
        model.AstKind.Binary, f64_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.poszero.add",
        expression("f64(-0.0)+f64(0.0)"),
        model.AstKind.Binary, f64_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.nan.ne",
        expression("f64(0.0)/f64(0.0)!=f64(0.0)"),
        model.AstKind.Binary, bool_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.nan.eq",
        expression("f64(0.0)/f64(0.0)==f64(0.0)"),
        model.AstKind.Binary, bool_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.zeros.eq",
        expression("f64(-0.0)==f64(0.0)"),
        model.AstKind.Binary, bool_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.from.float", expression("i8(1.9)"),
        model.AstKind.Call, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i8.from.negfloat", expression("i8(-1.9)"),
        model.AstKind.Call, i8_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.i32.from.inf", expression("i32(f32(1e40))"),
        model.AstKind.Call, i32_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f32.from.int", expression("f32(16777217)"),
        model.AstKind.Call, f32_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.f64.from.f32", expression("f64(f32(0.1))"),
        model.AstKind.Call, f64_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
    source_case("src.string", expression("\"a\\u{0}😀\""),
        model.AstKind.Literal, string_type, inout state, names, kinds, ids, no_nominals,
        function_unused);
}


func empty_source(node usize) hir.HirSource {
    return hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: node),
        span: model.Span(snapshot: 0, begin_byte: 0, end_byte: 0));
}

func make_node(type_id usize, data hir.NodeData,
               children Vec[usize]) hir.HirNode {
    return hir.HirNode(type_id: type_id, source: empty_source(0), scope: 0,
        children: children, data: data, errors: [], exits: []);
}

func symbol_constant(id usize, name string) model.Symbol {
    return model.Symbol(id: id, name: name,
        kind: model.SymbolKind.Constant, module: 0,
        definition: option.Option[model.NodeRef].None,
        declaration: option.Option[model.Span].None, exported: false,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None);
}

func symbol_function(id usize, name string) model.Symbol {
    return model.Symbol(id: id, name: name,
        kind: model.SymbolKind.Function, module: 0,
        definition: option.Option[model.NodeRef].None,
        declaration: option.Option[model.Span].None, exported: false,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None);
}

func make_hir_module(context types.Context, nodes Vec[hir.HirNode],
                     symbols Vec[model.Symbol],
                     nominals Vec[hir.NominalDecl]) hir.HirModule {
    let project = model.empty_project();
    let resolved = model.ResolvedProject(project: project, symbols: symbols,
        occurrences: [], deferred_members: [], self_parameters: []);
    var module = hir.empty_module(resolved, 1, config());
    module.types = context;
    module.nodes = nodes;
    module.nominals = nominals;
    return module;
}

func literal_node(type_id usize, decimal string,
                  bits u64) hir.HirNode {
    return make_node(type_id, hir.NodeData.IntegerLiteral(
        value: hir.IntegerLiteral(decimal: decimal, bits: bits)), []);
}

func bool_node(type_id usize, value bool) hir.HirNode {
    return make_node(type_id, hir.NodeData.BoolLiteral(
        value: hir.BoolLiteral(value: value)), []);
}

func float_node(type_id usize, bits u64) hir.HirNode {
    return make_node(type_id, hir.NodeData.FloatLiteral(
        value: hir.FloatLiteral(bits: bits)), []);
}

func call_arg(parameter u32, expression usize) hir.CallArg {
    return hir.CallArg(source_index: parameter, parameter_index: parameter,
        label: option.Option[string].None, mode: model.ParamMode.Ordinary,
        expression: expression);
}

func hir_case(label string, context types.Context, nodes Vec[hir.HirNode],
              symbols Vec[model.Symbol], nominals Vec[hir.NominalDecl],
              node usize) throws os.Error {
    let module = make_hir_module(context, nodes, symbols, nominals);
    switch constant.evaluate_hir_constant(module, node) {
        case option.Option.Some(value): {
            print_constant(label, context, value);
        }
        case option.Option.None: {
            io.println(label + "=none");
        }
    }
}

func aggregate_case(label string, context types.Context,
                    nodes Vec[hir.HirNode], node usize) throws os.Error {
    let module = make_hir_module(context, nodes, [], []);
    switch constant.evaluate_hir_constant(module, node) {
        case option.Option.Some(value): {
            switch value.data {
                case hir.ConstantData.ConstantAggregate(payload): {
                    io.println(label + "=aggregate:" +
                        strconv.format_u64(u64(vec.len(payload.fields))));
                }
                default: { io.println(label + "=some"); }
            }
        }
        case option.Option.None: { io.println(label + "=none"); }
    }
}

func aggregate_expression_case(label string, context types.Context,
                               nodes Vec[hir.HirNode],
                               symbols Vec[model.Symbol],
                               node usize) throws os.Error {
    let module = make_hir_module(context, nodes, symbols, []);
    var result = "false";
    if constant.aggregate_constant_expression(module, node) {
        result = "true";
    }
    io.println(label + "=" + result);
}

func hir_tests(state inout types.Context) throws os.Error {
    let i8_type = scalar(inout state, model.TypeKind.SignedInt, 8);
    let u8_type = scalar(inout state, model.TypeKind.UnsignedInt, 8);
    let i32_type = scalar(inout state, model.TypeKind.SignedInt, 32);
    let f32_type = scalar(inout state, model.TypeKind.Float, 32);
    let bool_type = scalar(inout state, model.TypeKind.Bool, 0);
    let struct_type = nominal_type(inout state,
        model.TypeKind.NominalStruct, 100);
    let enum_type = nominal_type(inout state, model.TypeKind.NominalEnum, 101);
    let nodes = vec.empty[hir.HirNode]();
    vec.push(nodes, literal_node(i32_type, "42", 42));
    hir_case("hir.integer", state, nodes, [], [], 0);
    let float_nodes = vec.empty[hir.HirNode]();
    vec.push(float_nodes, float_node(f32_type, 2164260864));
    hir_case("hir.float", state, float_nodes, [], [], 0);
    let bool_nodes = vec.empty[hir.HirNode]();
    vec.push(bool_nodes, bool_node(bool_type, true));
    hir_case("hir.bool", state, bool_nodes, [], [], 0);
    let binary_nodes = vec.empty[hir.HirNode]();
    vec.push(binary_nodes, literal_node(i8_type, "127", 127));
    vec.push(binary_nodes, literal_node(i8_type, "1", 1));
    vec.push(binary_nodes, make_node(i8_type, hir.NodeData.Binary(
        value: hir.Binary(op: hir.BinaryOp.Add)), [0, 1]));
    hir_case("hir.binary.wrap", state, binary_nodes, [], [], 2);
    let shift_nodes = vec.empty[hir.HirNode]();
    vec.push(shift_nodes, literal_node(i8_type, "-7", 249));
    vec.push(shift_nodes, literal_node(i8_type, "1", 1));
    vec.push(shift_nodes, make_node(i8_type, hir.NodeData.Binary(
        value: hir.Binary(op: hir.BinaryOp.ShiftRight)), [0, 1]));
    hir_case("hir.binary.shr", state, shift_nodes, [], [], 2);
    let short_nodes = vec.empty[hir.HirNode]();
    vec.push(short_nodes, bool_node(bool_type, false));
    vec.push(short_nodes, bool_node(bool_type, true));
    vec.push(short_nodes, make_node(bool_type, hir.NodeData.ShortCircuit(
        value: hir.ShortCircuit(op: hir.LogicalOp.And)), [0, 1]));
    hir_case("hir.short.and", state, short_nodes, [], [], 2);
    let or_nodes = vec.empty[hir.HirNode]();
    vec.push(or_nodes, bool_node(bool_type, true));
    vec.push(or_nodes, bool_node(bool_type, false));
    vec.push(or_nodes, make_node(bool_type, hir.NodeData.ShortCircuit(
        value: hir.ShortCircuit(op: hir.LogicalOp.Or)), [0, 1]));
    hir_case("hir.short.or", state, or_nodes, [], [], 2);
    let convert_nodes = vec.empty[hir.HirNode]();
    vec.push(convert_nodes, literal_node(i32_type, "200", 200));
    vec.push(convert_nodes, make_node(u8_type, hir.NodeData.IntegerConvert(
        value: hir.IntegerConvert()), [0]));
    hir_case("hir.convert.u8", state, convert_nodes, [], [], 1);
    let convert_bad = vec.empty[hir.HirNode]();
    vec.push(convert_bad, literal_node(i32_type, "256", 256));
    vec.push(convert_bad, make_node(u8_type, hir.NodeData.IntegerConvert(
        value: hir.IntegerConvert()), [0]));
    hir_case("hir.convert.overflow", state, convert_bad, [], [], 1);
    let unary_nodes = vec.empty[hir.HirNode]();
    vec.push(unary_nodes, literal_node(u8_type, "0", 0));
    vec.push(unary_nodes, make_node(u8_type, hir.NodeData.Unary(
        value: hir.Unary(op: hir.UnaryOp.BitNot)), [0]));
    hir_case("hir.unary.not", state, unary_nodes, [], [], 1);
    let float_unary = vec.empty[hir.HirNode]();
    vec.push(float_unary, float_node(f32_type, 1069547520));
    vec.push(float_unary, make_node(f32_type, hir.NodeData.Unary(
        value: hir.Unary(op: hir.UnaryOp.Negate)), [0]));
    hir_case("hir.unary.float", state, float_unary, [], [], 1);
    let struct_nodes = vec.empty[hir.HirNode]();
    vec.push(struct_nodes, literal_node(i32_type, "1", 1));
    vec.push(struct_nodes, literal_node(i32_type, "2", 2));
    let fields = vec.empty[hir.CallArg]();
    vec.push(fields, call_arg(1, 0));
    vec.push(fields, call_arg(0, 1));
    vec.push(struct_nodes, make_node(struct_type, hir.NodeData.StructInit(
        value: hir.StructInit(fields: fields)), [0, 1]));
    hir_case("hir.struct.reorder", state, struct_nodes, [], [], 2);
    let enum_nodes = vec.empty[hir.HirNode]();
    vec.push(enum_nodes, literal_node(i32_type, "3", 3));
    vec.push(enum_nodes, literal_node(i32_type, "4", 4));
    let payload = vec.empty[hir.CallArg]();
    vec.push(payload, call_arg(0, 0));
    vec.push(payload, call_arg(1, 1));
    vec.push(enum_nodes, make_node(enum_type, hir.NodeData.EnumInit(
        value: hir.EnumInit(variant: 9, payload: payload)), [0, 1]));
    hir_case("hir.enum.reorder", state, enum_nodes, [], [], 2);
    let nominals = vec.empty[hir.NominalDecl]();
    let field_list = vec.empty[hir.FieldDecl]();
    vec.push(field_list, hir.FieldDecl(symbol: 200, type_id: i32_type,
        exported: true, source: empty_source(0)));
    vec.push(field_list, hir.FieldDecl(symbol: 201, type_id: i32_type,
        exported: true, source: empty_source(0)));
    vec.push(nominals, hir.NominalDecl(symbol: 100,
        kind: model.TypeKind.NominalStruct, params: [], fields: field_list,
        variants: [], source: empty_source(0)));
    let field_nodes = vec.empty[hir.HirNode]();
    vec.push(field_nodes, literal_node(i32_type, "5", 5));
    vec.push(field_nodes, literal_node(i32_type, "6", 6));
    let field_args = vec.empty[hir.CallArg]();
    vec.push(field_args, call_arg(0, 0));
    vec.push(field_args, call_arg(1, 1));
    vec.push(field_nodes, make_node(struct_type, hir.NodeData.StructInit(
        value: hir.StructInit(fields: field_args)), [0, 1]));
    vec.push(field_nodes, make_node(i32_type, hir.NodeData.FieldRead(
        value: hir.FieldRead(field: 201)), [2]));
    hir_case("hir.field", state, field_nodes, [], nominals, 3);
    let read_nodes = vec.empty[hir.HirNode]();
    vec.push(read_nodes, literal_node(i32_type, "9", 9));
    vec.push(read_nodes, make_node(i32_type, hir.NodeData.Binding(
        value: hir.Binding(symbol: 0, writable: false)), [0]));
    vec.push(read_nodes, make_node(i32_type, hir.NodeData.Read(
        value: hir.Read(symbol: 0)), []));
    let read_symbols = [symbol_constant(0, "c0")];
    hir_case("hir.read", state, read_nodes, read_symbols, [], 2);
    let cycle_nodes = vec.empty[hir.HirNode]();
    vec.push(cycle_nodes, make_node(i32_type, hir.NodeData.Read(
        value: hir.Read(symbol: 1)), []));
    vec.push(cycle_nodes, make_node(i32_type, hir.NodeData.Binding(
        value: hir.Binding(symbol: 1, writable: false)), [0]));
    let cycle_symbols = [symbol_constant(0, "c0"), symbol_constant(1, "c1")];
    hir_case("hir.cycle", state, cycle_nodes, cycle_symbols, [], 0);
    let literal_value = hir.ConstantValue(type_id: i32_type,
        data: hir.ConstantData.IntegerLiteral(
            value: hir.IntegerLiteral(decimal: "77", bits: 77)));
    let literal_constant_nodes = vec.empty[hir.HirNode]();
    vec.push(literal_constant_nodes, make_node(i32_type,
        hir.NodeData.ConstantLiteral(value: hir.ConstantLiteral(
            value: literal_value)), []));
    hir_case("hir.constant_literal", state, literal_constant_nodes, [], [], 0);
    let unsupported = vec.empty[hir.HirNode]();
    vec.push(unsupported, make_node(i32_type, hir.NodeData.Block(
        value: hir.Block()), []));
    hir_case("hir.unsupported", state, unsupported, [], [], 0);
    let depth_nodes = vec.empty[hir.HirNode]();
    vec.push(depth_nodes, literal_node(i32_type, "1", 1));
    for var index usize = 0; index < 129; index += 1 {
        let previous = vec.len(depth_nodes) - 1;
        vec.push(depth_nodes, make_node(i32_type, hir.NodeData.Unary(
            value: hir.Unary(op: hir.UnaryOp.Negate)), [previous]));
    }
    hir_case("hir.depth", state, depth_nodes, [], [],
        vec.len(depth_nodes) - 1);
    let aggregate_expr = vec.empty[hir.HirNode]();
    vec.push(aggregate_expr, literal_node(i32_type, "1", 1));
    let one_field = vec.empty[hir.CallArg]();
    vec.push(one_field, call_arg(0, 0));
    vec.push(aggregate_expr, make_node(struct_type, hir.NodeData.StructInit(
        value: hir.StructInit(fields: one_field)), [0]));
    aggregate_expression_case("agg.struct", state, aggregate_expr, [], 1);
    aggregate_expression_case("agg.literal", state, aggregate_expr, [], 0);
    let read_aggregate = vec.empty[hir.HirNode]();
    vec.push(read_aggregate, aggregate_expr[1]);
    vec.push(read_aggregate, make_node(struct_type, hir.NodeData.Binding(
        value: hir.Binding(symbol: 2, writable: false)), [0]));
    vec.push(read_aggregate, make_node(struct_type, hir.NodeData.Read(
        value: hir.Read(symbol: 2)), []));
    let agg_symbols = [symbol_constant(0, "a0"), symbol_constant(1, "a1"),
        symbol_constant(2, "a2")];
    aggregate_expression_case("agg.read", state, read_aggregate,
        agg_symbols, 2);
    let work_nodes = vec.empty[hir.HirNode]();
    vec.push(work_nodes, literal_node(i32_type, "1", 1));
    let many = vec.empty[hir.CallArg]();
    for var index usize = 0; index < 99999; index += 1 {
        vec.push(many, call_arg(0, 0));
    }
    vec.push(work_nodes, make_node(struct_type, hir.NodeData.StructInit(
        value: hir.StructInit(fields: many)), [0]));
    aggregate_case("hir.work.limit.ok", state, work_nodes, 1);
    let over_nodes = vec.empty[hir.HirNode]();
    vec.push(over_nodes, literal_node(i32_type, "1", 1));
    let too_many = vec.empty[hir.CallArg]();
    for var index usize = 0; index < 100000; index += 1 {
        vec.push(too_many, call_arg(0, 0));
    }
    vec.push(over_nodes, make_node(struct_type, hir.NodeData.StructInit(
        value: hir.StructInit(fields: too_many)), [0]));
    aggregate_case("hir.work.limit.over", state, over_nodes, 1);
}


func function_type(state inout types.Context, parameter usize,
                   result usize) usize {
    let parameters = vec.empty[model.ParameterType]();
    vec.push(parameters, model.ParameterType(
        mode: model.ParamMode.Ordinary, type_id: parameter));
    let value = model.Type(kind: model.TypeKind.Function, bits: 0,
        declaration: 0, binding: 0, parameters: parameters, result: result,
        throws_type: none_type(), type_args: [], c_type: 0);
    try {
        return types.intern(inout state, value);
    } catch error types.Error {
        return 0;
    }
}

func field_decl(symbol usize, type_id usize) hir.FieldDecl {
    return hir.FieldDecl(symbol: symbol, type_id: type_id, exported: true,
        source: empty_source(0));
}

func source_special_tests(state inout types.Context) throws os.Error {
    let i32_type = scalar(inout state, model.TypeKind.SignedInt, 32);
    let string_type = scalar(inout state, model.TypeKind.String, 0);
    let point_type = nominal_type(inout state,
        model.TypeKind.NominalStruct, 300);
    let item_type = nominal_type(inout state,
        model.TypeKind.NominalEnum, 310);
    let holder_type = nominal_type(inout state,
        model.TypeKind.NominalStruct, 400);
    let point_fields = vec.empty[hir.FieldDecl]();
    vec.push(point_fields, field_decl(2, i32_type));
    vec.push(point_fields, field_decl(3, i32_type));
    let point_nominals = vec.empty[hir.NominalDecl]();
    vec.push(point_nominals, hir.NominalDecl(symbol: 300,
        kind: model.TypeKind.NominalStruct, params: [],
        fields: point_fields, variants: [], source: empty_source(0)));
    let point_names = ["Point", "i32", "x", "y"];
    let point_kinds = [model.SymbolKind.Type,
        model.SymbolKind.BuiltinType, model.SymbolKind.Field,
        model.SymbolKind.Field];
    let point_ids = [point_type, i32_type, i32_type, i32_type];
    source_full_case("agg.positional", `package app;
struct Point { x i32; y i32; }
func f() Point { return Point(1, 2); }
`, model.AstKind.Call, point_type, inout state, point_names,
        point_kinds, point_ids, [], point_nominals, function_unused);
    source_full_case("agg.named.reorder", `package app;
struct Point { x i32; y i32; }
func f() Point { return Point(y: 2, x: 1); }
`, model.AstKind.Call, point_type, inout state, point_names,
        point_kinds, point_ids, [], point_nominals, function_unused);
    source_full_case("agg.nested.field", `package app;
struct Point { x i32; y i32; }
func f() Point { return Point(y: Point(x: 3, y: 4).x, x: 5); }
`, model.AstKind.Call, point_type, inout state, point_names,
        point_kinds, point_ids, [], point_nominals, function_unused);
    let alias_source = `package app;
struct Point { x i32; y i32; }
const Origin = Point(x: 1, y: 2);
func f() Point { return Origin; }
`;
    let alias_parsed = parse_source(alias_source);
    let alias_binding = find_kind(alias_parsed, model.AstKind.Binding);
    let alias_names = ["Point", "Origin", "x", "y", "i32"];
    let alias_kinds = [model.SymbolKind.Type, model.SymbolKind.Constant,
        model.SymbolKind.Field, model.SymbolKind.Field,
        model.SymbolKind.BuiltinType];
    let alias_ids = [point_type, point_type, i32_type, i32_type, i32_type];
    let alias_defs = [option.Option[usize].None,
        option.Option[usize].Some(alias_binding),
        option.Option[usize].None, option.Option[usize].None,
        option.Option[usize].None];
    source_full_case("agg.constant.alias", alias_source,
        model.AstKind.Name, point_type, inout state, alias_names,
        alias_kinds, alias_ids, alias_defs, point_nominals, function_unused);
    let field_source = `package app;
struct Point { x i32; y i32; }
const Origin = Point(x: 1, y: 2);
func f() i32 { return Origin.y; }
`;
    source_full_case("agg.constant.field", field_source,
        model.AstKind.Member, i32_type, inout state, alias_names,
        alias_kinds, alias_ids, alias_defs, point_nominals, function_unused);
    let variant = vec.empty[hir.VariantDecl]();
    let payload = vec.empty[hir.FieldDecl]();
    vec.push(payload, field_decl(3, string_type));
    vec.push(variant, hir.VariantDecl(symbol: 2, payload: payload,
        source: empty_source(0)));
    let item_nominals = vec.empty[hir.NominalDecl]();
    vec.push(item_nominals, hir.NominalDecl(symbol: 310,
        kind: model.TypeKind.NominalEnum, params: [], fields: [],
        variants: variant, source: empty_source(0)));
    source_full_case("enum.payload", `package app;
enum Item { Empty; Full(text string); }
func f() Item { return Item.Full(text: "x"); }
`, model.AstKind.Call, item_type, inout state,
        ["Item", "string", "Full", "text"],
        [model.SymbolKind.Type, model.SymbolKind.BuiltinType,
         model.SymbolKind.Variant, model.SymbolKind.Field],
        [item_type, string_type, item_type, string_type], [], item_nominals,
        function_unused);
    let call_type = function_type(inout state, i32_type, i32_type);
    let holder_fields = vec.empty[hir.FieldDecl]();
    vec.push(holder_fields, field_decl(3, call_type));
    let holder_nominals = vec.empty[hir.NominalDecl]();
    vec.push(holder_nominals, hir.NominalDecl(symbol: 400,
        kind: model.TypeKind.NominalStruct, params: [],
        fields: holder_fields, variants: [], source: empty_source(0)));
    let make_function = func(candidate model.NodeRef, expected usize)
                              hir.FunctionValue
                              throws model.SupportError {
        return hir.FunctionValue(symbol: 77, type_args: [],
            captures: [], move_capture: false,
            bound: option.Option[hir.BoundReceiver].None);
    };
    source_full_case("function.field", `package app;
struct Holder { call func(i32) i32; }
func twice(x i32) i32 { return x * 2; }
func f() Holder { return Holder(call: twice); }
`, model.AstKind.Call, holder_type, inout state,
        ["Holder", "twice", "i32", "call"],
        [model.SymbolKind.Type, model.SymbolKind.Function,
         model.SymbolKind.BuiltinType, model.SymbolKind.Field],
        [holder_type, call_type, i32_type, call_type], [], holder_nominals,
        make_function);
    let cycle_source = `package app;
const A = A;
func f() i32 { return A; }
`;
    let cycle_parsed = parse_source(cycle_source);
    let cycle_binding = find_kind(cycle_parsed, model.AstKind.Binding);
    source_full_case("source.cycle", cycle_source, model.AstKind.Name,
        i32_type, inout state, ["A", "i32"],
        [model.SymbolKind.Constant, model.SymbolKind.BuiltinType],
        [i32_type, i32_type],
        [option.Option[usize].Some(cycle_binding),
         option.Option[usize].None], [], function_unused);
    var nested = "1";
    for var index usize = 0; index < 130; index += 1 {
        nested = "(" + nested + ")";
    }
    source_full_case("source.depth", expression(nested),
        model.AstKind.Parenthesized, i32_type, inout state, [], [], [], [],
        [], function_unused);
}




func same_case(label string, left hir.ConstantValue,
               right hir.ConstantValue) throws os.Error {
    var result = "false";
    if constant.same_constant_value(left, right) { result = "true"; }
    io.println(label + "=" + result);
}

func parameterized_type(state inout types.Context, parameter usize,
                        result usize) usize {
    let parameters = vec.empty[model.ParameterType]();
    vec.push(parameters, model.ParameterType(
        mode: model.ParamMode.Ordinary, type_id: parameter));
    let value = model.Type(kind: model.TypeKind.Function, bits: 0,
        declaration: 0, binding: 0, parameters: parameters, result: result,
        throws_type: none_type(), type_args: [], c_type: 0);
    try {
        return types.intern(inout state, value);
    } catch error types.Error {
        return 0;
    }
}

func function_value(symbol usize, args Vec[usize]) hir.ConstantValue {
    return hir.ConstantValue(type_id: 0,
        data: hir.ConstantData.FunctionValue(value: hir.FunctionValue(
            symbol: symbol, type_args: args, captures: [],
            move_capture: false,
            bound: option.Option[hir.BoundReceiver].None)));
}

func aggregate_value(type_id usize, variant option.Option[usize],
                     fields Vec[hir.ConstantValue]) hir.ConstantValue {
    return hir.ConstantValue(type_id: type_id,
        data: hir.ConstantData.ConstantAggregate(
            value: hir.ConstantAggregate(variant: variant, fields: fields)));
}

func same_tests(state inout types.Context) throws os.Error {
    let i32_type = scalar(inout state, model.TypeKind.SignedInt, 32);
    let i8_type = scalar(inout state, model.TypeKind.SignedInt, 8);
    let f32_type = scalar(inout state, model.TypeKind.Float, 32);
    let bool_type = scalar(inout state, model.TypeKind.Bool, 0);
    let string_type = scalar(inout state, model.TypeKind.String, 0);
    let struct_type = nominal_type(inout state,
        model.TypeKind.NominalStruct, 500);
    let int_one = hir.ConstantValue(type_id: i32_type,
        data: hir.ConstantData.IntegerLiteral(
            value: hir.IntegerLiteral(decimal: "1", bits: 1)));
    let int_one_other_bits = hir.ConstantValue(type_id: i32_type,
        data: hir.ConstantData.IntegerLiteral(
            value: hir.IntegerLiteral(decimal: "1", bits: 2)));
    let int_one_i8 = hir.ConstantValue(type_id: i8_type,
        data: hir.ConstantData.IntegerLiteral(
            value: hir.IntegerLiteral(decimal: "1", bits: 1)));
    let float_nan = hir.ConstantValue(type_id: f32_type,
        data: hir.ConstantData.FloatLiteral(
            value: hir.FloatLiteral(bits: 0x7fc00000)));
    let float_nan_same = hir.ConstantValue(type_id: f32_type,
        data: hir.ConstantData.FloatLiteral(
            value: hir.FloatLiteral(bits: 0x7fc00000)));
    let bool_true = hir.ConstantValue(type_id: bool_type,
        data: hir.ConstantData.BoolLiteral(
            value: hir.BoolLiteral(value: true)));
    let string_a = hir.ConstantValue(type_id: string_type,
        data: hir.ConstantData.StringLiteral(
            value: hir.StringLiteral(utf8: "a\u{0}😀")));
    let string_b = hir.ConstantValue(type_id: string_type,
        data: hir.ConstantData.StringLiteral(
            value: hir.StringLiteral(utf8: "a\u{0}😀")));
    same_case("same.int.equal", int_one, int_one);
    same_case("same.int.bits", int_one, int_one_other_bits);
    same_case("same.int.type", int_one, int_one_i8);
    same_case("same.float.nan", float_nan, float_nan_same);
    same_case("same.bool", bool_true, bool_true);
    same_case("same.string", string_a, string_b);
    let function_a = function_value(7, [i32_type]);
    let function_b = function_value(7, [i32_type]);
    let function_c = function_value(8, [i32_type]);
    let function_d = function_value(7, [i8_type]);
    same_case("same.function", function_a, function_b);
    same_case("same.function.symbol", function_a, function_c);
    same_case("same.function.args", function_a, function_d);
    let fields_a = vec.empty[hir.ConstantValue]();
    vec.push(fields_a, int_one);
    vec.push(fields_a, function_a);
    let fields_b = vec.empty[hir.ConstantValue]();
    vec.push(fields_b, int_one);
    vec.push(fields_b, function_a);
    let fields_c = vec.empty[hir.ConstantValue]();
    vec.push(fields_c, function_a);
    vec.push(fields_c, int_one);
    same_case("same.aggregate.equal",
        aggregate_value(struct_type, option.Option[usize].None, fields_a),
        aggregate_value(struct_type, option.Option[usize].None, fields_b));
    same_case("same.aggregate.order",
        aggregate_value(struct_type, option.Option[usize].None, fields_a),
        aggregate_value(struct_type, option.Option[usize].None, fields_c));
    same_case("same.aggregate.variant",
        aggregate_value(struct_type, option.Option[usize].None, fields_a),
        aggregate_value(struct_type, option.Option[usize].Some(3), fields_a));
}

func transform_tests(state inout types.Context) throws os.Error {
    let i32_type = scalar(inout state, model.TypeKind.SignedInt, 32);
    let parameter_type = nominal_type(inout state,
        model.TypeKind.TypeParameter, 42);
    let parameter_function = parameterized_type(inout state,
        parameter_type, i32_type);
    let concrete_function = parameterized_type(inout state,
        i32_type, i32_type);
    let struct_type = nominal_type(inout state,
        model.TypeKind.NominalStruct, 500);
    let substitutions = [model.Substitution(symbol: 42, type_id: i32_type)];
    let function_args = vec.empty[usize]();
    vec.push(function_args, parameter_type);
    var function_constant = function_value(10, function_args);
    function_constant.type_id = parameter_function;
    let change = func(value hir.FunctionValue) hir.FunctionValue
                     throws model.SupportError {
        let captures = vec.empty[hir.CaptureSource]();
        vec.push(captures, hir.CaptureSource(origin: 3, source: 4,
            type_id: 5, is_move: false));
        return hir.FunctionValue(symbol: value.symbol + 1,
            type_args: value.type_args, captures: captures,
            move_capture: true,
            bound: option.Option[hir.BoundReceiver].Some(
                hir.BoundReceiver(type_id: i32_type,
                    mode: model.ParamMode.Inout)));
    };
    try {
        constant.transform_constant(inout function_constant, substitutions,
            inout state, change);
        print_constant("transform.function", state, function_constant);
    } catch error model.SupportError {
        io.println("transform.function=error");
    }
    let fields = vec.empty[hir.ConstantValue]();
    let nested_args = vec.empty[usize]();
    vec.push(nested_args, parameter_type);
    var nested_function = function_value(20, nested_args);
    nested_function.type_id = parameter_function;
    vec.push(fields, nested_function);
    vec.push(fields, hir.ConstantValue(type_id: i32_type,
        data: hir.ConstantData.IntegerLiteral(
            value: hir.IntegerLiteral(decimal: "9", bits: 9))));
    var aggregate = aggregate_value(struct_type,
        option.Option[usize].None, fields);
    try {
        constant.transform_constant(inout aggregate, substitutions,
            inout state, change);
        print_constant("transform.aggregate", state, aggregate);
    } catch error model.SupportError {
        io.println("transform.aggregate=error");
    }
}

func main() i32 throws os.Error {
    var state = types.context();
    literal_tests(inout state);
    source_tests(inout state);
    source_special_tests(inout state);
    hir_tests(inout state);
    same_tests(inout state);
    transform_tests(inout state);
    return 0;
}