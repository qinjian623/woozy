// Two-direction isolation probes for hirclone.clone_module.
//
// Each id names one Vec-bearing field.  The probe clones the fixture twice,
// mutates that field in the left clone, and checks that (a) the left
// fingerprint moved and (b) the right clone did not move; it then mutates the
// right clone and repeats in the other direction.  A field that kept a shared
// Vec would fail one of the two isolation checks.
//
// Fields marked wz_only have no mutable C++ counterpart (a C++ SourceSnapshot
// is immutable and ParseResult diagnostics live outside the C++ module); the
// C++ oracle prints cpp=none for those names and they are reported as
// not compared instead of being silently dropped.
package app;

import "app/wzcc/hir" as hir;
import "app/wzcc/hirclone" as hirclone;
import "app/wzcc/model" as model;
import "app/wzcc/types" as types;
import "std/io" as io;
import "std/os" as os;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;


pub struct ProbeResult {
    pub name string;
    pub wz_only bool;
    pub left_changed bool;
    pub right_isolated bool;
    pub reverse_changed bool;
    pub reverse_isolated bool;
}

func flag(value bool) string {
    if value {
        return "1";
    }
    return "0";
}

func is_wz_only(id u32) bool {
    switch id {
        case 0: return true;
        case 9: return true;
        case 10: return true;
        case 11: return true;
        case 12: return true;
        case 15: return true;
        case 16: return true;
        case 17: return true;
        case 18: return true;
        case 21: return true;
        case 22: return true;
        case 119: return true;
        case 120: return true;
        case 121: return true;
        case 122: return true;
        default: return false;
    }
}

func grow(module inout hir.HirModule, value model.Type) {
    var ok = true;
    let ignored = intern(inout module.types, value, inout ok);
}

func mutate(module inout hir.HirModule, id u32) {
    let span = module.resolved.project.files[0].nodes[0].span;
    if id == 0 {
        vec.push(module.resolved.project.files,
            module.resolved.project.files[0]);
    } else if id == 1 {
        vec.push(module.resolved.project.modules,
            module.resolved.project.modules[0]);
    } else if id == 2 {
        vec.push(module.resolved.project.bindings,
            module.resolved.project.bindings[0]);
    } else if id == 3 {
        vec.push(module.resolved.project.foreign_bindings,
            module.resolved.project.foreign_bindings[0]);
    } else if id == 4 {
        vec.push(module.resolved.project.c_bindings,
            module.resolved.project.c_bindings[0]);
    } else if id == 5 {
        vec.push(module.resolved.project.c_types,
            module.resolved.project.c_types[0]);
    } else if id == 6 {
        vec.push(module.resolved.project.c_callables,
            module.resolved.project.c_callables[0]);
    } else if id == 7 {
        vec.push(module.resolved.project.c_libraries, "mut");
    } else if id == 8 {
        vec.push(module.resolved.project.c_library_dirs, "/mut");
    } else if id == 9 {
        vec.push(module.resolved.project.files[0].lexed.source.original, 0x41);
    } else if id == 10 {
        vec.push(module.resolved.project.files[0].lexed.source.normalized, 0x41);
    } else if id == 11 {
        vec.push(module.resolved.project.files[0].lexed.source.offsets, 0);
    } else if id == 12 {
        vec.push(module.resolved.project.files[0].lexed.source.boundaries,
            module.resolved.project.files[0].lexed.source.boundaries[0]);
    } else if id == 13 {
        vec.push(module.resolved.project.files[0].lexed.tokens,
            module.resolved.project.files[0].lexed.tokens[0]);
    } else if id == 14 {
        vec.push(module.resolved.project.files[0].lexed.tokens[0]
            .leading_trivia, model.Trivia(kind: model.TriviaKind.LineComment,
                span: span, spelling: "//mut"));
    } else if id == 15 {
        vec.push(module.resolved.project.files[0].lexed.diagnostics,
            synthetic_diagnostic(span));
    } else if id == 16 {
        vec.push(module.resolved.project.files[0].lexed.diagnostics[0].related,
            model.Related(span: span, message: "mut"));
    } else if id == 17 {
        vec.push(module.resolved.project.files[0].lexed.diagnostics[0].fixits,
            model.Fixit(span: span, replacement: "mut", revision: 9));
    } else if id == 18 {
        vec.push(module.resolved.project.files[0].lexed.diagnostics[0].notes,
            "mut");
    } else if id == 19 {
        vec.push(module.resolved.project.files[0].nodes,
            module.resolved.project.files[0].nodes[0]);
    } else if id == 20 {
        vec.push(module.resolved.project.files[0].nodes[0].children, 0);
    } else if id == 21 {
        vec.push(module.resolved.project.files[0].diagnostics,
            synthetic_diagnostic(span));
    } else if id == 22 {
        vec.push(module.resolved.project.files[0].diagnostics[0].related,
            model.Related(span: span, message: "mut"));
    } else if id == 23 {
        vec.push(module.resolved.project.modules[0].files, 0);
    } else if id == 24 {
        vec.push(module.resolved.project.modules[0].imports,
            module.resolved.project.modules[0].imports[0]);
    } else if id == 25 {
        vec.push(module.resolved.project.modules[0].foreign_exports,
            module.resolved.project.modules[0].foreign_exports[0]);
    } else if id == 26 {
        vec.push(module.resolved.project.modules[0].foreign_exports[0]
            .candidates, 2);
    } else if id == 27 {
        switch module.resolved.project.modules[0].foreign_exports[0]
            .c_type_ref {
            case option.Option.Some(item):
                vec.push(item.args, item.args[0]);
            case option.Option.None:
                vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 28 {
        vec.push(module.resolved.project.bindings[0].allowed_backends, "mut");
    } else if id == 29 {
        vec.push(module.resolved.project.bindings[0].package_requirements,
            module.resolved.project.bindings[0].package_requirements[0]);
    } else if id == 30 {
        vec.push(module.resolved.project.bindings[0].modules,
            module.resolved.project.bindings[0].modules[0]);
    } else if id == 31 {
        vec.push(module.resolved.project.bindings[0].declarations, 9);
    } else if id == 32 {
        vec.push(module.resolved.project.bindings[0].conformance_required,
            "mut");
    } else if id == 33 {
        vec.push(module.resolved.project.foreign_bindings[0].host_attribute,
            "mut");
    } else if id == 34 {
        switch module.resolved.project.foreign_bindings[0].detail {
            case model.ForeignDetail.Type(payload): vec.push(payload.members, 9);
            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 35 {
