            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 36 {
        switch module.resolved.project.foreign_bindings[0].detail {
            case model.ForeignDetail.Type(payload):
                vec.push(payload.indexers, 9);
            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 37 {
        switch module.resolved.project.foreign_bindings[0].detail {
            case model.ForeignDetail.Type(payload):
                vec.push(payload.slices, 9);
            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 38 {
        switch module.resolved.project.foreign_bindings[2].detail {
            case model.ForeignDetail.Callable(payload):
                vec.push(payload.parameters, payload.parameters[0]);
            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 39 {
        switch module.resolved.project.foreign_bindings[2].detail {
