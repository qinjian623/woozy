        vec.push(module.scopes, module.scopes[0]);
    } else if id == 88 {
        vec.push(module.nominals, module.nominals[0]);
    } else if id == 89 {
        vec.push(module.nominals[0].params, module.nominals[0].params[0]);
    } else if id == 90 {
        switch module.nominals[0].params[0].trait_ref {
            case option.Option.Some(item):
                vec.push(item.args, item.args[0]);
            case option.Option.None:
                vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 91 {
        vec.push(module.nominals[0].fields, module.nominals[0].fields[0]);
    } else if id == 92 {
        vec.push(module.nominals[0].variants,
            module.nominals[0].variants[0]);
    } else if id == 93 {
        vec.push(module.nominals[0].variants[0].payload,
            module.nominals[0].variants[0].payload[0]);
    } else if id == 94 {
        vec.push(module.traits, module.traits[0]);
    } else if id == 95 {
        vec.push(module.traits[0].params, module.traits[0].params[0]);
    } else if id == 96 {
        vec.push(module.traits[0].methods, module.traits[0].methods[0]);
    } else if id == 97 {
        vec.push(module.traits[0].methods[0].parameters,
            module.traits[0].methods[0].parameters[0]);
    } else if id == 98 {
        vec.push(module.impls, module.impls[0]);
    } else if id == 99 {
        vec.push(module.impls[0].params, module.impls[0].params[0]);
    } else if id == 100 {
        switch module.impls[0].trait_ref {
            case option.Option.Some(item):
                vec.push(item.args, item.args[0]);
            case option.Option.None:
                vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 101 {
        vec.push(module.impls[0].methods, 9);
    } else if id == 102 {
        vec.push(module.templates, module.templates[0]);
    } else if id == 103 {
        vec.push(module.templates[0].function.parameters,
            module.templates[0].function.parameters[0]);
    } else if id == 104 {
        vec.push(module.templates[0].function.captures,
            module.templates[0].function.captures[0]);
    } else if id == 105 {
        vec.push(module.templates[0].params, module.templates[0].params[0]);
    } else if id == 106 {
        vec.push(module.instances, module.instances[0]);
    } else if id == 107 {
        vec.push(module.instances[0].type_args,
            module.instances[0].type_args[0]);
    } else if id == 108 {
        vec.push(module.instances[0].renamed,
            module.instances[0].renamed[0]);
    } else if id == 109 {
        vec.push(module.ownership.uses, module.ownership.uses[0]);
    } else if id == 110 {
        vec.push(module.ownership.temporaries,
            module.ownership.temporaries[0]);
    } else if id == 111 {
        vec.push(module.ownership.locals, module.ownership.locals[0]);
    } else if id == 112 {
        vec.push(module.ownership.full_expressions,
            module.ownership.full_expressions[0]);
    } else if id == 113 {
        vec.push(module.ownership.full_expressions[0].actions,
            module.ownership.full_expressions[0].actions[0]);
    } else if id == 114 {
        vec.push(module.ownership.calls, module.ownership.calls[0]);
    } else if id == 115 {
        vec.push(module.ownership.calls[0].on_return,
            module.ownership.calls[0].on_return[0]);
    } else if id == 116 {
        vec.push(module.foreign_bindings, module.foreign_bindings[0]);
    } else if id == 117 {
        switch module.nodes[40].data {
            case hir.NodeData.ConstantLiteral(payload):
                switch payload.value.data {
                    case hir.ConstantData.ConstantAggregate(aggregate):
                        switch aggregate.fields[2].data {
                            case hir.ConstantData.FunctionValue(function):
                                vec.push(function.captures,
                                    function.captures[0]);
                            default: vec.push(module.resolved.project
                                .c_libraries, "none");
                        }
                    default: vec.push(module.resolved.project.c_libraries,
                        "none");
                }
            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else if id == 118 {
        switch module.nodes[40].data {
            case hir.NodeData.ConstantLiteral(payload):
                switch payload.value.data {
                    case hir.ConstantData.ConstantAggregate(aggregate):
                        switch aggregate.fields[2].data {
                            case hir.ConstantData.FunctionValue(function):
                                vec.push(function.type_args,
                                    function.type_args[0]);
                            default: vec.push(module.resolved.project
                                .c_libraries, "none");
                        }
                    default: vec.push(module.resolved.project.c_libraries,
                        "none");
                }
            default: vec.push(module.resolved.project.c_libraries, "none");
        }
    } else {
        vec.push(module.resolved.project.c_libraries, "unknown");
    }
}

func probe(module hir.HirModule, id u32, name string) ProbeResult {
    var left = module;
    var right = module;
    var cloned = true;
    try {
        left = hirclone.clone_module(module);
        right = hirclone.clone_module(module);
    } catch raised model.SupportError {
        cloned = false;
    }
    if !cloned {
        return failed_probe(name, is_wz_only(id));
    }
    let left_before = fingerprint(left);
    let right_before = fingerprint(right);
    mutate(inout left, id);
    let left_changed = fingerprint(left) != left_before;
    let right_isolated = fingerprint(right) == right_before;
    let left_after = fingerprint(left);
    mutate(inout right, id);
    let reverse_changed = fingerprint(right) != right_before;
    let reverse_isolated = fingerprint(left) == left_after;
    return ProbeResult(name: name, wz_only: is_wz_only(id),
        left_changed: left_changed, right_isolated: right_isolated,
        reverse_changed: reverse_changed,
        reverse_isolated: reverse_isolated);
}

func report(result ProbeResult) i32 throws os.Error {
    let line = text.join(["PROBE", result.name,
        "wz_only=" + flag(result.wz_only),
        "left_changed=" + flag(result.left_changed),
        "right_isolated=" + flag(result.right_isolated),
        "reverse_changed=" + flag(result.reverse_changed),
        "reverse_isolated=" + flag(result.reverse_isolated)], " ");
    io.println(line);
    if !result.left_changed || !result.right_isolated ||
       !result.reverse_changed || !result.reverse_isolated {
        return 1;
    }
    return 0;
}

func one(module hir.HirModule, id u32, name string) i32 throws os.Error {
    return report(probe(module, id, name));
}

// The four narrow entry points clone one record.  Their probes mirror the
// module probes: clone twice, mutate a Vec in one copy, and require both copies
// to stay isolated; the pre-mutation fingerprints also prove value fidelity.
func switch_pattern(module hir.HirModule) hir.Pattern {
    var value = hir.Pattern(type_id: 0,
        source: hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: 0),
            span: model.Span(snapshot: 0, begin_byte: 0, end_byte: 0)),
        variant: option.Option[usize].None,
        binding: option.Option[usize].None,
        payload: vec.empty[hir.Pattern](),
        literal: option.Option[hir.PatternLiteral].None);
    switch module.nodes[28].data {
        case hir.NodeData.Switch(payload):
            value = payload.arms[0].pattern;
        default:
    }
    return value;
}

func constant_value(module hir.HirModule) hir.ConstantValue {
    var value = hir.ConstantValue(type_id: 0,
        data: hir.ConstantData.UnitLiteral(value: hir.UnitLiteral()));
    switch module.nodes[40].data {
        case hir.NodeData.ConstantLiteral(payload):
            value = payload.value;
        default:
    }
    return value;
}

func failed_probe(name string, wz_only bool) ProbeResult {
    return ProbeResult(name: name, wz_only: wz_only, left_changed: false,
        right_isolated: false, reverse_changed: false,
        reverse_isolated: false);
}

func probe_clone_node(module hir.HirModule) ProbeResult {
    let name = "entry.clone_node";
    let original = module.nodes[28];
    let base = fp_hir_node(0, original);
    var left = original;
    var right = original;
    var cloned = true;
    try {
        left = hirclone.clone_node(original);
        right = hirclone.clone_node(original);
    } catch raised model.SupportError {
        cloned = false;
    }
    if !cloned || fp_hir_node(0, left) != base ||
       fp_hir_node(0, right) != base {
        return failed_probe(name, true);
    }
    let left_before = fp_hir_node(0, left);
    let right_before = fp_hir_node(0, right);
    switch left.data {
        case hir.NodeData.Switch(payload):
            vec.push(payload.arms, payload.arms[0]);
        default:
            vec.push(left.children, 0);
    }
    let left_changed = fp_hir_node(0, left) != left_before;
    let right_isolated = fp_hir_node(0, right) == right_before;
    let left_after = fp_hir_node(0, left);
    switch right.data {
        case hir.NodeData.Switch(payload):
            vec.push(payload.arms, payload.arms[0]);
        default:
            vec.push(right.children, 0);
    }
    return ProbeResult(name: name, wz_only: true,
        left_changed: left_changed, right_isolated: right_isolated,
        reverse_changed: fp_hir_node(0, right) != right_before,
        reverse_isolated: fp_hir_node(0, left) == left_after);
}

func probe_clone_function(module hir.HirModule) ProbeResult {
    let name = "entry.clone_function";
    let original = module.functions[0];
    let base = fp_hir_function(0, original);
    var left = original;
    var right = original;
    var cloned = true;
    try {
        left = hirclone.clone_function(original);
        right = hirclone.clone_function(original);
    } catch raised model.SupportError {
        cloned = false;
    }
    if !cloned || fp_hir_function(0, left) != base ||
       fp_hir_function(0, right) != base {
        return failed_probe(name, true);
    }
    let left_before = fp_hir_function(0, left);
    let right_before = fp_hir_function(0, right);
    vec.push(left.parameters, left.parameters[0]);
    let left_changed = fp_hir_function(0, left) != left_before;
    let right_isolated = fp_hir_function(0, right) == right_before;
    let left_after = fp_hir_function(0, left);
    vec.push(right.parameters, right.parameters[0]);
    return ProbeResult(name: name, wz_only: true,
        left_changed: left_changed, right_isolated: right_isolated,
        reverse_changed: fp_hir_function(0, right) != right_before,
        reverse_isolated: fp_hir_function(0, left) == left_after);
}

func probe_clone_pattern(module hir.HirModule) ProbeResult {
    let name = "entry.clone_pattern";
    let original = switch_pattern(module);
    let base = fp_pattern(0, original);
    var left = original;
    var right = original;
    var cloned = true;
    try {
        left = hirclone.clone_pattern(original);
        right = hirclone.clone_pattern(original);
    } catch raised model.SupportError {
        cloned = false;
    }
    if !cloned || fp_pattern(0, left) != base ||
       fp_pattern(0, right) != base {
        return failed_probe(name, true);
    }
    let left_before = fp_pattern(0, left);
    let right_before = fp_pattern(0, right);
    vec.push(left.payload, left.payload[0]);
    let left_changed = fp_pattern(0, left) != left_before;
    let right_isolated = fp_pattern(0, right) == right_before;
    let left_after = fp_pattern(0, left);
    vec.push(right.payload, right.payload[0]);
    return ProbeResult(name: name, wz_only: true,
        left_changed: left_changed, right_isolated: right_isolated,
        reverse_changed: fp_pattern(0, right) != right_before,
        reverse_isolated: fp_pattern(0, left) == left_after);
}

func probe_clone_constant(module hir.HirModule) ProbeResult {
    let name = "entry.clone_constant";
    let original = constant_value(module);
    let base = fp_constant_value(0, original);
    var left = original;
    var right = original;
    var cloned = true;
    try {
        left = hirclone.clone_constant(original);
        right = hirclone.clone_constant(original);
    } catch raised model.SupportError {
        cloned = false;
    }
    if !cloned || fp_constant_value(0, left) != base ||
       fp_constant_value(0, right) != base {
        return failed_probe(name, true);
    }
    let left_before = fp_constant_value(0, left);
    let right_before = fp_constant_value(0, right);
    switch left.data {
        case hir.ConstantData.ConstantAggregate(payload):
            vec.push(payload.fields, payload.fields[0]);
        default:
    }
    let left_changed = fp_constant_value(0, left) != left_before;
    let right_isolated = fp_constant_value(0, right) == right_before;
    let left_after = fp_constant_value(0, left);
    switch right.data {
        case hir.ConstantData.ConstantAggregate(payload):
            vec.push(payload.fields, payload.fields[0]);
        default:
    }
    return ProbeResult(name: name, wz_only: true,
        left_changed: left_changed, right_isolated: right_isolated,
        reverse_changed: fp_constant_value(0, right) != right_before,
        reverse_isolated: fp_constant_value(0, left) == left_after);
}

