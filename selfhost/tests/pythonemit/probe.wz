// Test-only probe for the pure text/identity half of the Python emitter.
//
// This file is copied into the temporary project's pythonemit package by
// run.py.  It exercises only api.wz/writer.wz helpers, which do not depend on
// the shared valueops classifier or the verifier gate, so no stubbed or
// fabricated verified module is involved.  Expected values live in run.py and
// follow the C++ emitter's exact spelling rules.
package pythonemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/system" as system;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

func span_of(snapshot u64, begin u64, end u64) model.Span {
    return model.Span(snapshot: snapshot, begin_byte: begin, end_byte: end);
}

func span_text(value model.Span) string {
    return u64_text(value.snapshot) + ":" + u64_text(value.begin_byte) + "-" +
        u64_text(value.end_byte);
}

func failure_text(error Failure) string {
    switch error {
        case Failure.Rejected(message, has_source, source, reason):
            var location = "-";
            if has_source {
                location = span_text(source);
            }
            return "rejected|" + u32_text(reject_reason_id(reason)) + "|" +
                message + "|" + location;
        case Failure.Internal(message):
            return "internal|" + message;
    }
}

func record_error(out inout Vec[string], name string, error Failure) {
    vec.push(out, name + "=" + failure_text(error));
}

func symbol(id usize, name string, kind model.SymbolKind,
            module usize) model.Symbol {
    return model.Symbol(id: id, name: name, kind: kind, module: module,
        definition: option.Option[model.NodeRef].Some(
            model.NodeRef(module: module, file: 0, node: 0)),
        declaration: option.Option[model.Span].None, exported: true,
        target: option.Option[usize].None,
        foreign: option.Option[model.ForeignExportRef].None);
}

func empty_module(id usize, path string) model.Module {
    return model.Module(id: id, logical_path: path, identity: path,
        package_name: "p", files: [], imports: [], foreign_exports: [],
        binding: option.Option[model.BindingModuleRef].None,
        c_binding: option.Option[usize].None);
}

func intern_type(state inout types.Context,
                 value model.Type) usize throws model.SupportError {
    try {
        return types.intern(inout state, value);
    } catch error types.Error {
        var message = "";
        switch error {
            case types.Error.Invalid(text_value): message = text_value;
        }
        throw model.SupportError.Invalid(message);
    }
}

struct Fixture {
    module hir.HirModule;
    unit usize;
    boolean usize;
    string_type usize;
    isize usize;
    usize_type usize;
    i8_type usize;
    u32_type usize;
    f32_type usize;
    f64_type usize;
    nominal usize;
    generic_nominal usize;
    vec_i8 usize;
    slice_vec_i8 usize;
    function_type usize;
    trait_object usize;
    module_read usize;
    module_error usize;
    module_bad_error usize;
    weak_i8 usize;
    option_i8 usize;
    box_param usize;
    param usize;
}

func type_with(kind model.TypeKind) model.Type {
    return model.empty_type(kind);
}

func build_fixture() Fixture throws model.SupportError {
    var context = types.context();
    let unit = intern_type(inout context, type_with(model.TypeKind.Unit));
    let boolean = intern_type(inout context, type_with(model.TypeKind.Bool));
    let string_type = intern_type(inout context,
        type_with(model.TypeKind.String));
    let isize_value = intern_type(inout context,
        type_with(model.TypeKind.Isize));
    let usize_value = intern_type(inout context,
        type_with(model.TypeKind.Usize));
    var i8_value = type_with(model.TypeKind.SignedInt);
    i8_value.bits = 8;
    let i8_type = intern_type(inout context, i8_value);
    var u32_value = type_with(model.TypeKind.UnsignedInt);
    u32_value.bits = 32;
    let u32_type = intern_type(inout context, u32_value);
    var f32_value = type_with(model.TypeKind.Float);
    f32_value.bits = 32;
    let f32_type = intern_type(inout context, f32_value);
    var f64_value = type_with(model.TypeKind.Float);
    f64_value.bits = 64;
    let f64_type = intern_type(inout context, f64_value);
    var nominal_value = type_with(model.TypeKind.NominalStruct);
    nominal_value.declaration = 0;
    let nominal = intern_type(inout context, nominal_value);
    var generic_value = type_with(model.TypeKind.NominalStruct);
    generic_value.declaration = 0;
    generic_value.type_args = [i8_type];
    let generic_nominal = intern_type(inout context, generic_value);
    var vec_value = type_with(model.TypeKind.Vec);
    vec_value.type_args = [i8_type];
    let vec_i8 = intern_type(inout context, vec_value);
    var slice_value = type_with(model.TypeKind.Slice);
    slice_value.type_args = [vec_i8];
    let slice_vec_i8 = intern_type(inout context, slice_value);
    var function_value = type_with(model.TypeKind.Function);
    function_value.parameters = [
        model.ParameterType(mode: model.ParamMode.Inout, type_id: i8_type),
        model.ParameterType(mode: model.ParamMode.Move, type_id: u32_type)];
    function_value.result = f32_type;
    function_value.throws_type = option.Option[usize].Some(string_type);
    let function_type = intern_type(inout context, function_value);
    var trait_value = type_with(model.TypeKind.TraitObject);
    trait_value.declaration = 1;
    trait_value.type_args = [boolean];
    let trait_object = intern_type(inout context, trait_value);
    var read_value = type_with(model.TypeKind.ForeignOpaque);
    read_value.binding = 0;
    let module_read = intern_type(inout context, read_value);
    var error_value = type_with(model.TypeKind.ForeignOpaque);
    error_value.binding = 1;
    let module_error = intern_type(inout context, error_value);
    var bad_error_value = type_with(model.TypeKind.ForeignOpaque);
    bad_error_value.binding = 2;
    let module_bad_error = intern_type(inout context, bad_error_value);
    var weak_value = type_with(model.TypeKind.Weak);
    weak_value.type_args = [i8_type];
    let weak_i8 = intern_type(inout context, weak_value);
    var option_value = type_with(model.TypeKind.NominalEnum);
    option_value.declaration = 5;
    option_value.type_args = [i8_type];
    let option_i8 = intern_type(inout context, option_value);
    var param_value = type_with(model.TypeKind.TypeParameter);
    param_value.declaration = 3;
    let param = intern_type(inout context, param_value);
    var vec_param_value = type_with(model.TypeKind.Vec);
    vec_param_value.type_args = [param];
    let vec_param = intern_type(inout context, vec_param_value);
    var box_value = type_with(model.TypeKind.NominalStruct);
    box_value.declaration = 2;
    box_value.type_args = [param];
    let box_param = intern_type(inout context, box_value);

    var project = model.empty_project();
    project.root = "test";
    project.package_name = "p";
    project.backend = "python";
    project.word_bits = 64;
    project.entry = 0;
    project.modules = [empty_module(0, "app/pkg"),
        empty_module(1, "std/traits"), empty_module(2, "std/box")];
    project.bindings = [model.BindingBundle(path: "bindings/x.json",
        json: "{}", sha256: "abc", source: span_of(1, 1, 2), schema_version: 1,
        contract: "python-binding/1", review_status: "reviewed",
        allowed_backends: ["python", "native"],
        package_requirements: [model.PackageRequirement(
            package_name: "numpy", version_policy: "^2",
            source: span_of(1, 1, 2))],
        modules: [model.BindingModule(logical_path: "std/np",
            host_module: "numpy", provider: "pypi", source: span_of(1, 1, 2))],
        declarations: [], conformance_required: [])];
    project.foreign_bindings = [
        model.ForeignDeclaration(id: 0, bundle: 0, source: span_of(1, 3, 4),
            json_pointer: "/0", identity: "host.Thing", module: "std/np",
            name: "Thing", host_attribute: ["attr"],
            detail: model.ForeignDetail.Type(value: model.BindingType(
                kind: "host_reference", copy: "share", members: [],
                properties: [], indexers: [], slices: [])),
            stable_identity: "host.Thing"),
        model.ForeignDeclaration(id: 1, bundle: 0, source: span_of(1, 5, 9),
            json_pointer: "/1", identity: "py.Error", module: "std/np",
            name: "Error", host_attribute: ["attr"],
            detail: model.ForeignDetail.Type(value: model.BindingType(
                kind: "runtime_error", copy: "share", members: [],
                properties: [], indexers: [], slices: [])),
            stable_identity: "py.Error"),
        model.ForeignDeclaration(id: 2, bundle: 0, source: span_of(1, 5, 9),
            json_pointer: "/2", identity: "host.Bad", module: "std/np",
            name: "Bad", host_attribute: ["attr"],
            detail: model.ForeignDetail.Type(value: model.BindingType(
                kind: "host_reference", copy: "share", members: [],
                properties: [], indexers: [], slices: [])),
            stable_identity: "host.Bad")];
    project.files = [model.ParseResult(state: model.PhaseState.Complete,
        failure: model.FailureKind.Source,
        lexed: model.LexResult(state: model.PhaseState.Complete,
            failure: model.FailureKind.Source,
            source: model.Source(file_id: 1, revision_id: 1, id: 1,
                path: "src/main.wz", original: [], normalized: [], offsets: [],
                boundaries: [], valid: true, error_byte: 0, error_length: 0,
                error_message: ""),
            tokens: [], diagnostics: [], has_value: true),
        nodes: [], root: 0, recovered: false, diagnostics: [],
        has_value: true)];
    var modules = vec.empty[model.Module]();
    vec.push(modules, empty_module(0, "app/pkg"));
    vec.push(modules, empty_module(1, "std/traits"));
    vec.push(modules, empty_module(2, "std/box"));
    modules[0].files = [0];
    project.modules = modules;
    var resolved = model.ResolvedProject(project: project, symbols: [],
        occurrences: [], deferred_members: [], self_parameters: []);
    resolved.symbols = [
        symbol(0, "Thing", model.SymbolKind.Type, 0),
        symbol(1, "Show", model.SymbolKind.Trait, 1),
        symbol(2, "Box", model.SymbolKind.Type, 2),
        symbol(3, "T", model.SymbolKind.TypeParameter, 0),
        symbol(4, "cell", model.SymbolKind.Field, 2),
        symbol(5, "Option", model.SymbolKind.Type, 0)];
    var module = hir.empty_module(resolved, 0,
        model.CheckConfig(backend: model.Backend.Python, word_bits: 64));
    module.types = context;
    module.nominals = [hir.NominalDecl(symbol: 2,
        kind: model.TypeKind.NominalStruct,
        params: [hir.GenericParam(symbol: 3,
            trait_ref: option.Option[hir.TraitRef].None,
            source: hir.HirSource(node: model.NodeRef(module: 2, file: 0,
                node: 0), span: span_of(1, 1, 2)))],
        fields: [hir.FieldDecl(symbol: 4, type_id: vec_param, exported: false,
            source: hir.HirSource(node: model.NodeRef(module: 2, file: 0,
                node: 1), span: span_of(1, 1, 2)))],
        variants: [], source: hir.HirSource(node: model.NodeRef(module: 2,
