package app;

// Pretokenized parser tests.  These build model.LexResult values by hand so
// the parser is exercised without depending on the stage-1 lexer package.
import "app/wzcc/model" as model;
import "app/wzcc/parser" as parser;
import "std/io" as io;
import "std/os" as os;
import "std/text" as text;
import "std/vec" as vec;

const AST_BINDING u32 = 3;
const AST_FUNCTION u32 = 4;
const AST_STRUCT u32 = 5;
const AST_ENUM u32 = 6;
const AST_TRAIT u32 = 7;
const AST_IMPL u32 = 8;
const AST_GENERIC_PARAMETER u32 = 11;
const AST_PARAMETER u32 = 12;
const AST_ASYNC u32 = 13;
const AST_AWAIT u32 = 14;
const AST_NAMED_TYPE u32 = 15;
const AST_FUNCTION_TYPE u32 = 16;
const AST_PARENTHESIZED_TYPE u32 = 17;
const AST_BLOCK u32 = 18;
const AST_EXPRESSION_STATEMENT u32 = 19;
const AST_ASSIGN u32 = 20;
const AST_IF u32 = 21;
const AST_FOR u32 = 22;
const AST_FORIN u32 = 23;
const AST_SWITCH u32 = 24;
const AST_CASE u32 = 25;
const AST_TRY u32 = 26;
const AST_CATCH u32 = 27;
const AST_DEFER u32 = 28;
const AST_UNSAFE u32 = 29;
const AST_RETURN u32 = 30;
const AST_THROW u32 = 31;
const AST_BREAK u32 = 32;
const AST_CONTINUE u32 = 33;
const AST_UNARY u32 = 36;
const AST_BINARY u32 = 37;
const AST_CALL u32 = 38;
const AST_ARGUMENT u32 = 39;
const AST_MEMBER u32 = 40;
const AST_NEUTRAL_BRACKET u32 = 41;
const AST_BRACKET_ITEM u32 = 42;
const AST_SLICE u32 = 43;
const AST_LIST u32 = 44;
const AST_FUNCTION_LITERAL u32 = 45;
const AST_BIND_PATTERN u32 = 47;
const AST_LITERAL_PATTERN u32 = 48;
const AST_VARIANT_PATTERN u32 = 49;
const AST_ERROR u32 = 50;
const AST_TRAIT_OBJECT_TYPE u32 = 51;

struct Builder {
    tokens Vec[model.Token];
    offset u64;
}

struct Test {
    checks usize;
    failures usize;
    failed Vec[string];
}

func builder() Builder {
    return Builder(tokens: vec.empty[model.Token](), offset: 0);
}

func push(b inout Builder, spelling string, kind model.TokenKind) usize {
    let begin = b.offset;
    let length = u64(text.byte_len(spelling));
    b.offset += length;
    let index = vec.len(b.tokens);
    vec.push(b.tokens, model.Token(kind: kind,
        span: model.Span(snapshot: 1, begin_byte: begin,
                         end_byte: begin + length),
        spelling: spelling, leading_trivia: vec.empty[model.Trivia](),
        has_string_value: false, string_value: ""));
    return index;
}

func kw(b inout Builder, spelling string) usize {
    return push(inout b, spelling, model.TokenKind.Keyword);
}

func name(b inout Builder, spelling string) usize {
    return push(inout b, spelling, model.TokenKind.Identifier);
}

func punctuation(b inout Builder, spelling string) usize {
    return push(inout b, spelling, model.TokenKind.Punctuation);
}

func integer(b inout Builder, spelling string) usize {
    return push(inout b, spelling, model.TokenKind.Integer);
}

func floating(b inout Builder, spelling string) usize {
    return push(inout b, spelling, model.TokenKind.Floating);
}

func string_literal(b inout Builder, spelling string) usize {
    return push(inout b, spelling, model.TokenKind.StringLiteral);
}

func finish_tokens(b inout Builder) usize {
    return push(inout b, "", model.TokenKind.End);
}

func source() model.Source {
    return model.Source(file_id: 1, revision_id: 1, id: 1, path: "parser-test",
        original: [], normalized: [], offsets: [], boundaries: [], valid: true,
        error_byte: 0, error_length: 0, error_message: "");
}

func invalid_source() model.Source {
    return model.Source(file_id: 1, revision_id: 1, id: 1,
        path: "parser-test-invalid", original: [], normalized: [], offsets: [],
        boundaries: [], valid: false, error_byte: 0, error_length: 1,
        error_message: "invalid source");
}

func lexed(b Builder) model.LexResult {
    return model.LexResult(state: model.PhaseState.Complete,
        failure: model.FailureKind.Source, source: source(),
        tokens: b.tokens, diagnostics: vec.empty[model.Diagnostic](),
        has_value: true);
}

func lexed_full(b Builder, state model.PhaseState,
                failure model.FailureKind,
                diagnostics Vec[model.Diagnostic],
                has_value bool, source_value model.Source) model.LexResult {
    return model.LexResult(state: state, failure: failure,
        source: source_value, tokens: b.tokens, diagnostics: diagnostics,
        has_value: has_value);
}

func lexed_with(b Builder, state model.PhaseState,
                failure model.FailureKind,
                diagnostics Vec[model.Diagnostic],
                has_value bool) model.LexResult {
    return lexed_full(b, state, failure, diagnostics, has_value, source());
}

func check(t inout Test, ok bool, label string) {
    t.checks += 1;
    if !ok {
        t.failures += 1;
        vec.push(t.failed, label);
    }
}

func is_complete(state model.PhaseState) bool {
    switch state {
        case model.PhaseState.Complete: return true;
        default: return false;
    }
}

func is_recovered(state model.PhaseState) bool {
    switch state {
        case model.PhaseState.Recovered: return true;
        default: return false;
    }
}

func is_failed(state model.PhaseState) bool {
    switch state {
        case model.PhaseState.Failed: return true;
        default: return false;
    }
}

func is_cancelled(state model.PhaseState) bool {
    switch state {
        case model.PhaseState.Cancelled: return true;
        default: return false;
    }
}

func phase_id(state model.PhaseState) u32 {
    switch state {
        case model.PhaseState.Complete: return 0;
        case model.PhaseState.Recovered: return 1;
        case model.PhaseState.Failed: return 2;
        case model.PhaseState.Cancelled: return 3;
    }
}

func failure_id(failure model.FailureKind) u32 {
    switch failure {
        case model.FailureKind.Source: return 0;
        case model.FailureKind.Unsupported: return 1;
        case model.FailureKind.Environment: return 2;
        case model.FailureKind.Internal: return 3;
    }
}

// Mirrors PhaseResult::exit_code classification without relying on
// has_value or diagnostic counts alone.
func exit_classification(result model.ParseResult) u8 {
    if is_cancelled(result.state) { return 4; }
    var error = false;
    for diagnostic in result.diagnostics {
        if diagnostic.severity == "error" { error = true; }
    }
    if is_complete(result.state) && result.has_value && !error { return 0; }
    let id = failure_id(result.failure);
    if id == 2 { return 2; }
    if id == 3 { return 3; }
    return 1;
}

func count_kind(nodes Vec[model.AstNode], kind u32) usize {
    var count usize = 0;
    for node in nodes {
        if model.ast_kind_id(node.kind) == kind { count += 1; }
    }
    return count;
}

func first_kind(nodes Vec[model.AstNode], kind u32) usize {
    for var index usize = 0; index < vec.len(nodes); index += 1 {
        if model.ast_kind_id(nodes[index].kind) == kind { return index; }
    }
    return vec.len(nodes);
}

func count_message(diagnostics Vec[model.Diagnostic], message string) usize {
    var count usize = 0;
    for diagnostic in diagnostics {
        if diagnostic.message == message { count += 1; }
    }
    return count;
}

// Every node uses a half-open token range, its span is the raw byte range of
// that token range, children are allocated before their parent, and only
// Error nodes carry recovered=true.
func check_tree(t inout Test, nodes Vec[model.AstNode],
               tokens Vec[model.Token], label string) {
    for var index usize = 0; index < vec.len(nodes); index += 1 {
        let node = nodes[index];
        let node_kind = model.ast_kind_id(node.kind);
        check(inout t, node_kind <= 51, label + ": ast kind in frozen range");
        check(inout t, node.token_begin <= node.token_end,
              label + ": token range order");
        check(inout t, node.token_end <= vec.len(tokens),
              label + ": token range bound");
        check(inout t, node.span.snapshot == 1, label + ": span snapshot");
        check(inout t, node.recovered == (node_kind == AST_ERROR),
              label + ": recovered only on Error");
        if node.token_begin < vec.len(tokens) {
            check(inout t, node.span.begin_byte ==
                     tokens[node.token_begin].span.begin_byte,
                  label + ": span begins at first token");
            if node.token_end > node.token_begin {
                check(inout t, node.span.end_byte ==
                         tokens[node.token_end - 1].span.end_byte,
                      label + ": span ends at last token");
            } else {
                check(inout t, node.span.end_byte ==
                         tokens[node.token_begin].span.end_byte,
                      label + ": empty range keeps token span");
            }
        } else {
            check(inout t, node.span.begin_byte == 0 && node.span.end_byte == 0,
                  label + ": past-end node has empty span");
        }
        for child in node.children {
            check(inout t, child < index, label + ": child before parent");
        }
    }
}

