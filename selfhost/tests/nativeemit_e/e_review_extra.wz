// Extra independent E probes for the SH08e production fix.
//
// This file is test-only.  It builds raw NativeIR/HIR records, calls the real
// production E helpers, and prints the resulting LLVM text.  It never builds a
// VerifiedModule and never edits generated IR to make a check pass.
package nativeemit;

import "app/wzcc/hir" as hir;
import "app/wzcc/model" as model;
import "app/wzcc/nativeir" as nativeir;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

pub struct EProbeCase {
    pub name string;
    pub llvm string;
    pub expected string;
    pub actual string;
}

func ex_source() hir.HirSource {
    return hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: 0),
        span: ex_span());
}
func ex_span() model.Span {
    return model.Span(snapshot: 0, begin_byte: 0, end_byte: 0);
}
func ex_field(symbol usize, t usize) hir.FieldDecl {
    return hir.FieldDecl(symbol: symbol, type_id: t, exported: true,
        source: ex_source());
}
func ex_generic(symbol usize) hir.GenericParam {
    return hir.GenericParam(symbol: symbol,
        trait_ref: option.Option[hir.TraitRef].None, source: ex_source());
}
func ex_variant(symbol usize, payload Vec[hir.FieldDecl]) hir.VariantDecl {
    return hir.VariantDecl(symbol: symbol, payload: payload, source: ex_source());
}
func ex_enum(symbol usize, params Vec[hir.GenericParam],
             variants Vec[hir.VariantDecl]) hir.NominalDecl {
    return hir.NominalDecl(symbol: symbol, kind: model.TypeKind.NominalEnum,
        params: params, fields: [], variants: variants, source: ex_source());
}
func ex_intern(c inout types.Context, v model.Type) usize throws Error {
    try { return types.intern(inout c, v); }
    catch e types.Error {
        switch e { case types.Error.Invalid(m): throw invalid(m); }
    }
}
func ex_function_type(c inout types.Context, parameters Vec[usize],
                      result usize) usize throws Error {
    var value = model.empty_type(model.TypeKind.Function);
    var fields Vec[model.ParameterType] = [];
    for item in parameters {
        vec.push(fields, model.ParameterType(mode: model.ParamMode.Ordinary,
            type_id: item));
    }
    value.parameters = fields;
    value.result = result;
    return ex_intern(inout c, value);
}
func ex_scalar(name string) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Scalar, scalar: name,
        writable: false, args: [], named: 0);
}
func ex_named(id u32) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Named, scalar: "",
        writable: false, args: [], named: id);
}
func ex_pointer(name string) model.CTypeRef {
    return model.CTypeRef(kind: model.CTypeKind.Pointer, scalar: "",
        writable: true, args: [ex_scalar(name)], named: 0);
}
func ex_cfield(name string, t model.CTypeRef, offset u64) model.CFieldDecl {
    return model.CFieldDecl(name: name, type_ref: t, offset: offset,
        source: ex_span());
}
func ex_unit_return() model.CReturnDecl {
    return model.CReturnDecl(type_ref: ex_scalar("Unit"), ownership: "unit",
        release_symbol: "", retain_symbol: "", source: ex_span());
}
func ex_record(id u32, name string, fields Vec[model.CFieldDecl], size u64,
               align u64) model.CTypeDecl {
    return model.CTypeDecl(id: id, bundle: 0, source: ex_span(),
        identity: "test." + name, module: "test", name: name, c_name: name,
        kind: model.CDeclKind.Record, fields: fields, size: size, align: align,
        release_symbol: "", retain_symbol: "", result: ex_scalar("Unit"),
        parameters: [],
        registration: option.Option[model.CRegistrationDecl].None);
}
func ex_begin(state inout Emitter, name string, parameters Vec[string],
              result string) usize throws Error {
    let function = new_function(name, Signature(result: result,
        parameters: parameters), "", "", inout state);
    let entry = new_block(function, "entry", inout state);
    position(entry, inout state);
    return function;
}
func ex_value(returned option.Option[Value]) Value throws Error {
    switch returned {
        case option.Option.Some(value): return value;
        case option.Option.None: throw invalid("probe emission returned no value");
    }
}
func ex_instruction(op nativeir.Op, type_id usize, signature usize,
                    system option.Option[u32]) nativeir.Instruction {
    var value = nativeir.empty_instruction();
    value.op = op;
    value.type_id = type_id;
    value.signature = signature;
    value.system = system;
    return value;
}

// One module keeps every probe function together so a linked C driver can
// call the real runtime once.  Individual helper modules are emitted by
// review.wz and are opt-verified separately.
func ex_bundle() EProbeCase throws Error {
    var resolved = model.ResolvedProject(project: model.empty_project(),
        symbols: [], occurrences: [], deferred_members: [],
        self_parameters: []);
    var module = hir.empty_module(resolved, 0,
        model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    var c = types.context();

    let bool_id = ex_intern(inout c, model.empty_type(model.TypeKind.Bool));
    var i32_type = model.empty_type(model.TypeKind.SignedInt);
    i32_type.bits = 32;
    let i32_id = ex_intern(inout c, i32_type);
    var i64_type = model.empty_type(model.TypeKind.SignedInt);
    i64_type.bits = 64;
    let i64_id = ex_intern(inout c, i64_type);
    var u8_type = model.empty_type(model.TypeKind.UnsignedInt);
    u8_type.bits = 8;
    let u8_id = ex_intern(inout c, u8_type);
    let usize_id = ex_intern(inout c, model.empty_type(model.TypeKind.Usize));
    let ipc_id = ex_intern(inout c, model.empty_type(model.TypeKind.IpcHandle));
    let str_id = ex_intern(inout c, model.empty_type(model.TypeKind.String));

    var vec_type = model.empty_type(model.TypeKind.Vec);
    vec_type.type_args = [u8_id];
    let vec_id = ex_intern(inout c, vec_type);

    var opt_str = model.empty_type(model.TypeKind.NominalEnum);
    opt_str.declaration = 10;
    opt_str.type_args = [str_id];
    let opt_str_id = ex_intern(inout c, opt_str);
    var res_opt_str = model.empty_type(model.TypeKind.NominalEnum);
    res_opt_str.declaration = 20;
    res_opt_str.type_args = [opt_str_id];
    let res_opt_str_id = ex_intern(inout c, res_opt_str);
    var opt_vec = model.empty_type(model.TypeKind.NominalEnum);
    opt_vec.declaration = 30;
    opt_vec.type_args = [vec_id];
    let opt_vec_id = ex_intern(inout c, opt_vec);
    var res_opt_vec = model.empty_type(model.TypeKind.NominalEnum);
    res_opt_vec.declaration = 40;
    res_opt_vec.type_args = [opt_vec_id];
    let res_opt_vec_id = ex_intern(inout c, res_opt_vec);

    var pair_type = model.empty_type(model.TypeKind.CForeignRecord);
    pair_type.c_type = 1;
    let pair_id = ex_intern(inout c, pair_type);
    var nested_type = model.empty_type(model.TypeKind.CForeignRecord);
    nested_type.c_type = 2;
    let nested_id = ex_intern(inout c, nested_type);
    var pointer_type = model.empty_type(model.TypeKind.CForeignPointer);
    pointer_type.type_args = [i32_id];
    let pointer_id = ex_intern(inout c, pointer_type);

    let sig_getenv = ex_function_type(inout c, [str_id], res_opt_str_id);
    let sig_getenv_bytes = ex_function_type(inout c, [vec_id], res_opt_vec_id);
    let sig_cond = ex_function_type(inout c,
        [ipc_id, usize_id, ipc_id, usize_id, i64_id], bool_id);
    let sig_sem = ex_function_type(inout c, [ipc_id, usize_id, i64_id], bool_id);
    let sig_try = ex_function_type(inout c, [ipc_id, usize_id], bool_id);

    module.resolved.project.c_types = [
        ex_record(1, "Pair", [
            ex_cfield("flag", ex_scalar("bool"), 0),
            ex_cfield("value", ex_scalar("i32"), 4)], 8, 4),
        ex_record(2, "Nested", [
            ex_cfield("inner", ex_named(1), 0),
            ex_cfield("pointer", ex_pointer("i32"), 8)], 16, 8)];
    module.types = c;
    module.nominals = [
        ex_enum(10, [ex_generic(100)], [
            ex_variant(11, []), ex_variant(12, [ex_field(13, str_id)])]),
        ex_enum(20, [ex_generic(101)], [
            ex_variant(21, [ex_field(22, opt_str_id)]),
            ex_variant(23, [ex_field(24, i32_id)])]),
        ex_enum(30, [ex_generic(102)], [
            ex_variant(31, []), ex_variant(32, [ex_field(33, vec_id)])]),
        ex_enum(40, [ex_generic(103)], [
            ex_variant(41, [ex_field(42, opt_vec_id)]),
            ex_variant(43, [ex_field(44, i32_id)])])];

    var state = new_emitter(nativeir.empty_module(module), default_options());

    // getenv (142): Result[Option[string], i32].
    let getenv_result = lower_type(res_opt_str_id, inout state);
    let getenv_function = ex_begin(inout state, "ex_getenv_probe",
        ["{ ptr, i64, i64, ptr }"], getenv_result);
    let getenv_instruction = ex_instruction(nativeir.Op.SystemCall,
        res_opt_str_id, sig_getenv, option.Option[u32].Some(142));
    let getenv_arg = parameter(state, getenv_function, 0);
    let getenv_value = ex_value(e_process_system_call(getenv_instruction,
        [getenv_arg], inout state));
    terminate("ret " + typed(getenv_value), inout state);

    // getenv_bytes (143): Result[Option[Vec[u8]], i32].
    let getenv_bytes_result = lower_type(res_opt_vec_id, inout state);
    let getenv_bytes_function = ex_begin(inout state, "ex_getenv_bytes_probe",
        ["ptr"], getenv_bytes_result);
    let getenv_bytes_instruction = ex_instruction(nativeir.Op.SystemCall,
        res_opt_vec_id, sig_getenv_bytes, option.Option[u32].Some(143));
    let getenv_bytes_arg = parameter(state, getenv_bytes_function, 0);
    let getenv_bytes_value = ex_value(e_process_system_call(
        getenv_bytes_instruction, [getenv_bytes_arg], inout state));
    terminate("ret " + typed(getenv_bytes_value), inout state);

    // ipc cond_wait (184).
    let cond_function = ex_begin(inout state, "ex_wait_cond",
        ["ptr", "i64", "ptr", "i64", "i64"], "i1");
    let cond_instruction = ex_instruction(nativeir.Op.SystemCall, bool_id,
        sig_cond, option.Option[u32].Some(184));
    var cond_args Vec[Value] = [];
    for var index usize = 0; index < 5; index += 1 {
        vec.push(cond_args, parameter(state, cond_function, index));
    }
    let cond_value = ex_value(e_process_system_call(cond_instruction,
        cond_args, inout state));
    terminate("ret " + typed(cond_value), inout state);

    // ipc sem_wait (185).
    let sem_function = ex_begin(inout state, "ex_wait_sem",
        ["ptr", "i64", "i64"], "i1");
    let sem_instruction = ex_instruction(nativeir.Op.SystemCall, bool_id,
        sig_sem, option.Option[u32].Some(185));
    var sem_args Vec[Value] = [];
    for var index usize = 0; index < 3; index += 1 {
        vec.push(sem_args, parameter(state, sem_function, index));
    }
    let sem_value = ex_value(e_process_system_call(sem_instruction, sem_args,
        inout state));
    terminate("ret " + typed(sem_value), inout state);

    // ipc sem_trywait (186).
    let try_function = ex_begin(inout state, "ex_wait_trywait",
        ["ptr", "i64"], "i1");
    let try_instruction = ex_instruction(nativeir.Op.SystemCall, bool_id,
        sig_try, option.Option[u32].Some(186));
    var try_args Vec[Value] = [];
    for var index usize = 0; index < 2; index += 1 {
        vec.push(try_args, parameter(state, try_function, index));
    }
    let try_value = ex_value(e_process_system_call(try_instruction, try_args,
        inout state));
    terminate("ret " + typed(try_value), inout state);

    // CFieldRead: bool and i32 fields of Pair.
    let pair_layout = c_lower_type(pair_id, inout state);
    let field_bool_function = ex_begin(inout state, "ex_field_bool",
        [pair_layout], "i1");
    var bool_instruction = ex_instruction(nativeir.Op.CFieldRead, bool_id, 0,
        option.Option[u32].None);
    bool_instruction.c_field = 0;
    let field_bool_arg = parameter(state, field_bool_function, 0);
    let field_bool_value = ex_value(emit_c_instruction(bool_instruction,
        [field_bool_arg], inout state));
    terminate("ret " + typed(field_bool_value), inout state);

    let field_i32_function = ex_begin(inout state, "ex_field_i32",
        [pair_layout], "i32");
    var i32_instruction = ex_instruction(nativeir.Op.CFieldRead, i32_id, 0,
        option.Option[u32].None);
    i32_instruction.c_field = 1;
    let field_i32_arg = parameter(state, field_i32_function, 0);
    let field_i32_value = ex_value(emit_c_instruction(i32_instruction,
        [field_i32_arg], inout state));
    terminate("ret " + typed(field_i32_value), inout state);

    // CFieldRead: nested record and pointer fields of Nested.
    let nested_layout = c_lower_type(nested_id, inout state);
    let nested_pair_layout = c_lower_type(pair_id, inout state);
    let field_nested_function = ex_begin(inout state, "ex_field_nested",
        [nested_layout], nested_pair_layout);
    var nested_instruction = ex_instruction(nativeir.Op.CFieldRead, pair_id, 0,
        option.Option[u32].None);
    nested_instruction.c_field = 0;
    let field_nested_arg = parameter(state, field_nested_function, 0);
    let field_nested_value = ex_value(emit_c_instruction(nested_instruction,
        [field_nested_arg], inout state));
    terminate("ret " + typed(field_nested_value), inout state);

    let field_pointer_function = ex_begin(inout state, "ex_field_pointer",
        [nested_layout], "ptr");
    var pointer_instruction = ex_instruction(nativeir.Op.CFieldRead,
        pointer_id, 0, option.Option[u32].None);
    pointer_instruction.c_field = 1;
    let field_pointer_arg = parameter(state, field_pointer_function, 0);
    let field_pointer_value = ex_value(emit_c_instruction(pointer_instruction,
        [field_pointer_arg], inout state));
    terminate("ret " + typed(field_pointer_value), inout state);

    return EProbeCase(name: "runtime_bundle",
        llvm: text.join(sections(state), ""),
        expected: "getenv text Result, getenv_bytes Result, three IPC waits, " +
            "bool/i32/nested/pointer field results",
        actual: "");
}

pub func e_review_extra_cases() Vec[EProbeCase] throws Error {
    var cases = vec.empty[EProbeCase]();
    vec.push(cases, ex_bundle());
    return cases;
}
