package io;
import "std/os" as os;
import "std/text" as text;
import "std/vec" as vec;
import "std/option" as option;
import "std/strconv" as strconv;

pub trait Printable { func to_text(value Self) string; }
impl Printable for string { func to_text(value Self) string { return value; } }
impl Printable for bool { func to_text(value Self) string { if value { return "true"; } return "false"; } }
impl Printable for i8 { func to_text(value Self) string { return strconv.format_i64(i64(value)); } }
impl Printable for i16 { func to_text(value Self) string { return strconv.format_i64(i64(value)); } }
impl Printable for i32 { func to_text(value Self) string { return strconv.format_i64(i64(value)); } }
impl Printable for i64 { func to_text(value Self) string { return strconv.format_i64(value); } }
impl Printable for isize { func to_text(value Self) string { return strconv.format_i64(i64(value)); } }
impl Printable for u8 { func to_text(value Self) string { return strconv.format_u64(u64(value)); } }
impl Printable for u16 { func to_text(value Self) string { return strconv.format_u64(u64(value)); } }
impl Printable for u32 { func to_text(value Self) string { return strconv.format_u64(u64(value)); } }
impl Printable for u64 { func to_text(value Self) string { return strconv.format_u64(value); } }
impl Printable for usize { func to_text(value Self) string { return strconv.format_u64(u64(value)); } }
impl Printable for f32 { func to_text(value Self) string { return strconv.format_f32(value); } }
impl Printable for f64 { func to_text(value Self) string { return strconv.format_f64(value); } }

pub func print[T Printable](value T) throws os.Error {
    os.write_all_text(os.stdout(),value.to_text());
}
pub func println[T Printable](value T) throws os.Error {
    os.write_all_text(os.stdout(),value.to_text()+"\n");
}
pub func eprint[T Printable](value T) throws os.Error {
    os.write_all_text(os.stderr(),value.to_text());
}
pub func eprintln[T Printable](value T) throws os.Error {
    os.write_all_text(os.stderr(),value.to_text()+"\n");
}
pub func decode(data Vec[u8]) string throws os.Error {
    try { return text.from_bytes(data); }
    catch error text.Error { throw os.Error.System(84,0); }
}
pub func read_all(file os.File) Vec[u8] throws os.Error {
    let out = vec.empty[u8]();
    let buffer = vec.make[u8](4096,0);
    for true {
        var count usize = 0;
        try { count = os.read(file,buffer,vec.len(buffer)); }
        catch error os.Error {
            switch error {
                case os.Error.Interrupted(code,completed): continue;
                default: throw error;
            }
        }
        if count == 0 { return out; }
        __woozy_io_vec_append_bytes(out,buffer,0,count);
    }
}
pub func read_text(file os.File) string throws os.Error { return decode(read_all(file)); }

pub struct Reader { file os.File; buffer Vec[u8]; cursor Vec[usize]; }
pub func reader(file os.File) Reader {
    return Reader(file:file,buffer:vec.make[u8](4096,0),cursor:[0,0]);
}
func refill(input Reader) bool throws os.Error {
    for true {
        try {
            let count = os.read(input.file,input.buffer,vec.len(input.buffer));
            input.cursor[0] = 0;
            input.cursor[1] = count;
            return count != 0;
        } catch error os.Error {
            switch error {
                case os.Error.Interrupted(code,completed): continue;
                default: throw error;
            }
        }
    }
    return false;
}
pub func read_byte(input Reader) option.Option[u8] throws os.Error {
    if input.cursor[0] == input.cursor[1] && !refill(input) {
        return option.Option[u8].None;
    }
    let byte = input.buffer[input.cursor[0]];
    input.cursor[0] += 1;
    return option.Option[u8].Some(byte);
}
// A line excludes LF and a preceding CR; EOF after data still returns a line.
pub func read_line_bytes(input Reader) option.Option[Vec[u8]] throws os.Error {
    if input.cursor[0] == input.cursor[1] && !refill(input) {
        return option.Option[Vec[u8]].None;
    }
    let start = input.cursor[0];
    let limit = input.cursor[1];
    for var index = start; index < limit; index += 1 {
        if input.buffer[index] == 10 {
            input.cursor[0] = index + 1;
            var end = index;
            if end > start && input.buffer[end-1] == 13 { end -= 1; }
            return option.Option[Vec[u8]].Some(input.buffer[start:end]);
        }
    }

    let out = input.buffer[start:limit];
    input.cursor[0] = limit;
    try {
        for refill(input) {
            var index = input.cursor[0];
            let end = input.cursor[1];
            for index < end {
                let byte = input.buffer[index];
                index += 1;
                if byte == 10 {
                    input.cursor[0] = index;
                    let length = vec.len(out);
                    if length > 0 && out[length-1] == 13 { let removed=vec.pop(out); }
                    return option.Option[Vec[u8]].Some(out);
                }
                vec.push(out,byte);
            }
            input.cursor[0] = end;
        }
    } catch error os.Error {
        // A failed refill has no unread suffix; replay this line for aliases.
        let count = vec.len(out);
        if count > 0 {
            if vec.len(input.buffer) < count { vec.resize(input.buffer,count,0); }
            for var index usize = 0; index < count; index += 1 { input.buffer[index] = out[index]; }
            input.cursor[0] = 0;
            input.cursor[1] = count;
        }
        throw error;
    }
    return option.Option[Vec[u8]].Some(out);
}
pub func read_line(input Reader) option.Option[string] throws os.Error {
    switch read_line_bytes(input) {
        case option.Option.None: return option.Option[string].None;
        case option.Option.Some(data): return option.Option[string].Some(decode(data));
    }
}

pub struct Writer { file os.File; pending Vec[u8]; }
pub func writer(file os.File) Writer { return Writer(file:file,pending:vec.empty[u8]()); }
pub func flush(output Writer) throws os.Error {
    try { os.write_all(output.file,output.pending); }
    catch error os.Error {
        var completed usize = 0;
        switch error {
            case os.Error.Interrupted(code,count): completed = count;
            case os.Error.WouldBlock(code,count): completed = count;
            case os.Error.System(code,count): completed = count;
            case os.Error.NoProgress(count): completed = count;
        }
        let remaining = vec.len(output.pending)-completed;
        for var index usize = 0; index < remaining; index += 1 {
            output.pending[index] = output.pending[index+completed];
        }
        vec.resize(output.pending,remaining,0);
        throw error;
    }
    vec.clear(output.pending);
}
// write_byte appends one byte and flushes before appending when the buffer is
// full. If that flush throws, the byte is not appended: pending still holds
// exactly the unwritten suffix, so retrying write_byte after flush neither
// duplicates nor drops the byte. write and write_text inherit this guarantee.
pub func write_byte(output Writer, byte u8) throws os.Error {
    if vec.len(output.pending) == 4096 { flush(output); }
    vec.push(output.pending, byte);
}
pub func write(output Writer, data Vec[u8]) throws os.Error {
    for byte in data { write_byte(output,byte); }
}
pub func write_text(output Writer, value string) throws os.Error { write(output,text.bytes(value)); }
