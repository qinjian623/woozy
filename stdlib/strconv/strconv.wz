            magnitude = magnitude * 10 + u64(d14);
            let d15 = value[15] - 48;
            if d15 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d15);
            let d16 = value[16] - 48;
            if d16 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d16);
        }
        case 18: {
            let d1 = value[1] - 48;
            if d1 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d1);
            let d2 = value[2] - 48;
            if d2 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d2);
            let d3 = value[3] - 48;
            if d3 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d3);
            let d4 = value[4] - 48;
            if d4 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d4);
            let d5 = value[5] - 48;
            if d5 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d5);
            let d6 = value[6] - 48;
            if d6 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d6);
            let d7 = value[7] - 48;
            if d7 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d7);
            let d8 = value[8] - 48;
            if d8 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d8);
            let d9 = value[9] - 48;
            if d9 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d9);
            let d10 = value[10] - 48;
            if d10 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d10);
            let d11 = value[11] - 48;
            if d11 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d11);
            let d12 = value[12] - 48;
            if d12 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d12);
            let d13 = value[13] - 48;
            if d13 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d13);
            let d14 = value[14] - 48;
            if d14 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d14);
            let d15 = value[15] - 48;
            if d15 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d15);
            let d16 = value[16] - 48;
            if d16 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d16);
            let d17 = value[17] - 48;
            if d17 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d17);
        }
        case 19: {
            let d1 = value[1] - 48;
            if d1 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d1);
            let d2 = value[2] - 48;
            if d2 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d2);
            let d3 = value[3] - 48;
            if d3 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d3);
            let d4 = value[4] - 48;
            if d4 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d4);
            let d5 = value[5] - 48;
            if d5 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d5);
            let d6 = value[6] - 48;
            if d6 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d6);
            let d7 = value[7] - 48;
            if d7 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d7);
            let d8 = value[8] - 48;
            if d8 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d8);
            let d9 = value[9] - 48;
            if d9 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d9);
            let d10 = value[10] - 48;
            if d10 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d10);
            let d11 = value[11] - 48;
            if d11 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d11);
            let d12 = value[12] - 48;
            if d12 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d12);
            let d13 = value[13] - 48;
            if d13 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d13);
            let d14 = value[14] - 48;
            if d14 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d14);
            let d15 = value[15] - 48;
            if d15 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d15);
            let d16 = value[16] - 48;
            if d16 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d16);
            let d17 = value[17] - 48;
            if d17 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d17);
            let d18 = value[18] - 48;
            if d18 > 9 { throw Error.InvalidSyntax; }
            magnitude = magnitude * 10 + u64(d18);
        }
        default: {
            var free_end usize = 19;
            if first == 43 { free_end = 20; }
            if free_end > size { free_end = size; }
            // Eight digits fit in a u64 chunk; combine them once.
            for index + 8 <= free_end {
                let b0 = value[index + 0] - 48;
                if b0 > 9 { throw Error.InvalidSyntax; }
                let b1 = value[index + 1] - 48;
                if b1 > 9 { throw Error.InvalidSyntax; }
                let b2 = value[index + 2] - 48;
                if b2 > 9 { throw Error.InvalidSyntax; }
                let b3 = value[index + 3] - 48;
                if b3 > 9 { throw Error.InvalidSyntax; }
                let b4 = value[index + 4] - 48;
                if b4 > 9 { throw Error.InvalidSyntax; }
                let b5 = value[index + 5] - 48;
                if b5 > 9 { throw Error.InvalidSyntax; }
                let b6 = value[index + 6] - 48;
                if b6 > 9 { throw Error.InvalidSyntax; }
                let b7 = value[index + 7] - 48;
                if b7 > 9 { throw Error.InvalidSyntax; }
                let chunk = u64(b0) * 10000000 + u64(b1) * 1000000 + u64(b2) * 100000 + u64(b3) * 10000 + u64(b4) * 1000 + u64(b5) * 100 + u64(b6) * 10 + u64(b7) * 1;
                magnitude = magnitude * CHUNK + chunk;
                index += 8;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            if index < free_end {
                let t = value[index] - 48;
                if t > 9 { throw Error.InvalidSyntax; }
                magnitude = magnitude * 10 + u64(t);
                index += 1;
            }
            var overflow = false;
            for index < size {
                let d = value[index] - 48;
                if d > 9 { throw Error.InvalidSyntax; }
                let digit = u64(d);
                if magnitude > UNSIGNED_CUTOFF ||
                   (magnitude == UNSIGNED_CUTOFF && digit > 5) {
                    overflow = true;
                } else if !overflow {
                    magnitude = magnitude * 10 + digit;
                }
                index += 1;
            }
            if overflow { throw Error.OutOfRange; }
        }
    }
    return magnitude;
}

pub func parse_f32(value string) f32 throws Error { return checked(__woozy_num_parse_f32(value)); }
pub func format_f32(value f32) string { return wz_format_f32(value); }
pub func parse_f64(value string) f64 throws Error { return checked(__woozy_num_parse_f64(value)); }
pub func format_f64(value f64) string { return wz_format_f64(value); }
