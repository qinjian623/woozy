package strconv;
import "std/result" as result;
import "std/text" as text;
pub enum Error { InvalidSyntax; OutOfRange; }
func checked[T](value result.Result[T,i32]) T throws Error {
    switch value {
        case result.Result.Ok(item): return item;
        case result.Result.Err(code):
            if code == 34 { throw Error.OutOfRange; }
            throw Error.InvalidSyntax;
    }
}

// Integer parsing mirrors runtime/native/numbers.cpp: one optional sign, then
// one or more ASCII digits. The whole token is validated before range is
// reported, so a malformed suffix keeps InvalidSyntax priority over OutOfRange.
//
// The magnitude is accumulated in u64 with a guard derived from U64_MAX. Once
// overflow is seen, further digits are still validated but not accumulated, so
// the range decision never depends on the token length. The direct string
// index is a Unicode scalar read; the Native emitter may lower it to a byte
// load only when the string is ASCII and otherwise falls back to the runtime
// accessor. Every scalar is compared with '0'..'9', so a non-ASCII scalar or
// an embedded NUL is InvalidSyntax on either path.
const U64_MAX u64 = 18_446_744_073_709_551_615;
const SIGNED_LIMIT u64 = U64_MAX / 2 + 1;
func parse_magnitude(value string, start usize, size usize) u64 throws Error {
    if start == size { throw Error.InvalidSyntax; }
    let cutoff = U64_MAX / 10;
    let last_digit = U64_MAX % 10;
    var magnitude u64 = 0;

    // 10^19 - 1 = 9_999_999_999_999_999_999 < U64_MAX, so any 19 decimal
    // digits fit. Consume that prefix without a per-digit overflow check.
    var index = start;
    var prefix_end = start + 19;
    if prefix_end > size { prefix_end = size; }
    for index < prefix_end {
        let scalar = value[index];
        if scalar < 48 || scalar > 57 { throw Error.InvalidSyntax; }
        magnitude = magnitude * 10 + u64(scalar - 48);
        index += 1;
    }

    // The remaining digits use the usual cutoff check. Once overflow is
    // seen, keep validating suffixes so InvalidSyntax still wins.
    var overflow = false;
    for index < size {
        let scalar = value[index];
        if scalar < 48 || scalar > 57 { throw Error.InvalidSyntax; }
        let digit = u64(scalar - 48);
        if !overflow {
            if magnitude > cutoff || (magnitude == cutoff && digit > last_digit) {
                overflow = true;
            } else {
                magnitude = magnitude * 10 + digit;
            }
        }
        index += 1;
    }
    if overflow { throw Error.OutOfRange; }
    return magnitude;
}

pub func parse_i64(value string) i64 throws Error {
    let size = text.len(value);
    if size == 0 || text.byte_len(value) != size { throw Error.InvalidSyntax; }
    let first = value[0];
    let negative = first == 45;
    var start usize = 0;
    if first == 43 || negative { start = 1; }
    let magnitude = parse_magnitude(value, start, size);
    if negative {
        if magnitude > SIGNED_LIMIT { throw Error.OutOfRange; }
        if magnitude == SIGNED_LIMIT { return -9_223_372_036_854_775_808; }
        return -i64(magnitude);
    }
    if magnitude >= SIGNED_LIMIT { throw Error.OutOfRange; }
    return i64(magnitude);
}

pub func parse_u64(value string) u64 throws Error {
    let size = text.len(value);
    if size == 0 || text.byte_len(value) != size { throw Error.InvalidSyntax; }
    let first = value[0];
    if first == 45 { throw Error.InvalidSyntax; }
    var start usize = 0;
    if first == 43 { start = 1; }
    return parse_magnitude(value, start, size);
}

pub func parse_f32(value string) f32 throws Error { return wz_parse_f32(value); }
pub func format_f32(value f32) string { return wz_format_f32(value); }
pub func parse_f64(value string) f64 throws Error { return wz_parse_f64(value); }
pub func format_f64(value f64) string { return wz_format_f64(value); }
