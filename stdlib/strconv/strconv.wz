package strconv;
import "std/result" as result;
import "std/text" as text;
pub enum Error { InvalidSyntax; OutOfRange; }
func checked[T](value result.Result[T,i32]) T throws Error {
    switch value {
        case result.Result.Ok(item): return item;
        case result.Result.Err(code):
            if code == 34 { throw Error.OutOfRange; }
            throw Error.InvalidSyntax;
    }
}

