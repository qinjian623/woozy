func fp_pow5_wide(exponent i64) FpWide {
    let index = exponent + 342;
    if index < 64 {
        return fp_pow5_block_0(usize(index));
    }
    if index < 128 {
        return fp_pow5_block_1(usize(index));
    }
    if index < 192 {
        return fp_pow5_block_2(usize(index));
    }
    if index < 256 {
        return fp_pow5_block_3(usize(index));
    }
    if index < 320 {
        return fp_pow5_block_4(usize(index));
    }
    if index < 384 {
        return fp_pow5_block_5(usize(index));
    }
    if index < 448 {
        return fp_pow5_block_6(usize(index));
    }
    if index < 512 {
        return fp_pow5_block_7(usize(index));
    }
    if index < 576 {
        return fp_pow5_block_8(usize(index));
    }
    if index < 640 {
        return fp_pow5_block_9(usize(index));
    }
    if index < 651 {
        return fp_pow5_block_10(usize(index));
    }
    return FpWide(hi: 0, lo: 0);
}
