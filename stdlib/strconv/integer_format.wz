package strconv;
import "std/text" as text;
import "std/vec" as vec;

func format_decimal(magnitude u64, negative bool) string {
    // Count the exact output size first, four decimal digits per radix-10000
    // unit, then finish the bounded tail. This avoids both a fixed maximum
    // buffer and compacting the finished digits down to the front.
    var digits usize = 1;
    var counted = magnitude;
    for counted >= 10000 {
        counted /= 10000;
        digits += 4;
    }
    if counted >= 1000 {
        digits += 3;
    } else if counted >= 100 {
        digits += 2;
    } else if counted >= 10 {
        digits += 1;
    }
    var length = digits;
    if negative {
        length += 1;
    }
    let buffer = vec.make[u8](length, 0);
    // Keep the existing radix-100 formatting, but write straight into the
    // exact-size result so no copy or resize is needed afterward.
    var begin usize = length;
    var remaining = magnitude;
    for remaining >= 100 {
        let pair = remaining % 100;
        remaining /= 100;
        begin -= 2;
        buffer[begin] = u8(pair / 10) + 48;
        buffer[begin + 1] = u8(pair % 10) + 48;
    }
    if remaining >= 10 {
        begin -= 2;
        buffer[begin] = u8(remaining / 10) + 48;
        buffer[begin + 1] = u8(remaining % 10) + 48;
    } else {
        begin -= 1;
        buffer[begin] = u8(remaining) + 48;
    }
    if negative {
        begin -= 1;
        buffer[begin] = 45;
    }
    try { return text.from_bytes(buffer); }
    catch error text.Error {
        // The bytes above are decimal ASCII digits and an optional minus.
        return "";
    }
}

pub func format_i64(value i64) string {
    if value < 0 { return format_decimal(u64(-(value + 1)) + 1, true); }
    return format_decimal(u64(value), false);
}

pub func format_u64(value u64) string { return format_decimal(value, false); }
