package strconv;
import "std/text" as text;
import "std/vec" as vec;

// A u64 holds at most 20 decimal digits; the extra byte is for a minus sign.
const FORMAT_BUFFER usize = 21;

func format_decimal(magnitude u64, negative bool) string {
    // Fill the buffer from the end so digits come out most-significant first.
    // Division stops as soon as the quotient reaches zero, so every value has
    // exactly one leading digit, including zero.
    let buffer = vec.make[u8](FORMAT_BUFFER, 0);
    var begin usize = FORMAT_BUFFER;
    var remaining = magnitude;
    for {
        begin -= 1;
        buffer[begin] = u8(remaining % 10) + 48;
        remaining /= 10;
        if remaining == 0 { break; }
    }
    if negative {
        begin -= 1;
        buffer[begin] = 45;
    }
    try { return text.from_bytes(buffer[begin:]); }
    catch error text.Error {
        // The bytes above are decimal ASCII digits and an optional minus.
        return "";
    }
}

pub func format_i64(value i64) string {
    if value < 0 { return format_decimal(u64(-(value + 1)) + 1, true); }
    return format_decimal(u64(value), false);
}

pub func format_u64(value u64) string { return format_decimal(value, false); }
