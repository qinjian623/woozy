// Hash map with separate chaining and lazily allocated Vec buckets.
// With well-distributed hashes, insert/get/remove take amortized O(1) time;
// doubling and rehashing keep the load factor at or below 0.75.
//
// Map is a value struct, but all mutable state lives behind shared Vec
// handles. buckets[0] and allocated[0] describe the same bucket table.
// Untouched slots share an empty Vec, which is replaced before insertion.
// Copying a Map therefore shares the same logical map, matching the language
// rule for Vec identity. Operations read buckets[0] at entry, so replacing
// the bucket vector after growth is visible through every Map alias.
//
// Keys are compared with hash.Hash.equals. Hash functions are
// non-cryptographic (see std/hash) and are not a security boundary.
package map;

import "std/hash" as hash;
import "std/option" as option;
import "std/vec" as vec;

const INITIAL_CAPACITY usize = 8;
// The largest representable usize. Bucket growth must never double past half
// of this value; see grow.
const MAX_USIZE usize = ~usize(0);

pub struct Entry[K,V] {
    pub key K;
    pub value V;
}

pub struct Map[K hash.Hash,V] {
    buckets Vec[Vec[Vec[Entry[K,V]]]];
    size Vec[usize];
    allocated Vec[Vec[bool]];
}

func empty_buckets[K hash.Hash,V](capacity usize) Vec[Vec[Entry[K,V]]] {
    return vec.make[Vec[Entry[K,V]]](capacity, vec.empty[Entry[K,V]]());
}

func ensure_bucket[K hash.Hash,V](buckets Vec[Vec[Entry[K,V]]], allocated Vec[bool], index usize) Vec[Entry[K,V]] {
    // Keep allocated buckets even when emptied: an outer probe may hold one.
    if !allocated[index] {
        buckets[index] = vec.empty[Entry[K,V]]();
        allocated[index] = true;
    }
    return buckets[index];
}

// new creates an empty map with an initial capacity of eight buckets.
pub func new[K hash.Hash,V]() Map[K,V] {
    let buckets = vec.make[Vec[Vec[Entry[K,V]]]](1, empty_buckets[K,V](INITIAL_CAPACITY));
    return Map[K,V](buckets: buckets, size: vec.make[usize](1, 0),
        allocated: vec.make[Vec[bool]](1, vec.make[bool](INITIAL_CAPACITY, false)));
}

pub func len[K hash.Hash,V](values Map[K,V]) usize {
    return values.size[0];
}

// is_empty reports whether the map has no entries.
pub func is_empty[K hash.Hash,V](values Map[K,V]) bool {
    return len(values) == 0;
}

// Capture the table before calling hash, which can re-enter the Map. Use its
// result as a separate index so the existing table handle can be borrowed.
func bucket_index[K hash.Hash](key K, capacity usize) usize {
    // Bucket arrays start at INITIAL_CAPACITY and only grow by doubling.
    return usize(K.hash(key) & u64(capacity - 1));
}

func find_index[K hash.Hash,V](bucket Vec[Entry[K,V]], key K) option.Option[usize] {
    // Index loop: an element is replaced only after this loop has ended.
    for var index usize = 0; index < vec.len(bucket); index += 1 {
        if K.equals(bucket[index].key, key) {
            return option.Option[usize].Some(index);
        }
    }
    return option.Option[usize].None;
}

func grow[K hash.Hash,V](values Map[K,V], current Vec[Vec[Entry[K,V]]]) {
    let capacity = vec.len(current);
    if capacity > MAX_USIZE / 2 {
        // A Vec of bucket handles cannot hold this many elements. Let Vec
        // report the same allocation-size Panic before publishing any state.
        let rejected = empty_buckets[K,V](MAX_USIZE);
        return;
    }
    let larger = capacity * 2;
    let buckets = empty_buckets[K,V](larger);
    let allocated = vec.make[bool](larger, false);
    for var index usize = 0; index < capacity; index += 1 {
        let bucket = current[index];
        for var position usize = 0; position < vec.len(bucket); position += 1 {
            let entry = bucket[position];
            let target = bucket_index(entry.key, larger);
            vec.push(ensure_bucket[K,V](buckets, allocated, target), entry);
        }
    }
    // Publish allocation flags first. Releasing their old Vec cannot invoke
    // a key or value callback.
    values.allocated[0] = allocated;
    values.buckets[0] = buckets;
}

// insert replaces an existing value or adds a new entry. It returns the
// previous value when the key was already present.
pub func insert[K hash.Hash,V](values Map[K,V], key K, value V) option.Option[V] {
    let buckets = values.buckets[0];
    let allocated = values.allocated[0];
    let capacity = vec.len(buckets);
    let index = bucket_index(key, capacity);
    let bucket = ensure_bucket[K,V](buckets, allocated, index);
    switch find_index(bucket, key) {
        case option.Option.Some(position): {
            let previous = bucket[position].value;
            bucket[position].value = value;
            return option.Option[V].Some(previous);
        }
        case option.Option.None: {
            vec.push(bucket, Entry[K,V](key: key, value: value));
            values.size[0] = values.size[0] + 1;
            if values.size[0] > capacity - capacity / 4 {
                grow(values, buckets);
            }
            return option.Option[V].None;
        }
    }
}

// get returns a copy of the stored value; owned values are retained by the
// returned Option and can outlive the map.
pub func get[K hash.Hash,V](values Map[K,V], key K) option.Option[V] {
    let buckets = values.buckets[0];
    let index = bucket_index(key, vec.len(buckets));
    let bucket = buckets[index];
    switch find_index(bucket, key) {
        case option.Option.Some(position): return option.Option[V].Some(bucket[position].value);
        case option.Option.None: return option.Option[V].None;
    }
}

pub func contains[K hash.Hash,V](values Map[K,V], key K) bool {
    switch get(values, key) {
        case option.Option.Some(found): return true;
        case option.Option.None: return false;
    }
}

// remove deletes an entry and returns the removed value. Removal uses
// swap-with-last inside the bucket, so it is O(bucket length). Capacity is
// not shrunk.
pub func remove[K hash.Hash,V](values Map[K,V], key K) option.Option[V] {
    let buckets = values.buckets[0];
    let index = bucket_index(key, vec.len(buckets));
    let bucket = buckets[index];
    switch find_index(bucket, key) {
        case option.Option.Some(position): {
            let removed = bucket[position].value;
            let last = vec.len(bucket) - 1;
            if position != last {
                bucket[position] = bucket[last];
            }
            let discarded = vec.pop(bucket);
            values.size[0] = values.size[0] - 1;
            return option.Option[V].Some(removed);
        }
        case option.Option.None: return option.Option[V].None;
    }
}

// clear removes all entries and resets the bucket array to the initial
// capacity. Existing aliases observe the cleared map.
pub func clear[K hash.Hash,V](values Map[K,V]) {
    values.size[0] = 0;
    let buckets = empty_buckets[K,V](INITIAL_CAPACITY);
    let allocated = vec.make[bool](INITIAL_CAPACITY, false);
    values.allocated[0] = allocated;
    values.buckets[0] = buckets;
}

// keys, values and entries return snapshots. Mutating the map afterwards
// does not invalidate the returned Vec.
pub func keys[K hash.Hash,V](values Map[K,V]) Vec[K] {
    let out = vec.empty[K]();
    vec.reserve(out, len(values));
    let buckets = values.buckets[0];
    for var index usize = 0; index < vec.len(buckets); index += 1 {
        let bucket = buckets[index];
        for var position usize = 0; position < vec.len(bucket); position += 1 {
            vec.push(out, bucket[position].key);
        }
    }
    return out;
}

pub func values[K hash.Hash,V](values Map[K,V]) Vec[V] {
    let out = vec.empty[V]();
    vec.reserve(out, len(values));
    let buckets = values.buckets[0];
    for var index usize = 0; index < vec.len(buckets); index += 1 {
        let bucket = buckets[index];
        for var position usize = 0; position < vec.len(bucket); position += 1 {
            vec.push(out, bucket[position].value);
        }
    }
    return out;
}

pub func entries[K hash.Hash,V](values Map[K,V]) Vec[Entry[K,V]] {
    let out = vec.empty[Entry[K,V]]();
    vec.reserve(out, len(values));
    let buckets = values.buckets[0];
    for var index usize = 0; index < vec.len(buckets); index += 1 {
        let bucket = buckets[index];
        for var position usize = 0; position < vec.len(bucket); position += 1 {
            vec.push(out, bucket[position]);
        }
    }
    return out;
}
