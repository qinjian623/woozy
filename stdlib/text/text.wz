package text;
import "std/result" as result;
import "std/vec" as vec;
import "std/option" as option;
pub enum Error { InvalidUtf8; InvalidScalar(value u32); }
pub func len(value string) usize { return __woozy_text_len(value); }
pub func byte_len(value string) usize { return __woozy_text_byte_len(value); }
pub func from_bytes(value Vec[u8]) string throws Error {
    switch __woozy_text_from_bytes(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidUtf8;
    }
}
pub func from_rune(value u32) string throws Error {
    switch __woozy_text_from_rune(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidScalar(value);
    }
}
pub func bytes(value string) Vec[u8] { return __woozy_text_bytes(value); }

// Cursor positions are offsets in one immutable string. The backend
// chooses the units; only the step returned by read advances a cursor.
const CURSOR_STEP_MASK u64 = 0xffffffff;

pub func runes(value string) Vec[u32] {
    let out = vec.empty[u32]();
    let length = len(value);
    vec.reserve(out,length);
    var cursor u64 = 0;
    for var index usize = 0; index < length; index += 1 {
        let read = __woozy_text_cursor_read(value,cursor);
        vec.push(out,u32(read >> 32));
        cursor += read & CURSOR_STEP_MASK;
    }
    return out;
}
pub func starts_with(value string, prefix string) bool {
    return len(prefix) <= len(value) && value[:len(prefix)] == prefix;
}
pub func ends_with(value string, suffix string) bool {
    return len(suffix) <= len(value) && value[len(value)-len(suffix):] == suffix;
}
struct SearchCursor {
    offset u64;
    index usize;
}

// KMP visits each scalar once. The failure table bounds the total number
// of fallbacks by the number of forward matches.
func match_table(pattern Vec[u32]) Vec[usize] {
    let length = vec.len(pattern);
    let fallback = vec.make[usize](length,0);
    var matched usize = 0;
    for var index usize = 1; index < length; index += 1 {
        matched = match_rune(pattern,fallback,matched,pattern[index]);
        fallback[index] = matched;
    }
    return fallback;
}
func match_rune(pattern Vec[u32], fallback Vec[usize], matched usize, rune u32) usize {
    var available = matched;
    for true {
        if pattern[available] == rune { return available+1; }
        if available == 0 { return 0; }
        available = fallback[available-1];
    }
}

// Save the position just past the last match. After an overlapping match,
// its longest proper border can begin the next one.
func scan_matches(value string, pattern Vec[u32], fallback Vec[usize],
    cursor inout SearchCursor, limit usize, overlap bool) usize {
    let length = len(value);
    let pattern_length = vec.len(pattern);
    var index = cursor.index;
    var offset = cursor.offset;
    var matched usize = 0;
    var total usize = 0;
    var end = cursor;
    for index < length {
        let read = __woozy_text_cursor_read(value,offset);
        offset += read & CURSOR_STEP_MASK;
        index += 1;
        matched = match_rune(pattern,fallback,matched,u32(read >> 32));
        if matched == pattern_length {
            end = SearchCursor(offset:offset,index:index);
            total += 1;
            if total == limit { break; }
            matched = 0;
            if overlap { matched = fallback[pattern_length-1]; }
        }
    }
    cursor = end;
    return total;
}

pub func find_from(value string, needle string, start usize) option.Option[usize] {
    let value_length = len(value);
    let needle_length = len(needle);
    if start > value_length || needle_length > value_length-start {
        return option.Option[usize].None;
    }
    if needle_length == 0 { return option.Option[usize].Some(start); }
    let pattern = runes(needle);
    let fallback = match_table(pattern);
    var cursor = SearchCursor(offset:__woozy_text_cursor_at(value,start),
        index:start);
    if scan_matches(value,pattern,fallback,inout cursor,1,false) != 0 {
        return option.Option[usize].Some(cursor.index-needle_length);
    }
    return option.Option[usize].None;
}
pub func find(value string, needle string) option.Option[usize] {
    return find_from(value,needle,0);
}
pub func contains(value string, needle string) bool {
    switch find(value,needle) {
        case option.Option.Some(index): return true;
        case option.Option.None: return false;
    }
}
pub func split(value string, separator string) Vec[string] {
    return split_n(value,separator,~usize(0));
}
pub func join(values Vec[string], separator string) string {
    var out = "";
    var first = true;
    for value in values {
        if !first { out += separator; }
        out += value;
        first = false;
    }
    return out;
}
pub func replace(value string, old string, replacement string) string {
    if len(old) == 0 {
        var out = replacement;
        for var index usize = 0; index < len(value); index += 1 {
            out += value[index:index+1];
            out += replacement;
        }
        return out;
    }
    return join(split(value,old),replacement);
}
pub func repeat(value string, count usize) string {
    var out = "";
    var block = value;
    var remaining = count;
    for remaining != 0 {
        if (remaining & 1) != 0 { out += block; }
        remaining = remaining >> 1;
        if remaining != 0 { block += block; }
    }
    return out;
}
pub func is_space(rune u32) bool {
    return (rune >= 9 && rune <= 13) || rune == 32 || rune == 0x85 ||
        rune == 0xa0 || rune == 0x1680 || (rune >= 0x2000 && rune <= 0x200a) ||
        rune == 0x2028 || rune == 0x2029 || rune == 0x202f || rune == 0x205f || rune == 0x3000;
}
pub func trim(value string) string {
    var start usize = 0;
    var end = len(value);
    for start < end && is_space(value[start]) { start += 1; }
    for start < end && is_space(value[end-1]) { end -= 1; }
    return value[start:end];
}
pub func ascii_lower(value string) string {
    var out = "";
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    for var index usize = 0; index < len(value); index += 1 {
        let rune = value[index];
        if rune >= 65 && rune <= 90 {
            let offset = usize(rune-65);
            out += alphabet[offset:offset+1];
        } else { out += value[index:index+1]; }
    }
    return out;
}
pub func ascii_upper(value string) string {
    var out = "";
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    for var index usize = 0; index < len(value); index += 1 {
        let rune = value[index];
        if rune >= 97 && rune <= 122 {
            let offset = usize(rune-97);
            out += alphabet[offset:offset+1];
        } else { out += value[index:index+1]; }
    }
    return out;
}

pub func find_last(value string, needle string) option.Option[usize] {
    let length = len(value);
    let needle_length = len(needle);
    if needle_length == 0 { return option.Option[usize].Some(length); }
    if needle_length > length { return option.Option[usize].None; }
    let pattern = runes(needle);
    let fallback = match_table(pattern);
    var cursor = SearchCursor(offset:0,index:0);
    if scan_matches(value,pattern,fallback,inout cursor,~usize(0),true) != 0 {
        return option.Option[usize].Some(cursor.index-needle_length);
    }
    return option.Option[usize].None;
}

pub func count(value string, needle string) usize {
    let length = len(value);
    let needle_length = len(needle);
    if needle_length == 0 { return length+1; }
    if needle_length > length { return 0; }
    // A single scalar has no prefix or overlap state to maintain.
    if needle_length == 1 { return __woozy_text_count_rune(value,needle[0]); }
    let pattern = runes(needle);
    let fallback = match_table(pattern);
    var cursor = SearchCursor(offset:0,index:0);
    return scan_matches(value,pattern,fallback,inout cursor,~usize(0),false);
}

pub func split_n(value string, separator string, limit usize) Vec[string] {
    let out = vec.empty[string]();
    if limit == 0 { return out; }
    let length = len(value);
    let separator_length = len(separator);
    if limit == 1 || separator_length > length {
        vec.push(out,value);
        return out;
    }
    let end = __woozy_text_cursor_at(value,length);
    if separator_length == 0 {
        var offset u64 = 0;
        for var pieces usize = 0; offset < end && pieces+1 < limit; pieces += 1 {
            let read = __woozy_text_cursor_read(value,offset);
            let next = offset + (read & CURSOR_STEP_MASK);
            vec.push(out,__woozy_text_cursor_slice(value,offset,next));
            offset = next;
        }
        if offset < end { vec.push(out,__woozy_text_cursor_slice(value,offset,end)); }
        return out;
    }
    let pattern = runes(separator);
    let fallback = match_table(pattern);
    // A matched separator occupies the same cursor distance in either string.
    let width = __woozy_text_cursor_at(separator,separator_length);
    var cursor = SearchCursor(offset:0,index:0);
    var start u64 = 0;
    for var pieces usize = 0; pieces+1 < limit; pieces += 1 {
        if scan_matches(value,pattern,fallback,inout cursor,1,false) == 0 { break; }
        vec.push(out,__woozy_text_cursor_slice(value,start,cursor.offset-width));
        start = cursor.offset;
    }
    if start == 0 { vec.push(out,value); }
    else { vec.push(out,__woozy_text_cursor_slice(value,start,end)); }
    return out;
}

pub func split_lines(value string) Vec[string] {
    let out = vec.empty[string]();
    let end = __woozy_text_cursor_at(value,len(value));
    var start u64 = 0;
    var offset u64 = 0;
    for offset < end {
        let read = __woozy_text_cursor_read(value,offset);
        let rune = u32(read >> 32);
        let next = offset + (read & CURSOR_STEP_MASK);
        if rune == 10 || rune == 13 {
            vec.push(out,__woozy_text_cursor_slice(value,start,offset));
            offset = next;
            if rune == 13 && offset < end {
                let following = __woozy_text_cursor_read(value,offset);
                if u32(following >> 32) == 10 {
                    offset += following & CURSOR_STEP_MASK;
                }
            }
            start = offset;
        } else { offset = next; }
    }
    if start < end { vec.push(out,__woozy_text_cursor_slice(value,start,end)); }
    return out;
}

pub func trim_start(value string) string {
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var offset usize = 0;
    for offset < data_bytes {
        if !is_space(utf8_decode(data,offset)) { break; }
        offset = utf8_next(data,offset);
    }
    if offset == 0 { return value; }
    return text_from_span(data,offset,data_bytes);
}
pub func trim_end(value string) string {
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var end usize = data_bytes;
    for end > 0 {
        let start = utf8_prev(data,end);
        if !is_space(utf8_decode(data,start)) { break; }
        end = start;
    }
    if end == data_bytes { return value; }
    return text_from_span(data,0,end);
}
pub func strip_prefix(value string, prefix string) option.Option[string] {
    if !starts_with(value,prefix) { return option.Option[string].None; }
    return option.Option[string].Some(value[len(prefix):]);
}
pub func strip_suffix(value string, suffix string) option.Option[string] {
    if !ends_with(value,suffix) { return option.Option[string].None; }
    return option.Option[string].Some(value[0:len(value)-len(suffix)]);
}
func utf8_next(data Vec[u8], offset usize) usize {
    let first = data[offset];
    if first < 0x80 { return offset+1; }
    if first < 0xe0 { return offset+2; }
    if first < 0xf0 { return offset+3; }
    return offset+4;
}
func utf8_prev(data Vec[u8], end usize) usize {
    var start = end-1;
    for start > 0 && (data[start] & 0xc0) == 0x80 { start -= 1; }
    return start;
}
func utf8_decode(data Vec[u8], offset usize) u32 {
    let first = u32(data[offset]);
    if first < 0x80 { return first; }
    if first < 0xe0 {
        return ((first & 0x1f) << 6) | (u32(data[offset+1]) & 0x3f);
    }
    if first < 0xf0 {
        return ((first & 0x0f) << 12) | ((u32(data[offset+1]) & 0x3f) << 6) |
            (u32(data[offset+2]) & 0x3f);
    }
    return ((first & 0x07) << 18) | ((u32(data[offset+1]) & 0x3f) << 12) |
        ((u32(data[offset+2]) & 0x3f) << 6) | (u32(data[offset+3]) & 0x3f);
}
func text_from_span(data Vec[u8], start usize, end usize) string {
    // Callers pass complete UTF-8 code point spans from an existing string.
    try {
        return from_bytes(data[start:end]);
    } catch error Error {
        return "";
    }
}
