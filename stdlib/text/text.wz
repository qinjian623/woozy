package text;
import "std/result" as result;
import "std/vec" as vec;
import "std/option" as option;
pub const MAX_PADDING_WIDTH usize = 1_000_000;
pub enum Error { InvalidUtf8; InvalidScalar(value u32); }
// Padding has its own error type so adding width limits does not change the
// existing conversion error or break exhaustive matches on text.Error.
pub enum PaddingError { InvalidScalar(value u32); WidthTooLarge(value usize); }
const PAD_LEFT u32 = 0;
const PAD_RIGHT u32 = 1;
const PAD_CENTER u32 = 2;
pub func len(value string) usize { return __woozy_text_len(value); }
pub func byte_len(value string) usize { return __woozy_text_byte_len(value); }
pub func from_bytes(value Vec[u8]) string throws Error {
    switch __woozy_text_from_bytes(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidUtf8;
    }
}
pub func from_rune(value u32) string throws Error {
    switch __woozy_text_from_rune(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidScalar(value);
    }
}
pub func bytes(value string) Vec[u8] { return __woozy_text_bytes(value); }

// Cursor positions are offsets in one immutable string. The backend
// chooses the units; only the step returned by read advances a cursor.
const CURSOR_STEP_MASK u64 = 0xffffffff;

pub func runes(value string) Vec[u32] {
    let out = vec.empty[u32]();
    let length = len(value);
    vec.reserve(out,length);
    var cursor u64 = 0;
    for var index usize = 0; index < length; index += 1 {
        let read = __woozy_text_cursor_read(value,cursor);
        vec.push(out,u32(read >> 32));
        cursor += read & CURSOR_STEP_MASK;
    }
    return out;
}
pub func starts_with(value string, prefix string) bool {
    return len(prefix) <= len(value) && value[:len(prefix)] == prefix;
}
pub func ends_with(value string, suffix string) bool {
    return len(suffix) <= len(value) && value[len(value)-len(suffix):] == suffix;
}
struct SearchCursor {
    offset u64;
    index usize;
}

// KMP visits each scalar once. The failure table bounds the total number
// of fallbacks by the number of forward matches.
func match_table(pattern Vec[u32]) Vec[usize] {
    let length = vec.len(pattern);
    let fallback = vec.make[usize](length,0);
    var matched usize = 0;
    for var index usize = 1; index < length; index += 1 {
        matched = match_rune(pattern,fallback,matched,pattern[index]);
        fallback[index] = matched;
    }
    return fallback;
}
func match_rune(pattern Vec[u32], fallback Vec[usize], matched usize, rune u32) usize {
    var available = matched;
    for true {
        if pattern[available] == rune { return available+1; }
        if available == 0 { return 0; }
        available = fallback[available-1];
    }
}

// Save the position just past the last match. After an overlapping match,
// its longest proper border can begin the next one.
func scan_matches(value string, pattern Vec[u32], fallback Vec[usize],
    cursor inout SearchCursor, limit usize, overlap bool) usize {
    let length = len(value);
    let pattern_length = vec.len(pattern);
    var index = cursor.index;
    var offset = cursor.offset;
    var matched usize = 0;
    var total usize = 0;
    var end = cursor;
    for index < length {
        let read = __woozy_text_cursor_read(value,offset);
        offset += read & CURSOR_STEP_MASK;
        index += 1;
        matched = match_rune(pattern,fallback,matched,u32(read >> 32));
        if matched == pattern_length {
            end = SearchCursor(offset:offset,index:index);
            total += 1;
            if total == limit { break; }
            matched = 0;
            if overlap { matched = fallback[pattern_length-1]; }
        }
    }
    cursor = end;
    return total;
}

pub func find_from(value string, needle string, start usize) option.Option[usize] {
    let value_length = len(value);
    let needle_length = len(needle);
    if start > value_length || needle_length > value_length-start {
        return option.Option[usize].None;
    }
    if needle_length == 0 { return option.Option[usize].Some(start); }
    let offset = __woozy_text_cursor_at(value,start);
    if needle_length == 1 {
        let rune = needle[0];
        var cursor = offset;
        for var index = start; index < value_length; index += 1 {
            let read = __woozy_text_cursor_read(value,cursor);
            if u32(read >> 32) == rune { return option.Option[usize].Some(index); }
            cursor += read & CURSOR_STEP_MASK;
        }
        return option.Option[usize].None;
    }
    let pattern = runes(needle);
    let fallback = match_table(pattern);
    var cursor = SearchCursor(offset:offset,index:start);
    if scan_matches(value,pattern,fallback,inout cursor,1,false) != 0 {
        return option.Option[usize].Some(cursor.index-needle_length);
    }
    return option.Option[usize].None;
}
pub func find(value string, needle string) option.Option[usize] {
    return find_from(value,needle,0);
}
pub func contains(value string, needle string) bool {
    switch find(value,needle) {
        case option.Option.Some(index): return true;
        case option.Option.None: return false;
    }
}
pub func split(value string, separator string) Vec[string] {
    return split_n(value,separator,~usize(0));
}
// split_whitespace splits on Unicode White_Space exactly as is_space defines
// it. Empty fields are discarded, so an empty or all-whitespace input returns
// an empty Vec. Embedded NUL is ordinary non-whitespace text.
pub func split_whitespace(value string) Vec[string] {
    let out = vec.empty[string]();
    let end = __woozy_text_cursor_at(value,len(value));
    var offset u64 = 0;
    var start u64 = 0;
    var in_field = false;
    for offset < end {
        let read = __woozy_text_cursor_read(value,offset);
        let next = offset + (read & CURSOR_STEP_MASK);
        if is_space(u32(read >> 32)) {
            if in_field {
                vec.push(out,__woozy_text_cursor_slice(value,start,offset));
                in_field = false;
            }
        } else if !in_field {
            start = offset;
            in_field = true;
        }
        offset = next;
    }
    if in_field { vec.push(out,__woozy_text_cursor_slice(value,start,end)); }
    return out;
}
pub func join(values Vec[string], separator string) string {
    let count = vec.len(values);
    if count == 0 { return ""; }
    if count == 1 { return values[0]; }
    let out = vec.empty[u8]();
    let gap = bytes(separator);
    for var index usize = 0; index < count; index += 1 {
        if index != 0 { append_bytes(out,gap); }
        append_text(out,values[index]);
    }
    return text_from_buffer(out);
}
// Return the cursor after the next occurrence. Zero denotes no match because
// every scalar advances the cursor by at least one unit.
func next_scalar(value string, needle u32, start u64, end u64) u64 {
    var offset = start;
    for offset < end {
        let read = __woozy_text_cursor_read(value,offset);
        offset += read & CURSOR_STEP_MASK;
        if u32(read >> 32) == needle { return offset; }
    }
    return 0;
}

func replace_scalar(value string, old string, replacement string) string {
    let needle = old[0];
    let end = __woozy_text_cursor_at(value,len(value));
    var matched = next_scalar(value,needle,0,end);
    if matched == 0 { return value; }

    let width = __woozy_text_cursor_at(old,1);
    let out = vec.empty[u8]();
    let inserted = bytes(replacement);
    // Equal-width and expanding replacements cannot shorten the result.
    if vec.len(inserted) >= byte_len(old) { vec.reserve(out,byte_len(value)); }
    var start u64 = 0;
    for matched != 0 {
        let stop = matched-width;
        if start < stop {
            append_text(out,__woozy_text_cursor_slice(value,start,stop));
        }
        append_bytes(out,inserted);
        start = matched;
        matched = next_scalar(value,needle,start,end);
    }
    if start < end {
        append_text(out,__woozy_text_cursor_slice(value,start,end));
    }
    return text_from_buffer(out);
}

pub func replace(value string, old string, replacement string) string {
    let length = len(old);
    if length == 0 { return replace_empty(value,replacement); }
    if length == 1 { return replace_scalar(value,old,replacement); }
    return join(split(value,old),replacement);
}
pub func repeat(value string, count usize) string {
    var out = "";
    var block = value;
    var remaining = count;
    for remaining != 0 {
        if (remaining & 1) != 0 { out += block; }
        remaining = remaining >> 1;
        if remaining != 0 { block += block; }
    }
    return out;
}
// Padding widths count Unicode code points, not bytes or display columns.
// pad_left adds fill on the left (right-aligning value); pad_right adds fill
// on the right (left-aligning it). A width at or below len(value) returns value
// unchanged. The fill rune must be a Unicode scalar value and is validated
// even when no padding is needed. Widths above MAX_PADDING_WIDTH throw
// PaddingError.WidthTooLarge.
pub func pad_left(value string, width usize) string throws PaddingError {
    return pad_left_with(value,width,32);
}
pub func pad_left_with(value string, width usize, fill u32) string throws PaddingError {
    return pad_with(value,width,fill,PAD_LEFT);
}
pub func pad_right(value string, width usize) string throws PaddingError {
    return pad_right_with(value,width,32);
}
pub func pad_right_with(value string, width usize, fill u32) string throws PaddingError {
    return pad_with(value,width,fill,PAD_RIGHT);
}
// pad_center puts the extra fill rune on the right when the padding is odd.
pub func pad_center(value string, width usize) string throws PaddingError {
    return pad_center_with(value,width,32);
}
pub func pad_center_with(value string, width usize, fill u32) string throws PaddingError {
    return pad_with(value,width,fill,PAD_CENTER);
}
// Unicode 18.0.0 White_Space. This is the complete property: U+0009..U+000D,
// U+0020, U+0085, U+00A0, U+1680, U+2000..U+200A, U+2028, U+2029, U+202F,
// U+205F and U+3000. U+180E, U+200B and U+FEFF are not White_Space.
pub func is_space(rune u32) bool {
    return (rune >= 9 && rune <= 13) || rune == 32 || rune == 0x85 ||
        rune == 0xa0 || rune == 0x1680 || (rune >= 0x2000 && rune <= 0x200a) ||
        rune == 0x2028 || rune == 0x2029 || rune == 0x202f || rune == 0x205f || rune == 0x3000;
}
pub func trim(value string) string {
    let length = len(value);
    if length == 0 { return value; }
    // End checks use existing code point indexing, so an obvious no-op needs
    // no bytes(value) scratch. Actual trimming still needs one O(n) byte copy.
    if !is_space(value[0]) && !is_space(value[length-1]) { return value; }
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var start usize = 0;
    for start < data_bytes {
        if !is_space(utf8_decode(data,start)) { break; }
        start = utf8_next(data,start);
    }
    var end usize = data_bytes;
    for end > start {
        let previous = utf8_prev(data,end);
        if !is_space(utf8_decode(data,previous)) { break; }
        end = previous;
    }
    if start == 0 && end == data_bytes { return value; }
    return text_from_span(data,start,end);
}
pub func ascii_lower(value string) string {
    return ascii_shift(value,65,90,97);
}
pub func ascii_upper(value string) string {
    return ascii_shift(value,97,122,65);
}

pub func find_last(value string, needle string) option.Option[usize] {
    let length = len(value);
    let needle_length = len(needle);
    if needle_length == 0 { return option.Option[usize].Some(length); }
    if needle_length > length { return option.Option[usize].None; }
    let pattern = runes(needle);
    let fallback = match_table(pattern);
    var cursor = SearchCursor(offset:0,index:0);
    if scan_matches(value,pattern,fallback,inout cursor,~usize(0),true) != 0 {
        return option.Option[usize].Some(cursor.index-needle_length);
    }
    return option.Option[usize].None;
}

pub func count(value string, needle string) usize {
    let length = len(value);
    let needle_length = len(needle);
    if needle_length == 0 { return length+1; }
    if needle_length > length { return 0; }
    // A single scalar has no prefix or overlap state to maintain.
    if needle_length == 1 { return __woozy_text_count_rune(value,needle[0]); }
    let pattern = runes(needle);
    let fallback = match_table(pattern);
    var cursor = SearchCursor(offset:0,index:0);
    return scan_matches(value,pattern,fallback,inout cursor,~usize(0),false);
}

pub func split_n(value string, separator string, limit usize) Vec[string] {
    let out = vec.empty[string]();
    if limit == 0 { return out; }
    let length = len(value);
    let separator_length = len(separator);
    if limit == 1 || separator_length > length {
        vec.push(out,value);
        return out;
    }
    let end = __woozy_text_cursor_at(value,length);
    if separator_length == 0 {
        var offset u64 = 0;
        for var pieces usize = 0; offset < end && pieces+1 < limit; pieces += 1 {
            let read = __woozy_text_cursor_read(value,offset);
            let next = offset + (read & CURSOR_STEP_MASK);
            vec.push(out,__woozy_text_cursor_slice(value,offset,next));
            offset = next;
        }
        if offset < end { vec.push(out,__woozy_text_cursor_slice(value,offset,end)); }
        return out;
    }
    // A matched separator occupies the same cursor distance in either string.
    let width = __woozy_text_cursor_at(separator,separator_length);
    var start u64 = 0;
    if separator_length == 1 {
        let rune = separator[0];
        for var pieces usize = 1; pieces < limit; pieces += 1 {
            let matched = next_scalar(value,rune,start,end);
            if matched == 0 { break; }
            vec.push(out,__woozy_text_cursor_slice(value,start,matched-width));
            start = matched;
        }
    } else {
        let pattern = runes(separator);
        let fallback = match_table(pattern);
        var cursor = SearchCursor(offset:0,index:0);
        for var pieces usize = 1; pieces < limit; pieces += 1 {
            if scan_matches(value,pattern,fallback,inout cursor,1,false) == 0 { break; }
            vec.push(out,__woozy_text_cursor_slice(value,start,cursor.offset-width));
            start = cursor.offset;
        }
    }
    if start == 0 { vec.push(out,value); }
    else { vec.push(out,__woozy_text_cursor_slice(value,start,end)); }
    return out;
}

pub func split_lines(value string) Vec[string] {
    let out = vec.empty[string]();
    let end = __woozy_text_cursor_at(value,len(value));
    var start u64 = 0;
    var offset u64 = 0;
    for offset < end {
        let read = __woozy_text_cursor_read(value,offset);
        let rune = u32(read >> 32);
        let next = offset + (read & CURSOR_STEP_MASK);
        if rune == 10 || rune == 13 {
            vec.push(out,__woozy_text_cursor_slice(value,start,offset));
            offset = next;
            if rune == 13 && offset < end {
                let following = __woozy_text_cursor_read(value,offset);
                if u32(following >> 32) == 10 {
                    offset += following & CURSOR_STEP_MASK;
                }
            }
            start = offset;
        } else { offset = next; }
    }
    if start < end { vec.push(out,__woozy_text_cursor_slice(value,start,end)); }
    return out;
}

pub func trim_start(value string) string {
    let length = len(value);
    if length == 0 { return value; }
    let initial = __woozy_text_cursor_read(value,0);
    if !is_space(u32(initial >> 32)) { return value; }
    var offset = initial & CURSOR_STEP_MASK;
    var first usize = 1;
    for first < length {
        let read = __woozy_text_cursor_read(value,offset);
        if !is_space(u32(read >> 32)) { break; }
        offset += read & CURSOR_STEP_MASK;
        first += 1;
    }
    if first == length { return ""; }
    // Keep the view when it covers at least as much data as it omits.
    // A smaller result should not keep a large discarded prefix alive.
    let suffix = value[first:];
    let size = byte_len(suffix);
    if size < byte_len(value)-size { return text_from_buffer(bytes(suffix)); }
    return suffix;
}
pub func trim_end(value string) string {
    let length = len(value);
    if length == 0 || !is_space(value[length-1]) { return value; }
    // Scan disjoint windows. Doubling the width bounds the total cost of
    // locating their starts by the distance to the cut.
    var end = length-1;
    var width usize = 1;
    for end > 0 {
        let start = end-width;
        var offset = __woozy_text_cursor_at(value,start);
        var cut = start;
        for var index usize = start; index < end; index += 1 {
            let read = __woozy_text_cursor_read(value,offset);
            offset += read & CURSOR_STEP_MASK;
            if !is_space(u32(read >> 32)) { cut = index+1; }
        }
        if cut != start {
            let prefix = value[0:cut];
            let size = byte_len(prefix);
            if size < byte_len(value)-size { return text_from_buffer(bytes(prefix)); }
            return prefix;
        }
        end = start;
        if width > end/2 { width = end; }
        else { width *= 2; }
    }
    return "";
}
pub func strip_prefix(value string, prefix string) option.Option[string] {
    if !starts_with(value,prefix) { return option.Option[string].None; }
    return option.Option[string].Some(value[len(prefix):]);
}
pub func strip_suffix(value string, suffix string) option.Option[string] {
    if !ends_with(value,suffix) { return option.Option[string].None; }
    return option.Option[string].Some(value[0:len(value)-len(suffix)]);
}
func pad_with(value string, width usize, fill u32, mode u32) string throws PaddingError {
    if width > MAX_PADDING_WIDTH { throw PaddingError.WidthTooLarge(width); }
    let fill_text = pad_fill(fill);
    let length = len(value);
    if width <= length { return value; }
    let total = width - length;
    if mode == PAD_LEFT { return repeat(fill_text,total) + value; }
    if mode == PAD_RIGHT { return value + repeat(fill_text,total); }
    let left = total / 2;
    return repeat(fill_text,left) + value + repeat(fill_text,total-left);
}
func pad_fill(fill u32) string throws PaddingError {
    try {
        return from_rune(fill);
    } catch problem Error {
        throw PaddingError.InvalidScalar(fill);
    }
}
func replace_empty(value string, replacement string) string {
    if len(replacement) == 0 { return value; }
    let data = bytes(value);
    let data_bytes = vec.len(data);
    let replacement_bytes = bytes(replacement);
    let out = vec.empty[u8]();
    vec.reserve(out,data_bytes+vec.len(replacement_bytes));
    append_bytes(out,replacement_bytes);
    var offset usize = 0;
    for offset < data_bytes {
        let next = utf8_next(data,offset);
        append_span(out,data,offset,next);
        append_bytes(out,replacement_bytes);
        offset = next;
    }
    return text_from_buffer(out);
}
func ascii_shift(value string, source_first u8, source_last u8,
        target_first u8) string {
    let length = len(value);
    if length == 0 { return value; }
    if length == 1 {
        let rune = value[0];
        if rune < u32(source_first) || rune > u32(source_last) {
            return value;
        }
    }
    // There is no zero-copy byte view in the public text API. Detecting that a
    // longer string has no byte in this range therefore costs one O(n)
    // bytes(value) scratch copy. The output buffer is only allocated after a
    // matching ASCII byte is found.
    let data = bytes(value);
    var changed = false;
    for byte in data {
        if byte >= source_first && byte <= source_last {
            changed = true;
            break;
        }
    }
    if !changed { return value; }
    let out = vec.empty[u8]();
    vec.reserve(out,vec.len(data));
    for byte in data {
        if byte >= source_first && byte <= source_last {
            vec.push(out,target_first + (byte-source_first));
        } else { vec.push(out,byte); }
    }
    return text_from_buffer(out);
}
func append_bytes(out Vec[u8], source Vec[u8]) {
    vec.extend(out,source);
}
func append_span(out Vec[u8], data Vec[u8], start usize, end usize) {
    for var index usize = start; index < end; index += 1 {
        vec.push(out,data[index]);
    }
}
func append_text(out Vec[u8], value string) {
    vec.extend(out,bytes(value));
}
func text_from_buffer(data Vec[u8]) string {
    // Callers only concatenate valid UTF-8 spans from existing strings.
    try {
        return from_bytes(data);
    } catch problem Error {
        return "";
    }
}
func utf8_next(data Vec[u8], offset usize) usize {
    let first = data[offset];
    if first < 0x80 { return offset+1; }
    if first < 0xe0 { return offset+2; }
    if first < 0xf0 { return offset+3; }
    return offset+4;
}
func utf8_prev(data Vec[u8], end usize) usize {
    var start = end-1;
    for start > 0 && (data[start] & 0xc0) == 0x80 { start -= 1; }
    return start;
}
func utf8_decode(data Vec[u8], offset usize) u32 {
    let first = u32(data[offset]);
    if first < 0x80 { return first; }
    if first < 0xe0 {
        return ((first & 0x1f) << 6) | (u32(data[offset+1]) & 0x3f);
    }
    if first < 0xf0 {
        return ((first & 0x0f) << 12) | ((u32(data[offset+1]) & 0x3f) << 6) |
            (u32(data[offset+2]) & 0x3f);
    }
    return ((first & 0x07) << 18) | ((u32(data[offset+1]) & 0x3f) << 12) |
        ((u32(data[offset+2]) & 0x3f) << 6) | (u32(data[offset+3]) & 0x3f);
}
func text_from_span(data Vec[u8], start usize, end usize) string {
    // Callers pass complete UTF-8 code point spans from an existing string.
    try {
        return from_bytes(data[start:end]);
    } catch error Error {
        return "";
    }
}
