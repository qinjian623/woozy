package text;
import "std/result" as result;
import "std/vec" as vec;
import "std/option" as option;
pub enum Error { InvalidUtf8; InvalidScalar(value u32); }
pub func len(value string) usize { return __woozy_text_len(value); }
pub func byte_len(value string) usize { return __woozy_text_byte_len(value); }
pub func from_bytes(value Vec[u8]) string throws Error {
    switch __woozy_text_from_bytes(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidUtf8;
    }
}
pub func from_rune(value u32) string throws Error {
    switch __woozy_text_from_rune(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidScalar(value);
    }
}
pub func bytes(value string) Vec[u8] { return __woozy_text_bytes(value); }

pub func runes(value string) Vec[u32] {
    let data = bytes(value);
    let out = vec.empty[u32]();
    vec.reserve(out,len(value));
    for var offset usize = 0; offset < vec.len(data); offset = utf8_next(data,offset) {
        vec.push(out,utf8_decode(data,offset));
    }
    return out;
}
pub func starts_with(value string, prefix string) bool {
    return len(prefix) <= len(value) && value[:len(prefix)] == prefix;
}
pub func ends_with(value string, suffix string) bool {
    return len(suffix) <= len(value) && value[len(value)-len(suffix):] == suffix;
}
pub func find_from(value string, needle string, start usize) option.Option[usize] {
    if start > len(value) || len(needle) > len(value)-start { return option.Option[usize].None; }
    for var index = start; index <= len(value)-len(needle); index += 1 {
        if value[index:index+len(needle)] == needle { return option.Option[usize].Some(index); }
    }
    return option.Option[usize].None;
}
pub func find(value string, needle string) option.Option[usize] {
    return find_from(value,needle,0);
}
pub func contains(value string, needle string) bool {
    switch find(value,needle) {
        case option.Option.Some(index): return true;
        case option.Option.None: return false;
    }
}
pub func split(value string, separator string) Vec[string] {
    let out = vec.empty[string]();
    if len(separator) == 0 {
        for var index usize = 0; index < len(value); index += 1 {
            vec.push(out,value[index:index+1]);
        }
        return out;
    }
    var start usize = 0;
    for true {
        switch find_from(value,separator,start) {
            case option.Option.Some(index): {
                vec.push(out,value[start:index]);
                start = index+len(separator);
            }
            case option.Option.None: {
                vec.push(out,value[start:]);
                return out;
            }
        }
    }
}
pub func join(values Vec[string], separator string) string {
    var out = "";
    var first = true;
    for value in values {
        if !first { out += separator; }
        out += value;
        first = false;
    }
    return out;
}
pub func replace(value string, old string, replacement string) string {
    if len(old) == 0 {
        var out = replacement;
        for var index usize = 0; index < len(value); index += 1 {
            out += value[index:index+1];
            out += replacement;
        }
        return out;
    }
    return join(split(value,old),replacement);
}
pub func repeat(value string, count usize) string {
    var out = "";
    var block = value;
    var remaining = count;
    for remaining != 0 {
        if (remaining & 1) != 0 { out += block; }
        remaining = remaining >> 1;
        if remaining != 0 { block += block; }
    }
    return out;
}
pub func is_space(rune u32) bool {
    return (rune >= 9 && rune <= 13) || rune == 32 || rune == 0x85 ||
        rune == 0xa0 || rune == 0x1680 || (rune >= 0x2000 && rune <= 0x200a) ||
        rune == 0x2028 || rune == 0x2029 || rune == 0x202f || rune == 0x205f || rune == 0x3000;
}
pub func trim(value string) string {
    var start usize = 0;
    var end = len(value);
    for start < end && is_space(value[start]) { start += 1; }
    for start < end && is_space(value[end-1]) { end -= 1; }
    return value[start:end];
}
pub func ascii_lower(value string) string {
    var out = "";
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    for var index usize = 0; index < len(value); index += 1 {
        let rune = value[index];
        if rune >= 65 && rune <= 90 {
            let offset = usize(rune-65);
            out += alphabet[offset:offset+1];
        } else { out += value[index:index+1]; }
    }
    return out;
}
pub func ascii_upper(value string) string {
    var out = "";
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    for var index usize = 0; index < len(value); index += 1 {
        let rune = value[index];
        if rune >= 97 && rune <= 122 {
            let offset = usize(rune-97);
            out += alphabet[offset:offset+1];
        } else { out += value[index:index+1]; }
    }
    return out;
}

pub func find_last(value string, needle string) option.Option[usize] {
    if needle == "" { return option.Option[usize].Some(len(value)); }
    if byte_len(needle) > byte_len(value) { return option.Option[usize].None; }
    let haystack = bytes(value);
    let pattern = bytes(needle);
    let pattern_bytes = vec.len(pattern);
    let haystack_bytes = vec.len(haystack);
    let fallback = match_table(pattern);
    var matched usize = 0;
    var last = haystack_bytes;
    for var offset usize = 0; offset < haystack_bytes; offset += 1 {
        matched = match_byte(pattern,fallback,matched,haystack[offset]);
        if matched == pattern_bytes {
            last = offset+1-pattern_bytes;
            matched = fallback[matched-1];
        }
    }
    if last == haystack_bytes { return option.Option[usize].None; }
    var index usize = 0;
    for var offset usize = 0; offset < last; offset = utf8_next(haystack,offset) {
        index += 1;
    }
    return option.Option[usize].Some(index);
}
func count_words(value string, target u8) option.Option[usize] {
    let byte_count = byte_len(value);
    let repeated = u64(target) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let x = word ^ repeated;
        let zero_flags = ~(((x & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) |
            x | 0x7f7f7f7f7f7f7f7f);
        total += usize((((zero_flags >> 7) * 0x0101010101010101) >> 56));
        offset += 8;
    }
    let remaining = byte_count - offset;
    if remaining != 0 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let x = word ^ repeated;
        var zero_flags = ~(((x & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) |
            x | 0x7f7f7f7f7f7f7f7f);
        zero_flags = zero_flags & (~u64(0) << ((8-remaining)*8));
        total += usize((((zero_flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
func byte_zero_flags(x u64) u64 {
    return ~(((x & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) |
        x | 0x7f7f7f7f7f7f7f7f);
}
// Count nonoverlapping matches of 2-4 byte patterns with a border.
// Each candidate start is the high bit of its byte. With wrapping u64
// arithmetic, flags & (~flags+1) selects the earliest one. Clear its span
// and carry any part that reaches into the next window.
func count_overlap(value string, pattern Vec[u8], byte_count usize,
    width usize) option.Option[usize] {
    let first = u64(pattern[0]) * 0x0101010101010101;
    let second = u64(pattern[1]) * 0x0101010101010101;
    var third u64 = 0;
    var fourth u64 = 0;
    if width >= 3 { third = u64(pattern[2]) * 0x0101010101010101; }
    if width == 4 { fourth = u64(pattern[3]) * 0x0101010101010101; }
    let stride = 9-width;
    let carry_shift = stride*8;
    var span_factor u64 = 0x0101;
    if width == 3 { span_factor = 0x010101; }
    else if width == 4 { span_factor = 0x01010101; }
    var total usize = 0;
    var offset usize = 0;
    var carry u64 = 0;
    for byte_count-offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        if width == 3 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16);
        } else if width == 4 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16) &
                (byte_zero_flags(word ^ fourth) >> 24);
        }
        flags = flags & ~carry;
        var blocked u64 = 0;
        for flags != 0 {
            let selected = flags & (~flags + 1);
            total += 1;
            blocked = selected * span_factor;
            flags = flags & ~blocked;
        }
        carry = blocked >> carry_shift;
        offset += stride;
    }
    if offset <= byte_count-width {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        if width == 3 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16);
        } else if width == 4 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16) &
                (byte_zero_flags(word ^ fourth) >> 24);
        }
        let tail = offset-(byte_count-8);
        flags = flags & (~u64(0) << (tail*8));
        carry = carry << (tail*8);
        flags = flags & ~carry;
        for flags != 0 {
            let selected = flags & (~flags + 1);
            total += 1;
            flags = flags & ~(selected * span_factor);
        }
    }
    return option.Option[usize].Some(total);
}
func count_two(value string, pattern Vec[u8], byte_count usize) option.Option[usize] {
    let first = u64(pattern[0]) * 0x0101010101010101;
    let second = u64(pattern[1]) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
        offset += 7;
    }
    if offset <= byte_count - 2 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        flags = flags & (~u64(0) << ((offset-(byte_count-8))*8));
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
func count_three(value string, pattern Vec[u8], byte_count usize) option.Option[usize] {
    let first = u64(pattern[0]) * 0x0101010101010101;
    let second = u64(pattern[1]) * 0x0101010101010101;
    let third = u64(pattern[2]) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16);
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
        offset += 6;
    }
    if offset <= byte_count - 3 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16);
        flags = flags & (~u64(0) << ((offset-(byte_count-8))*8));
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
func count_four(value string, pattern Vec[u8], byte_count usize) option.Option[usize] {
    let first = u64(pattern[0]) * 0x0101010101010101;
    let second = u64(pattern[1]) * 0x0101010101010101;
    let third = u64(pattern[2]) * 0x0101010101010101;
    let fourth = u64(pattern[3]) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16) &
            (byte_zero_flags(word ^ fourth) >> 24);
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
        offset += 5;
    }
    if offset <= byte_count - 4 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16) &
            (byte_zero_flags(word ^ fourth) >> 24);
        flags = flags & (~u64(0) << ((offset-(byte_count-8))*8));
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
pub func count(value string, needle string) usize {
    if needle == "" { return len(value)+1; }
    let value_bytes = byte_len(value);
    let needle_bytes = byte_len(needle);
    if needle_bytes > value_bytes { return 0; }
    if needle_bytes == 1 {
        let target = u8(needle[0]);
        if value_bytes >= 8 {
            switch count_words(value,target) {
                case option.Option.Some(total): return total;
                case option.Option.None: {}
            }
        }
        if value_bytes <= 32 && value_bytes == len(value) {
            var total usize = 0;
            for var index usize = 0; index < len(value); index += 1 {
                if value[index] == u32(target) { total += 1; }
            }
            return total;
        }
        let haystack = bytes(value);
        let haystack_bytes = vec.len(haystack);
        var total usize = 0;
        var offset usize = 0;
        for haystack_bytes - offset >= 8 {
            if haystack[offset] == target { total += 1; }
            if haystack[offset+1] == target { total += 1; }
            if haystack[offset+2] == target { total += 1; }
            if haystack[offset+3] == target { total += 1; }
            if haystack[offset+4] == target { total += 1; }
            if haystack[offset+5] == target { total += 1; }
            if haystack[offset+6] == target { total += 1; }
            if haystack[offset+7] == target { total += 1; }
            offset += 8;
        }
        for offset < haystack_bytes {
            if haystack[offset] == target { total += 1; }
            offset += 1;
        }
        return total;
    }
    let pattern = bytes(needle);
    if needle_bytes >= 2 && needle_bytes <= 4 && value_bytes >= 8 {
        // A border is a proper prefix that is also a suffix; only then can
        // matches overlap, so those patterns use the packed greedy path.
        var has_border = pattern[0] == pattern[needle_bytes-1];
        if needle_bytes == 4 &&
            pattern[0] == pattern[2] && pattern[1] == pattern[3] {
            has_border = true;
        }
        if !has_border {
            if needle_bytes == 2 {
                switch count_two(value,pattern,value_bytes) {
                    case option.Option.Some(total): return total;
                    case option.Option.None: {}
                }
            } else if needle_bytes == 3 {
                switch count_three(value,pattern,value_bytes) {
                    case option.Option.Some(total): return total;
                    case option.Option.None: {}
                }
            } else {
                switch count_four(value,pattern,value_bytes) {
                    case option.Option.Some(total): return total;
                    case option.Option.None: {}
                }
            }
        } else {
            switch count_overlap(value,pattern,value_bytes,needle_bytes) {
                case option.Option.Some(total): return total;
                case option.Option.None: {}
            }
        }
    }
    let haystack = bytes(value);
    let pattern_bytes = vec.len(pattern);
    let haystack_bytes = vec.len(haystack);
    let fallback = match_table(pattern);
    var matched usize = 0;
    var total usize = 0;
    for var offset usize = 0; offset < haystack_bytes; offset += 1 {
        matched = match_byte(pattern,fallback,matched,haystack[offset]);
        if matched == pattern_bytes {
            total += 1;
            matched = 0;
        }
    }
    return total;
}
pub func split_n(value string, separator string, limit usize) Vec[string] {
    let out = vec.empty[string]();
    if limit == 0 { return out; }
    if limit == 1 {
        vec.push(out,value);
        return out;
    }
    let haystack = bytes(value);
    let haystack_bytes = vec.len(haystack);
    if separator == "" {
        var offset usize = 0;
        var pieces usize = 0;
        for offset < haystack_bytes && pieces+1 < limit {
            let next = utf8_next(haystack,offset);
            vec.push(out,text_from_span(haystack,offset,next));
            pieces += 1;
            offset = next;
        }
        if offset < haystack_bytes {
            vec.push(out,text_from_span(haystack,offset,haystack_bytes));
        }
        return out;
    }
    let pattern = bytes(separator);
    let pattern_bytes = vec.len(pattern);
    if pattern_bytes > haystack_bytes {
        vec.push(out,value);
        return out;
    }
    let fallback = match_table(pattern);
    var matched usize = 0;
    var start usize = 0;
    var pieces usize = 0;
    for var offset usize = 0; offset < haystack_bytes && pieces+1 < limit; offset += 1 {
        matched = match_byte(pattern,fallback,matched,haystack[offset]);
        if matched == pattern_bytes {
            vec.push(out,text_from_span(haystack,start,offset+1-pattern_bytes));
            pieces += 1;
            start = offset+1;
            matched = 0;
        }
    }
    vec.push(out,text_from_span(haystack,start,haystack_bytes));
    return out;
}
pub func split_lines(value string) Vec[string] {
    let out = vec.empty[string]();
    let data = bytes(value);
    let data_bytes = vec.len(data);
    if data_bytes == 0 { return out; }
    var start usize = 0;
    var offset usize = 0;
    for offset < data_bytes {
        if data[offset] == 10 {
            vec.push(out,text_from_span(data,start,offset));
            offset += 1;
            start = offset;
        } else if data[offset] == 13 {
            vec.push(out,text_from_span(data,start,offset));
            offset += 1;
            if offset < data_bytes && data[offset] == 10 { offset += 1; }
            start = offset;
        } else {
            offset = utf8_next(data,offset);
        }
    }
    if start < data_bytes {
        vec.push(out,text_from_span(data,start,data_bytes));
    }
    return out;
}
pub func trim_start(value string) string {
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var offset usize = 0;
    for offset < data_bytes {
        if !is_space(utf8_decode(data,offset)) { break; }
        offset = utf8_next(data,offset);
    }
    if offset == 0 { return value; }
    return text_from_span(data,offset,data_bytes);
}
pub func trim_end(value string) string {
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var end usize = data_bytes;
    for end > 0 {
        let start = utf8_prev(data,end);
        if !is_space(utf8_decode(data,start)) { break; }
        end = start;
    }
    if end == data_bytes { return value; }
    return text_from_span(data,0,end);
}
pub func strip_prefix(value string, prefix string) option.Option[string] {
    if !starts_with(value,prefix) { return option.Option[string].None; }
    return option.Option[string].Some(value[len(prefix):]);
}
pub func strip_suffix(value string, suffix string) option.Option[string] {
    if !ends_with(value,suffix) { return option.Option[string].None; }
    return option.Option[string].Some(value[0:len(value)-len(suffix)]);
}
// A complete UTF-8 pattern begins with a leading byte, so byte matches
// also begin and end on code point boundaries.
func match_table(pattern Vec[u8]) Vec[usize] {
    let length = vec.len(pattern);
    let fallback = vec.make[usize](length,0);
    var matched usize = 0;
    for var index usize = 1; index < length; index += 1 {
        matched = match_byte(pattern,fallback,matched,pattern[index]);
        fallback[index] = matched;
    }
    return fallback;
}
func match_byte(pattern Vec[u8], fallback Vec[usize], matched usize, byte u8) usize {
    var available = matched;
    for available > 0 && pattern[available] != byte {
        available = fallback[available-1];
    }
    if pattern[available] == byte { return available+1; }
    return available;
}
func utf8_next(data Vec[u8], offset usize) usize {
    let first = data[offset];
    if first < 0x80 { return offset+1; }
    if first < 0xe0 { return offset+2; }
    if first < 0xf0 { return offset+3; }
    return offset+4;
}
func utf8_prev(data Vec[u8], end usize) usize {
    var start = end-1;
    for start > 0 && (data[start] & 0xc0) == 0x80 { start -= 1; }
    return start;
}
func utf8_decode(data Vec[u8], offset usize) u32 {
    let first = u32(data[offset]);
    if first < 0x80 { return first; }
    if first < 0xe0 {
        return ((first & 0x1f) << 6) | (u32(data[offset+1]) & 0x3f);
    }
    if first < 0xf0 {
        return ((first & 0x0f) << 12) | ((u32(data[offset+1]) & 0x3f) << 6) |
            (u32(data[offset+2]) & 0x3f);
    }
    return ((first & 0x07) << 18) | ((u32(data[offset+1]) & 0x3f) << 12) |
        ((u32(data[offset+2]) & 0x3f) << 6) | (u32(data[offset+3]) & 0x3f);
}
func text_from_span(data Vec[u8], start usize, end usize) string {
    // Callers pass complete UTF-8 code point spans from an existing string.
    try {
        return from_bytes(data[start:end]);
    } catch error Error {
        return "";
    }
}
