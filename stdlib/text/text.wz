package text;
import "std/result" as result;
import "std/vec" as vec;
import "std/option" as option;
pub const MAX_PADDING_WIDTH usize = 1_000_000;
pub enum Error { InvalidUtf8; InvalidScalar(value u32); }
// Padding has its own error type so adding width limits does not change the
// existing conversion error or break exhaustive matches on text.Error.
pub enum PaddingError { InvalidScalar(value u32); WidthTooLarge(value usize); }
const PAD_LEFT u32 = 0;
const PAD_RIGHT u32 = 1;
const PAD_CENTER u32 = 2;
const DIRECT_FIND_CODE_POINTS usize = 64;
const DIRECT_FIND_PATTERN_BYTES usize = 64;
pub func len(value string) usize { return __woozy_text_len(value); }
pub func byte_len(value string) usize { return __woozy_text_byte_len(value); }
pub func from_bytes(value Vec[u8]) string throws Error {
    switch __woozy_text_from_bytes(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidUtf8;
    }
}
pub func from_rune(value u32) string throws Error {
    switch __woozy_text_from_rune(value) {
        case result.Result.Ok(text): return text;
        case result.Result.Err(error): throw Error.InvalidScalar(value);
    }
}
pub func bytes(value string) Vec[u8] { return __woozy_text_bytes(value); }

pub func runes(value string) Vec[u32] {
    let data = bytes(value);
    let out = vec.empty[u32]();
    vec.reserve(out,len(value));
    for var offset usize = 0; offset < vec.len(data); offset = utf8_next(data,offset) {
        vec.push(out,utf8_decode(data,offset));
    }
    return out;
}
pub func starts_with(value string, prefix string) bool {
    return len(prefix) <= len(value) && value[:len(prefix)] == prefix;
}
pub func ends_with(value string, suffix string) bool {
    return len(suffix) <= len(value) && value[len(value)-len(suffix):] == suffix;
}
// Bounded tail match; callers bound scan_start and the remaining codepoints.
func find_tail(value string, needle string, scan_start usize,
    needle_points usize) option.Option[usize] {
    let suffix = value[scan_start:];
    let suffix_points = len(suffix);
    for var index usize = 0; index <= suffix_points-needle_points; index += 1 {
        if suffix[index:index+needle_points] == needle {
            return option.Option[usize].Some(scan_start+index);
        }
    }
    return option.Option[usize].None;
}
func find_large(value string, needle string, start usize, value_points usize,
    needle_points usize) option.Option[usize] {
    // Probe a few early starts before paying for the byte copy.
    var scan_start usize = start;
    if start < 8 && needle_points <= 8 {
        let last_start = value_points-needle_points;
        var index usize = start;
        var checked usize = 0;
        for index <= last_start && checked < 8 {
            if value[index:index+needle_points] == needle {
                return option.Option[usize].Some(index);
            }
            index += 1;
            checked += 1;
        }
        scan_start = index;
        if scan_start > last_start { return option.Option[usize].None; }
    }
    var word_backend = false;
    switch __woozy_text_load8(value,0) {
        case option.Option.Some(loaded): word_backend = true;
        case option.Option.None: {}
    }
    if !word_backend {
        for var index usize = scan_start; index <= value_points-needle_points; index += 1 {
            if value[index:index+needle_points] == needle {
                return option.Option[usize].Some(index);
            }
        }
        return option.Option[usize].None;
    }
    if scan_start <= value_points && value_points-scan_start <= 16 {
        return find_tail(value,needle,scan_start,needle_points);
    }
    let haystack = bytes(value);
    let value_bytes = vec.len(haystack);
    let needle_bytes = byte_len(needle);
    var start_byte usize = 0;
    if scan_start != 0 {
        if value_points == value_bytes {
            start_byte = scan_start;
        } else if value_points-scan_start < scan_start {
            start_byte = value_bytes;
            for var index usize = value_points; index > scan_start; index -= 1 {
                start_byte = utf8_prev(haystack,start_byte);
            }
        } else {
            var offset usize = 0;
            for var index usize = 0; index < scan_start; index += 1 {
                offset = utf8_next(haystack,offset);
            }
            start_byte = offset;
        }
    }
    if needle_bytes > value_bytes-start_byte {
        return option.Option[usize].None;
    }
    var cursor usize = scan_start;
    if needle_bytes == 1 {
        let target = u8(needle[0]);
        var offset usize = start_byte;
        for offset < value_bytes {
            cursor += 1;
            let byte = haystack[offset];
            if byte == target {
                return option.Option[usize].Some(cursor-1);
            }
            offset = utf8_next(haystack,offset);
        }
        return option.Option[usize].None;
    }
    let pattern = bytes(needle);
    let fallback = match_table(pattern);
    var matched usize = 0;
    for var offset usize = start_byte; offset < value_bytes; offset += 1 {
        let byte = haystack[offset];
        if (byte & 0xc0) != 0x80 { cursor += 1; }
        matched = match_byte(pattern,fallback,matched,byte);
        if matched == needle_bytes {
            return option.Option[usize].Some(cursor-needle_points);
        }
    }
    return option.Option[usize].None;
}
pub func find_from(value string, needle string, start usize) option.Option[usize] {
    let value_points = len(value);
    let needle_points = len(needle);
    if start > value_points { return option.Option[usize].None; }
    if needle_points == 0 { return option.Option[usize].Some(start); }
    if needle_points > value_points-start { return option.Option[usize].None; }
    // Tiny haystacks avoid the byte copy and suffix table used below.
    if value_points <= 32 {
        for var index usize = start; index <= value_points-needle_points; index += 1 {
            if value[index:index+needle_points] == needle {
                return option.Option[usize].Some(index);
            }
        }
        return option.Option[usize].None;
    }
    return find_large(value,needle,start,value_points,needle_points);
}
pub func find(value string, needle string) option.Option[usize] {
    return find_from(value,needle,0);
}
pub func contains(value string, needle string) bool {
    switch find(value,needle) {
        case option.Option.Some(index): return true;
        case option.Option.None: return false;
    }
}
pub func split(value string, separator string) Vec[string] {
    if len(value) > 32 {
        var word_backend = false;
        switch __woozy_text_load8(value,0) {
            case option.Option.Some(loaded): word_backend = true;
            case option.Option.None: {}
        }
        if word_backend { return split_n(value,separator,~usize(0)); }
    }
    let out = vec.empty[string]();
    let value_length = len(value);
    if value_length == 0 {
        if len(separator) != 0 { vec.push(out,""); }
        return out;
    }
    if len(separator) == 0 {
        return split_n(value,separator,value_length+1);
    }
    if byte_len(separator) > byte_len(value) {
        vec.push(out,value);
        return out;
    }
    // A non-empty separator consumes at least one code point, so the result
    // has at most value_length+1 pieces and split_n has identical behavior.
    return split_n(value,separator,value_length+1);
}
// split_whitespace splits on Unicode White_Space exactly as is_space defines
// it. Empty fields are discarded, so an empty or all-whitespace input returns
// an empty Vec. Embedded NUL is ordinary non-whitespace text.
pub func split_whitespace(value string) Vec[string] {
    let out = vec.empty[string]();
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var offset usize = 0;
    var start usize = 0;
    var in_field = false;
    for offset < data_bytes {
        let next = utf8_next(data,offset);
        if is_space(utf8_decode(data,offset)) {
            if in_field {
                vec.push(out,text_from_span(data,start,offset));
                in_field = false;
            }
        } else if !in_field {
            start = offset;
            in_field = true;
        }
        offset = next;
    }
    if in_field { vec.push(out,text_from_span(data,start,data_bytes)); }
    return out;
}
pub func join(values Vec[string], separator string) string {
    let count = vec.len(values);
    if count == 0 { return ""; }
    if count == 1 { return values[0]; }
    let out = vec.empty[u8]();
    let gap = bytes(separator);
    for var index usize = 0; index < count; index += 1 {
        if index != 0 { append_bytes(out,gap); }
        append_text(out,values[index]);
    }
    return text_from_buffer(out);
}
pub func replace(value string, old string, replacement string) string {
    if len(old) == 0 { return replace_empty(value,replacement); }
    if len(value) == 0 || byte_len(old) > byte_len(value) { return value; }
    let haystack = bytes(value);
    let pattern = bytes(old);
    let pattern_bytes = vec.len(pattern);
    switch find_bytes_from(haystack,pattern,0) {
        case option.Option.None: return value;
        case option.Option.Some(first): {
            let haystack_bytes = vec.len(haystack);
            if pattern_bytes <= DIRECT_FIND_PATTERN_BYTES &&
               haystack_bytes > DIRECT_FIND_CODE_POINTS {
                // A bounded number of string concatenations is linear and
                // avoids pushing an unchanged, potentially long span byte by byte.
                switch find_bytes_from(haystack,pattern,first+pattern_bytes) {
                    case option.Option.None:
                        return replace_sparse(value,old,replacement,haystack,first,haystack_bytes);
                    case option.Option.Some(second):
                        switch find_bytes_from(haystack,pattern,second+pattern_bytes) {
                            case option.Option.None:
                                return replace_sparse(value,old,replacement,haystack,first,second);
                            case option.Option.Some(third): {}
                        }
                }
            }
            let replacement_bytes = bytes(replacement);
            let out = vec.empty[u8]();
            vec.reserve(out,vec.len(haystack)+vec.len(replacement_bytes));
            append_span(out,haystack,0,first);
            append_bytes(out,replacement_bytes);
            var piece_start = first+pattern_bytes;
            if pattern_bytes <= DIRECT_FIND_PATTERN_BYTES {
                let first_byte = pattern[0];
                let limit = haystack_bytes-pattern_bytes;
                for var offset usize = piece_start; offset <= limit; offset += 1 {
                    if haystack[offset] != first_byte { continue; }
                    var index usize = 1;
                    for index < pattern_bytes && haystack[offset+index] == pattern[index] {
                        index += 1;
                    }
                    if index == pattern_bytes {
                        append_span(out,haystack,piece_start,offset);
                        append_bytes(out,replacement_bytes);
                        piece_start = offset+pattern_bytes;
                        offset = piece_start-1;
                    }
                }
            } else {
                let fallback = match_table(pattern);
                var matched usize = 0;
                for var offset usize = piece_start; offset < haystack_bytes; offset += 1 {
                    matched = match_byte(pattern,fallback,matched,haystack[offset]);
                    if matched == pattern_bytes {
                        append_span(out,haystack,piece_start,offset+1-pattern_bytes);
                        append_bytes(out,replacement_bytes);
                        piece_start = offset+1;
                        matched = 0;
                    }
                }
            }
            append_span(out,haystack,piece_start,haystack_bytes);
            return text_from_buffer(out);
        }
    }
}
func replace_sparse(value string, old string, replacement string,
                    data Vec[u8], first usize, second usize) string {
    let ascii = byte_len(value) == len(value);
    var begin = first;
    if !ascii { begin = utf8_span_length(data,0,first); }
    let end = begin+len(old);
    if second == vec.len(data) {
        return value[:begin]+replacement+value[end:];
    }
    var next = second;
    if !ascii { next = end+utf8_span_length(data,first+byte_len(old),second); }
    return value[:begin]+replacement+value[end:next]+replacement+value[next+len(old):];
}
pub func repeat(value string, count usize) string {
    var out = "";
    var block = value;
    var remaining = count;
    for remaining != 0 {
        if (remaining & 1) != 0 { out += block; }
        remaining = remaining >> 1;
        if remaining != 0 { block += block; }
    }
    return out;
}
// Padding widths count Unicode code points, not bytes or display columns.
// pad_left adds fill on the left (right-aligning value); pad_right adds fill
// on the right (left-aligning it). A width at or below len(value) returns value
// unchanged. The fill rune must be a Unicode scalar value and is validated
// even when no padding is needed. Widths above MAX_PADDING_WIDTH throw
// PaddingError.WidthTooLarge.
pub func pad_left(value string, width usize) string throws PaddingError {
    return pad_left_with(value,width,32);
}
pub func pad_left_with(value string, width usize, fill u32) string throws PaddingError {
    return pad_with(value,width,fill,PAD_LEFT);
}
pub func pad_right(value string, width usize) string throws PaddingError {
    return pad_right_with(value,width,32);
}
pub func pad_right_with(value string, width usize, fill u32) string throws PaddingError {
    return pad_with(value,width,fill,PAD_RIGHT);
}
// pad_center puts the extra fill rune on the right when the padding is odd.
pub func pad_center(value string, width usize) string throws PaddingError {
    return pad_center_with(value,width,32);
}
pub func pad_center_with(value string, width usize, fill u32) string throws PaddingError {
    return pad_with(value,width,fill,PAD_CENTER);
}
// Unicode 18.0.0 White_Space. This is the complete property: U+0009..U+000D,
// U+0020, U+0085, U+00A0, U+1680, U+2000..U+200A, U+2028, U+2029, U+202F,
// U+205F and U+3000. U+180E, U+200B and U+FEFF are not White_Space.
pub func is_space(rune u32) bool {
    return (rune >= 9 && rune <= 13) || rune == 32 || rune == 0x85 ||
        rune == 0xa0 || rune == 0x1680 || (rune >= 0x2000 && rune <= 0x200a) ||
        rune == 0x2028 || rune == 0x2029 || rune == 0x202f || rune == 0x205f || rune == 0x3000;
}
pub func trim(value string) string {
    let length = len(value);
    if length == 0 { return value; }
    // End checks use existing code point indexing, so an obvious no-op needs
    // no bytes(value) scratch. Actual trimming still needs one O(n) byte copy.
    if !is_space(value[0]) && !is_space(value[length-1]) { return value; }
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var start usize = 0;
    for start < data_bytes {
        if !is_space(utf8_decode(data,start)) { break; }
        start = utf8_next(data,start);
    }
    var end usize = data_bytes;
    for end > start {
        let previous = utf8_prev(data,end);
        if !is_space(utf8_decode(data,previous)) { break; }
        end = previous;
    }
    if start == 0 && end == data_bytes { return value; }
    return text_from_span(data,start,end);
}
pub func ascii_lower(value string) string {
    return ascii_shift(value,65,90,97);
}
pub func ascii_upper(value string) string {
    return ascii_shift(value,97,122,65);
}

pub func find_last(value string, needle string) option.Option[usize] {
    if needle == "" { return option.Option[usize].Some(len(value)); }
    if byte_len(needle) > byte_len(value) { return option.Option[usize].None; }
    let haystack = bytes(value);
    let pattern = bytes(needle);
    let pattern_bytes = vec.len(pattern);
    let haystack_bytes = vec.len(haystack);
    let fallback = match_table(pattern);
    var matched usize = 0;
    var last = haystack_bytes;
    for var offset usize = 0; offset < haystack_bytes; offset += 1 {
        matched = match_byte(pattern,fallback,matched,haystack[offset]);
        if matched == pattern_bytes {
            last = offset+1-pattern_bytes;
            matched = fallback[matched-1];
        }
    }
    if last == haystack_bytes { return option.Option[usize].None; }
    var index usize = 0;
    for var offset usize = 0; offset < last; offset = utf8_next(haystack,offset) {
        index += 1;
    }
    return option.Option[usize].Some(index);
}
func count_words(value string, target u8) option.Option[usize] {
    let byte_count = byte_len(value);
    let repeated = u64(target) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let x = word ^ repeated;
        let zero_flags = ~(((x & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) |
            x | 0x7f7f7f7f7f7f7f7f);
        total += usize((((zero_flags >> 7) * 0x0101010101010101) >> 56));
        offset += 8;
    }
    let remaining = byte_count - offset;
    if remaining != 0 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let x = word ^ repeated;
        var zero_flags = ~(((x & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) |
            x | 0x7f7f7f7f7f7f7f7f);
        zero_flags = zero_flags & (~u64(0) << ((8-remaining)*8));
        total += usize((((zero_flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
func byte_zero_flags(x u64) u64 {
    return ~(((x & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) |
        x | 0x7f7f7f7f7f7f7f7f);
}
// Pack the UTF-8 bytes of a needle into a little-endian u64.
// Callers limit the needle width to 2-4 bytes.
// ASCII code points can be read directly; other scalars are encoded as UTF-8.
// This keeps the packed counting paths free of a temporary needle byte Vec.
func pack_short_needle(value string, byte_count usize) u64 {
    let points = len(value);
    if points == byte_count {
        if points == 2 {
            return (u64(value[0]) & 0xff) |
                ((u64(value[1]) & 0xff) << 8);
        }
        if points == 3 {
            return (u64(value[0]) & 0xff) |
                ((u64(value[1]) & 0xff) << 8) |
                ((u64(value[2]) & 0xff) << 16);
        }
        if points == 4 {
            return (u64(value[0]) & 0xff) |
                ((u64(value[1]) & 0xff) << 8) |
                ((u64(value[2]) & 0xff) << 16) |
                ((u64(value[3]) & 0xff) << 24);
        }
        return u64(value[0]) & 0xff;
    }
    var packed u64 = 0;
    var shift usize = 0;
    for var index usize = 0; index < points; index += 1 {
        let rune = value[index];
        if rune < 0x80 {
            packed = packed | (u64(rune) << shift);
            shift += 8;
        } else if rune < 0x800 {
            packed = packed | (u64(0xc0 | (rune >> 6)) << shift);
            packed = packed | (u64(0x80 | (rune & 0x3f)) << (shift+8));
            shift += 16;
        } else if rune < 0x10000 {
            packed = packed | (u64(0xe0 | (rune >> 12)) << shift);
            packed = packed | (u64(0x80 | ((rune >> 6) & 0x3f)) << (shift+8));
            packed = packed | (u64(0x80 | (rune & 0x3f)) << (shift+16));
            shift += 24;
        } else {
            packed = packed | (u64(0xf0 | (rune >> 18)) << shift);
            packed = packed | (u64(0x80 | ((rune >> 12) & 0x3f)) << (shift+8));
            packed = packed | (u64(0x80 | ((rune >> 6) & 0x3f)) << (shift+16));
            packed = packed | (u64(0x80 | (rune & 0x3f)) << (shift+24));
            shift += 32;
        }
    }
    return packed;
}
// Count nonoverlapping matches of 2-4 byte patterns with a border.
// Each candidate start is the high bit of its byte. With wrapping u64
// arithmetic, flags & (~flags+1) selects the earliest one. Clear its span
// and carry any part that reaches into the next window.
func count_overlap(value string, packed u64, byte_count usize,
    width usize) option.Option[usize] {
    let first = (packed & 0xff) * 0x0101010101010101;
    let second = ((packed >> 8) & 0xff) * 0x0101010101010101;
    var third u64 = 0;
    var fourth u64 = 0;
    if width >= 3 { third = ((packed >> 16) & 0xff) * 0x0101010101010101; }
    if width == 4 { fourth = ((packed >> 24) & 0xff) * 0x0101010101010101; }
    let stride = 9-width;
    let carry_shift = stride*8;
    var span_factor u64 = 0x0101;
    if width == 3 { span_factor = 0x010101; }
    else if width == 4 { span_factor = 0x01010101; }
    var total usize = 0;
    var offset usize = 0;
    var carry u64 = 0;
    for byte_count-offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        if width == 3 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16);
        } else if width == 4 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16) &
                (byte_zero_flags(word ^ fourth) >> 24);
        }
        flags = flags & ~carry;
        var blocked u64 = 0;
        for flags != 0 {
            let selected = flags & (~flags + 1);
            total += 1;
            blocked = selected * span_factor;
            flags = flags & ~blocked;
        }
        carry = blocked >> carry_shift;
        offset += stride;
    }
    if offset <= byte_count-width {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        if width == 3 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16);
        } else if width == 4 {
            flags = flags & (byte_zero_flags(word ^ third) >> 16) &
                (byte_zero_flags(word ^ fourth) >> 24);
        }
        let tail = offset-(byte_count-8);
        flags = flags & (~u64(0) << (tail*8));
        carry = carry << (tail*8);
        flags = flags & ~carry;
        for flags != 0 {
            let selected = flags & (~flags + 1);
            total += 1;
            flags = flags & ~(selected * span_factor);
        }
    }
    return option.Option[usize].Some(total);
}
func count_two(value string, packed u64, byte_count usize) option.Option[usize] {
    let first = (packed & 0xff) * 0x0101010101010101;
    let second = ((packed >> 8) & 0xff) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
        offset += 7;
    }
    if offset <= byte_count - 2 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8);
        flags = flags & (~u64(0) << ((offset-(byte_count-8))*8));
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
func count_three(value string, packed u64, byte_count usize) option.Option[usize] {
    let first = (packed & 0xff) * 0x0101010101010101;
    let second = ((packed >> 8) & 0xff) * 0x0101010101010101;
    let third = ((packed >> 16) & 0xff) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16);
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
        offset += 6;
    }
    if offset <= byte_count - 3 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16);
        flags = flags & (~u64(0) << ((offset-(byte_count-8))*8));
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
func count_four(value string, packed u64, byte_count usize) option.Option[usize] {
    let first = (packed & 0xff) * 0x0101010101010101;
    let second = ((packed >> 8) & 0xff) * 0x0101010101010101;
    let third = ((packed >> 16) & 0xff) * 0x0101010101010101;
    let fourth = ((packed >> 24) & 0xff) * 0x0101010101010101;
    var total usize = 0;
    var offset usize = 0;
    for byte_count - offset >= 8 {
        var word u64 = 0;
        switch __woozy_text_load8(value,offset) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        let flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16) &
            (byte_zero_flags(word ^ fourth) >> 24);
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
        offset += 5;
    }
    if offset <= byte_count - 4 {
        var word u64 = 0;
        switch __woozy_text_load8(value,byte_count-8) {
            case option.Option.Some(loaded): word = loaded;
            case option.Option.None: return option.Option[usize].None;
        }
        var flags = byte_zero_flags(word ^ first) &
            (byte_zero_flags(word ^ second) >> 8) &
            (byte_zero_flags(word ^ third) >> 16) &
            (byte_zero_flags(word ^ fourth) >> 24);
        flags = flags & (~u64(0) << ((offset-(byte_count-8))*8));
        total += usize((((flags >> 7) * 0x0101010101010101) >> 56));
    }
    return option.Option[usize].Some(total);
}
pub func count(value string, needle string) usize {
    let needle_bytes = byte_len(needle);
    if needle_bytes == 0 { return len(value)+1; }
    let value_bytes = byte_len(value);
    if needle_bytes > value_bytes { return 0; }
    if needle_bytes == 1 {
        let target = u8(needle[0]);
        if value_bytes >= 8 {
            switch count_words(value,target) {
                case option.Option.Some(total): return total;
                case option.Option.None: {}
            }
        }
        if value_bytes <= 32 && value_bytes == len(value) {
            var total usize = 0;
            for var index usize = 0; index < len(value); index += 1 {
                if value[index] == u32(target) { total += 1; }
            }
            return total;
        }
        let haystack = bytes(value);
        let haystack_bytes = vec.len(haystack);
        var total usize = 0;
        var offset usize = 0;
        for haystack_bytes - offset >= 8 {
            if haystack[offset] == target { total += 1; }
            if haystack[offset+1] == target { total += 1; }
            if haystack[offset+2] == target { total += 1; }
            if haystack[offset+3] == target { total += 1; }
            if haystack[offset+4] == target { total += 1; }
            if haystack[offset+5] == target { total += 1; }
            if haystack[offset+6] == target { total += 1; }
            if haystack[offset+7] == target { total += 1; }
            offset += 8;
        }
        for offset < haystack_bytes {
            if haystack[offset] == target { total += 1; }
            offset += 1;
        }
        return total;
    }
    if needle_bytes >= 2 && needle_bytes <= 4 && value_bytes >= 8 {
        let packed = pack_short_needle(needle,needle_bytes);
        // A border is a proper prefix that is also a suffix; only then can
        // matches overlap, so those patterns use the packed greedy path.
        let first_byte = packed & 0xff;
        let last_byte = (packed >> ((needle_bytes-1)*8)) & 0xff;
        var has_border = first_byte == last_byte;
        if needle_bytes == 4 &&
            first_byte == ((packed >> 16) & 0xff) &&
            ((packed >> 8) & 0xff) == ((packed >> 24) & 0xff) {
            has_border = true;
        }
        if !has_border {
            if needle_bytes == 2 {
                switch count_two(value,packed,value_bytes) {
                    case option.Option.Some(total): return total;
                    case option.Option.None: {}
                }
            } else if needle_bytes == 3 {
                switch count_three(value,packed,value_bytes) {
                    case option.Option.Some(total): return total;
                    case option.Option.None: {}
                }
            } else {
                switch count_four(value,packed,value_bytes) {
                    case option.Option.Some(total): return total;
                    case option.Option.None: {}
                }
            }
        } else {
            switch count_overlap(value,packed,value_bytes,needle_bytes) {
                case option.Option.Some(total): return total;
                case option.Option.None: {}
            }
        }
    }
    let haystack = bytes(value);
    let pattern = bytes(needle);
    let pattern_bytes = vec.len(pattern);
    let haystack_bytes = vec.len(haystack);
    let fallback = match_table(pattern);
    var matched usize = 0;
    var total usize = 0;
    for var offset usize = 0; offset < haystack_bytes; offset += 1 {
        matched = match_byte(pattern,fallback,matched,haystack[offset]);
        if matched == pattern_bytes {
            total += 1;
            matched = 0;
        }
    }
    return total;
}
pub func split_n(value string, separator string, limit usize) Vec[string] {
    let out = vec.empty[string]();
    if limit == 0 { return out; }
    if limit == 1 {
        vec.push(out,value);
        return out;
    }
    if separator == "" {
        let value_points = len(value);
        let value_bytes = byte_len(value);
        var word_backend = false;
        if value_bytes != value_points && value_bytes >= 8 {
            switch __woozy_text_load8(value,0) {
                case option.Option.Some(loaded): word_backend = true;
                case option.Option.None: {}
            }
        }
        var pieces usize = 0;
        if word_backend {
            var remaining = value;
            for len(remaining) != 0 && pieces+1 < limit {
                vec.push(out,remaining[0:1]);
                remaining = remaining[1:];
                pieces += 1;
            }
            if len(remaining) != 0 {
                vec.push(out,remaining);
            }
            return out;
        }
        var offset usize = 0;
        for offset < value_points && pieces+1 < limit {
            vec.push(out,value[offset:offset+1]);
            pieces += 1;
            offset += 1;
        }
        if offset < value_points {
            vec.push(out,value[offset:value_points]);
        }
        return out;
    }
    let haystack = bytes(value);
    let haystack_bytes = vec.len(haystack);
    let ascii = haystack_bytes == len(value);
    let pattern = bytes(separator);
    let pattern_bytes = vec.len(pattern);
    if pattern_bytes > haystack_bytes {
        vec.push(out,value);
        return out;
    }
    let fallback = match_table(pattern);
    var matched usize = 0;
    var start usize = 0;
    var pieces usize = 0;
    for var offset usize = 0; offset < haystack_bytes && pieces+1 < limit; offset += 1 {
        matched = match_byte(pattern,fallback,matched,haystack[offset]);
        if matched == pattern_bytes {
            let end = offset+1-pattern_bytes;
            if ascii {
                vec.push(out,value[start:end]);
            } else {
                vec.push(out,text_from_span(haystack,start,end));
            }
            pieces += 1;
            start = offset+1;
            matched = 0;
        }
    }
    if pieces == 0 {
        vec.push(out,value);
        return out;
    }
    if ascii {
        vec.push(out,value[start:haystack_bytes]);
    } else {
        vec.push(out,text_from_span(haystack,start,haystack_bytes));
    }
    return out;
}
pub func split_lines(value string) Vec[string] {
    let out = vec.empty[string]();
    let data = bytes(value);
    let data_bytes = vec.len(data);
    if data_bytes == 0 { return out; }
    var start usize = 0;
    var offset usize = 0;
    for offset < data_bytes {
        if data[offset] == 10 {
            vec.push(out,text_from_span(data,start,offset));
            offset += 1;
            start = offset;
        } else if data[offset] == 13 {
            vec.push(out,text_from_span(data,start,offset));
            offset += 1;
            if offset < data_bytes && data[offset] == 10 { offset += 1; }
            start = offset;
        } else {
            offset = utf8_next(data,offset);
        }
    }
    if start < data_bytes {
        vec.push(out,text_from_span(data,start,data_bytes));
    }
    return out;
}
pub func trim_start(value string) string {
    if len(value) == 0 || !is_space(value[0]) { return value; }
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var offset usize = 0;
    for offset < data_bytes {
        if !is_space(utf8_decode(data,offset)) { break; }
        offset = utf8_next(data,offset);
    }
    if offset == 0 { return value; }
    return text_from_span(data,offset,data_bytes);
}
pub func trim_end(value string) string {
    if len(value) == 0 || !is_space(value[len(value)-1]) { return value; }
    let data = bytes(value);
    let data_bytes = vec.len(data);
    var end usize = data_bytes;
    for end > 0 {
        let start = utf8_prev(data,end);
        if !is_space(utf8_decode(data,start)) { break; }
        end = start;
    }
    if end == data_bytes { return value; }
    return text_from_span(data,0,end);
}
pub func strip_prefix(value string, prefix string) option.Option[string] {
    if !starts_with(value,prefix) { return option.Option[string].None; }
    return option.Option[string].Some(value[len(prefix):]);
}
pub func strip_suffix(value string, suffix string) option.Option[string] {
    if !ends_with(value,suffix) { return option.Option[string].None; }
    return option.Option[string].Some(value[0:len(value)-len(suffix)]);
}
func pad_with(value string, width usize, fill u32, mode u32) string throws PaddingError {
    if width > MAX_PADDING_WIDTH { throw PaddingError.WidthTooLarge(width); }
    let fill_text = pad_fill(fill);
    let length = len(value);
    if width <= length { return value; }
    let total = width - length;
    if mode == PAD_LEFT { return repeat(fill_text,total) + value; }
    if mode == PAD_RIGHT { return value + repeat(fill_text,total); }
    let left = total / 2;
    return repeat(fill_text,left) + value + repeat(fill_text,total-left);
}
func pad_fill(fill u32) string throws PaddingError {
    try {
        return from_rune(fill);
    } catch problem Error {
        throw PaddingError.InvalidScalar(fill);
    }
}
func replace_empty(value string, replacement string) string {
    let data = bytes(value);
    let data_bytes = vec.len(data);
    let replacement_bytes = bytes(replacement);
    let out = vec.empty[u8]();
    vec.reserve(out,data_bytes+vec.len(replacement_bytes));
    append_bytes(out,replacement_bytes);
    var offset usize = 0;
    for offset < data_bytes {
        let next = utf8_next(data,offset);
        append_span(out,data,offset,next);
        append_bytes(out,replacement_bytes);
        offset = next;
    }
    return text_from_buffer(out);
}
func ascii_shift(value string, source_first u8, source_last u8,
        target_first u8) string {
    let length = len(value);
    if length == 0 { return value; }
    if length == 1 {
        let rune = value[0];
        if rune < u32(source_first) || rune > u32(source_last) {
            return value;
        }
    }
    // There is no zero-copy byte view in the public text API. Detecting that a
    // longer string has no byte in this range therefore costs one O(n)
    // bytes(value) scratch copy. The output buffer is only allocated after a
    // matching ASCII byte is found.
    let data = bytes(value);
    var changed = false;
    for byte in data {
        if byte >= source_first && byte <= source_last {
            changed = true;
            break;
        }
    }
    if !changed { return value; }
    let out = vec.empty[u8]();
    vec.reserve(out,vec.len(data));
    for byte in data {
        if byte >= source_first && byte <= source_last {
            vec.push(out,target_first + (byte-source_first));
        } else { vec.push(out,byte); }
    }
    return text_from_buffer(out);
}
func find_bytes_from(data Vec[u8], pattern Vec[u8], start usize) option.Option[usize] {
    let pattern_bytes = vec.len(pattern);
    if pattern_bytes == 0 { return option.Option[usize].Some(start); }
    let data_bytes = vec.len(data);
    if start > data_bytes || pattern_bytes > data_bytes-start {
        return option.Option[usize].None;
    }
    // A bounded-pattern direct scan is linear in the haystack: the per-byte
    // work is capped by DIRECT_FIND_PATTERN_BYTES. Avoid allocating a KMP
    // fallback table for the common short pattern case.
    let first = pattern[0];
    if pattern_bytes <= DIRECT_FIND_PATTERN_BYTES {
        let limit = data_bytes-pattern_bytes;
        for var offset usize = start; offset <= limit; offset += 1 {
            if data[offset] != first { continue; }
            var index usize = 1;
            for index < pattern_bytes && data[offset+index] == pattern[index] {
                index += 1;
            }
            if index == pattern_bytes { return option.Option[usize].Some(offset); }
        }
        return option.Option[usize].None;
    }
    let fallback = match_table(pattern);
    var matched usize = 0;
    for var offset usize = start; offset < data_bytes; offset += 1 {
        matched = match_byte(pattern,fallback,matched,data[offset]);
        if matched == pattern_bytes {
            return option.Option[usize].Some(offset+1-pattern_bytes);
        }
    }
    return option.Option[usize].None;
}
func utf8_offset(data Vec[u8], index usize) usize {
    var offset usize = 0;
    var count usize = 0;
    for count < index {
        offset = utf8_next(data,offset);
        count += 1;
    }
    return offset;
}
func utf8_span_length(data Vec[u8], start usize, end usize) usize {
    var offset = start;
    var count usize = 0;
    for offset < end {
        offset = utf8_next(data,offset);
        count += 1;
    }
    return count;
}
func append_bytes(out Vec[u8], source Vec[u8]) {
    for byte in source { vec.push(out,byte); }
}
func append_span(out Vec[u8], data Vec[u8], start usize, end usize) {
    for var index usize = start; index < end; index += 1 {
        vec.push(out,data[index]);
    }
}
func append_text(out Vec[u8], value string) {
    for byte in bytes(value) { vec.push(out,byte); }
}
func text_from_buffer(data Vec[u8]) string {
    // Callers only concatenate valid UTF-8 spans from existing strings.
    try {
        return from_bytes(data);
    } catch problem Error {
        return "";
    }
}
// A complete UTF-8 pattern begins with a leading byte, so byte matches
// also begin and end on code point boundaries.
func match_table(pattern Vec[u8]) Vec[usize] {
    let length = vec.len(pattern);
    let fallback = vec.make[usize](length,0);
    var matched usize = 0;
    for var index usize = 1; index < length; index += 1 {
        matched = match_byte(pattern,fallback,matched,pattern[index]);
        fallback[index] = matched;
    }
    return fallback;
}
func match_byte(pattern Vec[u8], fallback Vec[usize], matched usize, byte u8) usize {
    var available = matched;
    // Each state needs only one checked read of its pattern byte.
    for {
        if pattern[available] == byte { return available+1; }
        if available == 0 { return 0; }
        available = fallback[available-1];
    }
}
func utf8_next(data Vec[u8], offset usize) usize {
    let first = data[offset];
    if first < 0x80 { return offset+1; }
    if first < 0xe0 { return offset+2; }
    if first < 0xf0 { return offset+3; }
    return offset+4;
}
func utf8_prev(data Vec[u8], end usize) usize {
    var start = end-1;
    for start > 0 && (data[start] & 0xc0) == 0x80 { start -= 1; }
    return start;
}
func utf8_decode(data Vec[u8], offset usize) u32 {
    let first = u32(data[offset]);
    if first < 0x80 { return first; }
    if first < 0xe0 {
        return ((first & 0x1f) << 6) | (u32(data[offset+1]) & 0x3f);
    }
    if first < 0xf0 {
        return ((first & 0x0f) << 12) | ((u32(data[offset+1]) & 0x3f) << 6) |
            (u32(data[offset+2]) & 0x3f);
    }
    return ((first & 0x07) << 18) | ((u32(data[offset+1]) & 0x3f) << 12) |
        ((u32(data[offset+2]) & 0x3f) << 6) | (u32(data[offset+3]) & 0x3f);
}
func text_from_span(data Vec[u8], start usize, end usize) string {
    // Callers pass complete UTF-8 code point spans from an existing string.
    try {
        return from_bytes(data[start:end]);
    } catch error Error {
        return "";
    }
}
