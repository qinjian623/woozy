// Small regular expression matcher for UTF-8 text.
//
// The pattern is compiled to a Thompson NFA and simulated with a state set.
// Every input position visits each NFA state at most once, so pathological
// repetition does not backtrack exponentially. find reports the earliest
// match start and, for that start, the longest match end.
//
// Supported syntax:
//   literals (including UTF-8), ., ^, $, ( ), |, *, +, ?,
//   [a-z], [^x], and the escapes \\ \. \* \+ \? \( \) \[ \] \{ \} \| \^ \$ \- \n \r \t
//
// ^ and $ assert the beginning and end of the whole input. . does not match
// U+000A. Offsets in Error are Unicode code point indices in the pattern.
// compile emits capture tags automatically when a pattern has at most
// MAX_CAPTURE_GROUPS groups.  If a pattern needs more groups, or its tag states
// would exceed the existing NFA state budget, compile falls back to grouping-
// only states; ordinary matching is unchanged and find_captures reports
// CaptureError.Unavailable.  compile_captures is the explicitly checked form
// and reports PatternTooLarge instead of falling back.  Ordinary
// find/find_all/split/replace skip tag states without copying them;
// find_captures runs the tagged thread path.  See README.md in this directory
// for the extended API, capture tie model and performance limits.
// Backreferences, lookaround, {m,n} and flags are rejected.
package regex;

import "std/option" as option;
import "std/text" as text;
import "std/vec" as vec;

const MAX_PATTERN_BYTES usize = 65536;
const MAX_PATTERN_CODEPOINTS usize = 4096;
const MAX_NESTING usize = 128;
const MAX_STATES usize = 16384;
const MAX_CLASS_RANGES usize = 16384;
const MAX_CAPTURE_GROUPS usize = 32;
const NO_STATE usize = 18446744073709551615;

const KIND_CHAR u32 = 0;
const KIND_ANY u32 = 1;
const KIND_CLASS u32 = 2;
const KIND_NEG_CLASS u32 = 3;
const KIND_SPLIT u32 = 4;
const KIND_JUMP u32 = 5;
const KIND_START u32 = 6;
const KIND_END u32 = 7;
const KIND_MATCH u32 = 8;
const KIND_TAG_START u32 = 9;
const KIND_TAG_END u32 = 10;

pub enum Error {
    Syntax(offset usize);
    PatternTooLarge(offset usize);
    NestingTooDeep(offset usize);
}

// CaptureError is separate from Error so the published compile error cases stay
// exhaustive-compatible.  Unavailable is reported only by
// find_captures/find_captures_from when compile returned a valid Pattern
// without capture tags because the pattern exceeded the capture-group or
// tag-state budget.
pub enum CaptureError {
    Unavailable;
}

pub struct Match {
    pub start usize;
    pub end usize;
}

// Captures holds the leftmost-longest overall match, retained source and the
// participating groups.  Use group_count/group/group_text instead of indexing
// the private group vector.  Group 0 is the overall match; group 1 is the
// first opening parenthesis.  Non-participating groups are None.
pub struct Captures {
    pub start usize;
    pub end usize;
    source string;
    groups Vec[option.Option[Match]];
}

struct Range {
    low u32;
    high u32;
}

struct Inst {
    kind u32;
    next usize;
    alt usize;
    value u32;
    range_start usize;
    range_end usize;
}

pub struct Pattern {
    states Vec[Inst];
    ranges Vec[Range];
    start usize;
    groups usize;
    captures_available bool;
}

struct Patch {
    state usize;
    alt bool;
}

struct Frag {
    start usize;
    outs Vec[Patch];
    repeatable bool;
}

struct Compiler {
    pattern Vec[u32];
    cursor Vec[usize];
    states Vec[Inst];
    ranges Vec[Range];
    capture bool;
    groups Vec[usize];
}

struct Runner {
    compiled Pattern;
    input Vec[u32];
    starts Vec[usize];
    touched Vec[usize];
    active Vec[usize];
}

// Scratch holds the three frontiers used by one ordinary search.  A fresh
// Scratch is cheap for a single find; multi-match callers keep one across all
// searches instead of allocating these Vecs again for every match.
struct Scratch {
    stack Vec[usize];
    seeds Vec[usize];
    seed_starts Vec[usize];
}

struct CaptureThread {
    state usize;
    start usize;
    tags Vec[usize];
}

struct CaptureFrame {
    state usize;
    tags Vec[usize];
}

struct CaptureRunner {
    compiled Pattern;
    input Vec[u32];
    seen Vec[bool];
    touched Vec[usize];
    active Vec[CaptureThread];
}

func at_end(c Compiler) bool {
    return c.cursor[0] >= vec.len(c.pattern);
}

func peek(c Compiler) u32 {
    if at_end(c) { return 0x110000; }
    return c.pattern[c.cursor[0]];
}

func advance(c Compiler) {
    c.cursor[0] += 1;
}

func emit(c Compiler, kind u32, next usize, alt usize, value u32,
          range_start usize, range_end usize, offset usize) usize throws Error {
    if vec.len(c.states) >= MAX_STATES {
        throw Error.PatternTooLarge(offset);
    }
    vec.push(c.states, Inst(kind:kind, next:next, alt:alt, value:value,
        range_start:range_start, range_end:range_end));
    return vec.len(c.states) - 1;
}

func add_range(c Compiler, low u32, high u32, offset usize) throws Error {
    if vec.len(c.ranges) >= MAX_CLASS_RANGES {
        throw Error.PatternTooLarge(offset);
    }
    vec.push(c.ranges, Range(low:low, high:high));
}

func patch(c Compiler, outs Vec[Patch], target usize) {
    for item in outs {
        if item.alt {
            c.states[item.state].alt = target;
        } else {
            c.states[item.state].next = target;
        }
    }
}

func empty_fragment(c Compiler, offset usize) Frag throws Error {
    let state = emit(c, KIND_JUMP, NO_STATE, NO_STATE, 0, 0, 0, offset);
    let outs = vec.empty[Patch]();
    vec.push(outs, Patch(state:state, alt:false));
    return Frag(start:state, outs:outs, repeatable:true);
}

func char_fragment(c Compiler, value u32, offset usize) Frag throws Error {
    let state = emit(c, KIND_CHAR, NO_STATE, NO_STATE, value, 0, 0, offset);
    let outs = vec.empty[Patch]();
    vec.push(outs, Patch(state:state, alt:false));
    return Frag(start:state, outs:outs, repeatable:true);
}

func simple_fragment(c Compiler, kind u32, offset usize) Frag throws Error {
    let state = emit(c, kind, NO_STATE, NO_STATE, 0, 0, 0, offset);
    let outs = vec.empty[Patch]();
    vec.push(outs, Patch(state:state, alt:false));
    return Frag(start:state, outs:outs, repeatable:true);
}

func concat_fragments(c Compiler, left Frag, right Frag) Frag {
    patch(c, left.outs, right.start);
    return Frag(start:left.start, outs:right.outs, repeatable:true);
}

func escaped_rune(c Compiler) u32 throws Error {
    let slash = c.cursor[0];
    advance(c);
    if at_end(c) {
        throw Error.Syntax(slash);
    }
    let offset = c.cursor[0];
    let rune = peek(c);
    advance(c);
    if rune == 110 { return 10; }
    if rune == 114 { return 13; }
    if rune == 116 { return 9; }
    if rune == 92 || rune == 46 || rune == 94 || rune == 36 ||
       rune == 42 || rune == 43 || rune == 63 || rune == 40 ||
       rune == 41 || rune == 91 || rune == 93 || rune == 123 ||
       rune == 125 || rune == 124 || rune == 45 {
        return rune;
    }
    throw Error.Syntax(offset);
}

func parse_class(c Compiler) Frag throws Error {
    let open = c.cursor[0] - 1;
    var negated = false;
    if peek(c) == 94 {
        negated = true;
        advance(c);
    }
    let range_start = vec.len(c.ranges);
    var items usize = 0;
    for true {
        if at_end(c) {
            throw Error.Syntax(c.cursor[0]);
        }
        if peek(c) == 93 {
            if items == 0 {
                throw Error.Syntax(c.cursor[0]);
            }
            advance(c);
            break;
        }
        let first_offset = c.cursor[0];
        var first u32 = 0;
        if peek(c) == 92 {
            first = escaped_rune(c);
        } else {
            first = peek(c);
            advance(c);
        }
        if peek(c) == 45 {
            let dash = c.cursor[0];
            advance(c);
            if at_end(c) {
                throw Error.Syntax(c.cursor[0]);
            }
            if peek(c) == 93 {
                add_range(c, first, first, first_offset);
                add_range(c, 45, 45, dash);
                items += 2;
                continue;
            }
            var second u32 = 0;
            if peek(c) == 92 {
                second = escaped_rune(c);
            } else {
                second = peek(c);
                advance(c);
            }
            if second < first {
                throw Error.Syntax(dash);
            }
            add_range(c, first, second, dash);
            items += 1;
        } else {
            add_range(c, first, first, first_offset);
            items += 1;
        }
    }
    let range_end = vec.len(c.ranges);
    var kind = KIND_CLASS;
    if negated { kind = KIND_NEG_CLASS; }
    let state = emit(c, kind, NO_STATE, NO_STATE, 0, range_start, range_end, open);
    let outs = vec.empty[Patch]();
    vec.push(outs, Patch(state:state, alt:false));
    return Frag(start:state, outs:outs, repeatable:true);
}

func parse_atom(c Compiler, depth usize) Frag throws Error {
    let offset = c.cursor[0];
    let rune = peek(c);
    if rune == 40 {
        advance(c);
        if depth >= MAX_NESTING {
            throw Error.NestingTooDeep(offset);
        }
        if !c.capture {
            let inner = parse_alternation(c, depth + 1);
            if at_end(c) || peek(c) != 41 {
                throw Error.Syntax(c.cursor[0]);
            }
            advance(c);
            return Frag(start:inner.start, outs:inner.outs, repeatable:true);
        }
        if c.groups[0] >= MAX_CAPTURE_GROUPS {
            throw Error.PatternTooLarge(offset);
        }
        let group = c.groups[0];
        c.groups[0] += 1;
        let open = emit(c, KIND_TAG_START, NO_STATE, NO_STATE, u32(group * 2),
            0, 0, offset);
        let inner = parse_alternation(c, depth + 1);
        if at_end(c) || peek(c) != 41 {
            throw Error.Syntax(c.cursor[0]);
        }
        advance(c);
        let close = emit(c, KIND_TAG_END, NO_STATE, NO_STATE,
            u32(group * 2 + 1), 0, 0, offset);
        patch(c, inner.outs, close);
        c.states[open].next = inner.start;
        let outs = vec.empty[Patch]();
        vec.push(outs, Patch(state:close, alt:false));
        return Frag(start:open, outs:outs, repeatable:true);
    }
    if rune == 91 {
        advance(c);
        return parse_class(c);
    }
    if rune == 46 {
        advance(c);
        return simple_fragment(c, KIND_ANY, offset);
    }
    if rune == 94 {
        advance(c);
        let result = simple_fragment(c, KIND_START, offset);
        return Frag(start:result.start, outs:result.outs, repeatable:false);
    }
    if rune == 36 {
        advance(c);
        let result = simple_fragment(c, KIND_END, offset);
        return Frag(start:result.start, outs:result.outs, repeatable:false);
    }
    if rune == 92 {
        let value = escaped_rune(c);
        return char_fragment(c, value, offset);
    }
    if rune == 42 || rune == 43 || rune == 63 || rune == 41 ||
       rune == 93 || rune == 123 || rune == 125 || rune == 124 {
        throw Error.Syntax(offset);
    }
    if at_end(c) {
        throw Error.Syntax(offset);
    }
    advance(c);
    return char_fragment(c, rune, offset);
}

func parse_repetition(c Compiler, depth usize) Frag throws Error {
    let atom = parse_atom(c, depth);
    if at_end(c) {
        return atom;
    }
    let rune = peek(c);
    if rune != 42 && rune != 43 && rune != 63 {
        return atom;
    }
    let offset = c.cursor[0];
    if !atom.repeatable {
        throw Error.Syntax(offset);
    }
    advance(c);
    if !at_end(c) {
        let after = peek(c);
        if after == 42 || after == 43 || after == 63 {
            throw Error.Syntax(c.cursor[0]);
        }
    }
    if rune == 42 {
        let split = emit(c, KIND_SPLIT, atom.start, NO_STATE, 0, 0, 0, offset);
        patch(c, atom.outs, split);
        let outs = vec.empty[Patch]();
        vec.push(outs, Patch(state:split, alt:true));
        return Frag(start:split, outs:outs, repeatable:true);
    }
    if rune == 43 {
        let split = emit(c, KIND_SPLIT, atom.start, NO_STATE, 0, 0, 0, offset);
        patch(c, atom.outs, split);
        let outs = vec.empty[Patch]();
        vec.push(outs, Patch(state:split, alt:true));
        return Frag(start:atom.start, outs:outs, repeatable:true);
    }
    let split = emit(c, KIND_SPLIT, atom.start, NO_STATE, 0, 0, 0, offset);
    vec.push(atom.outs, Patch(state:split, alt:true));
    return Frag(start:split, outs:atom.outs, repeatable:true);
}

func parse_concat(c Compiler, depth usize) Frag throws Error {
    var result = empty_fragment(c, c.cursor[0]);
    for !at_end(c) && peek(c) != 124 && peek(c) != 41 {
        let next = parse_repetition(c, depth);
        result = concat_fragments(c, result, next);
    }
    return result;
}

func parse_alternation(c Compiler, depth usize) Frag throws Error {
    var result = parse_concat(c, depth);
    for peek(c) == 124 {
        let offset = c.cursor[0];
        advance(c);
        let right = parse_concat(c, depth);
        let split = emit(c, KIND_SPLIT, result.start, right.start, 0, 0, 0, offset);
        for item in right.outs {
            vec.push(result.outs, item);
        }
        result = Frag(start:split, outs:result.outs, repeatable:true);
    }
    return result;
}

func compile_pattern(pattern string, capture bool) Pattern throws Error {
    if text.byte_len(pattern) > MAX_PATTERN_BYTES {
        throw Error.PatternTooLarge(0);
    }
    let runes = text.runes(pattern);
    if vec.len(runes) > MAX_PATTERN_CODEPOINTS {
        throw Error.PatternTooLarge(MAX_PATTERN_CODEPOINTS);
    }
    let c = Compiler(
        pattern:runes,
        cursor:vec.make[usize](1, 0),
        states:vec.empty[Inst](),
        ranges:vec.empty[Range](),
        capture:capture,
        groups:vec.make[usize](1, 0));
    let root = parse_alternation(c, 0);
    if !at_end(c) {
        throw Error.Syntax(c.cursor[0]);
    }
    let match_state = emit(c, KIND_MATCH, NO_STATE, NO_STATE, 0, 0, 0, c.cursor[0]);
    patch(c, root.outs, match_state);
    return Pattern(states:c.states, ranges:c.ranges, start:root.start,
        groups:c.groups[0], captures_available:capture);
}

// compile prefers a capture-capable Pattern so find_captures works on ordinary
// values.  A Pattern that previously compiled only because groups emitted no
// extra states must still compile: if the tagged form exceeds the group or
// state budget, retry without tags.  Syntax and nesting diagnostics are the
// same in both forms, so they are not retried.
pub func compile(pattern string) Pattern throws Error {
    try {
        return compile_pattern(pattern, true);
    } catch error Error {
        switch error {
            case Error.PatternTooLarge(offset): {
                return compile_pattern(pattern, false);
            }
            case Error.Syntax(offset): throw Error.Syntax(offset);
            case Error.NestingTooDeep(offset): throw Error.NestingTooDeep(offset);
        }
    }
}

pub func compile_captures(pattern string) Pattern throws Error {
    return compile_pattern(pattern, true);
}

func class_matches(compiled Pattern, inst Inst, rune u32) bool {
    var found = false;
    for var index usize = inst.range_start; index < inst.range_end; index += 1 {
        let range = compiled.ranges[index];
        if rune >= range.low && rune <= range.high {
            found = true;
            break;
        }
    }
    if inst.kind == KIND_NEG_CLASS {
        return !found;
    }
    return found;
}

// Add one thread and its epsilon closure. starts holds the earliest start for
// every state visited at this input position; earlier threads always run
// first, so a later thread can never overwrite one.
func add_thread(runner Runner, stack Vec[usize], seed usize, start usize,
    position usize, count usize) {
    var state = seed;
    for true {
        // Follow the preferred edge directly. Only deferred split edges need
        // the stack. Mark before following any edge to bound epsilon cycles.
        for runner.starts[state] == NO_STATE {
            runner.starts[state] = start;
            vec.push(runner.touched, state);
            let inst = runner.compiled.states[state];
            if inst.kind == KIND_SPLIT {
                vec.push(stack, inst.alt);
            } else if inst.kind == KIND_START {
                if position != 0 { break; }
            } else if inst.kind == KIND_END {
                if position != count { break; }
            } else if inst.kind != KIND_JUMP && inst.kind != KIND_TAG_START &&
                      inst.kind != KIND_TAG_END {
                if inst.kind != KIND_MATCH {
                    vec.push(runner.active, state);
                }
                break;
            }
            state = inst.next;
        }
        if vec.len(stack) == 0 { return; }
        switch vec.pop(stack) {
            case option.Option.Some(next): state = next;
            case option.Option.None: return;
        }
    }
}

func make_runner(compiled Pattern, input Vec[u32]) Runner {
    return Runner(
        compiled:compiled,
        input:input,
        starts:vec.make[usize](vec.len(compiled.states), NO_STATE),
        touched:vec.empty[usize](),
        active:vec.empty[usize]());
}

func make_scratch() Scratch {
    return Scratch(
        stack:vec.empty[usize](),
        seeds:vec.empty[usize](),
        seed_starts:vec.empty[usize]());
}

func reset_runner(runner Runner) {
    for state in runner.touched {
        runner.starts[state] = NO_STATE;
    }
    vec.clear(runner.touched);
    vec.clear(runner.active);
}

func runner_for(compiled Pattern, value string) Runner {
    return make_runner(compiled, text.runes(value));
}

// rune_byte_len is only called for scalar values from a valid source string.
func rune_byte_len(rune u32) usize {
    if rune < 0x80 { return 1; }
    if rune < 0x800 { return 2; }
    if rune < 0x10000 { return 3; }
    return 4;
}

// byte_offsets maps every code point boundary to its UTF-8 byte offset.  It
// lets split/replace copy byte ranges without calling a code-point slice,
// whose runtime implementation rescans from the start of the string.
func byte_offsets(input Vec[u32]) Vec[usize] {
    let offsets = vec.make[usize](vec.len(input) + 1, 0);
    var offset usize = 0;
    for var index usize = 0; index < vec.len(input); index += 1 {
        offset += rune_byte_len(input[index]);
        offsets[index + 1] = offset;
    }
    return offsets;
}

// These slices are always on valid code point boundaries, so the error arm is
// unreachable for strings received from the language runtime.
func text_from_byte_range(data Vec[u8], start usize, end usize) string {
    try {
        return text.from_bytes(data[start:end]);
    } catch error text.Error {
        return "";
    }
}

func text_from_byte_vec(data Vec[u8]) string {
    try {
        return text.from_bytes(data);
    } catch error text.Error {
        return "";
    }
}

func append_byte_range(out Vec[u8], data Vec[u8], start usize, end usize) {
    for var index usize = start; index < end; index += 1 {
        vec.push(out, data[index]);
    }
}

// search_runner searches input[from:] for the earliest start and, for that
// start, the longest end.  A fresh or reused runner is accepted; the caller's
// input is already in code points.  ^ is tested against position zero of the
// whole input, never against from.  A single search gets a private Scratch,
// while repeated-search callers use search_runner_with_scratch below.
func search_runner(runner Runner, from usize) option.Option[Match] {
    if from > vec.len(runner.input) { return option.Option[Match].None; }
    return search_runner_with_scratch(runner, from, make_scratch());
}

// add_thread drains the stack. Each completed scan step clears both seed
// vectors before advancing, so searches always return with empty scratch.
func search_runner_with_scratch(runner Runner, from usize,
    scratch Scratch) option.Option[Match] {
    reset_runner(runner);
    let count = vec.len(runner.input);
    if from > count {
        return option.Option[Match].None;
    }
    var best_start = NO_STATE;
    var best_end usize = 0;
    var position usize = from;
    // compile_pattern appends the sole MATCH instruction after all others.
    let match_state = vec.len(runner.compiled.states) - 1;
    add_thread(runner, scratch.stack, runner.compiled.start, position, position, count);
    for true {
        let start = runner.starts[match_state];
        if start < best_start ||
           (start != NO_STATE && start == best_start && position > best_end) {
            best_start = start;
            best_end = position;
        }
        if position == count {
            break;
        }
        // Active contains only consuming states, ordered by thread start.
        // After a match, its first thread determines whether we can improve it.
        if best_start != NO_STATE &&
           (vec.len(runner.active) == 0 || runner.starts[runner.active[0]] > best_start) {
            break;
        }
        let rune = runner.input[position];
        for state in runner.active {
            let start = runner.starts[state];
            if best_start != NO_STATE && start > best_start {
                continue;
            }
            let inst = runner.compiled.states[state];
            var matched = false;
            if inst.kind == KIND_CHAR {
                matched = rune == inst.value;
            } else if inst.kind == KIND_ANY {
                matched = rune != 10;
            } else if inst.kind == KIND_CLASS || inst.kind == KIND_NEG_CLASS {
                matched = class_matches(runner.compiled, inst, rune);
            }
            if matched {
                vec.push(scratch.seeds, inst.next);
                vec.push(scratch.seed_starts, start);
            }
        }
        reset_runner(runner);
        for var index usize = 0; index < vec.len(scratch.seeds); index += 1 {
            add_thread(runner, scratch.stack, scratch.seeds[index],
                scratch.seed_starts[index], position + 1, count);
        }
        vec.clear(scratch.seeds);
        vec.clear(scratch.seed_starts);
        if best_start == NO_STATE {
            add_thread(runner, scratch.stack, runner.compiled.start,
                position + 1, position + 1, count);
        }
        position += 1;
    }
    if best_start == NO_STATE {
        return option.Option[Match].None;
    }
    return option.Option[Match].Some(Match(start:best_start, end:best_end));
}

pub func find(compiled Pattern, value string) option.Option[Match] {
    return find_from(compiled, value, 0);
}

// find_from starts searching at code point index from.  Matches that begin
// before from are ignored.  from greater than the input length yields None;
// from equal to the length can still find an empty match at the end.  The
// ordinary leftmost-longest rule is preserved: earliest start at or after
// from, then the longest end for that start.
pub func find_from(compiled Pattern, value string, from usize) option.Option[Match] {
    let runner = runner_for(compiled, value);
    return search_runner(runner, from);
}

pub func is_match(compiled Pattern, value string) bool {
    switch find(compiled, value) {
        case option.Option.Some(found): return true;
        case option.Option.None: return false;
    }
}

// find_all returns non-overlapping matches in order.  It uses the same
// zero-width advance rule as split and replace: after an empty match at p the
// next search begins at p+1, while a non-empty match continues at its end.
// An empty match at the end is included once and then stops.  Ordinary
// matching ignores capture tag states without copying tags.
pub func find_all(compiled Pattern, value string) Vec[Match] {
    let out = vec.empty[Match]();
    let runner = runner_for(compiled, value);
    let scratch = make_scratch();
    let count = vec.len(runner.input);
    var search usize = 0;
    var done = false;
    for !done {
        switch search_runner_with_scratch(runner, search, scratch) {
            case option.Option.Some(found): {
                vec.push(out, found);
                if found.start == found.end {
                    if found.start >= count {
                        done = true;
                    } else {
                        search = found.start + 1;
                    }
                } else {
                    search = found.end;
                }
            }
            case option.Option.None: done = true;
        }
    }
    return out;
}

// split and split_n partition value at non-overlapping matches.  An empty
// match is a real separator at its position; after it the next search starts
// one code point later, so a zero-width pattern cannot loop.  The piece before
// every separator and the piece after the last one are both kept, including
// empty pieces.  split_n mirrors std/text.split_n: limit 0 returns an empty
// Vec, limit 1 returns [value], and otherwise at most limit pieces are
// returned with the last piece holding the remaining text.
func split_core(compiled Pattern, value string, bounded bool, limit usize) Vec[string] {
    let out = vec.empty[string]();
    if bounded && limit == 0 {
        return out;
    }
    if bounded && limit == 1 {
        vec.push(out, value);
        return out;
    }
    let runner = runner_for(compiled, value);
    let scratch = make_scratch();
    let count = vec.len(runner.input);
    let data = text.bytes(value);
    let offsets = byte_offsets(runner.input);
    var piece_start usize = 0;
    var search usize = 0;
    var done = false;
    for !done {
        if bounded && vec.len(out) + 1 >= limit {
            done = true;
        } else {
            switch search_runner_with_scratch(runner, search, scratch) {
                case option.Option.Some(found): {
                    vec.push(out, text_from_byte_range(data,
                        offsets[piece_start], offsets[found.start]));
                    if found.start == found.end {
                        piece_start = found.start;
                        if found.start >= count {
                            done = true;
                        } else {
                            search = found.start + 1;
                        }
                    } else {
                        piece_start = found.end;
                        search = found.end;
                    }
                }
                case option.Option.None: done = true;
            }
        }
    }
    vec.push(out, text_from_byte_range(data, offsets[piece_start],
        offsets[count]));
    return out;
}

pub func split(compiled Pattern, value string) Vec[string] {
    return split_core(compiled, value, false, 0);
}

pub func split_n(compiled Pattern, value string, limit usize) Vec[string] {
    return split_core(compiled, value, true, limit);
}

// replace_all and replace_n insert replacement literally; $ and \ are not
// expanded.  The bounded form replaces at most limit matches, with limit 0
// leaving value unchanged.  Zero-width matches follow the same advance rule as
// split: after a match at position p the next search begins at p+1, while the
// character at p is still copied before the next replacement.
func replace_core(compiled Pattern, value string, replacement string,
    bounded bool, limit usize) string {
    if bounded && limit == 0 {
        return value;
    }
    let runner = runner_for(compiled, value);
    let scratch = make_scratch();
    let count = vec.len(runner.input);
    let data = text.bytes(value);
    let offsets = byte_offsets(runner.input);
    let replacement_data = text.bytes(replacement);
    let out = vec.empty[u8]();
    vec.reserve(out, vec.len(data));
    var piece_start usize = 0;
    var search usize = 0;
    var replaced usize = 0;
    var done = false;
    for !done {
        if bounded && replaced >= limit {
            done = true;
        } else {
            switch search_runner_with_scratch(runner, search, scratch) {
                case option.Option.Some(found): {
                    append_byte_range(out, data, offsets[piece_start],
                        offsets[found.start]);
                    append_byte_range(out, replacement_data, 0,
                        vec.len(replacement_data));
                    replaced += 1;
                    if found.start == found.end {
                        piece_start = found.start;
                        if found.start >= count {
                            done = true;
                        } else {
                            search = found.start + 1;
                        }
                    } else {
                        piece_start = found.end;
                        search = found.end;
                    }
                }
                case option.Option.None: done = true;
            }
        }
    }
    if replaced == 0 {
        return value;
    }
    append_byte_range(out, data, offsets[piece_start], offsets[count]);
    return text_from_byte_vec(out);
}

pub func replace_all(compiled Pattern, value string, replacement string) string {
    return replace_core(compiled, value, replacement, false, 0);
}

pub func replace_n(compiled Pattern, value string, replacement string,
    limit usize) string {
    return replace_core(compiled, value, replacement, true, limit);
}

// Tagged capture path.  compile_captures returns a normal Pattern with tag
// states.  Threads are kept in deterministic priority order: the first
// alternative and the greedy repetition branch come first.  Deduplication
// keeps at most one thread per NFA state and position, so this is not a
// backtracking matcher.  For a fixed overall leftmost-longest span, the
// surviving highest-priority path determines the captures; this tie rule is
// deterministic but is not the POSIX subexpression-longest rule.  Because a state is not revisited at one
// position, a final zero-length repetition is not re-entered; a group that
// would only participate in that final empty iteration keeps its last
// non-empty capture or stays None.  Overall spans are unaffected.
func make_capture_runner(compiled Pattern, input Vec[u32]) CaptureRunner {
    return CaptureRunner(
        compiled:compiled,
        input:input,
        seen:vec.make[bool](vec.len(compiled.states), false),
        touched:vec.empty[usize](),
        active:vec.empty[CaptureThread]());
}

func reset_capture_runner(runner CaptureRunner) {
    for state in runner.touched {
        runner.seen[state] = false;
    }
    vec.clear(runner.touched);
    vec.clear(runner.active);
}

func copy_tags(tags Vec[usize]) Vec[usize] {
    let out = vec.make[usize](vec.len(tags), NO_STATE);
    for var index usize = 0; index < vec.len(tags); index += 1 {
        out[index] = tags[index];
    }
    return out;
}

// add_capture_thread adds one tagged thread and its epsilon closure.  Tags are
// treated as immutable handles: a tag state clones before writing, so split
// branches can share the old vector safely.  The seen map deduplicates both
// epsilon states and consuming states; the first thread in priority order wins.
func add_capture_thread(runner CaptureRunner, seed usize, start usize,
    position usize, tags Vec[usize]) {
    let stack = vec.empty[CaptureFrame]();
    vec.push(stack, CaptureFrame(state:seed, tags:tags));
    let count = vec.len(runner.input);
    for vec.len(stack) != 0 {
        let frame = stack[vec.len(stack) - 1];
        let discarded = vec.pop(stack);
        let state = frame.state;
        if runner.seen[state] {
            continue;
        }
        runner.seen[state] = true;
        vec.push(runner.touched, state);
        let inst = runner.compiled.states[state];
        if inst.kind == KIND_SPLIT {
            vec.push(stack, CaptureFrame(state:inst.alt, tags:frame.tags));
            vec.push(stack, CaptureFrame(state:inst.next, tags:frame.tags));
        } else if inst.kind == KIND_JUMP {
            vec.push(stack, CaptureFrame(state:inst.next, tags:frame.tags));
        } else if inst.kind == KIND_TAG_START || inst.kind == KIND_TAG_END {
            let updated = copy_tags(frame.tags);
            updated[usize(inst.value)] = position;
            vec.push(stack, CaptureFrame(state:inst.next, tags:updated));
        } else if inst.kind == KIND_START {
            if position == 0 {
                vec.push(stack, CaptureFrame(state:inst.next, tags:frame.tags));
            }
        } else if inst.kind == KIND_END {
            if position == count {
                vec.push(stack, CaptureFrame(state:inst.next, tags:frame.tags));
            }
        } else {
            vec.push(runner.active, CaptureThread(state:state, start:start,
                tags:frame.tags));
        }
    }
}

func make_captures(source string, start usize, end usize, tags Vec[usize],
    groups usize) Captures {
    let spans = vec.empty[option.Option[Match]]();
    vec.reserve(spans, groups);
    for var index usize = 0; index < groups; index += 1 {
        let group_start = tags[index * 2];
        let group_end = tags[index * 2 + 1];
        if group_start == NO_STATE || group_end == NO_STATE {
            vec.push(spans, option.Option[Match].None);
        } else {
            vec.push(spans, option.Option[Match].Some(
                Match(start:group_start, end:group_end)));
        }
    }
    return Captures(source:source, start:start, end:end, groups:spans);
}

// Like the ordinary search, tagged matching prunes later starts. A MATCH thread is
// terminal, and a thread whose start is later than the best match cannot
// improve the leftmost start or its captures.
func capture_can_extend(runner CaptureRunner, best_start usize) bool {
    for thread in runner.active {
        if thread.start <= best_start &&
           runner.compiled.states[thread.state].kind != KIND_MATCH {
            return true;
        }
    }
    return false;
}

// search_captures uses the same leftmost-match pruning as search_runner, but
// keeps the highest-priority tagged path for a fixed overall span.  Once a
// match exists, later starts are discarded and not spawned; if no live thread
// with the best start (or an earlier one) can consume another code point, the
// remaining suffix cannot change the result.
func search_captures(runner CaptureRunner, from usize,
    source string) option.Option[Captures] {
    reset_capture_runner(runner);
    let count = vec.len(runner.input);
    if from > count {
        return option.Option[Captures].None;
    }
    let groups = runner.compiled.groups;
    var best_start = NO_STATE;
    var best_end usize = 0;
    var best_tags = vec.empty[usize]();
    var position usize = from;
    let initial_tags = vec.make[usize](groups * 2, NO_STATE);
    add_capture_thread(runner, runner.compiled.start, position, position,
        initial_tags);
    for true {
        for var index usize = 0; index < vec.len(runner.active); index += 1 {
            let thread = runner.active[index];
            if runner.compiled.states[thread.state].kind == KIND_MATCH {
                let start = thread.start;
                if start < best_start || (start == best_start && position > best_end) {
                    best_start = start;
                    best_end = position;
                    best_tags = copy_tags(thread.tags);
                }
            }
        }
        if position == count {
            break;
        }
        // Kept identical to the ordinary runner: only threads that can still
        // tie or improve the earliest start survive, and an all-terminal state
        // set ends the suffix scan.
        if best_start != NO_STATE && !capture_can_extend(runner, best_start) {
            break;
        }
        let rune = runner.input[position];
        let seed_states = vec.empty[usize]();
        let seed_starts = vec.empty[usize]();
        let seed_tags = vec.empty[Vec[usize]]();
        for thread in runner.active {
            if best_start != NO_STATE && thread.start > best_start {
                continue;
            }
            let inst = runner.compiled.states[thread.state];
            var matched = false;
            if inst.kind == KIND_CHAR {
                matched = rune == inst.value;
            } else if inst.kind == KIND_ANY {
                matched = rune != 10;
            } else if inst.kind == KIND_CLASS || inst.kind == KIND_NEG_CLASS {
                matched = class_matches(runner.compiled, inst, rune);
            }
            if matched {
                vec.push(seed_states, inst.next);
                vec.push(seed_starts, thread.start);
                vec.push(seed_tags, thread.tags);
            }
        }
        reset_capture_runner(runner);
        for var index usize = 0; index < vec.len(seed_states); index += 1 {
            add_capture_thread(runner, seed_states[index], seed_starts[index],
                position + 1, seed_tags[index]);
        }
        if best_start == NO_STATE {
            let next_tags = vec.make[usize](groups * 2, NO_STATE);
            add_capture_thread(runner, runner.compiled.start, position + 1,
                position + 1, next_tags);
        }
        position += 1;
    }
    if best_start == NO_STATE {
        return option.Option[Captures].None;
    }
    return option.Option[Captures].Some(
        make_captures(source, best_start, best_end, best_tags, groups));
}

pub func find_captures(compiled Pattern,
    value string) option.Option[Captures] throws CaptureError {
    return find_captures_from(compiled, value, 0);
}

// find_captures_from follows find_from for the overall span.  It accepts any
// Pattern whose compile pass could emit capture tags, including plain compile
// of a pattern with zero groups.  Capture groups are numbered by their opening
// parenthesis, starting at 1, including groups inside alternations that did
// not participate (those are None).  The result retains the source string for
// group_text.  A Pattern that had to fall back to grouping-only states throws
// CaptureError.Unavailable instead of silently returning zero groups.
pub func find_captures_from(compiled Pattern, value string,
    from usize) option.Option[Captures] throws CaptureError {
    if !compiled.captures_available {
        throw CaptureError.Unavailable;
    }
    let runner = make_capture_runner(compiled, text.runes(value));
    return search_captures(runner, from, value);
}

// group_count returns the number of capture groups in a result.  A Pattern
// compiled from a pattern without parentheses has zero.
pub func group_count(captures Captures) usize {
    return vec.len(captures.groups);
}

// group returns group index 0 (the overall match) or 1..group_count.  An
// out-of-range or non-participating group is None.
pub func group(captures Captures, index usize) option.Option[Match] {
    if index == 0 {
        return option.Option[Match].Some(
            Match(start:captures.start, end:captures.end));
    }
    if index > vec.len(captures.groups) {
        return option.Option[Match].None;
    }
    return captures.groups[index - 1];
}

// group_text returns the captured source text without requiring the caller to
// index a group vector or slice the source.  The Captures value retains its
// source string, so this remains valid after the original source goes out of
// scope.  Out-of-range and non-participating groups return None.
pub func group_text(captures Captures, index usize) option.Option[string] {
    switch group(captures, index) {
        case option.Option.Some(span): {
            if span.start > span.end ||
               span.end > text.len(captures.source) { return option.Option[string].None; }
            return option.Option[string].Some(
                captures.source[span.start:span.end]);
        }
        case option.Option.None: return option.Option[string].None;
    }
}
