// Writer-priority readers-writer lock built only from std/sync primitives and
// ordinary shared Vec storage. A copied ReadWriteLock aliases the same state:
// the mutex, condition variable, reader table and owner cell are all shared.
//
// The lock is non-recursive: a thread may not acquire read twice, write twice,
// or upgrade/downgrade while holding the other mode. Those mistakes and
// unlocking from a thread that does not hold the lock Panic immediately rather
// than waiting for a deadlock.
package rwlock;

import "std/os" as os;
import "std/sync" as sync;
import "std/vec" as vec;

struct Owners {
    waiting_writers i64;
    waiting_readers i64;
    writer i64;
    first_reader i64;
}

struct State {
    // Direct native handles and Vec handles; copying ReadWriteLock copies these
    // aliases, so every copy operates on the same gate, reader table and owners.
    gate sync.Mutex;
    changed sync.Condvar;
    // Additional reader thread IDs. Nonempty only while first_reader is set.
    readers Vec[i64];
    // Waiter counts and the active writer and first reader IDs (0 if absent).
    owners Vec[Owners];
}

pub struct ReadWriteLock {
    state State;
}

func misuse() {
    // There is no source-level panic primitive. Unlocking a fresh mutex is an
    // existing runtime misuse path and terminates with the same
    // runtime-handle-misuse Panic used by std/sync; typed catch cannot absorb it.
    let unused = sync.mutex();
    sync.unlock(unused);
}

func current_thread() i64 {
    try {
        return i64(os.gettid());
    } catch error os.Error {
        misuse();
        return 0;
    }
}

func reader_index(readers Vec[i64], tid i64) i64 {
    let count = vec.len(readers);
    for var index usize = 0; index < count; index += 1 {
        if readers[index] == tid { return i64(index); }
    }
    return -1;
}

func remove_reader(readers Vec[i64], index usize) {
    let last = vec.len(readers) - 1;
    if index != last { readers[index] = readers[last]; }
    let removed = vec.pop(readers);
}

pub func new() ReadWriteLock {
    let readers = vec.empty[i64]();
    let owners = [Owners(waiting_writers: 0, waiting_readers: 0,
                         writer: 0, first_reader: 0)];
    return ReadWriteLock(state: State(
        gate: sync.mutex(),
        changed: sync.condvar(),
        readers: readers,
        owners: owners));
}

pub func read_lock(lock ReadWriteLock) {
    let tid = current_thread();
    sync.lock(lock.state.gate);
    var owners = lock.state.owners[0];
    let first = owners.first_reader;
    if owners.writer == tid || first == tid ||
       (first != 0 && reader_index(lock.state.readers, tid) >= 0) {
        sync.unlock(lock.state.gate);
        misuse();
    }

    if owners.writer != 0 || owners.waiting_writers != 0 {
        owners.waiting_readers += 1;
        lock.state.owners[0] = owners;
        for owners.writer != 0 || owners.waiting_writers != 0 {
            sync.wait(lock.state.changed, lock.state.gate);
            owners = lock.state.owners[0];
        }
        owners.waiting_readers -= 1;
    }
    if owners.first_reader == 0 {
        owners.first_reader = tid;
        lock.state.owners[0] = owners;
    } else {
        vec.push(lock.state.readers, tid);
        lock.state.owners[0] = owners;
    }
    sync.unlock(lock.state.gate);
}

pub func read_unlock(lock ReadWriteLock) {
    let tid = current_thread();
    sync.lock(lock.state.gate);
    var owners = lock.state.owners[0];
    if owners.first_reader == tid {
        let count = vec.len(lock.state.readers);
        if count == 0 {
            owners.first_reader = 0;
            lock.state.owners[0] = owners;
            if owners.waiting_writers != 0 || owners.waiting_readers != 0 {
                sync.notify_all(lock.state.changed);
            }
        } else {
            let last = count - 1;
            owners.first_reader = lock.state.readers[last];
            lock.state.owners[0] = owners;
            let removed = vec.pop(lock.state.readers);
        }
    } else {
        let index = reader_index(lock.state.readers, tid);
        if index < 0 {
            sync.unlock(lock.state.gate);
            misuse();
        }
        remove_reader(lock.state.readers, usize(index));
    }
    sync.unlock(lock.state.gate);
}

pub func write_lock(lock ReadWriteLock) {
    let tid = current_thread();
    sync.lock(lock.state.gate);
    var owners = lock.state.owners[0];
    let writer = owners.writer;
    let first = owners.first_reader;
    if writer == tid || first == tid ||
       (first != 0 && reader_index(lock.state.readers, tid) >= 0) {
        sync.unlock(lock.state.gate);
        misuse();
    }

    if writer != 0 || first != 0 {
        owners.waiting_writers += 1;
        lock.state.owners[0] = owners;
        for owners.writer != 0 || owners.first_reader != 0 {
            sync.wait(lock.state.changed, lock.state.gate);
            owners = lock.state.owners[0];
        }
        owners.waiting_writers -= 1;
    }
    owners.writer = tid;
    lock.state.owners[0] = owners;
    sync.unlock(lock.state.gate);
}

pub func write_unlock(lock ReadWriteLock) {
    let tid = current_thread();
    sync.lock(lock.state.gate);
    var owners = lock.state.owners[0];
    if owners.writer != tid {
        sync.unlock(lock.state.gate);
        misuse();
    }
    owners.writer = 0;
    lock.state.owners[0] = owners;
    if owners.waiting_writers != 0 || owners.waiting_readers != 0 {
        sync.notify_all(lock.state.changed);
    }
    sync.unlock(lock.state.gate);
}
