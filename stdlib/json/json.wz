// Strict RFC 8259 JSON reader and writer.
//
// Numbers are stored as their raw decimal token in Value.Number. The token is
// never converted through a double, so arbitrary-size integers and long
// fractions keep every digit. Use as_i64/as_u64/as_f64 (or number_text plus
// std/strconv) when a numeric value is needed. serialize validates the raw
// token of user-constructed Number values and rejects malformed tokens.
//
// Parser and serializer both accept at most 256 nested containers and report
// Error.DepthLimit instead of exhausting the stack. serialize and
// serialize_pretty also detect a cyclic Vec graph through that depth limit.
// serialize_pretty uses the conventional two-space indentation and never adds
// a trailing newline; empty arrays and objects stay on one line as [] and {}.
//
// Object duplicate keys: the last value wins, and the member keeps the
// position of its first occurrence. This applies to the parser; field applies
// the same last-match rule even to manually built objects, while the
// serializer still writes every member it is given in stored order.
//
// Error.Syntax offsets are Unicode code point indices into the input string,
// matching std/text.len and string indexing.
package json;

import "std/option" as option;
import "std/strconv" as strconv;
import "std/text" as text;
import "std/vec" as vec;

const MAX_DEPTH usize = 256;
const PRETTY_INDENT usize = 2;
// Objects with at least this many parsed members switch to a local
// open-addressed index for duplicate-name lookup. Smaller objects keep the
// linear scan.
const OBJECT_INDEX_MEMBER_THRESHOLD usize = 16;
const INDEX_EMPTY usize = ~usize(0);

pub enum Error {
    Syntax(offset usize);
    DepthLimit;
    InvalidNumber;
    NumberRange;
}

pub enum Value {
    Null;
    Bool(value bool);
    String(value string);
    Number(value string);
    Array(value Vec[Value]);
    Object(value Vec[Member]);
}

pub struct Member {
    pub name string;
    pub value Value;
}

func decode_utf8(bytes Vec[u8], offset usize) string throws Error {
    try {
        return text.from_bytes(bytes);
    } catch error text.Error {
        throw Error.Syntax(offset);
    }
}

func skip_whitespace(source Vec[u8], cursor inout usize) {
    for cursor < vec.len(source) {
        let rune = source[cursor];
        if rune == 32 || rune == 9 || rune == 10 || rune == 13 {
            cursor += 1;
        } else {
            break;
        }
    }
}

func is_digit(rune u32) bool { return rune >= 48 && rune <= 57; }

func push_byte(out Vec[u8], value u32) {
    vec.push(out, u8(value));
}

func push_rune(out Vec[u8], rune u32) {
    if rune <= 0x7f {
        push_byte(out, rune);
    } else if rune <= 0x7ff {
        push_byte(out, 0xc0 | (rune >> 6));
        push_byte(out, 0x80 | (rune & 0x3f));
    } else if rune <= 0xffff {
        push_byte(out, 0xe0 | (rune >> 12));
        push_byte(out, 0x80 | ((rune >> 6) & 0x3f));
        push_byte(out, 0x80 | (rune & 0x3f));
    } else {
        push_byte(out, 0xf0 | (rune >> 18));
        push_byte(out, 0x80 | ((rune >> 12) & 0x3f));
        push_byte(out, 0x80 | ((rune >> 6) & 0x3f));
        push_byte(out, 0x80 | (rune & 0x3f));
    }
}

func parse_hex4(source Vec[u8], cursor inout usize) u32 throws Error {
    var value u32 = 0;
    for var index usize = 0; index < 4; index += 1 {
        if cursor >= vec.len(source) {
            throw Error.Syntax(cursor);
        }
        let rune = u32(source[cursor]);
        var digit u32 = 0;
        if rune >= 48 && rune <= 57 {
            digit = rune - 48;
        } else if rune >= 65 && rune <= 70 {
            digit = rune - 55;
        } else if rune >= 97 && rune <= 102 {
            digit = rune - 87;
        } else {
            throw Error.Syntax(cursor);
        }
        value = value * 16 + digit;
        cursor += 1;
    }
    return value;
}

func parse_string(source Vec[u8], cursor inout usize) string throws Error {
    cursor += 1;
    let start = cursor;
    let length = vec.len(source);
    for cursor < length {
        let byte = source[cursor];
        if byte == 34 {
            let end = cursor;
            cursor += 1;
            return decode_utf8(source[start:end], cursor);
        }
        if byte < 0x20 {
            throw Error.Syntax(cursor);
        }
        if byte == 92 {
            let prefix = source[start:cursor];
            return parse_escaped_string(source, inout cursor, prefix);
        }
        cursor += 1;
    }
    throw Error.Syntax(cursor);
}

func parse_escaped_string(source Vec[u8], cursor inout usize, out Vec[u8]) string throws Error {
    let length = vec.len(source);
    for true {
        if cursor >= length {
            throw Error.Syntax(cursor);
        }
        let rune = u32(source[cursor]);
        if rune == 34 {
            cursor += 1;
            return decode_utf8(out, cursor);
        }
        if rune < 0x20 {
            throw Error.Syntax(cursor);
        }
        if rune != 92 {
            push_byte(out, rune);
            cursor += 1;
            continue;
        }
        cursor += 1;
        if cursor >= length {
            throw Error.Syntax(cursor);
        }
        let escape = u32(source[cursor]);
        if escape == 34 || escape == 92 || escape == 47 {
            push_byte(out, escape);
            cursor += 1;
            continue;
        }
        if escape == 98 {
            push_byte(out, 8);
            cursor += 1;
            continue;
        }
        if escape == 102 {
            push_byte(out, 12);
            cursor += 1;
            continue;
        }
        if escape == 110 {
            push_byte(out, 10);
            cursor += 1;
            continue;
        }
        if escape == 114 {
            push_byte(out, 13);
            cursor += 1;
            continue;
        }
        if escape == 116 {
            push_byte(out, 9);
            cursor += 1;
            continue;
        }
        if escape != 117 {
            throw Error.Syntax(cursor);
        }
        cursor += 1;
        let high = parse_hex4(source, inout cursor);
        if high >= 0xd800 && high <= 0xdbff {
            if cursor + 1 >= length || source[cursor] != 92 || source[cursor + 1] != 117 {
                throw Error.Syntax(cursor);
            }
            cursor += 2;
            let low = parse_hex4(source, inout cursor);
            if low < 0xdc00 || low > 0xdfff {
                throw Error.Syntax(cursor);
            }
            let scalar = 0x10000 + ((high - 0xd800) << 10) + (low - 0xdc00);
            push_rune(out, scalar);
            continue;
        }
        if high >= 0xdc00 && high <= 0xdfff {
            throw Error.Syntax(cursor);
        }
        push_rune(out, high);
    }
    throw Error.Syntax(cursor);
}

func scan_number(source Vec[u8], cursor inout usize) throws Error {
    let start = cursor;
    let length = vec.len(source);
    if source[cursor] == 45 {
        cursor += 1;
    }
    if cursor >= length {
        throw Error.Syntax(start);
    }
    if source[cursor] == 48 {
        cursor += 1;
    } else if is_digit(u32(source[cursor])) {
        cursor += 1;
        for cursor < length && is_digit(u32(source[cursor])) {
            cursor += 1;
        }
    } else {
        throw Error.Syntax(cursor);
    }
    if cursor < length && source[cursor] == 46 {
        cursor += 1;
        if cursor >= length || !is_digit(u32(source[cursor])) {
            throw Error.Syntax(cursor);
        }
        for cursor < length && is_digit(u32(source[cursor])) {
            cursor += 1;
        }
    }
    if cursor < length && (source[cursor] == 101 || source[cursor] == 69) {
        cursor += 1;
        if cursor < length && (source[cursor] == 43 || source[cursor] == 45) {
            cursor += 1;
        }
        if cursor >= length || !is_digit(u32(source[cursor])) {
            throw Error.Syntax(cursor);
        }
        for cursor < length && is_digit(u32(source[cursor])) {
            cursor += 1;
        }
    }
}

func match_word(source Vec[u8], cursor inout usize, word string) bool {
    var length usize = 0;
    for rune in word {
        if cursor + length >= vec.len(source) || u32(source[cursor + length]) != rune {
            return false;
        }
        length += 1;
    }
    cursor += length;
    return true;
}

func parse_array(source Vec[u8], cursor inout usize, depth usize) Value throws Error {
    cursor += 1;
    let items = vec.empty[Value]();
    skip_whitespace(source, inout cursor);
    if cursor >= vec.len(source) {
        throw Error.Syntax(cursor);
    }
    if source[cursor] == 93 {
        cursor += 1;
        return Value.Array(items);
    }
    for true {
        let item = parse_value(source, inout cursor, depth + 1);
        vec.push(items, item);
        skip_whitespace(source, inout cursor);
        if cursor >= vec.len(source) {
            throw Error.Syntax(cursor);
        }
        if source[cursor] == 44 {
            cursor += 1;
            skip_whitespace(source, inout cursor);
            continue;
        }
        if source[cursor] == 93 {
            cursor += 1;
            return Value.Array(items);
        }
        throw Error.Syntax(cursor);
    }
    throw Error.Syntax(cursor);
}

// Local FNV-1a/avalanche hash for the object-member index. It is not a
// security boundary and is only used to reduce duplicate-key comparisons.
func key_hash(value string) u64 {
    var state u64 = 14695981039346656037;
    var count u64 = 0;
    for rune in value {
        state = (state ^ u64(rune)) * 1099511628211;
        count += 1;
    }
    state = (state ^ count) * 1099511628211;
    state ^= state >> 33;
    state *= 0xff51afd7ed558ccd;
    state ^= state >> 33;
    state *= 0xc4ceb9fe1a85ec53;
    state ^= state >> 33;
    return state;
}

// A local open-addressed slot keeps the member index and its retained key
// hash together. Small objects still only pay for the empty table; the wider
// slots exist only after the index is built. Growth reuses the stored hashes
// instead of re-hashing resident keys.
struct IndexSlot {
    hash u64;
    member usize;
}

func empty_slot() IndexSlot { return IndexSlot(hash: 0, member: INDEX_EMPTY); }

func index_grow(table inout Vec[IndexSlot]) {
    let larger = vec.make[IndexSlot](vec.len(table) * 2, empty_slot());
    let mask = vec.len(larger) - 1;
    for var index usize = 0; index < vec.len(table); index += 1 {
        let entry = table[index];
        if entry.member == INDEX_EMPTY { continue; }
        var slot = usize(entry.hash) & mask;
        for true {
            if larger[slot].member == INDEX_EMPTY {
                larger[slot] = entry;
                break;
            }
            slot = (slot + 1) & mask;
        }
    }
    table = larger;
}

// index_insert stores a member that the caller already proved new.
func index_insert(table inout Vec[IndexSlot], count inout usize, hash u64, member_index usize) {
    if vec.len(table) == 0 {
        table = vec.make[IndexSlot](32, empty_slot());
    }
    if (count + 1) * 2 > vec.len(table) {
        index_grow(inout table);
    }
    let mask = vec.len(table) - 1;
    var slot = usize(hash) & mask;
    for true {
        if table[slot].member == INDEX_EMPTY {
            table[slot] = IndexSlot(hash: hash, member: member_index);
            count += 1;
            return;
        }
        slot = (slot + 1) & mask;
    }
}

// index_find_or_insert probes once for both outcomes. A new member is written
// into the empty slot of that same probe, so the ordinary no-grow insertion
// does not probe twice. Only growth re-probes; duplicate keys never grow the
// table. A retained hash that matches still needs exact string equality, so a
// collision cannot hide a distinct key.
func index_find_or_insert(table inout Vec[IndexSlot], members Vec[Member], count inout usize, key string, hash u64, member_index usize) usize {
    let mask = vec.len(table) - 1;
    var slot = usize(hash) & mask;
    for true {
        let entry = table[slot];
        if entry.member == INDEX_EMPTY {
            if (count + 1) * 2 > vec.len(table) {
                index_grow(inout table);
                index_insert(inout table, inout count, hash, member_index);
                return INDEX_EMPTY;
            }
            table[slot] = IndexSlot(hash: hash, member: member_index);
            count += 1;
            return INDEX_EMPTY;
        }
        if entry.hash == hash && members[entry.member].name == key { return entry.member; }
        slot = (slot + 1) & mask;
    }
    return INDEX_EMPTY;
}

func parse_object(source Vec[u8], cursor inout usize, depth usize) Value throws Error {
    cursor += 1;
    let members = vec.empty[Member]();
    skip_whitespace(source, inout cursor);
    if cursor >= vec.len(source) {
        throw Error.Syntax(cursor);
    }
    if source[cursor] == 125 {
        cursor += 1;
        return Value.Object(members);
    }
    var table = vec.empty[IndexSlot]();
    var indexed_count usize = 0;
    var indexed = false;
    var parsed_members usize = 0;
    for true {
        parsed_members += 1;
        if cursor >= vec.len(source) || source[cursor] != 34 {
            throw Error.Syntax(cursor);
        }
        let name = parse_string(source, inout cursor);
        skip_whitespace(source, inout cursor);
        if cursor >= vec.len(source) || source[cursor] != 58 {
            throw Error.Syntax(cursor);
        }
        cursor += 1;
        skip_whitespace(source, inout cursor);
        let member_value = parse_value(source, inout cursor, depth + 1);
        if !indexed && parsed_members >= OBJECT_INDEX_MEMBER_THRESHOLD {
            table = vec.make[IndexSlot](32, empty_slot());
            var count usize = 0;
            for var index usize = 0; index < vec.len(members); index += 1 {
                index_insert(inout table, inout count, key_hash(members[index].name), index);
            }
            indexed_count = count;
            indexed = true;
        }
        var replaced = false;
        if indexed {
            let name_hash = key_hash(name);
            let found = index_find_or_insert(inout table, members, inout indexed_count, name, name_hash, vec.len(members));
            if found != INDEX_EMPTY {
                members[found].value = member_value;
                replaced = true;
            }
        } else {
            for var index usize = 0; index < vec.len(members); index += 1 {
                if members[index].name == name {
                    members[index].value = member_value;
                    replaced = true;
                    break;
                }
            }
        }
        if !replaced {
            vec.push(members, Member(name: name, value: member_value));
        }
        skip_whitespace(source, inout cursor);
        if cursor >= vec.len(source) {
            throw Error.Syntax(cursor);
        }
        if source[cursor] == 44 {
            cursor += 1;
            skip_whitespace(source, inout cursor);
            continue;
        }
        if source[cursor] == 125 {
            cursor += 1;
            return Value.Object(members);
        }
        throw Error.Syntax(cursor);
    }
    throw Error.Syntax(cursor);
}

func parse_value(source Vec[u8], cursor inout usize, depth usize) Value throws Error {
    if cursor >= vec.len(source) {
        throw Error.Syntax(cursor);
    }
    let rune = u32(source[cursor]);
    if rune == 91 || rune == 123 {
        if depth >= MAX_DEPTH {
            throw Error.DepthLimit;
        }
        if rune == 91 {
            return parse_array(source, inout cursor, depth);
        }
        return parse_object(source, inout cursor, depth);
    }
    if rune == 34 {
        return Value.String(parse_string(source, inout cursor));
    }
    if rune == 45 || is_digit(rune) {
        let start = cursor;
        scan_number(source, inout cursor);
        return Value.Number(decode_utf8(source[start:cursor], start));
    }
    let start = cursor;
    if rune == 116 && match_word(source, inout cursor, "true") {
        return Value.Bool(true);
    }
    if rune == 102 && match_word(source, inout cursor, "false") {
        return Value.Bool(false);
    }
    if rune == 110 && match_word(source, inout cursor, "null") {
        return Value.Null;
    }
    throw Error.Syntax(start);
}

pub func parse(source string) Value throws Error {
    let bytes = text.bytes(source);
    var cursor usize = 0;
    try {
        skip_whitespace(bytes, inout cursor);
        let value = parse_value(bytes, inout cursor, 0);
        skip_whitespace(bytes, inout cursor);
        if cursor != vec.len(bytes) {
            throw Error.Syntax(cursor);
        }
        return value;
    } catch error Error {
        switch error {
            case Error.Syntax(offset): {
                // The scanner indexes valid UTF-8 bytes. Count leading bytes
                // only on failure to recover the public code point position.
                var codepoints usize = 0;
                for var index usize = 0; index < offset; index += 1 {
                    if (bytes[index] & 0xc0) != 0x80 { codepoints += 1; }
                }
                throw Error.Syntax(codepoints);
            }
            case _: throw error;
        }
    }
}

func valid_number(token string) bool {
    let bytes = text.bytes(token);
    let length = vec.len(bytes);
    if length == 0 {
        return false;
    }
    var cursor usize = 0;
    try {
        scan_number(bytes, inout cursor);
        return cursor == length;
    } catch error Error {
        return false;
    }
}

// Integer conversions accept only tokens without a fraction or exponent.
// parse_i64/parse_u64 deliberately reject those as InvalidSyntax.
func integer_token(token string) bool {
    let bytes = text.bytes(token);
    for var index usize = 0; index < vec.len(bytes); index += 1 {
        let byte = bytes[index];
        if byte == 46 || byte == 101 || byte == 69 { return false; }
    }
    return true;
}

func write_number(out Vec[u8], token string) Unit throws Error {
    let bytes = text.bytes(token);
    let count = vec.len(bytes);
    if count == 0 { throw Error.InvalidNumber; }
    var cursor usize = 0;
    var valid = false;
    try {
        scan_number(bytes, inout cursor);
        valid = cursor == count;
    } catch error Error {
        valid = false;
    }
    if !valid { throw Error.InvalidNumber; }
    vec.extend(out, bytes);
}

func write_hex_digit(out Vec[u8], digit u8) {
    if digit < 10 { vec.push(out, 48 + digit); }
    else { vec.push(out, 87 + digit); }
}

func write_string(out Vec[u8], value string) {
    vec.push(out, 34);
    // No byte of a multibyte UTF-8 scalar can match the ASCII escape set.
    let bytes = text.bytes(value);
    let count = vec.len(bytes);
    for var index usize = 0; index < count; index += 1 {
        let byte = bytes[index];
        if byte >= 32 && byte != 34 && byte != 92 {
            vec.push(out, byte);
            continue;
        }
        vec.push(out, 92);
        switch byte {
            case 34: vec.push(out, 34);
            case 92: vec.push(out, 92);
            case 8: vec.push(out, 98);
            case 12: vec.push(out, 102);
            case 10: vec.push(out, 110);
            case 13: vec.push(out, 114);
            case 9: vec.push(out, 116);
            case _: {
                vec.push(out, 117);
                vec.push(out, 48);
                vec.push(out, 48);
                write_hex_digit(out, byte >> 4);
                write_hex_digit(out, byte & 15);
            }
        }
    }
    vec.push(out, 34);
}

func write_indent(out Vec[u8], depth usize) {
    vec.push(out, 10);
    for var index usize = 0; index < depth * PRETTY_INDENT; index += 1 {
        vec.push(out, 32);
    }
}

func write_value(out Vec[u8], value Value, depth usize, pretty bool) throws Error {
    switch value {
        case Value.Null: {
            vec.push(out, 110);
            vec.push(out, 117);
            vec.push(out, 108);
            vec.push(out, 108);
        }
        case Value.Bool(item): {
            if item {
                vec.push(out, 116);
                vec.push(out, 114);
                vec.push(out, 117);
                vec.push(out, 101);
            } else {
                vec.push(out, 102);
                vec.push(out, 97);
                vec.push(out, 108);
                vec.push(out, 115);
                vec.push(out, 101);
            }
        }
        case Value.String(item): write_string(out, item);
        case Value.Number(token): write_number(out, token);
        case Value.Array(items): {
            if depth >= MAX_DEPTH { throw Error.DepthLimit; }
            vec.push(out, 91);
            let count = vec.len(items);
            for var index usize = 0; index < count; index += 1 {
                if index != 0 { vec.push(out, 44); }
                if pretty { write_indent(out, depth + 1); }
                write_value(out, items[index], depth + 1, pretty);
            }
            if pretty && count != 0 { write_indent(out, depth); }
            vec.push(out, 93);
        }
        case Value.Object(members): {
            if depth >= MAX_DEPTH { throw Error.DepthLimit; }
            vec.push(out, 123);
            let count = vec.len(members);
            for var index usize = 0; index < count; index += 1 {
                if index != 0 { vec.push(out, 44); }
                if pretty { write_indent(out, depth + 1); }
                let member = members[index];
                write_string(out, member.name);
                vec.push(out, 58);
                if pretty { vec.push(out, 32); }
                write_value(out, member.value, depth + 1, pretty);
            }
            if pretty && count != 0 { write_indent(out, depth); }
            vec.push(out, 125);
        }
    }
}

pub func serialize(value Value) string throws Error {
    let out = vec.empty[u8]();
    write_value(out, value, 0, false);
    return decode_utf8(out, 0);
}

// serialize_pretty writes the same JSON value with two-space indentation.
pub func serialize_pretty(value Value) string throws Error {
    let out = vec.empty[u8]();
    write_value(out, value, 0, true);
    return decode_utf8(out, 0);
}

// field returns the value of the last object member with the given name.
// Parsed objects already contain the last value at the first position, and
// manually built objects use the same last-match rule without being reordered
// or deduplicated.
pub func field(value Value, name string) option.Option[Value] {
    switch value {
        case Value.Object(members): {
            var index = vec.len(members);
            for index > 0 {
                index -= 1;
                if members[index].name == name {
                    return option.Option[Value].Some(members[index].value);
                }
            }
            return option.Option[Value].None;
        }
        case _: return option.Option[Value].None;
    }
}

// index returns an array element when position is in range.
pub func index(value Value, position usize) option.Option[Value] {
    switch value {
        case Value.Array(items): {
            if position < vec.len(items) {
                return option.Option[Value].Some(items[position]);
            }
            return option.Option[Value].None;
        }
        case _: return option.Option[Value].None;
    }
}

pub func number_text(value Value) option.Option[string] {
    switch value {
        case Value.Number(token): return option.Option[string].Some(token);
        case _: return option.Option[string].None;
    }
}

pub func as_i64(value Value) i64 throws Error {
    switch value {
        case Value.Number(token): {
            if !valid_number(token) { throw Error.InvalidNumber; }
            if !integer_token(token) { throw Error.InvalidNumber; }
            try {
                return strconv.parse_i64(token);
            } catch error strconv.Error {
                switch error {
                    case strconv.Error.InvalidSyntax: throw Error.InvalidNumber;
                    case strconv.Error.OutOfRange: throw Error.NumberRange;
                }
            }
        }
        case _: throw Error.InvalidNumber;
    }
}

pub func as_u64(value Value) u64 throws Error {
    switch value {
        case Value.Number(token): {
            if !valid_number(token) { throw Error.InvalidNumber; }
            if !integer_token(token) { throw Error.InvalidNumber; }
            // parse_u64 reports a leading minus as InvalidSyntax. Any negative
            // integer token (including the -0 spelling) is outside the u64
            // domain, so it is a range failure rather than a malformed number.
            if token[0] == 45 { throw Error.NumberRange; }
            try {
                return strconv.parse_u64(token);
            } catch error strconv.Error {
                switch error {
                    case strconv.Error.InvalidSyntax: throw Error.InvalidNumber;
                    case strconv.Error.OutOfRange: throw Error.NumberRange;
                }
            }
        }
        case _: throw Error.InvalidNumber;
    }
}

pub func as_f64(value Value) f64 throws Error {
    switch value {
        case Value.Number(token): {
            if !valid_number(token) { throw Error.InvalidNumber; }
            try {
                return strconv.parse_f64(token);
            } catch error strconv.Error {
                throw Error.NumberRange;
            }
        }
        case _: throw Error.InvalidNumber;
    }
}
