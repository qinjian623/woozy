func wz_normalize_nfd_page(rune u32) string {
    if rune < 503 {
        if rune < 65 {
            if rune < 12 {
                return "";
            } else if rune > 64 {
                return "";
            } else {
                return wz_normalize_nfd_page_chunk_0(rune);
            }
        } else if rune > 248 {
            if rune < 249 {
                return "";
            } else if rune > 502 {
                return "";
            } else {
                return wz_normalize_nfd_page_chunk_2(rune);
            }
        } else {
            return wz_normalize_nfd_page_chunk_1(rune);
        }
    } else if rune > 778 {
        if rune < 4010 {
            if rune < 779 {
                return "";
            } else if rune > 4009 {
                return "";
            } else {
                return wz_normalize_nfd_page_chunk_4(rune);
            }
        } else if rune > 12163 {
            if rune < 12164 {
                return "";
            } else if rune > 12193 {
                return "";
            } else {
                return wz_normalize_nfd_page_chunk_6(rune);
            }
        } else {
            return wz_normalize_nfd_page_chunk_5(rune);
        }
    } else {
        return wz_normalize_nfd_page_chunk_3(rune);
    }
    return "";
}

