    let second = data[base+5];
    if second != 0 { case_append_rune(out, second); }
    let third = data[base+6];
    if third != 0 { case_append_rune(out, third); }
}

func case_mapping(rune u32, out Vec[u8], data string) {
    if data != "" {
        var low usize = 0;
        var high usize = text.len(data) / 7;
        for low < high {
            let middle = (low+high)/2;
            let base = middle*7;
            let start = data[base];
            let end = data[base+1];
            if rune < start {
                high = middle;
            } else if rune > end {
                low = middle+1;
            } else {
                case_apply_record(data, base, rune, out);
                return;
            }
        }
    }
    case_append_rune(out, rune);
}

func case_property_lookup(data string, rune u32) bool {
    if data == "" { return false; }
    var low usize = 0;
    var high usize = text.len(data) / 2;
    for low < high {
        let middle = (low+high)/2;
        let base = middle*2;
        let start = data[base];
        let end = data[base+1];
        if rune < start { high = middle; }
        else if rune > end { low = middle+1; }
        else { return true; }
    }
    return false;
}

