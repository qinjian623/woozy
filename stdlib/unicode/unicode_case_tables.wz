func case_upper(rune u32, out Vec[u8]) {
    case_mapping(rune, out, case_upper_page(rune >> 6));
}

func case_lower(rune u32, out Vec[u8]) {
    case_mapping(rune, out, case_lower_page(rune >> 6));
}

func case_is_cased(rune u32) bool {
    return case_property_lookup(case_cased_page(rune >> 7), rune);
}

func case_is_case_ignorable(rune u32) bool {
    return case_property_lookup(case_ignorable_page(rune >> 7), rune);
}

