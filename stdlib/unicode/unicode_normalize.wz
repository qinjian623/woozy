// Pure Woozy implementation of Unicode 18.0.0 normalization.
//
// This file is deliberately package-private: normalize() in unicode.wz keeps
// its public signature and ASCII fast path, and casefold/upper/lower/grapheme
// conversion remain on their existing implementations.  The tables live in
// unicode_normalize_tables.wz and are generated from the repository's Unicode
// 18.0.0 data; no native runtime entry point is called here.
package unicode;

import "std/text" as text;
import "std/vec" as vec;

// NFC/NFD/NFKC/NFKD with the same Form values and result as the runtime ABI.
func wz_normalize(value string, form Form) string {
    switch form {
        case Form.NFC: return wz_normalize_impl(value,false,true);
        case Form.NFD: return wz_normalize_impl(value,false,false);
        case Form.NFKC: return wz_normalize_impl(value,true,true);
        case Form.NFKD: return wz_normalize_impl(value,true,false);
    }
}

// Decode directly into the decomposition buffer.  text.runes() would first
// build a second Vec[u32] that this loop copies into the buffer, so using the
// package-private utf8_rune/utf8_next helpers avoids that extra pass.
func wz_normalize_impl(value string, compat bool, compose bool) string {
    let data = text.bytes(value);
    if wz_normalize_is_identity(data,compat,compose) { return value; }
    let buffer = vec.empty[u32]();
    vec.reserve(buffer,text.len(value));
    let total = vec.len(data);
    var offset usize = 0;
    for offset < total {
        let rune = utf8_rune(data,offset);
        if rune >= 0xac00 && rune <= 0xd7a3 {
            wz_normalize_hangul(rune,buffer);
        } else if compat {
            let page = wz_normalize_nfkd_page(rune >> WZ_NORMALIZE_PAGE_SHIFT);
            wz_normalize_append_mapping(page,rune,buffer);
        } else {
            let page = wz_normalize_nfd_page(rune >> WZ_NORMALIZE_PAGE_SHIFT);
            wz_normalize_append_mapping(page,rune,buffer);
        }
        offset = utf8_next(data,offset);
    }
    wz_normalize_reorder(buffer);
    if compose {
        let length = wz_normalize_compose(buffer);
        return wz_normalize_encode(buffer,length);
    }
    return wz_normalize_encode(buffer,vec.len(buffer));
}

// Conservative Unicode Quick_Check identity test.  The generated NFC/NFKC
// sets contain every scalar whose single-scalar form changes (No) and every
// scalar that can combine with a preceding character (Maybe, including
// algorithmic Hangul V/T).  Requiring all scalars to be quick-check Yes and
// all combining classes to be zero is sufficient for NFC/NFKC identity.
// For NFD/NFKD, no decomposition mapping and nondecreasing nonzero classes
// are sufficient because decomposition does not compose.
func wz_normalize_is_identity(data Vec[u8], compat bool, compose bool) bool {
    let total = vec.len(data);
    var offset usize = 0;
    var previous_class u32 = 0;
    for offset < total {
        let rune = utf8_rune(data,offset);
        if compose {
            if wz_normalize_ccc(rune) != 0 { return false; }
            if compat {
                if wz_normalize_nfkc_bad(rune) != 0 { return false; }
            } else {
                if wz_normalize_nfc_bad(rune) != 0 { return false; }
            }
        } else {
            if rune >= 0xac00 && rune <= 0xd7a3 { return false; }
            if compat {
                let page = wz_normalize_nfkd_page(rune >> WZ_NORMALIZE_PAGE_SHIFT);
                if page != "" && wz_normalize_page_entry(page,rune) != 0 { return false; }
            } else {
                let page = wz_normalize_nfd_page(rune >> WZ_NORMALIZE_PAGE_SHIFT);
                if page != "" && wz_normalize_page_entry(page,rune) != 0 { return false; }
            }
            let current_class = wz_normalize_ccc(rune);
            if current_class != 0 && previous_class > current_class { return false; }
            previous_class = current_class;
        }
        offset = utf8_next(data,offset);
    }
    return true;
}

// A page starts with a 32-byte header holding two 6-bit digits per slot,
// high digit first.  Header offsets are relative to the page start and are
// zero when the slot has no decomposition.  A nonzero offset selects a record
// containing one 6-bit target count followed by four 6-bit digits per target.
// Every field is a printable ASCII byte biased by 32, so decoding uses only
// indexed loads and never scans UTF-8.
func wz_normalize_page_entry(data string, rune u32) u32 {
    let index = usize(rune & WZ_NORMALIZE_PAGE_MASK) * 2;
    let high = u32(data[index]) - 32;
    let low = u32(data[index + 1]) - 32;
    return (high << 6) | low;
}

func wz_normalize_page_value(data string, index usize) u32 {
    var value u32 = u32(data[index]) - 32;
    value = (value << 6) | (u32(data[index + 1]) - 32);
    value = (value << 6) | (u32(data[index + 2]) - 32);
    value = (value << 6) | (u32(data[index + 3]) - 32);
    return value;
}

// Append one table page entry.  An empty page or a zero header offset means
// the scalar has no mapping and is copied unchanged.
func wz_normalize_append_mapping(data string, rune u32, out Vec[u32]) {
    if data == "" {
        vec.push(out,rune);
        return;
    }
    let base = usize(wz_normalize_page_entry(data,rune));
    if base == 0 {
        vec.push(out,rune);
        return;
    }
    let length = u32(data[base]) - 32;
    var index usize = 0;
    for index < usize(length) {
        vec.push(out,wz_normalize_page_value(data,base + 1 + index * 4));
        index += 1;
    }
}

// Hangul syllable decomposition from UAX #15 section 3.12.  NFKD uses the
// same decomposition as NFD for Hangul syllables.
func wz_normalize_hangul(rune u32, out Vec[u32]) {
    let sindex = rune - 0xac00;
    let lead = 0x1100 + sindex / 588;
    let vowel = 0x1161 + (sindex % 588) / 28;
    vec.push(out,lead);
    vec.push(out,vowel);
    let trail = sindex % 28;
    if trail != 0 { vec.push(out,0x11a7 + trail); }
}

// Canonical ordering: stable-sort each maximal run of non-starters by
// combining class.  Starters (class 0) are never moved, which is the same
// result as utf8proc's adjacent-swap pass.  Short runs use insertion sort;
// long runs use a stable counting sort so a deliberately reversed combining
// sequence cannot make reordering quadratic.
// Inserting a run of this length takes at most about as many shifts as
// scanning the 256 fixed combining-class buckets once.
const WZ_NORMALIZE_INSERTION_LIMIT usize = 24;

func wz_normalize_reorder(buffer Vec[u32]) {
    let total = vec.len(buffer);
    if total < 2 { return; }
    var start usize = 0;
    for start < total {
        if wz_normalize_ccc(buffer[start]) == 0 {
            start += 1;
            continue;
        }
        var end = start+1;
        for end < total && wz_normalize_ccc(buffer[end]) != 0 { end += 1; }
        if end-start > 1 {
            if end-start <= WZ_NORMALIZE_INSERTION_LIMIT {
                wz_normalize_insertion_sort(buffer,start,end);
            } else {
                wz_normalize_counting_sort(buffer,start,end);
            }
        }
        start = end;
    }
}

func wz_normalize_insertion_sort(buffer Vec[u32], start usize, end usize) {
    for var index usize = start+1; index < end; index += 1 {
        let value = buffer[index];
        let value_class = wz_normalize_ccc(value);
        var position = index;
        for position > start {
            let previous_class = wz_normalize_ccc(buffer[position-1]);
            if previous_class <= value_class { break; }
            buffer[position] = buffer[position-1];
            position -= 1;
        }
        buffer[position] = value;
    }
}

// Counting sort is stable because equal classes are emitted in input order.
// Class 0 never occurs in a run, so the zero bucket is reserved and unused.
func wz_normalize_counting_sort(buffer Vec[u32], start usize, end usize) {
    let counts = vec.make[usize](256,0);
    for var index usize = start; index < end; index += 1 {
        let value_class = usize(wz_normalize_ccc(buffer[index]));
        counts[value_class] += 1;
    }
    var offset usize = 0;
    for var value_class usize = 1; value_class < 256; value_class += 1 {
        let count = counts[value_class];
        counts[value_class] = offset;
        offset += count;
    }
    let length = end-start;
    let scratch = vec.make[u32](length,0);
    for var index usize = start; index < end; index += 1 {
        let value = buffer[index];
        let value_class = usize(wz_normalize_ccc(value));
        scratch[counts[value_class]] = value;
        counts[value_class] += 1;
    }
    for var index usize = 0; index < length; index += 1 {
        buffer[start+index] = scratch[index];
    }
}

// Canonical composition from UAX #15, including Hangul L+V and LV+T and the
// combining-class blocking rule.  has_maximum/maximum_class mirror utf8proc's
// -1 sentinel: a class 0 scalar may compose only when no mark has been seen
// since the starter.
func wz_normalize_compose(buffer Vec[u32]) usize {
    let total = vec.len(buffer);
    var read usize = 0;
    var written usize = 0;
    var starter usize = 0;
    var has_starter bool = false;
    var maximum_class u32 = 0;
    var has_maximum bool = false;
    for read < total {
        let current = buffer[read];
        let current_class = wz_normalize_ccc(current);
        var merged = false;
        if has_starter && (!has_maximum || current_class > maximum_class) {
            let first = buffer[starter];
            if first >= 0x1100 && first < 0x1113 {
                if current >= 0x1161 && current < 0x1176 {
                    let lindex = first - 0x1100;
                    let vindex = current - 0x1161;
                    buffer[starter] = 0xac00 + (lindex * 21 + vindex) * 28;
                    merged = true;
                }
            }
            if !merged && first >= 0xac00 && first < 0xd7a4 &&
               (first - 0xac00) % 28 == 0 {
                if current >= 0x11a8 && current < 0x11c3 {
                    buffer[starter] = first + (current - 0x11a7);
                    merged = true;
                }
            }
            if !merged {
                let composite = wz_normalize_compose_pair(first,current);
                if composite != 0 {
                    buffer[starter] = composite;
                    merged = true;
                }
            }
        }
        if !merged {
            if written != read { buffer[written] = current; }
            if current_class != 0 {
                if !has_maximum || current_class > maximum_class {
                    maximum_class = current_class;
                    has_maximum = true;
                }
            } else {
                starter = written;
                has_starter = true;
                has_maximum = false;
            }
            written += 1;
        }
        read += 1;
    }
    return written;
}

// Encode exactly limit scalars in two passes so the output allocation is made
// once.  The byte-width sum is at most 4*limit.  runes is a real Vec[u32] with
// a checked backing allocation, and every private caller passes limit <= len,
// so 4*limit fits usize along with the exact allocation below.
func wz_normalize_encode(runes Vec[u32], limit usize) string {
    var size usize = 0;
    var index usize = 0;
    for index < limit {
        let rune = runes[index];
        if rune < 0x80 {
            size += 1;
        } else if rune < 0x800 {
            size += 2;
        } else if rune < 0x10000 {
            size += 3;
        } else {
            size += 4;
        }
        index += 1;
    }
    let out = vec.make[u8](size,0);
    var offset usize = 0;
    index = 0;
    for index < limit {
        let rune = runes[index];
        if rune < 0x80 {
            out[offset] = u8(rune);
            offset += 1;
        } else if rune < 0x800 {
            out[offset] = u8(0xc0 | (rune >> 6));
            out[offset + 1] = u8(0x80 | (rune & 0x3f));
            offset += 2;
        } else if rune < 0x10000 {
            out[offset] = u8(0xe0 | (rune >> 12));
            out[offset + 1] = u8(0x80 | ((rune >> 6) & 0x3f));
            out[offset + 2] = u8(0x80 | (rune & 0x3f));
            offset += 3;
        } else {
            out[offset] = u8(0xf0 | (rune >> 18));
            out[offset + 1] = u8(0x80 | ((rune >> 12) & 0x3f));
            out[offset + 2] = u8(0x80 | ((rune >> 6) & 0x3f));
            out[offset + 3] = u8(0x80 | (rune & 0x3f));
            offset += 4;
        }
        index += 1;
    }
    return wz_normalize_string_from_bytes(out);
}

func wz_normalize_string_from_bytes(data Vec[u8]) string {
    try {
        return text.from_bytes(data);
    } catch error text.Error {
        // All input and table scalars are valid Unicode scalar values.
        return "";
    }
}
