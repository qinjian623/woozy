package main;

struct Point {
    x f64;
    y f64;
}

trait SquaredNorm {
    func squared_norm(self Self) f64;
}

impl SquaredNorm for Point {
    func squared_norm(self Point) f64 {
        return self.x * self.x + self.y * self.y;
    }
}

func main() i32 {
    let point = Point(x: 3.0, y: 4.0);
    let norm = point.squared_norm();
    if norm != 25.0 {
        return 1;
    }
    return 0;
}
