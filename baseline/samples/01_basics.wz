package main;

// v0.1 示例；正式源文件后缀为 .wz。
// 本文件展示词法、初始化、值构造和两种 for。

struct Point {
    x f64;
    y f64;
}

func squared_distance(a Point, b Point) f64 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    return dx * dx + dy * dy;
}

func main() i32 {
    let decimal i64 = 1_024;
    let hexadecimal i64 = 0x2A;
    let binary i64 = 0b101010;
    let exponent f64 = 1.25e2;
    let text = "中文与 UTF-8\nquote: \"; slash: \\";
    let enabled = true;

    let origin = Point(x: 0.0, y: 0.0);
    let position = Point(x: 3.0, y: 4.0);
    let distance = squared_distance(origin, position);

    var count i32 = 0;
    for var i i32 = 0; i < 4; i += 1 {
        count += i;
    }
    for count < 10 {
        count += 1;
    }

    if decimal != 1024 || hexadecimal != 42 || binary != 42 {
        return 1;
    }
    if exponent != 125.0 || !enabled {
        return 2;
    }
    if distance != 25.0 || count != 10 {
        return 3;
    }
    return 0;
}
