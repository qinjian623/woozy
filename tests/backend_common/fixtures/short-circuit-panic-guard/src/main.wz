package app;

func main() i32 {
    var zero i32 = 0;
    var width i32 = 32;
    var one i32 = 1;
    var enabled bool = false;
    var and_count i32 = 0;
    var or_count i32 = 0;

    if enabled && (7 / zero == 0) {
        and_count += 1;
    }
    if !enabled || (7 / zero == 0) {
        or_count += 1;
    }
    if enabled && (one << width == 0) {
        and_count += 10;
    }
    if !enabled || (one << width == 0) {
        or_count += 10;
    }

    if and_count != 0 {
        return 1;
    }
    if or_count != 11 {
        return 2;
    }
    if zero != 0 {
        return 3;
    }
    if width != 32 {
        return 4;
    }
    return 0;
}
