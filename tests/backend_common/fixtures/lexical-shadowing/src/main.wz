package app;

func main() i32 {
    var value i32 = 1;
    {
        let value i32 = value + 1;
        if value != 2 {
            return 1;
        }
        {
            var value i32 = value * 3;
            value += 1;
            if value != 7 {
                return 2;
            }
        }
        if value != 2 {
