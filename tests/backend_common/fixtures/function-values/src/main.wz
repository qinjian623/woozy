package app;

func add(a i32, b i32) i32 {
    return a + b;
}

func apply(op func(i32, i32) i32, a i32, b i32) i32 {
    return op(a, b);
}

func main() i32 {
    let twice = func(value i32) i32 {
        return value * 2;
    };
    let indirect func(i32, i32) i32 = add;
    let alias = twice;

    let direct_result = add(1, 2);
    let function_result = twice(21);
    let applied = apply(indirect, 2, 3);
    let alias_result = alias(4);

    if direct_result != 3 {
        return 1;
    }
    if function_result != 42 {
        return 2;
    }
    if applied != 5 {
        return 3;
    }
    if alias_result != 8 {
        return 4;
    }
    return 0;
}
