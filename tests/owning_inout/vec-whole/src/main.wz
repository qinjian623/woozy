package app;

import "std/option" as option;
import "std/weak" as weak;

// A whole owning Vec binding is the caller's real storage. Replacing it drops
// exactly the old handle once, publishes the complete new handle, and keeps an
// unrelated copy of the old value alive through its own reference count.
func replace(slot inout Vec[i32]) {
    slot = [7, 8];
}

func main() i32 {
    var items Vec[i32] = [1, 2, 3];
    let alias = items;
    var old_weak Weak[Vec[i32]] = weak.downgrade(items);
    replace(inout items);
    if items[0] != 7 || items[1] != 8 { return 1; }
    if len(items) != 2 { return 2; }
    // The copy still owns the old container, so the old identity is alive.
    if alias[0] != 1 || alias[1] != 2 || alias[2] != 3 { return 3; }
    switch weak.upgrade(old_weak) {
    case option.Option.Some(strong):
        if strong[0] != 1 || len(strong) != 3 { return 4; }
    case option.Option.None:
        return 5;
    }
    return 0;
}

func len(value Vec[i32]) i32 {
    var count i32 = 0;
    for item in value { count = count + 1; }
    return count;
}
