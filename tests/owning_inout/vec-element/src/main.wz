package app;

struct Cell { items Vec[i32]; tag i32; }

func replace_element(slot inout Vec[i32]) {
    slot = [9, 10];
}

func bump(slot inout i32) {
    slot = slot + 1;
}

func main() i32 {
    // A Vec[Vec[i32]] element is an owning slot inside shared storage.
    var rows Vec[Vec[i32]] = [[1], [2, 3], [4]];
    replace_element(inout rows[1]);
    if rows[0][0] != 1 { return 1; }
    if rows[1][0] != 9 || rows[1][1] != 10 { return 2; }
    if rows[2][0] != 4 { return 3; }
    // Direct element replacement through the same shared storage.
    rows[2] = [5, 6];
    if rows[2][0] != 5 || rows[2][1] != 6 { return 4; }

    // Owning field of a Vec element: only the selected field changes.
    var cells Vec[Cell] = [Cell(items: [1], tag: 1), Cell(items: [2], tag: 2)];
    replace_element(inout cells[0].items);
    if cells[0].items[0] != 9 || cells[0].items[1] != 10 { return 5; }
    if cells[0].tag != 1 { return 6; }
    if cells[1].items[0] != 2 || cells[1].tag != 2 { return 7; }
    // POD field of another element stays disjoint.
    bump(inout cells[1].tag);
    if cells[1].tag != 3 || cells[1].items[0] != 2 { return 8; }
    return 0;
}
