package app;
import "std/iter" as iter;
import "std/option" as option;

enum Failure { Bad; }
struct Bad { value i32; }

impl iter.Iterator[i32] for Bad {
    func next(cursor inout Self) option.Option[i32] throws Failure {
        return option.Option[i32].None;
    }
}

func main() i32 {
    let source = Bad(value: 1);
    for item in source { if item == 1 { return 1; } }
    return 0;
}
