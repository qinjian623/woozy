package app;

trait Iterator[T] { func next(cursor inout Self) Option[T]; }
enum Option[T] { None; Some(value T); }
struct Plain { value i32; }

impl Iterator[i32] for Plain {
    func next(cursor inout Self) Option[i32] {
        return Option[i32].None;
    }
}

func main() i32 {
    let source = Plain(value: 1);
    for item in source { if item == 1 { return 1; } }
    return 0;
}
