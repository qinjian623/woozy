package app;
import "std/iter" as iter;
import "std/option" as option;

struct Both { value i32; }

impl iter.Iterator[i32] for Both {
    func next(cursor inout Self) option.Option[i32] {
        return option.Option[i32].None;
    }
}
impl iter.Iterator[bool] for Both {
    func next(cursor inout Self) option.Option[bool] {
        return option.Option[bool].None;
    }
}

func main() i32 {
    let source = Both(value: 1);
    for item in source {
        let typed bool = item;
        if typed { return 1; }
    }
    return 0;
}
