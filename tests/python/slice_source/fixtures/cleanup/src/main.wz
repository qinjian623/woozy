package app;
import "std/slice" as slice;

enum E { Bad; }

func probe(flag bool, values Vec[string], log inout i64) i32 throws E {
    let s Slice[string] = slice.view[string](values, 0, 2);
    defer { log = log * 10 + 9; }
    if flag { throw E.Bad; }
    return 0;
}

func loops(values Vec[i32]) i32 {
    let s Slice[i32] = slice.view[i32](values, 0, 3);
    var seen i32 = 0;
    for x in s {
        if seen == 0 { seen += 1; continue; }
        if seen == 1 { seen += 1; break; }
    }
    if seen != 2 { return 1; }
    return s[1];
}

func main() i32 {
    let texts Vec[string] = ["a", "b", "c"];
    let v Vec[i32] = [4, 5, 6];
    var log i64 = 0;
    if loops(v) != 5 { return 1; }
    try {
        let n i32 = probe(true, texts, inout log);
        return 2;
    } catch e E {
        log = log * 10 + 1;
    }
    if log != 91 { return 3; }
    {
        defer { log = log * 10 + 2; }
        let s Slice[string] = slice.view[string](texts, 1, 2);
        if s[0] != "b" { return 4; }
    }
    if log != 912 { return 5; }
    return 0;
}
