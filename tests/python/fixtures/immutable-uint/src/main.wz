package app;

func u32_bits() u32 {
    let a u32 = 4294967295;
    let b u32 = 2863311530;
    let c u32 = a & b;
    let d u32 = c | 305419896;
    return d ^ 4294967295;
}

func u32_shifts() u32 {
    let value u32 = 3758096384;
    let right u32 = value >> 31;
    let left u32 = value << 1;
    let again u32 = (left >> 1) | right;
    return again;
}

func u64_bits() u64 {
    let a u64 = 18446744073709551615;
    let b u64 = 12297829382473034410;
    let c u64 = a & b;
    let d u64 = c | 1;
    return d ^ 18446744073709551615;
}

func u64_shifts() u64 {
    let value u64 = 18446744073709551615;
    let right u64 = value >> 63;
    let left u64 = value << 63;
    let again u64 = (left >> 63) | right;
    return again;
}

func dynamic_u32(value u32, count u32) u32 {
    return (value & 4294967295) >> count;
}

func dynamic_u64(value u64, count u64) u64 {
    return (value | 1) << count;
}

func writable_u32() u32 {
    var value u32 = 4294967295;
    return (value & 305419896) >> 3;
}

func closure_u32() u32 {
    let value u32 = 4294967295;
    let read = func() u32 { return value & 305419896; };
    return read();
}

func branch_u32(flag bool) u32 {
    if flag {
        let value u32 = 4294967295;
        let masked u32 = value & 305419896;
        return masked;
    }
    let other u32 = 305419896;
    return other | 1;
}

func invalid_high_u32() u32 {
    let value u32 = 1;
    return value >> 32;
}

func invalid_negative_u64() u64 {
    let value u64 = 1;
    return value << -1;
}

func main() i32 {
    if u32_bits() != 1161888005 { return 1; }
    if u32_shifts() != 1610612737 { return 2; }
    if u64_bits() != 6148914691236517204 { return 3; }
    if u64_shifts() != 1 { return 4; }
    if dynamic_u32(4294967295, 3) != 536870911 { return 5; }
    if dynamic_u64(2, 3) != 24 { return 6; }
    if writable_u32() != 38177487 { return 7; }
    if closure_u32() != 305419896 { return 8; }
    if branch_u32(true) != 305419896 || branch_u32(false) != 305419897 { return 9; }
    return 0;
}
