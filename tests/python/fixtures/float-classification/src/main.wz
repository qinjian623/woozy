package app;

import "std/math" as math;

func classify(value f64) i32 {
    if math.isnan(value) { return 1; }
    if math.isinf(value) { return 2; }
    if math.isfinite(value) { return 3; }
    return 0;
}

func check_signbit(value f64) bool { return math.signbit(value); }
func check_isinf(value f64) bool { return math.isinf(value); }
func check_isfinite(value f64) bool { return math.isfinite(value); }

func main() i32 { return classify(1.0) - 3; }
