set(work "${CMAKE_CURRENT_BINARY_DIR}/cli-build-test")
file(MAKE_DIRECTORY "${work}/project/src")
set(manifest "${work}/project/lang.toml")
file(WRITE "${manifest}" "schema_version=1\n[package]\nname=\"cli\"\nsource_root=\"src\"\nentry=\"app\"\n[build]\nbackend=\"python\"\nword_bits=64\n")
function(check status code)
  execute_process(COMMAND "${LANGC}" build ${ARGN} --format json
    RESULT_VARIABLE actual OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${actual}" STREQUAL "${status}" OR NOT err STREQUAL "")
    message(FATAL_ERROR "build: expected ${status}, got ${actual}: ${out}${err}")
  endif()
  string(JSON actual_status GET "${out}" status)
  if(status EQUAL 0)
    if(NOT actual_status STREQUAL "ok")
      message(FATAL_ERROR "Expected successful build: ${out}")
    endif()
  else()
    string(JSON actual_code GET "${out}" diagnostics 0 code)
    if(NOT actual_status STREQUAL "error" OR NOT actual_code STREQUAL "${code}")
      message(FATAL_ERROR "Expected ${code}: ${out}")
    endif()
  endif()
endfunction()
check(0 "" --project "${ROOT}/tests/fixtures/core/lang.toml" --backend python --out-dir "${work}/core")
execute_process(COMMAND "${PYTHON}" -s "${work}/core/program.py"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT out STREQUAL "" OR NOT err STREQUAL "")
  message(FATAL_ERROR "Generated core failed: ${status}: ${out}${err}")
endif()
file(SHA256 "${work}/core/program.py" code_before)
file(SHA256 "${work}/core/langrt.py" runtime_before)
file(WRITE "${work}/project/src/main.wz" "package app; func main() i32 {return true;}")
check(1 E_TYPE_MISMATCH --project "${manifest}" --out-dir "${work}/core")
file(SHA256 "${work}/core/program.py" code_after)
file(SHA256 "${work}/core/langrt.py" runtime_after)
if(NOT code_before STREQUAL code_after OR NOT runtime_before STREQUAL runtime_after)
  message(FATAL_ERROR "Failed build changed existing outputs")
endif()
file(WRITE "${work}/project/src/main.wz" "package app; func main() i32 {return 7;}")
check(0 "" --project "${manifest}" --out-dir "${work}/nonzero")
execute_process(COMMAND "${PYTHON}" -s "${work}/nonzero/program.py"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 7 OR NOT out STREQUAL "" OR NOT err STREQUAL "")
  message(FATAL_ERROR "Build must not execute program, ordinary return must be 7")
endif()
if(NOT NATIVE_AVAILABLE)
  check(1 E_CAPABILITY_UNAVAILABLE --project "${manifest}" --backend native --out-dir "${work}/native")
endif()
file(WRITE "${work}/output-is-file" "preserve")
check(2 E_INPUT_IO --project "${manifest}" --out-dir "${work}/output-is-file")
file(READ "${work}/output-is-file" preserved)
if(NOT preserved STREQUAL "preserve")
  message(FATAL_ERROR "Failed build removed an output path file")
endif()
file(MAKE_DIRECTORY "${work}/blocked/program.py")
check(2 E_INPUT_IO --project "${manifest}" --out-dir "${work}/blocked")
file(GLOB stages "${work}/blocked/.woozyc-*")
if(stages OR NOT IS_DIRECTORY "${work}/blocked/program.py")
  message(FATAL_ERROR "Failed build left staging data or removed existing directory")
endif()
if(EXISTS "${work}/blocked/langrt.py")
  message(FATAL_ERROR "Failed build published runtime")
endif()
file(WRITE "${work}/blocked/langrt.py" "old-runtime-sentinel")
file(WRITE "${work}/blocked/unrelated" "keep")
check(2 E_INPUT_IO --project "${manifest}" --out-dir "${work}/blocked")
file(READ "${work}/blocked/langrt.py" preserved)
file(READ "${work}/blocked/unrelated" unrelated)
file(GLOB stages "${work}/blocked/.woozyc-*" "${work}/core/.woozyc-*")
if(NOT preserved STREQUAL "old-runtime-sentinel" OR NOT unrelated STREQUAL "keep" OR stages OR NOT IS_DIRECTORY "${work}/blocked/program.py")
  message(FATAL_ERROR "Failed publication damaged existing files or left staging")
endif()
file(REMOVE_RECURSE "${work}")
