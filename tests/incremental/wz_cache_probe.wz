package app;
import "app/wzcc/frontcache" as frontcache;
import "app/wzcc/hir" as hir;
import "app/wzcc/hirverify" as hirverify;
import "app/wzcc/model" as model;
import "app/wzcc/source" as source;
import "app/wzcc/lexer" as lexer;
import "app/wzcc/parser" as parser;
import "app/wzcc/resolve" as resolve;
import "app/wzcc/types" as types;
import "std/option" as option;
import "std/vec" as vec;
import "std/text" as text;
import "std/fs" as fs;
import "std/io" as io;
import "std/os" as os;
import "std/process" as process;

func empty(snapshot u64) hir.HirModule throws model.SupportError {
    let parsed = parser.parse(lexer.lex(source.snapshot(0, 0, snapshot, "/cache/main.wz", text.bytes("package app; func main() Unit { }"))));
    if !parsed.has_value { throw model.SupportError.Invalid("probe parse"); }
    var project = model.empty_project(); project.files = [parsed];
    project.modules = [model.Module(id: 0, logical_path: "app", identity: "source:/cache/app", package_name: "app",
        files: [0], imports: [], foreign_exports: [], binding: option.Option[model.BindingModuleRef].None, c_binding: option.Option[usize].None)];
    let resolved = resolve.resolve_project(project);
    if !resolved.has_value || vec.len(resolved.diagnostics) != 0 { throw model.SupportError.Invalid("probe resolve"); }
    var module = hir.empty_module(resolved.value, 0, model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    try {
        let unit = types.intern(inout module.types, model.empty_type(model.TypeKind.Unit));
        var signature = model.empty_type(model.TypeKind.Function); signature.result = unit;
        types.intern(inout module.types, signature);
    } catch problem types.Error { throw model.SupportError.Invalid("probe types"); }
    return module;
}
func populate(module inout hir.HirModule) throws model.SupportError {
    let file = module.resolved.project.files[0]; var function usize = 0; var block usize = 0;
    for symbol in module.resolved.symbols { if symbol.name == "main" { function = symbol.id; } }
    var function_node usize = 0;
    switch module.resolved.symbols[function].definition { case option.Option.Some(ref): function_node = ref.node; case option.Option.None: throw model.SupportError.Invalid("probe function"); }
    for var index usize = 0; index < vec.len(file.nodes); index += 1 { if model.ast_kind_id(file.nodes[index].kind) == 18 { block = index; } }
    let source = hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: block), span: file.nodes[block].span);
    module.scopes = [hir.HirScope(function: function, parent: option.Option[usize].None, source: source)];
    module.nodes = [hir.HirNode(type_id: 1, source: source, scope: 0, children: [], data: hir.NodeData.Block(hir.Block()), errors: [], exits: [])];
    module.functions = [hir.HirFunction(symbol: function, signature: 2, parameters: [], body: 0, scope: 0,
        source: hir.HirSource(node: model.NodeRef(module: 0, file: 0, node: function_node), span: file.nodes[function_node].span), captures: [], is_async: false)];
}
func main() i32 throws os.Error {
    let args = process.args(); if vec.len(args) != 3 { return 1; }
    let cache = frontcache.context(args[1], "actual-wz-cache-probe/1");
    try {
        let input = source.snapshot(2, 0, 7, "/cache/strings.wz", text.bytes("package app; const VALUE string = \"alpha\";"));
        let parsed = parser.parse(lexer.lex(input)); frontcache.store_ast(cache, parsed);
        switch frontcache.load_ast(cache, source.snapshot(2, 1, 19, input.path, input.original)) {
            case option.Option.None: return 2;
            case option.Option.Some(value): if value.lexed.source.id != 19 { return 3; }
        }
        var module = empty(5); populate(inout module);
        let checked = hirverify.verify(module, hirverify.VerifyMode.Backend);
        switch checked.value {
            case option.Option.None: { for item in checked.diagnostics { io.eprintln(item.code + ":" + item.message); } return 4; }
            case option.Option.Some(verified): frontcache.store(cache, hirverify.snapshot(verified));
        }
        var restored = empty(29); let accepted = frontcache.restore(cache, inout restored);
        if vec.len(accepted) != 1 || vec.len(restored.functions) != 1 || restored.functions[0].source.span.snapshot != 29 { return 5; }
        let verified = hirverify.verify(restored, hirverify.VerifyMode.Backend);
        if !option.is_some(verified.value) { for item in verified.diagnostics { io.eprintln(item.code + ":" + item.message); } return 6; }
        let object = fs.read_file(args[2]); frontcache.store_object(cache, "test.obj", object);
        switch frontcache.load_object(cache, "test.obj") {
            case option.Option.None: return 7;
            case option.Option.Some(bytes): if vec.len(bytes) != vec.len(object) { return 8; }
        }
        frontcache.store_object(cache, "invalid.obj", [127, 69, 76, 70]);
        if option.is_some(frontcache.load_object(cache, "invalid.obj")) { return 9; }
        if cache.counters[0] != 1 || cache.counters[2] != 1 || cache.counters[6] != 1 { return 10; }
        io.println("WZ_CACHE ast=1 scalar=1 native_object=1 invalid_object=miss current_span=29"); return 0;
    } catch problem model.SupportError {
        switch problem { case model.SupportError.Invalid(message): io.eprintln(message); case model.SupportError.Limit(message): io.eprintln(message); }
        return 11;
    }
}
