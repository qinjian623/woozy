package main;
import "app/wzcc/source" as source;
import "app/wzcc/lexer" as lexer;
import "app/wzcc/parser" as parser;
import "app/wzcc/resolve" as resolve;
import "app/wzcc/model" as model;
import "app/wzcc/hir" as hir;
import "app/wzcc/interface" as interface;
import "app/wzcc/types" as types;
import "std/text" as text;
import "std/vec" as vec;
import "std/option" as option;
import "std/io" as io;
import "std/os" as os;

func main() i32 throws os.Error {
    let input = source.snapshot(0, 0, 0, "/identity/test.wz", text.bytes(
        "package identity; pub func f[T](x T) T { return x; } pub struct S { pub value i32; }"));
    let parsed = parser.parse(lexer.lex(input));
    if !parsed.has_value { return 1; }
    var project_value = model.empty_project();
    vec.push(project_value.files, parsed);
    vec.push(project_value.modules, model.Module(id: 0, logical_path: "app",
        identity: "source:/identity/猫", package_name: "identity", files: [0], imports: [],
        foreign_exports: [], binding: option.Option[model.BindingModuleRef].None,
        c_binding: option.Option[usize].None));
    let resolved = resolve.resolve_project(project_value);
    if !resolved.has_value || vec.len(resolved.diagnostics) != 0 { return 2; }
    var module = hir.empty_module(resolved.value, 0, model.CheckConfig(backend: model.Backend.Native, word_bits: 64));
    var function usize = 0;
    var structure usize = 0;
    for symbol in resolved.value.symbols {
        if symbol.name == "f" { function = symbol.id; }
        if symbol.name == "S" { structure = symbol.id; }
    }
    try {
        let base = interface.symbol_key(module, function);
        var integer = model.empty_type(model.TypeKind.SignedInt); integer.bits = 32;
        let i32_type = types.intern(inout module.types, integer);
        var signature = model.empty_type(model.TypeKind.Function);
        signature.parameters = [model.ParameterType(mode: model.ParamMode.Move, type_id: i32_type)];
        signature.result = i32_type;
        let function_type = types.intern(inout module.types, signature);
        var nominal = model.empty_type(model.TypeKind.NominalStruct); nominal.declaration = structure;
        let nominal_type = types.intern(inout module.types, nominal);
        var instance = resolved.value.symbols[function]; instance.id = vec.len(module.resolved.symbols);
        vec.push(module.resolved.symbols, instance);
        vec.push(module.instances, hir.FunctionInstance(symbol: instance.id, origin: function,
            type_args: [i32_type], renamed: [], target: module.config));
        io.println(base);
        io.println(interface.symbol_key(module, instance.id));
        io.println(interface.native_function_name(module, instance.id));
        io.println(interface.type_key(module, function_type));
        io.println(interface.type_key(module, nominal_type));
        return 0;
    } catch problem model.SupportError { return 3; }
      catch problem types.Error { return 4; }
}
