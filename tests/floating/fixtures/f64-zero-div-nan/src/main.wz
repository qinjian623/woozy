package app;

func positive_zero() f64 {
    return 0.0;
}

func negative_zero() f64 {
    return -0.0;
}

func opposite_zero_sum() f64 {
    let positive f64 = 0.0;
    let negative f64 = -0.0;
    return positive + negative;
}

func negative_zero_sum() f64 {
    let left f64 = -0.0;
    let right f64 = -0.0;
    return left + right;
}

func negative_zero_subtract() f64 {
    let left f64 = -0.0;
    let right f64 = 0.0;
    return left - right;
}

func negative_zero_product() f64 {
    let negative f64 = -0.0;
    return negative * 1.0;
}

func negative_zero_quotient() f64 {
    let negative f64 = -0.0;
    return negative / 1.0;
}

func positive_infinity() f64 {
    let zero f64 = 0.0;
    return 1.0 / zero;
}

func negative_infinity_numerator() f64 {
    let negative_one f64 = -1.0;
    let zero f64 = 0.0;
    return negative_one / zero;
}

func negative_infinity_divisor() f64 {
    let negative_zero f64 = -0.0;
    return 1.0 / negative_zero;
}

func nan_zero_over_zero() f64 {
    let zero f64 = 0.0;
    return zero / zero;
}

func nan_inf_minus_inf() f64 {
    let zero f64 = 0.0;
    let infinity f64 = 1.0 / zero;
    return infinity - infinity;
}

func nan_equal_self() bool {
    let nan f64 = 0.0 / 0.0;
    return nan == nan;
}

func nan_not_equal_self() bool {
    let nan f64 = 0.0 / 0.0;
    return nan != nan;
}

func nan_less_than_one() bool {
    let nan f64 = 0.0 / 0.0;
    return nan < 1.0;
}

func one_less_than_nan() bool {
    let nan f64 = 0.0 / 0.0;
    let one f64 = 1.0;
    return one < nan;
}

func nan_less_equal_one() bool {
    let nan f64 = 0.0 / 0.0;
    return nan <= 1.0;
}

func nan_greater_equal_one() bool {
    let nan f64 = 0.0 / 0.0;
    return nan >= 1.0;
}

func nan_greater_than_one() bool {
    let nan f64 = 0.0 / 0.0;
    return nan > 1.0;
}

func nan_equal_zero() bool {
    let nan f64 = 0.0 / 0.0;
    return nan == 0.0;
}

func finite_less_than() bool {
    let left f64 = 1.0;
    let right f64 = 2.0;
    return left < right;
}

func finite_less_equal() bool {
    let left f64 = 1.0;
    let right f64 = 1.0;
    return left <= right;
}

func finite_greater_than() bool {
    let left f64 = 2.0;
    let right f64 = 1.0;
    return left > right;
}

func finite_greater_equal() bool {
    let left f64 = 1.0;
    let right f64 = 1.0;
    return left >= right;
}

func positive_zero_equal_negative_zero() bool {
    let positive f64 = 0.0;
    let negative f64 = -0.0;
    return positive == negative;
}

func positive_zero_not_equal_negative_zero() bool {
    let positive f64 = 0.0;
    let negative f64 = -0.0;
    return positive != negative;
}

func main() i32 {
    return 0;
}
