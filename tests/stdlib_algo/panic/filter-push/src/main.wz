// filter holds a full-range Slice over the input while it calls keep.  The
// input still has spare capacity, so a push through an alias must Panic with
// active-iteration before writing the reserved slot or changing the length,
// and main must not reach return 0.
package app;

import "std/algo" as algo;
import "std/vec" as vec;

func main() i32 {
    let values = vec.make[i32](2, 0);
    values[0] = 2;
    values[1] = 1;
    vec.reserve(values, 8);
    let alias = values;
    let keep = func(value i32) bool {
        vec.push(alias, 9);
        return value == 2;
    };
    let filtered = algo.filter[i32](values, keep);
    if vec.len(filtered) != 1 { return 1; }
    return 0;
}
