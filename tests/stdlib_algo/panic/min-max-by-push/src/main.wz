// The first comparison runs for the second element and unconditionally
// attempts a structural change. Without a traversal pin, min_max_by returns
// normally.
package app;

import "std/algo" as algo;
import "std/option" as option;
import "std/vec" as vec;

func main() i32 {
    let values = vec.make[i32](2, 0);
    values[0] = 2;
    values[1] = 1;
    let less = func(left i32, right i32) bool {
        vec.push(values, 9);
        return left < right;
    };
    switch algo.min_max_by[i32](values, less) {
        case option.Option.Some(bounds): return 0;
        case option.Option.None: return 1;
    }
}
