// fold holds a full-range Slice over the input while it calls combine. A push
// through an alias must Panic with active-iteration before the length changes,
// so main must not reach return 0.
package app;

import "std/algo" as algo;
import "std/vec" as vec;

func main() i32 {
    let values = vec.make[i32](5, 0);
    values[0] = 4;
    values[1] = 3;
    values[2] = 2;
    values[3] = 1;
    values[4] = 0;
    let alias = values;
    let combine = func(accumulator i32, value i32) i32 {
        vec.push(alias, value);
        return accumulator + value;
    };
    let folded = algo.fold[i32, i32](values, 0, combine);
    if folded != 10 { return 1; }
    return 0;
}
