// A resize that changes length must Panic before modifying the pinned input.
// The length is 5, so the first unrolled group is already being traversed.
package app;

import "std/algo" as algo;
import "std/vec" as vec;

func main() i32 {
    let values = vec.make[i32](5, 0);
    values[0] = 4;
    values[1] = 3;
    values[2] = 2;
    values[3] = 1;
    values[4] = 0;
    let alias = values;
    let combine = func(accumulator i32, value i32) i32 {
        vec.resize(alias, 1, 0);
        return accumulator + value;
    };
    let folded = algo.fold[i32, i32](values, 0, combine);
    if folded != 10 { return 1; }
    return 0;
}
