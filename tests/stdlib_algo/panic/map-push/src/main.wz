// map pins its input while it calls transform. A push through an alias must
// Panic with active-iteration before the input length changes, so main must
// not reach return 0.
package app;

import "std/algo" as algo;
import "std/vec" as vec;

func main() i32 {
    let values = vec.make[i32](5, 0);
    values[0] = 4;
    values[1] = 3;
    values[2] = 2;
    values[3] = 1;
    values[4] = 0;
    let alias = values;
    let transform = func(value i32) i32 {
        vec.push(alias, value);
        return value * 2;
    };
    let mapped = algo.map[i32, i32](values, transform);
    if vec.len(mapped) != 5 { return 1; }
    return 0;
}
