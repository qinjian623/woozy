// A resize that changes length must Panic before modifying the pinned input.
// map reads the original length once, so the callback must not shorten or
// extend the vector underneath the traversal.
package app;

import "std/algo" as algo;
import "std/vec" as vec;

func main() i32 {
    let values = vec.make[i32](5, 0);
    values[0] = 4;
    values[1] = 3;
    values[2] = 2;
    values[3] = 1;
    values[4] = 0;
    let alias = values;
    let transform = func(value i32) i32 {
        vec.resize(alias, 1, 0);
        return value * 2;
    };
    let mapped = algo.map[i32, i32](values, transform);
    if vec.len(mapped) != 5 { return 1; }
    return 0;
}
