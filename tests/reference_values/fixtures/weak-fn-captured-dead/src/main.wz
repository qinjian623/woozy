package app;

import "std/option" as option;
import "std/weak" as weak;

func main() i32 {
    var weak_value Weak[func() i32] = weak.empty[func() i32]();
    {
        var value i32 = 41;
        let captured = func() i32 { return value; };
        weak_value = weak.downgrade[func() i32](captured);
        switch weak.upgrade(weak_value) {
        case option.Option.Some(strong):
            if strong() != 41 { return 1; }
        case option.Option.None:
            return 2;
        }
    }

    switch weak.upgrade(weak_value) {
    case option.Option.Some(strong):
        let ignored = strong();
        return 3;
    case option.Option.None:
        return 0;
    }
}
