package app;

struct Counter {
    value i32;
}

impl Counter {
    func bump(self inout Self, delta i32) i32 {
        let old = self.value;
        self.value = old + delta;
        return old;
    }
}

func main() i32 {
    var counter = Counter(value: 1);
    // Binding an inout-Self method must be rejected; it cannot be stored as a
    // repeatable function value.
    let bump = counter.bump;
    return bump(1);
}
