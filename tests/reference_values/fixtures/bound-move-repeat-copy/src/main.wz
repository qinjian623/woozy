package app;

import "std/box" as box;

struct Counter {
    cell box.Box[i32];
}

impl Counter {
    func take(self move Counter) i32 {
        let old = box.get(self.cell);
        box.set(self.cell, old + 1);
        return old;
    }
}

func main() i32 {
    let cell = box.new[i32](0);
    let counter = Counter(cell: cell);
    let take = (move counter).take;

    if take() != 0 { return 1; }
    if take() != 1 { return 2; }
    let copied = take;
    if copied() != 2 { return 3; }
    if take() != 3 { return 4; }
    if box.get(cell) != 4 { return 5; }
    return 0;
}
