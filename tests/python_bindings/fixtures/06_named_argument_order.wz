package main;

import "std/py" as py;
import "torch" as torch;
import "torch/nn" as nn;

// 源码先写 out_features，再写 in_features；按源码顺序求值应得 order == 21。
// 若错误地先按形参顺序求值，则会得到 order == 12。
func mark(value i64, code i64, order inout i64) i64 {
    order = order * 10 + code;
    return value;
}

func build_model(order inout i64) nn.Linear throws py.Error {
    return nn.Linear(
        out_features: mark(2, 2, inout order),
        in_features: mark(1, 1, inout order),
        dtype: torch.float32,
        device: "cpu",
    );
}

func main() i32 {
    var order i64 = 0;
    try {
        let ignored = build_model(inout order);
        if order != 21 {
            return 1;
        }
    } catch error py.Error {
        return 2;
    }
    return 0;
}
