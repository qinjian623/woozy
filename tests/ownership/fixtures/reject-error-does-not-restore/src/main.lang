package main;

enum E {
    Bad(code i32);
}

func mark(log inout i64, digit i64) {
    log = log * 10 + digit;
}

func bad(log inout i64) i32 throws E {
    mark(inout log, 2);
    throw E.Bad(code: 2);
}

func consume(values move Vec[i32], first i32, second i32) i32 {
    return values[0] + first + second;
}

func main() i32 {
    var log i64 = 0;
    var values Vec[i32] = [1];
    try {
        let result = consume(move values, bad(inout log), 0);
    } catch err E {
        return values[0];
    }
    return 0;
}
