package app;

struct Branch {
    label i32;
    children Vec[Item];
    extras Vec[Item];
}

enum Item {
    Leaf(value i32);
    Node(data Branch);
}

func count(item Item) i32 {
    switch item {
        case Item.Leaf(value):
            return value;
        case Item.Node(data):
            var total = data.label;
            for child in data.children {
                total += count(child);
            }
            for extra in data.extras {
                total += count(extra);
            }
            return total;
    }
}

