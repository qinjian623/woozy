package main;

func probe(log inout i64) i32 {
    let values Vec[i32] = [7];
    defer {
        log = log * 10 + i64(values[0]);
    }
    log = 1;
    return 0;
}

func main() i32 {
    var log i64 = 0;
    let result = probe(inout log);
    if result != 0 {
        return 1;
    }
    if log != 17 {
        return 2;
    }
    return 0;
}
