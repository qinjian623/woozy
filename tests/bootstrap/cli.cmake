function(expect status pattern)
  execute_process(COMMAND "${LANGC}" ${ARGN} RESULT_VARIABLE actual
    OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${actual}" STREQUAL "${status}")
    message(FATAL_ERROR "${ARGN}: expected ${status}, got ${actual}: ${out}${err}")
  endif()
  if(NOT "${out}${err}" MATCHES "${pattern}")
    message(FATAL_ERROR "${ARGN}: missing ${pattern}: ${out}${err}")
  endif()
  if(NOT status EQUAL 0 AND NOT out STREQUAL "")
    message(FATAL_ERROR "Failure unexpectedly wrote stdout: ${out}")
  endif()
  if(status EQUAL 0 AND NOT err STREQUAL "")
    message(FATAL_ERROR "Success unexpectedly wrote stderr: ${err}")
  endif()
endfunction()
expect(0 "Usage: langc" --help)
expect(0 "^langc 0[.]1[.]0-bootstrap [(]compiler-dev/1[)]\n$" --version)
expect(2 "E_DRIVER_ARGUMENT")
expect(2 "E_DRIVER_ARGUMENT" nonsense)
expect(2 "E_DRIVER_ARGUMENT" --bogus)
expect(2 "E_DRIVER_ARGUMENT" --help extra)
expect(2 "E_DRIVER_ARGUMENT" --version extra)
expect(2 "E_DRIVER_ARGUMENT" check)
expect(1 "E_CAPABILITY_UNAVAILABLE" build --backend native)
expect(1 "E_CAPABILITY_UNAVAILABLE" lsp)
expect(1 "E_CAPABILITY_UNAVAILABLE" capabilities --format json)
expect(2 "E_DRIVER_ARGUMENT" check --syntax-only)
expect(2 "E_DRIVER_ARGUMENT" check --project)
expect(2 "E_DRIVER_ARGUMENT" check --project a --backend invalid)
expect(2 "E_DRIVER_ARGUMENT" check --syntax-only a --project b)
set(source "${CMAKE_CURRENT_BINARY_DIR}/bootstrap.syntax.lang")
file(WRITE "${source}" "package p; func main() {}")
expect(0 "syntax ok:" check --syntax-only "${source}")
file(WRITE "${source}" "package p; func main() { let x = 1 }")
expect(1 "bytes.*E_PARSE_EXPECTED_TOKEN" check --syntax-only "${source}")
file(REMOVE "${source}")
execute_process(COMMAND "${LANGC}" check --syntax-only --format json "${source}"
  RESULT_VARIABLE missing_status OUTPUT_VARIABLE missing_json ERROR_VARIABLE missing_error)
string(JSON missing_code GET "${missing_json}" diagnostics 0 code)
if(NOT missing_status EQUAL 2 OR NOT missing_code STREQUAL "E_INPUT_IO" OR
   NOT missing_error STREQUAL "")
  message(FATAL_ERROR "Missing input must be a JSON environment error: ${missing_json}${missing_error}")
endif()
