// CON03: awaiting the same failing Task twice copies the promise-owned owning
// error each time; both catches see a live Vec and every reference is dropped.
package app;
import "std/async" as a;
import "std/io" as io;
import "std/os" as os;

enum Failure { Bad(values Vec[i32]); }

async func get() i32 throws Failure {
    await a.sleep(1);
    throw Failure.Bad(values: [42]);
}

async func main() i32 throws os.Error {
    let task = get();
    {
        try {
            await task;
        } catch error Failure {
            switch error {
                case Failure.Bad(values): {
                    if values[0] != 42 { return 1; }
                    io.println("42");
                }
            }
        }
    }
    {
        try {
            await task;
        } catch error Failure {
            switch error {
                case Failure.Bad(values): {
                    if values[0] != 42 { return 1; }
                    io.println("42");
                }
            }
        }
    }
    return 0;
}
