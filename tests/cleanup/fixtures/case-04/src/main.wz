package main;
enum E { Bad(code i32); }
func mark(log inout i64, digit i64) { log = log * 10 + digit; }

func fail(log inout i64) i32 throws E {
    defer {mark(inout log,3);}
    {
        defer {mark(inout log,2);}
        mark(inout log,1);throw E.Bad(code:7);
        defer {mark(inout log,8);}
    }
}
func main() i32 {
    var log i64=0;
    try {
        defer {mark(inout log,4);}
        let x=fail(inout log);mark(inout log,8);
    } catch err E {
        switch err {case E.Bad(code):if code!=7 {return 1;}}
        mark(inout log,5);defer {mark(inout log,6);}
    }
    mark(inout log,7);
    if log!=1234567 {return 2;}return 0;
}
