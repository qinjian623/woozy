package main;
enum E { Bad(code i32); }
func mark(log inout i64, digit i64) { log = log * 10 + digit; }

func good(log inout i64) i32 {mark(inout log,1);return 1;}
func bad(log inout i64) i32 throws E {
    mark(inout log,2);throw E.Bad(code:2);
}
func later(log inout i64) i32 {mark(inout log,9);return 3;}
func sink(first i32,second i32,third i32) i32 {return first+second+third;}
func main() i32 {
    var log i64=0;
    try {
        defer {mark(inout log,3);}
        let x=sink(third:good(inout log),
                   second:bad(inout log),first:later(inout log));
    } catch err E {mark(inout log,4);}
    if log!=1234 {return 1;}return 0;
}
