package main;
enum E { Bad(code i32); }
func mark(log inout i64, digit i64) { log = log * 10 + digit; }

func fail() throws E {throw E.Bad(code:0);}
func probe(log inout i64) {
    defer {mark(inout log,4);}
    defer {
        for var i i32=0;i<2;i+=1 {if i==0 {continue;}break;}
        try {mark(inout log,2);fail();}
        catch err E {mark(inout log,3);}
    }
    mark(inout log,1);
}
func main() i32 {
    var log i64=0;probe(inout log);
    if log!=1234 {return 1;}return 0;
}
