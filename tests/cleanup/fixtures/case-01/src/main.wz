package main;
enum E { Bad(code i32); }
func mark(log inout i64, digit i64) { log = log * 10 + digit; }

func probe(log inout i64) i32 {
    var x i64=1; let old=x;
    defer {mark(inout log,9);}
    {
        defer {mark(inout log,x);}
        defer {mark(inout log,old);}
        x=2;
    }
    mark(inout log,3); return 7;
}
func main() i32 {
    var log i64=0; let r=probe(inout log);
    if r!=7 || log!=1239 {return 1;} return 0;
}
