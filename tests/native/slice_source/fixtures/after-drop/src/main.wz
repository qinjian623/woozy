package app;
import "std/slice" as slice;
import "std/vec" as vec;

func main() i32 {
    let v Vec[i32] = [1, 2, 3];
    {
        let s Slice[i32] = slice.view[i32](v, 0, 2);
        vec.reserve[i32](v, 3);
        vec.resize[i32](v, 3, 0);
        if s[0] != 1 || s[1] != 2 { return 1; }
    }
    vec.push[i32](v, 4);
    vec.pop[i32](v);
    vec.clear[i32](v);
    vec.resize[i32](v, 2, 9);
    vec.reserve[i32](v, 8);
    if vec.len[i32](v) != 2 { return 2; }
    let s2 Slice[i32] = slice.view[i32](v, 0, 2);
    if slice.len[i32](s2) != 2 || s2[0] != 9 || s2[1] != 9 { return 3; }
    return 0;
}
