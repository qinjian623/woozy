package app;

import "std/os" as os;
import "std/sync" as sync;
import "std/task" as task;
import "std/thread" as thread;
import "std/vec" as vec;

struct Work {
    id i64;
    started sync.AtomicI64;
    release sync.AtomicI64;
}

struct LateWork {
    pool task.Pool[Work,i64];
    started sync.AtomicI64;
    release sync.AtomicI64;
    attempted sync.AtomicI64;
    submitted sync.AtomicI64;
    futures Vec[task.Future[i64]];
}

func hold(work Work) i64 {
    sync.fetch_add(work.started, 1);
    for sync.load(work.release) == 0 {}
    return work.id;
}

func submit_late(work LateWork) i64 {
    sync.store(work.attempted, 1);
    try {
        let future = task.submit(work.pool,
            Work(id: 2, started: work.started, release: work.release));
        vec.push(work.futures, future);
        sync.store(work.submitted, 1);
        return 0;
    } catch error task.Error {
        switch error {
            case task.Error.Closed: return 2;
            default: return 3;
        }
    }
}

func spawn_thread[A](entry func(A) i64, argument A) thread.Thread {
    try {
        return thread.spawn[A](entry, argument);
    } catch error os.Error {
        let empty = vec.empty[thread.Thread]();
        return empty[0];
    }
}

func join_thread(worker thread.Thread) i64 {
    try {
        return thread.join(worker);
    } catch error os.Error {
        return -1;
    }
}

func main() i32 throws task.Error {
    let pool = task.new[Work,i64](hold, 1, 1);
    let started = sync.atomic_i64(0);
    let release = sync.atomic_i64(0);

    let first = task.submit(pool, Work(id: 0, started: started, release: release));
    for sync.load(started) < 1 {}

    // The worker is blocked in task 0. Task 1 fills the one queue slot; this
    // submit returns because the queue had space.
    let second = task.submit(pool, Work(id: 1, started: started, release: release));

    let attempted = sync.atomic_i64(0);
    let submitted = sync.atomic_i64(0);
    let late_futures = vec.empty[task.Future[i64]]();
    let late = spawn_thread(submit_late, LateWork(
        pool: pool,
        started: started,
        release: release,
        attempted: attempted,
        submitted: submitted,
        futures: late_futures));

    for sync.load(attempted) < 1 {}
    // Task 2 cannot be accepted until a worker takes a queued task. This check
    // observes the blocked submitter; the release below is the only progress.
    if sync.load(submitted) != 0 { return 1; }
    if task.ready(second) { return 2; }

    sync.store(release, 1);
    for sync.load(submitted) < 1 {}
    if !(join_thread(late) == 0) { return 3; }

    if !(task.get(first) == 0) { return 4; }
    if !(task.get(second) == 1) { return 5; }
    if !(vec.len(late_futures) == 1) { return 6; }
    if !(task.get(late_futures[0]) == 2) { return 7; }
    if sync.load(started) != 3 { return 8; }

    task.close(pool);
    task.join(pool);
    return 0;
}
