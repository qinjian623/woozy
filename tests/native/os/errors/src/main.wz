package main;
import "std/os" as os;

func system_error(error os.Error, expected i32) bool {
    switch error {
        case os.Error.System(code, completed): return code == expected && completed == 0;
        case _: return false;
    }
}

func main() i32 throws os.Error {
    var observed = false;
    try {
        let file = os.open("no-such-file", os.O_RDONLY, 0);
        os.close(file);
    } catch error os.Error { observed = system_error(error, 2); }
    if !observed { return 1; }

    let file = os.open("closed.bin", os.O_CREAT | os.O_TRUNC | os.O_RDWR, 0o600);
    os.close(file);
    observed = false;
    try { os.read(file, [0], 1); }
    catch error os.Error { observed = system_error(error, 9); }
    if !observed { return 2; }

    observed = false;
    try {
        let invalid = os.open("invalid\0suffix", os.O_RDONLY, 0);
        os.close(invalid);
    } catch error os.Error { observed = system_error(error, 22); }
    if !observed { return 3; }

    observed = false;
    try {
        let invalid = os.open("", os.O_RDONLY, 0);
        os.close(invalid);
    } catch error os.Error { observed = system_error(error, 36); }
    if !observed { return 4; }

    let counts = os.open("counts.bin", os.O_CREAT | os.O_TRUNC | os.O_RDWR, 0o600);
    observed = false;
    try { os.read(counts, [0], 2); }
    catch error os.Error { observed = system_error(error, 22); }
    if !observed { return 5; }
    observed = false;
    try { os.write(counts, [65], 2); }
    catch error os.Error { observed = system_error(error, 22); }
    if !observed { return 6; }
    os.close(counts);

    let empty Vec[u8] = [];
    if os.read(os.stdin(), empty, 0) != 0 { return 7; }
    if os.write(os.stdout(), empty, 0) != 0 { return 8; }
    os.write_all(os.stdout(), empty);
    if os.write_text(os.stdout(), "") != 0 { return 9; }
    os.write_all_text(os.stdout(), "");
    return 0;
}
