package main;
import "std/os" as os;

func main() i32 throws os.Error {
    os.mkdir("made", 0o700);
    let file = os.open("made/inside.bin", os.O_CREAT | os.O_TRUNC | os.O_RDWR, 0o600);
    if os.write_text(file, "directory exists") != 16 { return 1; }
    os.close(file);
    os.unlink("made/inside.bin");
    os.rmdir("made");
    return 0;
}
