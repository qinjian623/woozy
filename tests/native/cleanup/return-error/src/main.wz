package app;
enum E {Bad(code i32);}
func mark(log inout i64,digit i64) {log=log*10+digit;}
func fail(log inout i64) i32 throws E {mark(inout log,1);throw E.Bad(code:7);}
func probe(log inout i64) i32 throws E {defer {mark(inout log,2);}return fail(inout log);}
func main() i32 {var log i64=0;try {probe(inout log);return 1;}catch e E {switch e {case E.Bad(code):if code!=7 {return 2;}}mark(inout log,3);}if log!=123 {return 3;}return 0;}
