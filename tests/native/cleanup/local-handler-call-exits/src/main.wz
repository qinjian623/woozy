package app; enum E {Bad(code i32);} func fail() throws E {throw E.Bad(code:9);}func choose(x bool)i32 throws E{if x{return 1;}throw E.Bad(code:9);}func f(x bool,log inout i32)i32 throws E{defer{let delta i32=4;try{fail();}catch e E{log+=delta;}}return choose(x);}func main()i32{var log i32=0;try{if f(true,inout log)!=1{return 1;}f(false,inout log);return 2;}catch e E{switch e{case E.Bad(code):if code!=9{return 3;}}}if log!=8{return 4;}return 0;}
