package app;
enum E {Bad(code i32);}
func choose(ok bool) E throws E {if ok {return E.Bad(code:7);}throw E.Bad(code:9);}
func main() i32 {
    try {let value=choose(true);switch value {case E.Bad(code):if code!=7 {return 1;}}}
    catch e E {return 2;}
    try {choose(false);return 3;}catch e E {switch e {case E.Bad(code):if code!=9 {return 4;}}}
    return 0;
}
