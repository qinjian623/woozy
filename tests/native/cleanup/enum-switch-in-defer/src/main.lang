package app;
enum E {A;B(code i32);}
func mark(log inout i64,digit i64) {log=log*10+digit;}
func f(value E,first bool,log inout i64) i32 {
    defer {switch value {
        case E.A:mark(inout log,1);
        case E.B(code):mark(inout log,i64(code));
    }}
    if first {return 7;}return 8;
}
func main() i32 {
    var log i64=0;
    if f(E.A,true,inout log)!=7 {return 1;}
    if f(E.B(code:3),false,inout log)!=8 {return 2;}
    if log!=13 {return 3;}return 0;
}
