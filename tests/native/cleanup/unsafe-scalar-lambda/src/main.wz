package app;
func empty() {unsafe {}}
func only_return() i32 {unsafe {return 1;}}
func shadow(x i32) i32 {unsafe {let x i32=x+1;unsafe {{let y i32=x;if y!=2 {return 9;}}}}return x-1;}
func generic[T](x T) T {unsafe {let y T=x;return y;}}
func lambda() i32 {let g func() i32=func() i32 {unsafe {let x i32=1;return x;}};return g();}
func main() i32 {empty();if only_return()!=1{return 1;}if shadow(1)!=0{return 2;}if generic(4)!=4{return 3;}if lambda()!=1{return 4;}return 0;}
