package app;

struct Bundle { label string; items Vec[string]; }
struct Pair { text string; items Vec[string]; }
enum Failure { Bad(value Vec[string]); }

func make_items() Vec[string] { return ["零","空","末\0😀"]; }
func mark(log inout i64,digit i64) { log=log*10+digit; }
func items(log inout i64) Vec[string] { mark(inout log,1); return ["一\0二","三"]; }
func bad_items(log inout i64) Vec[string] throws Failure {
    mark(inout log,2);
    let value=items(inout log);
    throw Failure.Bad(value:value);
}
func bad_text(log inout i64) string throws Failure {
    mark(inout log,3);
    throw Failure.Bad(value:["错\0误"]);
}
func probe(log inout i64) i32 {
    {
        let normal=items(inout log);
        defer { mark(inout log,4); }
        let first=normal[0];
    }
    try { let ignored=bad_items(inout log); }
    catch e Failure { switch e { case Failure.Bad(payload): { let seen=payload[0]; } } }
    try { let partial=Pair(items:items(inout log),text:bad_text(inout log)); }
    catch e Failure { switch e { case Failure.Bad(payload): { let seen=payload[0]; } } }
    return 0;
}

