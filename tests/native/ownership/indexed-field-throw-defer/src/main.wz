package app;
enum E {Bad;}
struct Pair{x i32;y i32;}
func fail(log inout i64)i32 throws E {log=log*10+3;throw E.Bad;}
func probe(log inout i64)i32 throws E {var values Vec[Pair]=[Pair(x:1,y:2)];{defer {log=log*10+9;}try {values[0].x=fail(inout log);}catch e E {log=log*10+4;}}if log!=349{return 1;}if values[0].x!=1{return 2;}return 0;}
func main()i32 throws E {var log i64=0;if probe(inout log)!=0{return 1;}return 0;}
