package app;

func rhs(values move Vec[i32]) i32 { return values[0] + 1; }

func without_alias() Unit {
    let values Vec[i32] = [81];
    values[0] = rhs(move values);
}

func read(values Vec[i32]) i32 { return values[0]; }

func main() i32 {
    without_alias();
    let values Vec[i32] = [81];
    let alias = values;
    values[0] = rhs(move values);
    if read(alias) != 82 { return 1; }
    return 0;
}
