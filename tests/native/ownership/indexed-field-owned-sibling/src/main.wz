package app;
struct Box{x i32;items Vec[i32];other Vec[i32];}
func main()i32 {var values Vec[Box]=[Box(x:1,items:[2],other:[3])];values[0].x=7;if values[0].x!=7{return 1;}if values[0].items[0]!=2{return 2;}if values[0].other[0]!=3{return 3;}values[0].items[0]=8;if values[0].other[0]!=3{return 4;}return 0;}
