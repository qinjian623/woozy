package app;enum E{Bad(value Vec[i32]);} struct Pair{first Vec[i32];second Vec[i32];}func mark(log inout i64,digit i64){log=log*10+digit;}func make(log inout i64) Vec[i32]{mark(inout log,1);return [1];}func bad(log inout i64) Vec[i32] throws E {mark(inout log,2);throw E.Bad(value:[2]);}func main() i32{var log i64=0;try{let p=Pair(second:make(inout log),first:bad(inout log));}catch e E{mark(inout log,3);}if log!=123{return 1;}return 0;}
