package app;
struct Inner{x i32;y i32;}
struct Box{inner Vec[Inner];tag i32;}
func main()i32 {let outer Vec[Box]=[Box(inner:[Inner(x:1,y:2)],tag:3)];outer[0].inner[0].x=7;if outer[0].inner[0].x!=7{return 1;}if outer[0].inner[0].y!=2{return 2;}if outer[0].tag!=3{return 3;}let temp Vec[Box]=[Box(inner:[Inner(x:4,y:5)],tag:6)];temp[0].inner[0].y=8;if temp[0].inner[0].x!=4{return 4;}if temp[0].inner[0].y!=8{return 5;}if temp[0].tag!=6{return 6;}return 0;}
