package app;
import "std/async" as a;
import "std/io" as io;
import "std/os" as os;

// The caller's block owns `data`; the task must own the normal Vec parameter
// across the suspension point. Leaving the block drops the caller's handle.
async func job(data Vec[i32]) Unit throws os.Error {
    await a.sleep(1);
    io.println(data[0]);
}

func main() i32 throws os.Error {
    {
        let data Vec[i32] = [42];
        a.spawn(job(data));
    }
    a.run();
    a.shutdown();
    return 0;
}
