package app;
import "std/cancel" as cancel;
import "std/channel" as channel;
import "std/os" as os;
import "std/sync" as sync;
import "std/thread" as thread;
import "std/time" as time;

struct SendWork {
    pipe channel.Channel[i64];
    token cancel.Token;
    entered sync.AtomicI64;
}
struct ReceiveWork {
    pipe channel.Channel[i64];
    token cancel.Token;
    entered sync.AtomicI64;
}
struct TimedSendWork {
    pipe channel.Channel[i64];
    timeout i64;
    entered sync.AtomicI64;
}
struct CloseWork { pipe channel.Channel[i64]; }
struct RequestWork { token cancel.Token; }
struct SendOneWork { pipe channel.Channel[i64]; value i64; }

func send_cancel_result(work SendWork) i64 {
    sync.fetch_add(work.entered,1);
    switch channel.send_cancel[i64](work.pipe,1,work.token) {
        case channel.SendWaitResult.Cancelled: return 1;
        case channel.SendWaitResult.Closed: return 2;
        case channel.SendWaitResult.Timeout: return 3;
        case channel.SendWaitResult.Sent: return 4;
    }
}
func receive_cancel_result(work ReceiveWork) i64 {
    sync.fetch_add(work.entered,1);
    switch channel.receive_cancel[i64](work.pipe,work.token) {
        case channel.ReceiveWaitResult.Item(value): return 10 + value;
        case channel.ReceiveWaitResult.Cancelled: return 1;
        case channel.ReceiveWaitResult.Closed: return 2;
        case channel.ReceiveWaitResult.Timeout: return 3;
    }
}
func timed_send_result(work TimedSendWork) i64 {
    sync.fetch_add(work.entered,1);
    switch channel.send_timeout[i64](work.pipe,1,work.timeout) {
        case channel.SendWaitResult.Closed: return 2;
        case channel.SendWaitResult.Timeout: return 3;
        case channel.SendWaitResult.Cancelled: return 4;
        case channel.SendWaitResult.Sent: return 1;
    }
}
func close_channel(work CloseWork) i64 { channel.close(work.pipe); return 0; }
func request_cancel(work RequestWork) i64 { cancel.request(work.token); return 0; }
func send_one(work SendOneWork) i64 {
    switch channel.send_timeout[i64](work.pipe,work.value,0) {
        case channel.SendWaitResult.Sent: return 1;
        default: return 0;
    }
}
func wait_entered(value sync.AtomicI64) {
    for var spin i64 = 0; spin < 100_000_000; spin += 1 {
        if sync.load(value) != 0 { return; }
    }
}
func wait_subscription(token cancel.Token) bool {
    for var spin i64 = 0; spin < 100_000_000; spin += 1 {
        if cancel.subscription_count(token) == 1 { return true; }
    }
    return false;
}

func main() i32 throws os.Error {

    // Registration/request interleaving: sometimes wait for the waiter to
    // enter, sometimes request immediately. A full channel never has space and
    // an empty channel never has data, so both must end Cancelled without a
    // stale subscription.
    for var round i32 = 0; round < 30; round += 1 {
        let pipe = channel.bounded[i64](1);
        switch channel.send_timeout[i64](pipe,1,0) {
            case channel.SendWaitResult.Sent: {}
            default: return 24;
        }
        let token = cancel.new();
        let entered = sync.atomic_i64(0);
        let waiter = thread.spawn[SendWork](send_cancel_result,
            SendWork(pipe: pipe,token: token,entered: entered));
        if round % 2 == 0 { wait_entered(entered); }
        cancel.request(token);
        cancel.request(token);
        if thread.join(waiter) != 1 { return 25; }
        if cancel.subscription_count(token) != 0 { return 26; }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Item(value): if value != 1 { return 27; }
            default: return 28;
        }
    }

    for var round i32 = 0; round < 30; round += 1 {
        let pipe = channel.bounded[i64](1);
        let token = cancel.new();
        let entered = sync.atomic_i64(0);
        let waiter = thread.spawn[ReceiveWork](receive_cancel_result,
            ReceiveWork(pipe: pipe,token: token,entered: entered));
        if round % 2 == 0 { wait_entered(entered); }
        cancel.request(token);
        cancel.request(token);
        if thread.join(waiter) != 1 { return 29; }
        if cancel.subscription_count(token) != 0 { return 30; }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Timeout: {}
            default: return 31;
        }
    }

    for var round i32 = 0; round < 30; round += 1 {
        let pipe = channel.bounded[i64](1);
        switch channel.send_timeout[i64](pipe,1,0) {
            case channel.SendWaitResult.Sent: {}
            default: return 1;
        }
        let token = cancel.new();
        let entered = sync.atomic_i64(0);
        let waiter = thread.spawn[SendWork](send_cancel_result,
            SendWork(pipe: pipe,token: token,entered: entered));
        wait_entered(entered);
        if !wait_subscription(token) { return 2; }
        let closer = thread.spawn[CloseWork](close_channel,CloseWork(pipe: pipe));
        let requester = thread.spawn[RequestWork](request_cancel,RequestWork(token: token));
        if thread.join(closer) != 0 || thread.join(requester) != 0 { return 3; }
        let result = thread.join(waiter);
        if result != 1 && result != 2 { return 4; }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Item(value): if value != 1 { return 5; }
            default: return 6;
        }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Closed: {}
            default: return 7;
        }
    }

    for var round i32 = 0; round < 30; round += 1 {
        let pipe = channel.bounded[i64](1);
        let token = cancel.new();
        let entered = sync.atomic_i64(0);
        let waiter = thread.spawn[ReceiveWork](receive_cancel_result,
            ReceiveWork(pipe: pipe,token: token,entered: entered));
        wait_entered(entered);
        if !wait_subscription(token) { return 8; }
        let sender = thread.spawn[SendOneWork](send_one,SendOneWork(pipe: pipe,value: 7));
        let requester = thread.spawn[RequestWork](request_cancel,RequestWork(token: token));
        if thread.join(sender) != 1 || thread.join(requester) != 0 { return 9; }
        let result = thread.join(waiter);
        if result == 1 {
            switch channel.receive_timeout[i64](pipe,0) {
                case channel.ReceiveWaitResult.Item(value): if value != 7 { return 10; }
                default: return 11;
            }
        } else if result != 17 {
            return 12;
        }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Timeout: {}
            default: return 13;
        }
    }

    for var round i32 = 0; round < 20; round += 1 {
        let pipe = channel.bounded[i64](1);
        switch channel.send_timeout[i64](pipe,1,0) {
            case channel.SendWaitResult.Sent: {}
            default: return 14;
        }
        let entered = sync.atomic_i64(0);
        let waiter = thread.spawn[TimedSendWork](timed_send_result,
            TimedSendWork(pipe: pipe,timeout: 200_000_000,entered: entered));
        wait_entered(entered);
        time.sleep_ms(1);
        let closer = thread.spawn[CloseWork](close_channel,CloseWork(pipe: pipe));
        if thread.join(closer) != 0 { return 15; }
        let result = thread.join(waiter);
        if result != 2 && result != 3 { return 16; }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Item(value): if value != 1 { return 17; }
            default: return 18;
        }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Closed: {}
            default: return 19;
        }
    }

    for var round i32 = 0; round < 20; round += 1 {
        let pipe = channel.bounded[i64](1);
        let token = cancel.new();
        let entered = sync.atomic_i64(0);
        let waiter = thread.spawn[ReceiveWork](receive_cancel_result,
            ReceiveWork(pipe: pipe,token: token,entered: entered));
        wait_entered(entered);
        if !wait_subscription(token) { return 20; }
        let closer = thread.spawn[CloseWork](close_channel,CloseWork(pipe: pipe));
        let requester = thread.spawn[RequestWork](request_cancel,RequestWork(token: token));
        if thread.join(closer) != 0 || thread.join(requester) != 0 { return 21; }
        let result = thread.join(waiter);
        if result != 1 && result != 2 { return 22; }
        switch channel.receive_timeout[i64](pipe,0) {
            case channel.ReceiveWaitResult.Closed: {}
            default: return 23;
        }
    }
    return 0;
}
