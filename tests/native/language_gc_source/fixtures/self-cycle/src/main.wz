package app;

// A Vec[Node] whose element points back at its own container. Plain ARC
// cannot reclaim this object graph.
struct Node {
    value i32;
    children Vec[Node];
}

func main() i32 {
    var cycle Vec[Node] = [Node(value: 1, children: [])];
    cycle[0] = Node(value: 2, children: cycle);
    if cycle[0].value != 2 {
        return 1;
    }
    if cycle[0].children[0].value != 2 {
        return 2;
    }
    return 0;
}
