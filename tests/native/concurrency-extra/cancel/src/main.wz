package main;
import "std/cancel" as cancel;
import "std/os" as os;
import "std/sync" as sync;
import "std/thread" as thread;

struct Work {
    token cancel.Token;
    started sync.AtomicI64;
    ticks sync.AtomicI64;
    deferred sync.AtomicI64;
    checked sync.AtomicI64;
}

func cooperative(work Work) i64 {
    defer { sync.fetch_add(work.deferred,1); }
    sync.store(work.started,1);
    for !cancel.is_cancelled(work.token) {
        sync.fetch_add(work.ticks,1);
    }
    var rejected = false;
    try { cancel.check(work.token); }
    catch error cancel.Error {
        switch error { case cancel.Error.Cancelled: rejected = true; }
    }
    if !rejected { return 1; }
    sync.store(work.checked,1);
    return 0;
}

func wait_value(value sync.AtomicI64, expected i64) bool {
    for var spin i64 = 0; spin < 100000000; spin += 1 {
        if sync.load(value) == expected { return true; }
    }
    return false;
}

func main() i32 throws os.Error {
    let token = cancel.new();
    if cancel.is_cancelled(token) { return 1; }
    var accepted = false;
    try { cancel.check(token); accepted = true; }
    catch error cancel.Error { return 2; }
    if !accepted { return 3; }

    cancel.request(token);
    cancel.request(token);
    cancel.request(token);
    if !cancel.is_cancelled(token) { return 4; }
    let alias = token;
    if !cancel.is_cancelled(alias) { return 5; }
    for var attempt i32 = 0; attempt < 3; attempt += 1 {
        var rejected = false;
        try { cancel.check(alias); }
        catch error cancel.Error {
            switch error { case cancel.Error.Cancelled: rejected = true; }
        }
        if !rejected { return 6; }
    }

    let work = Work(
        token: cancel.new(),
        started: sync.atomic_i64(0),
        ticks: sync.atomic_i64(0),
        deferred: sync.atomic_i64(0),
        checked: sync.atomic_i64(0));
    let worker = thread.spawn[Work](cooperative,work);
    if !wait_value(work.started,1) { return 7; }
    for var spin i64 = 0; spin < 100000 && sync.load(work.ticks) < 1000; spin += 1 { }
    if sync.load(work.ticks) == 0 { return 8; }
    cancel.request(work.token);
    cancel.request(work.token);
    if thread.join(worker) != 0 { return 9; }
    if sync.load(work.checked) != 1 || sync.load(work.deferred) != 1 { return 10; }

    let completed = cancel.new();
    var normal_defer = false;
    if !cancel.is_cancelled(completed) {
        defer { normal_defer = true; }
    }
    if !normal_defer { return 11; }
    return 0;
}
