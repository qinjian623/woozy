package main;
import "std/os" as os;
import "std/thread" as thread;
func add(x i64) i64 { return x + 1; }
func relay[A](entry func(A) i64, argument A) i64 throws os.Error {
    return thread.join(thread.spawn[A](entry, argument));
}
func main() i32 throws os.Error {
    let callback = add;
    let first = thread.spawn[i64](callback, 4294967296);
    let alias = first;
    if !(thread.join(first) == 4294967297) { return 1; }
    if !(thread.join(alias) == 4294967297) { return 1; }
    if !(relay[i64](add, -42) == -41) { return 1; }
    return 0;
}
