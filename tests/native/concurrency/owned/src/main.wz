package main;
import "std/os" as os;
import "std/thread" as thread;
enum Payload { Values(data Vec[i64]); }
struct Work { rows Vec[Vec[i64]]; payload Payload; callback func(i64) i64; }
func increment(x i64) i64 { return x + 1; }
func sum(work Work) i64 {
    var result i64 = 0;
    for var n i32 = 0; n < 200; n += 1 {
        var part i64 = 0;
        for row in work.rows { for x in row { part += x; } }
        switch work.payload { case Payload.Values(values): for x in values { part += x; } }
        result = work.callback(part);
    }
    return result;
}
func main() i32 throws os.Error {
    let work = Work(rows: [[1,2],[3,4]], payload: Payload.Values([5,6]), callback: increment);
    for var n i32 = 0; n < 16; n += 1 {
        let jobs = [thread.spawn[Work](sum,work),thread.spawn[Work](sum,work),thread.spawn[Work](sum,work),thread.spawn[Work](sum,work)];
        for job in jobs { if !(thread.join(job) == 22) { return 1; } }
    }
    return 0;
}
