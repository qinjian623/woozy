func main() i32 throws os.Error {
    let done = sync.atomic_i64(0);
    for var n i32 = 0; n < 64; n += 1 { let dropped = thread.spawn[sync.AtomicI64](worker,done); }
    for sync.load(done) < 64 { }
    return 0;
}
