package app;
import "capturing/lib" as capturing;

func cb(value i32) i32 {
    return value + 10;
}

func main() i32 {
    {
        // Explicit close uses the C unregister symbol and a Unit result.
        let sub = capturing.subscribe(cb);
        if capturing.invoke_last(sub, 1) != 11 { return 1; }
        if capturing.info_last(sub) != 1 { return 2; }
        capturing.close(sub);
        if capturing.live_subscriptions() != 0 { return 3; }
        if capturing.unregister_calls() != 1 { return 4; }
    }
    {
        // No explicit close: leaving the block releases the last Source owner.
        let auto = capturing.subscribe(cb);
        if capturing.invoke_last(auto, 2) != 12 { return 5; }
    }
    if capturing.live_subscriptions() != 0 { return 6; }
    if capturing.unregister_calls() != 2 { return 7; }
    if capturing.live_threads() != 0 { return 8; }
    return 0;
}
