package app;
import "capturing/lib" as capturing;

// Integration probe: this project only uses the managed registration surface.
// A compiler that has not yet frozen CRegistrationDecl/CRegistrationCall
// rejects the binding before reaching this source.  Once it parses, the same
// project is built and executed at O0 and O2.
func cb(value i32) i32 {
    return value + 1;
}

func main() i32 {
    let sub = capturing.subscribe(cb);
    if capturing.invoke_last(sub, 4) != 5 {
        return 1;
    }
    return 0;
}
