package app;
import "capturing/lib" as capturing;

// The callback environment captures a Vec graph whose element stores the same
// function value.  That is a cycle rooted externally by the registration
// context until explicit close.  The test does not require the collector to
// reclaim the cycle; it checks that explicit close drops the external root and
// that later graph use and allocation pressure stay valid.
struct Node {
    value i32;
    callback func(i32) i32;
    next Vec[Node];
}

func main() i32 {
    {
        var ring Vec[Node] = [
            Node(value: 1, callback: func(value i32) i32 { return value; }, next: [])
        ];
        let cb = func(value i32) i32 {
            return ring[0].value + value;
        };
        ring[0] = Node(value: 7, callback: cb, next: ring);

        let sub = capturing.subscribe(cb);
        if capturing.invoke_last(sub, 5) != 12 { return 1; }
        if capturing.calls(sub) != 1 { return 2; }
        capturing.close(sub);
        if capturing.live_subscriptions() != 0 { return 3; }
        // The local ring and its stored function value are still live.
        if ring[0].callback(1) != 8 { return 4; }
    }

    var i i32 = 0;
    for i < 64 {
        var pressure Vec[Vec[i32]] = [[i, i + 1], [i + 2, i + 3]];
        pressure[0][0] = i;
        i += 1;
    }
    if capturing.live_subscriptions() != 0 { return 5; }
    if capturing.unregister_calls() != 1 { return 6; }
    return 0;
}
