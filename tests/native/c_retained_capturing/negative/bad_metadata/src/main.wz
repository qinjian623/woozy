package app;
import "capturing/lib" as capturing;

func cb(value i32) i32 {
    return value;
}

// The local binding declares the callback context as u64 instead of
// PtrMut[Unit].  Binding validation must reject it before code generation.
func main() i32 {
    let sub = capturing.subscribe(cb);
    return capturing.invoke_last(sub, 1) - 1;
}
