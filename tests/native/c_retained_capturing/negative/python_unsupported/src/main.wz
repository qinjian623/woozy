package app;
import "capturing/lib" as capturing;

func cb(value i32) i32 {
    return value;
}

// C bindings are Native-only.  The Python backend must reject this project
// explicitly and must not emit a Python program.
func main() i32 {
    let sub = capturing.subscribe(cb);
    return capturing.invoke_last(sub, 1) - 1;
}
