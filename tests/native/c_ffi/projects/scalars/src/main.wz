package app;
import "fixture/lib" as fixture;
import "std/ffi" as ffi;

func callback(value i32, context u64) i32 {
    return value + i32(context);
}

func point_cb(point fixture.Point, context u64) i64 {
    return i64(point.x) + 100 * i64(point.y);
}

func point_return_cb(context u64) fixture.Point {
    return fixture.cf_point_make(11, 22, 1.5);
}

func tiny_cb(value fixture.Tiny, context u64) fixture.Tiny {
    return value;
}

func large_cb(value fixture.Large, context u64) fixture.Large {
    return value;
}

func narrow_cb(a i8, b u16, c f32, d bool, context u64) bool {
    return a == -7 && b == 65000 && c == 2.5 && d;
}

func float_cb(a f32, b f64, context u64) f64 {
    return f64(a) + b;
}

func int_return_cb(a i8, b u16, context u64) i16 {
    return i16(a) + i16(b);
}

func early_resource(value i32) i32 {
    let resource = fixture.cf_resource_new(value);
    if value < 0 { return 1; }
    return fixture.cf_resource_value(resource) - value;
}

