    let pointer PtrMut[i32] = fixture.cf_global_i32_ptr();
    if fixture.cf_read_i32(pointer) != 11 { return 20; }
    unsafe {
        if pointer[0] != 11 { return 21; }
        pointer[0] = 42;
        pointer[0] += 1;
        if pointer[0] != 43 { return 51; }
        pointer[0] -= 1;
    }
    if fixture.cf_read_i32(pointer) != 42 { return 22; }
    fixture.cf_write_i32(pointer, 51);
    unsafe {
        if pointer[0] != 51 { return 23; }
    }

    let writable = fixture.cf_sha_output();
    let mutable = ffi.buffer_mut[u8](writable, 8);
    if ffi.len_mut[u8](mutable) != 8 { return 42; }
    unsafe {
        mutable[0] = 7;
        mutable[1] = 9;
        mutable[0] += 1;
        if mutable[0] != 8 { return 43; }
