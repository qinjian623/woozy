    if fixture.cf_add_i32(-3, 10) != 7 { return 12; }
    fixture.cf_void(77);
    if fixture.cf_last_void() != 77 { return 13; }

    let bytes Ptr[u8] = fixture.cf_bytes_ptr();
    let count = fixture.cf_bytes_len();
    let view Buffer[u8] = ffi.buffer[u8](bytes, count);
    if ffi.len[u8](view) != 4 { return 14; }
    unsafe {
        if view[0] != 65 { return 15; }
        if view[1] != 0 { return 16; }
        if view[2] != 255 { return 17; }
        if view[3] != 66 { return 18; }
    }
    if fixture.cf_checksum(view) != 146159386 { return 19; }
    let small_index i32 = 2;
    unsafe {
        if view[small_index] != 255 { return 45; }
