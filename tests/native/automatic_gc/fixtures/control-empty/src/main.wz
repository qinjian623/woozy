package app;

// Blank control: a real Native program with no heap-owning value at all.
// The observation build must see zero allocations, so startup code does not
// contribute to the leak measurements of the other fixtures.
func main() i32 {
    var total i32 = 0;
    for var i i32 = 0; i < 3; i += 1 {
        total += i;
    }
    if total != 3 {
        return 1;
    }
    return 0;
}
