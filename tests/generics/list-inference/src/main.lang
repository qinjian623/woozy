package app;

enum E { Bad; }
func accept_i32(values Vec[i32]) {}
func accept_f32(values Vec[f32]) {}
func accept_f64(values Vec[f64]) {}
func accept_nested(values Vec[Vec[i32]]) {}
func record(log inout i32, digit i32) i32 {
    log = log * 10 + digit;
    return digit;
}
func fail(log inout i32) Vec[i32] throws E {
    log = log * 10 + 7;
    throw E.Bad;
}
func id[T](value T) T {
    return value;
}

func main() i32 {
    let value i32 = 2;
    let first = [1, value];
    let reverse = [value, 1];
    accept_i32(first);
    accept_i32(reverse);
    if first[0] != reverse[1] || first[1] != reverse[0] { return 1; }

    let real f32 = 2.5;
    let floats = [1.0, real];
    let reversed_floats = [real, 1.0];
    accept_f32(floats);
    accept_f32(reversed_floats);
    let defaults = [1.0 + 2.5, 3.0];
    let reversed_defaults = [3.0, 1.0 + 2.5];
    accept_f64(defaults);
    accept_f64(reversed_defaults);
    if defaults[0] != 3.5 || reversed_defaults[1] != 3.5 { return 2; }

    let nested = [[1], [value]];
    let empty_first = [[], [value]];
    let empty_last = [[value], []];
    accept_nested(nested);
    accept_nested(empty_first);
    accept_nested(empty_last);
    if nested[0][0] != 1 || empty_first[1][0] != value { return 3; }
    let generic_int = [1, id[i32](2)];
    let generic_float = [1.0, id[f32](2.5)];
    accept_i32(generic_int);
    accept_f32(generic_float);

    var log i32 = 0;
    let ordered = [1, record(inout log, 2), record(inout log, 3)];
    if log != 23 || ordered[1] != 2 || ordered[2] != 3 { return 4; }
    let nested_order = [[record(inout log, 4)], [5], [record(inout log, 6)]];
    if log != 2346 || nested_order[1][0] != 5 { return 5; }
    try {
        let ignored = [[1], fail(inout log)];
        return 6;
    } catch error E {
        if log != 23467 { return 7; }
    }
    return 0;
}
