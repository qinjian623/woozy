    swap[i64](inout bx, inout by);
    if bx != 4 || by != 3 {
        return 2;
    }

    var cx u32 = 5;
    var cy u32 = 6;
    swap(inout cx, inout cy);
    if cx != 6 || cy != 5 {
        return 3;
    }

    var dx u64 = 7;
