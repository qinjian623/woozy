package app;

enum E {
    Bad;
}

trait Value {
    func get(self Self) i32;
}

trait Left {
    func pick(self Self) i32;
}

trait Right {
    func pick(self Self) i32;
}

impl Value for i32 { func get(self Self) i32 { return self; } }
impl Value for i64 { func get(self Self) i32 { return 1; } }
impl Value for u32 { func get(self Self) i32 { return 2; } }
impl Value for u64 { func get(self Self) i32 { return 3; } }
impl Value for f32 { func get(self Self) i32 { return 4; } }
impl Value for f64 { func get(self Self) i32 { return 5; } }
impl Value for bool { func get(self Self) i32 { return 6; } }

impl Left for i32 { func pick(self Self) i32 { return 3; } }
impl Right for i32 { func pick(self Self) i32 { return 7; } }

func mark(log inout i64, digit i32) {
    log = log * 10 + i64(digit);
}

func mark_value(log inout i64, digit i32) i32 {
    mark(inout log, digit);
    return digit;
}

func swap[T Value](a inout T, b inout T) {
    let tmp = a;
    a = b;
    b = tmp;
}

func replace[T Value](slot inout T, value T) T {
    let old = slot;
    let observed = slot.get();
    slot = value;
    return old;
}

func relay[T Value](a inout T, b inout T) {
    swap(inout a, inout b);
}

func forward[T Value](slot inout T, value T) T {
    return replace(inout slot, value);
}

func late[T Value](slot inout T, value T) T {
    let old = slot;
    defer {
        slot = value;
    }
    return old;
}

func pair[T Value, U Right](first inout T, second inout U,
                            first_value T, second_value U, log inout i64) {
    let f = first.get();
    let s = second.pick();
    first = first_value;
    second = second_value;
    mark(inout log, f + s);
}

func left[T Left](slot inout T, value T, log inout i64) {
    let p = slot.pick();
    slot = value;
    mark(inout log, p);
}

func right[T Right](slot inout T, value T, log inout i64) {
    let p = slot.pick();
    slot = value;
    mark(inout log, p);
}

func ordered[T Value](slot inout T, value T, second i32) T {
    let old = slot;
    slot = value;
    return old;
}

func use3[T Value](slot inout T, value T, first i32, second i32) i32 {
    slot = value;
    return first + second;
}

func bad(log inout i64) i32 throws E {
    mark(inout log, 2);
    throw E.Bad;
}

func fail[T Value](slot inout T, value T, log inout i64) i32 throws E {
    slot = value;
    mark(inout log, 4);
    throw E.Bad;
}

func mix[T Value](slot inout T, value T, owned move Vec[i32]) T {
    let local Vec[i32] = [70];
    defer {
        let read = local[0];
    }
    let old = slot;
    slot = value;
    return old;
}

func apply(f func(inout i32, i32) i32, slot inout i32, value i32) i32 {
    return f(inout slot, value);
}

func choose() (func(inout i32, i32) i32) {
    return replace;
}

func main() i32 {
    var log i64 = 0;

    var ax i32 = 1;
    var ay i32 = 2;
    swap(inout ax, inout ay);
    if ax != 2 || ay != 1 {
        return 1;
    }

    var bx i64 = 3;
