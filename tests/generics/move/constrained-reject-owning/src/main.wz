package app;

trait Value {
    func get(self Self) i32;
}

struct Item {
    items Vec[i32];
}

impl Value for Item {
    func get(self Self) i32 {
        return self.items[0];
    }
}

func swap[T Value](a inout T, b inout T) {
    let tmp = a;
    a = b;
    b = tmp;
}

func main() i32 {
    var first Item = Item(items: [1]);
    var second Item = Item(items: [2]);
    swap(inout first, inout second);
    return 0;
}
