package app;

trait Value {
    func get(self Self) i32;
}

trait Left {
    func pick(self Self) i32;
}

trait Right {
    func pick(self Self) i32;
}

struct Item {
    items Vec[i32];
}

impl Value for Item {
    func get(self Self) i32 {
        return self.items[0];
    }
}

impl Value for i32 {
    func get(self Self) i32 {
        return self;
    }
}

impl Value for bool {
    func get(self Self) i32 {
        if self {
            return 1;
        }
        return 0;
    }
}

impl Left for Item {
    func pick(self Self) i32 {
        return self.items[0] + 20;
    }
}

impl Right for Item {
    func pick(self Self) i32 {
        return self.items[0] + 10;
    }
}

func mark(log inout i64, digit i64) {
    log = log * 10 + digit;
}

func read[T Value](value move T) i32 {
    return value.get();
}

func pair[T Value, U Right](first move T, second move U) i32 {
    return first.get() + second.pick();
}

func forward[T Value](value move T) i32 {
    return read(move value);
}

func right[T Right](value move T) i32 {
    return value.pick();
}

func left[T Left](value move T) i32 {
    return value.pick();
}

func main() i32 {
    var log i64 = 0;

    var dropped Item = Item(items: [8]);
    mark(inout log, 1);
    let dropped_result = read(move dropped);
    mark(inout log, 2);
    if dropped_result != 8 {
        return 1;
    }

    var inferred Item = Item(items: [7]);
    let alias = inferred;
    let inferred_result = read(move inferred);
    if inferred_result != 7 || alias.items[0] != 7 {
        return 2;
    }

    var explicit Item = Item(items: [3]);
    let explicit_result = read[Item](move explicit);
    if explicit_result != 3 {
        return 3;
    }

    var right_item Item = Item(items: [4]);
    let right_result = right(move right_item);
    if right_result != 14 {
        return 4;
    }
    var right_explicit Item = Item(items: [5]);
    let right_explicit_result = right[Item](move right_explicit);
    if right_explicit_result != 15 {
        return 5;
    }

    var left_item Item = Item(items: [6]);
    let left_result = left(move left_item);
    if left_result != 26 {
        return 6;
    }

    var pair_first Item = Item(items: [7]);
    var pair_second Item = Item(items: [8]);
    let pair_result = pair(move pair_first, move pair_second);
    if pair_result != 25 {
        return 7;
    }
    var pair_first_explicit Item = Item(items: [9]);
    var pair_second_explicit Item = Item(items: [10]);
    let pair_explicit_result = pair[Item, Item](
        move pair_first_explicit, move pair_second_explicit);
    if pair_explicit_result != 29 {
        return 8;
    }

    var scalar i32 = 11;
    let scalar_result = read(move scalar);
    if scalar_result != 11 {
        return 9;
    }
    var flag bool = true;
    let flag_result = read(move flag);
    if flag_result != 1 {
        return 10;
    }

    var forwarded Item = Item(items: [12]);
    let forwarded_result = forward(move forwarded);
    if forwarded_result != 12 {
        return 11;
    }
    var forwarded_explicit Item = Item(items: [13]);
    let forwarded_explicit_result = forward[Item](move forwarded_explicit);
    if forwarded_explicit_result != 13 {
        return 12;
    }

    if log != 12 {
        return 13;
    }
    return 0;
}
