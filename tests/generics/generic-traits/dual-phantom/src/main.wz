package app;
trait Convert[A, B] { func code(owner Self) i32; }
struct Key { value i32; }
impl Convert[i32, bool] for Key { func code(owner Self) i32 { return owner.value + 11; } }
impl Convert[bool, i32] for Key { func code(owner Self) i32 { return owner.value + 22; } }
func first[T Convert[i32, bool]](owner T) i32 { return owner.code(); }
func second[T Convert[bool, i32]](owner T) i32 { return T.code(owner); }
func forward[T Convert[i32, bool]](owner T) i32 { return first[T](owner); }
func main() i32 {
    let key = Key(value: 3);
    if first(key) != 14 || second(key) != 25 || forward(key) != 14 { return 1; }
    return 0;
}
