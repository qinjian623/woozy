package app;
trait Carry[A] {func relay[U](owner Self,key A,value move U)U;}
struct Box[T] {value T;}
impl[P] Carry[P] for Box[P] {func relay[V](owner Self,key P,value move V)V{return move value;}}
func forward[T Carry[i32],U](owner T,value move U)U{return T.relay[U](owner,1,move value);}
func main()i32 {let b=Box[i32](value:2);let a=b.relay[Vec[i32]](2,[7]);let c=Box[i32].relay[Vec[i32]](b,3,move a);let d=forward(b,move c);if d[0]!=7{return 1;}return 0;}
