package app;

enum E {
    Bad;
}

struct Holder {
    items Vec[i32];
    marker i32;
}

struct Box {
    items Vec[i32];
    marker i32;
}

impl Holder {
    func consume(self Self, value move Box) i32 throws E {
        let local = Box(items: [9], marker: 1);
        defer {
            let read = local.items[0];
        }
        throw E.Bad;
    }

    func keep(self Self, value move Box) Box {
        let local Vec[i32] = [8];
        defer {
            let read = local[0];
        }
        return move value;
    }
}

func main() i32 {
    let h = Holder(items: [1], marker: 5);
    let alias = h.items;

    var box = Box(items: [2], marker: 1);
    let box_alias = box;
    let kept = h.keep(move box);
    kept.items[0] = 7;
    if box_alias.items[0] != 7 {
        return 1;
    }
    if alias[0] != 1 {
        return 2;
    }

    var failing = Box(items: [3], marker: 2);
    try {
        let ignored = h.consume(move failing);
    } catch err E {
        if h.marker != 5 {
            return 3;
        }
    }
    if alias[0] != 1 {
        return 4;
    }
    return 0;
}
