package app;

struct Box[T] {
    value T;
    items Vec[i32];
    marker i32;
}

struct Pair[A, B] {
    first A;
    second B;
    items Vec[i32];
}

enum Maybe[T] {
    None;
    Some(value T);
}

func mark(log inout i64, digit i64) {
    log = log * 10 + digit;
}

func mark_value(log inout i64, digit i64) i32 {
    mark(inout log, digit);
    return i32(digit);
}

func make_box(log inout i64) Box[i32] {
    mark(inout log, 9);
    return Box[i32](value: 1, items: [91], marker: 0);
}

func relay[T](value move T) T {
    return move value;
}

impl[T] Box[T] {
    func take[U](self Self, value move U) U {
        return move value;
    }

    func take_static[U](value move U) U {
        return move value;
    }

    func mix[U](self Self, left move T, right move U) U {
        return move right;
    }

    func forward[U](self Self, value move U) U {
        return relay(move value);
    }

    func nested[U](self Self, value move U) U {
        return self.take(move value);
    }

    func ordered[U](self Self, first i32, value move U, second i32) U {
        return move value;
    }

    func keep[U](self Self, value move U) U {
        let local Vec[i32] = [90];
        defer {
            let read = local[0];
        }
        return move value;
    }

    func also[U](self Self, value move U) i32 {
        return self.marker + 1;
    }

    func accept(self Self, value move Self) i32 {
        return self.marker + value.marker;
    }

    func static_self[U](self U, value move U) i32 {
        return 1;
    }
}

impl[A, B] Pair[A, B] {
    func move_second[U](self Self, first move A, second move B, value move U) U {
        return move value;
    }

    func pair_take[U, V](self Self, first move U, second move V) V {
        return move second;
    }
}

impl[T] Maybe[T] {
    func take[U](value move U) U {
        return move value;
    }
}

func main() i32 {
    let b = Box[i32](value: 1, items: [2], marker: 3);
    let bv = Box[Vec[i32]](value: [3], items: [4], marker: 5);

    var x i32 = 4;
    let rx = b.take(move x);
    if rx != 4 {
        return 1;
    }

    var xs i32 = 28;
    let rxs = b.take[i32](move xs);
    if rxs != 28 {
        return 21;
    }

    var y Vec[i32] = [5];
    let y_alias = y;
    let ry = b.take(move y);
    ry[0] = 15;
    if y_alias[0] != 15 {
        return 2;
    }

    var z Vec[i32] = [6];
    let z_alias = z;
    let rz = bv.take(move z);
    rz[0] = 16;
    if z_alias[0] != 16 {
        return 3;
    }

    var s0 Vec[i32] = [7];
    let s0_alias = s0;
    let rs0 = Box[i32].take_static[Vec[i32]](move s0);
    rs0[0] = 17;
    if s0_alias[0] != 17 {
        return 4;
    }

    var s1 Vec[i32] = [8];
    let rs1 = Box[i32].take_static(move s1);
    if rs1[0] != 8 {
        return 5;
    }

    var s2 Vec[i32] = [9];
    let s2_alias = s2;
    let rs2 = Box[Vec[i32]].take_static[Vec[i32]](move s2);
    rs2[0] = 18;
    if s2_alias[0] != 18 {
        return 6;
    }

    var m1 i32 = 10;
    var m2 Vec[i32] = [11];
    let m2_alias = m2;
    let rm = b.mix(move m1, move m2);
    rm[0] = 19;
    if m2_alias[0] != 19 {
        return 7;
    }

    var m3 Vec[i32] = [12];
    var m4 i32 = 13;
    let rm2 = bv.mix(move m3, move m4);
    if rm2 != 13 {
        return 8;
    }

    var fw Vec[i32] = [14];
    let fw_alias = fw;
    let fwr = b.forward(move fw);
    fwr[0] = 20;
    if fw_alias[0] != 20 {
        return 9;
    }

    var nn Vec[i32] = [15];
    let nnr = b.nested(move nn);
    if nnr[0] != 15 {
        return 10;
    }

    var log i64 = 0;
    var named_values Vec[i32] = [16];
    let named_alias = named_values;
    let named = make_box(inout log).ordered(
        second: mark_value(inout log, 3),
        value: move named_values,
        first: mark_value(inout log, 2));
    if log != 932 {
        return 11;
    }
    named[0] = 21;
    if named_alias[0] != 21 {
        return 12;
    }

    var kept Vec[i32] = [17];
    let kept_alias = kept;
    let kept_result = b.keep(move kept);
    kept_result[0] = 22;
    if kept_alias[0] != 22 {
        return 13;
    }

    let copy = b;
    let acc = b.also(move copy);
    if acc != 4 {
        return 14;
    }
    let copy2 = b;
    let acc2 = b.accept(move copy2);
    if acc2 != 6 {
        return 15;
    }
    let copy3 = b;
    let rss = Box[i32].static_self[Box[i32]](b, move copy3);
    if rss != 1 {
        return 20;
    }

    let pair = Pair[i32, Vec[i32]](first: 1, second: [18], items: [19]);
    var p1 i32 = 20;
    var p2 Vec[i32] = [21];
    var p3 Box[i32] = Box[i32](value: 1, items: [22], marker: 4);
    let rp = pair.move_second(move p1, move p2, move p3);
    if rp.marker != 4 {
        return 16;
    }
    var q1 Vec[i32] = [23];
    var q2 i32 = 24;
    let rq = pair.pair_take[Vec[i32], i32](move q1, move q2);
    if rq != 24 {
        return 17;
    }

    let e0 = Maybe[i32].take[Vec[i32]]([25]);
    if e0[0] != 25 {
        return 18;
    }
    var e1 Vec[i32] = [26];
    let e1_alias = e1;
    let re = Maybe[Vec[i32]].take(move e1);
    re[0] = 27;
    if e1_alias[0] != 27 {
        return 19;
    }
    return 0;
}
