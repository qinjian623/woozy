package app;

enum E {
    Bad;
}

trait Maker {
    func make(seed i32) Self;
    func zero() Self;
}

trait Echo {
    func copy(owner Self, delta i32) Self;
}

trait Ordered {
    func pick(first i32, second i32) Self;
}

trait Checked {
    func accept(seed i32) Self throws E;
}

struct Box {
    value i32;
}

impl Maker for Box {
    func make(seed i32) Self {
        return Box(value: seed);
    }
    func zero() Self {
        return Box(value: 0);
    }
}

impl Echo for Box {
    func copy(owner Self, delta i32) Self {
        return Box(value: owner.value + delta);
    }
}

impl Ordered for Box {
    func pick(first i32, second i32) Self {
        return Box(value: first * 10 + second);
    }
}

impl Checked for Box {
    func accept(seed i32) Self throws E {
        if seed == 9 {
            throw E.Bad;
        }
        return Box(value: seed);
    }
}

func mark(log inout i64, digit i64) {
    log = log * 10 + digit;
}

func mark_value(log inout i64, digit i64) i32 {
    mark(inout log, digit);
    return i32(digit);
}

func bad(log inout i64) i32 throws E {
    mark(inout log, 9);
    throw E.Bad;
}

func build[T Maker](seed i32) T {
    return T.make(seed);
}

func zero[T Maker]() T {
    return T.zero();
}

func copy_value[T Echo](value T, delta i32) T {
    return T.copy(delta: delta, owner: value);
}

func relay[T Maker](seed i32) T {
    return build[T](seed);
}

func ordered[T Ordered](log inout i64) T {
    return T.pick(second: mark_value(inout log, 3),
                  first: mark_value(inout log, 2));
}

func checked_ok[T Checked](log inout i64, seed i32) T throws E {
    return T.accept(seed: mark_value(inout log, i64(seed)));
}

func checked_bad[T Checked](log inout i64) T throws E {
    return T.accept(seed: bad(inout log));
}

func main() i32 {
    let a = build[Box](3);
    let b = zero[Box]();
    let c = copy_value[Box](a, 4);
    let d = relay[Box](5);
    if a.value != 3 || b.value != 0 || c.value != 7 || d.value != 5 {
        return 1;
    }

    let s = Box.make(2);
    let t = Box.copy(owner: s, delta: 1);
    let u = s.copy(delta: 2);
    if t.value != 3 || u.value != 4 || s.value != 2 {
        return 2;
    }

    var log i64 = 0;
    let ordered_value = ordered[Box](inout log);
    if ordered_value.value != 23 || log != 32 {
        return 3;
    }

    var ok_log i64 = 0;
    try {
        let accepted = checked_ok[Box](inout ok_log, 4);
        if accepted.value != 4 || ok_log != 4 {
            return 4;
        }
    } catch e E {
        return 5;
    }

    var bad_log i64 = 0;
    try {
        let failed = checked_bad[Box](inout bad_log);
        return 6;
    } catch e E {
        if bad_log != 9 {
            return 7;
        }
    }
    if bad_log != 9 {
        return 8;
    }
    return 0;
}
