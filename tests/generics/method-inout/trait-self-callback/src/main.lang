enum Failure { Bad; }
trait CallbackFlow {
    func apply(self Self, f func(inout Self, Self) Self, slot inout Self,
               value Self, log inout i64) Self;
    func factory(self Self) (func(inout Self, Self) Self);
    func saved(self Self, f func(inout Self, Self) Self, slot inout Self,
               value Self, log inout i64, owned move Vec[i32]) Self;
    func failed(self Self, f func(inout Self, Self) Self, slot inout Self,
                value Self, log inout i64, owned move Vec[i32]) Self
        throws Failure;
}
func mark(log inout i64, digit i64) { log = log * 10 + digit; }
func replace(slot inout i32, value i32) i32 {
    let old = slot; slot = value; return old;
}
func reset(slot inout bool, value bool) bool {
    let old = slot; slot = value; return old;
}
impl CallbackFlow for i32 {
    func apply(self Self, f func(inout Self, Self) Self, slot inout Self,
               value Self, log inout i64) Self {
