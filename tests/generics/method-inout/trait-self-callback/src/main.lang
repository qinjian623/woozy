func through[T CallbackFlow](receiver T, f func(inout T, T) T,
                             slot inout T, value T, log inout i64) T {
    return receiver.apply(f, inout slot, value, inout log);
}
func outer[T CallbackFlow](receiver T, f func(inout T, T) T, slot inout T,
                           value T, log inout i64) T {
    return through(receiver, f, inout slot, value, inout log);
}
func make[T CallbackFlow](receiver T) (func(inout T, T) T) {
    return receiver.factory();
}
