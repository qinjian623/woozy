func mark(log inout i64, digit i64) {
    log = log * 10 + digit;
}

func mark_value(log inout i64, digit i64) i32 {
    mark(inout log, digit);
    return i32(digit);
}

func swap[T](a inout T, b inout T) {
    let tmp = a;
    a = b;
    b = tmp;
}

func relay[T](a inout T, b inout T) {
    swap(inout a, inout b);
}

func make_box(log inout i64) Box[i32] {
    mark(inout log, 9);
    return Box[i32](value: 1, items: [90], marker: 0);
}

impl Plain {
    func replace_plain(self Self, slot inout i32, value i32) i32 {
        let old = slot;
        slot = value;
        return old;
    }

    func replace_plain_static(slot inout i32, value i32) i32 {
        let old = slot;
        slot = value;
        return old;
    }

    func keep_plain[U](self Self, slot inout U, value U) U {
        let old = slot;
        slot = value;
        return old;
    }

    func keep_plain_static[U](slot inout U, value U) U {
        let old = slot;
        slot = value;
        return old;
    }
}

impl[T] Box[T] {
    func bump_self(self Self, slot inout T, value T) T {
        let old = slot;
        slot = value;
        return old;
