    func replace_static[U](slot inout U, value U) U {
        let old = slot;
        slot = value;
        return old;
    }

    func ordered[U](self Self, slot inout U, value U, second i32) U {
        let old = slot;
        slot = value;
        return old;
    }

    func forward[U](self Self, slot inout U, value U) U {
        return self.replace(inout slot, value);
    }

    func forward_static[U](slot inout U, value U) U {
        return Box[i32].replace_static(inout slot, value);
    }

    func forward_free[U](self Self, a inout U, b inout U) {
        swap(inout a, inout b);
    }

    func relay_free[U](self Self, a inout U, b inout U) {
        relay(inout a, inout b);
    }

    func static_self[U](self U, slot inout i32, value i32) i32 {
        let old = slot;
        slot = value;
        return old;
    }

    func mixed[U](self Self, slot inout U, value U, owned move Vec[i32]) U {
        let local Vec[i32] = [70];
        defer {
            let read = local[0];
        }
        let old = slot;
        slot = value;
        return old;
    }
}

impl[A, B] Pair[A, B] {
