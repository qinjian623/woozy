package app;

const NaN i32 = 99;

func classify_i8(x i8) i32 {
    switch x {
    case -128: return 1;
    case 0x10: return 2;
    default: return 3;
    }
}

func classify_u64(x u64) i32 {
    switch x {
    case 18446744073709551615: return 1;
    default: return 2;
    }
}

func classify_isize(x isize) i32 {
    switch x {
    case -9223372036854775808: return 1;
    default: return 2;
    }
}

func classify_usize(x usize) i32 {
    switch x {
    case 18446744073709551615: return 1;
    default: return 2;
    }
}

func classify_bool(x bool) i32 {
    switch x {
    case true: return 1;
    case false: return 2;
    }
}

func classify_f32(x f32) i32 {
    switch x {
    case 0.0: return 1;
    case 1e9999: return 2;
    case -1e9999: return 3;
    case 1.5: return 4;
    default: return 5;
    }
}

func classify_f64(x f64) i32 {
    switch x {
    case 0.0: return 1;
    case 1e9999: return 2;
    case -1e9999: return 3;
    case 1.5: return 4;
    default: return 5;
    }
}

func classify_string(x string) i32 {
    switch x {
    case "": return 1;
    case "a\0b": return 2;
    case "a\0c": return 3;
    case "中\0😀": return 4;
    case "\u{61}": return 5;
    default: return 6;
    }
}

func bound(x i32) i32 {
    switch x {
    case 0: return 0;
    case NaN: return NaN;
    }
}

func main() i32 {
    let i8_min i8 = -128;
    if classify_i8(i8_min) != 1 { return 1; }
    let i8_hex i8 = 16;
    if classify_i8(i8_hex) != 2 { return 2; }
    if classify_i8(1) != 3 { return 3; }

    let u64_max u64 = 18446744073709551615;
    if classify_u64(u64_max) != 1 { return 4; }
    let isize_min isize = -9223372036854775808;
    if classify_isize(isize_min) != 1 { return 5; }
    let usize_max usize = 18446744073709551615;
    if classify_usize(usize_max) != 1 { return 6; }

    if classify_bool(true) != 1 || classify_bool(false) != 2 { return 7; }

    let zero f32 = 0.0;
    let nz f32 = -0.0;
    if classify_f32(zero) != 1 || classify_f32(nz) != 1 { return 8; }
    if classify_f32(1e9999) != 2 || classify_f32(-1e9999) != 3 { return 9; }
    if classify_f32(1.5) != 4 || classify_f32(1e-9999) != 1 { return 10; }
    let nan32 f32 = zero / zero;
    if classify_f32(nan32) != 5 { return 11; }
    let dzero f64 = 0.0;
    if classify_f64(dzero) != 1 || classify_f64(1e9999) != 2 { return 12; }
    if classify_f64(-1e9999) != 3 || classify_f64(1.5) != 4 { return 13; }
    let nan64 f64 = dzero / dzero;
    if classify_f64(nan64) != 5 { return 14; }

    if classify_string("") != 1 { return 15; }
    if classify_string("a\0b") != 2 { return 16; }
    if classify_string("a\0c") != 3 { return 17; }
    if classify_string("中\0😀") != 4 { return 18; }
    if classify_string("a") != 5 { return 19; }
    if classify_string("a\0b\0") != 6 { return 20; }
    if classify_string("A") != 6 { return 21; }

    if bound(5) != 5 { return 22; }
    if bound(0) != 0 { return 23; }
    return 0;
}
