package app;
import "dep" as dep;
func pick[T](e dep.E[T]) i32 {
    switch e {
    case dep.E[T].A(_, 1): return 1;
    case dep.E[T].A(_, _): return 2;
    case dep.E[T].B("a\0b"): return 3;
    case dep.E[T].B(_): return 4;
    case dep.E[T].C(true, 1.5): return 5;
    case dep.E[T].C(false, _): return 6;
    case dep.E[T].C(true, _): return 7;
    }
}
func main() i32 {
    let a = dep.E[i32].A(x: 1, tag: 1);
    let b = dep.E[i64].B(s: "a\0b");
    let c = dep.E[i32].C(flag: true, f: 1.5);
    if pick[i32](a) != 1 { return 1; }
    if pick[i64](b) != 3 { return 2; }
    if pick[i32](c) != 5 { return 3; }
    if pick[i32](dep.make[i32](7)) != 1 { return 4; }
    return 0;
}
