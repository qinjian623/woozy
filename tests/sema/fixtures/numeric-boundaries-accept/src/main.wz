package app;

func add(a i32, b i32) i32 {
    return a + b;
}

func main() i32 {
    let high i8 = 127;
    let low i8 = -128;
    let max_u8 u8 = 255;
    let minimum i32 = -2_147_483_648;
    let inferred = 1;
    let widened i64 = inferred;
    var total i32 = 0;
    total = add(total, 2);
    total += 1;
    let wrapped = high + 1;
    if wrapped != -128 || low != -128 || max_u8 != 255 ||
       minimum != -2_147_483_648 || widened != 1 || total != 3 {
        return 1;
    }
    return 0;
}
