set(project "${CMAKE_CURRENT_BINARY_DIR}/sema-cli-project")
file(MAKE_DIRECTORY "${project}/src")
file(WRITE "${project}/lang.toml" "schema_version=1\n[package]\nname=\"test\"\nsource_root=\"src\"\nentry=\"app\"\n[build]\nbackend=\"native\"\nword_bits=64\n")
function(check status code)
  execute_process(COMMAND "${LANGC}" check --project "${project}/lang.toml"
    --format json ${ARGN} RESULT_VARIABLE actual OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${actual}" STREQUAL "${status}" OR NOT err STREQUAL "")
    message(FATAL_ERROR "check: expected ${status}, got ${actual}: ${out}${err}")
  endif()
  string(JSON actual_status GET "${out}" status)
  string(JSON count LENGTH "${out}" diagnostics)
  if(status EQUAL 0)
    if(NOT actual_status STREQUAL "ok" OR NOT count EQUAL 0)
      message(FATAL_ERROR "Expected successful check: ${out}")
    endif()
  else()
    string(JSON actual_code GET "${out}" diagnostics 0 code)
    if(NOT actual_code STREQUAL "${code}" OR NOT actual_status STREQUAL "error")
      message(FATAL_ERROR "Expected ${code}: ${out}")
    endif()
  endif()
endfunction()
file(WRITE "${project}/src/main.wz" "package app; func main() i32 { var x i32=1; return x; }")
check(0 "" --backend native)
check(0 "" --backend python)
file(WRITE "${project}/src/main.wz" "package app; func main() i32 { return true; }")
check(1 E_TYPE_MISMATCH)
file(WRITE "${project}/src/main.wz" "package app; func main() { missing(); }")
check(1 E_NAME_NOT_FOUND)
file(WRITE "${project}/src/main.wz" "package app; func main() { let x=1 }")
check(1 E_PARSE_EXPECTED_TOKEN)
file(REMOVE "${project}/lang.toml")
check(2 E_INPUT_IO)
file(WRITE "${project}/lang.toml" "[package\n")
check(2 E_MANIFEST_INVALID)
file(REMOVE_RECURSE "${project}")
