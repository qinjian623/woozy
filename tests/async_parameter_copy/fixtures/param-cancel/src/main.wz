package app;
import "std/async" as a;
import "std/io" as io;
import "std/os" as os;
import "std/vec" as vec;

// Cancel after suspension runs the source defer, then the common async final
// releases both ordinary frame-owned parameters exactly once.
async func child(data Vec[i32], log Vec[string]) Unit {
    defer {
        vec.push(log, "cancel-cleanup");
    }
    await a.sleep(5000);
    vec.push(log, "SHOULD NOT RUN");
}

func main() i32 throws os.Error {
    let data Vec[i32] = [42];
    let log = vec.empty[string]();
    let task = child(data, log);
    a.spawn(task);
    a.run_until(a.sleep(10));
    a.cancel(task);
    a.run_until(task);
    if !a.finished(task) {
        return 1;
    }
    a.shutdown();
    for line in log {
        io.println(line);
    }
    return 0;
}
