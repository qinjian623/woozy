package main;

trait Read[T] {
    func get(self Self) T;
}

struct Cell[T] {
    value T;
}

impl[T] Read[T] for Cell[T] {
    func get(self Cell[T]) T { return self.value; }
}

func main() i32 {
    let a dyn Read[i32] = Cell[i32](value: 7);
    let b dyn Read[bool] = Cell[bool](value: true);
    if a.get() != 7 || !b.get() { return 1; }
    return 0;
}
