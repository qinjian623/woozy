package main;

struct One { value i32; }
struct Two { left i32; right i32; }

trait Weight {
    func weight(self Self) i32;
}

impl Weight for One {
    func weight(self One) i32 {
        return self.value;
    }
}

impl Weight for Two {
    func weight(self Two) i32 {
        return self.left + self.right;
    }
}

func main() i32 {
    var items Vec[dyn Weight] = [One(value: 1), Two(left: 2, right: 3), One(value: 4)];
    if items[0].weight() != 1 { return 1; }
    if items[1].weight() != 5 { return 2; }
    let alias = items;
    let slice = items[1:3];
    items[0] = One(value: 9);
    if alias[0].weight() != 9 { return 3; }
    if slice[0].weight() != 5 || slice[1].weight() != 4 { return 4; }
    var total i32 = 0;
    for item in items {
        total += item.weight();
    }
    if total != 18 { return 5; }
    return 0;
}
