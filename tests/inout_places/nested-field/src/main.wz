package app;

struct Level3 {
    value i32;
}

struct Level2 {
    leaf Level3;
    label i32;
}

struct Level1 {
    inner Level2;
}

func add(slot inout i32, delta i32) {
    slot = slot + delta;
}

func touch(node inout Level3) {
    node.value = node.value * 2;
}

func main() i32 {
    var root = Level1(inner: Level2(leaf: Level3(value: 3), label: 7));
    add(inout root.inner.leaf.value, 4);
    if root.inner.leaf.value != 7 {
        return 1;
    }
    if root.inner.label != 7 {
        return 2;
    }
    touch(inout root.inner.leaf);
    if root.inner.leaf.value != 14 {
        return 3;
    }
    if root.inner.label != 7 {
        return 4;
    }
    return 0;
}
