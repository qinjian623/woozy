// Fannkuch-redux preparation fixture: iterative count-array permutation
// generation equivalent to the official recursive prefix-left-rotation order.
// PERF-FANNKUCH n={{N}} checksum={{CHECKSUM}} maximum={{MAXIMUM}}
package app;

struct FannkuchResult {
    checksum i64;
    maximum i32;
}

// Preparation-only observation point. Real builds keep this empty; the Python
// observer imports the generated module and records the actual arguments.
// Native O2 is expected to remove this empty call entirely.
func visit(index u64, values Vec[i32], flips i32) {
}

func fannkuch(n i32) FannkuchResult {
    // The only three working-array allocations for one complete fannkuch call.
    // Permutations reuse them through element-wise copy and swaps.
    var perm Vec[i32] = [{{ZEROS}}];
    var perm1 Vec[i32] = [{{ZEROS}}];
    var count Vec[i32] = [{{ZEROS}}];

    var max_flips i32 = 0;
    var checksum i64 = 0;
    var permutation_index u64 = 0;
    var r i32 = n;

    for var i i32 = 0; i < n; i += 1 {
        perm1[i] = i;
    }

    for {
        for r != 1 {
            count[r - 1] = r;
            r -= 1;
        }

        for var i i32 = 0; i < n; i += 1 {
            perm[i] = perm1[i];
        }

        var flips i32 = 0;
        for perm[0] != 0 {
            let k i32 = perm[0] + 1;
            var left i32 = 0;
            var right i32 = k - 1;
            for left < right {
                let saved i32 = perm[left];
                perm[left] = perm[right];
                perm[right] = saved;
                left += 1;
                right -= 1;
            }
            flips += 1;
        }

        visit(permutation_index, {{VISIT_VALUES}}, {{VISIT_FLIPS}});
        if flips > max_flips {
            max_flips = flips;
        }
        if permutation_index % 2 == 0 {
            checksum += i64(flips);
        } else {
            checksum -= i64(flips);
        }
        permutation_index += 1;

        for {
            if r == n {
                break;
            }
            let perm0 i32 = perm1[0];
            var i i32 = 0;
            for i < r {
                let j i32 = i + 1;
                perm1[i] = perm1[j];
                i = j;
            }
            perm1[r] = perm0;
            count[r] -= 1;
            if count[r] > 0 {
                break;
            }
            r += 1;
        }
        if r == n {
            break;
        }
    }

    return FannkuchResult(checksum: checksum, maximum: max_flips);
}

func main() i32 {
    let result = fannkuch({{N}});
    let expected_checksum i64 = {{CHECKSUM}};
    let expected_maximum i32 = {{MAXIMUM}};
    if result.checksum != expected_checksum {
        return 1;
    }
    if result.maximum != expected_maximum {
        return 2;
    }
    return 0;
}
