// C++20 reference for the same full perfect-tree workload: post-order Node
// creation, recursive node-count traversal, and complete unique_ptr release.
// Each logical node, including every leaf, is a separately allocated Node.
// There is no output, FFI, thread, SIMD, timing call, arena, pool, free-list,
// cached node, shared leaf, or formula-only replacement for the tree work.
// PERF-BINARYTREES n={{N}} max={{MAX_DEPTH}} stretch={{STRETCH_DEPTH}} expected_sha256={{EXPECTED_SHA}} variant={{VARIANT}}
#include <cstdint>
#include <memory>

// The same 24-byte Node size is used for leaves and internal nodes; leaves keep
// null left/right unique_ptr fields rather than a shared sentinel.
struct Node {
    bool leaf;
    std::unique_ptr<Node> left;
    std::unique_ptr<Node> right;
};

// Post-order creation: left subtree, right subtree, then the parent Node.
static std::unique_ptr<Node> make_tree(int32_t depth) {
    if (depth == 0) {
        auto node = std::make_unique<Node>();
        node->leaf = true;
        return node;
    }
    auto left = make_tree(depth - 1);
    auto right = make_tree(depth - 1);
    auto node = std::make_unique<Node>();
    node->leaf = false;
    node->left = std::move(left);
    node->right = std::move(right);
    return node;
}

// Traverse the complete tree in left/right order.
static int32_t check(const Node& node) {
    if (node.leaf) {
        return 1;
    }
    return 1 + check(*node.left) + check(*node.right);
}

static int32_t stretch_phase() {
    auto tree = make_tree({{STRETCH_DEPTH}});
    const int32_t total = check(*tree);
    if (total != {{STRETCH_CHECK}}) {
        return 1;
    }
    return 0;
}

static int32_t bucket_phase(int32_t max_depth, int32_t depth,
                            int32_t expected_trees, int32_t expected_check) {
    const int32_t tree_count =
        int32_t{1} << (max_depth - depth + 4);
    if (tree_count != expected_trees) {
        return 4;
    }
    int32_t total = 0;
    for (int32_t i = 0; i < tree_count; ++i) {
        // The tree is fully created before check, then destroyed at the end of
        // this iteration.
        auto tree = make_tree(depth);
        total += check(*tree);
    }
    if (total != expected_check) {
        return 2;
    }
    return 0;
}

static int32_t run() {
    const int32_t stretch_result = stretch_phase();
    if (stretch_result != 0) {
        return stretch_result;
    }

    // This tree remains alive through every bucket build/check/release below.
    auto long_lived = make_tree({{MAX_DEPTH}});
{{BUCKET_CALLS}}
    const int32_t long_total = check(*long_lived);
    if (long_total != {{LONG_CHECK}}) {
        return 3;
    }
    return 0;
}

int main() {
    return run();
}
