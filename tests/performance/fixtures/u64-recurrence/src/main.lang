package app;

func mix(x u64) u64 {
    var y u64 = x;
    y = y ^ (y >> 12);
    y = y ^ (y << 25);
    y = y ^ (y >> 27);
    return y * 2685821657736338717;
}

func advance(seed u64, count u64) u64 {
    var state u64 = seed;
    for var i u64 = 0; i < count; i += 1 {
        state = mix(state) + state * 6364136223846793005 + i;
    }
    return state;
}

func main() i32 {
    let actual = advance(0x123456789abcdef0, 30000000);
    let expected u64 = 16012610758795272003;
