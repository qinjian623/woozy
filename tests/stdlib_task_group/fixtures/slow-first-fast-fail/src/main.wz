// A slow successful task is first in the batch; a later task fails quickly.
// Fail-fast must cancel the slow member instead of awaiting it first. The
// slow member's sleep is cancelled, so "slow.after" must never appear, while
// its defer must run before the typed error reaches the caller.
package app;
import "std/async" as a;
import "std/io" as io;
import "std/os" as os;
import "std/vec" as vec;

enum Failure { Bad; }

async func slow(log Vec[string]) i32 throws Failure {
    defer { vec.push(log, "slow.cleanup"); }
    await a.sleep(200);
    vec.push(log, "slow.after");
    return 1;
}

async func fail(log Vec[string]) i32 throws Failure {
    defer { vec.push(log, "fail.cleanup"); }
    await a.sleep(5);
    vec.push(log, "fail.throw");
    throw Failure.Bad;
}

async func main() i32 throws os.Error {
    let log = vec.empty[string]();
    try {
        let values = a.or_throw(await a.gather[i32,Failure]([
            slow(log),
            fail(log)]));
        io.println("unexpected.ok");
    } catch error Failure {
        io.println("caught");
    }
    for line in log { io.println(line); }
    return 0;
}
