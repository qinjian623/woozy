// Behaviour checks for the ergonomic std/vec operations and std/sort range
// helpers. main returns 0 on success and a unique non-zero code identifying
// the first failing check.
package app;

import "std/box" as box;
import "std/option" as option;
import "std/slice" as slice;
import "std/sort" as sort;
import "std/vec" as vec;

struct Item {
    key i32;
    tag i32;
}

func less_i32(left i32, right i32) bool { return left < right; }
func greater_i32(left i32, right i32) bool { return left > right; }
func less_item(left Item, right Item) bool { return left.key < right.key; }
func greater_item(left Item, right Item) bool { return left.key > right.key; }
func item_key(value Item) i32 { return value.key; }
func less_string(left string, right string) bool { return left < right; }

func found_at(value option.Option[usize], expected usize) bool {
    switch value {
        case option.Option.Some(at): return at == expected;
        case option.Option.None: return false;
    }
}

func missing(value option.Option[usize]) bool {
    switch value {
        case option.Option.Some(at): return false;
        case option.Option.None: return true;
    }
}

// test_empty_and_edges covers empty Vecs, insertion at both ends, deletion at
// both ends, and the moment when insertion makes a full Vec grow.
func test_empty_and_edges() i32 {
    let values = vec.empty[i32]();
    if vec.len[i32](values) != 0 || vec.capacity[i32](values) != 0 {
        return 10;
    }
    vec.insert[i32](values, 0, 7);
    if vec.len[i32](values) != 1 || values[0] != 7 { return 11; }
    vec.insert[i32](values, 1, 9);
    if vec.len[i32](values) != 2 || values[1] != 9 { return 12; }
    vec.insert[i32](values, 0, 5);
    if vec.len[i32](values) != 3 { return 13; }
    if values[0] != 5 || values[1] != 7 || values[2] != 9 { return 14; }
    if vec.capacity[i32](values) < 3 { return 15; }

    let removed_last = vec.remove_at[i32](values, 2);
    if removed_last != 9 || vec.len[i32](values) != 2 { return 16; }
    if values[0] != 5 || values[1] != 7 { return 17; }
    let removed_first = vec.remove_at[i32](values, 0);
    if removed_first != 5 || vec.len[i32](values) != 1 { return 18; }
    if values[0] != 7 { return 19; }
    let removed_only = vec.swap_remove[i32](values, 0);
    if removed_only != 7 || vec.len[i32](values) != 0 { return 20; }
    vec.extend[i32](values, values);
    if vec.len[i32](values) != 0 { return 21; }

    // A make result with a power-of-two length has capacity == length.
    // Inserting at the end must make the Vec grow before the shift loop runs.
    let full = vec.make[i32](4, 0);
    full[0] = 1;
    full[1] = 2;
    full[2] = 3;
    full[3] = 4;
    if vec.len[i32](full) != 4 || vec.capacity[i32](full) != 4 { return 22; }
    vec.insert[i32](full, 4, 5);
    if vec.len[i32](full) != 5 || vec.capacity[i32](full) < 5 { return 23; }
    if full[0] != 1 || full[1] != 2 || full[2] != 3 || full[3] != 4 ||
       full[4] != 5 { return 24; }
    let end_value = vec.remove_at[i32](full, 4);
    if end_value != 5 || vec.len[i32](full) != 4 { return 25; }
    let front_value = vec.remove_at[i32](full, 0);
    if front_value != 1 || vec.len[i32](full) != 3 { return 26; }
    if full[0] != 2 || full[1] != 3 || full[2] != 4 { return 27; }
    let middle_value = vec.swap_remove[i32](full, 0);
    if middle_value != 2 || vec.len[i32](full) != 2 { return 28; }
    if full[0] != 4 || full[1] != 3 { return 29; }
    return 0;
}

// test_i32_self_alias inserts an element read from the same Vec, including the
// growth case, and then extends the Vec with itself.
func test_i32_self_alias() i32 {
    let values = vec.make[i32](4, 0);
    values[0] = 1;
    values[1] = 2;
    values[2] = 3;
    values[3] = 4;
    if vec.capacity[i32](values) != 4 { return 40; }

    vec.insert[i32](values, 2, values[3]);
    let inserted = [1, 2, 4, 3, 4];
    if vec.len[i32](values) != 5 { return 41; }
    for var index usize = 0; index < 5; index += 1 {
        if values[index] != i32(inserted[index]) { return 42; }
    }

    vec.insert[i32](values, vec.len[i32](values), values[0]);
    let appended = [1, 2, 4, 3, 4, 1];
    if vec.len[i32](values) != 6 { return 43; }
    for var index usize = 0; index < 6; index += 1 {
        if values[index] != i32(appended[index]) { return 44; }
    }

    let first = vec.remove_at[i32](values, 1);
    if first != 2 || vec.len[i32](values) != 5 { return 45; }
    let swapped = vec.swap_remove[i32](values, 0);
    if swapped != 1 || vec.len[i32](values) != 4 { return 46; }
    if values[0] != 1 || values[1] != 4 || values[2] != 3 ||
       values[3] != 4 { return 47; }
    let tail = vec.swap_remove[i32](values, 3);
    if tail != 4 || vec.len[i32](values) != 3 { return 48; }

    vec.extend[i32](values, values);
    let extended = [1, 4, 3, 1, 4, 3];
    if vec.len[i32](values) != 6 { return 49; }
    for var index usize = 0; index < 6; index += 1 {
        if values[index] != i32(extended[index]) { return 50; }
    }
    return 0;
}

// test_strings exercises reference-counted payloads through every operation,
// including an inserted value that aliases an element of the target.
func test_strings() i32 {
    let words = vec.make[string](3, "");
    words[0] = "alpha";
    words[1] = "beta";
    words[2] = "gamma";
    vec.insert[string](words, 1, words[0]);
    if vec.len[string](words) != 4 { return 60; }
    if words[0] != "alpha" || words[1] != "alpha" { return 61; }
    if words[2] != "beta" || words[3] != "gamma" { return 62; }

    let removed = vec.remove_at[string](words, 2);
    if removed != "beta" || vec.len[string](words) != 3 { return 63; }
    if words[0] != "alpha" || words[1] != "alpha" || words[2] != "gamma" {
        return 64;
    }
    let swapped = vec.swap_remove[string](words, 0);
    if swapped != "alpha" || vec.len[string](words) != 2 { return 65; }
    if words[0] != "gamma" || words[1] != "alpha" { return 66; }
    vec.extend[string](words, words);
    if vec.len[string](words) != 4 { return 67; }
    if words[0] != "gamma" || words[1] != "alpha" ||
       words[2] != "gamma" || words[3] != "alpha" { return 68; }
    words[0] = "delta";
    if words[2] != "gamma" { return 69; }

    let labels = vec.make[string](6, "");
    labels[0] = "b";
    labels[1] = "a";
    labels[2] = "b";
    labels[3] = "c";
    labels[4] = "a";
    labels[5] = "b";
    sort.sort_by[string](labels, less_string);
    let sorted = ["a", "a", "b", "b", "b", "c"];
    for var index usize = 0; index < 6; index += 1 {
        if labels[index] != sorted[index] { return 70; }
    }
    let range = sort.equal_range_by[string](labels, "b", less_string);
    if range.start != 2 || range.end != 5 { return 71; }
    if sort.upper_bound_by[string](labels, "a", less_string) != 2 {
        return 72;
    }
    if sort.upper_bound_by[string](labels, "c", less_string) != 6 {
        return 73;
    }
    if !found_at(sort.binary_search_by[string](labels, "b", less_string), 2) {
        return 74;
    }
    return 0;
}

// test_nested_vecs keeps inner Vec identities visible across insert, remove,
// swap_remove and self-extension, then repeats self-extension with a full Vec
// so the source elements move while they are being read.
func test_nested_vecs() i32 {
    let first = vec.make[i32](2, 0);
    first[0] = 1;
    first[1] = 2;
    let second = vec.make[i32](2, 0);
    second[0] = 3;
    second[1] = 4;
    let outer = vec.make[Vec[i32]](2, first);
    outer[1] = second;

    vec.insert[Vec[i32]](outer, 1, outer[0]);
    if vec.len[Vec[i32]](outer) != 3 { return 80; }
    outer[1][0] = 7;
    if outer[0][0] != 7 || first[0] != 7 { return 81; }
    if outer[2][0] != 3 { return 82; }
    let removed = vec.remove_at[Vec[i32]](outer, 0);
    removed[0] = 9;
    if outer[0][0] != 9 || outer[1][0] != 3 { return 83; }
    let swapped = vec.swap_remove[Vec[i32]](outer, 0);
    swapped[0] = 11;
    if first[0] != 11 || outer[0][0] != 3 { return 84; }
    vec.extend[Vec[i32]](outer, outer);
    if vec.len[Vec[i32]](outer) != 2 { return 85; }
    outer[1][1] = 42;
    if outer[0][1] != 42 || second[1] != 42 { return 86; }

    let left = vec.make[i32](1, 10);
    let middle = vec.make[i32](1, 20);
    let right = vec.make[i32](1, 30);
    let extra = vec.make[i32](1, 40);
    let chain = vec.make[Vec[i32]](4, left);
    chain[1] = middle;
    chain[2] = right;
    chain[3] = extra;
    if vec.capacity[Vec[i32]](chain) != 4 { return 87; }
    vec.extend[Vec[i32]](chain, chain);
    if vec.len[Vec[i32]](chain) != 8 { return 88; }
    chain[0][0] = 11;
    if chain[4][0] != 11 || left[0] != 11 { return 89; }
    chain[7][0] = 44;
    if extra[0] != 44 || chain[3][0] != 44 { return 90; }
    if chain[1][0] != 20 || chain[5][0] != 20 { return 91; }
    if chain[2][0] != 30 || chain[6][0] != 30 { return 92; }
    return 0;
}

// test_box_identity verifies that the helpers move shared Box handles rather
// than copying the boxed value.
func test_box_identity() i32 {
    let cell = box.new[i32](5);
    let other = box.new[i32](8);
    let cells = vec.make[box.Box[i32]](2, cell);
    cells[1] = other;
    vec.insert[box.Box[i32]](cells, 1, cell);
    box.set[i32](cells[1], 13);
    if box.get[i32](cell) != 13 { return 100; }
    let removed = vec.remove_at[box.Box[i32]](cells, 1);
    box.set[i32](removed, 21);
    if box.get[i32](cell) != 21 || box.get[i32](cells[0]) != 21 {
        return 101;
    }
    let swapped = vec.swap_remove[box.Box[i32]](cells, 0);
    box.set[i32](swapped, 34);
    if box.get[i32](cell) != 34 || box.get[i32](cells[0]) != 8 {
        return 102;
    }
    vec.extend[box.Box[i32]](cells, cells);
    box.set[i32](cells[1], 55);
    if box.get[i32](cells[0]) != 55 || box.get[i32](other) != 55 {
        return 103;
    }
    vec.insert[box.Box[i32]](cells, vec.len[box.Box[i32]](cells), cell);
    box.set[i32](cells[2], 64);
    if vec.len[box.Box[i32]](cells) != 3 || box.get[i32](cell) != 64 ||
       box.get[i32](cells[0]) != 55 || box.get[i32](cells[1]) != 55 {
        return 104;
    }
    return 0;
}

// test_ranges checks empty, full-duplicate, missing and boundary values for
// both ascending and descending strict weak orders.
func test_ranges() i32 {
    let empty = vec.empty[i32]();
    if sort.lower_bound_by[i32](empty, 5, less_i32) != 0 { return 110; }
    if sort.upper_bound_by[i32](empty, 5, less_i32) != 0 { return 111; }
    let empty_range = sort.equal_range_by[i32](empty, 5, less_i32);
    if empty_range.start != 0 || empty_range.end != 0 { return 112; }
    if !missing(sort.binary_search_by[i32](empty, 5, less_i32)) { return 113; }

    let values = vec.make[i32](8, 0);
    values[0] = 1;
    values[1] = 1;
    values[2] = 2;
    values[3] = 2;
    values[4] = 2;
    values[5] = 4;
    values[6] = 4;
    values[7] = 7;
    sort.sort_by[i32](values, less_i32);
    if !sort.is_sorted_by[i32](values, less_i32) { return 114; }
    if sort.lower_bound_by[i32](values, 2, less_i32) != 2 { return 115; }
    if sort.upper_bound_by[i32](values, 2, less_i32) != 5 { return 116; }
    let twos = sort.equal_range_by[i32](values, 2, less_i32);
    if twos.start != 2 || twos.end != 5 { return 117; }
    let ones = sort.equal_range_by[i32](values, 1, less_i32);
    if ones.start != 0 || ones.end != 2 { return 118; }
    let fours = sort.equal_range_by[i32](values, 4, less_i32);
    if fours.start != 5 || fours.end != 7 { return 119; }
    let sevens = sort.equal_range_by[i32](values, 7, less_i32);
    if sevens.start != 7 || sevens.end != 8 { return 120; }
    let below = sort.equal_range_by[i32](values, 0, less_i32);
    if below.start != 0 || below.end != 0 { return 121; }
    let above = sort.equal_range_by[i32](values, 9, less_i32);
    if above.start != 8 || above.end != 8 { return 122; }
    if sort.upper_bound_by[i32](values, 0, less_i32) != 0 { return 123; }
    if sort.upper_bound_by[i32](values, 9, less_i32) != 8 { return 124; }
    if !found_at(sort.binary_search_by[i32](values, 2, less_i32), 2) {
        return 125;
    }
    if !missing(sort.binary_search_by[i32](values, 9, less_i32)) {
        return 126;
    }

    let all = vec.make[i32](5, 7);
    if sort.lower_bound_by[i32](all, 7, less_i32) != 0 { return 127; }
    if sort.upper_bound_by[i32](all, 7, less_i32) != 5 { return 128; }
    let full_range = sort.equal_range_by[i32](all, 7, less_i32);
    if full_range.start != 0 || full_range.end != 5 { return 129; }
    if sort.upper_bound_by[i32](all, 6, less_i32) != 0 { return 130; }
    if sort.upper_bound_by[i32](all, 8, less_i32) != 5 { return 131; }

    let descending = vec.make[i32](8, 0);
    descending[0] = 9;
    descending[1] = 7;
    descending[2] = 5;
    descending[3] = 5;
    descending[4] = 5;
    descending[5] = 3;
    descending[6] = 1;
    descending[7] = 1;
    sort.sort_by[i32](descending, greater_i32);
    if !sort.is_sorted_by[i32](descending, greater_i32) { return 132; }
    if sort.lower_bound_by[i32](descending, 5, greater_i32) != 2 {
        return 133;
    }
    if sort.upper_bound_by[i32](descending, 5, greater_i32) != 5 {
        return 134;
    }
    let fives = sort.equal_range_by[i32](descending, 5, greater_i32);
    if fives.start != 2 || fives.end != 5 { return 135; }
    let threes = sort.equal_range_by[i32](descending, 3, greater_i32);
    if threes.start != 5 || threes.end != 6 { return 136; }
    let nines = sort.equal_range_by[i32](descending, 9, greater_i32);
    if nines.start != 0 || nines.end != 1 { return 137; }
    let zeros = sort.equal_range_by[i32](descending, 0, greater_i32);
    if zeros.start != 8 || zeros.end != 8 { return 138; }
    let tens = sort.equal_range_by[i32](descending, 10, greater_i32);
    if tens.start != 0 || tens.end != 0 { return 139; }
    let eights = sort.equal_range_by[i32](descending, 8, greater_i32);
    if eights.start != 1 || eights.end != 1 { return 140; }
    if !found_at(sort.binary_search_by[i32](descending, 5, greater_i32), 2) {
        return 141;
    }
    if !found_at(sort.binary_search_by[i32](descending, 9, greater_i32), 0) {
        return 142;
    }
    if !missing(sort.binary_search_by[i32](descending, 8, greater_i32)) {
        return 143;
    }
    let all_descending = vec.make[i32](4, 7);
    let all_descending_range = sort.equal_range_by[i32](all_descending, 7,
                                                         greater_i32);
    if all_descending_range.start != 0 || all_descending_range.end != 4 {
        return 144;
    }
    return 0;
}

// test_key_stability checks that sort_by_key preserves creation order
// inside every duplicate key group for ascending and descending orders, then
// checks the range helpers against the sorted result.
func test_key_stability() i32 {
    let empty = vec.empty[Item]();
    sort.sort_by_key[Item,i32](empty, item_key, less_i32);
    if vec.len[Item](empty) != 0 { return 150; }
    let single = vec.make[Item](1, Item(key: 1, tag: 2));
    sort.sort_by_key[Item,i32](single, item_key, less_i32);
    if single[0].tag != 2 { return 151; }

    let items = vec.make[Item](8, Item(key: 0, tag: 0));
    items[0] = Item(key: 3, tag: 0);
    items[1] = Item(key: 1, tag: 1);
    items[2] = Item(key: 2, tag: 2);
    items[3] = Item(key: 1, tag: 3);
    items[4] = Item(key: 3, tag: 4);
    items[5] = Item(key: 1, tag: 5);
    items[6] = Item(key: 2, tag: 6);
    items[7] = Item(key: 3, tag: 7);
    sort.sort_by_key[Item,i32](items, item_key, less_i32);
    if items[0].tag != 1 || items[1].tag != 3 || items[2].tag != 5 {
        return 152;
    }
    if items[3].tag != 2 || items[4].tag != 6 { return 153; }
    if items[5].tag != 0 || items[6].tag != 4 || items[7].tag != 7 {
        return 154;
    }
    let ones = sort.equal_range_by[Item](items, Item(key: 1, tag: 99),
                                         less_item);
    if ones.start != 0 || ones.end != 3 { return 155; }
    if sort.upper_bound_by[Item](items, Item(key: 2, tag: 99),
                                 less_item) != 5 { return 156; }
    if !found_at(sort.binary_search_by[Item](items, Item(key: 3, tag: 99),
                                             less_item), 5) { return 157; }

    sort.sort_by_key[Item,i32](items, item_key, greater_i32);
    if items[0].tag != 0 || items[1].tag != 4 || items[2].tag != 7 {
        return 158;
    }
    if items[3].tag != 2 || items[4].tag != 6 { return 159; }
    if items[5].tag != 1 || items[6].tag != 3 || items[7].tag != 5 {
        return 160;
    }
    let threes = sort.equal_range_by[Item](items, Item(key: 3, tag: 99),
                                           greater_item);
    if threes.start != 0 || threes.end != 3 { return 161; }
    if sort.upper_bound_by[Item](items, Item(key: 2, tag: 99),
                                 greater_item) != 5 { return 162; }
    if !found_at(sort.binary_search_by[Item](items, Item(key: 1, tag: 99),
                                             greater_item), 5) { return 163; }
    return 0;
}

// test_pinned_empty_extend checks that a no-op extend is allowed while a Slice
// pins the Vec, and that a later real mutation is rejected only after the pin
// is gone.
func test_pinned_empty_extend() i32 {
    let values = vec.make[i32](3, 1);
    let empty = vec.empty[i32]();
    {
        let guard Slice[i32] = slice.view[i32](values, 0, 2);
        vec.extend[i32](values, empty);
        if slice.len[i32](guard) != 2 { return 170; }
        if values[0] != 1 || values[2] != 1 { return 171; }
    }
    vec.push[i32](values, 4);
    if vec.len[i32](values) != 4 || values[3] != 4 { return 172; }
    return 0;
}

func main() i32 {
    var failure = test_empty_and_edges();
    if failure != 0 { return failure; }
    failure = test_i32_self_alias();
    if failure != 0 { return failure; }
    failure = test_strings();
    if failure != 0 { return failure; }
    failure = test_nested_vecs();
    if failure != 0 { return failure; }
    failure = test_box_identity();
    if failure != 0 { return failure; }
    failure = test_ranges();
    if failure != 0 { return failure; }
    failure = test_key_stability();
    if failure != 0 { return failure; }
    failure = test_pinned_empty_extend();
    if failure != 0 { return failure; }
    return 0;
}
