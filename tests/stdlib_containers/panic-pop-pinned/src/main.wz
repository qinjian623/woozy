package app;
import "std/option" as option;
import "std/slice" as slice;
import "std/vec" as vec;
func main() i32 {
    let empty = vec.empty[i32]();
    let pinned = slice.view(empty, 0, 0);
    switch vec.pop(empty) {
        case option.Option.Some(value): return 1;
        case option.Option.None: {}
    }
    if slice.len(pinned) != 0 { return 2; }
    let values Vec[i32] = [123, 456];
    let same = values;
    switch vec.pop(same) {
        case option.Option.Some(value): {
            if value != 456 || vec.len(values) != 1 || values[0] != 123 { return 3; }
        }
        case option.Option.None: return 4;
    }
    let strings Vec[string] = ["alpha", "b\u{e9}ta"];
    switch vec.pop(strings) {
        case option.Option.Some(value): {
            if value != "b\u{e9}ta" || vec.len(strings) != 1 { return 5; }
        }
        case option.Option.None: return 6;
    }
    let active = slice.view(values, 0, 1);
    switch vec.pop(values) {
        case option.Option.Some(value): return 7;
        case option.Option.None: {}
    }
    return i32(slice.len(active));
}
